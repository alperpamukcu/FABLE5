{"strings": [
{"key": "data.voice.aussie.another.0", "text": "Như cũ nha, mate!", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "Thêm ly nữa, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "Ly nữa đi, legend!", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "Yeah, righto.", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "Không tệ, mate.", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "Thế là được.", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "Thật hả, mate?", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto. Cũng phải.", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Nah, hơi gắt đấy.", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto, tôi chờ đủ lâu rồi.", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Nah, chán rồi. Tôi đi đây.", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "Cheers vì chẳng được gì, mate.", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "Một ly {drink}, mate.", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink}, làm ơn.", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "Tôi làm một ly {drink}.", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "Một {drink}, cheers.", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "Ripper!", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "Too easy!", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "Ngon ra phết!", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "Bloody ripper, mate. Cheers.", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "Too easy. Bạn rành nghề đấy.", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "Ly ngon nhất tối nay, thật đấy.", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "Nghe này, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "No dramas, nhưng {advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Nah, mate.", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "Không phải của tôi, xin lỗi.", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "Nhầm ly rồi, mate.", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "Thêm vòng nữa!", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "Như cũ nha em!", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "Cứ mang ra tiếp đi!", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "Cảm ơn nha.", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "Vậy là được rồi.", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "Cũng gần đúng.", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "Thật hả? Thôi được.", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "Em đang sai lầm đấy.", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "Sao cũng được. Quán em, em giữ.", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "Thôi khỏi. Chờ vậy đủ rồi.", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "Tối nay có ai làm không vậy?", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "Thôi. Đi chỗ khác uống.", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "Cho một ly {drink} nha.", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "Cho mình một ly {drink}.", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "Em ơi, một ly {drink}, rảnh thì làm nha.", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "Làm một ly {drink} đi.", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "Hoàn hảo!", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "Đúng nó rồi!", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "Chuẩn không cần chỉnh!", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "Chẳng có gì phải sửa.", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "Đây mới gọi là đồ uống.", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "Ai dạy em thì cảm ơn người ta giùm nha.", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "Hừm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice} Nói vậy thôi.", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "Nói thật nha? {advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "Không phải món mình gọi.", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "Nhầm đồ uống rồi.", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "Ly này đâu phải của mình.", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "Encore, làm ơn!", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "Thêm ly nữa, oui!", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "Nữa nhé, merci!", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ça va.", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "Cũng được.", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon, okay.", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "Quoi? Thật sao?", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Bon. Au revoir.", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule.", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non. Tôi chờ đủ rồi.", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis. Tôi đi.", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "Vậy au revoir.", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "Một ly {drink}, s'il vous plaît.", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "{drink}, làm ơn.", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "Un {drink}, merci.", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "Tôi lấy một ly {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "Parfait!", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "Voilà, hoàn hảo!", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "Magnifique!", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait. Tôi chẳng có gì để góp ý.", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voilà. Ở đây có người biết rót.", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique. Thật đấy.", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Écoute, {advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon, {advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors, {advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non.", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "Không phải ly này.", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon, nhầm rồi.", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "Mou ippai!", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "Thêm ly nữa, kanpai!", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "Nữa nhé, onegai!", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Hai, được.", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa.", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "Không tệ, ne.", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "Eh?! Thật sao?", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi. Được, tôi đi.", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta. Sayonara.", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen, tôi không chờ thêm được.", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii. Tôi đi.", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai. Tạm biệt.", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen, một ly {drink}.", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "Một {drink}, onegai.", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink}, làm ơn. Arigatou.", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto… một ly {drink}.", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "Oishii!", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "Sugoi, hoàn hảo!", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "Kanpai!", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii. Thật sự, đúng ly này rồi.", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "Sugoi. Bạn là dân chuyên, ne.", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "Kanpai. Hoàn hảo.", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "Etto, {advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "Ne, {advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "Sumimasen, nhưng {advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "Chotto… không phải.", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "Eh? Không phải ly này.", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "Chigau, xin lỗi.", "src": "Chigau, sorry."},
{"key": "data.voice.midwest.another.0", "text": "Thêm ly nữa, làm ơn!", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "Một ly nữa, cảm ơn nhiều!", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "Như cũ nhé, ope!", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "Ồ, vậy là được rồi.", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "Được, cảm ơn nhé.", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "Không tệ chút nào.", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "Ồ. Chà. Vậy thì thôi.", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "Ope, xin lỗi… tôi đi.", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "Hơi quá, nhưng được thôi.", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "Oh gosh, tôi thật sự không chờ nổi nữa.", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "Chà, chắc tôi phải đi thôi.", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "Xin lỗi nhé, tôi về trước.", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "Cho tôi một ly {drink} được không? Cảm ơn nhiều.", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "Một ly {drink}, nếu không phiền.", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "Ồ, cho tôi ly {drink} thôi.", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink}, làm ơn. Lúc nào cũng được.", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "Ồ, ngon thật!", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "You betcha!", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "Oh jeez, tuyệt!", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "Oh my gosh, ngon dễ thương ghê.", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "Ngon thật. Dì tôi mà biết quán này chắc mê lắm.", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "Chà, đúng thứ tôi đang cần.", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "Ồ, {advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "Nói để bạn biết, {advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "Không có gì to tát, nhưng {advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "Ope. Nhầm ly rồi.", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "Ồ, không phải của tôi.", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "Xin lỗi, không phải ly này.", "src": "Sorry, no. Not this."},
{"key": "data.voice.polish.another.0", "text": "Jeszcze raz!", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "Thêm ly nữa, proszę!", "src": "Another, proszę!"},
{"key": "data.voice.polish.another.2", "text": "Một ly nữa!", "src": "One more!"},
{"key": "data.voice.polish.close.0", "text": "Dobrze.", "src": "Dobrze."},
{"key": "data.voice.polish.close.1", "text": "Được.", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "Ổn, cảm ơn.", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "Serio? Được thôi.", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "Được. Do widzenia.", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "Co? Được, tôi đi.", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "Đủ rồi. Tôi về.", "src": "Enough. I'm going."},
{"key": "data.voice.polish.leaving.1", "text": "Nie, nie. Lâu quá.", "src": "Nie, nie. Too long."},
{"key": "data.voice.polish.leaving.2", "text": "Do widzenia.", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "Một ly {drink}, proszę.", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "{drink}, làm ơn.", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "Một {drink}. Cảm ơn.", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "Dobrze, một ly {drink}.", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "Na zdrowie!", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "Świetnie!", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "Ngon lắm!", "src": "Very good!"},
{"key": "data.voice.polish.praise.0", "text": "Na zdrowie. Đây mới là đồ uống thật.", "src": "Na zdrowie. This is a real drink."},
{"key": "data.voice.polish.praise.1", "text": "Świetnie. Như ở nhà.", "src": "Świetnie. Like at home."},
{"key": "data.voice.polish.praise.2", "text": "Dobrze. Ngon lắm, ngon lắm.", "src": "Dobrze. Very, very good."},
{"key": "data.voice.polish.sip.0", "text": "Dobrze, nhưng {advice_l}", "src": "Dobrze, but {advice_l}"},
{"key": "data.voice.polish.sip.1", "text": "Nghe này, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.polish.sip.2", "text": "Hm, {advice_l}", "src": "Hm, {advice_l}"},
{"key": "data.voice.polish.wrong.0", "text": "Nie. Nhầm ly.", "src": "Nie. Wrong one."},
{"key": "data.voice.polish.wrong.1", "text": "Không phải của tôi.", "src": "This is not mine."},
{"key": "data.voice.polish.wrong.2", "text": "Co to jest?", "src": "Co to jest?"},
{"key": "data.voice.turkish.another.0", "text": "Bir daha!", "src": "Bir daha!"},
{"key": "data.voice.turkish.another.1", "text": "Thêm ly nữa, abi!", "src": "Another, abi!"},
{"key": "data.voice.turkish.another.2", "text": "Nữa đi, eyvallah!", "src": "Again, eyvallah!"},
{"key": "data.voice.turkish.close.0", "text": "Tamam.", "src": "Tamam."},
{"key": "data.voice.turkish.close.1", "text": "İdare eder.", "src": "İdare eder."},
{"key": "data.voice.turkish.close.2", "text": "Được, ổn.", "src": "Okay, fine."},
{"key": "data.voice.turkish.kicked.0", "text": "Ciddi misin? Thôi được.", "src": "Ciddi misin? Okay."},
{"key": "data.voice.turkish.kicked.1", "text": "Abi, thật à? Được.", "src": "Abi, really? Fine."},
{"key": "data.voice.turkish.kicked.2", "text": "Yok, yok. Tôi đi.", "src": "Yok, yok. I'm going."},
{"key": "data.voice.turkish.leaving.0", "text": "Yok, tôi không chờ nữa.", "src": "Yok, I'm not waiting anymore."},
