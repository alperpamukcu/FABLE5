{"strings": [
{"key": "data.voice.african.another.0", "text": "Thêm ly nữa đi!", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "Một ly nữa, abeg!", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "Lại nữa nào, bạn tôi!", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "Cũng được.", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "No wahala.", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "Ừ, cảm ơn nhé.", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "Ah ah! Thật hả?", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala. Tôi đi.", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "Bạn tôi ơi, thế này không hay đâu.", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah ah. Tôi chờ đủ rồi.", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala. Tôi về đây.", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "Để tôi đi thôi, bạn tôi.", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "Cho một ly {drink} nhé.", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "Một {drink}, bạn tôi ơi.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Tôi lấy một ly {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "{drink}, abeg.", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "Ah, ngon!", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "Chuẩn!", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "Ly này được đấy!", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, ly này chuẩn rồi. Cảm ơn nhé.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "No wahala gì hết. Ngon lắm.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "Bạn tôi ơi, bạn rành nghề thật.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "Bạn tôi ơi, {advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg, {advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "Cũng được, nhưng {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah, không phải.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "Không phải ly này.", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "Bạn tôi ơi, không đúng rồi.", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "Như cũ nhé, mate!", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "Thêm ly nữa, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "Nào, thêm ly nữa!", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "Không tệ.", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Ta, thế là được.", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "Ổn, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Hay nhỉ. Hay thật đấy.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "Được thôi. Cheers vì chẳng được gì.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "Đùa nhau à.", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Thôi. Tôi chờ đủ lâu rồi.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "Chán thật. Tôi đi đây.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Hơi tệ đấy. Bye.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "Một ly {drink}, mate, lúc nào rảnh nhé.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, làm ơn. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "Thôi được, một ly {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "Cho tôi một {drink}, ta.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "Lovely!", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "Cheers, mate!", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "Ngon ra trò!", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Blimey. Ngon thật sự đấy.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Pha đúng bài luôn.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Ly này ngon ra phết.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "Có điều này: {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Nghe này, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Hơi lệch rồi đấy.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Ờm, không phải của tôi.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "Không phải món tôi gọi.", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "Thêm ly nữa, yaar!", "src": "One more, yaar!"},
