{"key": "data.voice.southern.leaving.2", "text": "Y'all thong thả quá nhỉ.", "src": "Y'all take your sweet time, don't you."},
{"key": "data.voice.southern.order.0", "text": "Chà, một ly {drink} là hợp với tôi.", "src": "Well now, a {drink} would suit me."},
{"key": "data.voice.southern.order.1", "text": "{drink}, darlin', nếu tiện nhé.", "src": "{drink}, darlin', if you please."},
{"key": "data.voice.southern.order.2", "text": "Chắc tôi lấy một ly {drink}.", "src": "Reckon I'll have a {drink}."},
{"key": "data.voice.southern.order.3", "text": "Một {drink}, sugar.", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "Ngon quá chừng!", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "Lord, ngon ghê!", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "Hot dang!", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "Chà, ai mà ngờ. Đúng là một ly ra trò.", "src": "Well, I'll be. That's a proper drink."},
{"key": "data.voice.southern.praise.1", "text": "Darlin', bạn có năng khiếu đấy.", "src": "Darlin', you got a gift."},
{"key": "data.voice.southern.praise.2", "text": "Chắc tôi tìm được chỗ ruột mới rồi.", "src": "Reckon I found my new spot."},
{"key": "data.voice.southern.sip.0", "text": "Nè, {advice_l}", "src": "Now, {advice_l}"},
{"key": "data.voice.southern.sip.1", "text": "Sugar, {advice_l}", "src": "Sugar, {advice_l}"},
{"key": "data.voice.southern.sip.2", "text": "Nói bạn nghe, {advice_l}", "src": "Tell you what, {advice_l}"},
{"key": "data.voice.southern.wrong.0", "text": "Không phải của tôi, hon.", "src": "Ain't mine, hon."},
{"key": "data.voice.southern.wrong.1", "text": "Ơ, cái gì đây?", "src": "Now what is this?"},
{"key": "data.voice.southern.wrong.2", "text": "Bless your heart.", "src": "Bless your heart."}
]}
