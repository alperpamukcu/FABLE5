{"strings": [
{"key": "data.voice.aussie.another.0", "text": "再来一样的，mate！", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "再来一杯，cheers！", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "Legend，再来一杯！", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "Yeah，righto，行。", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "不赖，mate。", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "凑合了。", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "Mate，你认真的？", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto。也行吧。", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Nah，这有点狠。", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto，我等得够久了。", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Nah，不管了。我走了。", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "白谢你了，mate。", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "Mate，一杯{drink}。", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink}，麻烦了。", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "我来杯{drink}。", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "一杯{drink}，cheers。", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "Ripper！绝了！", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "Too easy！没毛病！", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "好得很！", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "太 ripper 了，mate。Cheers。", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "Too easy。你是真懂。", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "说真的，今晚最好的一杯。", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Mate，{advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "我说，{advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "No dramas，不过{advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Nah，mate，不对。", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "不是我的，抱歉。", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "上错了，mate。", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "再来一轮！", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "照旧再来一杯！", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "接着上！", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "谢谢。", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "行吧。", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "差不多了。", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "真的假的？行。", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "你会后悔的。", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "随便。酒吧你自己留着吧。", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "算了。我不等了。", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "今晚有人上班吗？", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "好吧。我去别家喝。", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink}，谢谢。", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "我要一杯{drink}。", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "有空的时候来杯{drink}。", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "就来杯{drink}吧。", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "完美！", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "就是这个！", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "分毫不差！", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "一点都不用改。", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "这才叫一杯酒。", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "谁教你的，替我谢谢他。", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "嗯。{advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice}随口一说。", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "说实话？{advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "这不是我点的。", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "上错酒了。", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "那杯不是我的。", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "Encore，再来一杯！", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "Oui，再来一杯！", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "再来，merci！", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ca va，还行。", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "还可以。", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon，好吧。", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "Quoi？真的？", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Bon。Au revoir。", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule，太可笑了。", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non，我等够了。", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis，我走了。", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "那就 au revoir 了。", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "一杯{drink}，s'il vous plait。", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "{drink}，劳驾。", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "Un {drink}，merci。", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "我要一杯{drink}。", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "Parfait！完美！", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "Voila，就是这样！", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "Magnifique！太棒了！", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait。我一点意见都没有。", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voila。这儿总算有人会调酒。", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique。真心的。", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Ecoute，{advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon，{advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors，{advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non，不对。", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "不是这杯。", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon，上错了。", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "Mou ippai！再来一杯！", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "再来一杯，kanpai！", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "Onegai，再来！", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Hai，可以。", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa，还行吧。", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "不错呢，ne。", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "Eh？！真的吗？", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi。好吧，我走。", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta。那再见了。", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen，我等不下去了。", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii，我走了。", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai。再见。", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen，来杯{drink}。", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "一杯{drink}，onegai。", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink}，麻烦了。Arigatou。", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto……来杯{drink}。", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "Oishii！好喝！", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "Sugoi，完美！", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "Kanpai！干杯！", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii。真的，就是这杯。", "src": "Oishii. Truly, this is the one."},
