{"strings": [
{"key": "data.voice.african.another.0", "text": "再来一杯！", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "Abeg，再来一杯！", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "朋友，再来！", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "还行。", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "No wahala，可以的。", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "好，谢了。", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "Ah ah！真的假的？", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala，我走就是。", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "朋友，这样可不好。", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah ah，我等够了。", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala，我先走了。", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "朋友，我走啦。", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "请来一杯{drink}。", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "朋友，一杯{drink}。", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "我要一杯{drink}。", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "{drink}，abeg。", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "啊，好喝！", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "对味！", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "这杯正点！", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "啊，这杯对味了。谢谢你。", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "一点 wahala 都没有。真不错。", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "朋友，你这是有真本事。", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "朋友，{advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg，{advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "还行，不过{advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah，不对。", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "不是这杯。", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "朋友，这不对。", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "Mate，照旧再来一杯！", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "再来一杯，cheers！", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "行，再续一杯！", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "还不赖。", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Ta，凑合了。", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "行吧，cheers。", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "真有礼貌啊。太有礼貌了。", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "好吧。行。白谢你了。", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "你开玩笑的吧。", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Right，我等得够久了。", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "算了吧，我走了。", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "这地方有点 rubbish。拜。", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "Mate，得空来杯{drink}。", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}，劳驾。Cheers。", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "那就来杯{drink}吧。", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "我要杯{drink}，ta。", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "太 lovely 了！", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "谢啦，mate！", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "真地道！", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Blimey，这杯还真挺好。", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers，你这活儿干得地道。", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "好得没话说，这杯。", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate，{advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "有个小事儿：{advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "听着，{advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "这杯有点不对劲。", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "呃，不是我的。", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "这不是我点的。", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "再来一杯，yaar！", "src": "One more, yaar!"},
