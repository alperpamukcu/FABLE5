{"key": "data.voice.italian.leaving.2", "text": "Ciao。下辈子再说吧。", "src": "Ciao. Maybe next life."},
{"key": "data.voice.italian.order.0", "text": "来杯{drink}，per favore。", "src": "Un {drink}, per favore."},
