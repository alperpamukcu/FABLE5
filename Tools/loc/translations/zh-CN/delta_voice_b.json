{"key": "data.voice.italian.order.2", "text": "{drink}，grazie。", "src": "{drink}, grazie."},
{"key": "data.voice.italian.order.3", "text": "Dai，来杯{drink}。", "src": "Dai, a {drink}."},
{"key": "data.voice.italian.perfect.0", "text": "Perfetto！完美！", "src": "Perfetto!"},
{"key": "data.voice.italian.perfect.1", "text": "Bravo！好样的！", "src": "Bravo!"},
{"key": "data.voice.italian.perfect.2", "text": "Che buono！真好喝！", "src": "Che buono!"},
{"key": "data.voice.italian.praise.0", "text": "Perfetto。真心的。Grazie mille。", "src": "Perfetto. Truly. Grazie mille."},
{"key": "data.voice.italian.praise.1", "text": "Bravo。我 nonna 喝了都要感动哭。", "src": "Bravo. My nonna would cry."},
{"key": "data.voice.italian.praise.2", "text": "Che buono。我不走了。", "src": "Che buono. I'm not leaving."},
