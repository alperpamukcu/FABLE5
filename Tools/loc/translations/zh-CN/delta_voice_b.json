{"key": "data.voice.miami.sip.2", "text": "Está bien，pero……{advice_l}", "src": "Está bien, pero… {advice_l}"},
{"key": "data.voice.miami.wrong.0", "text": "¿Qué es esto？这是啥？", "src": "¿Qué es esto?"},
{"key": "data.voice.miami.wrong.1", "text": "No, no, no，不是。", "src": "No, no, no."},
{"key": "data.voice.miami.wrong.2", "text": "Oye，这不是我的。", "src": "Not mine, oye."},
{"key": "data.voice.nyc.another.0", "text": "再给我来一杯！", "src": "Hit me again!"},
