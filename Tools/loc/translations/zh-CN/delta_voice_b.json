{"key": "data.voice.surfer.order.0", "text": "Dude，来杯{drink}。", "src": "Dude, a {drink}."},
{"key": "data.voice.surfer.order.1", "text": "能给我来杯，那个，{drink}吗？", "src": "Can I get, like, a {drink}?"},
