{"strings": [
{"key": "data.voice.arabic.another.0", "text": "Kaman wahad！再来一杯！", "src": "Kaman wahad!"},
{"key": "data.voice.arabic.another.1", "text": "Yalla，再来一杯！", "src": "One more, yalla!"},
{"key": "data.voice.arabic.another.2", "text": "Habibi，再来！", "src": "Again, habibi!"},
{"key": "data.voice.arabic.close.0", "text": "Maashi，行。", "src": "Maashi."},
{"key": "data.voice.arabic.close.1", "text": "还可以。", "src": "It is okay."},
{"key": "data.voice.arabic.close.2", "text": "Tamam，谢了。", "src": "Tamam, shukran."},
{"key": "data.voice.arabic.kicked.0", "text": "Shu？你认真的？", "src": "Shu? Seriously?"},
{"key": "data.voice.arabic.kicked.1", "text": "Khalas，行。", "src": "Khalas. Fine."},
{"key": "data.voice.arabic.kicked.2", "text": "Yalla，我走。", "src": "Yalla. I go."},
{"key": "data.voice.arabic.leaving.0", "text": "Khalas，我走了。", "src": "Khalas. I am going."},
{"key": "data.voice.arabic.leaving.1", "text": "Yalla，不等了。", "src": "Yalla, enough waiting."},
{"key": "data.voice.arabic.leaving.2", "text": "Maa salama，再见。", "src": "Maa salama."},
{"key": "data.voice.arabic.order.0", "text": "请来一杯{drink}。", "src": "A {drink}, please."},
{"key": "data.voice.arabic.order.1", "text": "一杯{drink}，shukran。", "src": "One {drink}, shukran."},
{"key": "data.voice.arabic.order.2", "text": "Habibi，来杯{drink}。", "src": "Habibi, a {drink}."},
{"key": "data.voice.arabic.order.3", "text": "我要一杯{drink}。", "src": "I will take a {drink}."},
{"key": "data.voice.arabic.perfect.0", "text": "Ya salam！真好！", "src": "Ya salam!"},
{"key": "data.voice.arabic.perfect.1", "text": "Helu kteer！太好喝了！", "src": "Helu kteer!"},
{"key": "data.voice.arabic.perfect.2", "text": "完美，habibi！", "src": "Perfect, habibi!"},
{"key": "data.voice.arabic.praise.0", "text": "Ya salam。就是这个味，habibi。", "src": "Ya salam. This is the one, habibi."},
{"key": "data.voice.arabic.praise.1", "text": "Helu kteer，谢谢你。", "src": "Helu kteer. Shukran."},
{"key": "data.voice.arabic.praise.2", "text": "Yalla，你是真懂行。", "src": "Yalla, you know your work."},
{"key": "data.voice.arabic.sip.0", "text": "Habibi，{advice_l}", "src": "Habibi, {advice_l}"},
{"key": "data.voice.arabic.sip.1", "text": "Shuf，{advice_l}", "src": "Shuf, {advice_l}"},
{"key": "data.voice.arabic.sip.2", "text": "Tamam，不过{advice_l}", "src": "Tamam, bas {advice_l}"},
{"key": "data.voice.arabic.wrong.0", "text": "La, la，不对。", "src": "La, la."},
{"key": "data.voice.arabic.wrong.1", "text": "不是这杯。", "src": "This is not it."},
{"key": "data.voice.arabic.wrong.2", "text": "Shu hada？这是什么？", "src": "Shu hada?"},
{"key": "data.voice.chinese.another.0", "text": "再来一杯！", "src": "Zai lai yi bei!"},
{"key": "data.voice.chinese.another.1", "text": "再整一杯啊！", "src": "One more, ah!"},
{"key": "data.voice.chinese.another.2", "text": "续上续上！", "src": "Again, please!"},
{"key": "data.voice.chinese.close.0", "text": "还可以。", "src": "Hai keyi."},
{"key": "data.voice.chinese.close.1", "text": "凑合吧。", "src": "Okay lah."},
{"key": "data.voice.chinese.close.2", "text": "行吧，能喝。", "src": "It is fine."},
{"key": "data.voice.chinese.kicked.0", "text": "什么？真的假的？", "src": "Shenme? Really?"},
{"key": "data.voice.chinese.kicked.1", "text": "哎呀，行行行。", "src": "Aiya. Fine."},
{"key": "data.voice.chinese.kicked.2", "text": "好，我走。", "src": "Hao. I leave."},
{"key": "data.voice.chinese.leaving.0", "text": "哎呀，等太久了。", "src": "Aiya. I waited too long."},
{"key": "data.voice.chinese.leaving.1", "text": "算了，我走了。", "src": "Suan le. I go."},
{"key": "data.voice.chinese.leaving.2", "text": "那就再见吧。", "src": "Zaijian, then."},
{"key": "data.voice.chinese.order.0", "text": "来杯{drink}。", "src": "{drink}, please."},
{"key": "data.voice.chinese.order.1", "text": "一杯{drink}，谢谢。", "src": "One {drink}, xiexie."},
{"key": "data.voice.chinese.order.2", "text": "我要一杯{drink}。", "src": "I will have a {drink}."},
{"key": "data.voice.chinese.order.3", "text": "给我整杯{drink}。", "src": "A {drink} for me."},
{"key": "data.voice.chinese.perfect.0", "text": "很好！", "src": "Hen hao!"},
{"key": "data.voice.chinese.perfect.1", "text": "完美啊！", "src": "Perfect, ah!"},
{"key": "data.voice.chinese.perfect.2", "text": "真棒！", "src": "Zhen bang!"},
{"key": "data.voice.chinese.praise.0", "text": "真棒。冲这杯我也得再来。", "src": "Zhen bang. I will come back for this."},
{"key": "data.voice.chinese.praise.1", "text": "很好。你是真会调。", "src": "Hen hao. You know what you are doing."},
{"key": "data.voice.chinese.praise.2", "text": "完美啊。说真的。", "src": "Perfect, ah. Really."},
{"key": "data.voice.chinese.sip.0", "text": "哎，{advice_l}", "src": "Ai, {advice_l}"},
{"key": "data.voice.chinese.sip.1", "text": "听我说，{advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.chinese.sip.2", "text": "好是好，不过{advice_l}", "src": "Hao, but {advice_l}"},
{"key": "data.voice.chinese.wrong.0", "text": "不对。", "src": "Bu dui."},
{"key": "data.voice.chinese.wrong.1", "text": "哎呀，不是。", "src": "Aiya, no."},
{"key": "data.voice.chinese.wrong.2", "text": "不是这杯。", "src": "Not this one."},
{"key": "data.voice.filipino.another.0", "text": "Isa pa！再来一杯！", "src": "Isa pa!"},
{"key": "data.voice.filipino.another.1", "text": "再来一杯哈！", "src": "One more, ha!"},
{"key": "data.voice.filipino.another.2", "text": "麻烦再来一杯！", "src": "Again, please!"},
{"key": "data.voice.filipino.close.0", "text": "Okay lang，还行。", "src": "Okay lang."},
{"key": "data.voice.filipino.close.1", "text": "Sige，谢啦。", "src": "Sige, thanks."},
{"key": "data.voice.filipino.close.2", "text": "Ay，没事的。", "src": "Ay, it's fine."},
{"key": "data.voice.filipino.kicked.0", "text": "Ha？真的假的？", "src": "Ha? Really?"},
{"key": "data.voice.filipino.kicked.1", "text": "Ay。好吧。拜拜。", "src": "Ay. Okay. Bye."},
{"key": "data.voice.filipino.kicked.2", "text": "Grabe naman，太过分了。", "src": "Grabe naman."},
{"key": "data.voice.filipino.leaving.0", "text": "Ay, grabe。太久了，我走了。", "src": "Ay, grabe. Too long. I'm going."},
{"key": "data.voice.filipino.leaving.1", "text": "Sige na，拜拜。", "src": "Sige na, bye."},
{"key": "data.voice.filipino.leaving.2", "text": "Naku，根本没人来。", "src": "Naku, no one is coming."},
{"key": "data.voice.filipino.order.0", "text": "Ay，请来一杯{drink}。", "src": "Ay, one {drink}, please."},
{"key": "data.voice.filipino.order.1", "text": "给我{drink}。Salamat。", "src": "{drink} for me. Salamat."},
{"key": "data.voice.filipino.order.2", "text": "能来杯{drink}吗？谢谢哈。", "src": "Can I have a {drink}? Thanks, ha."},
{"key": "data.voice.filipino.order.3", "text": "Kuya，一杯{drink}。", "src": "A {drink}, kuya."},
{"key": "data.voice.filipino.perfect.0", "text": "Ay，sarap！好喝！", "src": "Ay, sarap!"},
{"key": "data.voice.filipino.perfect.1", "text": "Grabe，就是这个！", "src": "Grabe, yes!"},
{"key": "data.voice.filipino.perfect.2", "text": "完美，kuya！", "src": "Perfect, kuya!"},
{"key": "data.voice.filipino.praise.0", "text": "Grabe，太好喝了。Salamat。", "src": "Grabe. That is so good. Salamat."},
{"key": "data.voice.filipino.praise.1", "text": "Ay，sarap。今天上班的累全值了。", "src": "Ay, sarap. You made my whole shift."},
{"key": "data.voice.filipino.praise.2", "text": "Sige，冲这杯我还会再来。", "src": "Sige, I'm coming back for this."},
{"key": "data.voice.filipino.sip.0", "text": "Ay，{advice_l}", "src": "Ay, {advice_l}"},
{"key": "data.voice.filipino.sip.1", "text": "Sige，不过{advice_l}", "src": "Sige, but {advice_l}"},
{"key": "data.voice.filipino.sip.2", "text": "Ha？{advice}", "src": "Ha? {advice}"},
{"key": "data.voice.filipino.wrong.0", "text": "Ay，hindi。不是这杯。", "src": "Ay, hindi. Not this."},
{"key": "data.voice.filipino.wrong.1", "text": "Grabe，上错酒了。", "src": "Grabe, wrong drink."},
{"key": "data.voice.filipino.wrong.2", "text": "Kuya，这不是我的。", "src": "Not mine, kuya."},
{"key": "data.voice.italian.another.0", "text": "Ancora，dai！再来！", "src": "Ancora, dai!"},
