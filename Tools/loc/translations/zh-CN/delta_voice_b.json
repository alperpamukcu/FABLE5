{"key": "data.voice.italian.sip.2", "text": "Va bene，不过{advice_l}", "src": "Va bene, ma {advice_l}"},
{"key": "data.voice.italian.wrong.0", "text": "Mamma mia，不对。", "src": "Mamma mia, no."},
