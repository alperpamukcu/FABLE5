{"key": "data.voice.italian.another.2", "text": "Amore，再来一次！", "src": "Once more, amore!"},
{"key": "data.voice.italian.close.0", "text": "Va bene，行。", "src": "Va bene."},
{"key": "data.voice.italian.close.1", "text": "好，grazie。", "src": "Okay, grazie."},
{"key": "data.voice.italian.close.2", "text": "还不错，eh。", "src": "Not bad, eh."},
{"key": "data.voice.italian.kicked.0", "text": "Ma dai！真的吗？", "src": "Ma dai! Really?"},
