{"key": "data.voice.miami.leaving.2", "text": "No, no，我不等了。", "src": "No, no. I'm not waiting anymore."},
{"key": "data.voice.miami.order.0", "text": "Oye，给我来杯{drink}。", "src": "Oye, a {drink} for me."},
{"key": "data.voice.miami.order.1", "text": "Dale，一杯{drink}。", "src": "Dale, one {drink}."},
{"key": "data.voice.miami.order.2", "text": "{drink}，papi，得空就来。", "src": "{drink}, papi, when you can."},
{"key": "data.voice.miami.order.3", "text": "Mi amor，来杯{drink}。", "src": "Mi amor, a {drink}."},
{"key": "data.voice.miami.perfect.0", "text": "¡Qué rico！真香！", "src": "¡Qué rico!"},
{"key": "data.voice.miami.perfect.1", "text": "¡Eso es！就是它！", "src": "¡Eso es!"},
{"key": "data.voice.miami.perfect.2", "text": "Dale，perfecto！", "src": "¡Dale, perfecto!"},
{"key": "data.voice.miami.praise.0", "text": "Ay，就是这杯。Gracias。", "src": "Ay, this is the one. Gracias."},
{"key": "data.voice.miami.praise.1", "text": "我 abuela 都会点头，她可是什么都看不上。", "src": "My abuela would approve, and she approves of nothing."},
{"key": "data.voice.miami.praise.2", "text": "Dale。你是真会。", "src": "Dale. You know what you're doing."},
