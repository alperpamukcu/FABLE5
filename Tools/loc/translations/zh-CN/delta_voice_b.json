{"key": "data.voice.nyc.close.0", "text": "呃，还行。", "src": "Eh. It's fine."},
{"key": "data.voice.nyc.close.1", "text": "Yeah，凑合。", "src": "Yeah, alright."},
{"key": "data.voice.nyc.close.2", "text": "能喝。", "src": "It'll do."},
{"key": "data.voice.nyc.kicked.0", "text": "你现在是认真的？", "src": "You serious right now?"},
{"key": "data.voice.nyc.kicked.1", "text": "行。反正这酒吧也不怎么样。", "src": "Fine. Terrible bar anyway."},
{"key": "data.voice.nyc.kicked.2", "text": "哇。好。哇。", "src": "Wow. Okay. Wow."},
{"key": "data.voice.nyc.leaving.0", "text": "我还有地方要去。算了。", "src": "I got places to be. Forget it."},
{"key": "data.voice.nyc.leaving.1", "text": "离谱。我走了。", "src": "Unbelievable. I'm outta here."},
{"key": "data.voice.nyc.leaving.2", "text": "Yo，这是酒吧还是候诊室？", "src": "Yo, is this a bar or a waiting room?"},
{"key": "data.voice.nyc.order.0", "text": "Yo，给我来杯{drink}。", "src": "Yo, lemme get a {drink}."},
{"key": "data.voice.nyc.order.1", "text": "{drink}。我赶时间。", "src": "{drink}. And I'm in a hurry."},
{"key": "data.voice.nyc.order.2", "text": "Chief，来杯{drink}。", "src": "Gimme a {drink}, chief."},
{"key": "data.voice.nyc.order.3", "text": "{drink}。别整花样。", "src": "{drink}. Don't make it weird."},
{"key": "data.voice.nyc.perfect.0", "text": "这才像话！", "src": "Now we're talkin'!"},
{"key": "data.voice.nyc.perfect.1", "text": "就是这个！", "src": "That's the stuff!"},
{"key": "data.voice.nyc.perfect.2", "text": "哦，对味了！", "src": "Oh, that's it!"},
{"key": "data.voice.nyc.praise.0", "text": "行，我服了。这可从来没有过。", "src": "Okay, I'm impressed. That never happens."},
{"key": "data.voice.nyc.praise.1", "text": "我跟你说，这才叫酒。", "src": "Lemme tell ya, that's a drink."},
{"key": "data.voice.nyc.praise.2", "text": "这杯该多收钱。别真收啊。", "src": "You should charge more for this. Don't."},
{"key": "data.voice.nyc.sip.0", "text": "听着，{advice_l}", "src": "Look, {advice_l}"},
