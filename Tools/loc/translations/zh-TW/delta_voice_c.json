{"key": "data.voice.turkish.order.1", "text": "一杯{drink}，eyvallah。", "src": "One {drink}, eyvallah."},
{"key": "data.voice.turkish.order.2", "text": "{drink}，canım，有空再弄就好。", "src": "{drink}, canım, when you can."},
{"key": "data.voice.turkish.order.3", "text": "Bir {drink}，麻煩了。", "src": "Bir {drink}, please."},
{"key": "data.voice.turkish.perfect.0", "text": "Eyvallah！讚！", "src": "Eyvallah!"},
{"key": "data.voice.turkish.perfect.1", "text": "Harika！太棒了！", "src": "Harika!"},
{"key": "data.voice.turkish.perfect.2", "text": "Süper，abi！", "src": "Süper, abi!"},
{"key": "data.voice.turkish.praise.0", "text": "Eyvallah。就是要這樣調。", "src": "Eyvallah. This is how it's done."},
{"key": "data.voice.turkish.praise.1", "text": "Abi，我服了。Harika。", "src": "Abi, my hat is off. Harika."},
{"key": "data.voice.turkish.praise.2", "text": "Tamam，你真的很懂。", "src": "Tamam, you know your work."},
{"key": "data.voice.turkish.sip.0", "text": "Abi，{advice_l}", "src": "Abi, {advice_l}"},
{"key": "data.voice.turkish.sip.1", "text": "Bak，{advice_l}", "src": "Bak, {advice_l}"},
{"key": "data.voice.turkish.sip.2", "text": "Tamam，不過{advice_l}", "src": "Tamam ama, {advice_l}"},
{"key": "data.voice.turkish.wrong.0", "text": "Yok，不是這杯。", "src": "Yok, not this."},
{"key": "data.voice.turkish.wrong.1", "text": "Abi，送錯了。", "src": "Abi, wrong one."},
{"key": "data.voice.turkish.wrong.2", "text": "Bu ne şimdi？這是什麼？", "src": "Bu ne şimdi?"}
