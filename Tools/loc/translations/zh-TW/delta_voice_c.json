{"key": "data.voice.polish.close.1", "text": "好。", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "還好，謝謝。", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "Serio？好吧。", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "好。Do widzenia。", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "Co？好，我走。", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "夠了。我走了。", "src": "Enough. I'm going."},
