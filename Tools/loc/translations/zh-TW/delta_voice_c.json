{"strings": [
{"key": "data.voice.aussie.another.0", "text": "一樣再來，mate！", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "再一杯，cheers！", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "Legend，再來一杯！", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "Yeah，righto，可以。", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "不賴喔，mate。", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "這樣就好。", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "Mate，你認真的？", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto。也是啦。", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Nah，這有點狠。", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto，我等得夠久了。", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Nah，不管了。我走了。", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "真是謝囉，mate。", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "Mate，一杯{drink}。", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink}，麻煩了。", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "我來杯{drink}。", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "一杯{drink}，cheers。", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "Ripper！讚啦！", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "Too easy！沒問題！", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "好到不行！", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "超 ripper 的，mate。Cheers。", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "Too easy。你真的很懂。", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "說真的，今晚最好的一杯。", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Mate，{advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "我說，{advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "No dramas，不過{advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Nah，mate，不對。", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "不是我的，抱歉。", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "送錯了，mate。", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "再來一輪！", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "一樣再來一杯！", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "繼續上！", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "謝謝。", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "這樣可以。", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "差不多了。", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "真的假的？好啦。", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "你會後悔的。", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "隨便。酒吧你自己留著吧。", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "算了。我不等了。", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "今晚到底有沒有人在上班？", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "好喔。我去別家喝。", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink}，謝謝。", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "我要一杯{drink}。", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "有空的時候幫我弄杯{drink}。", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "就來杯{drink}吧。", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "完美！", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "就是這個！", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "一百分！", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "一點都不用改。", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "這才叫一杯酒。", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "不管是誰教你的，幫我謝謝他。", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "嗯。{advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice}隨口說說啦。", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "老實說？{advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "這不是我點的。", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "送錯酒了。", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "那杯不是我的。", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "Encore，再來一杯！", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "Oui，再一杯！", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "再來，merci！", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ca va，還可以。", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "還好。", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon，好吧。", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "Quoi？真的？", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Bon。Au revoir。", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule，太可笑了。", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non，我等夠了。", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis，我走了。", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "那就 au revoir 囉。", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "一杯{drink}，s'il vous plait。", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "{drink}，麻煩了。", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "Un {drink}，merci。", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "我要一杯{drink}。", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "Parfait！完美！", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "Voila，就是這樣！", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "Magnifique！太棒了！", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait。我完全沒意見。", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voila。這裡總算有人會調酒。", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique。真心的。", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Ecoute，{advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon，{advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors，{advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non，不對。", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "不是這杯。", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon，送錯了。", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "Mou ippai！再一杯！", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "再來一杯，kanpai！", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "Onegai，再來！", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Hai，可以。", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa，還好啦。", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "不錯呢，ne。", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "Eh？！真的嗎？", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi。好吧，我走。", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta。Sayonara。", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen，我等不下去了。", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii，我走了。", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai。再見。", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen，來杯{drink}。", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "一杯{drink}，onegai。", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink}，麻煩了。Arigatou。", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto……來杯{drink}。", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "Oishii！好喝！", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "Sugoi，完美！", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "Kanpai！乾杯！", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii。真的，就是這杯。", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "Sugoi。你是專業的呢，ne。", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "Kanpai。這杯完美。", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "Etto，{advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "Ne，{advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "Sumimasen，不過{advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "Chotto……不對。", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "Eh？不是這杯。", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "Chigau，不好意思。", "src": "Chigau, sorry."},
{"key": "data.voice.midwest.another.0", "text": "麻煩再來一杯！", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "再一杯，謝謝喔！", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "Ope，一樣再來一杯！", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "喔，這樣很好。", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "好的，謝謝。", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "一點也不差。", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "喔。嗯。那好吧。", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "Ope，不好意思……我走。", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "這有點過頭了，不過好吧。", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "Oh gosh，我真的等不下去了。", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "那個，我該走了。", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "抱歉，我先走一步。", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "可以給我一杯{drink}嗎？太感謝了。", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "不麻煩的話，來杯{drink}。", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "喔，我來杯{drink}就好。", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink}，謝謝。不急喔。", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "喔，真不錯！", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "You betcha！沒錯！", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "Oh jeez，太好了！", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "Oh my gosh，真的好好喝。", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "真不錯。我阿姨一定會愛上這裡。", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "嗯，正是我想要的。", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "喔，{advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "跟你說一下喔，{advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "沒什麼大不了，不過{advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "Ope，拿錯了。", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "喔，那不是我的。", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "抱歉，不是這杯。", "src": "Sorry, no. Not this."},
{"key": "data.voice.polish.another.0", "text": "Jeszcze raz！再一杯！", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "再來一杯，proszę！", "src": "Another, proszę!"},
