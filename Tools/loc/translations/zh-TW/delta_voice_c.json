{"key": "data.voice.polish.leaving.2", "text": "Do widzenia，再見。", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "一杯{drink}，proszę。", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "{drink}，麻煩你。", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "一杯{drink}。謝謝。", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "Dobrze，來杯{drink}。", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "Na zdrowie！乾杯！", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "Świetnie！太棒了！", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "很好！", "src": "Very good!"},
