{"key": "data.voice.surfer.leaving.2", "text": "嗯……不了。先溜了。", "src": "Yeah, no. Bailing."},
{"key": "data.voice.surfer.order.0", "text": "Dude，來杯{drink}。", "src": "Dude, a {drink}."},
{"key": "data.voice.surfer.order.1", "text": "可以給我，就是，一杯{drink}嗎？", "src": "Can I get, like, a {drink}?"},
{"key": "data.voice.surfer.order.2", "text": "{drink}，謝啦。Chill，不急。", "src": "{drink}, please. Chill, no rush."},
{"key": "data.voice.surfer.order.3", "text": "Yeah，來杯{drink}，超 epic。", "src": "Yeah, a {drink} sounds epic."},
{"key": "data.voice.surfer.perfect.0", "text": "Dude。就是它。", "src": "Dude. Yes."},
{"key": "data.voice.surfer.perfect.1", "text": "超 stoked！", "src": "Stoked!"},
{"key": "data.voice.surfer.perfect.2", "text": "超好喝！", "src": "So good!"},
{"key": "data.voice.surfer.praise.0", "text": "OK，這杯真的完美。Respect。", "src": "Okay, that's actually perfect. Respect."},
{"key": "data.voice.surfer.praise.1", "text": "Dude，不是開玩笑，太神了。", "src": "Dude. I'm not even kidding. Amazing."},
{"key": "data.voice.surfer.praise.2", "text": "Gnarly。是好的那種。", "src": "Gnarly. In a good way."},
{"key": "data.voice.surfer.sip.0", "text": "Dude，{advice_l}", "src": "Dude, {advice_l}"},
{"key": "data.voice.surfer.sip.1", "text": "那個喔，{advice_l}", "src": "Okay so, {advice_l}"},
{"key": "data.voice.surfer.sip.2", "text": "別有壓力，不過{advice_l}", "src": "No stress, but {advice_l}"},
{"key": "data.voice.surfer.wrong.0", "text": "呃，送錯酒了？", "src": "Uh, wrong drink?"},
{"key": "data.voice.surfer.wrong.1", "text": "不是這杯，dude。", "src": "Not it, dude."},
{"key": "data.voice.surfer.wrong.2", "text": "掃興。不是我的。", "src": "Bummer. Not mine."}
