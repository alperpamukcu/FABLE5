{"key": "data.voice.southern.order.3", "text": "一杯{drink}，sugar。", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "這可真棒！", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "Lord，真好喝！", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "Hot dang！沒話說！", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "哎呀呀，這才叫像樣的一杯酒。", "src": "Well, I'll be. That's a proper drink."},
{"key": "data.voice.southern.praise.1", "text": "Darlin'，你真有天分。", "src": "Darlin', you got a gift."},
{"key": "data.voice.southern.praise.2", "text": "我看我找到新據點了。", "src": "Reckon I found my new spot."},
{"key": "data.voice.southern.sip.0", "text": "我說啊，{advice_l}", "src": "Now, {advice_l}"},
{"key": "data.voice.southern.sip.1", "text": "Sugar，{advice_l}", "src": "Sugar, {advice_l}"},
{"key": "data.voice.southern.sip.2", "text": "跟你說，{advice_l}", "src": "Tell you what, {advice_l}"},
{"key": "data.voice.southern.wrong.0", "text": "這不是我的，hon。", "src": "Ain't mine, hon."},
{"key": "data.voice.southern.wrong.1", "text": "欸，這是什麼？", "src": "Now what is this?"},
{"key": "data.voice.southern.wrong.2", "text": "Bless your heart，不是這杯啦。", "src": "Bless your heart."}
]}
