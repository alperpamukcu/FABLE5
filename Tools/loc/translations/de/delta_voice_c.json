{"strings": [
{"key": "data.voice.aussie.another.0", "text": "Nochmal dasselbe, mate!", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "Noch einen, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "Noch einen, Legend!", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "Yeah, righto.", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "Nicht schlecht, mate.", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "Passt schon.", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "Ernsthaft, mate?", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto. Fair enough.", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Nah, das ist hart.", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto, ich hab lang genug gewartet.", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Nah, vergiss es. Ich bin weg.", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "Cheers für nichts, mate.", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "{drink}, mate.", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink}, bitte.", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "Ich nehm mal {drink}.", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "Einmal {drink}, cheers.", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "Ripper!", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "Too easy!", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "Verdammt gut!", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "Bloody Ripper, mate. Cheers.", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "Too easy. Du kennst dich aus.", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "Der beste heute Abend, ehrlich.", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "Hör mal, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "No dramas, aber {advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Nah, mate.", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "Nicht meiner, sorry.", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "Der falsche, mate.", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "Noch eine Runde!", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "Nochmal dasselbe!", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "Nur her damit!", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "Danke.", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "Passt schon.", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "Knapp, aber okay.", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "Im Ernst? Na gut.", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "Das ist ein Fehler.", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "Egal. Behalt deine Bar.", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "Vergiss es. Ich warte nicht länger.", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "Arbeitet hier heute überhaupt jemand?", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "Gut. Dann trink ich woanders.", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink}, bitte.", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "Ich nehme {drink}.", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "Einmal {drink}, wenn du kurz Zeit hast.", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "Für mich {drink}.", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "Perfekt!", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "Genau der!", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "Volltreffer!", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "Da würde ich nichts ändern.", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "Das ist mal ein Drink.", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "Wer's dir beigebracht hat: Sag danke.", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice} Nur so als Tipp.", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "Ehrlich gesagt, {advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "Hab ich nicht bestellt.", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "Falscher Drink.", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "Das ist nicht meiner.", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "Encore, bitte!", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "Noch einen, oui!", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "Nochmal, merci!", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ça va.", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "Passt schon.", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon, okay.", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "Quoi? Wirklich?", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Bon. Au revoir.", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule.", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non. Ich habe genug gewartet.", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis. Ich gehe.", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "Au revoir, dann.", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "{drink}, s'il vous plaît.", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "{drink}, bitte.", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "Un {drink}, merci.", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "Ich nehme {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "Parfait!", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "Voilà, perfekt!", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "Magnifique!", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait. Ich habe gar nichts anzumerken.", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voilà. Hier kann jemand einschenken.", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique. Wirklich.", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Écoute, {advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon, {advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors, {advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non.", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "Das ist er nicht.", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon, falsch.", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "Mou ippai!", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "Noch einen, kanpai!", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "Nochmal, onegai!", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Hai, okay.", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa.", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "Nicht schlecht, ne.", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "Eh?! Wirklich?", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi. Okay, ich gehe.", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta. Sayonara.", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen, ich kann nicht länger warten.", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii. Ich gehe.", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai. Auf Wiedersehen.", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen, einmal {drink}.", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "Einmal {drink}, onegai.", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink}, bitte. Arigatou.", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto… ich nehme {drink}.", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "Oishii!", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "Sugoi, perfekt!", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "Kanpai!", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii. Wirklich, das ist er.", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "Sugoi. Du bist ein Profi, ne.", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "Kanpai. Das ist perfekt.", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "Etto, {advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "Ne, {advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "Sumimasen, aber {advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "Chotto… nein.", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "Eh? Der nicht.", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "Chigau, Entschuldigung.", "src": "Chigau, sorry."},
{"key": "data.voice.midwest.another.0", "text": "Noch einen, bitte!", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "Noch einen, danke!", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "Nochmal dasselbe, ope!", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "Oh, das passt schon.", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "Klar, danke.", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "Gar nicht schlecht.", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "Oh. Na. Okay dann.", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "Ope, sorry… ich geh schon.", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "Bisschen viel, aber okay.", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "Oh gosh, ich kann echt nicht länger warten.", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "Na, ich sollte dann mal los.", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "Sorry, aber ich mach mich auf den Weg.", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "Könnte ich {drink} haben? Danke vielmals.", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "{drink}, wenn's keine Umstände macht.", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "Oh, nur {drink} für mich.", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink}, bitte. Ganz ohne Eile.", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "Oh, echt schön!", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "You betcha!", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "Oh jeez, ja!", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "Oh my gosh, das ist einfach herrlich.", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "Echt schön. Meiner Tante würd's hier gefallen.", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "Na, das tat gut.", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "Oh, {advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "Nur damit du's weißt, {advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "Keine große Sache, aber {advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "Ope. Der falsche.", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "Oh, das ist nicht meiner.", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "Sorry, nein. Der nicht.", "src": "Sorry, no. Not this."},
{"key": "data.voice.polish.another.0", "text": "Jeszcze raz!", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "Noch einen, proszę!", "src": "Another, proszę!"},
{"key": "data.voice.polish.another.2", "text": "Noch einer!", "src": "One more!"},
{"key": "data.voice.polish.close.0", "text": "Dobrze.", "src": "Dobrze."},
{"key": "data.voice.polish.close.1", "text": "Okay.", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "Passt, danke.", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "Serio? Okay.", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "Na gut. Do widzenia.", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "Co? Okay, ich geh.", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "Genug. Ich gehe.", "src": "Enough. I'm going."},
{"key": "data.voice.polish.leaving.1", "text": "Nie, nie. Zu lange.", "src": "Nie, nie. Too long."},
{"key": "data.voice.polish.leaving.2", "text": "Do widzenia.", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "{drink}, proszę.", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "{drink}, bitte.", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "Einmal {drink}. Danke.", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "Dobrze, einmal {drink}.", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "Na zdrowie!", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "Świetnie!", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "Sehr gut!", "src": "Very good!"},
{"key": "data.voice.polish.praise.0", "text": "Na zdrowie. Das ist ein echter Drink.", "src": "Na zdrowie. This is a real drink."},
{"key": "data.voice.polish.praise.1", "text": "Świetnie. Wie zu Hause.", "src": "Świetnie. Like at home."},
{"key": "data.voice.polish.praise.2", "text": "Dobrze. Sehr, sehr gut.", "src": "Dobrze. Very, very good."},
{"key": "data.voice.polish.sip.0", "text": "Dobrze, aber {advice_l}", "src": "Dobrze, but {advice_l}"},
{"key": "data.voice.polish.sip.1", "text": "Hör mal, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.polish.sip.2", "text": "Hm, {advice_l}", "src": "Hm, {advice_l}"},
{"key": "data.voice.polish.wrong.0", "text": "Nie. Der falsche.", "src": "Nie. Wrong one."},
{"key": "data.voice.polish.wrong.1", "text": "Das ist nicht meiner.", "src": "This is not mine."},
{"key": "data.voice.polish.wrong.2", "text": "Co to jest?", "src": "Co to jest?"},
{"key": "data.voice.turkish.another.0", "text": "Bir daha!", "src": "Bir daha!"},
{"key": "data.voice.turkish.another.1", "text": "Noch einen, abi!", "src": "Another, abi!"},
{"key": "data.voice.turkish.another.2", "text": "Nochmal, eyvallah!", "src": "Again, eyvallah!"},
{"key": "data.voice.turkish.close.0", "text": "Tamam.", "src": "Tamam."},
{"key": "data.voice.turkish.close.1", "text": "İdare eder.", "src": "İdare eder."},
{"key": "data.voice.turkish.close.2", "text": "Okay, passt.", "src": "Okay, fine."},
{"key": "data.voice.turkish.kicked.0", "text": "Ciddi misin? Okay.", "src": "Ciddi misin? Okay."},
{"key": "data.voice.turkish.kicked.1", "text": "Abi, echt jetzt? Na gut.", "src": "Abi, really? Fine."},
{"key": "data.voice.turkish.kicked.2", "text": "Yok, yok. Ich geh.", "src": "Yok, yok. I'm going."},
{"key": "data.voice.turkish.leaving.0", "text": "Yok, ich warte nicht mehr.", "src": "Yok, I'm not waiting anymore."},
{"key": "data.voice.turkish.leaving.1", "text": "Abi, arbeitet hier keiner?", "src": "Abi, is nobody working here?"},
{"key": "data.voice.turkish.leaving.2", "text": "Tamam, hoşça kal.", "src": "Tamam, hoşça kal."},
{"key": "data.voice.turkish.order.0", "text": "Abi, einmal {drink}.", "src": "Abi, a {drink}."},
{"key": "data.voice.turkish.order.1", "text": "{drink} für mich, eyvallah.", "src": "One {drink}, eyvallah."},
{"key": "data.voice.turkish.order.2", "text": "{drink}, canım, wenn du Zeit hast.", "src": "{drink}, canım, when you can."},
{"key": "data.voice.turkish.order.3", "text": "Bir {drink}, bitte.", "src": "Bir {drink}, please."},
{"key": "data.voice.turkish.perfect.0", "text": "Eyvallah!", "src": "Eyvallah!"},
{"key": "data.voice.turkish.perfect.1", "text": "Harika!", "src": "Harika!"},
{"key": "data.voice.turkish.perfect.2", "text": "Süper, abi!", "src": "Süper, abi!"},
{"key": "data.voice.turkish.praise.0", "text": "Eyvallah. So macht man das.", "src": "Eyvallah. This is how it's done."},
{"key": "data.voice.turkish.praise.1", "text": "Abi, Hut ab. Harika.", "src": "Abi, my hat is off. Harika."},
{"key": "data.voice.turkish.praise.2", "text": "Tamam, du verstehst dein Handwerk.", "src": "Tamam, you know your work."},
{"key": "data.voice.turkish.sip.0", "text": "Abi, {advice_l}", "src": "Abi, {advice_l}"},
{"key": "data.voice.turkish.sip.1", "text": "Bak, {advice_l}", "src": "Bak, {advice_l}"},
{"key": "data.voice.turkish.sip.2", "text": "Tamam ama, {advice_l}", "src": "Tamam ama, {advice_l}"},
