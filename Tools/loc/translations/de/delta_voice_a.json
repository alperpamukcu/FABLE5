{"strings": [
{"key": "data.voice.african.another.0", "text": "Bring noch einen!", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "Noch einer, abeg!", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "Nochmal, mein Freund!", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "Ist in Ordnung.", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "Passt, no wahala.", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "Okay, danke.", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "Ah ah! Im Ernst?", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala. Ich geh ja.", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "Mein Freund, das ist nicht schön.", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah ah. Ich hab genug gewartet.", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala. Ich gehe.", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "Ich geh dann, mein Freund.", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "{drink}, bitte.", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "Einmal {drink}, mein Freund.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Ich nehme {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "{drink}, abeg.", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "Ah, lecker!", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "Korrekt!", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "Der ist gut!", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, der ist korrekt. Danke dir.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "Null Wahala. Sehr schön.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "Mein Freund, du kennst dein Handwerk.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "Mein Freund, {advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg, {advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "Ist okay, aber {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah, nein.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "Das ist er nicht.", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "Mein Freund, nein.", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "Nochmal dasselbe, mate!", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "Noch einen, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "Na los, noch einer!", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "Nicht schlecht.", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Ta, passt schon.", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "Alright, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Charmant. Wirklich charmant.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "Right. Na dann. Cheers für nichts.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "Das ist ein Witz, oder?", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Right. Ich hab lang genug gewartet.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "Ach, vergiss es. Ich bin weg.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Ziemlich mies hier. Bye.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "{drink}, mate, wenn du kurz Zeit hast.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, bitte. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "Na dann, einmal {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "Ich nehm {drink}, ta.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "Lovely!", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "Cheers, mate!", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "Richtig gut!", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Blimey. Das ist wirklich lovely.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Das hast du ordentlich gemacht.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Bloody good, echt.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "Kleine Sache: {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Hör mal, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Bisschen daneben.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Ähm, nicht meiner.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "Hab ich nicht bestellt.", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "Noch einen, yaar!", "src": "One more, yaar!"},
{"key": "data.voice.desi.another.1", "text": "Aur ek!", "src": "Aur ek!"},
{"key": "data.voice.desi.another.2", "text": "Nochmal, bitte!", "src": "Again, please!"},
{"key": "data.voice.desi.close.0", "text": "Theek hai.", "src": "Theek hai."},
{"key": "data.voice.desi.close.1", "text": "Ist okay, na.", "src": "It is okay, na."},
{"key": "data.voice.desi.close.2", "text": "Chalega.", "src": "Chalega."},
{"key": "data.voice.desi.kicked.0", "text": "Kya? Im Ernst?", "src": "Kya? Seriously?"},
{"key": "data.voice.desi.kicked.1", "text": "Arre. Okay, gut.", "src": "Arre. Okay, fine."},
{"key": "data.voice.desi.kicked.2", "text": "Chalo. Ich geh.", "src": "Chalo. I go."},
{"key": "data.voice.desi.leaving.0", "text": "Arre yaar. Viel zu lang.", "src": "Arre yaar. Too long."},
{"key": "data.voice.desi.leaving.1", "text": "Chalo, ich gehe.", "src": "Chalo, I am going."},
{"key": "data.voice.desi.leaving.2", "text": "Bas. Es reicht.", "src": "Bas. Enough."},
{"key": "data.voice.desi.order.0", "text": "Einmal {drink}, bitte.", "src": "One {drink}, please."},
{"key": "data.voice.desi.order.1", "text": "{drink}, yaar.", "src": "A {drink}, yaar."},
{"key": "data.voice.desi.order.2", "text": "Ich nehme {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.desi.order.3", "text": "{drink}, na?", "src": "{drink}, na?"},
{"key": "data.voice.desi.perfect.0", "text": "Wah, perfekt!", "src": "Wah, perfect!"},
{"key": "data.voice.desi.perfect.1", "text": "Ekdum erste Klasse!", "src": "Ekdum first class!"},
{"key": "data.voice.desi.perfect.2", "text": "Bahut badhiya!", "src": "Bahut badhiya!"},
{"key": "data.voice.desi.praise.0", "text": "Wah. Ekdum perfekt, yaar.", "src": "Wah. Ekdum perfect, yaar."},
{"key": "data.voice.desi.praise.1", "text": "Bahut badhiya. Wirklich.", "src": "Bahut badhiya. Really."},
{"key": "data.voice.desi.praise.2", "text": "Erste Klasse. Ich komme wieder.", "src": "First class. I am coming back."},
{"key": "data.voice.desi.sip.0", "text": "Arre, {advice_l}", "src": "Arre, {advice_l}"},
{"key": "data.voice.desi.sip.1", "text": "Yaar, {advice_l}", "src": "Yaar, {advice_l}"},
{"key": "data.voice.desi.sip.2", "text": "Theek hai, aber {advice_l}", "src": "Theek hai, but {advice_l}"},
{"key": "data.voice.desi.wrong.0", "text": "Arre, nein.", "src": "Arre, no."},
{"key": "data.voice.desi.wrong.1", "text": "Das ist nicht meiner.", "src": "This is not mine."},
{"key": "data.voice.desi.wrong.2", "text": "Nahi, der falsche.", "src": "Nahi, wrong one."},
{"key": "data.voice.german.another.0", "text": "Noch eins!", "src": "Noch eins!"},
{"key": "data.voice.german.another.1", "text": "Mach noch einen!", "src": "Another, bitte!"},
{"key": "data.voice.german.another.2", "text": "Nochmal dasselbe, bitte!", "src": "Again, please!"},
{"key": "data.voice.german.close.0", "text": "Ja, passt.", "src": "Ja, okay."},
{"key": "data.voice.german.close.1", "text": "Geht klar.", "src": "Acceptable."},
{"key": "data.voice.german.close.2", "text": "Kann man trinken.", "src": "It is fine."},
{"key": "data.voice.german.kicked.0", "text": "Das ist doch absurd.", "src": "This is absurd."},
{"key": "data.voice.german.kicked.1", "text": "Schön. Mich siehst du nicht wieder.", "src": "Fine. I will not return."},
{"key": "data.voice.german.kicked.2", "text": "Ja, ja. Ich geh ja schon.", "src": "Ja, ja. I am going."},
{"key": "data.voice.german.leaving.0", "text": "Also, das geht gar nicht. Ich bin weg.", "src": "This is not acceptable. I am leaving."},
{"key": "data.voice.german.leaving.1", "text": "Nee. Ich hab lang genug gewartet.", "src": "Nein. I have waited enough."},
{"key": "data.voice.german.leaving.2", "text": "Unglaublich. Tschüss.", "src": "Unglaublich. Goodbye."},
{"key": "data.voice.german.order.0", "text": "Einmal {drink}, bitte. Aber ordentlich.", "src": "A {drink}, please. Correctly made."},
{"key": "data.voice.german.order.1", "text": "{drink}. Danke.", "src": "{drink}. Thank you."},
{"key": "data.voice.german.order.2", "text": "Für mich {drink}, bitte.", "src": "One {drink}, bitte."},
{"key": "data.voice.german.order.3", "text": "Ich hätte gern {drink}.", "src": "I would like a {drink}."},
{"key": "data.voice.german.perfect.0", "text": "Genau!", "src": "Genau!"},
{"key": "data.voice.german.perfect.1", "text": "Sehr gut!", "src": "Sehr gut!"},
{"key": "data.voice.german.perfect.2", "text": "Wunderbar!", "src": "Wunderbar!"},
{"key": "data.voice.german.praise.0", "text": "Ja. Genau so muss das.", "src": "Ja. This is exactly right."},
{"key": "data.voice.german.praise.1", "text": "Präzise. Das respektiere ich.", "src": "Precise. I respect precision."},
{"key": "data.voice.german.praise.2", "text": "Sehr gut. Nichts zu meckern.", "src": "Sehr gut. No notes."},
{"key": "data.voice.german.sip.0", "text": "Genau, aber {advice_l}", "src": "Genau, but {advice_l}"},
{"key": "data.voice.german.sip.1", "text": "Eine Anmerkung: {advice_l}", "src": "One remark: {advice_l}"},
{"key": "data.voice.german.sip.2", "text": "Ja, {advice_l}", "src": "Ja, {advice_l}"},
{"key": "data.voice.german.wrong.0", "text": "Nee. Das nicht.", "src": "Nein. Not this."},
{"key": "data.voice.german.wrong.1", "text": "Das ist falsch.", "src": "This is incorrect."},
{"key": "data.voice.german.wrong.2", "text": "Falscher Drink.", "src": "Wrong drink."},
{"key": "data.voice.korean.another.0", "text": "Han jan deo!", "src": "Han jan deo!"},
{"key": "data.voice.korean.another.1", "text": "Noch einen!", "src": "One more!"},
{"key": "data.voice.korean.another.2", "text": "Nochmal, juseyo!", "src": "Again, juseyo!"},
{"key": "data.voice.korean.close.0", "text": "Gwenchana.", "src": "Gwenchana."},
{"key": "data.voice.korean.close.1", "text": "Ist okay.", "src": "It is okay."},
{"key": "data.voice.korean.close.2", "text": "Nappeuji anha.", "src": "Nappeuji anha."},
{"key": "data.voice.korean.kicked.0", "text": "Jinjja? Wow.", "src": "Jinjja? Wow."},
{"key": "data.voice.korean.kicked.1", "text": "Aish. Na gut.", "src": "Aish. Fine."},
{"key": "data.voice.korean.kicked.2", "text": "Annyeong, dann.", "src": "Annyeong, then."},
{"key": "data.voice.korean.leaving.0", "text": "Aish. Viel zu lange.", "src": "Aish. Too long."},
{"key": "data.voice.korean.leaving.1", "text": "Ich gehe. Annyeong.", "src": "I am going. Annyeong."},
{"key": "data.voice.korean.leaving.2", "text": "Mot chamgesseo.", "src": "Mot chamgesseo."},
{"key": "data.voice.korean.order.0", "text": "{drink}, juseyo.", "src": "{drink}, juseyo."},
{"key": "data.voice.korean.order.1", "text": "Einmal {drink}, bitte.", "src": "One {drink}, please."},
{"key": "data.voice.korean.order.2", "text": "{drink} für mich.", "src": "A {drink} for me."},
{"key": "data.voice.korean.order.3", "text": "Ich möchte {drink}.", "src": "I want a {drink}."},
{"key": "data.voice.korean.perfect.0", "text": "Daebak!", "src": "Daebak!"},
{"key": "data.voice.korean.perfect.1", "text": "Jinjja gut!", "src": "Jinjja good!"},
{"key": "data.voice.korean.perfect.2", "text": "Choego!", "src": "Choego!"},
{"key": "data.voice.korean.praise.0", "text": "Daebak. Jinjja, das ist perfekt.", "src": "Daebak. Jinjja, this is perfect."},
{"key": "data.voice.korean.praise.1", "text": "Choego. Ehrlich.", "src": "Choego. I mean it."},
{"key": "data.voice.korean.praise.2", "text": "Wow. Du kannst das richtig.", "src": "Wow. You are good at this."},
{"key": "data.voice.korean.sip.0", "text": "Jamkkanman, {advice_l}", "src": "Jamkkanman, {advice_l}"},
{"key": "data.voice.korean.sip.1", "text": "Ähm, {advice_l}", "src": "Um, {advice_l}"},
{"key": "data.voice.korean.sip.2", "text": "Gwenchana, aber {advice_l}", "src": "Gwenchana, but {advice_l}"},
{"key": "data.voice.korean.wrong.0", "text": "Aniyo, nein.", "src": "Aniyo, no."},
{"key": "data.voice.korean.wrong.1", "text": "Das ist falsch.", "src": "This is wrong."},
{"key": "data.voice.korean.wrong.2", "text": "Eh? Nicht meiner.", "src": "Eh? Not mine."},
{"key": "data.voice.nordic.another.0", "text": "Noch einen. Skål!", "src": "Another. Skål!"},
{"key": "data.voice.nordic.another.1", "text": "Noch einer.", "src": "One more."},
{"key": "data.voice.nordic.another.2", "text": "Nochmal, bitte.", "src": "Again, please."},
{"key": "data.voice.nordic.close.0", "text": "Gut.", "src": "Fine."},
{"key": "data.voice.nordic.close.1", "text": "Ist okay.", "src": "It's okay."},
{"key": "data.voice.nordic.close.2", "text": "Reicht schon.", "src": "Good enough."},
{"key": "data.voice.nordic.kicked.0", "text": "Okay. Seltsam, aber okay.", "src": "Okay. Strange, but okay."},
{"key": "data.voice.nordic.kicked.1", "text": "Na gut.", "src": "Fine."},
{"key": "data.voice.nordic.kicked.2", "text": "Hm. Hej då, dann.", "src": "Hm. Goodbye then."},
{"key": "data.voice.nordic.leaving.0", "text": "Ich geh. Ist schon gut.", "src": "I'll go. It's fine."},
{"key": "data.voice.nordic.leaving.1", "text": "Zu lange. Hej då.", "src": "Too long. Goodbye."},
{"key": "data.voice.nordic.leaving.2", "text": "Nein. Ich gehe.", "src": "No. I'm leaving."},
{"key": "data.voice.nordic.order.0", "text": "{drink}. Danke.", "src": "A {drink}. Thanks."},
{"key": "data.voice.nordic.order.1", "text": "{drink}, bitte.", "src": "{drink}, please."},
{"key": "data.voice.nordic.order.2", "text": "Einmal {drink}. Keine Eile.", "src": "One {drink}. No rush."},
{"key": "data.voice.nordic.order.3", "text": "Ich nehme {drink}.", "src": "I'll have the {drink}."},
{"key": "data.voice.nordic.perfect.0", "text": "Skål!", "src": "Skål!"},
{"key": "data.voice.nordic.perfect.1", "text": "Sehr gut.", "src": "Very good."},
{"key": "data.voice.nordic.perfect.2", "text": "Ja. Gut.", "src": "Yes. Good."},
{"key": "data.voice.nordic.praise.0", "text": "Das ist sehr gut. Sage ich sonst nie.", "src": "This is very good. I don't say that."},
{"key": "data.voice.nordic.praise.1", "text": "Skål. Sauber gemacht.", "src": "Skål. Properly done."},
{"key": "data.voice.nordic.praise.2", "text": "Gut. Wirklich gut.", "src": "Good. Really good."},
{"key": "data.voice.nordic.sip.0", "text": "Tja. {advice}", "src": "Well. {advice}"},
{"key": "data.voice.nordic.sip.1", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.nordic.sip.2", "text": "Gut, aber {advice_l}", "src": "Fine, but {advice_l}"},
{"key": "data.voice.nordic.wrong.0", "text": "Nein. Der falsche.", "src": "No. Wrong one."},
{"key": "data.voice.nordic.wrong.1", "text": "Das ist er nicht.", "src": "This is not it."},
{"key": "data.voice.nordic.wrong.2", "text": "Hm. Nicht meiner.", "src": "Hm. Not mine."},
{"key": "data.voice.southern.another.0", "text": "Schenk mir noch einen ein!", "src": "Pour me another!"},
{"key": "data.voice.southern.another.1", "text": "Noch einen, Sugar!", "src": "One more, sugar!"},
{"key": "data.voice.southern.another.2", "text": "Immer her damit, y'all!", "src": "Keep 'em comin'!"},
{"key": "data.voice.southern.close.0", "text": "Is' schon recht.", "src": "That's alright."},
{"key": "data.voice.southern.close.1", "text": "Fair enough.", "src": "Fair enough."},
{"key": "data.voice.southern.close.2", "text": "Na, das tut's.", "src": "Well, it'll do."},
{"key": "data.voice.southern.kicked.0", "text": "Na, das ist aber unhöflich.", "src": "Well, that's just rude."},
{"key": "data.voice.southern.kicked.1", "text": "Alright then. Schönen Abend noch.", "src": "Alright then. Have a good one."},
{"key": "data.voice.southern.kicked.2", "text": "Moment mal… na gut.", "src": "Now hold on… fine."},
{"key": "data.voice.southern.leaving.0", "text": "Ich hab nicht die ganze Nacht Zeit, Darlin'.", "src": "Well, I ain't got all night."},
{"key": "data.voice.southern.leaving.1", "text": "Ich schätze, ich trink woanders.", "src": "Reckon I'll drink elsewhere."},
{"key": "data.voice.southern.leaving.2", "text": "Y'all lasst euch aber Zeit, was?", "src": "Y'all take your sweet time, don't you."},
{"key": "data.voice.southern.order.0", "text": "Well now, {drink} wär mir recht.", "src": "Well now, a {drink} would suit me."},
{"key": "data.voice.southern.order.1", "text": "{drink}, Darlin', wenn's recht ist.", "src": "{drink}, darlin', if you please."},
{"key": "data.voice.southern.order.2", "text": "Ich schätze, ich nehm {drink}.", "src": "Reckon I'll have a {drink}."},
{"key": "data.voice.southern.order.3", "text": "Einmal {drink}, Sugar.", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "Ist das fein!", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "Lord, ist das gut!", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "Hot dang!", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "Well, I'll be. Das ist ein richtiger Drink.", "src": "Well, I'll be. That's a proper drink."},
{"key": "data.voice.southern.praise.1", "text": "Darlin', du hast ein Talent.", "src": "Darlin', you got a gift."},
{"key": "data.voice.southern.praise.2", "text": "Ich glaub, das ist mein neuer Stammplatz.", "src": "Reckon I found my new spot."},
{"key": "data.voice.southern.sip.0", "text": "Also, {advice_l}", "src": "Now, {advice_l}"},
{"key": "data.voice.southern.sip.1", "text": "Sugar, {advice_l}", "src": "Sugar, {advice_l}"},
{"key": "data.voice.southern.sip.2", "text": "Weißt du was, {advice_l}", "src": "Tell you what, {advice_l}"},
{"key": "data.voice.southern.wrong.0", "text": "Das ist nicht meiner, Hon.", "src": "Ain't mine, hon."},
{"key": "data.voice.southern.wrong.1", "text": "Na, was ist denn das?", "src": "Now what is this?"},
{"key": "data.voice.southern.wrong.2", "text": "Bless your heart.", "src": "Bless your heart."}
]}
