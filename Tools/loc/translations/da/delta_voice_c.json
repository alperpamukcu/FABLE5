{"strings": [
{"key": "data.voice.aussie.another.0", "text": "Samme igen, mate!", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "Én til, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "En til, legend!", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "Yeah, righto.", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "Ikke dårligt, mate.", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "Den går.", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "Seriøst, mate?", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto. Fair nok.", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Nah, det er hårdt.", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto, nu har jeg ventet længe nok.", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Nah, glem det. Så går jeg.", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "Cheers for ingenting, mate.", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "{drink}, mate.", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink}, tak.", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "Jeg snupper lige {drink}.", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "{drink}, cheers.", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "Ripper!", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "Too easy!", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "Bloody godt!", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "Bloody ripper, mate. Cheers.", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "Too easy. Du kan dit stof.", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "Aftenens bedste, helt ærligt.", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "Hør, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "No dramas, men {advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Nah, mate.", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "Ikke min, sorry.", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "Forkert, mate.", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "En omgang til!", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "Det samme igen!", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "Bare kom med flere!", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "Tak.", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "Den går.", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "Tæt nok på.", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "Seriøst? Fint.", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "Du begår en fejl.", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "Lige meget. Behold din bar.", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "Glem det. Jeg gider ikke vente mere.", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "Er der nogen på arbejde i aften?", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "Nå. Så drikker jeg et andet sted.", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink}, tak.", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "Jeg tager {drink}.", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "{drink}, når du lige har et øjeblik.", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "Lad det blive {drink}.", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "Perfekt!", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "Det er den!", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "Lige i øjet!", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "Der er intet, jeg ville ændre.", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "Det kalder jeg en drink.", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "Hvem der end har lært dig det, så sig tak.", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice} Jeg siger det bare.", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "Ærligt talt? {advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "Det bestilte jeg ikke.", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "Forkert drink.", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "Den er ikke min.", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "Encore, tak!", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "En til, oui!", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "Igen, merci!", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ça va.", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "Det er fint.", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon, okay.", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "Quoi? Virkelig?", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Bon. Au revoir.", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule.", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non. Nu har jeg ventet nok.", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis. Jeg går.", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "Au revoir, så.", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "{drink}, s'il vous plaît.", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "{drink}, tak.", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "{drink}, merci.", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "Jeg tager {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "Parfait!", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "Voilà, perfekt!", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "Magnifique!", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait. Jeg har slet ingen bemærkninger.", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voilà. Her er nogen, der kan skænke.", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique. Virkelig.", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Écoute, {advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon, {advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors, {advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non.", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "Det er ikke den.", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon, forkert.", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "Mou ippai!", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "En til, kanpai!", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "Igen, onegai!", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Hai, okay.", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa.", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "Ikke dårligt, ne.", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "Eh?! Virkelig?", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi. Okay, jeg går.", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta. Sayonara.", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen, jeg kan ikke vente længere.", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii. Jeg går.", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai. Farvel.", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen, {drink}.", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "{drink}, onegai.", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink}, tak. Arigatou.", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto… {drink}, tak.", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "Oishii!", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "Sugoi, perfekt!", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "Kanpai!", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii. Virkelig, det er den.", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "Sugoi. Du er en pro, ne.", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "Kanpai. Den er perfekt.", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "Etto, {advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "Ne, {advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "Sumimasen, men {advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "Chotto… nej.", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "Eh? Ikke den her.", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "Chigau, undskyld.", "src": "Chigau, sorry."},
{"key": "data.voice.midwest.another.0", "text": "En til, tak!", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "Én mere, tak skal du have!", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "Det samme igen, ope!", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "Åh, det er fint.", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "Jo da, tak.", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "Slet ikke dårligt.", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "Åh. Nå. Okay så.", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "Ope, undskyld… jeg går.", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "Det er lidt meget, men okay.", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "Oh gosh, jeg kan altså ikke vente længere.", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "Nå, jeg må hellere se at komme afsted.", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "Undskyld, men jeg smutter.", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "Kunne jeg få {drink}? Thanks a bunch.", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "{drink}, hvis det ikke er til besvær.", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "Åh, bare {drink} til mig.", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink}, tak. Når det passer.", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "Åh, rigtig fint!", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "You betcha!", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "Oh jeez, ja!", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "Oh my gosh, den er simpelthen dejlig.", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "Rigtig fint. Min moster ville elske det her sted.", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "Nå, den ramte lige plet.", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "Åh, {advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "Bare så du ved det, {advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "Ikke noget stort, men {advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "Ope. Forkert.", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "Åh, den er ikke min.", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "Undskyld, nej. Ikke den her.", "src": "Sorry, no. Not this."},
{"key": "data.voice.polish.another.0", "text": "Jeszcze raz!", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "En til, proszę!", "src": "Another, proszę!"},
{"key": "data.voice.polish.another.2", "text": "Én mere!", "src": "One more!"},
{"key": "data.voice.polish.close.0", "text": "Dobrze.", "src": "Dobrze."},
{"key": "data.voice.polish.close.1", "text": "Okay.", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "Fint, tak.", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "Serio? Okay.", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "Fint. Do widzenia.", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "Co? Okay, jeg går.", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "Nu er det nok. Jeg går.", "src": "Enough. I'm going."},
{"key": "data.voice.polish.leaving.1", "text": "Nie, nie. Alt for længe.", "src": "Nie, nie. Too long."},
{"key": "data.voice.polish.leaving.2", "text": "Do widzenia.", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "{drink}, proszę.", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "{drink}, tak.", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "{drink}. Tak skal du have.", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "Dobrze, {drink} til mig.", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "Na zdrowie!", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "Świetnie!", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "Meget godt!", "src": "Very good!"},
{"key": "data.voice.polish.praise.0", "text": "Na zdrowie. Det her er en rigtig drink.", "src": "Na zdrowie. This is a real drink."},
{"key": "data.voice.polish.praise.1", "text": "Świetnie. Ligesom hjemme.", "src": "Świetnie. Like at home."},
{"key": "data.voice.polish.praise.2", "text": "Dobrze. Meget, meget god.", "src": "Dobrze. Very, very good."},
{"key": "data.voice.polish.sip.0", "text": "Dobrze, men {advice_l}", "src": "Dobrze, but {advice_l}"},
{"key": "data.voice.polish.sip.1", "text": "Hør her, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.polish.sip.2", "text": "Hm, {advice_l}", "src": "Hm, {advice_l}"},
{"key": "data.voice.polish.wrong.0", "text": "Nie. Forkert.", "src": "Nie. Wrong one."},
{"key": "data.voice.polish.wrong.1", "text": "Den her er ikke min.", "src": "This is not mine."},
{"key": "data.voice.polish.wrong.2", "text": "Co to jest?", "src": "Co to jest?"},
{"key": "data.voice.turkish.another.0", "text": "Bir daha!", "src": "Bir daha!"},
{"key": "data.voice.turkish.another.1", "text": "En til, abi!", "src": "Another, abi!"},
{"key": "data.voice.turkish.another.2", "text": "Igen, eyvallah!", "src": "Again, eyvallah!"},
{"key": "data.voice.turkish.close.0", "text": "Tamam.", "src": "Tamam."},
{"key": "data.voice.turkish.close.1", "text": "İdare eder.", "src": "İdare eder."},
{"key": "data.voice.turkish.close.2", "text": "Okay, fint.", "src": "Okay, fine."},
{"key": "data.voice.turkish.kicked.0", "text": "Ciddi misin? Okay.", "src": "Ciddi misin? Okay."},
{"key": "data.voice.turkish.kicked.1", "text": "Abi, virkelig? Fint.", "src": "Abi, really? Fine."},
{"key": "data.voice.turkish.kicked.2", "text": "Yok, yok. Jeg går.", "src": "Yok, yok. I'm going."},
{"key": "data.voice.turkish.leaving.0", "text": "Yok, jeg venter ikke længere.", "src": "Yok, I'm not waiting anymore."},
{"key": "data.voice.turkish.leaving.1", "text": "Abi, er der ingen på arbejde her?", "src": "Abi, is nobody working here?"},
{"key": "data.voice.turkish.leaving.2", "text": "Tamam, hoşça kal.", "src": "Tamam, hoşça kal."},
{"key": "data.voice.turkish.order.0", "text": "Abi, {drink}.", "src": "Abi, a {drink}."},
{"key": "data.voice.turkish.order.1", "text": "{drink}, eyvallah.", "src": "One {drink}, eyvallah."},
{"key": "data.voice.turkish.order.2", "text": "{drink}, canım, når du kan.", "src": "{drink}, canım, when you can."},
{"key": "data.voice.turkish.order.3", "text": "Bir {drink}, tak.", "src": "Bir {drink}, please."},
{"key": "data.voice.turkish.perfect.0", "text": "Eyvallah!", "src": "Eyvallah!"},
{"key": "data.voice.turkish.perfect.1", "text": "Harika!", "src": "Harika!"},
{"key": "data.voice.turkish.perfect.2", "text": "Süper, abi!", "src": "Süper, abi!"},
{"key": "data.voice.turkish.praise.0", "text": "Eyvallah. Sådan skal det gøres.", "src": "Eyvallah. This is how it's done."},
{"key": "data.voice.turkish.praise.1", "text": "Abi, jeg tager hatten af. Harika.", "src": "Abi, my hat is off. Harika."},
{"key": "data.voice.turkish.praise.2", "text": "Tamam, du kan dit håndværk.", "src": "Tamam, you know your work."},
{"key": "data.voice.turkish.sip.0", "text": "Abi, {advice_l}", "src": "Abi, {advice_l}"},
{"key": "data.voice.turkish.sip.1", "text": "Bak, {advice_l}", "src": "Bak, {advice_l}"},
{"key": "data.voice.turkish.sip.2", "text": "Tamam ama, {advice_l}", "src": "Tamam ama, {advice_l}"},
