{"strings": [
{"key": "data.voice.african.another.0", "text": "Kom med en til!", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "En til, abeg!", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "Igen, min ven!", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "Det er fint.", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "No wahala.", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "Okay, tak.", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "Ah ah! Seriøst?", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala. Jeg går.", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "Min ven, det her er ikke i orden.", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah ah. Nu har jeg ventet nok.", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala. Jeg smutter.", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "Lad mig gå, min ven.", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "{drink}, tak.", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "{drink} til mig, min ven.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Jeg vil gerne have {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "{drink}, abeg.", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "Ah, lækkert!", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "Helt rigtigt!", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "Den her er god!", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, den her er helt rigtig. Tak.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "Slet ingen wahala. Rigtig fin.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "Min ven, du kan dit kram.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "Min ven, {advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg, {advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "Det er fint, men {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah, nej.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "Det er ikke den.", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "Min ven, nej.", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "Det samme igen, mate!", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "En til, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "Kom nu, en til!", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "Ikke dårligt.", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Ta, den går.", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "Fint nok, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Charmerende. Virkelig charmerende.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "Nå. Godt. Cheers for ingenting.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "Det mener du ikke.", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Nå. Nu har jeg ventet længe nok.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "Glem det. Jeg smutter.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Ret ringe, det her. Bye.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "{drink}, mate, når du har et øjeblik.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, tak. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "Så lad gå, {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "{drink} til mig, ta.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "Lovely!", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "Cheers, mate!", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "Ordentlig godt!", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Blimey. Den er faktisk lovely.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Det der er gjort ordentligt.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Pokkers god, den der.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "Lige en lille ting: {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Hør, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Lidt ved siden af, den der.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Øh, ikke min.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "Det bestilte jeg ikke.", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "En til, yaar!", "src": "One more, yaar!"},
{"key": "data.voice.desi.another.1", "text": "Aur ek!", "src": "Aur ek!"},
{"key": "data.voice.desi.another.2", "text": "Igen, tak!", "src": "Again, please!"},
{"key": "data.voice.desi.close.0", "text": "Theek hai.", "src": "Theek hai."},
{"key": "data.voice.desi.close.1", "text": "Den er okay, na.", "src": "It is okay, na."},
{"key": "data.voice.desi.close.2", "text": "Chalega.", "src": "Chalega."},
{"key": "data.voice.desi.kicked.0", "text": "Kya? Seriøst?", "src": "Kya? Seriously?"},
{"key": "data.voice.desi.kicked.1", "text": "Arre. Okay, fint.", "src": "Arre. Okay, fine."},
{"key": "data.voice.desi.kicked.2", "text": "Chalo. Jeg går.", "src": "Chalo. I go."},
{"key": "data.voice.desi.leaving.0", "text": "Arre yaar. Alt for længe.", "src": "Arre yaar. Too long."},
{"key": "data.voice.desi.leaving.1", "text": "Chalo, nu går jeg.", "src": "Chalo, I am going."},
{"key": "data.voice.desi.leaving.2", "text": "Bas. Nu er det nok.", "src": "Bas. Enough."},
{"key": "data.voice.desi.order.0", "text": "{drink}, tak.", "src": "One {drink}, please."},
{"key": "data.voice.desi.order.1", "text": "{drink} til mig, yaar.", "src": "A {drink}, yaar."},
{"key": "data.voice.desi.order.2", "text": "Jeg tager {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.desi.order.3", "text": "{drink}, na?", "src": "{drink}, na?"},
{"key": "data.voice.desi.perfect.0", "text": "Wah, perfekt!", "src": "Wah, perfect!"},
{"key": "data.voice.desi.perfect.1", "text": "Ekdum first class!", "src": "Ekdum first class!"},
{"key": "data.voice.desi.perfect.2", "text": "Bahut badhiya!", "src": "Bahut badhiya!"},
{"key": "data.voice.desi.praise.0", "text": "Wah. Ekdum perfekt, yaar.", "src": "Wah. Ekdum perfect, yaar."},
{"key": "data.voice.desi.praise.1", "text": "Bahut badhiya. Virkelig.", "src": "Bahut badhiya. Really."},
{"key": "data.voice.desi.praise.2", "text": "First class. Jeg kommer igen.", "src": "First class. I am coming back."},
{"key": "data.voice.desi.sip.0", "text": "Arre, {advice_l}", "src": "Arre, {advice_l}"},
{"key": "data.voice.desi.sip.1", "text": "Yaar, {advice_l}", "src": "Yaar, {advice_l}"},
{"key": "data.voice.desi.sip.2", "text": "Theek hai, men {advice_l}", "src": "Theek hai, but {advice_l}"},
{"key": "data.voice.desi.wrong.0", "text": "Arre, nej.", "src": "Arre, no."},
{"key": "data.voice.desi.wrong.1", "text": "Den her er ikke min.", "src": "This is not mine."},
{"key": "data.voice.desi.wrong.2", "text": "Nahi, forkert.", "src": "Nahi, wrong one."},
{"key": "data.voice.german.another.0", "text": "Noch eins!", "src": "Noch eins!"},
{"key": "data.voice.german.another.1", "text": "En til, bitte!", "src": "Another, bitte!"},
{"key": "data.voice.german.another.2", "text": "Igen, tak!", "src": "Again, please!"},
{"key": "data.voice.german.close.0", "text": "Ja, okay.", "src": "Ja, okay."},
{"key": "data.voice.german.close.1", "text": "Acceptabelt.", "src": "Acceptable."},
{"key": "data.voice.german.close.2", "text": "Det er i orden.", "src": "It is fine."},
{"key": "data.voice.german.kicked.0", "text": "Det her er absurd.", "src": "This is absurd."},
{"key": "data.voice.german.kicked.1", "text": "Fint. Jeg kommer ikke igen.", "src": "Fine. I will not return."},
{"key": "data.voice.german.kicked.2", "text": "Ja, ja. Jeg går.", "src": "Ja, ja. I am going."},
{"key": "data.voice.german.leaving.0", "text": "Det er ikke acceptabelt. Jeg går.", "src": "This is not acceptable. I am leaving."},
{"key": "data.voice.german.leaving.1", "text": "Nein. Nu har jeg ventet nok.", "src": "Nein. I have waited enough."},
{"key": "data.voice.german.leaving.2", "text": "Unglaublich. Farvel.", "src": "Unglaublich. Goodbye."},
{"key": "data.voice.german.order.0", "text": "{drink}, tak. Korrekt lavet.", "src": "A {drink}, please. Correctly made."},
{"key": "data.voice.german.order.1", "text": "{drink}. Tak.", "src": "{drink}. Thank you."},
{"key": "data.voice.german.order.2", "text": "{drink}, bitte.", "src": "One {drink}, bitte."},
{"key": "data.voice.german.order.3", "text": "Jeg vil gerne have {drink}.", "src": "I would like a {drink}."},
{"key": "data.voice.german.perfect.0", "text": "Genau!", "src": "Genau!"},
{"key": "data.voice.german.perfect.1", "text": "Sehr gut!", "src": "Sehr gut!"},
{"key": "data.voice.german.perfect.2", "text": "Wunderbar!", "src": "Wunderbar!"},
{"key": "data.voice.german.praise.0", "text": "Ja. Den her er præcis rigtig.", "src": "Ja. This is exactly right."},
{"key": "data.voice.german.praise.1", "text": "Præcist. Jeg respekterer præcision.", "src": "Precise. I respect precision."},
{"key": "data.voice.german.praise.2", "text": "Sehr gut. Ingen bemærkninger.", "src": "Sehr gut. No notes."},
{"key": "data.voice.german.sip.0", "text": "Genau, men {advice_l}", "src": "Genau, but {advice_l}"},
{"key": "data.voice.german.sip.1", "text": "En bemærkning: {advice_l}", "src": "One remark: {advice_l}"},
{"key": "data.voice.german.sip.2", "text": "Ja, {advice_l}", "src": "Ja, {advice_l}"},
{"key": "data.voice.german.wrong.0", "text": "Nein. Ikke den her.", "src": "Nein. Not this."},
{"key": "data.voice.german.wrong.1", "text": "Det her er forkert.", "src": "This is incorrect."},
{"key": "data.voice.german.wrong.2", "text": "Forkert drink.", "src": "Wrong drink."},
{"key": "data.voice.korean.another.0", "text": "Han jan deo!", "src": "Han jan deo!"},
{"key": "data.voice.korean.another.1", "text": "En til!", "src": "One more!"},
{"key": "data.voice.korean.another.2", "text": "Igen, juseyo!", "src": "Again, juseyo!"},
{"key": "data.voice.korean.close.0", "text": "Gwenchana.", "src": "Gwenchana."},
{"key": "data.voice.korean.close.1", "text": "Den er okay.", "src": "It is okay."},
{"key": "data.voice.korean.close.2", "text": "Nappeuji anha.", "src": "Nappeuji anha."},
{"key": "data.voice.korean.kicked.0", "text": "Jinjja? Wow.", "src": "Jinjja? Wow."},
{"key": "data.voice.korean.kicked.1", "text": "Aish. Fint.", "src": "Aish. Fine."},
{"key": "data.voice.korean.kicked.2", "text": "Annyeong, så.", "src": "Annyeong, then."},
{"key": "data.voice.korean.leaving.0", "text": "Aish. Alt for længe.", "src": "Aish. Too long."},
{"key": "data.voice.korean.leaving.1", "text": "Jeg går. Annyeong.", "src": "I am going. Annyeong."},
{"key": "data.voice.korean.leaving.2", "text": "Mot chamgesseo. Jeg gider ikke mere.", "src": "Mot chamgesseo."},
{"key": "data.voice.korean.order.0", "text": "{drink}, juseyo.", "src": "{drink}, juseyo."},
{"key": "data.voice.korean.order.1", "text": "{drink}, tak.", "src": "One {drink}, please."},
{"key": "data.voice.korean.order.2", "text": "{drink} til mig.", "src": "A {drink} for me."},
{"key": "data.voice.korean.order.3", "text": "Jeg vil have {drink}.", "src": "I want a {drink}."},
{"key": "data.voice.korean.perfect.0", "text": "Daebak!", "src": "Daebak!"},
{"key": "data.voice.korean.perfect.1", "text": "Jinjja godt!", "src": "Jinjja good!"},
{"key": "data.voice.korean.perfect.2", "text": "Choego!", "src": "Choego!"},
{"key": "data.voice.korean.praise.0", "text": "Daebak. Jinjja, den her er perfekt.", "src": "Daebak. Jinjja, this is perfect."},
{"key": "data.voice.korean.praise.1", "text": "Choego. Det mener jeg.", "src": "Choego. I mean it."},
{"key": "data.voice.korean.praise.2", "text": "Wow. Du er god til det her.", "src": "Wow. You are good at this."},
{"key": "data.voice.korean.sip.0", "text": "Jamkkanman, {advice_l}", "src": "Jamkkanman, {advice_l}"},
{"key": "data.voice.korean.sip.1", "text": "Øh, {advice_l}", "src": "Um, {advice_l}"},
{"key": "data.voice.korean.sip.2", "text": "Gwenchana, men {advice_l}", "src": "Gwenchana, but {advice_l}"},
{"key": "data.voice.korean.wrong.0", "text": "Aniyo, nej.", "src": "Aniyo, no."},
{"key": "data.voice.korean.wrong.1", "text": "Det her er forkert.", "src": "This is wrong."},
{"key": "data.voice.korean.wrong.2", "text": "Hva'? Ikke min.", "src": "Eh? Not mine."},
{"key": "data.voice.nordic.another.0", "text": "En til. Skål!", "src": "Another. Skål!"},
{"key": "data.voice.nordic.another.1", "text": "Lige en omgang mere.", "src": "One more."},
{"key": "data.voice.nordic.another.2", "text": "Samme igen, tak.", "src": "Again, please."},
{"key": "data.voice.nordic.close.0", "text": "Fint nok.", "src": "Fine."},
{"key": "data.voice.nordic.close.1", "text": "Den er okay.", "src": "It's okay."},
{"key": "data.voice.nordic.close.2", "text": "Den går.", "src": "Good enough."},
{"key": "data.voice.nordic.kicked.0", "text": "Okay. Mærkeligt, men okay.", "src": "Okay. Strange, but okay."},
{"key": "data.voice.nordic.kicked.1", "text": "Fint.", "src": "Fine."},
{"key": "data.voice.nordic.kicked.2", "text": "Hm. Så farvel da.", "src": "Hm. Goodbye then."},
{"key": "data.voice.nordic.leaving.0", "text": "Jeg går. Det er fint.", "src": "I'll go. It's fine."},
{"key": "data.voice.nordic.leaving.1", "text": "Alt for længe. Farvel.", "src": "Too long. Goodbye."},
{"key": "data.voice.nordic.leaving.2", "text": "Nej. Nu går jeg.", "src": "No. I'm leaving."},
{"key": "data.voice.nordic.order.0", "text": "{drink}. Tak.", "src": "A {drink}. Thanks."},
{"key": "data.voice.nordic.order.1", "text": "Lad mig få {drink}.", "src": "{drink}, please."},
{"key": "data.voice.nordic.order.2", "text": "{drink}. Ingen stress.", "src": "One {drink}. No rush."},
{"key": "data.voice.nordic.order.3", "text": "Jeg tager lige {drink}.", "src": "I'll have the {drink}."},
{"key": "data.voice.nordic.perfect.0", "text": "Skål!", "src": "Skål!"},
{"key": "data.voice.nordic.perfect.1", "text": "Rigtig godt.", "src": "Very good."},
{"key": "data.voice.nordic.perfect.2", "text": "Ja. Godt.", "src": "Yes. Good."},
{"key": "data.voice.nordic.praise.0", "text": "Den er sgu god. Det siger jeg ikke tit.", "src": "This is very good. I don't say that."},
{"key": "data.voice.nordic.praise.1", "text": "Skål. Ordentligt lavet.", "src": "Skål. Properly done."},
{"key": "data.voice.nordic.praise.2", "text": "Godt. Rigtig godt.", "src": "Good. Really good."},
{"key": "data.voice.nordic.sip.0", "text": "Nå. {advice}", "src": "Well. {advice}"},
{"key": "data.voice.nordic.sip.1", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.nordic.sip.2", "text": "Fint, men {advice_l}", "src": "Fine, but {advice_l}"},
{"key": "data.voice.nordic.wrong.0", "text": "Nej. Forkert.", "src": "No. Wrong one."},
{"key": "data.voice.nordic.wrong.1", "text": "Det er ikke den.", "src": "This is not it."},
{"key": "data.voice.nordic.wrong.2", "text": "Hm. Ikke min.", "src": "Hm. Not mine."},
{"key": "data.voice.southern.another.0", "text": "Hæld en til op!", "src": "Pour me another!"},
{"key": "data.voice.southern.another.1", "text": "En til, sugar!", "src": "One more, sugar!"},
{"key": "data.voice.southern.another.2", "text": "Bare bliv ved, darlin'!", "src": "Keep 'em comin'!"},
{"key": "data.voice.southern.close.0", "text": "Det er i orden.", "src": "That's alright."},
{"key": "data.voice.southern.close.1", "text": "Fair nok.", "src": "Fair enough."},
{"key": "data.voice.southern.close.2", "text": "Nå, den går.", "src": "Well, it'll do."},
{"key": "data.voice.southern.kicked.0", "text": "Nå, det var da uhøfligt.", "src": "Well, that's just rude."},
{"key": "data.voice.southern.kicked.1", "text": "Okay så. Have a good one.", "src": "Alright then. Have a good one."},
{"key": "data.voice.southern.kicked.2", "text": "Hov, vent nu lige… fint.", "src": "Now hold on… fine."},
{"key": "data.voice.southern.leaving.0", "text": "Nå, jeg har altså ikke hele natten.", "src": "Well, I ain't got all night."},
{"key": "data.voice.southern.leaving.1", "text": "Reckon jeg drikker et andet sted.", "src": "Reckon I'll drink elsewhere."},
{"key": "data.voice.southern.leaving.2", "text": "Y'all tager jer sandelig god tid, hva'?", "src": "Y'all take your sweet time, don't you."},
{"key": "data.voice.southern.order.0", "text": "Nå, {drink} ville passe mig fint.", "src": "Well now, a {drink} would suit me."},
{"key": "data.voice.southern.order.1", "text": "{drink}, darlin', hvis du vil være så venlig.", "src": "{drink}, darlin', if you please."},
{"key": "data.voice.southern.order.2", "text": "Tror, jeg tager {drink}.", "src": "Reckon I'll have a {drink}."},
{"key": "data.voice.southern.order.3", "text": "{drink}, sugar.", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "Er det ikke fint!", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "Lord, den er god!", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "Hot dang!", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "Well, I'll be. Det er en ordentlig drink.", "src": "Well, I'll be. That's a proper drink."},
{"key": "data.voice.southern.praise.1", "text": "Darlin', du har et talent.", "src": "Darlin', you got a gift."},
{"key": "data.voice.southern.praise.2", "text": "Tror, jeg har fundet mit nye stamsted.", "src": "Reckon I found my new spot."},
{"key": "data.voice.southern.sip.0", "text": "Nå, {advice_l}", "src": "Now, {advice_l}"},
{"key": "data.voice.southern.sip.1", "text": "Sugar, {advice_l}", "src": "Sugar, {advice_l}"},
{"key": "data.voice.southern.sip.2", "text": "Ved du hvad, {advice_l}", "src": "Tell you what, {advice_l}"},
{"key": "data.voice.southern.wrong.0", "text": "Ikke min, hon.", "src": "Ain't mine, hon."},
{"key": "data.voice.southern.wrong.1", "text": "Hvad er nu det her?", "src": "Now what is this?"},
{"key": "data.voice.southern.wrong.2", "text": "Bless your heart.", "src": "Bless your heart."}
]}
