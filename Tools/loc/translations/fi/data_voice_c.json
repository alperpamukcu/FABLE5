{"strings": [
{"key": "data.voice.italian.another.0", "text": "Ancora, dai!", "src": "Ancora, dai!"},
{"key": "data.voice.italian.another.1", "text": "Toinen, grazie!", "src": "Another, grazie!"},
{"key": "data.voice.italian.another.2", "text": "Vielä kerran, amore!", "src": "Once more, amore!"},
{"key": "data.voice.italian.close.0", "text": "Va bene.", "src": "Va bene."},
{"key": "data.voice.italian.close.1", "text": "Okei, grazie.", "src": "Okay, grazie."},
{"key": "data.voice.italian.close.2", "text": "Ei paha, eh.", "src": "Not bad, eh."},
{"key": "data.voice.italian.kicked.0", "text": "Ma dai! Oikeasti?", "src": "Ma dai! Really?"},
{"key": "data.voice.italian.kicked.1", "text": "Va bene. Ciao, ciao.", "src": "Va bene. Ciao, ciao."},
{"key": "data.voice.italian.kicked.2", "text": "Che maleducato.", "src": "Che maleducato."},
{"key": "data.voice.italian.leaving.0", "text": "Basta. Minä menen.", "src": "Basta. I go."},
{"key": "data.voice.italian.leaving.1", "text": "Mamma mia, tätä odottamista!", "src": "Mamma mia, the waiting!"},
{"key": "data.voice.italian.leaving.2", "text": "Ciao. Ehkä seuraavassa elämässä.", "src": "Ciao. Maybe next life."},
{"key": "data.voice.italian.order.0", "text": "Un {drink}, per favore.", "src": "Un {drink}, per favore."},
{"key": "data.voice.italian.order.1", "text": "{drink}, amore.", "src": "A {drink}, amore."},
{"key": "data.voice.italian.order.2", "text": "{drink}, grazie.", "src": "{drink}, grazie."},
{"key": "data.voice.italian.order.3", "text": "Dai, yksi {drink}.", "src": "Dai, a {drink}."},
{"key": "data.voice.italian.perfect.0", "text": "Perfetto!", "src": "Perfetto!"},
{"key": "data.voice.italian.perfect.1", "text": "Bravo!", "src": "Bravo!"},
{"key": "data.voice.italian.perfect.2", "text": "Che buono!", "src": "Che buono!"},
{"key": "data.voice.italian.praise.0", "text": "Perfetto. Todella. Grazie mille.", "src": "Perfetto. Truly. Grazie mille."},
{"key": "data.voice.italian.praise.1", "text": "Bravo. Nonnani itkisi.", "src": "Bravo. My nonna would cry."},
{"key": "data.voice.italian.praise.2", "text": "Che buono. En lähde mihinkään.", "src": "Che buono. I'm not leaving."},
{"key": "data.voice.italian.sip.0", "text": "Senti, {advice_l}", "src": "Senti, {advice_l}"},
{"key": "data.voice.italian.sip.1", "text": "Allora, {advice_l}", "src": "Allora, {advice_l}"},
{"key": "data.voice.italian.sip.2", "text": "Va bene, ma {advice_l}", "src": "Va bene, ma {advice_l}"},
{"key": "data.voice.italian.wrong.0", "text": "Mamma mia, ei.", "src": "Mamma mia, no."},
{"key": "data.voice.italian.wrong.1", "text": "Ma che cos'è?", "src": "Ma che cos'è?"},
{"key": "data.voice.italian.wrong.2", "text": "Ei, ei. Ei tämä.", "src": "No, no. Not this."},
{"key": "data.voice.japanese.another.0", "text": "Mou ippai!", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "Vielä yksi, kanpai!", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "Uudestaan, onegai!", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Hai, okei.", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa.", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "Ei paha, ne.", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "Eh?! Oikeasti?", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi. Okei, minä menen.", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta. Sayonara.", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen, en voi odottaa enempää.", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii. Minä menen.", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai. Näkemiin.", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen, {drink}.", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "Yksi {drink}, onegai.", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink}, kiitos. Arigatou.", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto… {drink}.", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "Oishii!", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "Sugoi, täydellinen!", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "Kanpai!", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii. Todella, tämä on se.", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "Sugoi. Olet ammattilainen, ne.", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "Kanpai. Tämä on täydellinen.", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "Etto, {advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "Ne, {advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "Sumimasen, mutta {advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "Chotto… ei.", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "Eh? Ei tämä.", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "Chigau, anteeksi.", "src": "Chigau, sorry."},
{"key": "data.voice.korean.another.0", "text": "Han jan deo!", "src": "Han jan deo!"},
{"key": "data.voice.korean.another.1", "text": "Vielä yksi!", "src": "One more!"},
{"key": "data.voice.korean.another.2", "text": "Uudestaan, juseyo!", "src": "Again, juseyo!"},
{"key": "data.voice.korean.close.0", "text": "Gwenchana.", "src": "Gwenchana."},
{"key": "data.voice.korean.close.1", "text": "Ihan okei.", "src": "It is okay."},
{"key": "data.voice.korean.close.2", "text": "Nappeuji anha.", "src": "Nappeuji anha."},
{"key": "data.voice.korean.kicked.0", "text": "Jinjja? Vau.", "src": "Jinjja? Wow."},
{"key": "data.voice.korean.kicked.1", "text": "Aish. Hyvä on.", "src": "Aish. Fine."},
{"key": "data.voice.korean.kicked.2", "text": "Annyeong sitten.", "src": "Annyeong, then."},
{"key": "data.voice.korean.leaving.0", "text": "Aish. Liian kauan.", "src": "Aish. Too long."},
{"key": "data.voice.korean.leaving.1", "text": "Minä menen. Annyeong.", "src": "I am going. Annyeong."},
{"key": "data.voice.korean.leaving.2", "text": "Mot chamgesseo.", "src": "Mot chamgesseo."},
{"key": "data.voice.korean.order.0", "text": "{drink}, juseyo.", "src": "{drink}, juseyo."},
{"key": "data.voice.korean.order.1", "text": "Yksi {drink}, kiitos.", "src": "One {drink}, please."},
{"key": "data.voice.korean.order.2", "text": "Minulle {drink}.", "src": "A {drink} for me."},
{"key": "data.voice.korean.order.3", "text": "Haluan: {drink}.", "src": "I want a {drink}."},
{"key": "data.voice.korean.perfect.0", "text": "Daebak!", "src": "Daebak!"},
{"key": "data.voice.korean.perfect.1", "text": "Jinjja hyvä!", "src": "Jinjja good!"},
{"key": "data.voice.korean.perfect.2", "text": "Choego!", "src": "Choego!"},
{"key": "data.voice.korean.praise.0", "text": "Daebak. Jinjja, tämä on täydellinen.", "src": "Daebak. Jinjja, this is perfect."},
{"key": "data.voice.korean.praise.1", "text": "Choego. Tarkoitan sitä.", "src": "Choego. I mean it."},
{"key": "data.voice.korean.praise.2", "text": "Vau. Sinä olet hyvä tässä.", "src": "Wow. You are good at this."},
{"key": "data.voice.korean.sip.0", "text": "Jamkkanman, {advice_l}", "src": "Jamkkanman, {advice_l}"},
{"key": "data.voice.korean.sip.1", "text": "Öö, {advice_l}", "src": "Um, {advice_l}"},
{"key": "data.voice.korean.sip.2", "text": "Gwenchana, mutta {advice_l}", "src": "Gwenchana, but {advice_l}"},
{"key": "data.voice.korean.wrong.0", "text": "Aniyo, ei.", "src": "Aniyo, no."},
{"key": "data.voice.korean.wrong.1", "text": "Tämä on väärin.", "src": "This is wrong."},
{"key": "data.voice.korean.wrong.2", "text": "Eh? Ei minun.", "src": "Eh? Not mine."},
{"key": "data.voice.miami.another.0", "text": "¡Otra, dale!", "src": "¡Otra, dale!"},
{"key": "data.voice.miami.another.1", "text": "Vielä yksi, oye!", "src": "One more, oye!"},
{"key": "data.voice.miami.another.2", "text": "Uudestaan, mi amor!", "src": "Again, mi amor!"},
{"key": "data.voice.miami.close.0", "text": "Está bien.", "src": "Está bien."},
{"key": "data.voice.miami.close.1", "text": "Ei paha, chico.", "src": "Not bad, chico."},
{"key": "data.voice.miami.close.2", "text": "Okei, okei.", "src": "Okay, okay."},
{"key": "data.voice.miami.kicked.0", "text": "¿En serio? Okei, hyvä on.", "src": "¿En serio? Okay, fine."},
{"key": "data.voice.miami.kicked.1", "text": "Pilailetko, chico?", "src": "You're kidding me, chico."},
{"key": "data.voice.miami.kicked.2", "text": "Dale. Oma menetyksesi.", "src": "Dale. Your loss."},
{"key": "data.voice.miami.leaving.0", "text": "¡Oye! Olen istunut tässä koko illan.", "src": "¡Oye! I've been sitting here all night."},
{"key": "data.voice.miami.leaving.1", "text": "Bueno, se oli siinä. Ciao.", "src": "Bueno, that's it. Ciao."},
{"key": "data.voice.miami.leaving.2", "text": "Ei, ei. En odota enää.", "src": "No, no. I'm not waiting anymore."},
{"key": "data.voice.miami.order.0", "text": "Oye, mulle {drink}.", "src": "Oye, a {drink} for me."},
{"key": "data.voice.miami.order.1", "text": "Dale, yksi {drink}.", "src": "Dale, one {drink}."},
{"key": "data.voice.miami.order.2", "text": "{drink}, papi, kun ehdit.", "src": "{drink}, papi, when you can."},
{"key": "data.voice.miami.order.3", "text": "Mi amor, yksi {drink}.", "src": "Mi amor, a {drink}."},
{"key": "data.voice.miami.perfect.0", "text": "¡Qué rico!", "src": "¡Qué rico!"},
{"key": "data.voice.miami.perfect.1", "text": "¡Eso es!", "src": "¡Eso es!"},
{"key": "data.voice.miami.perfect.2", "text": "¡Dale, perfecto!", "src": "¡Dale, perfecto!"},
{"key": "data.voice.miami.praise.0", "text": "Ay, tämä on se oikea. Gracias.", "src": "Ay, this is the one. Gracias."},
{"key": "data.voice.miami.praise.1", "text": "Abuelani hyväksyisi, eikä hän hyväksy mitään.", "src": "My abuela would approve, and she approves of nothing."},
{"key": "data.voice.miami.praise.2", "text": "Dale. Sinä tiedät, mitä teet.", "src": "Dale. You know what you're doing."},
{"key": "data.voice.miami.sip.0", "text": "Mira, {advice_l}", "src": "Mira, {advice_l}"},
{"key": "data.voice.miami.sip.1", "text": "Oye, {advice_l}", "src": "Oye, {advice_l}"},
{"key": "data.voice.miami.sip.2", "text": "Está bien, pero… {advice_l}", "src": "Está bien, pero… {advice_l}"},
{"key": "data.voice.miami.wrong.0", "text": "¿Qué es esto?", "src": "¿Qué es esto?"},
{"key": "data.voice.miami.wrong.1", "text": "Ei, ei, ei.", "src": "No, no, no."},
{"key": "data.voice.miami.wrong.2", "text": "Ei minun, oye.", "src": "Not mine, oye."},
{"key": "data.voice.midwest.another.0", "text": "Toinen, kiitos!", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "Vielä yksi, kiitos kovasti!", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "Sama uudestaan, ope!", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "Voi, ihan hyvä.", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "Joo, kiitos.", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "Ei yhtään hassumpi.", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "Ai. No. Selvä sitten.", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "Ope, anteeksi… minä menen.", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "Vähän liikaa, mutta okei.", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "Oh gosh, en oikeasti voi odottaa enempää.", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "No, minun pitäisi kai lähteä.", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "Anteeksi, mutta taidan lähteä.", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "Olisiko {drink}? Kiitos kovasti.", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "{drink}, jos se ei ole vaivaksi.", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "Ai, minulle vain {drink}.", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink}, kiitos. Ei kiirettä.", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "Voi, tosi hyvä!", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "You betcha!", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "Oh jeez, kyllä!", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "Oh my gosh, tämähän on ihana.", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "Tosi hyvä. Tätini rakastaisi tätä paikkaa.", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "No, tuo osui kohdalleen.", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "Voi, {advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "Tiedoksi vain, {advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "Ei mikään iso juttu, mutta {advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "Ope. Väärä.", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "Ai, tuo ei ole minun.", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "Anteeksi, ei. Ei tämä.", "src": "Sorry, no. Not this."}
]}
