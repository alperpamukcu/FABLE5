{"strings": [
{"key": "data.voice.african.another.0", "text": "Tuo toinen!", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "Vielä yksi, abeg!", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "Uudestaan, ystävä!", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "Ihan hyvä.", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "No wahala.", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "Okei, kiitos.", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "Ah ah! Tosissasi?", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala. Minä menen.", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "Ystävä, tämä on huono juttu.", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah ah. Olen odottanut tarpeeksi.", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala. Minä lähden.", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "Anna minun mennä, ystävä.", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "{drink}, kiitos.", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "Yksi {drink}, ystävä.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Minulle {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "{drink}, abeg.", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "Ah, hienoa!", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "Oikein!", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "Tämä on hyvä!", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, tämä on oikein. Kiitos.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "Ei mitään wahalaa. Tosi hyvä.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "Ystävä, sinä osaat asiasi.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "Ystävä, {advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg, {advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "Ihan hyvä, mutta {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah, ei.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "Tämä ei ole se.", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "Ystävä, ei.", "src": "My friend, no."},
{"key": "data.voice.arabic.another.0", "text": "Kaman wahad!", "src": "Kaman wahad!"},
{"key": "data.voice.arabic.another.1", "text": "Vielä yksi, yalla!", "src": "One more, yalla!"},
{"key": "data.voice.arabic.another.2", "text": "Uudestaan, habibi!", "src": "Again, habibi!"},
{"key": "data.voice.arabic.close.0", "text": "Maashi.", "src": "Maashi."},
{"key": "data.voice.arabic.close.1", "text": "Ihan okei.", "src": "It is okay."},
{"key": "data.voice.arabic.close.2", "text": "Tamam, shukran.", "src": "Tamam, shukran."},
{"key": "data.voice.arabic.kicked.0", "text": "Shu? Oikeasti?", "src": "Shu? Seriously?"},
{"key": "data.voice.arabic.kicked.1", "text": "Khalas. Hyvä on.", "src": "Khalas. Fine."},
{"key": "data.voice.arabic.kicked.2", "text": "Yalla. Minä menen.", "src": "Yalla. I go."},
{"key": "data.voice.arabic.leaving.0", "text": "Khalas. Minä lähden.", "src": "Khalas. I am going."},
{"key": "data.voice.arabic.leaving.1", "text": "Yalla, tarpeeksi odotettu.", "src": "Yalla, enough waiting."},
{"key": "data.voice.arabic.leaving.2", "text": "Maa salama.", "src": "Maa salama."},
{"key": "data.voice.arabic.order.0", "text": "{drink}, kiitos.", "src": "A {drink}, please."},
{"key": "data.voice.arabic.order.1", "text": "Yksi {drink}, shukran.", "src": "One {drink}, shukran."},
{"key": "data.voice.arabic.order.2", "text": "Habibi, yksi {drink}.", "src": "Habibi, a {drink}."},
{"key": "data.voice.arabic.order.3", "text": "Minulle {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.arabic.perfect.0", "text": "Ya salam!", "src": "Ya salam!"},
{"key": "data.voice.arabic.perfect.1", "text": "Helu kteer!", "src": "Helu kteer!"},
{"key": "data.voice.arabic.perfect.2", "text": "Täydellinen, habibi!", "src": "Perfect, habibi!"},
{"key": "data.voice.arabic.praise.0", "text": "Ya salam. Tämä on se oikea, habibi.", "src": "Ya salam. This is the one, habibi."},
{"key": "data.voice.arabic.praise.1", "text": "Helu kteer. Shukran.", "src": "Helu kteer. Shukran."},
{"key": "data.voice.arabic.praise.2", "text": "Yalla, sinä osaat työsi.", "src": "Yalla, you know your work."},
{"key": "data.voice.arabic.sip.0", "text": "Habibi, {advice_l}", "src": "Habibi, {advice_l}"},
{"key": "data.voice.arabic.sip.1", "text": "Shuf, {advice_l}", "src": "Shuf, {advice_l}"},
{"key": "data.voice.arabic.sip.2", "text": "Tamam, bas {advice_l}", "src": "Tamam, bas {advice_l}"},
{"key": "data.voice.arabic.wrong.0", "text": "La, la.", "src": "La, la."},
{"key": "data.voice.arabic.wrong.1", "text": "Tämä ei ole se.", "src": "This is not it."},
{"key": "data.voice.arabic.wrong.2", "text": "Shu hada?", "src": "Shu hada?"},
{"key": "data.voice.aussie.another.0", "text": "Sama uudestaan, mate!", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "Vielä yks, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "Toinen, legend!", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "Joo, righto.", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "Ei paha, mate.", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "Kelpaa.", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "Ootsä tosissas, mate?", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto. Ihan reilua.", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Nah, aika rankkaa.", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto, oon odottanut tarpeeksi.", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Nah, antaa olla. Mä lähden.", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "Kiitti ei mistään, mate.", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "{drink}, mate.", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink}, kiitos.", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "Mulle {drink}.", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "Yks {drink}, cheers.", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "Ripper!", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "Too easy!", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "Pirun hyvä!", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "Bloody ripper, mate. Cheers.", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "Too easy. Sä osaat hommas.", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "Illan paras, ihan oikeesti.", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "Kato, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "No dramas, mut {advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Nah, mate.", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "Ei mun, sori.", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "Väärä, mate.", "src": "Wrong one, mate."},
{"key": "data.voice.brit.another.0", "text": "Sama uudestaan, mate!", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "Vielä yksi, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "No, vielä yksi!", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "Ei hassumpi.", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Ta, kyllä tämä kelpaa.", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "Selvä, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Charming. Kerrassaan charming.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "Selvä. No. Kiitos ei mistään.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "Pilailetko?", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Selvä. Olen odottanut tarpeeksi.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "Hitto tätä. Minä lähden.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Aika surkeaa. Heippa.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "{drink}, mate, kun ehdit.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, kiitos. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "No sitten, yksi {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "Minulle {drink}, ta.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "Lovely!", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "Cheers, mate!", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "Proper hyvä!", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Blimey. Tämähän on oikeasti lovely.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Tuo on tehty kunnolla.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Pirun hyvä, tuo.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "Pikku juttu: {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Kuule, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Vähän pielessä, tuo.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Öö, ei minun.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "En pyytänyt tätä.", "src": "Not what I asked."},
{"key": "data.voice.chinese.another.0", "text": "Zai lai yi bei!", "src": "Zai lai yi bei!"},
{"key": "data.voice.chinese.another.1", "text": "Vielä yksi, ah!", "src": "One more, ah!"},
{"key": "data.voice.chinese.another.2", "text": "Uudestaan, kiitos!", "src": "Again, please!"},
{"key": "data.voice.chinese.close.0", "text": "Hai keyi.", "src": "Hai keyi."},
{"key": "data.voice.chinese.close.1", "text": "Okei lah.", "src": "Okay lah."},
{"key": "data.voice.chinese.close.2", "text": "Ihan hyvä.", "src": "It is fine."},
{"key": "data.voice.chinese.kicked.0", "text": "Shenme? Oikeasti?", "src": "Shenme? Really?"},
{"key": "data.voice.chinese.kicked.1", "text": "Aiya. Hyvä on.", "src": "Aiya. Fine."},
{"key": "data.voice.chinese.kicked.2", "text": "Hao. Minä lähden.", "src": "Hao. I leave."},
{"key": "data.voice.chinese.leaving.0", "text": "Aiya. Odotin liian kauan.", "src": "Aiya. I waited too long."},
{"key": "data.voice.chinese.leaving.1", "text": "Suan le. Minä menen.", "src": "Suan le. I go."},
{"key": "data.voice.chinese.leaving.2", "text": "Zaijian sitten.", "src": "Zaijian, then."},
{"key": "data.voice.chinese.order.0", "text": "{drink}, kiitos.", "src": "{drink}, please."},
{"key": "data.voice.chinese.order.1", "text": "Yksi {drink}, xiexie.", "src": "One {drink}, xiexie."},
{"key": "data.voice.chinese.order.2", "text": "Minulle {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.chinese.order.3", "text": "Yksi {drink} tänne.", "src": "A {drink} for me."},
{"key": "data.voice.chinese.perfect.0", "text": "Hen hao!", "src": "Hen hao!"},
{"key": "data.voice.chinese.perfect.1", "text": "Täydellinen, ah!", "src": "Perfect, ah!"},
{"key": "data.voice.chinese.perfect.2", "text": "Zhen bang!", "src": "Zhen bang!"},
{"key": "data.voice.chinese.praise.0", "text": "Zhen bang. Tulen tämän takia takaisin.", "src": "Zhen bang. I will come back for this."},
{"key": "data.voice.chinese.praise.1", "text": "Hen hao. Sinä tiedät, mitä teet.", "src": "Hen hao. You know what you are doing."},
{"key": "data.voice.chinese.praise.2", "text": "Täydellinen, ah. Oikeasti.", "src": "Perfect, ah. Really."},
{"key": "data.voice.chinese.sip.0", "text": "Ai, {advice_l}", "src": "Ai, {advice_l}"},
{"key": "data.voice.chinese.sip.1", "text": "Kuuntele, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.chinese.sip.2", "text": "Hao, mutta {advice_l}", "src": "Hao, but {advice_l}"},
{"key": "data.voice.chinese.wrong.0", "text": "Bu dui.", "src": "Bu dui."},
{"key": "data.voice.chinese.wrong.1", "text": "Aiya, ei.", "src": "Aiya, no."},
{"key": "data.voice.chinese.wrong.2", "text": "Ei tämä.", "src": "Not this one."}
]}
