{"strings": [
{"key": "data.voice.turkish.another.0", "text": "Bir daha!", "src": "Bir daha!"},
{"key": "data.voice.turkish.another.1", "text": "Toinen, abi!", "src": "Another, abi!"},
{"key": "data.voice.turkish.another.2", "text": "Uudestaan, eyvallah!", "src": "Again, eyvallah!"},
{"key": "data.voice.turkish.close.0", "text": "Tamam.", "src": "Tamam."},
{"key": "data.voice.turkish.close.1", "text": "İdare eder.", "src": "İdare eder."},
{"key": "data.voice.turkish.close.2", "text": "Okei, hyvä on.", "src": "Okay, fine."},
{"key": "data.voice.turkish.kicked.0", "text": "Ciddi misin? Okei.", "src": "Ciddi misin? Okay."},
{"key": "data.voice.turkish.kicked.1", "text": "Abi, oikeasti? Hyvä on.", "src": "Abi, really? Fine."},
{"key": "data.voice.turkish.kicked.2", "text": "Yok, yok. Minä menen.", "src": "Yok, yok. I'm going."},
{"key": "data.voice.turkish.leaving.0", "text": "Yok, en odota enää.", "src": "Yok, I'm not waiting anymore."},
{"key": "data.voice.turkish.leaving.1", "text": "Abi, eikö täällä kukaan ole töissä?", "src": "Abi, is nobody working here?"},
{"key": "data.voice.turkish.leaving.2", "text": "Tamam, hoşça kal.", "src": "Tamam, hoşça kal."},
{"key": "data.voice.turkish.order.0", "text": "Abi, {drink}.", "src": "Abi, a {drink}."},
{"key": "data.voice.turkish.order.1", "text": "Yksi {drink}, eyvallah.", "src": "One {drink}, eyvallah."},
{"key": "data.voice.turkish.order.2", "text": "{drink}, canım, kun ehdit.", "src": "{drink}, canım, when you can."},
{"key": "data.voice.turkish.order.3", "text": "Bir {drink}, kiitos.", "src": "Bir {drink}, please."},
{"key": "data.voice.turkish.perfect.0", "text": "Eyvallah!", "src": "Eyvallah!"},
{"key": "data.voice.turkish.perfect.1", "text": "Harika!", "src": "Harika!"},
{"key": "data.voice.turkish.perfect.2", "text": "Süper, abi!", "src": "Süper, abi!"},
{"key": "data.voice.turkish.praise.0", "text": "Eyvallah. Näin se tehdään.", "src": "Eyvallah. This is how it's done."},
{"key": "data.voice.turkish.praise.1", "text": "Abi, hattua nostan. Harika.", "src": "Abi, my hat is off. Harika."},
{"key": "data.voice.turkish.praise.2", "text": "Tamam, sinä osaat työsi.", "src": "Tamam, you know your work."},
{"key": "data.voice.turkish.sip.0", "text": "Abi, {advice_l}", "src": "Abi, {advice_l}"},
{"key": "data.voice.turkish.sip.1", "text": "Bak, {advice_l}", "src": "Bak, {advice_l}"},
{"key": "data.voice.turkish.sip.2", "text": "Tamam ama, {advice_l}", "src": "Tamam ama, {advice_l}"},
{"key": "data.voice.turkish.wrong.0", "text": "Yok, ei tämä.", "src": "Yok, not this."},
{"key": "data.voice.turkish.wrong.1", "text": "Abi, väärä.", "src": "Abi, wrong one."},
{"key": "data.voice.turkish.wrong.2", "text": "Bu ne şimdi?", "src": "Bu ne şimdi?"}
]}
