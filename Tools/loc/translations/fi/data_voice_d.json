{"strings": [
{"key": "data.voice.nordic.another.0", "text": "Toinen. Skål!", "src": "Another. Skål!"},
{"key": "data.voice.nordic.another.1", "text": "Vielä yksi.", "src": "One more."},
{"key": "data.voice.nordic.another.2", "text": "Uudestaan, kiitos.", "src": "Again, please."},
{"key": "data.voice.nordic.close.0", "text": "Hyvä.", "src": "Fine."},
{"key": "data.voice.nordic.close.1", "text": "Ihan okei.", "src": "It's okay."},
{"key": "data.voice.nordic.close.2", "text": "Riittää.", "src": "Good enough."},
{"key": "data.voice.nordic.kicked.0", "text": "Okei. Outoa, mutta okei.", "src": "Okay. Strange, but okay."},
{"key": "data.voice.nordic.kicked.1", "text": "Hyvä on.", "src": "Fine."},
{"key": "data.voice.nordic.kicked.2", "text": "Hm. Hei sitten.", "src": "Hm. Goodbye then."},
{"key": "data.voice.nordic.leaving.0", "text": "Minä menen. Ei se mitään.", "src": "I'll go. It's fine."},
{"key": "data.voice.nordic.leaving.1", "text": "Liian kauan. Hei.", "src": "Too long. Goodbye."},
{"key": "data.voice.nordic.leaving.2", "text": "Ei. Minä lähden.", "src": "No. I'm leaving."},
{"key": "data.voice.nordic.order.0", "text": "{drink}. Kiitos.", "src": "A {drink}. Thanks."},
{"key": "data.voice.nordic.order.1", "text": "{drink}, kiitos.", "src": "{drink}, please."},
{"key": "data.voice.nordic.order.2", "text": "Yksi {drink}. Ei kiirettä.", "src": "One {drink}. No rush."},
{"key": "data.voice.nordic.order.3", "text": "Minulle {drink}.", "src": "I'll have the {drink}."},
{"key": "data.voice.nordic.perfect.0", "text": "Skål!", "src": "Skål!"},
{"key": "data.voice.nordic.perfect.1", "text": "Tosi hyvä.", "src": "Very good."},
{"key": "data.voice.nordic.perfect.2", "text": "Joo. Hyvä.", "src": "Yes. Good."},
{"key": "data.voice.nordic.praise.0", "text": "Tämä on tosi hyvä. En sano sitä usein.", "src": "This is very good. I don't say that."},
{"key": "data.voice.nordic.praise.1", "text": "Skål. Kunnolla tehty.", "src": "Skål. Properly done."},
{"key": "data.voice.nordic.praise.2", "text": "Hyvä. Oikeasti hyvä.", "src": "Good. Really good."},
{"key": "data.voice.nordic.sip.0", "text": "No. {advice}", "src": "Well. {advice}"},
{"key": "data.voice.nordic.sip.1", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.nordic.sip.2", "text": "Ihan hyvä, mutta {advice_l}", "src": "Fine, but {advice_l}"},
{"key": "data.voice.nordic.wrong.0", "text": "Ei. Väärä.", "src": "No. Wrong one."},
{"key": "data.voice.nordic.wrong.1", "text": "Tämä ei ole se.", "src": "This is not it."},
{"key": "data.voice.nordic.wrong.2", "text": "Hm. Ei minun.", "src": "Hm. Not mine."},
{"key": "data.voice.nyc.another.0", "text": "Anna toinen!", "src": "Hit me again!"},
{"key": "data.voice.nyc.another.1", "text": "Lisää tänne!", "src": "Keep 'em comin'!"},
{"key": "data.voice.nyc.another.2", "text": "Toinen, chief!", "src": "Another, chief!"},
{"key": "data.voice.nyc.close.0", "text": "Eh. Käy se.", "src": "Eh. It's fine."},
{"key": "data.voice.nyc.close.1", "text": "Joo, okei.", "src": "Yeah, alright."},
{"key": "data.voice.nyc.close.2", "text": "Kelpaa.", "src": "It'll do."},
{"key": "data.voice.nyc.kicked.0", "text": "Ootsä tosissas nyt?", "src": "You serious right now?"},
{"key": "data.voice.nyc.kicked.1", "text": "Hyvä on. Surkee baari muutenkin.", "src": "Fine. Terrible bar anyway."},
{"key": "data.voice.nyc.kicked.2", "text": "Vau. Okei. Vau.", "src": "Wow. Okay. Wow."},
{"key": "data.voice.nyc.leaving.0", "text": "Mulla on menoja. Unohda koko juttu.", "src": "I got places to be. Forget it."},
{"key": "data.voice.nyc.leaving.1", "text": "Uskomatonta. Mä lähden.", "src": "Unbelievable. I'm outta here."},
{"key": "data.voice.nyc.leaving.2", "text": "Yo, onks tää baari vai odotushuone?", "src": "Yo, is this a bar or a waiting room?"},
{"key": "data.voice.nyc.order.0", "text": "Yo, anna mulle {drink}.", "src": "Yo, lemme get a {drink}."},
{"key": "data.voice.nyc.order.1", "text": "{drink}. Ja mulla on kiire.", "src": "{drink}. And I'm in a hurry."},
{"key": "data.voice.nyc.order.2", "text": "Laita {drink}, chief.", "src": "Gimme a {drink}, chief."},
{"key": "data.voice.nyc.order.3", "text": "{drink}. Älä tee siitä outoa.", "src": "{drink}. Don't make it weird."},
{"key": "data.voice.nyc.perfect.0", "text": "Nyt puhutaan!", "src": "Now we're talkin'!"},
{"key": "data.voice.nyc.perfect.1", "text": "Tätä just!", "src": "That's the stuff!"},
{"key": "data.voice.nyc.perfect.2", "text": "Oh, tuo se on!", "src": "Oh, that's it!"},
{"key": "data.voice.nyc.praise.0", "text": "Okei, oon vaikuttunut. Sitä ei tapahdu koskaan.", "src": "Okay, I'm impressed. That never happens."},
{"key": "data.voice.nyc.praise.1", "text": "Kerronpa sulle, tuo on drinkki.", "src": "Lemme tell ya, that's a drink."},
{"key": "data.voice.nyc.praise.2", "text": "Tästä pitäis pyytää enemmän. Älä pyydä.", "src": "You should charge more for this. Don't."},
{"key": "data.voice.nyc.sip.0", "text": "Kato, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.nyc.sip.1", "text": "Sanonpahan vaan, {advice_l}", "src": "I'm just sayin', {advice_l}"},
{"key": "data.voice.nyc.sip.2", "text": "Ei paha, mut {advice_l}", "src": "Not bad, but {advice_l}"},
{"key": "data.voice.nyc.wrong.0", "text": "Mikä tää on?", "src": "What is this?"},
{"key": "data.voice.nyc.wrong.1", "text": "Fuhgeddaboudit.", "src": "Fuhgeddaboudit."},
{"key": "data.voice.nyc.wrong.2", "text": "Väärä, pal.", "src": "Wrong one, pal."},
{"key": "data.voice.polish.another.0", "text": "Jeszcze raz!", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "Toinen, proszę!", "src": "Another, proszę!"},
{"key": "data.voice.polish.another.2", "text": "Vielä yksi!", "src": "One more!"},
{"key": "data.voice.polish.close.0", "text": "Dobrze.", "src": "Dobrze."},
{"key": "data.voice.polish.close.1", "text": "Okei.", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "Hyvä, kiitos.", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "Serio? Okei.", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "Hyvä on. Do widzenia.", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "Co? Okei, minä menen.", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "Riittää. Minä lähden.", "src": "Enough. I'm going."},
{"key": "data.voice.polish.leaving.1", "text": "Nie, nie. Liian kauan.", "src": "Nie, nie. Too long."},
{"key": "data.voice.polish.leaving.2", "text": "Do widzenia.", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "{drink}, proszę.", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "{drink}, kiitos.", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "Yksi {drink}. Kiitos.", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "Dobrze, yksi {drink}.", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "Na zdrowie!", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "Świetnie!", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "Tosi hyvä!", "src": "Very good!"},
{"key": "data.voice.polish.praise.0", "text": "Na zdrowie. Tämä on oikea drinkki.", "src": "Na zdrowie. This is a real drink."},
{"key": "data.voice.polish.praise.1", "text": "Świetnie. Kuin kotona.", "src": "Świetnie. Like at home."},
{"key": "data.voice.polish.praise.2", "text": "Dobrze. Tosi, tosi hyvä.", "src": "Dobrze. Very, very good."},
{"key": "data.voice.polish.sip.0", "text": "Dobrze, mutta {advice_l}", "src": "Dobrze, but {advice_l}"},
{"key": "data.voice.polish.sip.1", "text": "Kuuntele, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.polish.sip.2", "text": "Hm, {advice_l}", "src": "Hm, {advice_l}"},
{"key": "data.voice.polish.wrong.0", "text": "Nie. Väärä.", "src": "Nie. Wrong one."},
{"key": "data.voice.polish.wrong.1", "text": "Tämä ei ole minun.", "src": "This is not mine."},
{"key": "data.voice.polish.wrong.2", "text": "Co to jest?", "src": "Co to jest?"},
{"key": "data.voice.southern.another.0", "text": "Kaada toinen!", "src": "Pour me another!"},
{"key": "data.voice.southern.another.1", "text": "Vielä yksi, sugar!", "src": "One more, sugar!"},
{"key": "data.voice.southern.another.2", "text": "Lisää vaan!", "src": "Keep 'em comin'!"},
{"key": "data.voice.southern.close.0", "text": "Ihan hyvä.", "src": "That's alright."},
{"key": "data.voice.southern.close.1", "text": "Reilu peli.", "src": "Fair enough."},
{"key": "data.voice.southern.close.2", "text": "No, kyllä tämä kelpaa.", "src": "Well, it'll do."},
{"key": "data.voice.southern.kicked.0", "text": "No, onpa tylyä.", "src": "Well, that's just rude."},
{"key": "data.voice.southern.kicked.1", "text": "Selvä sitten. Hyvää illanjatkoa.", "src": "Alright then. Have a good one."},
{"key": "data.voice.southern.kicked.2", "text": "Hetkinen nyt… hyvä on.", "src": "Now hold on… fine."},
{"key": "data.voice.southern.leaving.0", "text": "No, ei minulla ole koko yötä aikaa.", "src": "Well, I ain't got all night."},
{"key": "data.voice.southern.leaving.1", "text": "Taidan mennä muualle.", "src": "Reckon I'll drink elsewhere."},
{"key": "data.voice.southern.leaving.2", "text": "Y'all otatte kyllä aikanne, vai mitä.", "src": "Y'all take your sweet time, don't you."},
{"key": "data.voice.southern.order.0", "text": "No niin, {drink} sopisi minulle.", "src": "Well now, a {drink} would suit me."},
{"key": "data.voice.southern.order.1", "text": "{drink}, darlin', jos sopii.", "src": "{drink}, darlin', if you please."},
{"key": "data.voice.southern.order.2", "text": "Minulle kai {drink}.", "src": "Reckon I'll have a {drink}."},
{"key": "data.voice.southern.order.3", "text": "Yksi {drink}, sugar.", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "Eikö olekin hieno!", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "Lord, onpa hyvää!", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "Hot dang!", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "No jo on. Tuo on kunnon drinkki.", "src": "Well, I'll be. That's a proper drink."},
{"key": "data.voice.southern.praise.1", "text": "Darlin', sinulla on lahja.", "src": "Darlin', you got a gift."},
{"key": "data.voice.southern.praise.2", "text": "Taisin löytää uuden kantapaikkani.", "src": "Reckon I found my new spot."},
{"key": "data.voice.southern.sip.0", "text": "No niin, {advice_l}", "src": "Now, {advice_l}"},
{"key": "data.voice.southern.sip.1", "text": "Sugar, {advice_l}", "src": "Sugar, {advice_l}"},
{"key": "data.voice.southern.sip.2", "text": "Kerronpa sinulle, {advice_l}", "src": "Tell you what, {advice_l}"},
{"key": "data.voice.southern.wrong.0", "text": "Ei ole minun, hon.", "src": "Ain't mine, hon."},
{"key": "data.voice.southern.wrong.1", "text": "No mikäs tämä on?", "src": "Now what is this?"},
{"key": "data.voice.southern.wrong.2", "text": "Bless your heart.", "src": "Bless your heart."},
{"key": "data.voice.surfer.another.0", "text": "Vielä yksi, dude!", "src": "One more, dude!"},
{"key": "data.voice.surfer.another.1", "text": "Uudestaan, uudestaan!", "src": "Again, again!"},
{"key": "data.voice.surfer.another.2", "text": "Anna tulla vaan!", "src": "Keep 'em rolling!"},
{"key": "data.voice.surfer.close.0", "text": "Siistiä, siistiä.", "src": "Cool, cool."},
{"key": "data.voice.surfer.close.1", "text": "Joo, toimii.", "src": "Yeah, that works."},
{"key": "data.voice.surfer.close.2", "text": "Ihan kiva.", "src": "Nice enough."},
{"key": "data.voice.surfer.kicked.0", "text": "Rankkaa, dude.", "src": "Harsh, dude."},
{"key": "data.voice.surfer.kicked.1", "text": "Okei… aikamoinen vibe.", "src": "Okay… that's a vibe."},
{"key": "data.voice.surfer.kicked.2", "text": "Vau. Ei yhtään chill.", "src": "Wow. Not chill."},
{"key": "data.voice.surfer.leaving.0", "text": "Dude, oon ollu täällä ikuisuuden.", "src": "Dude, I've been here forever."},
{"key": "data.voice.surfer.leaving.1", "text": "Ei siistiä. Mä lähen.", "src": "Not cool. I'm out."},
{"key": "data.voice.surfer.leaving.2", "text": "Joo ei. Häivyn.", "src": "Yeah, no. Bailing."},
{"key": "data.voice.surfer.order.0", "text": "Dude, {drink}.", "src": "Dude, a {drink}."},
{"key": "data.voice.surfer.order.1", "text": "Olisko niinku… {drink}?", "src": "Can I get, like, a {drink}?"},
{"key": "data.voice.surfer.order.2", "text": "{drink}, kiitos. Chill, ei kiirettä.", "src": "{drink}, please. Chill, no rush."},
{"key": "data.voice.surfer.order.3", "text": "Joo, {drink} kuulostaa eepiseltä.", "src": "Yeah, a {drink} sounds epic."},
{"key": "data.voice.surfer.perfect.0", "text": "Dude. Kyllä.", "src": "Dude. Yes."},
{"key": "data.voice.surfer.perfect.1", "text": "Stoked!", "src": "Stoked!"},
{"key": "data.voice.surfer.perfect.2", "text": "Tosi hyvä!", "src": "So good!"},
{"key": "data.voice.surfer.praise.0", "text": "Okei, tää on oikeesti täydellinen. Respect.", "src": "Okay, that's actually perfect. Respect."},
{"key": "data.voice.surfer.praise.1", "text": "Dude. En ees vitsaile. Mahtava.", "src": "Dude. I'm not even kidding. Amazing."},
{"key": "data.voice.surfer.praise.2", "text": "Gnarly. Hyvällä tavalla.", "src": "Gnarly. In a good way."},
{"key": "data.voice.surfer.sip.0", "text": "Dude, {advice_l}", "src": "Dude, {advice_l}"},
{"key": "data.voice.surfer.sip.1", "text": "Okei eli, {advice_l}", "src": "Okay so, {advice_l}"},
{"key": "data.voice.surfer.sip.2", "text": "Ei stressiä, mut {advice_l}", "src": "No stress, but {advice_l}"},
{"key": "data.voice.surfer.wrong.0", "text": "Öö, väärä juoma?", "src": "Uh, wrong drink?"},
{"key": "data.voice.surfer.wrong.1", "text": "Ei se, dude.", "src": "Not it, dude."},
{"key": "data.voice.surfer.wrong.2", "text": "Bummer. Ei mun.", "src": "Bummer. Not mine."}
]}
