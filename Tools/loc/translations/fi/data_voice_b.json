{"strings": [
{"key": "data.voice.default.another.0", "text": "Toinen kierros!", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "Sama uudestaan!", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "Tätä lisää!", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "Kiitti.", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "Kelpaa.", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "Menettelee.", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "Ihanko totta? No hyvä.", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "Teet virheen.", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "Ihan sama. Pidä baarisi.", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "Unohda koko juttu. En jaksa enää odottaa.", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "Onko täällä kukaan töissä tänään?", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "Selvä. Menen muualle.", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink}, kiitos.", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "Mulle {drink}.", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "Yksi {drink}, kun ehdit.", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "Laita {drink}.", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "Täydellinen!", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "Juuri tuo!", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "Nappiin!", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "En muuttaisi mitään.", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "Tuo on drinkki.", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "Kuka ikinä sinut opetti, kiitä häntä.", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice} Sanonpahan vaan.", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "Rehellisesti? {advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "En tilannut tätä.", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "Väärä juoma.", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "Tuo ei ole minun.", "src": "That isn't mine."},
{"key": "data.voice.desi.another.0", "text": "Vielä yksi, yaar!", "src": "One more, yaar!"},
{"key": "data.voice.desi.another.1", "text": "Aur ek!", "src": "Aur ek!"},
{"key": "data.voice.desi.another.2", "text": "Uudestaan, kiitos!", "src": "Again, please!"},
{"key": "data.voice.desi.close.0", "text": "Theek hai.", "src": "Theek hai."},
{"key": "data.voice.desi.close.1", "text": "Ihan okei, na.", "src": "It is okay, na."},
{"key": "data.voice.desi.close.2", "text": "Chalega.", "src": "Chalega."},
{"key": "data.voice.desi.kicked.0", "text": "Kya? Oikeasti?", "src": "Kya? Seriously?"},
{"key": "data.voice.desi.kicked.1", "text": "Arre. Okei, hyvä on.", "src": "Arre. Okay, fine."},
{"key": "data.voice.desi.kicked.2", "text": "Chalo. Minä menen.", "src": "Chalo. I go."},
{"key": "data.voice.desi.leaving.0", "text": "Arre yaar. Liian kauan.", "src": "Arre yaar. Too long."},
{"key": "data.voice.desi.leaving.1", "text": "Chalo, minä lähden.", "src": "Chalo, I am going."},
{"key": "data.voice.desi.leaving.2", "text": "Bas. Riittää.", "src": "Bas. Enough."},
{"key": "data.voice.desi.order.0", "text": "Yksi {drink}, kiitos.", "src": "One {drink}, please."},
{"key": "data.voice.desi.order.1", "text": "{drink}, yaar.", "src": "A {drink}, yaar."},
{"key": "data.voice.desi.order.2", "text": "Minulle {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.desi.order.3", "text": "{drink}, na?", "src": "{drink}, na?"},
{"key": "data.voice.desi.perfect.0", "text": "Wah, täydellinen!", "src": "Wah, perfect!"},
{"key": "data.voice.desi.perfect.1", "text": "Ekdum first class!", "src": "Ekdum first class!"},
{"key": "data.voice.desi.perfect.2", "text": "Bahut badhiya!", "src": "Bahut badhiya!"},
{"key": "data.voice.desi.praise.0", "text": "Wah. Ekdum täydellinen, yaar.", "src": "Wah. Ekdum perfect, yaar."},
{"key": "data.voice.desi.praise.1", "text": "Bahut badhiya. Oikeasti.", "src": "Bahut badhiya. Really."},
{"key": "data.voice.desi.praise.2", "text": "First class. Minä tulen takaisin.", "src": "First class. I am coming back."},
{"key": "data.voice.desi.sip.0", "text": "Arre, {advice_l}", "src": "Arre, {advice_l}"},
{"key": "data.voice.desi.sip.1", "text": "Yaar, {advice_l}", "src": "Yaar, {advice_l}"},
{"key": "data.voice.desi.sip.2", "text": "Theek hai, mutta {advice_l}", "src": "Theek hai, but {advice_l}"},
{"key": "data.voice.desi.wrong.0", "text": "Arre, ei.", "src": "Arre, no."},
{"key": "data.voice.desi.wrong.1", "text": "Tämä ei ole minun.", "src": "This is not mine."},
{"key": "data.voice.desi.wrong.2", "text": "Nahi, väärä.", "src": "Nahi, wrong one."},
{"key": "data.voice.filipino.another.0", "text": "Isa pa!", "src": "Isa pa!"},
{"key": "data.voice.filipino.another.1", "text": "Vielä yksi, ha!", "src": "One more, ha!"},
{"key": "data.voice.filipino.another.2", "text": "Uudestaan, kiitos!", "src": "Again, please!"},
{"key": "data.voice.filipino.close.0", "text": "Okay lang.", "src": "Okay lang."},
{"key": "data.voice.filipino.close.1", "text": "Sige, kiitos.", "src": "Sige, thanks."},
{"key": "data.voice.filipino.close.2", "text": "Ay, ihan hyvä.", "src": "Ay, it's fine."},
{"key": "data.voice.filipino.kicked.0", "text": "Ha? Oikeasti?", "src": "Ha? Really?"},
{"key": "data.voice.filipino.kicked.1", "text": "Ay. Okei. Moikka.", "src": "Ay. Okay. Bye."},
{"key": "data.voice.filipino.kicked.2", "text": "Grabe naman.", "src": "Grabe naman."},
{"key": "data.voice.filipino.leaving.0", "text": "Ay, grabe. Liian kauan. Minä lähden.", "src": "Ay, grabe. Too long. I'm going."},
{"key": "data.voice.filipino.leaving.1", "text": "Sige na, moikka.", "src": "Sige na, bye."},
{"key": "data.voice.filipino.leaving.2", "text": "Naku, kukaan ei tule.", "src": "Naku, no one is coming."},
{"key": "data.voice.filipino.order.0", "text": "Ay, yksi {drink}, kiitos.", "src": "Ay, one {drink}, please."},
{"key": "data.voice.filipino.order.1", "text": "Minulle {drink}. Salamat.", "src": "{drink} for me. Salamat."},
{"key": "data.voice.filipino.order.2", "text": "Olisiko {drink}? Kiitos, ha.", "src": "Can I have a {drink}? Thanks, ha."},
{"key": "data.voice.filipino.order.3", "text": "{drink}, kuya.", "src": "A {drink}, kuya."},
{"key": "data.voice.filipino.perfect.0", "text": "Ay, sarap!", "src": "Ay, sarap!"},
{"key": "data.voice.filipino.perfect.1", "text": "Grabe, kyllä!", "src": "Grabe, yes!"},
{"key": "data.voice.filipino.perfect.2", "text": "Täydellinen, kuya!", "src": "Perfect, kuya!"},
{"key": "data.voice.filipino.praise.0", "text": "Grabe. Tosi hyvä. Salamat.", "src": "Grabe. That is so good. Salamat."},
{"key": "data.voice.filipino.praise.1", "text": "Ay, sarap. Pelastit koko vuoroni.", "src": "Ay, sarap. You made my whole shift."},
{"key": "data.voice.filipino.praise.2", "text": "Sige, tulen tämän takia takaisin.", "src": "Sige, I'm coming back for this."},
{"key": "data.voice.filipino.sip.0", "text": "Ay, {advice_l}", "src": "Ay, {advice_l}"},
{"key": "data.voice.filipino.sip.1", "text": "Sige, mutta {advice_l}", "src": "Sige, but {advice_l}"},
{"key": "data.voice.filipino.sip.2", "text": "Ha? {advice}", "src": "Ha? {advice}"},
{"key": "data.voice.filipino.wrong.0", "text": "Ay, hindi. Ei tämä.", "src": "Ay, hindi. Not this."},
{"key": "data.voice.filipino.wrong.1", "text": "Grabe, väärä juoma.", "src": "Grabe, wrong drink."},
{"key": "data.voice.filipino.wrong.2", "text": "Ei minun, kuya.", "src": "Not mine, kuya."},
{"key": "data.voice.french.another.0", "text": "Encore, kiitos!", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "Vielä yksi, oui!", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "Uudestaan, merci!", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ça va.", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "Ihan hyvä.", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon, okei.", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "Quoi? Oikeasti?", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Bon. Au revoir.", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule.", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non. Olen odottanut tarpeeksi.", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis. Minä menen.", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "Au revoir sitten.", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "{drink}, s'il vous plaît.", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "{drink}, kiitos.", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "Un {drink}, merci.", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "Minulle {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "Parfait!", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "Voilà, täydellinen!", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "Magnifique!", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait. Ei mitään huomautettavaa.", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voilà. Täällä joku osaa kaataa.", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique. Todella.", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Écoute, {advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon, {advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors, {advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non.", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "Tämä ei ole se.", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon, väärä.", "src": "Pardon, wrong."},
{"key": "data.voice.german.another.0", "text": "Noch eins!", "src": "Noch eins!"},
{"key": "data.voice.german.another.1", "text": "Toinen, bitte!", "src": "Another, bitte!"},
{"key": "data.voice.german.another.2", "text": "Uudestaan, kiitos!", "src": "Again, please!"},
{"key": "data.voice.german.close.0", "text": "Ja, okei.", "src": "Ja, okay."},
{"key": "data.voice.german.close.1", "text": "Hyväksyttävä.", "src": "Acceptable."},
{"key": "data.voice.german.close.2", "text": "Ihan hyvä.", "src": "It is fine."},
{"key": "data.voice.german.kicked.0", "text": "Tämä on absurdia.", "src": "This is absurd."},
{"key": "data.voice.german.kicked.1", "text": "Hyvä on. En palaa.", "src": "Fine. I will not return."},
{"key": "data.voice.german.kicked.2", "text": "Ja, ja. Minä menen.", "src": "Ja, ja. I am going."},
{"key": "data.voice.german.leaving.0", "text": "Tämä ei ole hyväksyttävää. Minä lähden.", "src": "This is not acceptable. I am leaving."},
{"key": "data.voice.german.leaving.1", "text": "Nein. Olen odottanut tarpeeksi.", "src": "Nein. I have waited enough."},
{"key": "data.voice.german.leaving.2", "text": "Unglaublich. Näkemiin.", "src": "Unglaublich. Goodbye."},
{"key": "data.voice.german.order.0", "text": "{drink}, kiitos. Oikein tehtynä.", "src": "A {drink}, please. Correctly made."},
{"key": "data.voice.german.order.1", "text": "{drink}. Kiitos.", "src": "{drink}. Thank you."},
{"key": "data.voice.german.order.2", "text": "Yksi {drink}, bitte.", "src": "One {drink}, bitte."},
{"key": "data.voice.german.order.3", "text": "Haluaisin: {drink}.", "src": "I would like a {drink}."},
{"key": "data.voice.german.perfect.0", "text": "Genau!", "src": "Genau!"},
{"key": "data.voice.german.perfect.1", "text": "Sehr gut!", "src": "Sehr gut!"},
{"key": "data.voice.german.perfect.2", "text": "Wunderbar!", "src": "Wunderbar!"},
{"key": "data.voice.german.praise.0", "text": "Ja. Juuri oikein.", "src": "Ja. This is exactly right."},
{"key": "data.voice.german.praise.1", "text": "Täsmällistä. Arvostan täsmällisyyttä.", "src": "Precise. I respect precision."},
{"key": "data.voice.german.praise.2", "text": "Sehr gut. Ei huomautettavaa.", "src": "Sehr gut. No notes."},
{"key": "data.voice.german.sip.0", "text": "Genau, mutta {advice_l}", "src": "Genau, but {advice_l}"},
{"key": "data.voice.german.sip.1", "text": "Yksi huomio: {advice_l}", "src": "One remark: {advice_l}"},
{"key": "data.voice.german.sip.2", "text": "Ja, {advice_l}", "src": "Ja, {advice_l}"},
{"key": "data.voice.german.wrong.0", "text": "Nein. Ei tämä.", "src": "Nein. Not this."},
{"key": "data.voice.german.wrong.1", "text": "Tämä on virheellinen.", "src": "This is incorrect."},
{"key": "data.voice.german.wrong.2", "text": "Väärä juoma.", "src": "Wrong drink."}
]}
