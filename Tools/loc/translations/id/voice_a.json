{"key": "data.voice.nordic.kicked.1", "text": "Baiklah.", "src": "Fine."},
{"key": "data.voice.nordic.kicked.2", "text": "Hm. Sampai jumpa, kalau begitu.", "src": "Hm. Goodbye then."},
{"key": "data.voice.nordic.leaving.0", "text": "Saya pergi. Tidak apa-apa.", "src": "I'll go. It's fine."},
