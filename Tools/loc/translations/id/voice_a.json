{"key": "data.voice.german.leaving.2", "text": "Unglaublich. Selamat tinggal.", "src": "Unglaublich. Goodbye."},
{"key": "data.voice.german.order.0", "text": "Satu {drink}, tolong. Dibuat dengan benar.", "src": "A {drink}, please. Correctly made."},
{"key": "data.voice.german.order.1", "text": "{drink}. Terima kasih.", "src": "{drink}. Thank you."},
{"key": "data.voice.german.order.2", "text": "Satu {drink}, bitte.", "src": "One {drink}, bitte."},
{"key": "data.voice.german.order.3", "text": "Saya ingin {drink}.", "src": "I would like a {drink}."},
{"key": "data.voice.german.perfect.0", "text": "Genau!", "src": "Genau!"},
{"key": "data.voice.german.perfect.1", "text": "Sehr gut!", "src": "Sehr gut!"},
{"key": "data.voice.german.perfect.2", "text": "Wunderbar!", "src": "Wunderbar!"},
