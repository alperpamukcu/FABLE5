{"key": "data.voice.nordic.order.0", "text": "Satu {drink}. Terima kasih.", "src": "A {drink}. Thanks."},
{"key": "data.voice.nordic.order.1", "text": "{drink}, tolong.", "src": "{drink}, please."},
{"key": "data.voice.nordic.order.2", "text": "Satu {drink}. Tidak usah buru-buru.", "src": "One {drink}. No rush."},
{"key": "data.voice.nordic.order.3", "text": "Saya pesan {drink}.", "src": "I'll have the {drink}."},
{"key": "data.voice.nordic.perfect.0", "text": "Skål!", "src": "Skål!"},
{"key": "data.voice.nordic.perfect.1", "text": "Bagus sekali.", "src": "Very good."},
{"key": "data.voice.nordic.perfect.2", "text": "Ya. Bagus.", "src": "Yes. Good."},
{"key": "data.voice.nordic.praise.0", "text": "Ini bagus sekali. Saya jarang bilang begitu.", "src": "This is very good. I don't say that."},
