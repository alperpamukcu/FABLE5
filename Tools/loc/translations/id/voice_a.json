{"key": "data.voice.korean.sip.2", "text": "Gwenchana, tapi {advice_l}", "src": "Gwenchana, but {advice_l}"},
{"key": "data.voice.korean.wrong.0", "text": "Aniyo, bukan.", "src": "Aniyo, no."},
{"key": "data.voice.korean.wrong.1", "text": "Ini salah.", "src": "This is wrong."},
{"key": "data.voice.korean.wrong.2", "text": "Eh? Bukan punya saya.", "src": "Eh? Not mine."},
{"key": "data.voice.nordic.another.0", "text": "Satu lagi. Skål!", "src": "Another. Skål!"},
{"key": "data.voice.nordic.another.1", "text": "Tambah satu.", "src": "One more."},
