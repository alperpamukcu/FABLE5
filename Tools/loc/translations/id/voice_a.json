{"key": "data.voice.southern.praise.1", "text": "Darlin', kamu berbakat.", "src": "Darlin', you got a gift."},
{"key": "data.voice.southern.praise.2", "text": "Reckon aku nemu tempat nongkrong baru.", "src": "Reckon I found my new spot."},
{"key": "data.voice.southern.sip.0", "text": "Nah, {advice_l}", "src": "Now, {advice_l}"},
{"key": "data.voice.southern.sip.1", "text": "Sugar, {advice_l}", "src": "Sugar, {advice_l}"},
