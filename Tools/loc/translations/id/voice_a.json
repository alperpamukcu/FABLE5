{"key": "data.voice.nordic.praise.2", "text": "Bagus. Benar-benar bagus.", "src": "Good. Really good."},
{"key": "data.voice.nordic.sip.0", "text": "Nah. {advice}", "src": "Well. {advice}"},
{"key": "data.voice.nordic.sip.1", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.nordic.sip.2", "text": "Baik, tapi {advice_l}", "src": "Fine, but {advice_l}"},
{"key": "data.voice.nordic.wrong.0", "text": "Tidak. Salah.", "src": "No. Wrong one."},
{"key": "data.voice.nordic.wrong.1", "text": "Bukan yang ini.", "src": "This is not it."},
{"key": "data.voice.nordic.wrong.2", "text": "Hm. Bukan punya saya.", "src": "Hm. Not mine."},
{"key": "data.voice.southern.another.0", "text": "Tuang satu lagi!", "src": "Pour me another!"},
{"key": "data.voice.southern.another.1", "text": "Satu lagi, sugar!", "src": "One more, sugar!"},
{"key": "data.voice.southern.another.2", "text": "Keep 'em comin', ya!", "src": "Keep 'em comin'!"},
