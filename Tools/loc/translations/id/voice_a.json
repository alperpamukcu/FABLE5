{"key": "data.voice.german.sip.2", "text": "Ja, {advice_l}", "src": "Ja, {advice_l}"},
{"key": "data.voice.german.wrong.0", "text": "Nein. Bukan ini.", "src": "Nein. Not this."},
{"key": "data.voice.german.wrong.1", "text": "Ini tidak benar.", "src": "This is incorrect."},
{"key": "data.voice.german.wrong.2", "text": "Minumannya salah.", "src": "Wrong drink."},
{"key": "data.voice.korean.another.0", "text": "Han jan deo!", "src": "Han jan deo!"},
