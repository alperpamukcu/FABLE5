{"strings": [
{"key": "data.voice.african.another.0", "text": "Tambah satu lagi!", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "Satu lagi, abeg!", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "Lagi, kawanku!", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "Boleh lah.", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "No wahala.", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "Oke, terima kasih.", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "Ah ah! Serius?", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala. Saya pergi.", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "Kawanku, ini tidak baik.", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah ah. Saya sudah cukup menunggu.", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala. Saya pergi saja.", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "Biar saya jalan, kawanku.", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "Satu {drink}, tolong.", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "Satu {drink}, kawanku.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Saya mau {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "{drink}, abeg.", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "Ah, mantap!", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "Pas sekali!", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "Yang ini enak!", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, yang ini benar. Terima kasih.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "Sama sekali no wahala. Enak sekali.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "Kawanku, kamu paham betul.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "Kawanku, {advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg, {advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "Sudah oke, tapi {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah, bukan.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "Bukan yang ini.", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "Kawanku, bukan ini.", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "Sama lagi, mate!", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "Satu lagi, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "Ayo, tambah satu!", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "Lumayan.", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Ta, cukuplah.", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "Alright, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Charming. Benar-benar charming.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "Oke. Ya sudah. Cheers for nothing.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "Bercanda kan, mate?", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Oke. Saya sudah cukup lama menunggu.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "Sudahlah. Saya pergi.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Payah juga ini. Bye.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "Satu {drink}, mate, kalau sempat.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, please. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "Ya sudah, satu {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "Saya pesan {drink}, ta.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "Lovely!", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "Cheers, mate!", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "Mantap betul!", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Blimey. Ini beneran lovely.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Kamu bikin ini dengan benar.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Bloody good, yang ini.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "Satu hal kecil: {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Begini, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Agak meleset, ini.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Erm, bukan punya saya.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "Bukan yang saya pesan.", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "Satu lagi, yaar!", "src": "One more, yaar!"},
{"key": "data.voice.desi.another.1", "text": "Aur ek!", "src": "Aur ek!"},
{"key": "data.voice.desi.another.2", "text": "Lagi, tolong!", "src": "Again, please!"},
{"key": "data.voice.desi.close.0", "text": "Theek hai.", "src": "Theek hai."},
{"key": "data.voice.desi.close.1", "text": "Oke kok, na.", "src": "It is okay, na."},
{"key": "data.voice.desi.close.2", "text": "Chalega.", "src": "Chalega."},
{"key": "data.voice.desi.kicked.0", "text": "Kya? Serius?", "src": "Kya? Seriously?"},
{"key": "data.voice.desi.kicked.1", "text": "Arre. Oke, baiklah.", "src": "Arre. Okay, fine."},
{"key": "data.voice.desi.kicked.2", "text": "Chalo. Saya pergi.", "src": "Chalo. I go."},
{"key": "data.voice.desi.leaving.0", "text": "Arre yaar. Kelamaan.", "src": "Arre yaar. Too long."},
{"key": "data.voice.desi.leaving.1", "text": "Chalo, saya jalan dulu.", "src": "Chalo, I am going."},
{"key": "data.voice.desi.leaving.2", "text": "Bas. Cukup.", "src": "Bas. Enough."},
{"key": "data.voice.desi.order.0", "text": "Satu {drink}, tolong.", "src": "One {drink}, please."},
{"key": "data.voice.desi.order.1", "text": "{drink} satu, yaar.", "src": "A {drink}, yaar."},
{"key": "data.voice.desi.order.2", "text": "Saya ambil {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.desi.order.3", "text": "{drink}, na?", "src": "{drink}, na?"},
{"key": "data.voice.desi.perfect.0", "text": "Wah, sempurna!", "src": "Wah, perfect!"},
{"key": "data.voice.desi.perfect.1", "text": "Ekdum first class!", "src": "Ekdum first class!"},
{"key": "data.voice.desi.perfect.2", "text": "Bahut badhiya!", "src": "Bahut badhiya!"},
{"key": "data.voice.desi.praise.0", "text": "Wah. Ekdum sempurna, yaar.", "src": "Wah. Ekdum perfect, yaar."},
{"key": "data.voice.desi.praise.1", "text": "Bahut badhiya. Sungguh.", "src": "Bahut badhiya. Really."},
{"key": "data.voice.desi.praise.2", "text": "First class. Saya pasti balik lagi.", "src": "First class. I am coming back."},
{"key": "data.voice.desi.sip.0", "text": "Arre, {advice_l}", "src": "Arre, {advice_l}"},
{"key": "data.voice.desi.sip.1", "text": "Yaar, {advice_l}", "src": "Yaar, {advice_l}"},
{"key": "data.voice.desi.sip.2", "text": "Theek hai, tapi {advice_l}", "src": "Theek hai, but {advice_l}"},
{"key": "data.voice.desi.wrong.0", "text": "Arre, bukan.", "src": "Arre, no."},
{"key": "data.voice.desi.wrong.1", "text": "Ini bukan punya saya.", "src": "This is not mine."},
{"key": "data.voice.desi.wrong.2", "text": "Nahi, salah yang ini.", "src": "Nahi, wrong one."},
{"key": "data.voice.german.another.0", "text": "Noch eins!", "src": "Noch eins!"},
