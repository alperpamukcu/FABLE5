{"key": "data.voice.korean.order.1", "text": "Satu {drink}, tolong.", "src": "One {drink}, please."},
{"key": "data.voice.korean.order.2", "text": "{drink} untuk saya.", "src": "A {drink} for me."},
{"key": "data.voice.korean.order.3", "text": "Saya mau {drink}.", "src": "I want a {drink}."},
{"key": "data.voice.korean.perfect.0", "text": "Daebak!", "src": "Daebak!"},
{"key": "data.voice.korean.perfect.1", "text": "Jinjja enak!", "src": "Jinjja good!"},
{"key": "data.voice.korean.perfect.2", "text": "Choego!", "src": "Choego!"},
{"key": "data.voice.korean.praise.0", "text": "Daebak. Jinjja, ini sempurna.", "src": "Daebak. Jinjja, this is perfect."},
{"key": "data.voice.korean.praise.1", "text": "Choego. Saya serius.", "src": "Choego. I mean it."},
