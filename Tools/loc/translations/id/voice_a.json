{"key": "data.voice.nordic.close.0", "text": "Baik.", "src": "Fine."},
{"key": "data.voice.nordic.close.1", "text": "Oke.", "src": "It's okay."},
{"key": "data.voice.nordic.close.2", "text": "Cukup bagus.", "src": "Good enough."},
