{"key": "recipes.way_line", "text": "{prep} · GELAS {glass}", "src": "{prep} · {glass} GLASS"},
{"key": "rule.already_at_bar", "text": "Mereka sudah ada di bar.", "src": "They are already at the bar."},
{"key": "rule.bar_top_best", "text": "Meja bar sudah yang terbaik.", "src": "The bar top is already the best one."},
{"key": "rule.bottle_owned", "text": "Botol itu sudah milikmu.", "src": "That bottle is already yours."},
{"key": "rule.card_not_read", "text": "Kartunya belum dibaca; dokumennya ada di baliknya.", "src": "The card has not been read; the papers are behind it."},
{"key": "rule.counter_clean", "text": "Meja bar di sini sudah bersih.", "src": "The counter is clean here."},
{"key": "rule.drink_in_shaker", "text": "Minumannya masih di shaker — tuang ke gelas dulu.", "src": "That drink is still in the shaker — pour it into a glass first."},
{"key": "rule.fixture_needs_stars", "text": "{fixture} butuh ruangan {stars} bintang; bar ini bernilai {rating}.", "src": "{fixture} needs a {stars}-star room; this bar rates {rating}."},
{"key": "rule.fixture_owned", "text": "Bar sudah punya {fixture}.", "src": "The bar already has {fixture}."},
{"key": "rule.fixture_rung_one_at_a_time", "text": "{fixture} ada di jenjang {level}; bar ini di jenjang {bar_level}. Naiknya satu jenjang demi satu.", "src": "{fixture} is rung {level} of its ladder; the bar stands on rung {bar_level}. It climbs one rung at a time."},
{"key": "rule.fixture_tower_one_line", "text": "{fixture} punya {lines} jalur; bar ini punya {bar_lines}. Menara dipasang satu jalur demi satu.", "src": "{fixture} runs {lines} lines; this bar runs {bar_lines}. A tower is fitted one line at a time."},
{"key": "rule.glass_line_finest", "text": "Gelas {glass} sudah yang terbaik.", "src": "The {glass} line is already the finest."},
{"key": "rule.kick_already_served", "text": "Kamu tak bisa mengusir orang yang sudah kamu layani; kesempatanmu tadi saat cek kartu.", "src": "You cannot show the door to someone you have already served; the card was your moment."},
{"key": "rule.kick_guest_of_house", "text": "Tamu kehormatan bar bukan hakmu untuk diusir.", "src": "The guest of the house is not yours to show the door."},
{"key": "rule.kick_read_card_first", "text": "Baca kartunya dulu.", "src": "Read the card first."},
{"key": "rule.no_glass_to_collect", "text": "Tak ada gelas untuk diambil di sini.", "src": "There is no glass here to collect."},
{"key": "rule.no_last_call", "text": "Tak ada yang menunggu pesanan terakhir.", "src": "Nobody is waiting on the last call."},
{"key": "rule.no_pourable_drinks", "text": "Belum ada minuman yang bisa kamu tuang.", "src": "No drinks you can pour yet."},
{"key": "rule.no_room_stool", "text": "Tak ada tempat untuk kursi lagi.", "src": "No room for another stool."},
{"key": "rule.not_enough_money", "text": "Uang tidak cukup ({money} < {price}).", "src": "Not enough money ({money} < {price})."},
{"key": "rule.not_on_counter", "text": "Itu tidak ada di meja bar ini.", "src": "That is not on this counter."},
{"key": "rule.not_ordered", "text": "Mereka belum memesan.", "src": "They have not ordered yet."},
{"key": "rule.not_waiting", "text": "Mereka sudah tidak menunggu.", "src": "They are not waiting any more."},
{"key": "rule.not_waiting_at_bar", "text": "Mereka tidak sedang menunggu di bar.", "src": "They are not waiting at the bar."},
{"key": "rule.nothing_to_serve", "text": "Tak ada yang bisa disajikan.", "src": "Nothing to serve."},
{"key": "rule.nothing_to_wash", "text": "Tak ada yang bisa dicuci di tanganmu.", "src": "There is nothing in your hands to wash."},
{"key": "rule.one_fitting_a_night", "text": "Satu perabot per malam — sisanya bisa menunggu besok.", "src": "One fitting a night — the rest keeps until tomorrow."},
{"key": "rule.pour_unmixed", "text": "Dua alkohol di shaker — kocok atau aduk dulu sebelum masuk gelas.", "src": "Two spirits in the tin — shake it or stir it before it goes to the glass."},
{"key": "rule.pull_cocktail_in_tin", "text": "Selesaikan atau buang koktailnya sebelum menuang bir.", "src": "Finish or bin the cocktail before you pull a pint."},
{"key": "rule.pull_glass_full", "text": "Gelasnya penuh. Sajikan atau buang.", "src": "The glass is full. Serve it or bin it."},
{"key": "rule.pull_glass_taken", "text": "Sudah ada minuman di gelas itu — sajikan atau buang sebelum menuang bir.", "src": "There is already a drink in that glass — serve it or bin it before pulling a pint."},
{"key": "rule.recipe_not_earned", "text": "{recipe} belum bisa diraih — {lock}.", "src": "{recipe} is not earned yet — {lock}."},
{"key": "rule.recipe_short_money", "text": "Uang tidak cukup — {recipe} seharga {price}.", "src": "Not enough money — {recipe} costs {price}."},
{"key": "rule.refund_under_rung", "text": "{fixture} ada di bawah jenjang yang lebih tinggi; kembalikan yang itu dulu.", "src": "{fixture} is under a higher rung; take that one back first."},
{"key": "rule.refund_under_tower", "text": "{fixture} ada di bawah menara {lines} jalur; kembalikan yang itu dulu.", "src": "{fixture} is under the {lines}-line tower; take that one back first."},
{"key": "rule.shake_empty", "text": "Shaker kosong, tak ada yang bisa dikocok.", "src": "Nothing in the shaker to shake."},
{"key": "rule.sink_running", "text": "Wastafel masih mengalir — tunggu sebentar.", "src": "The sink is running — wait for it."},
{"key": "rule.snack_bowl_empty", "text": "Mangkuk {snack} kosong hari ini.", "src": "The {snack} bowl is empty today."},
{"key": "rule.snack_needs_order", "text": "Camilan ikut pesanan minuman — mereka belum memesan.", "src": "Snacks ride a drink order — they have not ordered one yet."},
{"key": "rule.snack_not_at_bar", "text": "Mereka tidak ada di bar.", "src": "They are not at the bar."},
{"key": "rule.still_choosing", "text": "Mereka masih memilih.", "src": "They are still choosing."},
{"key": "rule.still_talking", "text": "Mereka masih bicara. Belum ada pesanan.", "src": "They are still talking. Nothing ordered yet."},
{"key": "rule.stir_empty", "text": "Shaker kosong, tak ada yang bisa diaduk.", "src": "Nothing in the shaker to stir."},
{"key": "rule.trial_not_asked", "text": "Mereka belum meminta apa-apa.", "src": "They have not asked for anything yet."},
{"key": "rule.trial_over", "text": "Ujian itu sudah selesai.", "src": "That trial is already over."},
{"key": "rule.trial_started", "text": "Ujian itu sudah dimulai.", "src": "That trial has already started."},
{"key": "rule.wipe_glass_first", "text": "Ambil gelasnya dulu — kamu tak bisa mengelap di bawahnya.", "src": "Collect the glass first — you cannot wipe under it."},
