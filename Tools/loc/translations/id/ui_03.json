{"key": "data.fixture.art_city.blurb", "text": "Cakrawala kota di malam hari dalam tiga bingkai. Satu-satunya pemandangan di ruangan ini yang bukan dari jendela."},
{"key": "data.fixture.art_city.name", "text": "Triptik Kota"},
{"key": "data.fixture.back6_chevron.blurb", "text": "Zigzag koral, krem, dan toska dari sudut ke sudut di atas panel dinding. Ruangan ini tak lagi terasa diam."},
{"key": "data.fixture.back6_chevron.name", "text": "Dinding Chevron"},
{"key": "data.fixture.beer_mat.blurb", "text": "Karet hitam di bawah keran bir. Menampung apa yang luput dari gelas."},
{"key": "data.fixture.beer_mat.name", "text": "Alas Tetesan"},
{"key": "data.fixture.ceil6_grid.blurb", "text": "Panel persegi, masing-masing dengan roset merah muda di tengahnya. Plafon yang baru kamu sadari di gelas kedua."},
{"key": "data.fixture.ceil6_grid.name", "text": "Panel Roset"},
{"key": "data.fixture.ceil6_ray.blurb", "text": "Sinar koral dan magenta memancar dari tengah ruangan. Seluruh tempat seakan condong ke arah bar."},
{"key": "data.fixture.ceil6_ray.name", "text": "Plafon Sinar Surya"},
{"key": "data.fixture.ceil6_stars.blurb", "text": "Biru malam dengan bintang emas bertaburan. Di luar sudah jam tutup, di dalam masih happy hour."},
{"key": "data.fixture.ceil6_stars.name", "text": "Plafon Bintang"},
{"key": "data.fixture.ceil_beams.blurb", "text": "Balok gelap melintang di atas plester. Ruangan jadi punya penutup, dan lampu punya sesuatu untuk disinari."},
{"key": "data.fixture.ceil_beams.name", "text": "Plafon Balok"},
{"key": "data.fixture.ceil_deco.blurb", "text": "Lis krem bertingkat dalam panel panjang. Mirip plafon tempat yang tarifnya lebih mahal."},
{"key": "data.fixture.ceil_deco.name", "text": "Plafon Deco"},
{"key": "data.fixture.ceil_palm.blurb", "text": "Daun palem dilukis di atas kepala, seolah bar ini berada di bawah pohon. Asap melayang di sela-selanya."},
{"key": "data.fixture.ceil_palm.name", "text": "Plafon Palem"},
{"key": "data.fixture.ceil_stucco.blurb", "text": "Plester putih hangat berpola putaran tangan. Setiap lampu di ruangan tampak lebih lembut di bawahnya."},
{"key": "data.fixture.ceil_stucco.name", "text": "Plafon Stuko"},
{"key": "data.fixture.counter_sink.blurb", "text": "Air dingin, saluran yang gompal, dan pemilik gedung yang menghitung apa saja yang dibuang ke sana."},
{"key": "data.fixture.counter_sink.name", "text": "Wastafel Baja"},
{"key": "data.fixture.flamingo_triptych.blurb", "text": "Pantai dalam tiga bingkai. Flamingonya tetap tinggal lewat jam tutup."},
{"key": "data.fixture.flamingo_triptych.name", "text": "Triptik Flamingo"},
{"key": "data.fixture.floor6_chip.blurb", "text": "Serpihan koral, toska, dan krem tertanam di lantai krem yang mengilap. Lantai lobi hotel untuk ruangan yang bukan hotel."},
{"key": "data.fixture.floor6_chip.name", "text": "Teraso Miami"},
{"key": "data.fixture.floor6_grid.blurb", "text": "Ubin gelap bergaris merah muda dan sian, seperti keluar dari video game. Berjalan ke bar terasa seperti level satu."},
{"key": "data.fixture.floor6_grid.name", "text": "Kisi Neon"},
{"key": "data.fixture.floor6_wave.blurb", "text": "Ombak toska bergulung di seluruh lantai. Air pasang datang lalu betah tinggal untuk minum."},
{"key": "data.fixture.floor6_wave.name", "text": "Ubin Ombak"},
{"key": "data.fixture.floor_carpet.blurb", "text": "Karpet ungu plum bermotif ramai, jenis yang memaafkan segalanya. Ruangan jadi hening di bawah kaki."},
{"key": "data.fixture.floor_carpet.name", "text": "Karpet"},
{"key": "data.fixture.floor_check.blurb", "text": "Kotak hitam dan putih sampai ke dinding belakang. Setiap kedai di setiap film punya lantai begini."},
{"key": "data.fixture.floor_check.name", "text": "Lantai Catur"},
{"key": "data.fixture.floor_marble.blurb", "text": "Batu putih yang dingin dengan urat abu-abu. Suara hak sepatu terdengar mahal di atasnya."},
{"key": "data.fixture.floor_marble.name", "text": "Lantai Marmer"},
{"key": "data.fixture.floor_rug.blurb", "text": "Oranye mengalir di atas toska, seperti garis pantai dilihat dari udara. Meredam gema papan lantai."},
{"key": "data.fixture.floor_rug.name", "text": "Permadani Pasang"},
{"key": "data.fixture.floor_terra.blurb", "text": "Ubin tanah liat yang hangat di atas papan. Menyembunyikan minuman tumpah lebih baik daripada kayu."},
{"key": "data.fixture.floor_terra.name", "text": "Terakota"},
{"key": "data.fixture.lamp6_neonbar.blurb", "text": "Tabung merah muda dan tabung sian berdampingan di tiap penyangga. Dindingnya berdengung, begitu pula ruangannya."},
{"key": "data.fixture.lamp6_neonbar.name", "text": "Lampu Dinding Neon"},
{"key": "data.fixture.lamp6_scallop.blurb", "text": "Kap krem di lengan kuningan, menyiram dinding dengan cahaya hangat. Jenis lampu yang biasa ada di bar hotel."},
{"key": "data.fixture.lamp6_scallop.name", "text": "Lampu Kap Gelombang"},
{"key": "data.fixture.lamp6_shell.blurb", "text": "Kerang laut berwarna koral yang bersinar dari dalam. Semua orang di bawahnya tampak seperti baru pulang liburan."},
{"key": "data.fixture.lamp6_shell.name", "text": "Lampu Kerang"},
{"key": "data.fixture.neon6_bird.blurb", "text": "Seekor pelikan dari tabung putih dan merah muda, paruhnya penuh. Warga sekitar menyebut bar ini dengan namanya."},
{"key": "data.fixture.neon6_bird.name", "text": "Pelikan Neon"},
{"key": "data.fixture.neon6_glass.blurb", "text": "Gelas tinggi berwarna sian berisi merah muda, dengan ceri di bibirnya. Papan ini menjelaskan untuk apa bar ini ada."},
{"key": "data.fixture.neon6_glass.name", "text": "Gelas Neon"},
{"key": "data.fixture.neon6_sun.blurb", "text": "Setengah matahari tenggelam ke garis-garis merah muda. Terbenam setiap malam tepat saat bar dibuka."},
{"key": "data.fixture.neon6_sun.name", "text": "Senja Neon"},
{"key": "data.fixture.neon_flamingo.blurb", "text": "Flamingo merah muda berdiri dengan satu kaki, berdengung pelan. Tak pernah lelah berdiri di sana."},
{"key": "data.fixture.neon_flamingo.name", "text": "Flamingo Neon"},
{"key": "data.fixture.neon_martini.blurb", "text": "Papan klasik: gelas yang tak pernah kosong."},
{"key": "data.fixture.neon_martini.name", "text": "Martini Neon"},
{"key": "data.fixture.picR6_conv.blurb", "text": "Mobil atap terbuka berwarna putih di jalan tepi laut. Seseorang melukisnya dari ingatan."},
{"key": "data.fixture.picR6_conv.name", "text": "Jalan Pesisir"},
{"key": "data.fixture.picR6_shapes.blurb", "text": "Segitiga, lingkaran, dan coretan dalam warna-warna ruangan ini. Tak ada yang sepakat itu gambar apa."},
{"key": "data.fixture.picR6_shapes.name", "text": "Bentuk Memphis"},
{"key": "data.fixture.picR6_sunset.blurb", "text": "Dua pohon palem, matahari merah muda, dan laut pirus, dalam bingkai emas yang tipis."}
]}
