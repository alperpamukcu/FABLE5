{"key": "data.voice.brit.another.0", "text": "Sama lagi, mate!", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "Satu lagi, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "Go on, satu lagi!", "src": "Go on, another!"},
