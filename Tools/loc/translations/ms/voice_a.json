{"key": "data.voice.african.perfect.0", "text": "Ah, sedap!", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "Betul!", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "Yang ini mantap!", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, yang ini betul. Terima kasih.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "Langsung no wahala. Sedap sangat.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "Kawan, awak memang pandai.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "Kawan saya, {advice_l}", "src": "My friend, {advice_l}"},
