{"key": "data.voice.brit.close.2", "text": "Alright, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Charming. Memang charming.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "Right. Okey. Cheers for nothing.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "Awak buat lawak ke?", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Right. Dah cukup lama saya tunggu.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "Tak kuasa. Saya blah.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Teruk sikit, ni. Bye.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "Satu {drink}, mate, bila awak senang.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, please. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "Okey lah, satu {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "Saya nak {drink}, ta.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "Lovely!", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "Cheers, mate!", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "Memang proper!", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Blimey. Sedap betul ni.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Awak buat dengan betul.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Bagus gila, yang ni.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "Satu perkara: {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Look, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Lain macam sikit, ni.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Erm, bukan saya punya.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "Bukan yang saya minta.", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "Satu lagi, yaar!", "src": "One more, yaar!"},
