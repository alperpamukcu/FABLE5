{"key": "data.voice.african.order.0", "text": "Satu {drink}, tolong.", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "Satu {drink}, kawan saya.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Saya nak {drink}.", "src": "I will have a {drink}."},
