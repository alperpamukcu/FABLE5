{"key": "data.voice.african.sip.2", "text": "Boleh, tapi {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah, bukan.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "Bukan yang ini.", "src": "This is not it."},
