{"key": "recipes.way_line", "text": "{prep} · GELAS {glass}", "src": "{prep} · {glass} GLASS"},
{"key": "rule.already_at_bar", "text": "Mereka sudah ada di bar.", "src": "They are already at the bar."},
{"key": "rule.bar_top_best", "text": "Permukaan bar sudah yang terbaik.", "src": "The bar top is already the best one."},
{"key": "rule.bottle_owned", "text": "Botol itu sudah milik anda.", "src": "That bottle is already yours."},
{"key": "rule.card_not_read", "text": "Kad belum dibaca; dokumen ada di belakangnya.", "src": "The card has not been read; the papers are behind it."},
{"key": "rule.counter_clean", "text": "Kaunter di sini sudah bersih.", "src": "The counter is clean here."},
{"key": "rule.drink_in_shaker", "text": "Minuman itu masih dalam shaker — tuang ke dalam gelas dulu.", "src": "That drink is still in the shaker — pour it into a glass first."},
{"key": "rule.fixture_needs_stars", "text": "{fixture} perlukan premis {stars} bintang; bar ini dinilai {rating}.", "src": "{fixture} needs a {stars}-star room; this bar rates {rating}."},
{"key": "rule.fixture_owned", "text": "Bar sudah ada {fixture}.", "src": "The bar already has {fixture}."},
{"key": "rule.fixture_rung_one_at_a_time", "text": "{fixture} ialah tahap {level} dalam tangganya; bar berada di tahap {bar_level}. Ia naik satu tahap demi satu.", "src": "{fixture} is rung {level} of its ladder; the bar stands on rung {bar_level}. It climbs one rung at a time."},
{"key": "rule.fixture_tower_one_line", "text": "{fixture} ada {lines} saluran; bar ini ada {bar_lines}. Menara dipasang satu saluran demi satu.", "src": "{fixture} runs {lines} lines; this bar runs {bar_lines}. A tower is fitted one line at a time."},
{"key": "rule.glass_line_finest", "text": "Barisan {glass} sudah yang terbaik.", "src": "The {glass} line is already the finest."},
{"key": "rule.kick_already_served", "text": "Anda tak boleh halau orang yang sudah dilayan; kad itulah peluang anda.", "src": "You cannot show the door to someone you have already served; the card was your moment."},
{"key": "rule.kick_guest_of_house", "text": "Tetamu istimewa bar bukan untuk anda halau.", "src": "The guest of the house is not yours to show the door."},
{"key": "rule.kick_read_card_first", "text": "Baca kad dulu.", "src": "Read the card first."},
{"key": "rule.no_glass_to_collect", "text": "Tiada gelas di sini untuk dikutip.", "src": "There is no glass here to collect."},
{"key": "rule.no_last_call", "text": "Tiada siapa menunggu pesanan terakhir.", "src": "Nobody is waiting on the last call."},
{"key": "rule.no_pourable_drinks", "text": "Belum ada minuman yang boleh anda tuang.", "src": "No drinks you can pour yet."},
{"key": "rule.no_room_stool", "text": "Tiada ruang untuk bangku lagi.", "src": "No room for another stool."},
{"key": "rule.not_enough_money", "text": "Duit tak cukup ({money} < {price}).", "src": "Not enough money ({money} < {price})."},
{"key": "rule.not_on_counter", "text": "Itu tiada di kaunter ini.", "src": "That is not on this counter."},
{"key": "rule.not_ordered", "text": "Mereka belum memesan.", "src": "They have not ordered yet."},
{"key": "rule.not_waiting", "text": "Mereka sudah tak menunggu lagi.", "src": "They are not waiting any more."},
{"key": "rule.not_waiting_at_bar", "text": "Mereka tidak menunggu di bar.", "src": "They are not waiting at the bar."},
{"key": "rule.nothing_to_serve", "text": "Tiada apa untuk dihidang.", "src": "Nothing to serve."},
{"key": "rule.nothing_to_wash", "text": "Tiada apa di tangan anda untuk dibasuh.", "src": "There is nothing in your hands to wash."},
{"key": "rule.one_fitting_a_night", "text": "Satu pemasangan semalam — yang lain tunggu esok.", "src": "One fitting a night — the rest keeps until tomorrow."},
{"key": "rule.pour_unmixed", "text": "Dua spirit dalam tin — goncang atau kacau sebelum masuk ke gelas.", "src": "Two spirits in the tin — shake it or stir it before it goes to the glass."},
{"key": "rule.pull_cocktail_in_tin", "text": "Habiskan atau buang koktel dulu sebelum tarik bir.", "src": "Finish or bin the cocktail before you pull a pint."},
{"key": "rule.pull_glass_full", "text": "Gelas dah penuh. Hidangkan atau buang.", "src": "The glass is full. Serve it or bin it."},
{"key": "rule.pull_glass_taken", "text": "Sudah ada minuman dalam gelas itu — hidangkan atau buang sebelum tarik bir.", "src": "There is already a drink in that glass — serve it or bin it before pulling a pint."},
{"key": "rule.recipe_not_earned", "text": "{recipe} belum diraih — {lock}.", "src": "{recipe} is not earned yet — {lock}."},
{"key": "rule.recipe_short_money", "text": "Duit tak cukup — {recipe} berharga {price}.", "src": "Not enough money — {recipe} costs {price}."},
{"key": "rule.refund_under_rung", "text": "{fixture} ada di bawah tahap yang lebih tinggi; pulangkan yang itu dulu.", "src": "{fixture} is under a higher rung; take that one back first."},
{"key": "rule.refund_under_tower", "text": "{fixture} ada di bawah menara {lines} saluran; pulangkan yang itu dulu.", "src": "{fixture} is under the {lines}-line tower; take that one back first."},
{"key": "rule.shake_empty", "text": "Tiada apa dalam shaker untuk digoncang.", "src": "Nothing in the shaker to shake."},
{"key": "rule.sink_running", "text": "Air singki masih mengalir — tunggu sekejap.", "src": "The sink is running — wait for it."},
{"key": "rule.snack_bowl_empty", "text": "Mangkuk {snack} kosong hari ini.", "src": "The {snack} bowl is empty today."},
{"key": "rule.snack_needs_order", "text": "Snek ikut pesanan minuman — mereka belum pesan apa-apa.", "src": "Snacks ride a drink order — they have not ordered one yet."},
{"key": "rule.snack_not_at_bar", "text": "Mereka tiada di bar.", "src": "They are not at the bar."},
{"key": "rule.still_choosing", "text": "Mereka masih memilih.", "src": "They are still choosing."},
{"key": "rule.still_talking", "text": "Mereka masih bercakap. Belum pesan apa-apa.", "src": "They are still talking. Nothing ordered yet."},
{"key": "rule.stir_empty", "text": "Tiada apa dalam shaker untuk dikacau.", "src": "Nothing in the shaker to stir."},
{"key": "rule.trial_not_asked", "text": "Mereka belum minta apa-apa.", "src": "They have not asked for anything yet."},
{"key": "rule.trial_over", "text": "Cabaran itu sudah tamat.", "src": "That trial is already over."},
{"key": "rule.trial_started", "text": "Cabaran itu sudah bermula.", "src": "That trial has already started."},
{"key": "rule.wipe_glass_first", "text": "Kutip gelas dulu — anda tak boleh lap di bawahnya.", "src": "Collect the glass first — you cannot wipe under it."},
