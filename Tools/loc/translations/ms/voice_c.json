{"strings": [
{"key": "data.voice.aussie.another.0", "text": "Sama lagi, mate!", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "Satu lagi, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "Lagi, legend!", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "Yeah, righto.", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "Boleh tahan, mate.", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "Cukuplah tu.", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "Serius ke, mate?", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto. Fair enough.", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Nah, kasar tu.", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto, dah cukup lama saya tunggu.", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Nah, malas. Saya pergi.", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "Cheers for nothing, mate.", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "Satu {drink}, mate.", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink}, please.", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "Saya ambil {drink}.", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "Satu {drink}, cheers.", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "Ripper!", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "Too easy!", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "Mantap gila!", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "Bloody ripper, mate. Cheers.", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "Too easy. Awak memang tahu kerja.", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "Terbaik malam ini, jujur.", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "Begini, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "No dramas, tapi {advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Nah, mate.", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "Bukan saya punya, sori.", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "Salah, mate.", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "Satu round lagi!", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "Sama macam tadi!", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "Bawa lagi!", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "Terima kasih.", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "Okeylah tu.", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "Dekat-dekat dah.", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "Serius? Okey.", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "Awak buat silap ni.", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "Suka hatilah. Simpan bar awak.", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "Tak payahlah. Penat tunggu.", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "Ada orang kerja ke malam ni?", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "Okey. Saya minum tempat lain.", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink}, satu.", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "Saya nak {drink}.", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "Satu {drink}, bila senang nanti.", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "Bagi {drink} lah.", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "Sempurna!", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "Ini dia!", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "Tepat!", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "Tak ada apa nak ubah.", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "Haa, ini baru minuman.", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "Siapa ajar awak, cakap terima kasih kat dia.", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "Hmm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice} Cakap je.", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "Jujurnya? {advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "Bukan yang saya minta.", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "Salah minuman.", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "Itu bukan saya punya.", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "Encore, tolong!", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "Satu lagi, oui!", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "Lagi, merci!", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ca va.", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "Okey je.", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon, okey.", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "Quoi? Betul ke?", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Bon. Au revoir.", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule.", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non. Dah cukup saya tunggu.", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis. Saya pergi.", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "Au revoir, kalau begitu.", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "Satu {drink}, s'il vous plait.", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "{drink}, tolong.", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "Un {drink}, merci.", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "Saya ambil {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "Parfait!", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "Voila, sempurna!", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "Magnifique!", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait. Langsung tiada komen.", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voila. Ada orang sini yang pandai tuang.", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique. Sungguh.", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Ecoute, {advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon, {advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors, {advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non.", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "Bukan yang ini.", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon, salah.", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "Mou ippai!", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "Satu lagi, kanpai!", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "Lagi, onegai!", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Hai, okey.", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa.", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "Boleh tahan, ne.", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "Eh?! Betul ke?", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi. Okey, saya pergi.", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta. Sayonara.", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen, saya tak boleh tunggu lagi.", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii. Saya pergi.", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai. Selamat tinggal.", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen, satu {drink}.", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "Satu {drink}, onegai.", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink}, tolong. Arigatou.", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto… satu {drink}.", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "Oishii!", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "Sugoi, sempurna!", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "Kanpai!", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii. Sungguh, inilah dia.", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "Sugoi. Awak memang pro, ne.", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "Kanpai. Ini sempurna.", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "Etto, {advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "Ne, {advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "Sumimasen, tapi {advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "Chotto… bukan.", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "Eh? Bukan ini.", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "Chigau, maaf.", "src": "Chigau, sorry."},
{"key": "data.voice.midwest.another.0", "text": "Satu lagi, please!", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "Tambah satu, thanks!", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "Sama lagi, ope!", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "Oh, okey je.", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "Sure, terima kasih.", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "Boleh tahan juga.", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "Oh. Well. Okey kalau macam tu.", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "Ope, maaf… saya pergi.", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "Melampau sikit, tapi okey.", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "Oh gosh, saya betul-betul tak boleh tunggu lagi.", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "Well, saya patut gerak dulu.", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "Maaf, tapi saya minta diri.", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "Boleh saya dapat {drink}? Thanks a bunch.", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "Satu {drink}, kalau tak menyusahkan.", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "Oh, {drink} je untuk saya.", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink}, please. Bila-bila pun boleh.", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "Oh, real nice!", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "You betcha!", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "Oh jeez, ya!", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "Oh my gosh, cantiknya.", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "Real nice. Makcik saya mesti suka tempat ni.", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "Well, itu memang kena.", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "Oh, {advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "Sekadar makluman, {advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "Bukan hal besar, tapi {advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "Ope. Salah.", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "Oh, itu bukan saya punya.", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "Maaf, bukan. Bukan ini.", "src": "Sorry, no. Not this."},
{"key": "data.voice.polish.another.0", "text": "Jeszcze raz!", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "Satu lagi, proszę!", "src": "Another, proszę!"},
{"key": "data.voice.polish.another.2", "text": "Tambah satu!", "src": "One more!"},
{"key": "data.voice.polish.close.0", "text": "Dobrze.", "src": "Dobrze."},
{"key": "data.voice.polish.close.1", "text": "Okey.", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "Bolehlah, terima kasih.", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "Serio? Okey.", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "Baiklah. Do widzenia.", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "Co? Okey, saya pergi.", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "Cukup. Saya pergi.", "src": "Enough. I'm going."},
{"key": "data.voice.polish.leaving.1", "text": "Nie, nie. Lama sangat.", "src": "Nie, nie. Too long."},
{"key": "data.voice.polish.leaving.2", "text": "Do widzenia.", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "Satu {drink}, proszę.", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "{drink}, tolong.", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "Satu {drink}. Terima kasih.", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "Dobrze, satu {drink}.", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "Na zdrowie!", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "Świetnie!", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "Bagus sangat!", "src": "Very good!"},
{"key": "data.voice.polish.praise.0", "text": "Na zdrowie. Ini baru minuman.", "src": "Na zdrowie. This is a real drink."},
{"key": "data.voice.polish.praise.1", "text": "Świetnie. Macam di kampung halaman.", "src": "Świetnie. Like at home."},
{"key": "data.voice.polish.praise.2", "text": "Dobrze. Bagus, bagus sangat.", "src": "Dobrze. Very, very good."},
{"key": "data.voice.polish.sip.0", "text": "Dobrze, tapi {advice_l}", "src": "Dobrze, but {advice_l}"},
{"key": "data.voice.polish.sip.1", "text": "Dengar, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.polish.sip.2", "text": "Hm, {advice_l}", "src": "Hm, {advice_l}"},
{"key": "data.voice.polish.wrong.0", "text": "Nie. Salah.", "src": "Nie. Wrong one."},
{"key": "data.voice.polish.wrong.1", "text": "Ini bukan saya punya.", "src": "This is not mine."},
{"key": "data.voice.polish.wrong.2", "text": "Co to jest?", "src": "Co to jest?"},
{"key": "data.voice.turkish.another.0", "text": "Bir daha!", "src": "Bir daha!"},
{"key": "data.voice.turkish.another.1", "text": "Satu lagi, abi!", "src": "Another, abi!"},
{"key": "data.voice.turkish.another.2", "text": "Lagi, eyvallah!", "src": "Again, eyvallah!"},
{"key": "data.voice.turkish.close.0", "text": "Tamam.", "src": "Tamam."},
{"key": "data.voice.turkish.close.1", "text": "İdare eder.", "src": "İdare eder."},
{"key": "data.voice.turkish.close.2", "text": "Okey, bolehlah.", "src": "Okay, fine."},
{"key": "data.voice.turkish.kicked.0", "text": "Ciddi misin? Okey.", "src": "Ciddi misin? Okay."},
{"key": "data.voice.turkish.kicked.1", "text": "Abi, betul ke? Baiklah.", "src": "Abi, really? Fine."},
{"key": "data.voice.turkish.kicked.2", "text": "Yok, yok. Saya pergi.", "src": "Yok, yok. I'm going."},
{"key": "data.voice.turkish.leaving.0", "text": "Yok, saya tak nak tunggu lagi.", "src": "Yok, I'm not waiting anymore."},
{"key": "data.voice.turkish.leaving.1", "text": "Abi, tak ada orang kerja ke sini?", "src": "Abi, is nobody working here?"},
{"key": "data.voice.turkish.leaving.2", "text": "Tamam, hoşça kal.", "src": "Tamam, hoşça kal."},
{"key": "data.voice.turkish.order.0", "text": "Abi, satu {drink}.", "src": "Abi, a {drink}."},
{"key": "data.voice.turkish.order.1", "text": "Satu {drink}, eyvallah.", "src": "One {drink}, eyvallah."},
{"key": "data.voice.turkish.order.2", "text": "{drink}, canım, bila sempat.", "src": "{drink}, canım, when you can."},
{"key": "data.voice.turkish.order.3", "text": "Bir {drink}, tolong.", "src": "Bir {drink}, please."},
{"key": "data.voice.turkish.perfect.0", "text": "Eyvallah!", "src": "Eyvallah!"},
{"key": "data.voice.turkish.perfect.1", "text": "Harika!", "src": "Harika!"},
{"key": "data.voice.turkish.perfect.2", "text": "Süper, abi!", "src": "Süper, abi!"},
{"key": "data.voice.turkish.praise.0", "text": "Eyvallah. Beginilah caranya.", "src": "Eyvallah. This is how it's done."},
{"key": "data.voice.turkish.praise.1", "text": "Abi, tabik spring. Harika.", "src": "Abi, my hat is off. Harika."},
{"key": "data.voice.turkish.praise.2", "text": "Tamam, awak tahu kerja awak.", "src": "Tamam, you know your work."},
{"key": "data.voice.turkish.sip.0", "text": "Abi, {advice_l}", "src": "Abi, {advice_l}"},
