{"strings": [
{"key": "data.voice.aussie.another.0", "text": "Remets ça, mate !", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "Encore une, cheers !", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "Une autre, legend !", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "Ouais, righto.", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "Pas mal, mate.", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "Ça fera l'affaire.", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "Sérieux, mate ?", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto. C'est de bonne guerre.", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Nah, c'est dur, ça.", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto, j'ai assez attendu.", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Nah, laisse tomber. Je file.", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "Merci pour rien, mate.", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "{drink}, mate.", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink}, s'il te plaît.", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "Je vais me prendre : {drink}.", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "{drink}, cheers.", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "Ripper !", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "Too easy !", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "Sacrément bon !", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "Bloody ripper, mate. Cheers.", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "Too easy. Tu connais ton affaire.", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "Le meilleur de la soirée, franchement.", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "Écoute, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "No dramas, mais {advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Nah, mate.", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "Pas le mien, désolé.", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "Pas le bon, mate.", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "Une autre !", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "La même chose !", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "Continue comme ça !", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "Merci.", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "Ça ira.", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "Pas loin.", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "Sérieusement ? Bon.", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "Tu fais une erreur.", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "Comme tu veux. Garde ton bar.", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "Laisse tomber. J'en ai assez d'attendre.", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "Il y a quelqu'un qui bosse, ce soir ?", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "Bon. J'irai boire ailleurs.", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink}, s'il te plaît.", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "Je vais prendre : {drink}.", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "{drink}, quand tu as une seconde.", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "Ce sera : {drink}.", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "Parfait !", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "C'est exactement ça !", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "Pile-poil !", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "Je n'y changerais rien.", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "Ça, c'est une boisson.", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "Remercie celui qui t'a appris.", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice} Je dis ça comme ça.", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "Franchement ? {advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "Ce n'est pas ma commande.", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "Mauvaise boisson.", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "Ce n'est pas le mien.", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "Remets-nous ça !", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "Allez, la petite sœur !", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "Encore une, merci !", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ça va.", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "Ça passe.", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon, ok.", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "Quoi ? Sérieux ?", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Bon. Au revoir.", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule.", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non. J'ai assez attendu.", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis. J'y vais.", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "Au revoir, alors.", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "{drink}, s'il te plaît.", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "Je vais te prendre : {drink}.", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "{drink}, merci.", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "Allez, envoie : {drink} !", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "Parfait !", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "Voilà, nickel !", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "Magnifique !", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait. Rien à redire.", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voilà. Enfin quelqu'un qui sait servir.", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique. Vraiment.", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Écoute, {advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon, {advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors, {advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non.", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "C'est pas ça.", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon, erreur.", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "Mou ippai !", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "Encore une, kanpai !", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "La même, onegai !", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Hai, d'accord.", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa.", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "Pas mal, ne.", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "Eh ?! Vraiment ?", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi. Bon, je m'en vais.", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta. Sayonara.", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen, je ne peux plus attendre.", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii. J'y vais.", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai. Au revoir.", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen, {drink}.", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "{drink}, onegai.", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink}, s'il te plaît. Arigatou.", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto… {drink}.", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "Oishii !", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "Sugoi, parfait !", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "Kanpai !", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii. Vraiment, c'est exactement ça.", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "Sugoi. Du travail de pro, ne.", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "Kanpai. C'est parfait.", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "Etto, {advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "Ne, {advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "Sumimasen, mais {advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "Chotto… non.", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "Eh ? Pas ça.", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "Chigau, désolé.", "src": "Chigau, sorry."},
{"key": "data.voice.midwest.another.0", "text": "Une autre, s'il te plaît !", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "Encore une, merci !", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "La même, ope !", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "Oh, c'est très bien.", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "Bien sûr, merci.", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "Pas mal du tout.", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "Oh. Bon. D'accord, alors.", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "Ope, pardon… Je m'en vais.", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "C'est un peu fort, mais d'accord.", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "Oh gosh, je ne peux vraiment plus attendre.", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "Bon, je ferais mieux d'y aller.", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "Pardon, mais je vais y aller.", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "Je pourrais avoir : {drink} ? Merci mille fois.", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "{drink}, si ça ne te dérange pas.", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "Oh, pour moi juste : {drink}.", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink}, s'il te plaît. Quand tu peux.", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "Oh, super chouette !", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "You betcha !", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "Oh jeez, oui !", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "Oh my gosh, c'est tout simplement délicieux.", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "Super chouette. Ma tante adorerait cet endroit.", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "Eh bien, ça fait du bien.", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "Oh, {advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "Juste pour info, {advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "Rien de grave, mais {advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "Ope. Pas le bon.", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "Oh, ce n'est pas le mien.", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "Pardon, non. Pas ça.", "src": "Sorry, no. Not this."},
{"key": "data.voice.polish.another.0", "text": "Jeszcze raz !", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "Une autre, proszę !", "src": "Another, proszę!"},
{"key": "data.voice.polish.another.2", "text": "Encore une !", "src": "One more!"},
{"key": "data.voice.polish.close.0", "text": "Dobrze.", "src": "Dobrze."},
{"key": "data.voice.polish.close.1", "text": "Ok.", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "Ça va, merci.", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "Serio ? D'accord.", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "Très bien. Do widzenia.", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "Co ? Bon, je m'en vais.", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "Ça suffit. J'y vais.", "src": "Enough. I'm going."},
{"key": "data.voice.polish.leaving.1", "text": "Nie, nie. Trop long.", "src": "Nie, nie. Too long."},
{"key": "data.voice.polish.leaving.2", "text": "Do widzenia.", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "{drink}, proszę.", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "{drink}, s'il te plaît.", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "Pour moi : {drink}. Merci.", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "Dobrze, ce sera : {drink}.", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "Na zdrowie !", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "Świetnie !", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "Très bon !", "src": "Very good!"},
{"key": "data.voice.polish.praise.0", "text": "Na zdrowie. Ça, c'est une vraie boisson.", "src": "Na zdrowie. This is a real drink."},
{"key": "data.voice.polish.praise.1", "text": "Świetnie. Comme à la maison.", "src": "Świetnie. Like at home."},
{"key": "data.voice.polish.praise.2", "text": "Dobrze. Très, très bon.", "src": "Dobrze. Very, very good."},
{"key": "data.voice.polish.sip.0", "text": "Dobrze, mais {advice_l}", "src": "Dobrze, but {advice_l}"},
{"key": "data.voice.polish.sip.1", "text": "Écoute, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.polish.sip.2", "text": "Hm, {advice_l}", "src": "Hm, {advice_l}"},
{"key": "data.voice.polish.wrong.0", "text": "Nie. Pas le bon.", "src": "Nie. Wrong one."},
{"key": "data.voice.polish.wrong.1", "text": "Ce n'est pas le mien.", "src": "This is not mine."},
{"key": "data.voice.polish.wrong.2", "text": "Co to jest ?", "src": "Co to jest?"},
{"key": "data.voice.turkish.another.0", "text": "Bir daha !", "src": "Bir daha!"},
{"key": "data.voice.turkish.another.1", "text": "Une autre, abi !", "src": "Another, abi!"},
{"key": "data.voice.turkish.another.2", "text": "Encore une, eyvallah !", "src": "Again, eyvallah!"},
{"key": "data.voice.turkish.close.0", "text": "Tamam.", "src": "Tamam."},
{"key": "data.voice.turkish.close.1", "text": "İdare eder.", "src": "İdare eder."},
{"key": "data.voice.turkish.close.2", "text": "Ok, ça va.", "src": "Okay, fine."},
{"key": "data.voice.turkish.kicked.0", "text": "Ciddi misin ? Bon.", "src": "Ciddi misin? Okay."},
{"key": "data.voice.turkish.kicked.1", "text": "Abi, vraiment ? D'accord.", "src": "Abi, really? Fine."},
{"key": "data.voice.turkish.kicked.2", "text": "Yok, yok. Je m'en vais.", "src": "Yok, yok. I'm going."},
{"key": "data.voice.turkish.leaving.0", "text": "Yok, je n'attends plus.", "src": "Yok, I'm not waiting anymore."},
{"key": "data.voice.turkish.leaving.1", "text": "Abi, personne ne travaille ici ?", "src": "Abi, is nobody working here?"},
{"key": "data.voice.turkish.leaving.2", "text": "Tamam, hoşça kal.", "src": "Tamam, hoşça kal."},
{"key": "data.voice.turkish.order.0", "text": "Abi, {drink}.", "src": "Abi, a {drink}."},
{"key": "data.voice.turkish.order.1", "text": "{drink}, eyvallah.", "src": "One {drink}, eyvallah."},
{"key": "data.voice.turkish.order.2", "text": "{drink}, canım, quand tu peux.", "src": "{drink}, canım, when you can."},
{"key": "data.voice.turkish.order.3", "text": "Bir {drink}, s'il te plaît.", "src": "Bir {drink}, please."},
{"key": "data.voice.turkish.perfect.0", "text": "Eyvallah !", "src": "Eyvallah!"},
{"key": "data.voice.turkish.perfect.1", "text": "Harika !", "src": "Harika!"},
{"key": "data.voice.turkish.perfect.2", "text": "Süper, abi !", "src": "Süper, abi!"},
{"key": "data.voice.turkish.praise.0", "text": "Eyvallah. C'est comme ça qu'on fait.", "src": "Eyvallah. This is how it's done."},
{"key": "data.voice.turkish.praise.1", "text": "Abi, chapeau. Harika.", "src": "Abi, my hat is off. Harika."},
{"key": "data.voice.turkish.praise.2", "text": "Tamam, tu connais ton métier.", "src": "Tamam, you know your work."},
{"key": "data.voice.turkish.sip.0", "text": "Abi, {advice_l}", "src": "Abi, {advice_l}"},
