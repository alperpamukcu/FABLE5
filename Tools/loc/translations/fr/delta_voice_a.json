{"strings": [
{"key": "data.voice.african.another.0", "text": "Remets-en une !", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "Encore une, abeg !", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "La même, mon ami !", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "Ça va, c'est bien.", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "No wahala, ça ira.", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "D'accord, merci.", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "Ah ah ! Sérieux ?", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala. Je m'en vais.", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "Mon ami, ce n'est pas bien, ça.", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah ah. J'ai assez attendu.", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala. Je file.", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "Bon, je te laisse, mon ami.", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "{drink}, s'il te plaît.", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "Mon ami, pour moi : {drink}.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Je prendrai : {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "{drink}, abeg. Merci.", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "Ah, c'est bon, ça !", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "Correct, correct !", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "Celle-là est bonne !", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, celle-là est correcte. Merci.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "Zéro wahala. Très, très bon.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "Mon ami, toi, tu connais le livre.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "Mon ami, {advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg, écoute : {advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "C'est bien, mais {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah, non.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "Ce n'est pas ça.", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "Mon ami, non, non.", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "La même, mate !", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "Encore une, cheers !", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "Allez, go on, une autre !", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "Pas mal.", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Ta, ça ira.", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "Bon, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Charmant. Absolument charmant.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "Right. Bon. Merci pour rien.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "Tu te fiches de moi, là.", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Right. J'ai assez attendu.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "Tant pis. I'm off.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Un peu nul, tout ça. Bye.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "{drink}, mate, quand tu as une minute.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, s'il te plaît. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "Allez, go on : {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "Pour moi : {drink}, ta.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "Lovely, ça !", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "Bien joué, mate !", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "Drôlement bon !", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Blimey. C'est franchement délicieux.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Ça, c'est du travail propre.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Sacrément bon, ça.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "Petit détail : {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Écoute, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Un peu à côté, ça.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Euh, pas le mien.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "Pas ce que j'ai demandé.", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "Encore une, yaar !", "src": "One more, yaar!"},
{"key": "data.voice.desi.another.1", "text": "Aur ek !", "src": "Aur ek!"},
{"key": "data.voice.desi.another.2", "text": "La même, s'il te plaît !", "src": "Again, please!"},
{"key": "data.voice.desi.close.0", "text": "Theek hai.", "src": "Theek hai."},
{"key": "data.voice.desi.close.1", "text": "Ça va, na.", "src": "It is okay, na."},
{"key": "data.voice.desi.close.2", "text": "Chalega, ça passe.", "src": "Chalega."},
{"key": "data.voice.desi.kicked.0", "text": "Kya ? Sérieusement ?", "src": "Kya? Seriously?"},
{"key": "data.voice.desi.kicked.1", "text": "Arre. Bon, d'accord.", "src": "Arre. Okay, fine."},
{"key": "data.voice.desi.kicked.2", "text": "Chalo. Je m'en vais.", "src": "Chalo. I go."},
{"key": "data.voice.desi.leaving.0", "text": "Arre yaar. C'est trop long.", "src": "Arre yaar. Too long."},
{"key": "data.voice.desi.leaving.1", "text": "Chalo, j'y vais.", "src": "Chalo, I am going."},
{"key": "data.voice.desi.leaving.2", "text": "Bas. Ça suffit.", "src": "Bas. Enough."},
{"key": "data.voice.desi.order.0", "text": "{drink}, s'il te plaît.", "src": "One {drink}, please."},
{"key": "data.voice.desi.order.1", "text": "Yaar, pour moi : {drink}.", "src": "A {drink}, yaar."},
{"key": "data.voice.desi.order.2", "text": "Je prends ça : {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.desi.order.3", "text": "{drink}, na ?", "src": "{drink}, na?"},
{"key": "data.voice.desi.perfect.0", "text": "Wah, parfait !", "src": "Wah, perfect!"},
{"key": "data.voice.desi.perfect.1", "text": "Ekdum first class !", "src": "Ekdum first class!"},
{"key": "data.voice.desi.perfect.2", "text": "Bahut badhiya !", "src": "Bahut badhiya!"},
{"key": "data.voice.desi.praise.0", "text": "Wah. Ekdum parfait, yaar.", "src": "Wah. Ekdum perfect, yaar."},
{"key": "data.voice.desi.praise.1", "text": "Bahut badhiya. Vraiment.", "src": "Bahut badhiya. Really."},
{"key": "data.voice.desi.praise.2", "text": "First class. Je reviendrai.", "src": "First class. I am coming back."},
{"key": "data.voice.desi.sip.0", "text": "Arre, {advice_l}", "src": "Arre, {advice_l}"},
{"key": "data.voice.desi.sip.1", "text": "Yaar, {advice_l}", "src": "Yaar, {advice_l}"},
{"key": "data.voice.desi.sip.2", "text": "Theek hai, mais {advice_l}", "src": "Theek hai, but {advice_l}"},
{"key": "data.voice.desi.wrong.0", "text": "Arre, non.", "src": "Arre, no."},
{"key": "data.voice.desi.wrong.1", "text": "Ce n'est pas le mien.", "src": "This is not mine."},
{"key": "data.voice.desi.wrong.2", "text": "Nahi, pas celui-là.", "src": "Nahi, wrong one."},
{"key": "data.voice.german.another.0", "text": "Noch eins !", "src": "Noch eins!"},
{"key": "data.voice.german.another.1", "text": "Une autre, bitte !", "src": "Another, bitte!"},
{"key": "data.voice.german.another.2", "text": "La même, s'il te plaît !", "src": "Again, please!"},
{"key": "data.voice.german.close.0", "text": "Ja, d'accord.", "src": "Ja, okay."},
{"key": "data.voice.german.close.1", "text": "Acceptable.", "src": "Acceptable."},
{"key": "data.voice.german.close.2", "text": "C'est correct.", "src": "It is fine."},
{"key": "data.voice.german.kicked.0", "text": "C'est absurde.", "src": "This is absurd."},
{"key": "data.voice.german.kicked.1", "text": "Très bien. Je ne reviendrai pas.", "src": "Fine. I will not return."},
{"key": "data.voice.german.kicked.2", "text": "Ja, ja. Je m'en vais.", "src": "Ja, ja. I am going."},
{"key": "data.voice.german.leaving.0", "text": "Ce n'est pas acceptable. Je pars.", "src": "This is not acceptable. I am leaving."},
{"key": "data.voice.german.leaving.1", "text": "Nein. J'ai assez attendu.", "src": "Nein. I have waited enough."},
{"key": "data.voice.german.leaving.2", "text": "Unglaublich. Au revoir.", "src": "Unglaublich. Goodbye."},
{"key": "data.voice.german.order.0", "text": "{drink}, s'il te plaît. Fait correctement.", "src": "A {drink}, please. Correctly made."},
{"key": "data.voice.german.order.1", "text": "{drink}. Merci.", "src": "{drink}. Thank you."},
{"key": "data.voice.german.order.2", "text": "Pour moi : {drink}, bitte.", "src": "One {drink}, bitte."},
{"key": "data.voice.german.order.3", "text": "Je voudrais : {drink}.", "src": "I would like a {drink}."},
{"key": "data.voice.german.perfect.0", "text": "Genau !", "src": "Genau!"},
{"key": "data.voice.german.perfect.1", "text": "Sehr gut !", "src": "Sehr gut!"},
{"key": "data.voice.german.perfect.2", "text": "Wunderbar !", "src": "Wunderbar!"},
{"key": "data.voice.german.praise.0", "text": "Ja. C'est exactement ça.", "src": "Ja. This is exactly right."},
{"key": "data.voice.german.praise.1", "text": "Précis. Je respecte la précision.", "src": "Precise. I respect precision."},
{"key": "data.voice.german.praise.2", "text": "Sehr gut. Rien à redire.", "src": "Sehr gut. No notes."},
{"key": "data.voice.german.sip.0", "text": "Genau, mais {advice_l}", "src": "Genau, but {advice_l}"},
{"key": "data.voice.german.sip.1", "text": "Une remarque : {advice_l}", "src": "One remark: {advice_l}"},
{"key": "data.voice.german.sip.2", "text": "Ja, {advice_l}", "src": "Ja, {advice_l}"},
{"key": "data.voice.german.wrong.0", "text": "Nein. Pas ça.", "src": "Nein. Not this."},
{"key": "data.voice.german.wrong.1", "text": "C'est incorrect.", "src": "This is incorrect."},
{"key": "data.voice.german.wrong.2", "text": "Mauvaise boisson.", "src": "Wrong drink."},
{"key": "data.voice.korean.another.0", "text": "Han jan deo !", "src": "Han jan deo!"},
{"key": "data.voice.korean.another.1", "text": "Encore une !", "src": "One more!"},
{"key": "data.voice.korean.another.2", "text": "La même, juseyo !", "src": "Again, juseyo!"},
{"key": "data.voice.korean.close.0", "text": "Gwenchana.", "src": "Gwenchana."},
{"key": "data.voice.korean.close.1", "text": "Ça va, c'est bien.", "src": "It is okay."},
{"key": "data.voice.korean.close.2", "text": "Nappeuji anha. Pas mal.", "src": "Nappeuji anha."},
{"key": "data.voice.korean.kicked.0", "text": "Jinjja ? Waouh.", "src": "Jinjja? Wow."},
{"key": "data.voice.korean.kicked.1", "text": "Aish. D'accord.", "src": "Aish. Fine."},
{"key": "data.voice.korean.kicked.2", "text": "Annyeong, alors.", "src": "Annyeong, then."},
{"key": "data.voice.korean.leaving.0", "text": "Aish. Trop long.", "src": "Aish. Too long."},
{"key": "data.voice.korean.leaving.1", "text": "Je m'en vais. Annyeong.", "src": "I am going. Annyeong."},
{"key": "data.voice.korean.leaving.2", "text": "Mot chamgesseo. J'y vais.", "src": "Mot chamgesseo."},
{"key": "data.voice.korean.order.0", "text": "{drink}, juseyo.", "src": "{drink}, juseyo."},
{"key": "data.voice.korean.order.1", "text": "{drink}, s'il te plaît.", "src": "One {drink}, please."},
{"key": "data.voice.korean.order.2", "text": "Pour moi : {drink}.", "src": "A {drink} for me."},
{"key": "data.voice.korean.order.3", "text": "Moi, je veux : {drink}.", "src": "I want a {drink}."},
{"key": "data.voice.korean.perfect.0", "text": "Daebak !", "src": "Daebak!"},
{"key": "data.voice.korean.perfect.1", "text": "Jinjja bon !", "src": "Jinjja good!"},
{"key": "data.voice.korean.perfect.2", "text": "Choego !", "src": "Choego!"},
{"key": "data.voice.korean.praise.0", "text": "Daebak. Jinjja, c'est parfait.", "src": "Daebak. Jinjja, this is perfect."},
{"key": "data.voice.korean.praise.1", "text": "Choego. Je le pense vraiment.", "src": "Choego. I mean it."},
{"key": "data.voice.korean.praise.2", "text": "Waouh. Tu t'y connais.", "src": "Wow. You are good at this."},
{"key": "data.voice.korean.sip.0", "text": "Jamkkanman, {advice_l}", "src": "Jamkkanman, {advice_l}"},
{"key": "data.voice.korean.sip.1", "text": "Euh, {advice_l}", "src": "Um, {advice_l}"},
{"key": "data.voice.korean.sip.2", "text": "Gwenchana, mais {advice_l}", "src": "Gwenchana, but {advice_l}"},
{"key": "data.voice.korean.wrong.0", "text": "Aniyo, non.", "src": "Aniyo, no."},
{"key": "data.voice.korean.wrong.1", "text": "Ce n'est pas ça.", "src": "This is wrong."},
{"key": "data.voice.korean.wrong.2", "text": "Hein ? Pas le mien.", "src": "Eh? Not mine."},
{"key": "data.voice.nordic.another.0", "text": "Une autre. Skål !", "src": "Another. Skål!"},
{"key": "data.voice.nordic.another.1", "text": "Encore une.", "src": "One more."},
{"key": "data.voice.nordic.another.2", "text": "La même, s'il te plaît.", "src": "Again, please."},
{"key": "data.voice.nordic.close.0", "text": "Ça ira.", "src": "Fine."},
{"key": "data.voice.nordic.close.1", "text": "C'est correct.", "src": "It's okay."},
{"key": "data.voice.nordic.close.2", "text": "Bien assez bon.", "src": "Good enough."},
{"key": "data.voice.nordic.kicked.0", "text": "Bon. Bizarre, mais bon.", "src": "Okay. Strange, but okay."},
{"key": "data.voice.nordic.kicked.1", "text": "D'accord.", "src": "Fine."},
{"key": "data.voice.nordic.kicked.2", "text": "Hm. Au revoir, alors.", "src": "Hm. Goodbye then."},
{"key": "data.voice.nordic.leaving.0", "text": "Je vais y aller. Ce n'est rien.", "src": "I'll go. It's fine."},
{"key": "data.voice.nordic.leaving.1", "text": "Trop long. Au revoir.", "src": "Too long. Goodbye."},
{"key": "data.voice.nordic.leaving.2", "text": "Non. Je pars.", "src": "No. I'm leaving."},
{"key": "data.voice.nordic.order.0", "text": "{drink}. Merci.", "src": "A {drink}. Thanks."},
{"key": "data.voice.nordic.order.1", "text": "{drink}, s'il te plaît.", "src": "{drink}, please."},
{"key": "data.voice.nordic.order.2", "text": "Pour moi : {drink}. Rien ne presse.", "src": "One {drink}. No rush."},
{"key": "data.voice.nordic.order.3", "text": "Je prendrai : {drink}.", "src": "I'll have the {drink}."},
{"key": "data.voice.nordic.perfect.0", "text": "Skål !", "src": "Skål!"},
{"key": "data.voice.nordic.perfect.1", "text": "Très bien.", "src": "Very good."},
{"key": "data.voice.nordic.perfect.2", "text": "Oui. C'est bon.", "src": "Yes. Good."},
{"key": "data.voice.nordic.praise.0", "text": "C'est très bon. Je ne dis jamais ça.", "src": "This is very good. I don't say that."},
{"key": "data.voice.nordic.praise.1", "text": "Skål. Du travail bien fait.", "src": "Skål. Properly done."},
{"key": "data.voice.nordic.praise.2", "text": "Bon. Vraiment bon.", "src": "Good. Really good."},
{"key": "data.voice.nordic.sip.0", "text": "Bon. {advice}", "src": "Well. {advice}"},
{"key": "data.voice.nordic.sip.1", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.nordic.sip.2", "text": "Ça va, mais {advice_l}", "src": "Fine, but {advice_l}"},
{"key": "data.voice.nordic.wrong.0", "text": "Non. Pas la bonne.", "src": "No. Wrong one."},
{"key": "data.voice.nordic.wrong.1", "text": "Ce n'est pas ça.", "src": "This is not it."},
{"key": "data.voice.nordic.wrong.2", "text": "Hm. Pas le mien.", "src": "Hm. Not mine."},
{"key": "data.voice.southern.another.0", "text": "Ressers-moi !", "src": "Pour me another!"},
{"key": "data.voice.southern.another.1", "text": "Encore une, sugar !", "src": "One more, sugar!"},
{"key": "data.voice.southern.another.2", "text": "Continue comme ça, darlin' !", "src": "Keep 'em comin'!"},
{"key": "data.voice.southern.close.0", "text": "C'est bien comme ça.", "src": "That's alright."},
{"key": "data.voice.southern.close.1", "text": "Ça me va.", "src": "Fair enough."},
{"key": "data.voice.southern.close.2", "text": "Bah, ça fera l'affaire.", "src": "Well, it'll do."},
{"key": "data.voice.southern.kicked.0", "text": "Eh bien, c'est d'un impoli.", "src": "Well, that's just rude."},
{"key": "data.voice.southern.kicked.1", "text": "Très bien. Bonne soirée à toi.", "src": "Alright then. Have a good one."},
{"key": "data.voice.southern.kicked.2", "text": "Attends voir… bon, d'accord.", "src": "Now hold on… fine."},
{"key": "data.voice.southern.leaving.0", "text": "J'ai pas toute la nuit, moi.", "src": "Well, I ain't got all night."},
{"key": "data.voice.southern.leaving.1", "text": "M'est avis que j'irai boire ailleurs.", "src": "Reckon I'll drink elsewhere."},
{"key": "data.voice.southern.leaving.2", "text": "Vous prenez tout votre temps, y'all, hein.", "src": "Y'all take your sweet time, don't you."},
{"key": "data.voice.southern.order.0", "text": "Eh bien, {drink}, ça m'irait.", "src": "Well now, a {drink} would suit me."},
{"key": "data.voice.southern.order.1", "text": "{drink}, darlin', si tu veux bien.", "src": "{drink}, darlin', if you please."},
{"key": "data.voice.southern.order.2", "text": "M'est avis qu'il me faut : {drink}.", "src": "Reckon I'll have a {drink}."},
{"key": "data.voice.southern.order.3", "text": "{drink}, sugar.", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "Ça, c'est beau !", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "Lord, que c'est bon !", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "Hot dang !", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "Ben ça alors. Ça, c'est un vrai verre.", "src": "Well, I'll be. That's a proper drink."},
{"key": "data.voice.southern.praise.1", "text": "Darlin', tu as un don.", "src": "Darlin', you got a gift."},
{"key": "data.voice.southern.praise.2", "text": "M'est avis que j'ai trouvé mon nouveau coin.", "src": "Reckon I found my new spot."},
{"key": "data.voice.southern.sip.0", "text": "Dis donc, {advice_l}", "src": "Now, {advice_l}"},
{"key": "data.voice.southern.sip.1", "text": "Sugar, {advice_l}", "src": "Sugar, {advice_l}"},
