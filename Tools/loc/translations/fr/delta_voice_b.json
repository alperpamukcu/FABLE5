{"strings": [
{"key": "data.voice.arabic.another.0", "text": "Kaman wahad !", "src": "Kaman wahad!"},
{"key": "data.voice.arabic.another.1", "text": "Encore une, yalla !", "src": "One more, yalla!"},
{"key": "data.voice.arabic.another.2", "text": "La même, habibi !", "src": "Again, habibi!"},
{"key": "data.voice.arabic.close.0", "text": "Maashi.", "src": "Maashi."},
{"key": "data.voice.arabic.close.1", "text": "Ça va, c'est bien.", "src": "It is okay."},
{"key": "data.voice.arabic.close.2", "text": "Tamam, shukran.", "src": "Tamam, shukran."},
{"key": "data.voice.arabic.kicked.0", "text": "Shu ? Sérieusement ?", "src": "Shu? Seriously?"},
{"key": "data.voice.arabic.kicked.1", "text": "Khalas. D'accord.", "src": "Khalas. Fine."},
{"key": "data.voice.arabic.kicked.2", "text": "Yalla. Je m'en vais.", "src": "Yalla. I go."},
{"key": "data.voice.arabic.leaving.0", "text": "Khalas. J'y vais.", "src": "Khalas. I am going."},
{"key": "data.voice.arabic.leaving.1", "text": "Yalla, assez attendu.", "src": "Yalla, enough waiting."},
{"key": "data.voice.arabic.leaving.2", "text": "Maa salama.", "src": "Maa salama."},
{"key": "data.voice.arabic.order.0", "text": "{drink}, s'il te plaît.", "src": "A {drink}, please."},
{"key": "data.voice.arabic.order.1", "text": "{drink}, shukran.", "src": "One {drink}, shukran."},
{"key": "data.voice.arabic.order.2", "text": "Habibi, pour moi : {drink}.", "src": "Habibi, a {drink}."},
{"key": "data.voice.arabic.order.3", "text": "Je prends : {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.arabic.perfect.0", "text": "Ya salam !", "src": "Ya salam!"},
{"key": "data.voice.arabic.perfect.1", "text": "Helu kteer !", "src": "Helu kteer!"},
{"key": "data.voice.arabic.perfect.2", "text": "Parfait, habibi !", "src": "Perfect, habibi!"},
{"key": "data.voice.arabic.praise.0", "text": "Ya salam. C'est exactement ça, habibi.", "src": "Ya salam. This is the one, habibi."},
{"key": "data.voice.arabic.praise.1", "text": "Helu kteer. Shukran.", "src": "Helu kteer. Shukran."},
{"key": "data.voice.arabic.praise.2", "text": "Yalla, tu connais ton métier.", "src": "Yalla, you know your work."},
{"key": "data.voice.arabic.sip.0", "text": "Habibi, {advice_l}", "src": "Habibi, {advice_l}"},
{"key": "data.voice.arabic.sip.1", "text": "Shuf, {advice_l}", "src": "Shuf, {advice_l}"},
{"key": "data.voice.arabic.sip.2", "text": "Tamam, bas {advice_l}", "src": "Tamam, bas {advice_l}"},
{"key": "data.voice.arabic.wrong.0", "text": "La, la.", "src": "La, la."},
{"key": "data.voice.arabic.wrong.1", "text": "Ce n'est pas ça.", "src": "This is not it."},
{"key": "data.voice.arabic.wrong.2", "text": "Shu hada ?", "src": "Shu hada?"},
{"key": "data.voice.chinese.another.0", "text": "Zai lai yi bei !", "src": "Zai lai yi bei!"},
{"key": "data.voice.chinese.another.1", "text": "Encore une, ah !", "src": "One more, ah!"},
{"key": "data.voice.chinese.another.2", "text": "La même, s'il te plaît !", "src": "Again, please!"},
{"key": "data.voice.chinese.close.0", "text": "Hai keyi.", "src": "Hai keyi."},
{"key": "data.voice.chinese.close.1", "text": "Ça va, lah.", "src": "Okay lah."},
{"key": "data.voice.chinese.close.2", "text": "C'est bien comme ça.", "src": "It is fine."},
{"key": "data.voice.chinese.kicked.0", "text": "Shenme ? Vraiment ?", "src": "Shenme? Really?"},
{"key": "data.voice.chinese.kicked.1", "text": "Aiya. D'accord.", "src": "Aiya. Fine."},
{"key": "data.voice.chinese.kicked.2", "text": "Hao. Je pars.", "src": "Hao. I leave."},
{"key": "data.voice.chinese.leaving.0", "text": "Aiya. J'ai trop attendu.", "src": "Aiya. I waited too long."},
{"key": "data.voice.chinese.leaving.1", "text": "Suan le. J'y vais.", "src": "Suan le. I go."},
{"key": "data.voice.chinese.leaving.2", "text": "Zaijian, alors.", "src": "Zaijian, then."},
{"key": "data.voice.chinese.order.0", "text": "{drink}, s'il te plaît.", "src": "{drink}, please."},
{"key": "data.voice.chinese.order.1", "text": "{drink}, xiexie.", "src": "One {drink}, xiexie."},
{"key": "data.voice.chinese.order.2", "text": "Je vais prendre : {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.chinese.order.3", "text": "Pour moi : {drink}.", "src": "A {drink} for me."},
{"key": "data.voice.chinese.perfect.0", "text": "Hen hao !", "src": "Hen hao!"},
{"key": "data.voice.chinese.perfect.1", "text": "Parfait, ah !", "src": "Perfect, ah!"},
{"key": "data.voice.chinese.perfect.2", "text": "Zhen bang !", "src": "Zhen bang!"},
{"key": "data.voice.chinese.praise.0", "text": "Zhen bang. Je reviendrai pour ça.", "src": "Zhen bang. I will come back for this."},
{"key": "data.voice.chinese.praise.1", "text": "Hen hao. Tu sais ce que tu fais.", "src": "Hen hao. You know what you are doing."},
{"key": "data.voice.chinese.praise.2", "text": "Parfait, ah. Vraiment.", "src": "Perfect, ah. Really."},
{"key": "data.voice.chinese.sip.0", "text": "Ai, {advice_l}", "src": "Ai, {advice_l}"},
{"key": "data.voice.chinese.sip.1", "text": "Écoute, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.chinese.sip.2", "text": "Hao, mais {advice_l}", "src": "Hao, but {advice_l}"},
{"key": "data.voice.chinese.wrong.0", "text": "Bu dui.", "src": "Bu dui."},
{"key": "data.voice.chinese.wrong.1", "text": "Aiya, non.", "src": "Aiya, no."},
{"key": "data.voice.chinese.wrong.2", "text": "Pas celui-là.", "src": "Not this one."},
{"key": "data.voice.filipino.another.0", "text": "Isa pa !", "src": "Isa pa!"},
{"key": "data.voice.filipino.another.1", "text": "Encore une, ha !", "src": "One more, ha!"},
{"key": "data.voice.filipino.another.2", "text": "La même, s'il te plaît !", "src": "Again, please!"},
{"key": "data.voice.filipino.close.0", "text": "Okay lang.", "src": "Okay lang."},
{"key": "data.voice.filipino.close.1", "text": "Sige, merci.", "src": "Sige, thanks."},
{"key": "data.voice.filipino.close.2", "text": "Ay, ça va.", "src": "Ay, it's fine."},
{"key": "data.voice.filipino.kicked.0", "text": "Ha ? Vraiment ?", "src": "Ha? Really?"},
{"key": "data.voice.filipino.kicked.1", "text": "Ay. D'accord. Salut.", "src": "Ay. Okay. Bye."},
{"key": "data.voice.filipino.kicked.2", "text": "Grabe naman.", "src": "Grabe naman."},
{"key": "data.voice.filipino.leaving.0", "text": "Ay, grabe. Trop long. J'y vais.", "src": "Ay, grabe. Too long. I'm going."},
{"key": "data.voice.filipino.leaving.1", "text": "Sige na, salut.", "src": "Sige na, bye."},
{"key": "data.voice.filipino.leaving.2", "text": "Naku, personne ne vient.", "src": "Naku, no one is coming."},
{"key": "data.voice.filipino.order.0", "text": "Ay, {drink}, s'il te plaît.", "src": "Ay, one {drink}, please."},
{"key": "data.voice.filipino.order.1", "text": "{drink} pour moi. Salamat.", "src": "{drink} for me. Salamat."},
{"key": "data.voice.filipino.order.2", "text": "Tu me sers : {drink} ? Merci, ha.", "src": "Can I have a {drink}? Thanks, ha."},
{"key": "data.voice.filipino.order.3", "text": "{drink}, kuya.", "src": "A {drink}, kuya."},
{"key": "data.voice.filipino.perfect.0", "text": "Ay, sarap !", "src": "Ay, sarap!"},
{"key": "data.voice.filipino.perfect.1", "text": "Grabe, oui !", "src": "Grabe, yes!"},
{"key": "data.voice.filipino.perfect.2", "text": "Parfait, kuya !", "src": "Perfect, kuya!"},
{"key": "data.voice.filipino.praise.0", "text": "Grabe. C'est tellement bon. Salamat.", "src": "Grabe. That is so good. Salamat."},
{"key": "data.voice.filipino.praise.1", "text": "Ay, sarap. Ça efface ma journée de boulot.", "src": "Ay, sarap. You made my whole shift."},
{"key": "data.voice.filipino.praise.2", "text": "Sige, je reviendrai pour ça.", "src": "Sige, I'm coming back for this."},
{"key": "data.voice.filipino.sip.0", "text": "Ay, {advice_l}", "src": "Ay, {advice_l}"},
{"key": "data.voice.filipino.sip.1", "text": "Sige, mais {advice_l}", "src": "Sige, but {advice_l}"},
{"key": "data.voice.filipino.sip.2", "text": "Ha ? {advice}", "src": "Ha? {advice}"},
{"key": "data.voice.filipino.wrong.0", "text": "Ay, hindi. Pas ça.", "src": "Ay, hindi. Not this."},
{"key": "data.voice.filipino.wrong.1", "text": "Grabe, mauvaise boisson.", "src": "Grabe, wrong drink."},
{"key": "data.voice.filipino.wrong.2", "text": "Pas le mien, kuya.", "src": "Not mine, kuya."},
{"key": "data.voice.italian.another.0", "text": "Ancora, dai !", "src": "Ancora, dai!"},
{"key": "data.voice.italian.another.1", "text": "Une autre, grazie !", "src": "Another, grazie!"},
{"key": "data.voice.italian.another.2", "text": "Encore une, amore !", "src": "Once more, amore!"},
{"key": "data.voice.italian.close.0", "text": "Va bene.", "src": "Va bene."},
{"key": "data.voice.italian.close.1", "text": "D'accord, grazie.", "src": "Okay, grazie."},
{"key": "data.voice.italian.close.2", "text": "Pas mal, eh.", "src": "Not bad, eh."},
{"key": "data.voice.italian.kicked.0", "text": "Ma dai ! Vraiment ?", "src": "Ma dai! Really?"},
{"key": "data.voice.italian.kicked.1", "text": "Va bene. Ciao, ciao.", "src": "Va bene. Ciao, ciao."},
{"key": "data.voice.italian.kicked.2", "text": "Che maleducato.", "src": "Che maleducato."},
{"key": "data.voice.italian.leaving.0", "text": "Basta. Je m'en vais.", "src": "Basta. I go."},
{"key": "data.voice.italian.leaving.1", "text": "Mamma mia, cette attente !", "src": "Mamma mia, the waiting!"},
{"key": "data.voice.italian.leaving.2", "text": "Ciao. Dans une autre vie, peut-être.", "src": "Ciao. Maybe next life."},
{"key": "data.voice.italian.order.0", "text": "{drink}, per favore.", "src": "Un {drink}, per favore."},
{"key": "data.voice.italian.order.1", "text": "{drink}, amore.", "src": "A {drink}, amore."},
{"key": "data.voice.italian.order.2", "text": "{drink}, grazie.", "src": "{drink}, grazie."},
{"key": "data.voice.italian.order.3", "text": "Dai, pour moi : {drink}.", "src": "Dai, a {drink}."},
{"key": "data.voice.italian.perfect.0", "text": "Perfetto !", "src": "Perfetto!"},
{"key": "data.voice.italian.perfect.1", "text": "Bravo !", "src": "Bravo!"},
{"key": "data.voice.italian.perfect.2", "text": "Che buono !", "src": "Che buono!"},
{"key": "data.voice.italian.praise.0", "text": "Perfetto. Vraiment. Grazie mille.", "src": "Perfetto. Truly. Grazie mille."},
{"key": "data.voice.italian.praise.1", "text": "Bravo. Ma nonna en pleurerait.", "src": "Bravo. My nonna would cry."},
{"key": "data.voice.italian.praise.2", "text": "Che buono. Je ne bouge plus d'ici.", "src": "Che buono. I'm not leaving."},
{"key": "data.voice.italian.sip.0", "text": "Senti, {advice_l}", "src": "Senti, {advice_l}"},
{"key": "data.voice.italian.sip.1", "text": "Allora, {advice_l}", "src": "Allora, {advice_l}"},
{"key": "data.voice.italian.sip.2", "text": "Va bene, ma {advice_l}", "src": "Va bene, ma {advice_l}"},
{"key": "data.voice.italian.wrong.0", "text": "Mamma mia, non.", "src": "Mamma mia, no."},
{"key": "data.voice.italian.wrong.1", "text": "Ma che cos'è ?", "src": "Ma che cos'è?"},
{"key": "data.voice.italian.wrong.2", "text": "Non, non. Pas ça.", "src": "No, no. Not this."},
{"key": "data.voice.miami.another.0", "text": "Otra, dale !", "src": "¡Otra, dale!"},
{"key": "data.voice.miami.another.1", "text": "Encore une, oye !", "src": "One more, oye!"},
{"key": "data.voice.miami.another.2", "text": "La même, mi amor !", "src": "Again, mi amor!"},
{"key": "data.voice.miami.close.0", "text": "Está bien.", "src": "Está bien."},
{"key": "data.voice.miami.close.1", "text": "Pas mal, chico.", "src": "Not bad, chico."},
{"key": "data.voice.miami.close.2", "text": "Ok, ok.", "src": "Okay, okay."},
{"key": "data.voice.miami.kicked.0", "text": "En serio ? Bon, d'accord.", "src": "¿En serio? Okay, fine."},
{"key": "data.voice.miami.kicked.1", "text": "Tu te moques de moi, chico.", "src": "You're kidding me, chico."},
{"key": "data.voice.miami.kicked.2", "text": "Dale. Tant pis pour toi.", "src": "Dale. Your loss."},
{"key": "data.voice.miami.leaving.0", "text": "Oye ! Ça fait toute la soirée que j'attends.", "src": "¡Oye! I've been sitting here all night."},
{"key": "data.voice.miami.leaving.1", "text": "Bueno, c'est fini. Ciao.", "src": "Bueno, that's it. Ciao."},
{"key": "data.voice.miami.leaving.2", "text": "Non, non. Je n'attends plus.", "src": "No, no. I'm not waiting anymore."},
{"key": "data.voice.miami.order.0", "text": "Oye, pour moi : {drink}.", "src": "Oye, a {drink} for me."},
{"key": "data.voice.miami.order.1", "text": "Dale, {drink}.", "src": "Dale, one {drink}."},
{"key": "data.voice.miami.order.2", "text": "{drink}, papi, quand tu peux.", "src": "{drink}, papi, when you can."},
{"key": "data.voice.miami.order.3", "text": "Mi amor, {drink}.", "src": "Mi amor, a {drink}."},
{"key": "data.voice.miami.perfect.0", "text": "Qué rico !", "src": "¡Qué rico!"},
{"key": "data.voice.miami.perfect.1", "text": "Eso es !", "src": "¡Eso es!"},
{"key": "data.voice.miami.perfect.2", "text": "Dale, perfecto !", "src": "¡Dale, perfecto!"},
{"key": "data.voice.miami.praise.0", "text": "Ay, c'est exactement ça. Gracias.", "src": "Ay, this is the one. Gracias."},
{"key": "data.voice.miami.praise.1", "text": "Mon abuela approuverait, et elle n'approuve rien.", "src": "My abuela would approve, and she approves of nothing."},
{"key": "data.voice.miami.praise.2", "text": "Dale. Tu sais ce que tu fais.", "src": "Dale. You know what you're doing."},
{"key": "data.voice.miami.sip.0", "text": "Mira, {advice_l}", "src": "Mira, {advice_l}"},
{"key": "data.voice.miami.sip.1", "text": "Oye, {advice_l}", "src": "Oye, {advice_l}"},
{"key": "data.voice.miami.sip.2", "text": "Está bien, pero… {advice_l}", "src": "Está bien, pero… {advice_l}"},
{"key": "data.voice.miami.wrong.0", "text": "Qué es esto ?", "src": "¿Qué es esto?"},
{"key": "data.voice.miami.wrong.1", "text": "Non, non, non.", "src": "No, no, no."},
{"key": "data.voice.miami.wrong.2", "text": "Pas le mien, oye.", "src": "Not mine, oye."},
{"key": "data.voice.nyc.another.0", "text": "Remets-moi ça !", "src": "Hit me again!"},
{"key": "data.voice.nyc.another.1", "text": "Allez, envoie la suite !", "src": "Keep 'em comin'!"},
{"key": "data.voice.nyc.another.2", "text": "Une autre, chief !", "src": "Another, chief!"},
{"key": "data.voice.nyc.close.0", "text": "Bof. Ça passe.", "src": "Eh. It's fine."},
{"key": "data.voice.nyc.close.1", "text": "Ouais, ok.", "src": "Yeah, alright."},
{"key": "data.voice.nyc.close.2", "text": "Ça fera l'affaire.", "src": "It'll do."},
{"key": "data.voice.nyc.kicked.0", "text": "Sérieux, là ?", "src": "You serious right now?"},
{"key": "data.voice.nyc.kicked.1", "text": "Très bien. Bar nul, de toute façon.", "src": "Fine. Terrible bar anyway."},
{"key": "data.voice.nyc.kicked.2", "text": "Wow. Ok. Wow.", "src": "Wow. Okay. Wow."},
{"key": "data.voice.nyc.leaving.0", "text": "J'ai d'autres trucs à faire. Laisse tomber.", "src": "I got places to be. Forget it."},
{"key": "data.voice.nyc.leaving.1", "text": "Incroyable. Je me tire.", "src": "Unbelievable. I'm outta here."},
{"key": "data.voice.nyc.leaving.2", "text": "Yo, c'est un bar ou une salle d'attente ?", "src": "Yo, is this a bar or a waiting room?"},
{"key": "data.voice.nyc.order.0", "text": "Yo, file-moi : {drink}.", "src": "Yo, lemme get a {drink}."},
{"key": "data.voice.nyc.order.1", "text": "{drink}. Et ça presse.", "src": "{drink}. And I'm in a hurry."},
{"key": "data.voice.nyc.order.2", "text": "{drink}, chief. Vite fait.", "src": "Gimme a {drink}, chief."},
{"key": "data.voice.nyc.order.3", "text": "{drink}. Fais pas de chichis.", "src": "{drink}. Don't make it weird."},
{"key": "data.voice.nyc.perfect.0", "text": "Là, on parle !", "src": "Now we're talkin'!"},
{"key": "data.voice.nyc.perfect.1", "text": "Ça, c'est du bon !", "src": "That's the stuff!"},
{"key": "data.voice.nyc.perfect.2", "text": "Oh, voilà !", "src": "Oh, that's it!"},
{"key": "data.voice.nyc.praise.0", "text": "Ok, là tu m'impressionnes. Ça n'arrive jamais.", "src": "Okay, I'm impressed. That never happens."},
{"key": "data.voice.nyc.praise.1", "text": "Laisse-moi te dire, ça, c'est un verre.", "src": "Lemme tell ya, that's a drink."},
{"key": "data.voice.nyc.praise.2", "text": "Tu devrais le vendre plus cher. Non, fais pas ça.", "src": "You should charge more for this. Don't."},
{"key": "data.voice.nyc.sip.0", "text": "Écoute, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.nyc.sip.1", "text": "Je dis ça, je dis rien : {advice_l}", "src": "I'm just sayin', {advice_l}"},
{"key": "data.voice.nyc.sip.2", "text": "Pas mal, mais {advice_l}", "src": "Not bad, but {advice_l}"},
{"key": "data.voice.nyc.wrong.0", "text": "C'est quoi, ça ?", "src": "What is this?"},
{"key": "data.voice.nyc.wrong.1", "text": "Fuhgeddaboudit.", "src": "Fuhgeddaboudit."},
{"key": "data.voice.nyc.wrong.2", "text": "Pas le bon, pal.", "src": "Wrong one, pal."},
{"key": "data.voice.surfer.another.0", "text": "Encore une, dude !", "src": "One more, dude!"},
{"key": "data.voice.surfer.another.1", "text": "Encore, encore !", "src": "Again, again!"},
{"key": "data.voice.surfer.another.2", "text": "Que ça roule !", "src": "Keep 'em rolling!"},
{"key": "data.voice.surfer.close.0", "text": "Cool, cool.", "src": "Cool, cool."},
{"key": "data.voice.surfer.close.1", "text": "Ouais, ça marche.", "src": "Yeah, that works."},
{"key": "data.voice.surfer.close.2", "text": "Sympa, ça ira.", "src": "Nice enough."},
{"key": "data.voice.surfer.kicked.0", "text": "Dur, dude.", "src": "Harsh, dude."},
{"key": "data.voice.surfer.kicked.1", "text": "Ok… drôle de vibe.", "src": "Okay… that's a vibe."},
{"key": "data.voice.surfer.kicked.2", "text": "Wow. Pas chill.", "src": "Wow. Not chill."},
{"key": "data.voice.surfer.leaving.0", "text": "Dude, ça fait une éternité que je suis là.", "src": "Dude, I've been here forever."},
{"key": "data.voice.surfer.leaving.1", "text": "Pas cool. Je me barre.", "src": "Not cool. I'm out."},
{"key": "data.voice.surfer.leaving.2", "text": "Ouais, non. Je file.", "src": "Yeah, no. Bailing."},
{"key": "data.voice.surfer.order.0", "text": "Dude, {drink}.", "src": "Dude, a {drink}."},
{"key": "data.voice.surfer.order.1", "text": "Je peux avoir, genre : {drink} ?", "src": "Can I get, like, a {drink}?"},
{"key": "data.voice.surfer.order.2", "text": "{drink}, s'il te plaît. Chill, rien ne presse.", "src": "{drink}, please. Chill, no rush."},
{"key": "data.voice.surfer.order.3", "text": "Ouais, {drink}, ça serait épique.", "src": "Yeah, a {drink} sounds epic."},
{"key": "data.voice.surfer.perfect.0", "text": "Dude. Oui.", "src": "Dude. Yes."},
{"key": "data.voice.surfer.perfect.1", "text": "Stoked !", "src": "Stoked!"},
{"key": "data.voice.surfer.perfect.2", "text": "Trop bon !", "src": "So good!"},
{"key": "data.voice.surfer.praise.0", "text": "Ok, c'est carrément parfait. Respect.", "src": "Okay, that's actually perfect. Respect."},
{"key": "data.voice.surfer.praise.1", "text": "Dude. Sans rire. Génial.", "src": "Dude. I'm not even kidding. Amazing."},
