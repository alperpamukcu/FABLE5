{"strings": [
{"key": "data.voice.african.another.0", "text": "¡Trae otra!", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "¡Una más, abeg!", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "¡Otra vez, mi amigo!", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "Está bien.", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "No wahala.", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "Bueno, gracias.", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "¡Ah, ah! ¿En serio?", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala. Me voy.", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "Mi amigo, esto está feo.", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah, ah. Ya esperé bastante.", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala. Ya me voy.", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "Déjame irme, mi amigo.", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "{drink}, por favor.", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "Mi amigo, para mí: {drink}.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Yo quiero: {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "{drink}, abeg.", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "¡Ah, qué rico!", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "¡Correcto!", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "¡Este sí está bueno!", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, este está correcto. Gracias.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "Nada de wahala. Muy rico.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "Mi amigo, tú sí sabes.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "Mi amigo, {advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg, {advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "Está bien, pero {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah, ah, no.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "Esto no es.", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "Mi amigo, no.", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "¡Lo mismo, mate!", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "¡Una más, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "¡Vamos, otra!", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "Nada mal.", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Ta, con eso basta.", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "Bueno, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Encantador. Absolutamente encantador.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "Right. Bueno. Cheers por nada.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "Me estás tomando el pelo.", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Right. Ya esperé suficiente.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "Al diablo con esto. Me voy.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Qué desastre, esto. Bye.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "{drink}, mate, cuando tengas un momento.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, por favor. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "Bueno, va: {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "Para mí, {drink}, ta.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "¡Lovely!", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "¡Cheers, mate!", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "¡Buenísimo, de verdad!", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Blimey. Esto está lovely de verdad.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Eso lo hiciste como se debe.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Bloody good, esto.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "Un detallito: {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Mira, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Esto no cuadra.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Ehm, no es mío.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "No es lo que pedí.", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "¡Una más, yaar!", "src": "One more, yaar!"},
{"key": "data.voice.desi.another.1", "text": "¡Aur ek!", "src": "Aur ek!"},
{"key": "data.voice.desi.another.2", "text": "¡Otra, por favor!", "src": "Again, please!"},
{"key": "data.voice.desi.close.0", "text": "Theek hai.", "src": "Theek hai."},
{"key": "data.voice.desi.close.1", "text": "Está bien, ¿na?", "src": "It is okay, na."},
{"key": "data.voice.desi.close.2", "text": "Chalega, sirve.", "src": "Chalega."},
{"key": "data.voice.desi.kicked.0", "text": "¿Kya? ¿En serio?", "src": "Kya? Seriously?"},
{"key": "data.voice.desi.kicked.1", "text": "Arre. Bueno, está bien.", "src": "Arre. Okay, fine."},
{"key": "data.voice.desi.kicked.2", "text": "Chalo. Me voy.", "src": "Chalo. I go."},
{"key": "data.voice.desi.leaving.0", "text": "Arre yaar. Mucho tiempo.", "src": "Arre yaar. Too long."},
{"key": "data.voice.desi.leaving.1", "text": "Chalo, ya me voy.", "src": "Chalo, I am going."},
{"key": "data.voice.desi.leaving.2", "text": "Bas. Suficiente.", "src": "Bas. Enough."},
{"key": "data.voice.desi.order.0", "text": "{drink}, por favor.", "src": "One {drink}, please."},
{"key": "data.voice.desi.order.1", "text": "{drink}, yaar.", "src": "A {drink}, yaar."},
{"key": "data.voice.desi.order.2", "text": "Para mí: {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.desi.order.3", "text": "{drink}, ¿na?", "src": "{drink}, na?"},
{"key": "data.voice.desi.perfect.0", "text": "¡Wah, perfecto!", "src": "Wah, perfect!"},
{"key": "data.voice.desi.perfect.1", "text": "¡Ekdum de primera!", "src": "Ekdum first class!"},
{"key": "data.voice.desi.perfect.2", "text": "¡Bahut badhiya!", "src": "Bahut badhiya!"},
{"key": "data.voice.desi.praise.0", "text": "Wah. Ekdum perfecto, yaar.", "src": "Wah. Ekdum perfect, yaar."},
{"key": "data.voice.desi.praise.1", "text": "Bahut badhiya. En serio.", "src": "Bahut badhiya. Really."},
{"key": "data.voice.desi.praise.2", "text": "De primera. Voy a volver.", "src": "First class. I am coming back."},
{"key": "data.voice.desi.sip.0", "text": "Arre, {advice_l}", "src": "Arre, {advice_l}"},
{"key": "data.voice.desi.sip.1", "text": "Yaar, {advice_l}", "src": "Yaar, {advice_l}"},
{"key": "data.voice.desi.sip.2", "text": "Theek hai, pero {advice_l}", "src": "Theek hai, but {advice_l}"},
{"key": "data.voice.desi.wrong.0", "text": "Arre, no.", "src": "Arre, no."},
{"key": "data.voice.desi.wrong.1", "text": "Esto no es mío.", "src": "This is not mine."},
{"key": "data.voice.desi.wrong.2", "text": "Nahi, este no es.", "src": "Nahi, wrong one."},
{"key": "data.voice.german.another.0", "text": "¡Noch eins!", "src": "Noch eins!"},
{"key": "data.voice.german.another.1", "text": "¡Otro, bitte!", "src": "Another, bitte!"},
{"key": "data.voice.german.another.2", "text": "¡Otra vez, por favor!", "src": "Again, please!"},
{"key": "data.voice.german.close.0", "text": "Ja, está bien.", "src": "Ja, okay."},
{"key": "data.voice.german.close.1", "text": "Aceptable.", "src": "Acceptable."},
{"key": "data.voice.german.close.2", "text": "Está correcto.", "src": "It is fine."},
{"key": "data.voice.german.kicked.0", "text": "Esto es absurdo.", "src": "This is absurd."},
{"key": "data.voice.german.kicked.1", "text": "Bien. No voy a volver.", "src": "Fine. I will not return."},
{"key": "data.voice.german.kicked.2", "text": "Ja, ja. Ya me voy.", "src": "Ja, ja. I am going."},
{"key": "data.voice.german.leaving.0", "text": "Esto no es aceptable. Me retiro.", "src": "This is not acceptable. I am leaving."},
{"key": "data.voice.german.leaving.1", "text": "Nein. Ya esperé suficiente.", "src": "Nein. I have waited enough."},
{"key": "data.voice.german.leaving.2", "text": "Unglaublich. Adiós.", "src": "Unglaublich. Goodbye."},
{"key": "data.voice.german.order.0", "text": "{drink}, por favor. Bien preparado.", "src": "A {drink}, please. Correctly made."},
{"key": "data.voice.german.order.1", "text": "{drink}. Gracias.", "src": "{drink}. Thank you."},
{"key": "data.voice.german.order.2", "text": "{drink}, bitte.", "src": "One {drink}, bitte."},
{"key": "data.voice.german.order.3", "text": "Quisiera pedir: {drink}.", "src": "I would like a {drink}."},
{"key": "data.voice.german.perfect.0", "text": "¡Genau!", "src": "Genau!"},
{"key": "data.voice.german.perfect.1", "text": "¡Sehr gut!", "src": "Sehr gut!"},
{"key": "data.voice.german.perfect.2", "text": "¡Wunderbar!", "src": "Wunderbar!"},
{"key": "data.voice.german.praise.0", "text": "Ja. Esto es exactamente así.", "src": "Ja. This is exactly right."},
{"key": "data.voice.german.praise.1", "text": "Preciso. Respeto la precisión.", "src": "Precise. I respect precision."},
{"key": "data.voice.german.praise.2", "text": "Sehr gut. Nada que corregir.", "src": "Sehr gut. No notes."},
{"key": "data.voice.german.sip.0", "text": "Genau, pero {advice_l}", "src": "Genau, but {advice_l}"},
{"key": "data.voice.german.sip.1", "text": "Una observación: {advice_l}", "src": "One remark: {advice_l}"},
{"key": "data.voice.german.sip.2", "text": "Ja, {advice_l}", "src": "Ja, {advice_l}"},
{"key": "data.voice.german.wrong.0", "text": "Nein. Esto no.", "src": "Nein. Not this."},
{"key": "data.voice.german.wrong.1", "text": "Esto es incorrecto.", "src": "This is incorrect."},
{"key": "data.voice.german.wrong.2", "text": "Trago equivocado.", "src": "Wrong drink."},
{"key": "data.voice.korean.another.0", "text": "¡Han jan deo!", "src": "Han jan deo!"},
{"key": "data.voice.korean.another.1", "text": "¡Una más!", "src": "One more!"},
{"key": "data.voice.korean.another.2", "text": "¡Otra, juseyo!", "src": "Again, juseyo!"},
{"key": "data.voice.korean.close.0", "text": "Gwenchana.", "src": "Gwenchana."},
{"key": "data.voice.korean.close.1", "text": "Está bien.", "src": "It is okay."},
{"key": "data.voice.korean.close.2", "text": "Nappeuji anha. Nada mal.", "src": "Nappeuji anha."},
{"key": "data.voice.korean.kicked.0", "text": "¿Jinjja? Guau.", "src": "Jinjja? Wow."},
{"key": "data.voice.korean.kicked.1", "text": "Aish. Está bien.", "src": "Aish. Fine."},
{"key": "data.voice.korean.kicked.2", "text": "Annyeong, entonces.", "src": "Annyeong, then."},
{"key": "data.voice.korean.leaving.0", "text": "Aish. Demasiado tiempo.", "src": "Aish. Too long."},
{"key": "data.voice.korean.leaving.1", "text": "Ya me voy. Annyeong.", "src": "I am going. Annyeong."},
{"key": "data.voice.korean.leaving.2", "text": "Mot chamgesseo. Ya no aguanto.", "src": "Mot chamgesseo."},
{"key": "data.voice.korean.order.0", "text": "{drink}, juseyo.", "src": "{drink}, juseyo."},
{"key": "data.voice.korean.order.1", "text": "{drink}, por favor.", "src": "One {drink}, please."},
{"key": "data.voice.korean.order.2", "text": "Para mí: {drink}.", "src": "A {drink} for me."},
{"key": "data.voice.korean.order.3", "text": "Quiero pedir: {drink}.", "src": "I want a {drink}."},
{"key": "data.voice.korean.perfect.0", "text": "¡Daebak!", "src": "Daebak!"},
{"key": "data.voice.korean.perfect.1", "text": "¡Jinjja rico!", "src": "Jinjja good!"},
{"key": "data.voice.korean.perfect.2", "text": "¡Choego!", "src": "Choego!"},
{"key": "data.voice.korean.praise.0", "text": "Daebak. Jinjja, está perfecto.", "src": "Daebak. Jinjja, this is perfect."},
{"key": "data.voice.korean.praise.1", "text": "Choego. Lo digo en serio.", "src": "Choego. I mean it."},
{"key": "data.voice.korean.praise.2", "text": "Guau. Sabes lo que haces.", "src": "Wow. You are good at this."},
{"key": "data.voice.korean.sip.0", "text": "Jamkkanman, {advice_l}", "src": "Jamkkanman, {advice_l}"},
{"key": "data.voice.korean.sip.1", "text": "Mmm, {advice_l}", "src": "Um, {advice_l}"},
{"key": "data.voice.korean.sip.2", "text": "Gwenchana, pero {advice_l}", "src": "Gwenchana, but {advice_l}"},
{"key": "data.voice.korean.wrong.0", "text": "Aniyo, no.", "src": "Aniyo, no."},
{"key": "data.voice.korean.wrong.1", "text": "Esto está mal.", "src": "This is wrong."},
{"key": "data.voice.korean.wrong.2", "text": "¿Eh? No es mío.", "src": "Eh? Not mine."},
{"key": "data.voice.nordic.another.0", "text": "Otra. ¡Skål!", "src": "Another. Skål!"},
{"key": "data.voice.nordic.another.1", "text": "Una más.", "src": "One more."},
{"key": "data.voice.nordic.another.2", "text": "Otra, por favor.", "src": "Again, please."},
{"key": "data.voice.nordic.close.0", "text": "Bien.", "src": "Fine."},
{"key": "data.voice.nordic.close.1", "text": "Está bien.", "src": "It's okay."},
{"key": "data.voice.nordic.close.2", "text": "Suficiente.", "src": "Good enough."},
{"key": "data.voice.nordic.kicked.0", "text": "Okey. Raro, pero okey.", "src": "Okay. Strange, but okay."},
{"key": "data.voice.nordic.kicked.1", "text": "De acuerdo.", "src": "Fine."},
{"key": "data.voice.nordic.kicked.2", "text": "Hm. Adiós, entonces.", "src": "Hm. Goodbye then."},
{"key": "data.voice.nordic.leaving.0", "text": "Me voy. No pasa nada.", "src": "I'll go. It's fine."},
{"key": "data.voice.nordic.leaving.1", "text": "Demasiado tiempo. Adiós.", "src": "Too long. Goodbye."},
{"key": "data.voice.nordic.leaving.2", "text": "No. Me retiro.", "src": "No. I'm leaving."},
{"key": "data.voice.nordic.order.0", "text": "{drink}. Gracias.", "src": "A {drink}. Thanks."},
{"key": "data.voice.nordic.order.1", "text": "{drink}, por favor.", "src": "{drink}, please."},
{"key": "data.voice.nordic.order.2", "text": "{drink}. Sin apuro.", "src": "One {drink}. No rush."},
{"key": "data.voice.nordic.order.3", "text": "Para mí: {drink}. Takk.", "src": "I'll have the {drink}."},
{"key": "data.voice.nordic.perfect.0", "text": "¡Skål!", "src": "Skål!"},
{"key": "data.voice.nordic.perfect.1", "text": "Muy bueno.", "src": "Very good."},
{"key": "data.voice.nordic.perfect.2", "text": "Sí. Bueno.", "src": "Yes. Good."},
{"key": "data.voice.nordic.praise.0", "text": "Esto está muy bueno. Y yo no digo eso.", "src": "This is very good. I don't say that."},
{"key": "data.voice.nordic.praise.1", "text": "Skål. Bien hecho.", "src": "Skål. Properly done."},
{"key": "data.voice.nordic.praise.2", "text": "Bueno. Muy bueno, de verdad.", "src": "Good. Really good."},
{"key": "data.voice.nordic.sip.0", "text": "Bueno. {advice}", "src": "Well. {advice}"},
{"key": "data.voice.nordic.sip.1", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.nordic.sip.2", "text": "Bien, pero {advice_l}", "src": "Fine, but {advice_l}"},
{"key": "data.voice.nordic.wrong.0", "text": "No. Este no es.", "src": "No. Wrong one."},
{"key": "data.voice.nordic.wrong.1", "text": "Esto no es.", "src": "This is not it."},
{"key": "data.voice.nordic.wrong.2", "text": "Hm. No es mío.", "src": "Hm. Not mine."},
{"key": "data.voice.southern.another.0", "text": "¡Sírveme otra!", "src": "Pour me another!"},
{"key": "data.voice.southern.another.1", "text": "¡Una más, sugar!", "src": "One more, sugar!"},
{"key": "data.voice.southern.another.2", "text": "¡Que sigan llegando!", "src": "Keep 'em comin'!"},
{"key": "data.voice.southern.close.0", "text": "Está bien.", "src": "That's alright."},
{"key": "data.voice.southern.close.1", "text": "Me parece justo.", "src": "Fair enough."},
{"key": "data.voice.southern.close.2", "text": "Bueno, sirve.", "src": "Well, it'll do."},
{"key": "data.voice.southern.kicked.0", "text": "Well, eso es pura grosería.", "src": "Well, that's just rude."},
{"key": "data.voice.southern.kicked.1", "text": "Muy bien. Que tengas buena noche.", "src": "Alright then. Have a good one."},
{"key": "data.voice.southern.kicked.2", "text": "Oye, espera… bueno, está bien.", "src": "Now hold on… fine."},
{"key": "data.voice.southern.leaving.0", "text": "Well, no tengo toda la noche.", "src": "Well, I ain't got all night."},
{"key": "data.voice.southern.leaving.1", "text": "Creo que voy a tomar en otro lado.", "src": "Reckon I'll drink elsewhere."},
{"key": "data.voice.southern.leaving.2", "text": "Y'all se toman su tiempo, ¿no?", "src": "Y'all take your sweet time, don't you."},
{"key": "data.voice.southern.order.0", "text": "Well now, me caería bien: {drink}.", "src": "Well now, a {drink} would suit me."},
{"key": "data.voice.southern.order.1", "text": "{drink}, darlin', si eres tan amable.", "src": "{drink}, darlin', if you please."},
{"key": "data.voice.southern.order.2", "text": "Creo que voy a pedir: {drink}.", "src": "Reckon I'll have a {drink}."},
{"key": "data.voice.southern.order.3", "text": "{drink}, sugar.", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "¡Qué maravilla!", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "¡Lord, qué bueno!", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "¡Hot dang!", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "Well, I'll be. Esto sí es un trago.", "src": "Well, I'll be. That's a proper drink."},
{"key": "data.voice.southern.praise.1", "text": "Darlin', tienes un don.", "src": "Darlin', you got a gift."},
{"key": "data.voice.southern.praise.2", "text": "Creo que encontré mi nuevo lugar.", "src": "Reckon I found my new spot."},
{"key": "data.voice.southern.sip.0", "text": "A ver, {advice_l}", "src": "Now, {advice_l}"},
{"key": "data.voice.southern.sip.1", "text": "Sugar, {advice_l}", "src": "Sugar, {advice_l}"},
{"key": "data.voice.southern.sip.2", "text": "Te digo una cosa: {advice_l}", "src": "Tell you what, {advice_l}"},
{"key": "data.voice.southern.wrong.0", "text": "No es mío, hon.", "src": "Ain't mine, hon."},
{"key": "data.voice.southern.wrong.1", "text": "¿Y esto qué es?", "src": "Now what is this?"},
{"key": "data.voice.southern.wrong.2", "text": "Bless your heart, no es mío.", "src": "Bless your heart."}
]}
