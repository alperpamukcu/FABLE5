{"strings": [
{"key": "data.voice.african.another.0", "text": "Portane un altro!", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "Un altro, abeg!", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "Ancora, amico mio!", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "Va bene così.", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "No wahala.", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "Okay, grazie.", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "Ah ah! Sul serio?", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala. Me ne vado.", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "Amico mio, questo non è bello.", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah ah. Ho aspettato abbastanza.", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala. Io vado.", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "Lasciami andare, amico mio.", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "{drink}, per favore.", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "{drink}, amico mio.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Per me {drink}, grazie.", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "{drink}, abeg.", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "Ah, che buono!", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "Giustissimo!", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "Questo è bello!", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, questo è giusto. Grazie.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "No wahala proprio. Buonissimo.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "Amico mio, tu sai il fatto tuo.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "Amico mio, {advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg, {advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "Va bene, ma {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah, no.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "Non è questo.", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "Amico mio, no.", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "Lo stesso, mate!", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "Un altro, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "Dai, un altro!", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "Niente male.", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Ta, può andare.", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "Va bene, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Che gentilezza. Davvero squisita.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "Bene. Allora. Cheers per niente.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "Stai scherzando, vero?", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Bene. Ho aspettato abbastanza.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "Ma basta. Me ne vado.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Un po' scadente, qui. Bye.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "{drink}, mate, quando hai un attimo.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, per favore. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "Dai, allora: {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "Per me {drink}, ta.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "Lovely!", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "Cheers, mate!", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "Proprio buono!", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Blimey. È davvero lovely.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Fatto come si deve.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Bloody good, davvero.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "Una cosina: {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Senti, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Un po' storto, questo.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Ehm, non è il mio.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "Non è quello che ho chiesto.", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "Un altro, yaar!", "src": "One more, yaar!"},
{"key": "data.voice.desi.another.1", "text": "Aur ek!", "src": "Aur ek!"},
{"key": "data.voice.desi.another.2", "text": "Ancora, per favore!", "src": "Again, please!"},
{"key": "data.voice.desi.close.0", "text": "Theek hai.", "src": "Theek hai."},
{"key": "data.voice.desi.close.1", "text": "Va bene, na.", "src": "It is okay, na."},
{"key": "data.voice.desi.close.2", "text": "Chalega.", "src": "Chalega."},
{"key": "data.voice.desi.kicked.0", "text": "Kya? Sul serio?", "src": "Kya? Seriously?"},
{"key": "data.voice.desi.kicked.1", "text": "Arre. Okay, va bene.", "src": "Arre. Okay, fine."},
{"key": "data.voice.desi.kicked.2", "text": "Chalo. Io vado.", "src": "Chalo. I go."},
{"key": "data.voice.desi.leaving.0", "text": "Arre yaar. Troppo tempo.", "src": "Arre yaar. Too long."},
{"key": "data.voice.desi.leaving.1", "text": "Chalo, me ne vado.", "src": "Chalo, I am going."},
{"key": "data.voice.desi.leaving.2", "text": "Bas. Basta così.", "src": "Bas. Enough."},
{"key": "data.voice.desi.order.0", "text": "{drink}, per favore.", "src": "One {drink}, please."},
{"key": "data.voice.desi.order.1", "text": "Per me {drink}, yaar.", "src": "A {drink}, yaar."},
{"key": "data.voice.desi.order.2", "text": "Io prendo: {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.desi.order.3", "text": "{drink}, na?", "src": "{drink}, na?"},
{"key": "data.voice.desi.perfect.0", "text": "Wah, perfetto!", "src": "Wah, perfect!"},
{"key": "data.voice.desi.perfect.1", "text": "Ekdum first class!", "src": "Ekdum first class!"},
{"key": "data.voice.desi.perfect.2", "text": "Bahut badhiya!", "src": "Bahut badhiya!"},
{"key": "data.voice.desi.praise.0", "text": "Wah. Ekdum perfetto, yaar.", "src": "Wah. Ekdum perfect, yaar."},
{"key": "data.voice.desi.praise.1", "text": "Bahut badhiya. Davvero.", "src": "Bahut badhiya. Really."},
{"key": "data.voice.desi.praise.2", "text": "First class. Io torno.", "src": "First class. I am coming back."},
{"key": "data.voice.desi.sip.0", "text": "Arre, {advice_l}", "src": "Arre, {advice_l}"},
{"key": "data.voice.desi.sip.1", "text": "Yaar, {advice_l}", "src": "Yaar, {advice_l}"},
{"key": "data.voice.desi.sip.2", "text": "Theek hai, ma {advice_l}", "src": "Theek hai, but {advice_l}"},
{"key": "data.voice.desi.wrong.0", "text": "Arre, no.", "src": "Arre, no."},
{"key": "data.voice.desi.wrong.1", "text": "Questo non è il mio.", "src": "This is not mine."},
{"key": "data.voice.desi.wrong.2", "text": "Nahi, è quello sbagliato.", "src": "Nahi, wrong one."},
{"key": "data.voice.german.another.0", "text": "Noch eins!", "src": "Noch eins!"},
{"key": "data.voice.german.another.1", "text": "Un altro, bitte!", "src": "Another, bitte!"},
{"key": "data.voice.german.another.2", "text": "Ancora, per favore!", "src": "Again, please!"},
{"key": "data.voice.german.close.0", "text": "Ja, okay.", "src": "Ja, okay."},
{"key": "data.voice.german.close.1", "text": "Accettabile.", "src": "Acceptable."},
{"key": "data.voice.german.close.2", "text": "Va bene.", "src": "It is fine."},
{"key": "data.voice.german.kicked.0", "text": "Questo è assurdo.", "src": "This is absurd."},
{"key": "data.voice.german.kicked.1", "text": "Bene. Non tornerò.", "src": "Fine. I will not return."},
{"key": "data.voice.german.kicked.2", "text": "Ja, ja. Me ne vado.", "src": "Ja, ja. I am going."},
{"key": "data.voice.german.leaving.0", "text": "Non è accettabile. Me ne vado.", "src": "This is not acceptable. I am leaving."},
{"key": "data.voice.german.leaving.1", "text": "Nein. Ho aspettato abbastanza.", "src": "Nein. I have waited enough."},
{"key": "data.voice.german.leaving.2", "text": "Unglaublich. Arrivederci.", "src": "Unglaublich. Goodbye."},
{"key": "data.voice.german.order.0", "text": "{drink}, per favore. Fatto bene.", "src": "A {drink}, please. Correctly made."},
{"key": "data.voice.german.order.1", "text": "{drink}. Grazie.", "src": "{drink}. Thank you."},
{"key": "data.voice.german.order.2", "text": "Per me {drink}, bitte.", "src": "One {drink}, bitte."},
{"key": "data.voice.german.order.3", "text": "Io vorrei: {drink}.", "src": "I would like a {drink}."},
{"key": "data.voice.german.perfect.0", "text": "Genau!", "src": "Genau!"},
{"key": "data.voice.german.perfect.1", "text": "Sehr gut!", "src": "Sehr gut!"},
{"key": "data.voice.german.perfect.2", "text": "Wunderbar!", "src": "Wunderbar!"},
{"key": "data.voice.german.praise.0", "text": "Ja. Esattamente come deve essere.", "src": "Ja. This is exactly right."},
{"key": "data.voice.german.praise.1", "text": "Preciso. Io rispetto la precisione.", "src": "Precise. I respect precision."},
{"key": "data.voice.german.praise.2", "text": "Sehr gut. Niente da ridire.", "src": "Sehr gut. No notes."},
{"key": "data.voice.german.sip.0", "text": "Genau, ma {advice_l}", "src": "Genau, but {advice_l}"},
{"key": "data.voice.german.sip.1", "text": "Un'osservazione: {advice_l}", "src": "One remark: {advice_l}"},
{"key": "data.voice.german.sip.2", "text": "Ja, {advice_l}", "src": "Ja, {advice_l}"},
{"key": "data.voice.german.wrong.0", "text": "Nein. Non questo.", "src": "Nein. Not this."},
{"key": "data.voice.german.wrong.1", "text": "Questo non è corretto.", "src": "This is incorrect."},
{"key": "data.voice.german.wrong.2", "text": "Drink sbagliato.", "src": "Wrong drink."},
{"key": "data.voice.korean.another.0", "text": "Han jan deo!", "src": "Han jan deo!"},
{"key": "data.voice.korean.another.1", "text": "Un altro!", "src": "One more!"},
{"key": "data.voice.korean.another.2", "text": "Ancora, juseyo!", "src": "Again, juseyo!"},
{"key": "data.voice.korean.close.0", "text": "Gwenchana.", "src": "Gwenchana."},
{"key": "data.voice.korean.close.1", "text": "Va bene.", "src": "It is okay."},
{"key": "data.voice.korean.close.2", "text": "Nappeuji anha.", "src": "Nappeuji anha."},
{"key": "data.voice.korean.kicked.0", "text": "Jinjja? Wow.", "src": "Jinjja? Wow."},
{"key": "data.voice.korean.kicked.1", "text": "Aish. Va bene.", "src": "Aish. Fine."},
{"key": "data.voice.korean.kicked.2", "text": "Annyeong, allora.", "src": "Annyeong, then."},
{"key": "data.voice.korean.leaving.0", "text": "Aish. Troppo tempo.", "src": "Aish. Too long."},
{"key": "data.voice.korean.leaving.1", "text": "Me ne vado. Annyeong.", "src": "I am going. Annyeong."},
{"key": "data.voice.korean.leaving.2", "text": "Mot chamgesseo.", "src": "Mot chamgesseo."},
{"key": "data.voice.korean.order.0", "text": "{drink}, juseyo.", "src": "{drink}, juseyo."},
{"key": "data.voice.korean.order.1", "text": "{drink}, per favore.", "src": "One {drink}, please."},
{"key": "data.voice.korean.order.2", "text": "Per me {drink}.", "src": "A {drink} for me."},
{"key": "data.voice.korean.order.3", "text": "Io prendo: {drink}.", "src": "I want a {drink}."},
{"key": "data.voice.korean.perfect.0", "text": "Daebak!", "src": "Daebak!"},
{"key": "data.voice.korean.perfect.1", "text": "Jinjja buono!", "src": "Jinjja good!"},
{"key": "data.voice.korean.perfect.2", "text": "Choego!", "src": "Choego!"},
{"key": "data.voice.korean.praise.0", "text": "Daebak. Jinjja, è perfetto.", "src": "Daebak. Jinjja, this is perfect."},
{"key": "data.voice.korean.praise.1", "text": "Choego. Dico sul serio.", "src": "Choego. I mean it."},
{"key": "data.voice.korean.praise.2", "text": "Wow. Ci sai proprio fare.", "src": "Wow. You are good at this."},
{"key": "data.voice.korean.sip.0", "text": "Jamkkanman, {advice_l}", "src": "Jamkkanman, {advice_l}"},
{"key": "data.voice.korean.sip.1", "text": "Ehm, {advice_l}", "src": "Um, {advice_l}"},
{"key": "data.voice.korean.sip.2", "text": "Gwenchana, ma {advice_l}", "src": "Gwenchana, but {advice_l}"},
{"key": "data.voice.korean.wrong.0", "text": "Aniyo, no.", "src": "Aniyo, no."},
{"key": "data.voice.korean.wrong.1", "text": "È sbagliato.", "src": "This is wrong."},
{"key": "data.voice.korean.wrong.2", "text": "Eh? Non è il mio.", "src": "Eh? Not mine."},
{"key": "data.voice.nordic.another.0", "text": "Un altro. Skål!", "src": "Another. Skål!"},
{"key": "data.voice.nordic.another.1", "text": "Ancora uno.", "src": "One more."},
{"key": "data.voice.nordic.another.2", "text": "Di nuovo, per favore.", "src": "Again, please."},
{"key": "data.voice.nordic.close.0", "text": "Va bene.", "src": "Fine."},
{"key": "data.voice.nordic.close.1", "text": "È okay.", "src": "It's okay."},
{"key": "data.voice.nordic.close.2", "text": "Abbastanza buono.", "src": "Good enough."},
{"key": "data.voice.nordic.kicked.0", "text": "Okay. Strano, ma okay.", "src": "Okay. Strange, but okay."},
{"key": "data.voice.nordic.kicked.1", "text": "D'accordo.", "src": "Fine."},
{"key": "data.voice.nordic.kicked.2", "text": "Mh. Arrivederci, allora.", "src": "Hm. Goodbye then."},
{"key": "data.voice.nordic.leaving.0", "text": "Vado. Va bene così.", "src": "I'll go. It's fine."},
{"key": "data.voice.nordic.leaving.1", "text": "Troppo tempo. Arrivederci.", "src": "Too long. Goodbye."},
{"key": "data.voice.nordic.leaving.2", "text": "No. Me ne vado.", "src": "No. I'm leaving."},
{"key": "data.voice.nordic.order.0", "text": "{drink}. Grazie.", "src": "A {drink}. Thanks."},
{"key": "data.voice.nordic.order.1", "text": "{drink}, per favore.", "src": "{drink}, please."},
{"key": "data.voice.nordic.order.2", "text": "Per me {drink}. Con calma.", "src": "One {drink}. No rush."},
{"key": "data.voice.nordic.order.3", "text": "Io prendo: {drink}.", "src": "I'll have the {drink}."},
{"key": "data.voice.nordic.perfect.0", "text": "Skål!", "src": "Skål!"},
{"key": "data.voice.nordic.perfect.1", "text": "Molto buono.", "src": "Very good."},
{"key": "data.voice.nordic.perfect.2", "text": "Sì. Buono.", "src": "Yes. Good."},
{"key": "data.voice.nordic.praise.0", "text": "È molto buono. E io non lo dico mai.", "src": "This is very good. I don't say that."},
{"key": "data.voice.nordic.praise.1", "text": "Skål. Fatto come si deve.", "src": "Skål. Properly done."},
{"key": "data.voice.nordic.praise.2", "text": "Buono. Davvero buono.", "src": "Good. Really good."},
{"key": "data.voice.nordic.sip.0", "text": "Allora. {advice}", "src": "Well. {advice}"},
{"key": "data.voice.nordic.sip.1", "text": "Mh. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.nordic.sip.2", "text": "Va bene, ma {advice_l}", "src": "Fine, but {advice_l}"},
{"key": "data.voice.nordic.wrong.0", "text": "No. Quello sbagliato.", "src": "No. Wrong one."},
{"key": "data.voice.nordic.wrong.1", "text": "Non è questo.", "src": "This is not it."},
{"key": "data.voice.nordic.wrong.2", "text": "Mh. Non è il mio.", "src": "Hm. Not mine."},
{"key": "data.voice.southern.another.0", "text": "Versamene un altro!", "src": "Pour me another!"},
{"key": "data.voice.southern.another.1", "text": "Un altro, sugar!", "src": "One more, sugar!"},
{"key": "data.voice.southern.another.2", "text": "Avanti con il prossimo!", "src": "Keep 'em comin'!"},
{"key": "data.voice.southern.close.0", "text": "Va bene così.", "src": "That's alright."},
{"key": "data.voice.southern.close.1", "text": "Ci sta, dai.", "src": "Fair enough."},
{"key": "data.voice.southern.close.2", "text": "Be', può andare.", "src": "Well, it'll do."},
{"key": "data.voice.southern.kicked.0", "text": "Be', questa è proprio maleducazione.", "src": "Well, that's just rude."},
{"key": "data.voice.southern.kicked.1", "text": "D'accordo allora. Buona serata.", "src": "Alright then. Have a good one."},
{"key": "data.voice.southern.kicked.2", "text": "Aspetta un attimo… va bene.", "src": "Now hold on… fine."},
{"key": "data.voice.southern.leaving.0", "text": "Be', non ho mica tutta la notte.", "src": "Well, I ain't got all night."},
{"key": "data.voice.southern.leaving.1", "text": "Mi sa che vado a bere altrove.", "src": "Reckon I'll drink elsewhere."},
{"key": "data.voice.southern.leaving.2", "text": "Ve la prendete comoda, y'all.", "src": "Y'all take your sweet time, don't you."},
{"key": "data.voice.southern.order.0", "text": "Be', mi andrebbe proprio: {drink}.", "src": "Well now, a {drink} would suit me."},
{"key": "data.voice.southern.order.1", "text": "{drink}, darlin', se non ti spiace.", "src": "{drink}, darlin', if you please."},
{"key": "data.voice.southern.order.2", "text": "Mi sa che per me {drink}.", "src": "Reckon I'll have a {drink}."},
{"key": "data.voice.southern.order.3", "text": "{drink} per me, sugar.", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "Ma che meraviglia!", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "Signore, che buono!", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "Accidenti, sì!", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "Be', guarda un po'. Questo è un vero drink.", "src": "Well, I'll be. That's a proper drink."},
{"key": "data.voice.southern.praise.1", "text": "Darlin', tu hai un dono.", "src": "Darlin', you got a gift."},
{"key": "data.voice.southern.praise.2", "text": "Mi sa che ho trovato il mio nuovo posto.", "src": "Reckon I found my new spot."},
{"key": "data.voice.southern.sip.0", "text": "Allora, {advice_l}", "src": "Now, {advice_l}"},
{"key": "data.voice.southern.sip.1", "text": "Sugar, {advice_l}", "src": "Sugar, {advice_l}"},
{"key": "data.voice.southern.sip.2", "text": "Te lo dico io, {advice_l}", "src": "Tell you what, {advice_l}"},
{"key": "data.voice.southern.wrong.0", "text": "Non è il mio, hon.", "src": "Ain't mine, hon."},
{"key": "data.voice.southern.wrong.1", "text": "E questo cos'è?", "src": "Now what is this?"},
{"key": "data.voice.southern.wrong.2", "text": "Oh, tesoro. Bless your heart.", "src": "Bless your heart."}
]}
