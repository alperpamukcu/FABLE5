{"strings": [
{"key": "data.voice.aussie.another.0", "text": "Un altro uguale, mate!", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "Ancora uno, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "Un altro, legend!", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "Sì, righto.", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "Niente male, mate.", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "Può andare.", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "Sul serio, mate?", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto. Ci sta.", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Nah, questa è pesante.", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto, ho aspettato abbastanza.", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Nah, lascia stare. Me ne vado.", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "Cheers per niente, mate.", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "{drink}, mate.", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink}, per favore.", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "Dai, per me {drink}.", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "{drink} per me, cheers.", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "Ripper!", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "Too easy!", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "Buono da matti!", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "Un ripper, mate. Cheers.", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "Too easy. Sai il fatto tuo.", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "Il migliore della serata, sul serio.", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "Senti, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "No dramas, ma {advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Nah, mate.", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "Non è il mio, scusa.", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "Quello sbagliato, mate.", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "Un altro giro!", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "Lo stesso, grazie!", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "Avanti con il prossimo!", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "Grazie.", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "Può andare.", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "Ci siamo quasi.", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "Sul serio? Va bene.", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "Stai facendo un errore.", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "Come vuoi. Tieniti il tuo bar.", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "Lascia perdere. Ho finito di aspettare.", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "Ma stasera lavora qualcuno?", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "Bene. Vado a bere da un'altra parte.", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink}, per favore.", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "Per me {drink}.", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "{drink}, quando hai un attimo.", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "Allora… {drink}.", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "Perfetto!", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "Proprio così!", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "Centrato!", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "Non cambierei niente.", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "Questo sì che è un drink.", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "Chiunque ti abbia insegnato, ringrazialo.", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "Mh. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice} Tanto per dire.", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "Sinceramente? {advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "Non è quello che ho chiesto.", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "Drink sbagliato.", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "Questo non è il mio.", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "Encore, per favore!", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "Un altro, oui!", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "Ancora, merci!", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ça va.", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "Va bene.", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon, okay.", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "Quoi? Davvero?", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Bon. Au revoir.", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule.", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non. Ho aspettato abbastanza.", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis. Io vado.", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "Au revoir, allora.", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "{drink}, s'il vous plaît.", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "{drink}, per favore.", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "Per me {drink}, merci.", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "Io prendo: {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "Parfait!", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "Voilà, perfetto!", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "Magnifique!", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait. Non ho proprio niente da dire.", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voilà. Qui qualcuno sa versare.", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique. Davvero.", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Écoute, {advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon, {advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors, {advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non.", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "Non è questo.", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon, sbagliato.", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "Mou ippai!", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "Un altro, kanpai!", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "Ancora, onegai!", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Hai, okay.", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa.", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "Non male, ne.", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "Eh?! Davvero?", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi. Okay, vado.", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta. Sayonara.", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen, non posso aspettare di più.", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii. Io vado.", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai. Arrivederci.", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen, {drink}.", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "{drink}, onegai.", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink}, per favore. Arigatou.", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto… {drink}.", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "Oishii!", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "Sugoi, perfetto!", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "Kanpai!", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii. Davvero, è proprio questo.", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "Sugoi. Qui c'è mestiere, ne.", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "Kanpai. È perfetto.", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "Etto, {advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "Ne, {advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "Sumimasen, ma {advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "Chotto… no.", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "Eh? Non questo.", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "Chigau, scusa.", "src": "Chigau, sorry."},
{"key": "data.voice.midwest.another.0", "text": "Un altro, per favore!", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "Ancora uno, grazie!", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "Lo stesso, ope!", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "Oh, va benissimo.", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "Certo, grazie.", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "Niente male davvero.", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "Oh. Be'. Okay allora.", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "Ope, scusa… me ne vado.", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "Un po' esagerato, ma okay.", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "Oh gosh, proprio non posso aspettare ancora.", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "Be', dovrei proprio andare.", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "Scusa, ma io andrei.", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "Potrei avere… {drink}? Grazie mille.", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "{drink}, se non è un disturbo.", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "Oh, per me solo {drink}.", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink}, per favore. Con comodo.", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "Oh, proprio bello!", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "You betcha!", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "Oh jeez, sì!", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "Oh my gosh, è semplicemente delizioso.", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "Proprio bello. A mia zia piacerebbe un sacco questo posto.", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "Be', ci voleva proprio.", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "Oh, {advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "Giusto perché tu lo sappia, {advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "Niente di grave, ma {advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "Ope. Quello sbagliato.", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "Oh, non è il mio.", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "Scusa, no. Non questo.", "src": "Sorry, no. Not this."},
{"key": "data.voice.polish.another.0", "text": "Jeszcze raz!", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "Un altro, proszę!", "src": "Another, proszę!"},
{"key": "data.voice.polish.another.2", "text": "Ancora uno!", "src": "One more!"},
{"key": "data.voice.polish.close.0", "text": "Dobrze.", "src": "Dobrze."},
{"key": "data.voice.polish.close.1", "text": "Okay.", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "Va bene, grazie.", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "Serio? Okay.", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "Va bene. Do widzenia.", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "Co? Okay, vado.", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "Basta. Me ne vado.", "src": "Enough. I'm going."},
{"key": "data.voice.polish.leaving.1", "text": "Nie, nie. Troppo tempo.", "src": "Nie, nie. Too long."},
{"key": "data.voice.polish.leaving.2", "text": "Do widzenia.", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "{drink}, proszę.", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "{drink}, per favore.", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "Per me {drink}. Grazie.", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "Dobrze, allora: {drink}.", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "Na zdrowie!", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "Świetnie!", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "Molto buono!", "src": "Very good!"},
{"key": "data.voice.polish.praise.0", "text": "Na zdrowie. Questo è un vero drink.", "src": "Na zdrowie. This is a real drink."},
{"key": "data.voice.polish.praise.1", "text": "Świetnie. Come a casa.", "src": "Świetnie. Like at home."},
{"key": "data.voice.polish.praise.2", "text": "Dobrze. Molto, molto buono.", "src": "Dobrze. Very, very good."},
{"key": "data.voice.polish.sip.0", "text": "Dobrze, ma {advice_l}", "src": "Dobrze, but {advice_l}"},
{"key": "data.voice.polish.sip.1", "text": "Senti, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.polish.sip.2", "text": "Mh, {advice_l}", "src": "Hm, {advice_l}"},
{"key": "data.voice.polish.wrong.0", "text": "Nie. Quello sbagliato.", "src": "Nie. Wrong one."},
{"key": "data.voice.polish.wrong.1", "text": "Questo non è il mio.", "src": "This is not mine."},
{"key": "data.voice.polish.wrong.2", "text": "Co to jest?", "src": "Co to jest?"},
{"key": "data.voice.turkish.another.0", "text": "Bir daha!", "src": "Bir daha!"},
{"key": "data.voice.turkish.another.1", "text": "Un altro, abi!", "src": "Another, abi!"},
{"key": "data.voice.turkish.another.2", "text": "Ancora, eyvallah!", "src": "Again, eyvallah!"},
{"key": "data.voice.turkish.close.0", "text": "Tamam.", "src": "Tamam."},
{"key": "data.voice.turkish.close.1", "text": "İdare eder.", "src": "İdare eder."},
{"key": "data.voice.turkish.close.2", "text": "Okay, va bene.", "src": "Okay, fine."},
{"key": "data.voice.turkish.kicked.0", "text": "Ciddi misin? Okay.", "src": "Ciddi misin? Okay."},
{"key": "data.voice.turkish.kicked.1", "text": "Abi, davvero? Va bene.", "src": "Abi, really? Fine."},
{"key": "data.voice.turkish.kicked.2", "text": "Yok, yok. Me ne vado.", "src": "Yok, yok. I'm going."},
{"key": "data.voice.turkish.leaving.0", "text": "Yok, non aspetto più.", "src": "Yok, I'm not waiting anymore."},
{"key": "data.voice.turkish.leaving.1", "text": "Abi, qui non lavora nessuno?", "src": "Abi, is nobody working here?"},
{"key": "data.voice.turkish.leaving.2", "text": "Tamam, hoşça kal.", "src": "Tamam, hoşça kal."},
{"key": "data.voice.turkish.order.0", "text": "Abi, {drink}.", "src": "Abi, a {drink}."},
{"key": "data.voice.turkish.order.1", "text": "Per me {drink}, eyvallah.", "src": "One {drink}, eyvallah."},
{"key": "data.voice.turkish.order.2", "text": "{drink}, canım, quando puoi.", "src": "{drink}, canım, when you can."},
{"key": "data.voice.turkish.order.3", "text": "Bir {drink}, per favore.", "src": "Bir {drink}, please."},
{"key": "data.voice.turkish.perfect.0", "text": "Eyvallah!", "src": "Eyvallah!"},
{"key": "data.voice.turkish.perfect.1", "text": "Harika!", "src": "Harika!"},
{"key": "data.voice.turkish.perfect.2", "text": "Süper, abi!", "src": "Süper, abi!"},
{"key": "data.voice.turkish.praise.0", "text": "Eyvallah. Così si fa.", "src": "Eyvallah. This is how it's done."},
{"key": "data.voice.turkish.praise.1", "text": "Abi, giù il cappello. Harika.", "src": "Abi, my hat is off. Harika."},
{"key": "data.voice.turkish.praise.2", "text": "Tamam, sai fare il tuo lavoro.", "src": "Tamam, you know your work."},
{"key": "data.voice.turkish.sip.0", "text": "Abi, {advice_l}", "src": "Abi, {advice_l}"},
{"key": "data.voice.turkish.sip.1", "text": "Bak, {advice_l}", "src": "Bak, {advice_l}"},
{"key": "data.voice.turkish.sip.2", "text": "Tamam ama, {advice_l}", "src": "Tamam ama, {advice_l}"},
