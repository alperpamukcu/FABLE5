{"strings": [
{"key": "data.voice.arabic.another.0", "text": "Kaman wahad!", "src": "Kaman wahad!"},
{"key": "data.voice.arabic.another.1", "text": "Un altro, yalla!", "src": "One more, yalla!"},
{"key": "data.voice.arabic.another.2", "text": "Ancora, habibi!", "src": "Again, habibi!"},
{"key": "data.voice.arabic.close.0", "text": "Maashi.", "src": "Maashi."},
{"key": "data.voice.arabic.close.1", "text": "Va bene.", "src": "It is okay."},
{"key": "data.voice.arabic.close.2", "text": "Tamam, shukran.", "src": "Tamam, shukran."},
{"key": "data.voice.arabic.kicked.0", "text": "Shu? Sul serio?", "src": "Shu? Seriously?"},
{"key": "data.voice.arabic.kicked.1", "text": "Khalas. Va bene.", "src": "Khalas. Fine."},
{"key": "data.voice.arabic.kicked.2", "text": "Yalla. Me ne vado.", "src": "Yalla. I go."},
{"key": "data.voice.arabic.leaving.0", "text": "Khalas. Io vado.", "src": "Khalas. I am going."},
{"key": "data.voice.arabic.leaving.1", "text": "Yalla, basta aspettare.", "src": "Yalla, enough waiting."},
{"key": "data.voice.arabic.leaving.2", "text": "Maa salama.", "src": "Maa salama."},
{"key": "data.voice.arabic.order.0", "text": "{drink}, per favore.", "src": "A {drink}, please."},
{"key": "data.voice.arabic.order.1", "text": "Per me {drink}, shukran.", "src": "One {drink}, shukran."},
{"key": "data.voice.arabic.order.2", "text": "Habibi, {drink}.", "src": "Habibi, a {drink}."},
{"key": "data.voice.arabic.order.3", "text": "Io prendo: {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.arabic.perfect.0", "text": "Ya salam!", "src": "Ya salam!"},
{"key": "data.voice.arabic.perfect.1", "text": "Helu kteer!", "src": "Helu kteer!"},
{"key": "data.voice.arabic.perfect.2", "text": "Perfetto, habibi!", "src": "Perfect, habibi!"},
{"key": "data.voice.arabic.praise.0", "text": "Ya salam. È proprio questo, habibi.", "src": "Ya salam. This is the one, habibi."},
{"key": "data.voice.arabic.praise.1", "text": "Helu kteer. Shukran.", "src": "Helu kteer. Shukran."},
{"key": "data.voice.arabic.praise.2", "text": "Yalla, sai fare il tuo lavoro.", "src": "Yalla, you know your work."},
{"key": "data.voice.arabic.sip.0", "text": "Habibi, {advice_l}", "src": "Habibi, {advice_l}"},
{"key": "data.voice.arabic.sip.1", "text": "Shuf, {advice_l}", "src": "Shuf, {advice_l}"},
{"key": "data.voice.arabic.sip.2", "text": "Tamam, bas {advice_l}", "src": "Tamam, bas {advice_l}"},
{"key": "data.voice.arabic.wrong.0", "text": "La, la.", "src": "La, la."},
{"key": "data.voice.arabic.wrong.1", "text": "Non è questo.", "src": "This is not it."},
{"key": "data.voice.arabic.wrong.2", "text": "Shu hada?", "src": "Shu hada?"},
{"key": "data.voice.chinese.another.0", "text": "Zai lai yi bei!", "src": "Zai lai yi bei!"},
{"key": "data.voice.chinese.another.1", "text": "Ancora uno, ah!", "src": "One more, ah!"},
{"key": "data.voice.chinese.another.2", "text": "Di nuovo, per favore!", "src": "Again, please!"},
{"key": "data.voice.chinese.close.0", "text": "Hai keyi.", "src": "Hai keyi."},
{"key": "data.voice.chinese.close.1", "text": "Okay lah.", "src": "Okay lah."},
{"key": "data.voice.chinese.close.2", "text": "Va bene.", "src": "It is fine."},
{"key": "data.voice.chinese.kicked.0", "text": "Shenme? Davvero?", "src": "Shenme? Really?"},
{"key": "data.voice.chinese.kicked.1", "text": "Aiya. Va bene.", "src": "Aiya. Fine."},
{"key": "data.voice.chinese.kicked.2", "text": "Hao. Me ne vado.", "src": "Hao. I leave."},
{"key": "data.voice.chinese.leaving.0", "text": "Aiya. Ho aspettato troppo.", "src": "Aiya. I waited too long."},
{"key": "data.voice.chinese.leaving.1", "text": "Suan le. Io vado.", "src": "Suan le. I go."},
{"key": "data.voice.chinese.leaving.2", "text": "Zaijian, allora.", "src": "Zaijian, then."},
{"key": "data.voice.chinese.order.0", "text": "{drink}, per favore.", "src": "{drink}, please."},
{"key": "data.voice.chinese.order.1", "text": "Per me {drink}, xiexie.", "src": "One {drink}, xiexie."},
{"key": "data.voice.chinese.order.2", "text": "Io prendo: {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.chinese.order.3", "text": "{drink} per me.", "src": "A {drink} for me."},
{"key": "data.voice.chinese.perfect.0", "text": "Hen hao!", "src": "Hen hao!"},
{"key": "data.voice.chinese.perfect.1", "text": "Perfetto, ah!", "src": "Perfect, ah!"},
{"key": "data.voice.chinese.perfect.2", "text": "Zhen bang!", "src": "Zhen bang!"},
{"key": "data.voice.chinese.praise.0", "text": "Zhen bang. Torno apposta per questo.", "src": "Zhen bang. I will come back for this."},
{"key": "data.voice.chinese.praise.1", "text": "Hen hao. Sai quello che fai.", "src": "Hen hao. You know what you are doing."},
{"key": "data.voice.chinese.praise.2", "text": "Perfetto, ah. Davvero.", "src": "Perfect, ah. Really."},
{"key": "data.voice.chinese.sip.0", "text": "Ai, {advice_l}", "src": "Ai, {advice_l}"},
{"key": "data.voice.chinese.sip.1", "text": "Senti, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.chinese.sip.2", "text": "Hao, ma {advice_l}", "src": "Hao, but {advice_l}"},
{"key": "data.voice.chinese.wrong.0", "text": "Bu dui.", "src": "Bu dui."},
{"key": "data.voice.chinese.wrong.1", "text": "Aiya, no.", "src": "Aiya, no."},
{"key": "data.voice.chinese.wrong.2", "text": "Non è questo.", "src": "Not this one."},
{"key": "data.voice.filipino.another.0", "text": "Isa pa!", "src": "Isa pa!"},
{"key": "data.voice.filipino.another.1", "text": "Un altro, ha!", "src": "One more, ha!"},
{"key": "data.voice.filipino.another.2", "text": "Ancora, per favore!", "src": "Again, please!"},
{"key": "data.voice.filipino.close.0", "text": "Okay lang.", "src": "Okay lang."},
{"key": "data.voice.filipino.close.1", "text": "Sige, grazie.", "src": "Sige, thanks."},
{"key": "data.voice.filipino.close.2", "text": "Ay, va bene.", "src": "Ay, it's fine."},
{"key": "data.voice.filipino.kicked.0", "text": "Ha? Davvero?", "src": "Ha? Really?"},
{"key": "data.voice.filipino.kicked.1", "text": "Ay. Okay. Ciao.", "src": "Ay. Okay. Bye."},
{"key": "data.voice.filipino.kicked.2", "text": "Grabe naman.", "src": "Grabe naman."},
{"key": "data.voice.filipino.leaving.0", "text": "Ay, grabe. Troppo tempo. Me ne vado.", "src": "Ay, grabe. Too long. I'm going."},
{"key": "data.voice.filipino.leaving.1", "text": "Sige na, ciao.", "src": "Sige na, bye."},
{"key": "data.voice.filipino.leaving.2", "text": "Naku, qui non viene nessuno.", "src": "Naku, no one is coming."},
{"key": "data.voice.filipino.order.0", "text": "Ay, {drink}, per favore.", "src": "Ay, one {drink}, please."},
{"key": "data.voice.filipino.order.1", "text": "{drink} per me. Salamat.", "src": "{drink} for me. Salamat."},
{"key": "data.voice.filipino.order.2", "text": "{drink}, si può? Grazie, ha.", "src": "Can I have a {drink}? Thanks, ha."},
{"key": "data.voice.filipino.order.3", "text": "{drink}, kuya.", "src": "A {drink}, kuya."},
{"key": "data.voice.filipino.perfect.0", "text": "Ay, sarap!", "src": "Ay, sarap!"},
{"key": "data.voice.filipino.perfect.1", "text": "Grabe, sì!", "src": "Grabe, yes!"},
{"key": "data.voice.filipino.perfect.2", "text": "Perfetto, kuya!", "src": "Perfect, kuya!"},
{"key": "data.voice.filipino.praise.0", "text": "Grabe. Buonissimo. Salamat.", "src": "Grabe. That is so good. Salamat."},
{"key": "data.voice.filipino.praise.1", "text": "Ay, sarap. Mi hai fatto dimenticare il turno.", "src": "Ay, sarap. You made my whole shift."},
{"key": "data.voice.filipino.praise.2", "text": "Sige, torno apposta per questo.", "src": "Sige, I'm coming back for this."},
{"key": "data.voice.filipino.sip.0", "text": "Ay, {advice_l}", "src": "Ay, {advice_l}"},
{"key": "data.voice.filipino.sip.1", "text": "Sige, ma {advice_l}", "src": "Sige, but {advice_l}"},
{"key": "data.voice.filipino.sip.2", "text": "Ha? {advice}", "src": "Ha? {advice}"},
{"key": "data.voice.filipino.wrong.0", "text": "Ay, hindi. Non questo.", "src": "Ay, hindi. Not this."},
{"key": "data.voice.filipino.wrong.1", "text": "Grabe, drink sbagliato.", "src": "Grabe, wrong drink."},
{"key": "data.voice.filipino.wrong.2", "text": "Non è il mio, kuya.", "src": "Not mine, kuya."},
{"key": "data.voice.italian.another.0", "text": "Dai, un altro!", "src": "Ancora, dai!"},
{"key": "data.voice.italian.another.1", "text": "Ancora uno, grazie!", "src": "Another, grazie!"},
{"key": "data.voice.italian.another.2", "text": "Rifammene un altro, va'!", "src": "Once more, amore!"},
{"key": "data.voice.italian.close.0", "text": "Va bene.", "src": "Va bene."},
{"key": "data.voice.italian.close.1", "text": "Okay, grazie.", "src": "Okay, grazie."},
{"key": "data.voice.italian.close.2", "text": "Non male, eh.", "src": "Not bad, eh."},
{"key": "data.voice.italian.kicked.0", "text": "Ma dai! Sul serio?", "src": "Ma dai! Really?"},
{"key": "data.voice.italian.kicked.1", "text": "Va bene. Ciao, ciao.", "src": "Va bene. Ciao, ciao."},
{"key": "data.voice.italian.kicked.2", "text": "Che maleducazione.", "src": "Che maleducato."},
{"key": "data.voice.italian.leaving.0", "text": "Basta. Me ne vado.", "src": "Basta. I go."},
{"key": "data.voice.italian.leaving.1", "text": "Mamma mia, quanto si aspetta!", "src": "Mamma mia, the waiting!"},
{"key": "data.voice.italian.leaving.2", "text": "Ciao. Magari nella prossima vita.", "src": "Ciao. Maybe next life."},
{"key": "data.voice.italian.order.0", "text": "Per me {drink}, per favore.", "src": "Un {drink}, per favore."},
{"key": "data.voice.italian.order.1", "text": "Capo, {drink}.", "src": "A {drink}, amore."},
{"key": "data.voice.italian.order.2", "text": "{drink}, grazie.", "src": "{drink}, grazie."},
{"key": "data.voice.italian.order.3", "text": "Allora… {drink}, dai.", "src": "Dai, a {drink}."},
{"key": "data.voice.italian.perfect.0", "text": "Perfetto!", "src": "Perfetto!"},
{"key": "data.voice.italian.perfect.1", "text": "Grande!", "src": "Bravo!"},
{"key": "data.voice.italian.perfect.2", "text": "Che buono!", "src": "Che buono!"},
{"key": "data.voice.italian.praise.0", "text": "Perfetto. Davvero. Grazie mille.", "src": "Perfetto. Truly. Grazie mille."},
{"key": "data.voice.italian.praise.1", "text": "Complimenti. Mia nonna piangerebbe.", "src": "Bravo. My nonna would cry."},
{"key": "data.voice.italian.praise.2", "text": "Che buono. Io da qui non me ne vado.", "src": "Che buono. I'm not leaving."},
{"key": "data.voice.italian.sip.0", "text": "Senti, {advice_l}", "src": "Senti, {advice_l}"},
{"key": "data.voice.italian.sip.1", "text": "Allora, {advice_l}", "src": "Allora, {advice_l}"},
{"key": "data.voice.italian.sip.2", "text": "Va bene, ma {advice_l}", "src": "Va bene, ma {advice_l}"},
{"key": "data.voice.italian.wrong.0", "text": "Mamma mia, no.", "src": "Mamma mia, no."},
{"key": "data.voice.italian.wrong.1", "text": "Ma che cos'è?", "src": "Ma che cos'è?"},
{"key": "data.voice.italian.wrong.2", "text": "No, no. Non questo.", "src": "No, no. Not this."},
{"key": "data.voice.miami.another.0", "text": "¡Otra, dale!", "src": "¡Otra, dale!"},
{"key": "data.voice.miami.another.1", "text": "Un altro, oye!", "src": "One more, oye!"},
{"key": "data.voice.miami.another.2", "text": "Ancora, mi amor!", "src": "Again, mi amor!"},
{"key": "data.voice.miami.close.0", "text": "Está bien.", "src": "Está bien."},
{"key": "data.voice.miami.close.1", "text": "Niente male, chico.", "src": "Not bad, chico."},
{"key": "data.voice.miami.close.2", "text": "Okay, okay.", "src": "Okay, okay."},
{"key": "data.voice.miami.kicked.0", "text": "¿En serio? Okay, va bene.", "src": "¿En serio? Okay, fine."},
{"key": "data.voice.miami.kicked.1", "text": "Mi prendi in giro, chico.", "src": "You're kidding me, chico."},
{"key": "data.voice.miami.kicked.2", "text": "Dale. Peggio per te.", "src": "Dale. Your loss."},
{"key": "data.voice.miami.leaving.0", "text": "¡Oye! Sono qui da tutta la sera.", "src": "¡Oye! I've been sitting here all night."},
{"key": "data.voice.miami.leaving.1", "text": "Bueno, basta così. Ciao.", "src": "Bueno, that's it. Ciao."},
{"key": "data.voice.miami.leaving.2", "text": "No, no. Non aspetto più.", "src": "No, no. I'm not waiting anymore."},
{"key": "data.voice.miami.order.0", "text": "Oye, per me {drink}.", "src": "Oye, a {drink} for me."},
{"key": "data.voice.miami.order.1", "text": "Dale, {drink}.", "src": "Dale, one {drink}."},
{"key": "data.voice.miami.order.2", "text": "{drink}, papi, quando puoi.", "src": "{drink}, papi, when you can."},
{"key": "data.voice.miami.order.3", "text": "Mi amor, {drink}.", "src": "Mi amor, a {drink}."},
{"key": "data.voice.miami.perfect.0", "text": "¡Qué rico!", "src": "¡Qué rico!"},
{"key": "data.voice.miami.perfect.1", "text": "¡Eso es!", "src": "¡Eso es!"},
{"key": "data.voice.miami.perfect.2", "text": "¡Dale, perfetto!", "src": "¡Dale, perfecto!"},
{"key": "data.voice.miami.praise.0", "text": "Ay, è proprio questo. Gracias.", "src": "Ay, this is the one. Gracias."},
{"key": "data.voice.miami.praise.1", "text": "Mia abuela approverebbe, e lei non approva niente.", "src": "My abuela would approve, and she approves of nothing."},
{"key": "data.voice.miami.praise.2", "text": "Dale. Sai quello che fai.", "src": "Dale. You know what you're doing."},
{"key": "data.voice.miami.sip.0", "text": "Mira, {advice_l}", "src": "Mira, {advice_l}"},
{"key": "data.voice.miami.sip.1", "text": "Oye, {advice_l}", "src": "Oye, {advice_l}"},
{"key": "data.voice.miami.sip.2", "text": "Está bien, pero… {advice_l}", "src": "Está bien, pero… {advice_l}"},
{"key": "data.voice.miami.wrong.0", "text": "¿Qué es esto?", "src": "¿Qué es esto?"},
{"key": "data.voice.miami.wrong.1", "text": "No, no, no.", "src": "No, no, no."},
{"key": "data.voice.miami.wrong.2", "text": "Non è il mio, oye.", "src": "Not mine, oye."},
{"key": "data.voice.nyc.another.0", "text": "Dammene un altro!", "src": "Hit me again!"},
{"key": "data.voice.nyc.another.1", "text": "Avanti, un altro!", "src": "Keep 'em comin'!"},
{"key": "data.voice.nyc.another.2", "text": "Un altro, chief!", "src": "Another, chief!"},
{"key": "data.voice.nyc.close.0", "text": "Eh. Va bene.", "src": "Eh. It's fine."},
{"key": "data.voice.nyc.close.1", "text": "Sì, okay.", "src": "Yeah, alright."},
{"key": "data.voice.nyc.close.2", "text": "Può andare.", "src": "It'll do."},
{"key": "data.voice.nyc.kicked.0", "text": "Fai sul serio, adesso?", "src": "You serious right now?"},
{"key": "data.voice.nyc.kicked.1", "text": "Va bene. Bar orribile, comunque.", "src": "Fine. Terrible bar anyway."},
{"key": "data.voice.nyc.kicked.2", "text": "Wow. Okay. Wow.", "src": "Wow. Okay. Wow."},
{"key": "data.voice.nyc.leaving.0", "text": "Ho da fare. Lascia perdere.", "src": "I got places to be. Forget it."},
{"key": "data.voice.nyc.leaving.1", "text": "Incredibile. Me ne vado.", "src": "Unbelievable. I'm outta here."},
{"key": "data.voice.nyc.leaving.2", "text": "Yo, è un bar o una sala d'attesa?", "src": "Yo, is this a bar or a waiting room?"},
{"key": "data.voice.nyc.order.0", "text": "Yo, per me {drink}.", "src": "Yo, lemme get a {drink}."},
{"key": "data.voice.nyc.order.1", "text": "{drink}. E vado di fretta.", "src": "{drink}. And I'm in a hurry."},
{"key": "data.voice.nyc.order.2", "text": "{drink}, chief. Veloce.", "src": "Gimme a {drink}, chief."},
{"key": "data.voice.nyc.order.3", "text": "{drink}. Senza fare cose strane.", "src": "{drink}. Don't make it weird."},
{"key": "data.voice.nyc.perfect.0", "text": "Adesso sì che ci siamo!", "src": "Now we're talkin'!"},
{"key": "data.voice.nyc.perfect.1", "text": "Questa è roba buona!", "src": "That's the stuff!"},
{"key": "data.voice.nyc.perfect.2", "text": "Oh, eccolo!", "src": "Oh, that's it!"},
{"key": "data.voice.nyc.praise.0", "text": "Okay, sono colpito. Non succede mai.", "src": "Okay, I'm impressed. That never happens."},
{"key": "data.voice.nyc.praise.1", "text": "Te lo dico io, questo è un drink.", "src": "Lemme tell ya, that's a drink."},
{"key": "data.voice.nyc.praise.2", "text": "Dovresti farlo pagare di più. Non farlo.", "src": "You should charge more for this. Don't."},
{"key": "data.voice.nyc.sip.0", "text": "Senti, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.nyc.sip.1", "text": "Io dico solo: {advice_l}", "src": "I'm just sayin', {advice_l}"},
{"key": "data.voice.nyc.sip.2", "text": "Non male, ma {advice_l}", "src": "Not bad, but {advice_l}"},
{"key": "data.voice.nyc.wrong.0", "text": "E questo che cos'è?", "src": "What is this?"},
{"key": "data.voice.nyc.wrong.1", "text": "Fuhgeddaboudit. No.", "src": "Fuhgeddaboudit."},
{"key": "data.voice.nyc.wrong.2", "text": "Quello sbagliato, pal.", "src": "Wrong one, pal."},
{"key": "data.voice.surfer.another.0", "text": "Un altro, dude!", "src": "One more, dude!"},
{"key": "data.voice.surfer.another.1", "text": "Ancora, ancora!", "src": "Again, again!"},
{"key": "data.voice.surfer.another.2", "text": "Avanti così, onda dopo onda!", "src": "Keep 'em rolling!"},
{"key": "data.voice.surfer.close.0", "text": "Cool, cool.", "src": "Cool, cool."},
{"key": "data.voice.surfer.close.1", "text": "Sì, ci sta.", "src": "Yeah, that works."},
{"key": "data.voice.surfer.close.2", "text": "Niente male, dai.", "src": "Nice enough."},
{"key": "data.voice.surfer.kicked.0", "text": "Pesante, dude.", "src": "Harsh, dude."},
{"key": "data.voice.surfer.kicked.1", "text": "Okay… che vibe.", "src": "Okay… that's a vibe."},
{"key": "data.voice.surfer.kicked.2", "text": "Wow. Per niente chill.", "src": "Wow. Not chill."},
{"key": "data.voice.surfer.leaving.0", "text": "Dude, sono qui da una vita.", "src": "Dude, I've been here forever."},
{"key": "data.voice.surfer.leaving.1", "text": "Non è cool. Io vado.", "src": "Not cool. I'm out."},
{"key": "data.voice.surfer.leaving.2", "text": "Sì, no. Me la filo.", "src": "Yeah, no. Bailing."},
{"key": "data.voice.surfer.order.0", "text": "Dude, {drink}.", "src": "Dude, a {drink}."},
{"key": "data.voice.surfer.order.1", "text": "Posso avere, tipo… {drink}?", "src": "Can I get, like, a {drink}?"},
{"key": "data.voice.surfer.order.2", "text": "{drink}, per favore. Chill, nessuna fretta.", "src": "{drink}, please. Chill, no rush."},
{"key": "data.voice.surfer.order.3", "text": "Sì, {drink} suona epico.", "src": "Yeah, a {drink} sounds epic."},
{"key": "data.voice.surfer.perfect.0", "text": "Dude. Sì.", "src": "Dude. Yes."},
{"key": "data.voice.surfer.perfect.1", "text": "Stoked!", "src": "Stoked!"},
{"key": "data.voice.surfer.perfect.2", "text": "Troppo buono!", "src": "So good!"},
{"key": "data.voice.surfer.praise.0", "text": "Okay, è davvero perfetto. Respect.", "src": "Okay, that's actually perfect. Respect."},
{"key": "data.voice.surfer.praise.1", "text": "Dude. Non scherzo. Pazzesco.", "src": "Dude. I'm not even kidding. Amazing."},
{"key": "data.voice.surfer.praise.2", "text": "Gnarly. In senso buono.", "src": "Gnarly. In a good way."},
{"key": "data.voice.surfer.sip.0", "text": "Dude, {advice_l}", "src": "Dude, {advice_l}"},
