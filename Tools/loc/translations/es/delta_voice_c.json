{"strings": [
{"key": "data.voice.aussie.another.0", "text": "¡Lo mismo otra vez, mate!", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "¡Una más, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "¡Otra, legend!", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "Sí, righto.", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "No está mal, mate.", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "Me sirve.", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "¿Vas en serio, mate?", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto. Me parece justo.", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Nah, eso es muy duro.", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto, ya he esperado bastante.", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Nah, paso de esto. Me voy.", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "Cheers por nada, mate.", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "{drink}, mate.", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink}, por favor.", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "Me pido esto: {drink}.", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "{drink}, cheers.", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "¡Ripper!", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "¡Too easy!", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "¡De lujo!", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "Bloody ripper, mate. Cheers.", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "Too easy. Sabes lo que haces.", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "La mejor de la noche, en serio.", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "Mira, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "No dramas, pero {advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Nah, mate.", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "No es mío, perdona.", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "Esta no es, mate.", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "¡Otra ronda!", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "¡Lo mismo otra vez!", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "¡Venga, otra!", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "Gracias.", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "Me vale.", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "Casi, casi.", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "¿En serio? Vale.", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "Te estás equivocando.", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "Lo que tú digas. Quédate con tu bar.", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "Déjalo. Me he cansado de esperar.", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "¿Aquí no trabaja nadie esta noche?", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "Nada. Me voy a tomar algo a otro sitio.", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink}, por favor.", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "Para mí, {drink}.", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "{drink}, cuando puedas.", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "Que sea {drink}.", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "¡Perfecto!", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "¡Esa es!", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "¡Clavado!", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "No le cambiaría nada.", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "Esto sí es una copa.", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "Quien te enseñó, dale las gracias.", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "Mmm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice} Ahí lo dejo.", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "¿Sinceramente? {advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "No es lo que he pedido.", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "Esta no es.", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "Eso no es mío.", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "¡Encore, por favor!", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "¡Otra más, oui!", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "¡Otra vez, merci!", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ça va.", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "Está bien.", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon, vale.", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "¿Quoi? ¿En serio?", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Bon. Au revoir.", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule, vamos.", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non. Ya he esperado bastante.", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis. Me voy.", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "Au revoir, entonces.", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "{drink}, s'il vous plaît.", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "{drink}, por favor.", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "{drink}, merci.", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "Para mí: {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "¡Parfait!", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "¡Voilà, perfecto!", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "¡Magnifique!", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait. No tengo ni una pega.", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voilà. Aquí alguien sabe servir.", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique. De verdad.", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Écoute, {advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon, {advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors, {advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non.", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "Esto no es.", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon, te has equivocado.", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "¡Mou ippai!", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "¡Una más, kanpai!", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "¡Otra, onegai!", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Hai, vale.", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa.", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "No está mal, ne.", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "¡¿Eh?! ¿En serio?", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi. Vale, me voy.", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta. Sayonara.", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen, no puedo esperar más.", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii. Me voy.", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai. Adiós.", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen, {drink}.", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "{drink}, onegai.", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink}, por favor. Arigatou.", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto… {drink}.", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "¡Oishii!", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "¡Sugoi, perfecto!", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "¡Kanpai!", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii. De verdad, esta es la buena.", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "Sugoi. Eres un pro, ne.", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "Kanpai. Esto es perfecto.", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "Etto, {advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "Ne, {advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "Sumimasen, pero {advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "Chotto… no.", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "¿Eh? Esto no.", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "Chigau, perdón.", "src": "Chigau, sorry."},
{"key": "data.voice.midwest.another.0", "text": "¡Otra, por favor!", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "¡Una más, gracias!", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "¡Lo mismo otra vez, ope!", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "Oh, está bien.", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "Claro, gracias.", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "Nada mal, la verdad.", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "Oh. Bueno. Pues vale.", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "Ope, perdón… ya me voy.", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "Me parece un poco exagerado, pero vale.", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "Oh gosh, de verdad que no puedo esperar más.", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "Bueno, debería irme ya.", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "Lo siento, pero me marcho.", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "¿Podría ser {drink}? Mil gracias.", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "{drink}, si no es molestia.", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "Oh, para mí solo {drink}.", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink}, por favor. Sin prisa.", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "¡Oh, qué rico!", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "¡You betcha!", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "¡Oh jeez, sí!", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "Oh my gosh, está buenísimo.", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "Muy rico. A mi tía le encantaría este sitio.", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "Bueno, esto me ha sentado de maravilla.", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "Oh, {advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "Solo para que lo sepas: {advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "Sin importancia, pero {advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "Ope. Esta no es.", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "Oh, eso no es mío.", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "Perdona, no. Esto no.", "src": "Sorry, no. Not this."},
{"key": "data.voice.polish.another.0", "text": "¡Jeszcze raz!", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "¡Otra, proszę!", "src": "Another, proszę!"},
{"key": "data.voice.polish.another.2", "text": "¡Una más!", "src": "One more!"},
{"key": "data.voice.polish.close.0", "text": "Dobrze.", "src": "Dobrze."},
{"key": "data.voice.polish.close.1", "text": "Vale.", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "Bien, gracias.", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "¿Serio? Vale.", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "Bien. Do widzenia.", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "¿Co? Vale, me voy.", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "Ya está bien. Me marcho.", "src": "Enough. I'm going."},
{"key": "data.voice.polish.leaving.1", "text": "Nie, nie. Demasiado tiempo.", "src": "Nie, nie. Too long."},
{"key": "data.voice.polish.leaving.2", "text": "Do widzenia, pues.", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "{drink}, proszę.", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "{drink}, por favor.", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "{drink}. Gracias.", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "Dobrze, pues {drink}.", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "¡Na zdrowie!", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "¡Świetnie!", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "¡Muy bueno!", "src": "Very good!"},
{"key": "data.voice.polish.praise.0", "text": "Na zdrowie. Esto es una copa de verdad.", "src": "Na zdrowie. This is a real drink."},
{"key": "data.voice.polish.praise.1", "text": "Świetnie. Como en casa.", "src": "Świetnie. Like at home."},
{"key": "data.voice.polish.praise.2", "text": "Dobrze. Muy, muy bueno.", "src": "Dobrze. Very, very good."},
{"key": "data.voice.polish.sip.0", "text": "Dobrze, pero {advice_l}", "src": "Dobrze, but {advice_l}"},
{"key": "data.voice.polish.sip.1", "text": "Escucha, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.polish.sip.2", "text": "Hm, {advice_l}", "src": "Hm, {advice_l}"},
{"key": "data.voice.polish.wrong.0", "text": "Nie. Esta no es.", "src": "Nie. Wrong one."},
{"key": "data.voice.polish.wrong.1", "text": "Esto no es mío.", "src": "This is not mine."},
{"key": "data.voice.polish.wrong.2", "text": "¿Co to jest?", "src": "Co to jest?"},
{"key": "data.voice.turkish.another.0", "text": "¡Bir daha!", "src": "Bir daha!"},
{"key": "data.voice.turkish.another.1", "text": "¡Otra, abi!", "src": "Another, abi!"},
{"key": "data.voice.turkish.another.2", "text": "¡Otra vez, eyvallah!", "src": "Again, eyvallah!"},
{"key": "data.voice.turkish.close.0", "text": "Tamam.", "src": "Tamam."},
{"key": "data.voice.turkish.close.1", "text": "İdare eder.", "src": "İdare eder."},
{"key": "data.voice.turkish.close.2", "text": "Vale, está bien.", "src": "Okay, fine."},
{"key": "data.voice.turkish.kicked.0", "text": "¿Ciddi misin? Vale.", "src": "Ciddi misin? Okay."},
{"key": "data.voice.turkish.kicked.1", "text": "Abi, ¿en serio? Vale.", "src": "Abi, really? Fine."},
{"key": "data.voice.turkish.kicked.2", "text": "Yok, yok. Me voy.", "src": "Yok, yok. I'm going."},
{"key": "data.voice.turkish.leaving.0", "text": "Yok, no espero más.", "src": "Yok, I'm not waiting anymore."},
{"key": "data.voice.turkish.leaving.1", "text": "Abi, ¿aquí no trabaja nadie?", "src": "Abi, is nobody working here?"},
{"key": "data.voice.turkish.leaving.2", "text": "Tamam, hoşça kal.", "src": "Tamam, hoşça kal."},
{"key": "data.voice.turkish.order.0", "text": "Abi, {drink}.", "src": "Abi, a {drink}."},
{"key": "data.voice.turkish.order.1", "text": "{drink}, eyvallah.", "src": "One {drink}, eyvallah."},
{"key": "data.voice.turkish.order.2", "text": "{drink}, canım, cuando puedas.", "src": "{drink}, canım, when you can."},
{"key": "data.voice.turkish.order.3", "text": "Bir {drink}, por favor.", "src": "Bir {drink}, please."},
{"key": "data.voice.turkish.perfect.0", "text": "¡Eyvallah!", "src": "Eyvallah!"},
{"key": "data.voice.turkish.perfect.1", "text": "¡Harika!", "src": "Harika!"},
{"key": "data.voice.turkish.perfect.2", "text": "¡Süper, abi!", "src": "Süper, abi!"},
{"key": "data.voice.turkish.praise.0", "text": "Eyvallah. Así se hace.", "src": "Eyvallah. This is how it's done."},
{"key": "data.voice.turkish.praise.1", "text": "Abi, me quito el sombrero. Harika.", "src": "Abi, my hat is off. Harika."},
{"key": "data.voice.turkish.praise.2", "text": "Tamam, tú sabes tu oficio.", "src": "Tamam, you know your work."},
{"key": "data.voice.turkish.sip.0", "text": "Abi, {advice_l}", "src": "Abi, {advice_l}"},
{"key": "data.voice.turkish.sip.1", "text": "Bak, {advice_l}", "src": "Bak, {advice_l}"},
{"key": "data.voice.turkish.sip.2", "text": "Tamam ama, {advice_l}", "src": "Tamam ama, {advice_l}"},
