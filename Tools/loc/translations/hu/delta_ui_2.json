{"strings": [
{"key": "data.lesson.first_market.say.1", "text": "Vásárolj szűken. Egy új bárban a széles polc csak álló pénz.", "src": "Buy narrow. A wide shelf on a new bar is just money standing still."},
{"key": "data.lesson.first_night.say.0", "text": "Nyolc üveg és egy hordó. Technikailag ez egy bár.", "src": "Eight bottles and a keg. That is a bar, technically."},
{"key": "data.lesson.first_night.say.1", "text": "Előbb nézd meg az igazolványt, csak aztán tölts — abból tudod, miért jöttek.", "src": "Read them before you pour — the licence says what they came for."},
{"key": "data.lesson.red_night.say.0", "text": "A kassza nem fedezi a bérleti díjat. Egyszer minden bárral megesik.", "src": "The till is under the rent. It happens to every room once."},
{"key": "data.lesson.red_night.say.1", "text": "Kétszer már szokás. Háromszor egy másik bár, a te neveddel a cégéren.", "src": "Twice is a habit. Three times is a different bar with your name on it."},
{"key": "data.lesson.two_spirits.say.0", "text": "Két tömény egy shakerben magától nem lesz ital.", "src": "Two spirits in one tin do not become a drink on their own."},
{"key": "data.lesson.two_spirits.say.1", "text": "Rázd vagy keverd. A könyvben benne van, melyik.", "src": "Shake it or stir it. The book says which."},
{"key": "data.story.ece_1.ask.0", "text": "Az ajtó zárva. Tölts nekem valamit abból, ami tényleg van.", "src": "Door is shut. Pour me one of whatever we actually have."},
{"key": "data.story.ece_1.ask.1", "text": "A tulaj első estéje. Valahol ez szabály.", "src": "Owner's first night. It is a rule somewhere."},
{"key": "data.story.ece_1.declined.0", "text": "Nemet mondasz a pultosnak. Merész.", "src": "You are turning down the bartender. Bold."},
{"key": "data.story.ece_1.nudge.0", "text": "Bármi jó arról a polcról. Nem én vagyok a nehéz eset.", "src": "Anything on that shelf. I am not the difficult one."},
{"key": "data.story.ece_1.served_right.0", "text": "Nem rossz egy helytől, ami múlt héten még nem is létezett.", "src": "Not bad for a room that did not exist last week."},
{"key": "data.story.ece_1.served_right.1", "text": "Akik utánam jönnek, a másodperceidet is számolják. Én nem.", "src": "The ones who come after me will count your seconds. I do not."},
{"key": "data.story.ece_1.served_wrong.0", "text": "Nem ezt kértem, pedig én vagyok a könnyű eset.", "src": "That is not what I asked for, and I am the easy one."},
{"key": "hud.closed.banner", "text": "A BÁR BEZÁRT\nhárom nap mínuszban — próbáld újra: ÚJ JÁTÉK", "src": "THE BAR IS CLOSED\nthree days losing money — NEW RUN to try again"},
