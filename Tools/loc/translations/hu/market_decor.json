  {"key": "decor.fit.bar.identity", "text": "ÚJ PULTLAP", "src": "RESURFACE THE BAR"},
  {"key": "decor.fit.bar.meta_line", "text": "A vendégtér · fokozat: {rung}/{max}", "src": "The room · rung {rung} of {max}"},
  {"key": "decor.fit.bar.name", "text": "Új pultlap", "src": "Resurface the Bar"},
