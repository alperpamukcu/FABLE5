{"strings": [
{"key": "data.voice.aussie.another.0", "text": "Ugyanezt még egyszer, mate!", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "Még egyet, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "Jöhet a következő, legend!", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "Yeah, righto, jó.", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "Nem rossz, mate.", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "Megteszi.", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "Komolyan, mate?", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto. Hát, legyen.", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Nah, ez durva.", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto, eleget vártam.", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Nah, hagyjuk. Én leléptem.", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "Kösz a semmit, mate.", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "Egy {drink}, mate.", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink}, légyszi.", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "Nekem egy {drink} jöhet.", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "Egy {drink}, cheers.", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "Ripper, ez az!", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "Too easy, király!", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "Átkozottul jó!", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "Ez aztán ripper, mate. Cheers.", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "Too easy. Érted a dolgod.", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "Őszintén, ma este ez a legjobb.", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Figyu, mate: {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "Nézd, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "No dramas, de {advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Nah, mate, nem ez.", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "Nem az enyém, bocs.", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "Rossz ital, mate.", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "Még egy kört!", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "Ugyanezt még egyszer!", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "Csak jöjjenek!", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "Kösz.", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "Megteszi.", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "Majdnem jó.", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "Komolyan? Jól van.", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "Ezt még megbánod.", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "Mindegy. Tartsd meg a bárodat.", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "Hagyjuk. Elegem van a várásból.", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "Dolgozik itt ma valaki?", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "Jó. Majd máshol iszom.", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink}, légyszi.", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "Nekem egy {drink} lesz.", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "Egy {drink}, ha lesz egy perced.", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "Legyen egy {drink}.", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "Tökéletes!", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "Ez az!", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "Telitalálat!", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "Semmin nem változtatnék.", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "Na, ez már ital.", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "Aki tanított, annak mondj köszönetet.", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "Hmm, hát. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice} Csak mondom.", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "Őszintén? {advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "Nem ezt kértem.", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "Ez rossz ital.", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "Ez nem az enyém.", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "Encore, még egyet!", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "Még egyet, oui!", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "Még egyszer, merci!", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ca va, jó lesz.", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "Ez így jó.", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon, rendben.", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "Quoi? Komolyan?", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Hát bon. Au revoir.", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule. Nevetséges.", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non. Eleget vártam.", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis. Megyek.", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "Akkor au revoir.", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "Egy {drink}, s'il vous plait.", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "{drink}, legyen szíves.", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "Egy {drink} lesz, merci.", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "Nekem egy {drink} jöhet.", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "Parfait, ez az!", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "Voila, tökéletes!", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "Magnifique, csodás!", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait. Nincs semmi megjegyzésem.", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voila. Itt valaki tud tölteni.", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique. Őszintén.", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Ecoute, figyelj: {advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon, szóval {advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors, csak {advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non. Nem ez.", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "Ez nem az.", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon, ez rossz.", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "Mou ippai, még egyet!", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "Még egyet, kanpai!", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "Még egyszer, onegai!", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Hai, rendben.", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa, elmegy.", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "Nem rossz, hai.", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "Eh?! Komolyan?", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi. Jó, megyek.", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta. Akkor sayonara.", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen, nem tudok tovább várni.", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii. Megyek.", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai. Viszontlátásra.", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen, egy {drink}.", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "Egy {drink}, onegai.", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink}, legyen szíves. Arigatou.", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto… egy {drink}.", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "Oishii, finom!", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "Sugoi, tökéletes!", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "Kanpai! Egészség!", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii. Tényleg, ez az igazi.", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "Sugoi. Te aztán profi vagy.", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "Kanpai. Ez tökéletes.", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "Etto, szerintem {advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "Ano ne, {advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "Sumimasen, de {advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "Chotto… nem.", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "Eh? Nem ezt.", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "Chigau, bocsánat.", "src": "Chigau, sorry."},
{"key": "data.voice.midwest.another.0", "text": "Még egyet, ha lehet!", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "Még egyet, köszi!", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "Ope, ugyanezt még egyszer!", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "Ó, ez így jó.", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "Persze, köszönöm.", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "Egyáltalán nem rossz.", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "Ó. Hát. Akkor jó.", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "Ope, bocsánat… megyek.", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "Ez kicsit sok, de oké.", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "Oh gosh, tényleg nem tudok tovább várni.", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "Hát, nekem mennem kéne.", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "Bocsánat, de én indulok.", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "Jöhetne egy {drink}? Nagyon köszi.", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "Egy {drink}, ha nem nagy gond.", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "Ó, nekem csak egy {drink}.", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink}, legyen szíves. Ráér.", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "Ó, ez nagyon nice!", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "You betcha, ez az!", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "Oh jeez, igen!", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "Oh my gosh, ez egyszerűen csodás.", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "Nagyon nice. A nagynéném imádná ezt a helyet.", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "Hát, ez most nagyon jólesett.", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "Ó, csak {advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "Csak hogy tudd: {advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "Nem nagy ügy, de {advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "Ope. Nem ez az.", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "Ó, ez nem az enyém.", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "Bocsi, nem. Nem ezt.", "src": "Sorry, no. Not this."},
{"key": "data.voice.polish.another.0", "text": "Jeszcze raz, még egyet!", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "Még egyet, proszę!", "src": "Another, proszę!"},
{"key": "data.voice.polish.another.2", "text": "Még egy pohárral!", "src": "One more!"},
{"key": "data.voice.polish.close.0", "text": "Dobrze, jó lesz.", "src": "Dobrze."},
{"key": "data.voice.polish.close.1", "text": "Oké.", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "Rendben, köszönöm.", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "Serio? Oké.", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "Jól van. Do widzenia.", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "Co? Jó, megyek.", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "Elég. Megyek.", "src": "Enough. I'm going."},
{"key": "data.voice.polish.leaving.1", "text": "Nie, nie. Ez túl sokáig tart.", "src": "Nie, nie. Too long."},
{"key": "data.voice.polish.leaving.2", "text": "Hát do widzenia.", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "Egy {drink}, proszę.", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "{drink}, legyen szíves.", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "Egy {drink}. Köszönöm.", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "Dobrze, egy {drink}.", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "Na zdrowie, egészség!", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "Świetnie, remek!", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "Nagyon jó!", "src": "Very good!"},
{"key": "data.voice.polish.praise.0", "text": "Na zdrowie. Ez igazi ital.", "src": "Na zdrowie. This is a real drink."},
{"key": "data.voice.polish.praise.1", "text": "Świetnie. Mint otthon.", "src": "Świetnie. Like at home."},
{"key": "data.voice.polish.praise.2", "text": "Dobrze. Nagyon-nagyon jó.", "src": "Dobrze. Very, very good."},
{"key": "data.voice.polish.sip.0", "text": "Dobrze, de {advice_l}", "src": "Dobrze, but {advice_l}"},
{"key": "data.voice.polish.sip.1", "text": "Figyelj, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.polish.sip.2", "text": "Hm, szerintem {advice_l}", "src": "Hm, {advice_l}"},
{"key": "data.voice.polish.wrong.0", "text": "Nie. Ez nem az.", "src": "Nie. Wrong one."},
{"key": "data.voice.polish.wrong.1", "text": "Ez nem az enyém.", "src": "This is not mine."},
{"key": "data.voice.polish.wrong.2", "text": "Co to jest? Mi ez?", "src": "Co to jest?"},
{"key": "data.voice.turkish.another.0", "text": "Bir daha, még egyet!", "src": "Bir daha!"},
{"key": "data.voice.turkish.another.1", "text": "Még egyet, abi!", "src": "Another, abi!"},
{"key": "data.voice.turkish.another.2", "text": "Még egyszer, eyvallah!", "src": "Again, eyvallah!"},
{"key": "data.voice.turkish.close.0", "text": "Tamam, jó lesz.", "src": "Tamam."},
{"key": "data.voice.turkish.close.1", "text": "İdare eder, elmegy.", "src": "İdare eder."},
{"key": "data.voice.turkish.close.2", "text": "Oké, rendben.", "src": "Okay, fine."},
{"key": "data.voice.turkish.kicked.0", "text": "Ciddi misin? Oké.", "src": "Ciddi misin? Okay."},
{"key": "data.voice.turkish.kicked.1", "text": "Abi, komolyan? Jól van.", "src": "Abi, really? Fine."},
{"key": "data.voice.turkish.kicked.2", "text": "Yok, yok. Megyek.", "src": "Yok, yok. I'm going."},
{"key": "data.voice.turkish.leaving.0", "text": "Yok, én nem várok tovább.", "src": "Yok, I'm not waiting anymore."},
{"key": "data.voice.turkish.leaving.1", "text": "Abi, itt senki nem dolgozik?", "src": "Abi, is nobody working here?"},
{"key": "data.voice.turkish.leaving.2", "text": "Tamam, akkor hoşça kal.", "src": "Tamam, hoşça kal."},
{"key": "data.voice.turkish.order.0", "text": "Abi, egy {drink}.", "src": "Abi, a {drink}."},
{"key": "data.voice.turkish.order.1", "text": "Egy {drink}, eyvallah.", "src": "One {drink}, eyvallah."},
{"key": "data.voice.turkish.order.2", "text": "{drink}, canım, ha ráérsz.", "src": "{drink}, canım, when you can."},
{"key": "data.voice.turkish.order.3", "text": "Bir {drink}, légyszi.", "src": "Bir {drink}, please."},
{"key": "data.voice.turkish.perfect.0", "text": "Eyvallah, ez az!", "src": "Eyvallah!"},
{"key": "data.voice.turkish.perfect.1", "text": "Harika, csodás!", "src": "Harika!"},
{"key": "data.voice.turkish.perfect.2", "text": "Szuper, abi!", "src": "Süper, abi!"},
{"key": "data.voice.turkish.praise.0", "text": "Eyvallah. Így kell ezt csinálni.", "src": "Eyvallah. This is how it's done."},
