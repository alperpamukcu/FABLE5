{"strings": [
{"key": "data.voice.african.another.0", "text": "Hozz még egyet!", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "Még egyet, abeg!", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "Még egyszer, barátom!", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "Rendben van ez.", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "Semmi gond, no wahala.", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "Oké, köszönöm.", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "Ah ah! Komolyan?", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala. Megyek.", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "Barátom, ez nem szép dolog.", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah ah. Eleget vártam.", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala. Akkor én indulok.", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "Mennem kell, barátom.", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "Egy {drink}, legyen szíves.", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "{drink} lesz, barátom.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Nekem egy {drink} jöhet.", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "Abeg, egy {drink}!", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "Ah, finom!", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "Korrekt!", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "Ez nagyon jó!", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, ez így korrekt. Köszönöm.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "Semmi wahala. Nagyon szép.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "Barátom, te aztán érted a dolgod.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "Barátom, {advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg, figyelj: {advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "Jó ez, de {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah, nem.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "Nem ez az.", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "Barátom, ez nem az enyém.", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "Még egy ugyanilyet, mate!", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "Még egyet, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "Na jó, még egy kört!", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "Nem rossz.", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Ta, ez megteszi.", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "Rendben, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Bájos. Egyszerűen bájos.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "Right. Hát. Kösz a semmit.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "Ugye csak viccelsz?", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Right. Eleget vártam.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "Hagyjuk. Én leléptem.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Ez elég gyenge. Bye.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "Egy {drink}, mate, ha ráérsz.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, legyen szíves. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "Na jó, legyen egy {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "Nekem egy {drink}, ta.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "Remek, lovely!", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "Kösz, mate!", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "Ez igazán jó!", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Blimey. Ez tényleg lovely.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Ezt rendesen megcsináltad.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Ez átkozottul jó.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Figyelj, mate: {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "Csak egy apróság: {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Nézd, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Ez kicsit mellément.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Öhm, nem az enyém.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "Nem ezt kértem, mate.", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "Még egyet, yaar!", "src": "One more, yaar!"},
{"key": "data.voice.desi.another.1", "text": "Aur ek, még egyet!", "src": "Aur ek!"},
{"key": "data.voice.desi.another.2", "text": "Még egyszer, kérlek!", "src": "Again, please!"},
{"key": "data.voice.desi.close.0", "text": "Theek hai, jó lesz.", "src": "Theek hai."},
{"key": "data.voice.desi.close.1", "text": "Rendben van, na.", "src": "It is okay, na."},
{"key": "data.voice.desi.close.2", "text": "Chalega, elmegy.", "src": "Chalega."},
{"key": "data.voice.desi.kicked.0", "text": "Kya? Komolyan?", "src": "Kya? Seriously?"},
{"key": "data.voice.desi.kicked.1", "text": "Arre. Jó, rendben.", "src": "Arre. Okay, fine."},
{"key": "data.voice.desi.kicked.2", "text": "Chalo. Megyek.", "src": "Chalo. I go."},
{"key": "data.voice.desi.leaving.0", "text": "Arre yaar. Ez túl hosszú.", "src": "Arre yaar. Too long."},
{"key": "data.voice.desi.leaving.1", "text": "Chalo, én indulok.", "src": "Chalo, I am going."},
{"key": "data.voice.desi.leaving.2", "text": "Bas. Elég volt.", "src": "Bas. Enough."},
{"key": "data.voice.desi.order.0", "text": "Egy {drink}, kérlek.", "src": "One {drink}, please."},
{"key": "data.voice.desi.order.1", "text": "Egy {drink}, yaar.", "src": "A {drink}, yaar."},
{"key": "data.voice.desi.order.2", "text": "Nekem egy {drink} lesz.", "src": "I will take a {drink}."},
{"key": "data.voice.desi.order.3", "text": "{drink} jöhet, na?", "src": "{drink}, na?"},
{"key": "data.voice.desi.perfect.0", "text": "Wah, tökéletes!", "src": "Wah, perfect!"},
{"key": "data.voice.desi.perfect.1", "text": "Ekdum elsőosztályú!", "src": "Ekdum first class!"},
{"key": "data.voice.desi.perfect.2", "text": "Bahut badhiya, szuper!", "src": "Bahut badhiya!"},
{"key": "data.voice.desi.praise.0", "text": "Wah. Ekdum tökéletes, yaar.", "src": "Wah. Ekdum perfect, yaar."},
{"key": "data.voice.desi.praise.1", "text": "Bahut badhiya. Komolyan.", "src": "Bahut badhiya. Really."},
{"key": "data.voice.desi.praise.2", "text": "Első osztály. Én visszajövök.", "src": "First class. I am coming back."},
{"key": "data.voice.desi.sip.0", "text": "Arre, figyelj: {advice_l}", "src": "Arre, {advice_l}"},
{"key": "data.voice.desi.sip.1", "text": "Yaar, szerintem {advice_l}", "src": "Yaar, {advice_l}"},
{"key": "data.voice.desi.sip.2", "text": "Theek hai, de {advice_l}", "src": "Theek hai, but {advice_l}"},
{"key": "data.voice.desi.wrong.0", "text": "Arre, nem.", "src": "Arre, no."},
{"key": "data.voice.desi.wrong.1", "text": "Ez nem az enyém.", "src": "This is not mine."},
{"key": "data.voice.desi.wrong.2", "text": "Nahi, ez nem az.", "src": "Nahi, wrong one."},
{"key": "data.voice.german.another.0", "text": "Noch eins, még egyet!", "src": "Noch eins!"},
{"key": "data.voice.german.another.1", "text": "Még egyet, bitte!", "src": "Another, bitte!"},
{"key": "data.voice.german.another.2", "text": "Még egyszer, kérem!", "src": "Again, please!"},
{"key": "data.voice.german.close.0", "text": "Ja, rendben.", "src": "Ja, okay."},
{"key": "data.voice.german.close.1", "text": "Elfogadható.", "src": "Acceptable."},
{"key": "data.voice.german.close.2", "text": "Ez így megfelel.", "src": "It is fine."},
{"key": "data.voice.german.kicked.0", "text": "Ez abszurd.", "src": "This is absurd."},
{"key": "data.voice.german.kicked.1", "text": "Jó. Ide nem jövök vissza.", "src": "Fine. I will not return."},
{"key": "data.voice.german.kicked.2", "text": "Ja, ja. Megyek már.", "src": "Ja, ja. I am going."},
{"key": "data.voice.german.leaving.0", "text": "Ez elfogadhatatlan. Távozom.", "src": "This is not acceptable. I am leaving."},
{"key": "data.voice.german.leaving.1", "text": "Nein. Eleget vártam.", "src": "Nein. I have waited enough."},
{"key": "data.voice.german.leaving.2", "text": "Unglaublich. Viszontlátásra.", "src": "Unglaublich. Goodbye."},
{"key": "data.voice.german.order.0", "text": "Egy {drink}, kérem. Pontosan elkészítve.", "src": "A {drink}, please. Correctly made."},
{"key": "data.voice.german.order.1", "text": "{drink}. Köszönöm.", "src": "{drink}. Thank you."},
{"key": "data.voice.german.order.2", "text": "Egy {drink}, bitte.", "src": "One {drink}, bitte."},
{"key": "data.voice.german.order.3", "text": "Nekem egy {drink} lenne jó.", "src": "I would like a {drink}."},
{"key": "data.voice.german.perfect.0", "text": "Genau így!", "src": "Genau!"},
{"key": "data.voice.german.perfect.1", "text": "Sehr gut, tényleg!", "src": "Sehr gut!"},
{"key": "data.voice.german.perfect.2", "text": "Hát ez wunderbar!", "src": "Wunderbar!"},
{"key": "data.voice.german.praise.0", "text": "Ja. Ez pontosan így jó.", "src": "Ja. This is exactly right."},
{"key": "data.voice.german.praise.1", "text": "Precíz. Tisztelem a precizitást.", "src": "Precise. I respect precision."},
{"key": "data.voice.german.praise.2", "text": "Sehr gut. Nincs mit hozzátenni.", "src": "Sehr gut. No notes."},
{"key": "data.voice.german.sip.0", "text": "Genau, de {advice_l}", "src": "Genau, but {advice_l}"},
{"key": "data.voice.german.sip.1", "text": "Egy megjegyzés: {advice_l}", "src": "One remark: {advice_l}"},
{"key": "data.voice.german.sip.2", "text": "Ja, csak {advice_l}", "src": "Ja, {advice_l}"},
{"key": "data.voice.german.wrong.0", "text": "Nein. Nem ezt.", "src": "Nein. Not this."},
{"key": "data.voice.german.wrong.1", "text": "Ez nem helyes.", "src": "This is incorrect."},
{"key": "data.voice.german.wrong.2", "text": "Ez rossz ital.", "src": "Wrong drink."},
{"key": "data.voice.korean.another.0", "text": "Han jan deo, még egyet!", "src": "Han jan deo!"},
{"key": "data.voice.korean.another.1", "text": "Még egy pohárral!", "src": "One more!"},
{"key": "data.voice.korean.another.2", "text": "Még egyszer, juseyo!", "src": "Again, juseyo!"},
{"key": "data.voice.korean.close.0", "text": "Gwenchana, jó így.", "src": "Gwenchana."},
{"key": "data.voice.korean.close.1", "text": "Rendben van.", "src": "It is okay."},
{"key": "data.voice.korean.close.2", "text": "Nappeuji anha. Nem rossz.", "src": "Nappeuji anha."},
{"key": "data.voice.korean.kicked.0", "text": "Jinjja? Hű.", "src": "Jinjja? Wow."},
{"key": "data.voice.korean.kicked.1", "text": "Aish. Jól van.", "src": "Aish. Fine."},
{"key": "data.voice.korean.kicked.2", "text": "Akkor annyeong.", "src": "Annyeong, then."},
{"key": "data.voice.korean.leaving.0", "text": "Aish. Ez túl sokáig tart.", "src": "Aish. Too long."},
{"key": "data.voice.korean.leaving.1", "text": "Megyek. Annyeong.", "src": "I am going. Annyeong."},
{"key": "data.voice.korean.leaving.2", "text": "Mot chamgesseo. Nem bírom tovább.", "src": "Mot chamgesseo."},
{"key": "data.voice.korean.order.0", "text": "Egy {drink}, juseyo.", "src": "{drink}, juseyo."},
{"key": "data.voice.korean.order.1", "text": "{drink} lesz, köszönöm.", "src": "One {drink}, please."},
{"key": "data.voice.korean.order.2", "text": "Nekem egy {drink}.", "src": "A {drink} for me."},
{"key": "data.voice.korean.order.3", "text": "Egy {drink} kellene.", "src": "I want a {drink}."},
{"key": "data.voice.korean.perfect.0", "text": "Daebak, ez az!", "src": "Daebak!"},
{"key": "data.voice.korean.perfect.1", "text": "Jinjja jó!", "src": "Jinjja good!"},
{"key": "data.voice.korean.perfect.2", "text": "Choego! A legjobb!", "src": "Choego!"},
{"key": "data.voice.korean.praise.0", "text": "Daebak. Jinjja, ez tökéletes.", "src": "Daebak. Jinjja, this is perfect."},
{"key": "data.voice.korean.praise.1", "text": "Choego. Komolyan mondom.", "src": "Choego. I mean it."},
{"key": "data.voice.korean.praise.2", "text": "Hű. Ehhez nagyon értesz.", "src": "Wow. You are good at this."},
{"key": "data.voice.korean.sip.0", "text": "Jamkkanman, csak {advice_l}", "src": "Jamkkanman, {advice_l}"},
{"key": "data.voice.korean.sip.1", "text": "Öhm, {advice_l}", "src": "Um, {advice_l}"},
{"key": "data.voice.korean.sip.2", "text": "Gwenchana, de {advice_l}", "src": "Gwenchana, but {advice_l}"},
{"key": "data.voice.korean.wrong.0", "text": "Aniyo, nem.", "src": "Aniyo, no."},
{"key": "data.voice.korean.wrong.1", "text": "Ez nem jó.", "src": "This is wrong."},
{"key": "data.voice.korean.wrong.2", "text": "Eh? Nem az enyém.", "src": "Eh? Not mine."},
{"key": "data.voice.nordic.another.0", "text": "Még egyet. Skål!", "src": "Another. Skål!"},
{"key": "data.voice.nordic.another.1", "text": "Még egy.", "src": "One more."},
{"key": "data.voice.nordic.another.2", "text": "Még egyszer, kérem.", "src": "Again, please."},
{"key": "data.voice.nordic.close.0", "text": "Jó.", "src": "Fine."},
{"key": "data.voice.nordic.close.1", "text": "Rendben van.", "src": "It's okay."},
{"key": "data.voice.nordic.close.2", "text": "Elég jó.", "src": "Good enough."},
{"key": "data.voice.nordic.kicked.0", "text": "Oké. Furcsa, de oké.", "src": "Okay. Strange, but okay."},
{"key": "data.voice.nordic.kicked.1", "text": "Hát jó.", "src": "Fine."},
{"key": "data.voice.nordic.kicked.2", "text": "Hm. Akkor viszlát.", "src": "Hm. Goodbye then."},
{"key": "data.voice.nordic.leaving.0", "text": "Megyek. Semmi baj.", "src": "I'll go. It's fine."},
{"key": "data.voice.nordic.leaving.1", "text": "Túl sokáig tart. Viszlát.", "src": "Too long. Goodbye."},
{"key": "data.voice.nordic.leaving.2", "text": "Nem. Én elmegyek.", "src": "No. I'm leaving."},
{"key": "data.voice.nordic.order.0", "text": "Egy {drink}. Köszönöm.", "src": "A {drink}. Thanks."},
{"key": "data.voice.nordic.order.1", "text": "{drink}, legyen szíves.", "src": "{drink}, please."},
{"key": "data.voice.nordic.order.2", "text": "Egy {drink}. Nem sürgős.", "src": "One {drink}. No rush."},
{"key": "data.voice.nordic.order.3", "text": "Nekem: {drink}.", "src": "I'll have the {drink}."},
{"key": "data.voice.nordic.perfect.0", "text": "Skål, ez jó!", "src": "Skål!"},
{"key": "data.voice.nordic.perfect.1", "text": "Nagyon jó.", "src": "Very good."},
{"key": "data.voice.nordic.perfect.2", "text": "Igen. Jó.", "src": "Yes. Good."},
{"key": "data.voice.nordic.praise.0", "text": "Ez nagyon jó. Ilyet nem mondok gyakran.", "src": "This is very good. I don't say that."},
{"key": "data.voice.nordic.praise.1", "text": "Skål. Rendesen megcsinálva.", "src": "Skål. Properly done."},
{"key": "data.voice.nordic.praise.2", "text": "Jó. Tényleg jó.", "src": "Good. Really good."},
{"key": "data.voice.nordic.sip.0", "text": "Nos. {advice}", "src": "Well. {advice}"},
{"key": "data.voice.nordic.sip.1", "text": "Hm, hát. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.nordic.sip.2", "text": "Jó, de {advice_l}", "src": "Fine, but {advice_l}"},
{"key": "data.voice.nordic.wrong.0", "text": "Nem. Ez nem az.", "src": "No. Wrong one."},
{"key": "data.voice.nordic.wrong.1", "text": "Nem ezt kértem.", "src": "This is not it."},
{"key": "data.voice.nordic.wrong.2", "text": "Hm. Nem az enyém.", "src": "Hm. Not mine."},
{"key": "data.voice.southern.another.0", "text": "Tölts még egyet!", "src": "Pour me another!"},
{"key": "data.voice.southern.another.1", "text": "Még egyet, sugar!", "src": "One more, sugar!"},
{"key": "data.voice.southern.another.2", "text": "Csak jöjjenek, darlin'!", "src": "Keep 'em comin'!"},
{"key": "data.voice.southern.close.0", "text": "Ez így rendben.", "src": "That's alright."},
{"key": "data.voice.southern.close.1", "text": "Hát, legyen.", "src": "Fair enough."},
{"key": "data.voice.southern.close.2", "text": "Well, megteszi.", "src": "Well, it'll do."},
{"key": "data.voice.southern.kicked.0", "text": "Well, ez aztán goromba.", "src": "Well, that's just rude."},
{"key": "data.voice.southern.kicked.1", "text": "Hát jó. Szép estét, y'all.", "src": "Alright then. Have a good one."},
{"key": "data.voice.southern.kicked.2", "text": "Na de várjunk… jól van.", "src": "Now hold on… fine."},
{"key": "data.voice.southern.leaving.0", "text": "Well, nincs egész éjszakám.", "src": "Well, I ain't got all night."},
{"key": "data.voice.southern.leaving.1", "text": "Azt hiszem, máshol iszom.", "src": "Reckon I'll drink elsewhere."},
{"key": "data.voice.southern.leaving.2", "text": "Y'all aztán ráértek, mi?", "src": "Y'all take your sweet time, don't you."},
{"key": "data.voice.southern.order.0", "text": "Well now, egy {drink} jólesne.", "src": "Well now, a {drink} would suit me."},
{"key": "data.voice.southern.order.1", "text": "{drink}, darlin', ha lennél szíves.", "src": "{drink}, darlin', if you please."},
{"key": "data.voice.southern.order.2", "text": "Azt hiszem, egy {drink} lesz.", "src": "Reckon I'll have a {drink}."},
{"key": "data.voice.southern.order.3", "text": "Egy {drink}, sugar.", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "Na, ez aztán finom!", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "Te jó ég, de jó!", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "Hot dang, ez igen!", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "Na, ilyet. Ez aztán rendes ital.", "src": "Well, I'll be. That's a proper drink."},
{"key": "data.voice.southern.praise.1", "text": "Darlin', neked tehetséged van.", "src": "Darlin', you got a gift."},
