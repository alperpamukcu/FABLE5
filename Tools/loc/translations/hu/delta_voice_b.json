{"strings": [
{"key": "data.voice.arabic.another.0", "text": "Kaman wahad, még egyet!", "src": "Kaman wahad!"},
{"key": "data.voice.arabic.another.1", "text": "Még egyet, yalla!", "src": "One more, yalla!"},
{"key": "data.voice.arabic.another.2", "text": "Még egyszer, habibi!", "src": "Again, habibi!"},
{"key": "data.voice.arabic.close.0", "text": "Maashi, jó lesz.", "src": "Maashi."},
{"key": "data.voice.arabic.close.1", "text": "Rendben van ez.", "src": "It is okay."},
{"key": "data.voice.arabic.close.2", "text": "Tamam, köszönöm.", "src": "Tamam, shukran."},
{"key": "data.voice.arabic.kicked.0", "text": "Shu? Komolyan?", "src": "Shu? Seriously?"},
{"key": "data.voice.arabic.kicked.1", "text": "Khalas. Jól van.", "src": "Khalas. Fine."},
{"key": "data.voice.arabic.kicked.2", "text": "Yalla. Megyek.", "src": "Yalla. I go."},
{"key": "data.voice.arabic.leaving.0", "text": "Khalas. Én megyek.", "src": "Khalas. I am going."},
{"key": "data.voice.arabic.leaving.1", "text": "Yalla, elég a várakozásból.", "src": "Yalla, enough waiting."},
{"key": "data.voice.arabic.leaving.2", "text": "Maa salama, viszlát.", "src": "Maa salama."},
{"key": "data.voice.arabic.order.0", "text": "Egy {drink}, legyen szíves.", "src": "A {drink}, please."},
{"key": "data.voice.arabic.order.1", "text": "Egy {drink}, shukran.", "src": "One {drink}, shukran."},
{"key": "data.voice.arabic.order.2", "text": "Habibi, egy {drink}.", "src": "Habibi, a {drink}."},
{"key": "data.voice.arabic.order.3", "text": "Nekem egy {drink} lesz.", "src": "I will take a {drink}."},
{"key": "data.voice.arabic.perfect.0", "text": "Ya salam, ez az!", "src": "Ya salam!"},
{"key": "data.voice.arabic.perfect.1", "text": "Helu kteer, finom!", "src": "Helu kteer!"},
{"key": "data.voice.arabic.perfect.2", "text": "Tökéletes, habibi!", "src": "Perfect, habibi!"},
{"key": "data.voice.arabic.praise.0", "text": "Ya salam. Ez az igazi, habibi.", "src": "Ya salam. This is the one, habibi."},
{"key": "data.voice.arabic.praise.1", "text": "Helu kteer. Köszönöm szépen.", "src": "Helu kteer. Shukran."},
{"key": "data.voice.arabic.praise.2", "text": "Yalla, te érted a dolgod.", "src": "Yalla, you know your work."},
{"key": "data.voice.arabic.sip.0", "text": "Habibi, figyelj: {advice_l}", "src": "Habibi, {advice_l}"},
{"key": "data.voice.arabic.sip.1", "text": "Shuf, nézd: {advice_l}", "src": "Shuf, {advice_l}"},
{"key": "data.voice.arabic.sip.2", "text": "Tamam, csak {advice_l}", "src": "Tamam, bas {advice_l}"},
{"key": "data.voice.arabic.wrong.0", "text": "La, la. Nem.", "src": "La, la."},
{"key": "data.voice.arabic.wrong.1", "text": "Ez nem az.", "src": "This is not it."},
{"key": "data.voice.arabic.wrong.2", "text": "Shu hada? Mi ez?", "src": "Shu hada?"},
{"key": "data.voice.chinese.another.0", "text": "Zai lai yi bei, még egyet!", "src": "Zai lai yi bei!"},
{"key": "data.voice.chinese.another.1", "text": "Még egy pohárral!", "src": "One more, ah!"},
{"key": "data.voice.chinese.another.2", "text": "Még egyszer, kérem!", "src": "Again, please!"},
{"key": "data.voice.chinese.close.0", "text": "Hai keyi, elmegy.", "src": "Hai keyi."},
{"key": "data.voice.chinese.close.1", "text": "Oké, rendben.", "src": "Okay lah."},
{"key": "data.voice.chinese.close.2", "text": "Jó így.", "src": "It is fine."},
{"key": "data.voice.chinese.kicked.0", "text": "Shenme? Tényleg?", "src": "Shenme? Really?"},
{"key": "data.voice.chinese.kicked.1", "text": "Aiya. Jól van.", "src": "Aiya. Fine."},
{"key": "data.voice.chinese.kicked.2", "text": "Hao. Elmegyek.", "src": "Hao. I leave."},
{"key": "data.voice.chinese.leaving.0", "text": "Aiya. Túl sokat vártam.", "src": "Aiya. I waited too long."},
{"key": "data.voice.chinese.leaving.1", "text": "Suan le. Megyek.", "src": "Suan le. I go."},
{"key": "data.voice.chinese.leaving.2", "text": "Akkor zaijian.", "src": "Zaijian, then."},
{"key": "data.voice.chinese.order.0", "text": "{drink}, legyen szíves.", "src": "{drink}, please."},
{"key": "data.voice.chinese.order.1", "text": "Egy {drink}, xiexie.", "src": "One {drink}, xiexie."},
{"key": "data.voice.chinese.order.2", "text": "Nekem egy {drink} lesz.", "src": "I will have a {drink}."},
{"key": "data.voice.chinese.order.3", "text": "Egy {drink} ide, kérem.", "src": "A {drink} for me."},
{"key": "data.voice.chinese.perfect.0", "text": "Hen hao, nagyon jó!", "src": "Hen hao!"},
{"key": "data.voice.chinese.perfect.1", "text": "Tökéletes!", "src": "Perfect, ah!"},
{"key": "data.voice.chinese.perfect.2", "text": "Zhen bang, szuper!", "src": "Zhen bang!"},
{"key": "data.voice.chinese.praise.0", "text": "Zhen bang. Ezért visszajövök.", "src": "Zhen bang. I will come back for this."},
{"key": "data.voice.chinese.praise.1", "text": "Hen hao. Tudod, mit csinálsz.", "src": "Hen hao. You know what you are doing."},
{"key": "data.voice.chinese.praise.2", "text": "Tökéletes. Tényleg.", "src": "Perfect, ah. Really."},
{"key": "data.voice.chinese.sip.0", "text": "Ai, csak {advice_l}", "src": "Ai, {advice_l}"},
{"key": "data.voice.chinese.sip.1", "text": "Figyelj, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.chinese.sip.2", "text": "Hao, de {advice_l}", "src": "Hao, but {advice_l}"},
{"key": "data.voice.chinese.wrong.0", "text": "Bu dui, nem ez.", "src": "Bu dui."},
{"key": "data.voice.chinese.wrong.1", "text": "Aiya, nem.", "src": "Aiya, no."},
{"key": "data.voice.chinese.wrong.2", "text": "Nem ezt kértem.", "src": "Not this one."},
{"key": "data.voice.filipino.another.0", "text": "Isa pa, még egyet!", "src": "Isa pa!"},
{"key": "data.voice.filipino.another.1", "text": "Még egyet, ha!", "src": "One more, ha!"},
{"key": "data.voice.filipino.another.2", "text": "Még egyszer, légyszi!", "src": "Again, please!"},
{"key": "data.voice.filipino.close.0", "text": "Okay lang, jó ez.", "src": "Okay lang."},
{"key": "data.voice.filipino.close.1", "text": "Sige, köszi.", "src": "Sige, thanks."},
{"key": "data.voice.filipino.close.2", "text": "Ay, rendben van.", "src": "Ay, it's fine."},
{"key": "data.voice.filipino.kicked.0", "text": "Ha? Tényleg?", "src": "Ha? Really?"},
{"key": "data.voice.filipino.kicked.1", "text": "Ay. Oké. Szia.", "src": "Ay. Okay. Bye."},
{"key": "data.voice.filipino.kicked.2", "text": "Grabe naman. Ez durva.", "src": "Grabe naman."},
{"key": "data.voice.filipino.leaving.0", "text": "Ay, grabe. Túl sokáig tart. Megyek.", "src": "Ay, grabe. Too long. I'm going."},
{"key": "data.voice.filipino.leaving.1", "text": "Sige na, szia.", "src": "Sige na, bye."},
{"key": "data.voice.filipino.leaving.2", "text": "Naku, ide senki nem jön.", "src": "Naku, no one is coming."},
{"key": "data.voice.filipino.order.0", "text": "Ay, egy {drink}, légyszi.", "src": "Ay, one {drink}, please."},
{"key": "data.voice.filipino.order.1", "text": "Nekem: {drink}. Salamat.", "src": "{drink} for me. Salamat."},
{"key": "data.voice.filipino.order.2", "text": "Jöhet egy {drink}? Köszi, ha.", "src": "Can I have a {drink}? Thanks, ha."},
{"key": "data.voice.filipino.order.3", "text": "Egy {drink}, kuya.", "src": "A {drink}, kuya."},
{"key": "data.voice.filipino.perfect.0", "text": "Ay, sarap! Finom!", "src": "Ay, sarap!"},
{"key": "data.voice.filipino.perfect.1", "text": "Grabe, igen!", "src": "Grabe, yes!"},
{"key": "data.voice.filipino.perfect.2", "text": "Tökéletes, kuya!", "src": "Perfect, kuya!"},
{"key": "data.voice.filipino.praise.0", "text": "Grabe. Ez nagyon jó. Salamat.", "src": "Grabe. That is so good. Salamat."},
{"key": "data.voice.filipino.praise.1", "text": "Ay, sarap. Megmentetted az egész műszakomat.", "src": "Ay, sarap. You made my whole shift."},
{"key": "data.voice.filipino.praise.2", "text": "Sige, ezért visszajövök.", "src": "Sige, I'm coming back for this."},
{"key": "data.voice.filipino.sip.0", "text": "Ay, szerintem {advice_l}", "src": "Ay, {advice_l}"},
{"key": "data.voice.filipino.sip.1", "text": "Sige, de {advice_l}", "src": "Sige, but {advice_l}"},
{"key": "data.voice.filipino.sip.2", "text": "Ha? Figyelj. {advice}", "src": "Ha? {advice}"},
{"key": "data.voice.filipino.wrong.0", "text": "Ay, hindi. Nem ez.", "src": "Ay, hindi. Not this."},
{"key": "data.voice.filipino.wrong.1", "text": "Grabe, ez rossz ital.", "src": "Grabe, wrong drink."},
{"key": "data.voice.filipino.wrong.2", "text": "Nem az enyém, kuya.", "src": "Not mine, kuya."},
{"key": "data.voice.italian.another.0", "text": "Dai, még egyet!", "src": "Ancora, dai!"},
{"key": "data.voice.italian.another.1", "text": "Még egyet, grazie!", "src": "Another, grazie!"},
{"key": "data.voice.italian.another.2", "text": "Még egyszer, amore!", "src": "Once more, amore!"},
{"key": "data.voice.italian.close.0", "text": "Va bene, jó lesz.", "src": "Va bene."},
{"key": "data.voice.italian.close.1", "text": "Oké, grazie.", "src": "Okay, grazie."},
{"key": "data.voice.italian.close.2", "text": "Nem rossz, eh.", "src": "Not bad, eh."},
{"key": "data.voice.italian.kicked.0", "text": "Ma dai! Komolyan?", "src": "Ma dai! Really?"},
{"key": "data.voice.italian.kicked.1", "text": "Hát jó. Ciao, ciao.", "src": "Va bene. Ciao, ciao."},
{"key": "data.voice.italian.kicked.2", "text": "Che maleducato! Modortalan.", "src": "Che maleducato."},
{"key": "data.voice.italian.leaving.0", "text": "Basta. Megyek.", "src": "Basta. I go."},
{"key": "data.voice.italian.leaving.1", "text": "Mamma mia, ez a várakozás!", "src": "Mamma mia, the waiting!"},
{"key": "data.voice.italian.leaving.2", "text": "Ciao. Talán a következő életben.", "src": "Ciao. Maybe next life."},
{"key": "data.voice.italian.order.0", "text": "Egy {drink}, per favore.", "src": "Un {drink}, per favore."},
{"key": "data.voice.italian.order.1", "text": "Egy {drink}, amore.", "src": "A {drink}, amore."},
{"key": "data.voice.italian.order.2", "text": "{drink} lesz, grazie.", "src": "{drink}, grazie."},
{"key": "data.voice.italian.order.3", "text": "Dai, egy {drink}!", "src": "Dai, a {drink}."},
{"key": "data.voice.italian.perfect.0", "text": "Perfetto, ez az!", "src": "Perfetto!"},
{"key": "data.voice.italian.perfect.1", "text": "Bravo, ügyes!", "src": "Bravo!"},
{"key": "data.voice.italian.perfect.2", "text": "Che buono, finom!", "src": "Che buono!"},
{"key": "data.voice.italian.praise.0", "text": "Perfetto. Tényleg. Grazie mille.", "src": "Perfetto. Truly. Grazie mille."},
{"key": "data.voice.italian.praise.1", "text": "Bravo. A nonnám sírna.", "src": "Bravo. My nonna would cry."},
{"key": "data.voice.italian.praise.2", "text": "Che buono. Én innen nem megyek el.", "src": "Che buono. I'm not leaving."},
{"key": "data.voice.italian.sip.0", "text": "Senti, figyelj: {advice_l}", "src": "Senti, {advice_l}"},
{"key": "data.voice.italian.sip.1", "text": "Allora, szóval {advice_l}", "src": "Allora, {advice_l}"},
{"key": "data.voice.italian.sip.2", "text": "Va bene, de {advice_l}", "src": "Va bene, ma {advice_l}"},
{"key": "data.voice.italian.wrong.0", "text": "Mamma mia, nem.", "src": "Mamma mia, no."},
{"key": "data.voice.italian.wrong.1", "text": "Ma che cos'è? Mi ez?", "src": "Ma che cos'è?"},
{"key": "data.voice.italian.wrong.2", "text": "No, no. Nem ezt.", "src": "No, no. Not this."},
{"key": "data.voice.miami.another.0", "text": "¡Dale! Még egyet!", "src": "¡Otra, dale!"},
{"key": "data.voice.miami.another.1", "text": "Még egyet, oye!", "src": "One more, oye!"},
{"key": "data.voice.miami.another.2", "text": "Még egyszer, mi amor!", "src": "Again, mi amor!"},
{"key": "data.voice.miami.close.0", "text": "Está bien, jó így.", "src": "Está bien."},
{"key": "data.voice.miami.close.1", "text": "Nem rossz, chico.", "src": "Not bad, chico."},
{"key": "data.voice.miami.close.2", "text": "Oké, oké.", "src": "Okay, okay."},
{"key": "data.voice.miami.kicked.0", "text": "¿En serio? Oké, jól van.", "src": "¿En serio? Okay, fine."},
{"key": "data.voice.miami.kicked.1", "text": "Ugye csak viccelsz, chico?", "src": "You're kidding me, chico."},
{"key": "data.voice.miami.kicked.2", "text": "Dale. Te jársz rosszul.", "src": "Dale. Your loss."},
{"key": "data.voice.miami.leaving.0", "text": "¡Oye! Egész este itt ülök.", "src": "¡Oye! I've been sitting here all night."},
{"key": "data.voice.miami.leaving.1", "text": "Bueno, ennyi volt. Ciao.", "src": "Bueno, that's it. Ciao."},
{"key": "data.voice.miami.leaving.2", "text": "No, no. Én nem várok tovább.", "src": "No, no. I'm not waiting anymore."},
{"key": "data.voice.miami.order.0", "text": "Oye, nekem egy {drink}.", "src": "Oye, a {drink} for me."},
{"key": "data.voice.miami.order.1", "text": "Dale, egy {drink}.", "src": "Dale, one {drink}."},
{"key": "data.voice.miami.order.2", "text": "{drink}, papi, ha ráérsz.", "src": "{drink}, papi, when you can."},
{"key": "data.voice.miami.order.3", "text": "Mi amor, egy {drink}.", "src": "Mi amor, a {drink}."},
{"key": "data.voice.miami.perfect.0", "text": "¡Qué rico! Finom!", "src": "¡Qué rico!"},
{"key": "data.voice.miami.perfect.1", "text": "¡Eso es! Ez az!", "src": "¡Eso es!"},
{"key": "data.voice.miami.perfect.2", "text": "¡Dale, tökéletes!", "src": "¡Dale, perfecto!"},
{"key": "data.voice.miami.praise.0", "text": "Ay, ez az igazi. Gracias.", "src": "Ay, this is the one. Gracias."},
{"key": "data.voice.miami.praise.1", "text": "Az abuelám is rábólintana, pedig ő semmire sem bólint rá.", "src": "My abuela would approve, and she approves of nothing."},
{"key": "data.voice.miami.praise.2", "text": "Dale. Te tudod, mit csinálsz.", "src": "Dale. You know what you're doing."},
{"key": "data.voice.miami.sip.0", "text": "Mira, nézd: {advice_l}", "src": "Mira, {advice_l}"},
{"key": "data.voice.miami.sip.1", "text": "Oye, figyelj: {advice_l}", "src": "Oye, {advice_l}"},
{"key": "data.voice.miami.sip.2", "text": "Está bien, de… {advice_l}", "src": "Está bien, pero… {advice_l}"},
{"key": "data.voice.miami.wrong.0", "text": "¿Qué es esto? Mi ez?", "src": "¿Qué es esto?"},
{"key": "data.voice.miami.wrong.1", "text": "No, no, no. Nem ez.", "src": "No, no, no."},
{"key": "data.voice.miami.wrong.2", "text": "Nem az enyém, oye.", "src": "Not mine, oye."},
{"key": "data.voice.nyc.another.0", "text": "Hit me, még egyet!", "src": "Hit me again!"},
{"key": "data.voice.nyc.another.1", "text": "Csak hozd őket sorban!", "src": "Keep 'em comin'!"},
{"key": "data.voice.nyc.another.2", "text": "Még egyet, chief!", "src": "Another, chief!"},
{"key": "data.voice.nyc.close.0", "text": "Eh. Elmegy.", "src": "Eh. It's fine."},
{"key": "data.voice.nyc.close.1", "text": "Yeah, rendben.", "src": "Yeah, alright."},
{"key": "data.voice.nyc.close.2", "text": "Megteszi.", "src": "It'll do."},
{"key": "data.voice.nyc.kicked.0", "text": "Ezt most komolyan mondod?", "src": "You serious right now?"},
{"key": "data.voice.nyc.kicked.1", "text": "Jó. Amúgy is pocsék bár.", "src": "Fine. Terrible bar anyway."},
{"key": "data.voice.nyc.kicked.2", "text": "Wow. Oké. Wow.", "src": "Wow. Okay. Wow."},
{"key": "data.voice.nyc.leaving.0", "text": "Nekem dolgom van. Forget it.", "src": "I got places to be. Forget it."},
{"key": "data.voice.nyc.leaving.1", "text": "Hihetetlen. Én leléptem.", "src": "Unbelievable. I'm outta here."},
{"key": "data.voice.nyc.leaving.2", "text": "Yo, ez bár vagy váróterem?", "src": "Yo, is this a bar or a waiting room?"},
{"key": "data.voice.nyc.order.0", "text": "Yo, jöhet egy {drink}.", "src": "Yo, lemme get a {drink}."},
{"key": "data.voice.nyc.order.1", "text": "{drink}. És sietek.", "src": "{drink}. And I'm in a hurry."},
{"key": "data.voice.nyc.order.2", "text": "Egy {drink} ide, chief.", "src": "Gimme a {drink}, chief."},
{"key": "data.voice.nyc.order.3", "text": "{drink}. Ne bonyolítsd túl.", "src": "{drink}. Don't make it weird."},
{"key": "data.voice.nyc.perfect.0", "text": "Na, ez már beszéd!", "src": "Now we're talkin'!"},
{"key": "data.voice.nyc.perfect.1", "text": "Ez az igazi!", "src": "That's the stuff!"},
{"key": "data.voice.nyc.perfect.2", "text": "Ó, ez az!", "src": "Oh, that's it!"},
{"key": "data.voice.nyc.praise.0", "text": "Oké, le vagyok nyűgözve. Ilyen nincs.", "src": "Okay, I'm impressed. That never happens."},
{"key": "data.voice.nyc.praise.1", "text": "Mondok valamit: ez aztán ital.", "src": "Lemme tell ya, that's a drink."},
{"key": "data.voice.nyc.praise.2", "text": "Többet kéne kérned érte. De ne tedd.", "src": "You should charge more for this. Don't."},
{"key": "data.voice.nyc.sip.0", "text": "Nézd, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.nyc.sip.1", "text": "Csak mondom: {advice_l}", "src": "I'm just sayin', {advice_l}"},
{"key": "data.voice.nyc.sip.2", "text": "Nem rossz, de {advice_l}", "src": "Not bad, but {advice_l}"},
{"key": "data.voice.nyc.wrong.0", "text": "Ez meg mi?", "src": "What is this?"},
{"key": "data.voice.nyc.wrong.1", "text": "Fuhgeddaboudit. Nem ez.", "src": "Fuhgeddaboudit."},
{"key": "data.voice.nyc.wrong.2", "text": "Nem ez az, pal.", "src": "Wrong one, pal."},
{"key": "data.voice.surfer.another.0", "text": "Még egyet, dude!", "src": "One more, dude!"},
{"key": "data.voice.surfer.another.1", "text": "Még, még!", "src": "Again, again!"},
{"key": "data.voice.surfer.another.2", "text": "Jöhet a következő hullám!", "src": "Keep 'em rolling!"},
{"key": "data.voice.surfer.close.0", "text": "Cool, cool, jó ez.", "src": "Cool, cool."},
{"key": "data.voice.surfer.close.1", "text": "Yeah, ez így megy.", "src": "Yeah, that works."},
{"key": "data.voice.surfer.close.2", "text": "Elég nice.", "src": "Nice enough."},
{"key": "data.voice.surfer.kicked.0", "text": "Ez durva, dude.", "src": "Harsh, dude."},
{"key": "data.voice.surfer.kicked.1", "text": "Oké… ez is egy vibe.", "src": "Okay… that's a vibe."},
{"key": "data.voice.surfer.kicked.2", "text": "Wow. Ez nem chill.", "src": "Wow. Not chill."},
{"key": "data.voice.surfer.leaving.0", "text": "Dude, már ezer éve itt vagyok.", "src": "Dude, I've been here forever."},
{"key": "data.voice.surfer.leaving.1", "text": "Nem cool. Leléptem.", "src": "Not cool. I'm out."},
{"key": "data.voice.surfer.leaving.2", "text": "Yeah, nem. Én megyek.", "src": "Yeah, no. Bailing."},
{"key": "data.voice.surfer.order.0", "text": "Dude, egy {drink}.", "src": "Dude, a {drink}."},
{"key": "data.voice.surfer.order.1", "text": "Jöhet, mondjuk, egy {drink}?", "src": "Can I get, like, a {drink}?"},
{"key": "data.voice.surfer.order.2", "text": "{drink}, légyszi. Chill, nem sürgős.", "src": "{drink}, please. Chill, no rush."},
{"key": "data.voice.surfer.order.3", "text": "Yeah, egy {drink} most epic lenne.", "src": "Yeah, a {drink} sounds epic."},
{"key": "data.voice.surfer.perfect.0", "text": "Dude. Igen.", "src": "Dude. Yes."},
