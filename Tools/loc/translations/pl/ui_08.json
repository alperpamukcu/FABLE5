{"key": "rule.already_at_bar", "text": "Ten gość już siedzi przy barze.", "src": "They are already at the bar."},
{"key": "rule.bar_top_best", "text": "Blat baru jest już najlepszy.", "src": "The bar top is already the best one."},
{"key": "rule.bottle_owned", "text": "Ta butelka jest już twoja.", "src": "That bottle is already yours."},
{"key": "rule.card_not_read", "text": "Legitymacja nie została sprawdzona; dokumenty są za nią.", "src": "The card has not been read; the papers are behind it."},
{"key": "rule.counter_clean", "text": "Tu kontuar jest czysty.", "src": "The counter is clean here."},
{"key": "rule.drink_in_shaker", "text": "Ten drink jest wciąż w shakerze — najpierw przelej go do szkła.", "src": "That drink is still in the shaker — pour it into a glass first."},
{"key": "rule.fixture_needs_stars", "text": "{fixture}: wymaga sali na {stars} gwiazdki; ten bar ma ocenę {rating}.", "src": "{fixture} needs a {stars}-star room; this bar rates {rating}."},
{"key": "rule.fixture_owned", "text": "Bar ma już: {fixture}.", "src": "The bar already has {fixture}."},
{"key": "rule.fixture_rung_one_at_a_time", "text": "{fixture} to szczebel {level} swojej drabiny; bar stoi na szczeblu {bar_level}. Wspina się o jeden szczebel naraz.", "src": "{fixture} is rung {level} of its ladder; the bar stands on rung {bar_level}. It climbs one rung at a time."},
{"key": "rule.fixture_tower_one_line", "text": "{fixture} ma linie: {lines}; ten bar ma: {bar_lines}. Kolumnę rozbudowuje się o jedną linię naraz.", "src": "{fixture} runs {lines} lines; this bar runs {bar_lines}. A tower is fitted one line at a time."},
{"key": "rule.glass_line_finest", "text": "Szkło {glass} jest już najwyższej klasy.", "src": "The {glass} line is already the finest."},
{"key": "rule.kick_already_served", "text": "Nie wyprosisz kogoś, kogo już obsłużono; twoja chwila była przy legitymacji.", "src": "You cannot show the door to someone you have already served; the card was your moment."},
{"key": "rule.kick_guest_of_house", "text": "Gościa honorowego lokalu nie możesz wyprosić.", "src": "The guest of the house is not yours to show the door."},
{"key": "rule.kick_read_card_first", "text": "Najpierw sprawdź legitymację.", "src": "Read the card first."},
{"key": "rule.no_glass_to_collect", "text": "Nie ma tu szklanki do zebrania.", "src": "There is no glass here to collect."},
{"key": "rule.no_last_call", "text": "Nikt nie czeka na ostatnią kolejkę.", "src": "Nobody is waiting on the last call."},
{"key": "rule.no_pourable_drinks", "text": "Na razie nie ma drinków, które da się nalać.", "src": "No drinks you can pour yet."},
{"key": "rule.no_room_stool", "text": "Nie ma miejsca na kolejny stołek.", "src": "No room for another stool."},
{"key": "rule.not_enough_money", "text": "Za mało pieniędzy ({money} < {price}).", "src": "Not enough money ({money} < {price})."},
{"key": "rule.not_on_counter", "text": "Tego nie ma na kontuarze.", "src": "That is not on this counter."},
{"key": "rule.not_ordered", "text": "Gość jeszcze nic nie zamówił.", "src": "They have not ordered yet."},
{"key": "rule.not_waiting", "text": "Gość już nie czeka.", "src": "They are not waiting any more."},
{"key": "rule.not_waiting_at_bar", "text": "Gość nie czeka przy barze.", "src": "They are not waiting at the bar."},
{"key": "rule.nothing_to_serve", "text": "Nie ma czego podać.", "src": "Nothing to serve."},
{"key": "rule.nothing_to_wash", "text": "Nie masz w rękach nic do zmycia.", "src": "There is nothing in your hands to wash."},
{"key": "rule.one_fitting_a_night", "text": "Jedno wyposażenie na noc — reszta poczeka do jutra.", "src": "One fitting a night — the rest keeps until tomorrow."},
{"key": "rule.pour_unmixed", "text": "Dwa alkohole w shakerze — wstrząśnij albo zamieszaj, zanim trafią do szkła.", "src": "Two spirits in the tin — shake it or stir it before it goes to the glass."},
{"key": "rule.pull_cocktail_in_tin", "text": "Dokończ albo wyrzuć koktajl, zanim utoczysz piwo.", "src": "Finish or bin the cocktail before you pull a pint."},
{"key": "rule.pull_glass_full", "text": "Szklanka jest pełna. Podaj ją albo wyrzuć.", "src": "The glass is full. Serve it or bin it."},
{"key": "rule.pull_glass_taken", "text": "W tej szklance już jest drink — podaj go albo wyrzuć, zanim utoczysz piwo.", "src": "There is already a drink in that glass — serve it or bin it before pulling a pint."},
{"key": "rule.recipe_not_earned", "text": "{recipe} — jeszcze do zdobycia: {lock}.", "src": "{recipe} is not earned yet — {lock}."},
{"key": "rule.recipe_short_money", "text": "Za mało pieniędzy — {recipe} kosztuje {price}.", "src": "Not enough money — {recipe} costs {price}."},
{"key": "rule.refund_under_rung", "text": "{fixture} stoi pod wyższym szczeblem; najpierw oddaj tamten.", "src": "{fixture} is under a higher rung; take that one back first."},
{"key": "rule.refund_under_tower", "text": "{fixture} stoi pod kolumną na {lines} linie; najpierw oddaj tamtą.", "src": "{fixture} is under the {lines}-line tower; take that one back first."},
{"key": "rule.shake_empty", "text": "Shaker jest pusty, nie ma czym wstrząsać.", "src": "Nothing in the shaker to shake."},
{"key": "rule.sink_running", "text": "Woda w zlewie jeszcze leci — poczekaj.", "src": "The sink is running — wait for it."},
{"key": "rule.snack_bowl_empty", "text": "Ta miska jest dziś pusta: {snack}.", "src": "The {snack} bowl is empty today."},
{"key": "rule.snack_needs_order", "text": "Przekąski idą do zamówienia drinka — gość jeszcze go nie złożył.", "src": "Snacks ride a drink order — they have not ordered one yet."},
{"key": "rule.snack_not_at_bar", "text": "Gościa nie ma przy barze.", "src": "They are not at the bar."},
{"key": "rule.still_choosing", "text": "Gość jeszcze wybiera.", "src": "They are still choosing."},
{"key": "rule.still_talking", "text": "Gość jeszcze mówi. Nic nie zamówiono.", "src": "They are still talking. Nothing ordered yet."},
{"key": "rule.stir_empty", "text": "Shaker jest pusty, nie ma czego mieszać.", "src": "Nothing in the shaker to stir."},
{"key": "rule.trial_not_asked", "text": "Gość jeszcze o nic nie poprosił.", "src": "They have not asked for anything yet."},
