{"key": "data.voice.african.order.1", "text": "Raz {drink}, przyjacielu.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Wezmę: {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "{drink}, abeg.", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "Ah, słodko!", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "W sam raz!", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "Ten jest dobry!", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, ten jest jak trzeba. Dziękuję.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "No wahala, naprawdę. Bardzo dobre.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "Przyjacielu, ty znasz się na rzeczy.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "Przyjacielu, {advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg, {advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "Może być, ale {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah, nie.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "To nie to.", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "Przyjacielu, nie.", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "To samo jeszcze raz, mate!", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "Jeszcze jeden, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "No dalej, następny!", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "Nieźle.", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Dzięki, ujdzie.", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "Alright, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Uroczo. Po prostu uroczo.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "No dobrze. Cheers za nic.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "Chyba sobie żartujesz.", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Dobra. Dość tego czekania.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "A niech to. Spadam.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Trochę słabo tu. Bye.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "{drink}, mate, jak znajdziesz chwilkę.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, poproszę. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "No to dawaj: {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "Dla mnie: {drink}. Lovely.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "Lovely!", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "Cheers, mate!", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "Porządna robota!", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "O rany. Naprawdę lovely.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Zrobione jak należy.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Bloody good. Serio.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "Taki drobiazg: {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Słuchaj, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Coś tu nie gra.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Eee, to nie moje.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "Nie to było w zamówieniu.", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "Jeszcze jeden, yaar!", "src": "One more, yaar!"},
