{"strings": [
{"key": "data.voice.african.another.0", "text": "Dawaj następny!", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "Jeszcze jeden, abeg!", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "Powtórka, przyjacielu!", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "Może być.", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "No wahala.", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "Dobra, dzięki.", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "Ah ah! Na serio?", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala. Idę.", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "Przyjacielu, to nieładnie.", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah ah. Dość tego czekania.", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala. Idę sobie.", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "Pozwól, że pójdę, przyjacielu.", "src": "Let me go, my friend."},
