{"strings": [
{"key": "data.voice.aussie.another.0", "text": "To samo, mate!", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "Jeszcze jeden, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "Następny, legend!", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "No, righto.", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "Nieźle, mate.", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "Ujdzie.", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "Serio, mate?", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto. Niech będzie.", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Nah, to słabe.", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto, dość tego czekania.", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Nah, szkoda gadać. Idę.", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "Cheers za nic, mate.", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "{drink}, mate.", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink}, poproszę.", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "Wezmę: {drink}.", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "Raz {drink}, cheers.", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "Ripper!", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "Bułka z masłem!", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "Bloody dobre!", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "Bloody ripper, mate. Cheers.", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "No dramas. Znasz się na rzeczy.", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "Najlepszy tej nocy, serio.", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "Słuchaj, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "No dramas, ale {advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Nah, mate.", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "To nie moje, sorry.", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "Nie ten, mate.", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "Jeszcze jedna kolejka!", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "To samo jeszcze raz!", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "Kolejne poproszę!", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "Dzięki.", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "Może być.", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "Prawie.", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "Serio? Dobra.", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "Robisz błąd.", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "Nieważne. Zatrzymaj sobie ten bar.", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "Dajcie spokój. Nie będę dłużej czekać.", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "Czy ktoś tu dziś pracuje?", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "Dobra. Napiję się gdzie indziej.", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink}, poproszę.", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "Wezmę: {drink}.", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "Raz {drink}, jak znajdziesz chwilę.", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "Niech będzie: {drink}.", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "Idealnie!", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "To jest to!", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "W punkt!", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "Nie ma czego poprawiać.", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "O, to jest drink.", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "Podziękuj temu, kto cię uczył.", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice} Tak tylko mówię.", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "Szczerze? {advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "To nie moje zamówienie.", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "Zły drink.", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "To nie moje.", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "Encore, proszę!", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "Jeszcze jeden, oui!", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "Powtórka, merci!", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ça va.", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "Może być.", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon, okej.", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "Quoi? Serio?", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Bon. Au revoir.", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule.", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non. Dość czekania.", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis. Idę.", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "No to au revoir.", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "{drink}, s'il vous plaît.", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "{drink}, proszę.", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "Raz {drink}, merci.", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "Wezmę: {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "Parfait!", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "Voilà, idealnie!", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "Magnifique!", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait. Nie mam żadnych uwag.", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voilà. Ktoś tu umie nalewać.", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique. Naprawdę.", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Écoute, {advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon, {advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors, {advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non.", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "To nie to.", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon, nie ten.", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "Mou ippai!", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "Jeszcze jeden, kanpai!", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "Powtórka, onegai!", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Hai, okej.", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa.", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "Nieźle, ne.", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "Eh?! Naprawdę?", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi. Dobrze, idę.", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta. Sayonara.", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen, nie mogę dłużej czekać.", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii. Idę.", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai. Do widzenia.", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen, poproszę: {drink}.", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "Raz {drink}, onegai.", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink}, proszę. Arigatou.", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto… {drink}.", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "Oishii!", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "Sugoi, idealnie!", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "Kanpai!", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii. Naprawdę, to jest to.", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "Sugoi. Pełen profesjonalizm, ne.", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "Kanpai. To jest idealne.", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "Etto, {advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "Ne, {advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "Sumimasen, ale {advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "Chotto… nie.", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "Eh? Nie to.", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "Chigau, przepraszam.", "src": "Chigau, sorry."},
{"key": "data.voice.midwest.another.0", "text": "Jeszcze jeden, proszę!", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "Jeszcze raz, dziękuję!", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "To samo, ope!", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "Oj, może być.", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "Jasne, dzięki.", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "Wcale nieźle.", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "Oj. No. Dobrze więc.", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "Ope, przepraszam… już idę.", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "Trochę przesada, ale okej.", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "Oh gosh, naprawdę nie mogę dłużej czekać.", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "No, będę się zbierać.", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "Przepraszam, ale muszę już iść.", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "Mogę prosić: {drink}? Dziękuję bardzo.", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "{drink}, jeśli to nie kłopot.", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "Oj, dla mnie tylko {drink}.", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink}, proszę. Bez pośpiechu.", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "Oj, bardzo fajne!", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "You betcha!", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "Oh jeez, tak!", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "Oh my gosh, to jest po prostu cudne.", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "Bardzo fajne. Ciocia pokochałaby to miejsce.", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "No, to było w sam raz.", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "Oj, {advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "Tak tylko dla informacji: {advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "Nic wielkiego, ale {advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "Ope. Nie ten.", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "Oj, to nie moje.", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "Przepraszam, nie. Nie to.", "src": "Sorry, no. Not this."},
{"key": "data.voice.polish.another.0", "text": "Jeszcze jeden, szefie!", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "Powtórka, proszę!", "src": "Another, proszę!"},
{"key": "data.voice.polish.another.2", "text": "Dawaj następnego!", "src": "One more!"},
{"key": "data.voice.polish.close.0", "text": "Może być.", "src": "Dobrze."},
{"key": "data.voice.polish.close.1", "text": "Ujdzie.", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "No dobra, dzięki.", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "Serio? No dobra.", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "Dobra. Do widzenia.", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "Co? No to idę.", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "Dość. Idę.", "src": "Enough. I'm going."},
{"key": "data.voice.polish.leaving.1", "text": "Nie, nie. Za długo to trwa.", "src": "Nie, nie. Too long."},
{"key": "data.voice.polish.leaving.2", "text": "Do widzenia.", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "Poproszę: {drink}.", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "{drink}, szefie.", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "Raz {drink}. Dzięki.", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "Dobra, to {drink}.", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "Na zdrowie!", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "Świetnie!", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "Bomba!", "src": "Very good!"},
{"key": "data.voice.polish.praise.0", "text": "Na zdrowie. To jest prawdziwy drink.", "src": "Na zdrowie. This is a real drink."},
{"key": "data.voice.polish.praise.1", "text": "Świetne. Jak w domu.", "src": "Świetnie. Like at home."},
{"key": "data.voice.polish.praise.2", "text": "No, no. Bardzo, bardzo dobre.", "src": "Dobrze. Very, very good."},
{"key": "data.voice.polish.sip.0", "text": "Dobre, ale {advice_l}", "src": "Dobrze, but {advice_l}"},
{"key": "data.voice.polish.sip.1", "text": "Słuchaj, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.polish.sip.2", "text": "Hm, {advice_l}", "src": "Hm, {advice_l}"},
{"key": "data.voice.polish.wrong.0", "text": "Nie. To nie ten.", "src": "Nie. Wrong one."},
{"key": "data.voice.polish.wrong.1", "text": "To nie moje.", "src": "This is not mine."},
{"key": "data.voice.polish.wrong.2", "text": "Co to jest?", "src": "Co to jest?"},
{"key": "data.voice.turkish.another.0", "text": "Bir daha!", "src": "Bir daha!"},
{"key": "data.voice.turkish.another.1", "text": "Jeszcze jeden, abi!", "src": "Another, abi!"},
{"key": "data.voice.turkish.another.2", "text": "Powtórka, eyvallah!", "src": "Again, eyvallah!"},
{"key": "data.voice.turkish.close.0", "text": "Tamam.", "src": "Tamam."},
{"key": "data.voice.turkish.close.1", "text": "İdare eder.", "src": "İdare eder."},
{"key": "data.voice.turkish.close.2", "text": "Okej, może być.", "src": "Okay, fine."},
{"key": "data.voice.turkish.kicked.0", "text": "Ciddi misin? Okej.", "src": "Ciddi misin? Okay."},
{"key": "data.voice.turkish.kicked.1", "text": "Abi, serio? Dobra.", "src": "Abi, really? Fine."},
{"key": "data.voice.turkish.kicked.2", "text": "Yok, yok. Idę.", "src": "Yok, yok. I'm going."},
{"key": "data.voice.turkish.leaving.0", "text": "Yok, dłużej nie czekam.", "src": "Yok, I'm not waiting anymore."},
{"key": "data.voice.turkish.leaving.1", "text": "Abi, czy ktoś tu w ogóle pracuje?", "src": "Abi, is nobody working here?"},
{"key": "data.voice.turkish.leaving.2", "text": "Tamam, hoşça kal.", "src": "Tamam, hoşça kal."},
{"key": "data.voice.turkish.order.0", "text": "Abi, poproszę: {drink}.", "src": "Abi, a {drink}."},
{"key": "data.voice.turkish.order.1", "text": "Raz {drink}, eyvallah.", "src": "One {drink}, eyvallah."},
{"key": "data.voice.turkish.order.2", "text": "{drink}, canım, jak znajdziesz chwilę.", "src": "{drink}, canım, when you can."},
{"key": "data.voice.turkish.order.3", "text": "Bir {drink}, proszę.", "src": "Bir {drink}, please."},
{"key": "data.voice.turkish.perfect.0", "text": "Eyvallah!", "src": "Eyvallah!"},
{"key": "data.voice.turkish.perfect.1", "text": "Harika!", "src": "Harika!"},
{"key": "data.voice.turkish.perfect.2", "text": "Süper, abi!", "src": "Süper, abi!"},
{"key": "data.voice.turkish.praise.0", "text": "Eyvallah. Tak to się robi.", "src": "Eyvallah. This is how it's done."},
{"key": "data.voice.turkish.praise.1", "text": "Abi, czapki z głów. Harika.", "src": "Abi, my hat is off. Harika."},
