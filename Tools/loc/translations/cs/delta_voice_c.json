{"strings": [
{"key": "data.voice.aussie.another.0", "text": "Znova to samý, mate!", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "Ještě jedno, díky!", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "Další, legendo!", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "Jo, righto.", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "Není to zlý, mate.", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "To ujde.", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "Vážně, mate?", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto. Budiž.", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Nah, to je drsný.", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto, čekám už dost.", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Nah, kašlu na to. Jdu.", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "Díky za nic, mate.", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "{drink}, mate.", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "Prosím: {drink}.", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "Dám si: {drink}.", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "Jednou {drink}, cheers.", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "Ripper!", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "Too easy!", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "Zatraceně dobrý!", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "Bloody ripper, mate. Díky.", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "Too easy. Ty se v tom vyznáš.", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "Nejlepší za celou noc, fakt.", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "Hele, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "No dramas, ale {advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Nah, mate.", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "Není moje, sorry.", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "Špatnej, mate.", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "Ještě jednu rundu!", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "To samý ještě jednou!", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "Nos, nos!", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "Díky.", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "Ujde to.", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "Skoro trefa.", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "Vážně? Tak fajn.", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "Děláš chybu.", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "Je mi to jedno. Nech si svůj bar.", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "Kašlu na to. Už nečekám.", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "Pracuje tu dneska vůbec někdo?", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "Tak jo. Zajdu jinam.", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink}, prosím.", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "Dám si: {drink}.", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "Až budeš mít chvilku: {drink}.", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "Ať je to {drink}.", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "Paráda!", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "Přesně tohle!", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "Trefa!", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "Na tom není co měnit.", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "Tak tohle je drink.", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "Kdo tě to učil, tomu poděkuj.", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice} Jen tak mimochodem.", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "Upřímně? {advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "To není, co chci.", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "Špatný drink.", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "To není moje.", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "Encore, prosím!", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "Ještě jednu, oui!", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "Znovu, merci!", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ça va.", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "Je to v pořádku.", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon, dobře.", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "Quoi? Vážně?", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Bon. Au revoir.", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule. Směšné.", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non. Čekání už bylo dost.", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis. Jdu.", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "Tak au revoir.", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "{drink}, s'il vous plaît.", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "Prosím: {drink}.", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "Pro mě: {drink}, merci.", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "Vezmu si: {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "Parfait!", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "Voilà, dokonalé!", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "Magnifique!", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait. Nemám jedinou výtku.", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voilà. Tady někdo umí nalévat.", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique. Opravdu.", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Écoute, {advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon, {advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors, {advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non.", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "Tohle to není.", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon, špatně.", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "Mou ippai!", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "Ještě jednu, kanpai!", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "Znovu, onegai!", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Hai, dobře.", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa. Ujde.", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "Není to zlé, ne?", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "Eh?! Vážně?", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi. Dobře, jdu.", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta. Sayonara.", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen, déle čekat nemůžu.", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii. Jdu.", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai. Na shledanou.", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen, prosím: {drink}.", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "Jednou {drink}, onegai.", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink}, prosím. Arigatou.", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto… pro mě: {drink}.", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "Oishii!", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "Sugoi, dokonalé!", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "Kanpai!", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii. Opravdu, tohle je ono.", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "Sugoi. Ty jsi profík, ne?", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "Kanpai. Tohle je dokonalé.", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "Etto, {advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "Chotto, {advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "Sumimasen, ale {advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "Chotto… ne.", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "Eh? Tohle ne.", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "Chigau, promiň.", "src": "Chigau, sorry."},
{"key": "data.voice.midwest.another.0", "text": "Ještě jednu, prosím!", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "Další, moc děkuju!", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "To samé, ope!", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "Oh, to je fajn.", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "Jasně, díky.", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "Vůbec to není zlé.", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "Oh. No. Tak dobře.", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "Ope, sorry… půjdu.", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "To je trochu moc, ale okay.", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "Oh gosh, já už fakt nemůžu čekat.", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "Well, je čas vyrazit.", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "Sorry, ale půjdu.", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "Může být {drink}? Moc díky.", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "{drink}, jestli to není problém.", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "Oh, pro mě jen: {drink}.", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink}, prosím. Kdykoli.", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "Oh, moc hezké!", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "You betcha!", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "Oh jeez, jo!", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "Oh my gosh, to je prostě báječné.", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "Moc hezké. Teta by tenhle podnik milovala.", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "Well, tohle přišlo vhod.", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "Oh, {advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "Jen pro info, {advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "Nic hroznýho, ale {advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "Ope. Špatný.", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "Oh, to není moje.", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "Sorry, ne. Tohle ne.", "src": "Sorry, no. Not this."},
{"key": "data.voice.polish.another.0", "text": "Jeszcze raz!", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "Další, proszę!", "src": "Another, proszę!"},
{"key": "data.voice.polish.another.2", "text": "Ještě jedno!", "src": "One more!"},
{"key": "data.voice.polish.close.0", "text": "Dobrze.", "src": "Dobrze."},
{"key": "data.voice.polish.close.1", "text": "Okay, ujde.", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "Fajn, díky.", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "Serio? No dobře.", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "Fajn. Do widzenia.", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "Co? Dobře, jdu.", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "Dost. Odcházím.", "src": "Enough. I'm going."},
{"key": "data.voice.polish.leaving.1", "text": "Nie, nie. Moc dlouho.", "src": "Nie, nie. Too long."},
{"key": "data.voice.polish.leaving.2", "text": "Do widzenia.", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "{drink}, proszę.", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "Prosím: {drink}.", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "Jednou {drink}. Děkuju.", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "Dobrze, dám si: {drink}.", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "Na zdrowie!", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "Świetnie!", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "Moc dobré!", "src": "Very good!"},
{"key": "data.voice.polish.praise.0", "text": "Na zdrowie. Tohle je pravý drink.", "src": "Na zdrowie. This is a real drink."},
{"key": "data.voice.polish.praise.1", "text": "Świetnie. Jako doma.", "src": "Świetnie. Like at home."},
{"key": "data.voice.polish.praise.2", "text": "Dobrze. Moc, moc dobré.", "src": "Dobrze. Very, very good."},
{"key": "data.voice.polish.sip.0", "text": "Dobrze, ale {advice_l}", "src": "Dobrze, but {advice_l}"},
{"key": "data.voice.polish.sip.1", "text": "Słuchaj, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.polish.sip.2", "text": "Hm, {advice_l}", "src": "Hm, {advice_l}"},
{"key": "data.voice.polish.wrong.0", "text": "Nie. Špatný.", "src": "Nie. Wrong one."},
{"key": "data.voice.polish.wrong.1", "text": "Tohle není moje.", "src": "This is not mine."},
{"key": "data.voice.polish.wrong.2", "text": "Co to jest?", "src": "Co to jest?"},
{"key": "data.voice.turkish.another.0", "text": "Bir daha!", "src": "Bir daha!"},
{"key": "data.voice.turkish.another.1", "text": "Další, abi!", "src": "Another, abi!"},
{"key": "data.voice.turkish.another.2", "text": "Znovu, eyvallah!", "src": "Again, eyvallah!"},
{"key": "data.voice.turkish.close.0", "text": "Tamam.", "src": "Tamam."},
{"key": "data.voice.turkish.close.1", "text": "İdare eder.", "src": "İdare eder."},
{"key": "data.voice.turkish.close.2", "text": "Dobře, ujde.", "src": "Okay, fine."},
{"key": "data.voice.turkish.kicked.0", "text": "Ciddi misin? Dobře.", "src": "Ciddi misin? Okay."},
{"key": "data.voice.turkish.kicked.1", "text": "Abi, vážně? Fajn.", "src": "Abi, really? Fine."},
{"key": "data.voice.turkish.kicked.2", "text": "Yok, yok. Jdu.", "src": "Yok, yok. I'm going."},
{"key": "data.voice.turkish.leaving.0", "text": "Yok, už nečekám.", "src": "Yok, I'm not waiting anymore."},
{"key": "data.voice.turkish.leaving.1", "text": "Abi, to tu nikdo nepracuje?", "src": "Abi, is nobody working here?"},
{"key": "data.voice.turkish.leaving.2", "text": "Tamam, hoşça kal.", "src": "Tamam, hoşça kal."},
{"key": "data.voice.turkish.order.0", "text": "Abi, pro mě: {drink}.", "src": "Abi, a {drink}."},
{"key": "data.voice.turkish.order.1", "text": "Jednou {drink}, eyvallah.", "src": "One {drink}, eyvallah."},
{"key": "data.voice.turkish.order.2", "text": "{drink}, canım, až budeš moct.", "src": "{drink}, canım, when you can."},
{"key": "data.voice.turkish.order.3", "text": "Bir {drink}, prosím.", "src": "Bir {drink}, please."},
{"key": "data.voice.turkish.perfect.0", "text": "Eyvallah!", "src": "Eyvallah!"},
{"key": "data.voice.turkish.perfect.1", "text": "Harika!", "src": "Harika!"},
{"key": "data.voice.turkish.perfect.2", "text": "Süper, abi!", "src": "Süper, abi!"},
{"key": "data.voice.turkish.praise.0", "text": "Eyvallah. Takhle se to dělá.", "src": "Eyvallah. This is how it's done."},
{"key": "data.voice.turkish.praise.1", "text": "Abi, klobouk dolů. Harika.", "src": "Abi, my hat is off. Harika."},
{"key": "data.voice.turkish.praise.2", "text": "Tamam, ty svou práci umíš.", "src": "Tamam, you know your work."},
