{"strings": [
{"key": "data.voice.african.another.0", "text": "Nes další!", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "Ještě jednu, abeg!", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "Znovu, příteli!", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "Dobré to je.", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "No wahala.", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "Dobře, díky.", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "Ah ah! Vážně?", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala. Jdu.", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "Příteli, tohle není hezké.", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah ah. Čekám už dost dlouho.", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala. Už jdu.", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "Půjdu, příteli.", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "Prosím: {drink}.", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "Příteli, pro mě: {drink}.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Dám si: {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "{drink}, abeg.", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "Ah, lahoda!", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "Správně!", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "Tohle je dobré!", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, tohle je správně. Děkuju.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "Žádná wahala. Moc dobré.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "Příteli, ty tomu rozumíš.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "Příteli, {advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg, {advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "Dobré, ale {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah, ne.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "Tohle to není.", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "Příteli, ne.", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "To samé, mate!", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "Ještě jedno, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "No tak, další!", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "Není to zlé.", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Ta, to ujde.", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "Dobrý, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Okouzlující. Naprosto okouzlující.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "Right. No. Díky za nic.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "To si děláš legraci.", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Right. Toho čekání už bylo dost.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "Kašlu na to. Jdu.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Trochu mizérie, tohle. Bye.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "Mate, až budeš mít chvilku: {drink}.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, prosím. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "Tak jo, dám si: {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "Pro mě: {drink}, ta.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "Nádhera!", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "Cheers, mate!", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "Pořádně dobré!", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Blimey. To je fakt lovely.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Tohle je udělané pořádně.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Zatraceně dobré, tohle.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "Jedna drobnost: {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Hele, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Tohle trochu nesedí.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Ehm, to není moje.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "Tohle není moje objednávka.", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "Ještě jednu, yaar!", "src": "One more, yaar!"},
{"key": "data.voice.desi.another.1", "text": "Aur ek!", "src": "Aur ek!"},
{"key": "data.voice.desi.another.2", "text": "Znovu, prosím!", "src": "Again, please!"},
{"key": "data.voice.desi.close.0", "text": "Theek hai.", "src": "Theek hai."},
{"key": "data.voice.desi.close.1", "text": "Je to v pohodě, na.", "src": "It is okay, na."},
{"key": "data.voice.desi.close.2", "text": "Chalega, ujde to.", "src": "Chalega."},
{"key": "data.voice.desi.kicked.0", "text": "Kya? Vážně?", "src": "Kya? Seriously?"},
{"key": "data.voice.desi.kicked.1", "text": "Arre. Dobře, fajn.", "src": "Arre. Okay, fine."},
{"key": "data.voice.desi.kicked.2", "text": "Chalo. Jdu.", "src": "Chalo. I go."},
{"key": "data.voice.desi.leaving.0", "text": "Arre yaar. Moc dlouho.", "src": "Arre yaar. Too long."},
{"key": "data.voice.desi.leaving.1", "text": "Chalo, už jdu.", "src": "Chalo, I am going."},
{"key": "data.voice.desi.leaving.2", "text": "Bas. Stačí.", "src": "Bas. Enough."},
{"key": "data.voice.desi.order.0", "text": "Jednou prosím: {drink}.", "src": "One {drink}, please."},
{"key": "data.voice.desi.order.1", "text": "Yaar, pro mě: {drink}.", "src": "A {drink}, yaar."},
{"key": "data.voice.desi.order.2", "text": "Vezmu si: {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.desi.order.3", "text": "{drink}, na?", "src": "{drink}, na?"},
{"key": "data.voice.desi.perfect.0", "text": "Wah, dokonalé!", "src": "Wah, perfect!"},
{"key": "data.voice.desi.perfect.1", "text": "Ekdum first class!", "src": "Ekdum first class!"},
{"key": "data.voice.desi.perfect.2", "text": "Bahut badhiya!", "src": "Bahut badhiya!"},
{"key": "data.voice.desi.praise.0", "text": "Wah. Ekdum dokonalé, yaar.", "src": "Wah. Ekdum perfect, yaar."},
{"key": "data.voice.desi.praise.1", "text": "Bahut badhiya. Opravdu.", "src": "Bahut badhiya. Really."},
{"key": "data.voice.desi.praise.2", "text": "First class. Ještě se vrátím.", "src": "First class. I am coming back."},
{"key": "data.voice.desi.sip.0", "text": "Arre, {advice_l}", "src": "Arre, {advice_l}"},
{"key": "data.voice.desi.sip.1", "text": "Yaar, {advice_l}", "src": "Yaar, {advice_l}"},
{"key": "data.voice.desi.sip.2", "text": "Theek hai, ale {advice_l}", "src": "Theek hai, but {advice_l}"},
{"key": "data.voice.desi.wrong.0", "text": "Arre, ne.", "src": "Arre, no."},
{"key": "data.voice.desi.wrong.1", "text": "Tohle není moje.", "src": "This is not mine."},
{"key": "data.voice.desi.wrong.2", "text": "Nahi, špatný drink.", "src": "Nahi, wrong one."},
{"key": "data.voice.german.another.0", "text": "Noch eins!", "src": "Noch eins!"},
{"key": "data.voice.german.another.1", "text": "Další, bitte!", "src": "Another, bitte!"},
{"key": "data.voice.german.another.2", "text": "Ještě jednou, prosím!", "src": "Again, please!"},
{"key": "data.voice.german.close.0", "text": "Ja, dobře.", "src": "Ja, okay."},
{"key": "data.voice.german.close.1", "text": "Přijatelné.", "src": "Acceptable."},
{"key": "data.voice.german.close.2", "text": "Je to v pořádku.", "src": "It is fine."},
{"key": "data.voice.german.kicked.0", "text": "To je absurdní.", "src": "This is absurd."},
{"key": "data.voice.german.kicked.1", "text": "Dobře. Už se nevrátím.", "src": "Fine. I will not return."},
{"key": "data.voice.german.kicked.2", "text": "Ja, ja. Už jdu.", "src": "Ja, ja. I am going."},
{"key": "data.voice.german.leaving.0", "text": "Tohle je nepřijatelné. Odcházím.", "src": "This is not acceptable. I am leaving."},
{"key": "data.voice.german.leaving.1", "text": "Nein. Čekání bylo dost.", "src": "Nein. I have waited enough."},
{"key": "data.voice.german.leaving.2", "text": "Unglaublich. Na shledanou.", "src": "Unglaublich. Goodbye."},
{"key": "data.voice.german.order.0", "text": "Prosím: {drink}. Správně připravené.", "src": "A {drink}, please. Correctly made."},
{"key": "data.voice.german.order.1", "text": "{drink}. Děkuji.", "src": "{drink}. Thank you."},
{"key": "data.voice.german.order.2", "text": "Jednou {drink}, bitte.", "src": "One {drink}, bitte."},
{"key": "data.voice.german.order.3", "text": "Objednávám si: {drink}.", "src": "I would like a {drink}."},
{"key": "data.voice.german.perfect.0", "text": "Genau!", "src": "Genau!"},
{"key": "data.voice.german.perfect.1", "text": "Sehr gut!", "src": "Sehr gut!"},
{"key": "data.voice.german.perfect.2", "text": "Wunderbar!", "src": "Wunderbar!"},
{"key": "data.voice.german.praise.0", "text": "Ja. Přesně tak, jak má být.", "src": "Ja. This is exactly right."},
{"key": "data.voice.german.praise.1", "text": "Precizní. Přesnosti si vážím.", "src": "Precise. I respect precision."},
{"key": "data.voice.german.praise.2", "text": "Sehr gut. Bez výhrad.", "src": "Sehr gut. No notes."},
{"key": "data.voice.german.sip.0", "text": "Genau, ale {advice_l}", "src": "Genau, but {advice_l}"},
{"key": "data.voice.german.sip.1", "text": "Jedna poznámka: {advice_l}", "src": "One remark: {advice_l}"},
{"key": "data.voice.german.sip.2", "text": "Ja, {advice_l}", "src": "Ja, {advice_l}"},
{"key": "data.voice.german.wrong.0", "text": "Nein. Tohle ne.", "src": "Nein. Not this."},
{"key": "data.voice.german.wrong.1", "text": "Tohle je chybně.", "src": "This is incorrect."},
{"key": "data.voice.german.wrong.2", "text": "Špatný drink.", "src": "Wrong drink."},
{"key": "data.voice.korean.another.0", "text": "Han jan deo!", "src": "Han jan deo!"},
{"key": "data.voice.korean.another.1", "text": "Ještě jednu!", "src": "One more!"},
{"key": "data.voice.korean.another.2", "text": "Znovu, juseyo!", "src": "Again, juseyo!"},
{"key": "data.voice.korean.close.0", "text": "Gwenchana.", "src": "Gwenchana."},
{"key": "data.voice.korean.close.1", "text": "To je dobré.", "src": "It is okay."},
{"key": "data.voice.korean.close.2", "text": "Nappeuji anha. Ujde.", "src": "Nappeuji anha."},
{"key": "data.voice.korean.kicked.0", "text": "Jinjja? No teda.", "src": "Jinjja? Wow."},
{"key": "data.voice.korean.kicked.1", "text": "Aish. Fajn.", "src": "Aish. Fine."},
{"key": "data.voice.korean.kicked.2", "text": "Tak annyeong.", "src": "Annyeong, then."},
{"key": "data.voice.korean.leaving.0", "text": "Aish. Moc dlouho.", "src": "Aish. Too long."},
{"key": "data.voice.korean.leaving.1", "text": "Jdu. Annyeong.", "src": "I am going. Annyeong."},
{"key": "data.voice.korean.leaving.2", "text": "Mot chamgesseo. Nevydržím.", "src": "Mot chamgesseo."},
{"key": "data.voice.korean.order.0", "text": "{drink}, juseyo.", "src": "{drink}, juseyo."},
{"key": "data.voice.korean.order.1", "text": "Jednou {drink}, prosím.", "src": "One {drink}, please."},
{"key": "data.voice.korean.order.2", "text": "Pro mě: {drink}.", "src": "A {drink} for me."},
{"key": "data.voice.korean.order.3", "text": "Chci: {drink}.", "src": "I want a {drink}."},
{"key": "data.voice.korean.perfect.0", "text": "Daebak!", "src": "Daebak!"},
{"key": "data.voice.korean.perfect.1", "text": "Jinjja dobré!", "src": "Jinjja good!"},
{"key": "data.voice.korean.perfect.2", "text": "Choego!", "src": "Choego!"},
{"key": "data.voice.korean.praise.0", "text": "Daebak. Jinjja, tohle je dokonalé.", "src": "Daebak. Jinjja, this is perfect."},
{"key": "data.voice.korean.praise.1", "text": "Choego. Myslím to vážně.", "src": "Choego. I mean it."},
{"key": "data.voice.korean.praise.2", "text": "Wow. Tobě to fakt jde.", "src": "Wow. You are good at this."},
{"key": "data.voice.korean.sip.0", "text": "Jamkkanman, {advice_l}", "src": "Jamkkanman, {advice_l}"},
{"key": "data.voice.korean.sip.1", "text": "Hm, {advice_l}", "src": "Um, {advice_l}"},
{"key": "data.voice.korean.sip.2", "text": "Gwenchana, ale {advice_l}", "src": "Gwenchana, but {advice_l}"},
{"key": "data.voice.korean.wrong.0", "text": "Aniyo, ne.", "src": "Aniyo, no."},
{"key": "data.voice.korean.wrong.1", "text": "Tohle je špatně.", "src": "This is wrong."},
{"key": "data.voice.korean.wrong.2", "text": "Eh? To není moje.", "src": "Eh? Not mine."},
{"key": "data.voice.nordic.another.0", "text": "Další. Skål!", "src": "Another. Skål!"},
{"key": "data.voice.nordic.another.1", "text": "Ještě jedno.", "src": "One more."},
{"key": "data.voice.nordic.another.2", "text": "Znovu, prosím.", "src": "Again, please."},
{"key": "data.voice.nordic.close.0", "text": "Dobře.", "src": "Fine."},
{"key": "data.voice.nordic.close.1", "text": "Je to v pohodě.", "src": "It's okay."},
{"key": "data.voice.nordic.close.2", "text": "Stačí to.", "src": "Good enough."},
{"key": "data.voice.nordic.kicked.0", "text": "Dobře. Divné, ale dobře.", "src": "Okay. Strange, but okay."},
{"key": "data.voice.nordic.kicked.1", "text": "Tak jo.", "src": "Fine."},
{"key": "data.voice.nordic.kicked.2", "text": "Hm. Tak na shledanou.", "src": "Hm. Goodbye then."},
{"key": "data.voice.nordic.leaving.0", "text": "Půjdu. To nevadí.", "src": "I'll go. It's fine."},
{"key": "data.voice.nordic.leaving.1", "text": "Moc dlouho. Sbohem.", "src": "Too long. Goodbye."},
{"key": "data.voice.nordic.leaving.2", "text": "Ne. Odcházím.", "src": "No. I'm leaving."},
{"key": "data.voice.nordic.order.0", "text": "{drink}. Díky.", "src": "A {drink}. Thanks."},
{"key": "data.voice.nordic.order.1", "text": "Prosím: {drink}.", "src": "{drink}, please."},
{"key": "data.voice.nordic.order.2", "text": "Jednou {drink}. Nespěchá to.", "src": "One {drink}. No rush."},
{"key": "data.voice.nordic.order.3", "text": "Dám si: {drink}.", "src": "I'll have the {drink}."},
{"key": "data.voice.nordic.perfect.0", "text": "Skål!", "src": "Skål!"},
{"key": "data.voice.nordic.perfect.1", "text": "Moc dobré.", "src": "Very good."},
{"key": "data.voice.nordic.perfect.2", "text": "Ano. Dobré.", "src": "Yes. Good."},
{"key": "data.voice.nordic.praise.0", "text": "Tohle je moc dobré. To neříkám často.", "src": "This is very good. I don't say that."},
{"key": "data.voice.nordic.praise.1", "text": "Skål. Pořádně uděláno.", "src": "Skål. Properly done."},
{"key": "data.voice.nordic.praise.2", "text": "Dobré. Fakt dobré.", "src": "Good. Really good."},
{"key": "data.voice.nordic.sip.0", "text": "No. {advice}", "src": "Well. {advice}"},
{"key": "data.voice.nordic.sip.1", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.nordic.sip.2", "text": "Dobré, ale {advice_l}", "src": "Fine, but {advice_l}"},
{"key": "data.voice.nordic.wrong.0", "text": "Ne. Špatný.", "src": "No. Wrong one."},
{"key": "data.voice.nordic.wrong.1", "text": "Tohle to není.", "src": "This is not it."},
{"key": "data.voice.nordic.wrong.2", "text": "Hm. Není moje.", "src": "Hm. Not mine."},
{"key": "data.voice.southern.another.0", "text": "Nalij mi další!", "src": "Pour me another!"},
{"key": "data.voice.southern.another.1", "text": "Ještě jednu, sugar!", "src": "One more, sugar!"},
{"key": "data.voice.southern.another.2", "text": "Jen ať to jede!", "src": "Keep 'em comin'!"},
{"key": "data.voice.southern.close.0", "text": "To je v pořádku.", "src": "That's alright."},
{"key": "data.voice.southern.close.1", "text": "Budiž.", "src": "Fair enough."},
{"key": "data.voice.southern.close.2", "text": "Well, ujde to.", "src": "Well, it'll do."},
{"key": "data.voice.southern.kicked.0", "text": "Well, to je ale nezdvořilé.", "src": "Well, that's just rude."},
{"key": "data.voice.southern.kicked.1", "text": "Alright. Měj se hezky.", "src": "Alright then. Have a good one."},
{"key": "data.voice.southern.kicked.2", "text": "Moment, počkej… tak jo.", "src": "Now hold on… fine."},
{"key": "data.voice.southern.leaving.0", "text": "Well, nemám na to celou noc.", "src": "Well, I ain't got all night."},
{"key": "data.voice.southern.leaving.1", "text": "Asi si dám jinde.", "src": "Reckon I'll drink elsewhere."},
{"key": "data.voice.southern.leaving.2", "text": "Y'all si tu dáváte na čas, co?", "src": "Y'all take your sweet time, don't you."},
{"key": "data.voice.southern.order.0", "text": "Well now, co takhle: {drink}?", "src": "Well now, a {drink} would suit me."},
{"key": "data.voice.southern.order.1", "text": "{drink}, darlin', jestli můžeš.", "src": "{drink}, darlin', if you please."},
{"key": "data.voice.southern.order.2", "text": "Asi si dám: {drink}.", "src": "Reckon I'll have a {drink}."},
{"key": "data.voice.southern.order.3", "text": "Jednou {drink}, sugar.", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "No není to paráda!", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "Lord, to je dobré!", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "Hot dang!", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "Well, I'll be. Tohle je pořádný drink.", "src": "Well, I'll be. That's a proper drink."},
{"key": "data.voice.southern.praise.1", "text": "Darlin', ty máš talent.", "src": "Darlin', you got a gift."},
{"key": "data.voice.southern.praise.2", "text": "Tohle bude asi můj nový podnik.", "src": "Reckon I found my new spot."},
