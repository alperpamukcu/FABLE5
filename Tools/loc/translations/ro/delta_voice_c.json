{"strings": [
{"key": "data.voice.aussie.another.0", "text": "Tot la fel, mate!", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "Mai una, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "Încă una, legendă!", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "Yeah, righto.", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "Nu-i rea, mate.", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "Merge și așa.", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "Serios, mate?", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto. Corect, fie.", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Nah, asta-i dur.", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto, am așteptat destul.", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Nah, las-o baltă. Am plecat.", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "Mersi de nimic, mate.", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "{drink}, mate.", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink}, te rog.", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "Iau și eu: {drink}.", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "{drink}, cheers.", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "Ripper!", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "Too easy!", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "Al naibii de bună!", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "Bloody ripper, mate. Mersi.", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "Too easy. Te pricepi.", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "Cea mai bună din seara asta, sincer.", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "Uite, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "No dramas, dar {advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Nah, mate.", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "Nu e a mea, sorry.", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "Greșită, mate.", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "Încă o rundă!", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "Încă una la fel!", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "Mai adu, nu te opri!", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "Mersi.", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "Merge.", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "Aproape. Trece.", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "Serios? Bine.", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "Faci o greșeală.", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "Mă rog. Păstrează-ți barul.", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "Lasă. M-am săturat să aștept.", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "Lucrează cineva în seara asta?", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "Bine. Beau în altă parte.", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink}, te rog.", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "Eu iau: {drink}.", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "{drink}, când ai o secundă.", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "Hai să fie: {drink}.", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "Perfect!", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "Asta e!", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "Fix cum trebuie!", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "N-aș schimba nimic.", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "Asta da băutură.", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "Cine te-a învățat, să-i mulțumești.", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice} Zic și eu.", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "Sincer? {advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "Nu asta am cerut.", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "Băutură greșită.", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "Asta nu e a mea.", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "Encore, te rog!", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "Încă una, oui!", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "Încă o dată, merci!", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ça va.", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "E în regulă.", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon, bine.", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "Quoi? Pe bune?", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Bon. Au revoir.", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule. Ridicol.", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non. Am așteptat destul.", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis. Plec.", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "Atunci, au revoir.", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "{drink}, s'il vous plaît.", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "{drink}, te rog.", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "Pentru mine: {drink}, merci.", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "Eu iau: {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "Parfait!", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "Voilà, perfectă!", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "Magnifique!", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait. N-am absolut nimic de zis.", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voilà. Cineva de aici chiar știe să toarne.", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique. Sincer.", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Écoute, {advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon, {advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors, {advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non.", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "Nu asta e.", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon, e greșită.", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "Mou ippai! Încă una!", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "Încă una, kanpai!", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "Încă o dată, onegai!", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Okay, e în regulă.", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa. Merge.", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "Nu-i rea, ne.", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "Eh?! Pe bune?", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi. Bine, plec.", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta. Sayonara.", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen, nu mai pot aștepta.", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii. Plec.", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai. La revedere.", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen, {drink}.", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "{drink}, onegai.", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink}, te rog. Arigatou.", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto… {drink}.", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "Oishii!", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "Sugoi, perfectă!", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "Kanpai!", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii. Sincer, asta e.", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "Sugoi. Chiar ești pro, ne.", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "Kanpai. E perfectă.", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "Etto, {advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "Ne, {advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "Sumimasen, dar {advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "Chotto… nu.", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "Eh? Nu asta.", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "Chigau, scuze.", "src": "Chigau, sorry."},
{"key": "data.voice.midwest.another.0", "text": "Încă una, dacă se poate!", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "Mai una, mersi!", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "Ope, încă una la fel!", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "Oh, e în regulă.", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "Sigur, mersi.", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "Chiar nu-i rea.", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "Oh. Păi. Bine atunci.", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "Ope, scuze… plec.", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "E cam mult, dar okay.", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "Oh gosh, chiar nu mai pot aștepta.", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "Păi, cred că ar trebui să plec.", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "Scuze, dar eu o iau din loc.", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "Aș putea primi: {drink}? Mersi mult.", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "{drink}, dacă nu e cu deranj.", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "Oh, pentru mine doar: {drink}.", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink}, te rog. Când ai timp.", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "Oh, chiar bună!", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "You betcha!", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "Oh jeez, da!", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "Oh my gosh, e pur și simplu minunată.", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "Chiar bună. Mătușii mele i-ar plăcea localul.", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "Ei, exact de asta aveam nevoie.", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "Oh, {advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "Doar ca să știi, {advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "Nu-i mare lucru, dar {advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "Ope. Greșită.", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "Oh, asta nu e a mea.", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "Scuze, nu. Nu asta.", "src": "Sorry, no. Not this."},
{"key": "data.voice.polish.another.0", "text": "Jeszcze raz! Încă una!", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "Încă una, proszę!", "src": "Another, proszę!"},
{"key": "data.voice.polish.another.2", "text": "Mai una!", "src": "One more!"},
{"key": "data.voice.polish.close.0", "text": "Dobrze. Merge.", "src": "Dobrze."},
{"key": "data.voice.polish.close.1", "text": "Okay.", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "Bine, mersi.", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "Serio? Okay.", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "Bine. Do widzenia.", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "Co? Bine, plec.", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "Ajunge. Plec.", "src": "Enough. I'm going."},
{"key": "data.voice.polish.leaving.1", "text": "Nie, nie. Durează prea mult.", "src": "Nie, nie. Too long."},
{"key": "data.voice.polish.leaving.2", "text": "Do widzenia. Cu bine.", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "{drink}, proszę.", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "{drink}, te rog.", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "{drink}. Mulțumesc.", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "Dobrze, atunci: {drink}.", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "Na zdrowie!", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "Świetnie!", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "Foarte bună!", "src": "Very good!"},
{"key": "data.voice.polish.praise.0", "text": "Na zdrowie. Asta e băutură adevărată.", "src": "Na zdrowie. This is a real drink."},
{"key": "data.voice.polish.praise.1", "text": "Świetnie. Ca acasă.", "src": "Świetnie. Like at home."},
{"key": "data.voice.polish.praise.2", "text": "Dobrze. Foarte, foarte bună.", "src": "Dobrze. Very, very good."},
{"key": "data.voice.polish.sip.0", "text": "Dobrze, dar {advice_l}", "src": "Dobrze, but {advice_l}"},
{"key": "data.voice.polish.sip.1", "text": "Ascultă, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.polish.sip.2", "text": "Hm, {advice_l}", "src": "Hm, {advice_l}"},
{"key": "data.voice.polish.wrong.0", "text": "Nie. E greșită.", "src": "Nie. Wrong one."},
{"key": "data.voice.polish.wrong.1", "text": "Asta nu e a mea.", "src": "This is not mine."},
{"key": "data.voice.polish.wrong.2", "text": "Co to jest? Ce-i asta?", "src": "Co to jest?"},
{"key": "data.voice.turkish.another.0", "text": "Bir daha! Încă una!", "src": "Bir daha!"},
{"key": "data.voice.turkish.another.1", "text": "Încă una, abi!", "src": "Another, abi!"},
{"key": "data.voice.turkish.another.2", "text": "Încă o dată, eyvallah!", "src": "Again, eyvallah!"},
{"key": "data.voice.turkish.close.0", "text": "Tamam, merge.", "src": "Tamam."},
{"key": "data.voice.turkish.close.1", "text": "İdare eder.", "src": "İdare eder."},
{"key": "data.voice.turkish.close.2", "text": "Okay, bine.", "src": "Okay, fine."},
{"key": "data.voice.turkish.kicked.0", "text": "Ciddi misin? Okay.", "src": "Ciddi misin? Okay."},
{"key": "data.voice.turkish.kicked.1", "text": "Abi, pe bune? Bine.", "src": "Abi, really? Fine."},
{"key": "data.voice.turkish.kicked.2", "text": "Yok, yok. Plec.", "src": "Yok, yok. I'm going."},
{"key": "data.voice.turkish.leaving.0", "text": "Yok, nu mai aștept.", "src": "Yok, I'm not waiting anymore."},
{"key": "data.voice.turkish.leaving.1", "text": "Abi, nu lucrează nimeni aici?", "src": "Abi, is nobody working here?"},
{"key": "data.voice.turkish.leaving.2", "text": "Tamam, hoşça kal.", "src": "Tamam, hoşça kal."},
{"key": "data.voice.turkish.order.0", "text": "Abi, {drink}.", "src": "Abi, a {drink}."},
{"key": "data.voice.turkish.order.1", "text": "{drink}, eyvallah.", "src": "One {drink}, eyvallah."},
{"key": "data.voice.turkish.order.2", "text": "{drink}, canım, când poți.", "src": "{drink}, canım, when you can."},
{"key": "data.voice.turkish.order.3", "text": "Bir {drink}, te rog.", "src": "Bir {drink}, please."},
{"key": "data.voice.turkish.perfect.0", "text": "Eyvallah!", "src": "Eyvallah!"},
{"key": "data.voice.turkish.perfect.1", "text": "Harika!", "src": "Harika!"},
{"key": "data.voice.turkish.perfect.2", "text": "Süper, abi!", "src": "Süper, abi!"},
{"key": "data.voice.turkish.praise.0", "text": "Eyvallah. Așa se face.", "src": "Eyvallah. This is how it's done."},
{"key": "data.voice.turkish.praise.1", "text": "Abi, jos pălăria. Harika.", "src": "Abi, my hat is off. Harika."},
{"key": "data.voice.turkish.praise.2", "text": "Tamam, îți știi meseria.", "src": "Tamam, you know your work."},
