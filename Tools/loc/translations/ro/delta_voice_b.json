{"strings": [
{"key": "data.voice.arabic.another.0", "text": "Kaman wahad! Încă una!", "src": "Kaman wahad!"},
{"key": "data.voice.arabic.another.1", "text": "Încă una, yalla!", "src": "One more, yalla!"},
{"key": "data.voice.arabic.another.2", "text": "Încă o dată, habibi!", "src": "Again, habibi!"},
{"key": "data.voice.arabic.close.0", "text": "Maashi, merge.", "src": "Maashi."},
{"key": "data.voice.arabic.close.1", "text": "E în regulă.", "src": "It is okay."},
{"key": "data.voice.arabic.close.2", "text": "Tamam, shukran.", "src": "Tamam, shukran."},
{"key": "data.voice.arabic.kicked.0", "text": "Shu? Serios?", "src": "Shu? Seriously?"},
{"key": "data.voice.arabic.kicked.1", "text": "Khalas. Bine.", "src": "Khalas. Fine."},
{"key": "data.voice.arabic.kicked.2", "text": "Yalla. Plec.", "src": "Yalla. I go."},
{"key": "data.voice.arabic.leaving.0", "text": "Khalas. Eu plec.", "src": "Khalas. I am going."},
{"key": "data.voice.arabic.leaving.1", "text": "Yalla, destul am așteptat.", "src": "Yalla, enough waiting."},
{"key": "data.voice.arabic.leaving.2", "text": "Maa salama. Cu bine.", "src": "Maa salama."},
{"key": "data.voice.arabic.order.0", "text": "{drink}, te rog.", "src": "A {drink}, please."},
{"key": "data.voice.arabic.order.1", "text": "{drink}, shukran.", "src": "One {drink}, shukran."},
{"key": "data.voice.arabic.order.2", "text": "Habibi, pentru mine: {drink}.", "src": "Habibi, a {drink}."},
{"key": "data.voice.arabic.order.3", "text": "Eu iau: {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.arabic.perfect.0", "text": "Ya salam!", "src": "Ya salam!"},
{"key": "data.voice.arabic.perfect.1", "text": "Helu kteer!", "src": "Helu kteer!"},
{"key": "data.voice.arabic.perfect.2", "text": "Perfectă, habibi!", "src": "Perfect, habibi!"},
{"key": "data.voice.arabic.praise.0", "text": "Ya salam. Asta e, habibi.", "src": "Ya salam. This is the one, habibi."},
{"key": "data.voice.arabic.praise.1", "text": "Helu kteer. Shukran, pe bune.", "src": "Helu kteer. Shukran."},
{"key": "data.voice.arabic.praise.2", "text": "Yalla, îți știi meseria.", "src": "Yalla, you know your work."},
{"key": "data.voice.arabic.sip.0", "text": "Habibi, {advice_l}", "src": "Habibi, {advice_l}"},
{"key": "data.voice.arabic.sip.1", "text": "Shuf, {advice_l}", "src": "Shuf, {advice_l}"},
{"key": "data.voice.arabic.sip.2", "text": "Tamam, doar că {advice_l}", "src": "Tamam, bas {advice_l}"},
{"key": "data.voice.arabic.wrong.0", "text": "La, la. Nu.", "src": "La, la."},
{"key": "data.voice.arabic.wrong.1", "text": "Nu asta e.", "src": "This is not it."},
{"key": "data.voice.arabic.wrong.2", "text": "Shu hada? Ce-i asta?", "src": "Shu hada?"},
{"key": "data.voice.chinese.another.0", "text": "Zai lai yi bei! Încă una!", "src": "Zai lai yi bei!"},
{"key": "data.voice.chinese.another.1", "text": "Încă una, ah!", "src": "One more, ah!"},
{"key": "data.voice.chinese.another.2", "text": "Încă o dată, te rog!", "src": "Again, please!"},
{"key": "data.voice.chinese.close.0", "text": "Hai keyi. Merge.", "src": "Hai keyi."},
{"key": "data.voice.chinese.close.1", "text": "Okay lah.", "src": "Okay lah."},
{"key": "data.voice.chinese.close.2", "text": "E bine.", "src": "It is fine."},
{"key": "data.voice.chinese.kicked.0", "text": "Shenme? Pe bune?", "src": "Shenme? Really?"},
{"key": "data.voice.chinese.kicked.1", "text": "Aiya. Bine.", "src": "Aiya. Fine."},
{"key": "data.voice.chinese.kicked.2", "text": "Hao. Plec.", "src": "Hao. I leave."},
{"key": "data.voice.chinese.leaving.0", "text": "Aiya. Am așteptat prea mult.", "src": "Aiya. I waited too long."},
{"key": "data.voice.chinese.leaving.1", "text": "Suan le. Mă duc.", "src": "Suan le. I go."},
{"key": "data.voice.chinese.leaving.2", "text": "Atunci zaijian.", "src": "Zaijian, then."},
{"key": "data.voice.chinese.order.0", "text": "{drink}, te rog.", "src": "{drink}, please."},
{"key": "data.voice.chinese.order.1", "text": "{drink}, xiexie.", "src": "One {drink}, xiexie."},
{"key": "data.voice.chinese.order.2", "text": "Eu iau: {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.chinese.order.3", "text": "Pentru mine: {drink}.", "src": "A {drink} for me."},
{"key": "data.voice.chinese.perfect.0", "text": "Hen hao!", "src": "Hen hao!"},
{"key": "data.voice.chinese.perfect.1", "text": "Perfectă, ah!", "src": "Perfect, ah!"},
{"key": "data.voice.chinese.perfect.2", "text": "Zhen bang!", "src": "Zhen bang!"},
{"key": "data.voice.chinese.praise.0", "text": "Zhen bang. Revin pentru asta.", "src": "Zhen bang. I will come back for this."},
{"key": "data.voice.chinese.praise.1", "text": "Hen hao. Știi ce faci.", "src": "Hen hao. You know what you are doing."},
{"key": "data.voice.chinese.praise.2", "text": "Perfectă, ah. Pe bune.", "src": "Perfect, ah. Really."},
{"key": "data.voice.chinese.sip.0", "text": "Ai, {advice_l}", "src": "Ai, {advice_l}"},
{"key": "data.voice.chinese.sip.1", "text": "Ascultă, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.chinese.sip.2", "text": "Hao, dar {advice_l}", "src": "Hao, but {advice_l}"},
{"key": "data.voice.chinese.wrong.0", "text": "Bu dui. Greșit.", "src": "Bu dui."},
{"key": "data.voice.chinese.wrong.1", "text": "Aiya, nu.", "src": "Aiya, no."},
{"key": "data.voice.chinese.wrong.2", "text": "Nu asta.", "src": "Not this one."},
{"key": "data.voice.filipino.another.0", "text": "Isa pa! Încă una!", "src": "Isa pa!"},
{"key": "data.voice.filipino.another.1", "text": "Încă una, ha!", "src": "One more, ha!"},
{"key": "data.voice.filipino.another.2", "text": "Încă o dată, te rog!", "src": "Again, please!"},
{"key": "data.voice.filipino.close.0", "text": "Okay lang.", "src": "Okay lang."},
{"key": "data.voice.filipino.close.1", "text": "Sige, mersi.", "src": "Sige, thanks."},
{"key": "data.voice.filipino.close.2", "text": "Ay, e bine.", "src": "Ay, it's fine."},
{"key": "data.voice.filipino.kicked.0", "text": "Ha? Pe bune?", "src": "Ha? Really?"},
{"key": "data.voice.filipino.kicked.1", "text": "Ay. Bine. Pa.", "src": "Ay. Okay. Bye."},
{"key": "data.voice.filipino.kicked.2", "text": "Grabe naman. Serios?", "src": "Grabe naman."},
{"key": "data.voice.filipino.leaving.0", "text": "Ay, grabe. Prea mult. Plec.", "src": "Ay, grabe. Too long. I'm going."},
{"key": "data.voice.filipino.leaving.1", "text": "Sige na, pa.", "src": "Sige na, bye."},
{"key": "data.voice.filipino.leaving.2", "text": "Naku, nu vine nimeni.", "src": "Naku, no one is coming."},
{"key": "data.voice.filipino.order.0", "text": "Ay, {drink}, te rog.", "src": "Ay, one {drink}, please."},
{"key": "data.voice.filipino.order.1", "text": "Pentru mine: {drink}. Salamat.", "src": "{drink} for me. Salamat."},
{"key": "data.voice.filipino.order.2", "text": "Îmi dai și mie: {drink}? Mersi, ha.", "src": "Can I have a {drink}? Thanks, ha."},
{"key": "data.voice.filipino.order.3", "text": "{drink}, kuya.", "src": "A {drink}, kuya."},
{"key": "data.voice.filipino.perfect.0", "text": "Ay, sarap!", "src": "Ay, sarap!"},
{"key": "data.voice.filipino.perfect.1", "text": "Grabe, da!", "src": "Grabe, yes!"},
{"key": "data.voice.filipino.perfect.2", "text": "Perfectă, kuya!", "src": "Perfect, kuya!"},
{"key": "data.voice.filipino.praise.0", "text": "Grabe. E atât de bună. Salamat.", "src": "Grabe. That is so good. Salamat."},
{"key": "data.voice.filipino.praise.1", "text": "Ay, sarap. Mi-ai salvat toată tura.", "src": "Ay, sarap. You made my whole shift."},
{"key": "data.voice.filipino.praise.2", "text": "Sige, revin pentru asta.", "src": "Sige, I'm coming back for this."},
{"key": "data.voice.filipino.sip.0", "text": "Ay, {advice_l}", "src": "Ay, {advice_l}"},
{"key": "data.voice.filipino.sip.1", "text": "Sige, dar {advice_l}", "src": "Sige, but {advice_l}"},
{"key": "data.voice.filipino.sip.2", "text": "Ha? {advice}", "src": "Ha? {advice}"},
{"key": "data.voice.filipino.wrong.0", "text": "Ay, hindi. Nu asta.", "src": "Ay, hindi. Not this."},
{"key": "data.voice.filipino.wrong.1", "text": "Grabe, băutură greșită.", "src": "Grabe, wrong drink."},
{"key": "data.voice.filipino.wrong.2", "text": "Nu e a mea, kuya.", "src": "Not mine, kuya."},
{"key": "data.voice.italian.another.0", "text": "Ancora, dai!", "src": "Ancora, dai!"},
{"key": "data.voice.italian.another.1", "text": "Încă una, grazie!", "src": "Another, grazie!"},
{"key": "data.voice.italian.another.2", "text": "Încă o dată, amore!", "src": "Once more, amore!"},
{"key": "data.voice.italian.close.0", "text": "Va bene, merge.", "src": "Va bene."},
{"key": "data.voice.italian.close.1", "text": "Bine, grazie.", "src": "Okay, grazie."},
{"key": "data.voice.italian.close.2", "text": "Nu-i rea, eh.", "src": "Not bad, eh."},
{"key": "data.voice.italian.kicked.0", "text": "Ma dai! Pe bune?", "src": "Ma dai! Really?"},
{"key": "data.voice.italian.kicked.1", "text": "Va bene. Ciao, ciao.", "src": "Va bene. Ciao, ciao."},
{"key": "data.voice.italian.kicked.2", "text": "Che maleducato. Ce nepoliticos.", "src": "Che maleducato."},
{"key": "data.voice.italian.leaving.0", "text": "Basta. Plec.", "src": "Basta. I go."},
{"key": "data.voice.italian.leaving.1", "text": "Mamma mia, cât aștept!", "src": "Mamma mia, the waiting!"},
{"key": "data.voice.italian.leaving.2", "text": "Ciao. Poate în altă viață.", "src": "Ciao. Maybe next life."},
{"key": "data.voice.italian.order.0", "text": "{drink}, per favore.", "src": "Un {drink}, per favore."},
{"key": "data.voice.italian.order.1", "text": "{drink}, amore.", "src": "A {drink}, amore."},
{"key": "data.voice.italian.order.2", "text": "Pentru mine: {drink}, grazie.", "src": "{drink}, grazie."},
{"key": "data.voice.italian.order.3", "text": "Dai, dă-mi: {drink}.", "src": "Dai, a {drink}."},
{"key": "data.voice.italian.perfect.0", "text": "Perfetto!", "src": "Perfetto!"},
{"key": "data.voice.italian.perfect.1", "text": "Bravo!", "src": "Bravo!"},
{"key": "data.voice.italian.perfect.2", "text": "Che buono!", "src": "Che buono!"},
{"key": "data.voice.italian.praise.0", "text": "Perfetto. Pe bune. Grazie mille.", "src": "Perfetto. Truly. Grazie mille."},
{"key": "data.voice.italian.praise.1", "text": "Bravo. Nonna mea ar plânge.", "src": "Bravo. My nonna would cry."},
{"key": "data.voice.italian.praise.2", "text": "Che buono. Nu mai plec.", "src": "Che buono. I'm not leaving."},
{"key": "data.voice.italian.sip.0", "text": "Senti, {advice_l}", "src": "Senti, {advice_l}"},
{"key": "data.voice.italian.sip.1", "text": "Allora, {advice_l}", "src": "Allora, {advice_l}"},
{"key": "data.voice.italian.sip.2", "text": "Va bene, ma {advice_l}", "src": "Va bene, ma {advice_l}"},
{"key": "data.voice.italian.wrong.0", "text": "Mamma mia, nu.", "src": "Mamma mia, no."},
{"key": "data.voice.italian.wrong.1", "text": "Ma che cos'è? Ce-i asta?", "src": "Ma che cos'è?"},
{"key": "data.voice.italian.wrong.2", "text": "Nu, nu. Nu asta.", "src": "No, no. Not this."},
{"key": "data.voice.miami.another.0", "text": "¡Otra, dale! Încă una!", "src": "¡Otra, dale!"},
{"key": "data.voice.miami.another.1", "text": "Încă una, oye!", "src": "One more, oye!"},
{"key": "data.voice.miami.another.2", "text": "Încă o dată, mi amor!", "src": "Again, mi amor!"},
{"key": "data.voice.miami.close.0", "text": "Está bien, merge.", "src": "Está bien."},
{"key": "data.voice.miami.close.1", "text": "Nu-i rea, chico.", "src": "Not bad, chico."},
{"key": "data.voice.miami.close.2", "text": "Okay, okay.", "src": "Okay, okay."},
{"key": "data.voice.miami.kicked.0", "text": "¿En serio? Okay, fie.", "src": "¿En serio? Okay, fine."},
{"key": "data.voice.miami.kicked.1", "text": "Glumești, chico.", "src": "You're kidding me, chico."},
{"key": "data.voice.miami.kicked.2", "text": "Dale. Tu pierzi.", "src": "Dale. Your loss."},
{"key": "data.voice.miami.leaving.0", "text": "¡Oye! Stau aici de toată seara.", "src": "¡Oye! I've been sitting here all night."},
{"key": "data.voice.miami.leaving.1", "text": "Bueno, gata. Ciao.", "src": "Bueno, that's it. Ciao."},
{"key": "data.voice.miami.leaving.2", "text": "No, no. Nu mai aștept.", "src": "No, no. I'm not waiting anymore."},
{"key": "data.voice.miami.order.0", "text": "Oye, pentru mine: {drink}.", "src": "Oye, a {drink} for me."},
{"key": "data.voice.miami.order.1", "text": "Dale, {drink}.", "src": "Dale, one {drink}."},
{"key": "data.voice.miami.order.2", "text": "{drink}, papi, când poți.", "src": "{drink}, papi, when you can."},
{"key": "data.voice.miami.order.3", "text": "Mi amor, dă-mi: {drink}.", "src": "Mi amor, a {drink}."},
{"key": "data.voice.miami.perfect.0", "text": "¡Qué rico!", "src": "¡Qué rico!"},
{"key": "data.voice.miami.perfect.1", "text": "¡Eso es! Asta e!", "src": "¡Eso es!"},
{"key": "data.voice.miami.perfect.2", "text": "Dale, perfectă!", "src": "¡Dale, perfecto!"},
{"key": "data.voice.miami.praise.0", "text": "Ay, asta e. Gracias.", "src": "Ay, this is the one. Gracias."},
{"key": "data.voice.miami.praise.1", "text": "Abuela mea ar aproba, și ea nu aprobă nimic.", "src": "My abuela would approve, and she approves of nothing."},
{"key": "data.voice.miami.praise.2", "text": "Dale. Știi ce faci.", "src": "Dale. You know what you're doing."},
{"key": "data.voice.miami.sip.0", "text": "Mira, {advice_l}", "src": "Mira, {advice_l}"},
{"key": "data.voice.miami.sip.1", "text": "Oye, {advice_l}", "src": "Oye, {advice_l}"},
{"key": "data.voice.miami.sip.2", "text": "Está bien, dar… {advice_l}", "src": "Está bien, pero… {advice_l}"},
{"key": "data.voice.miami.wrong.0", "text": "¿Qué es esto? Ce-i asta?", "src": "¿Qué es esto?"},
{"key": "data.voice.miami.wrong.1", "text": "Nu, nu, nu.", "src": "No, no, no."},
{"key": "data.voice.miami.wrong.2", "text": "Nu e a mea, oye.", "src": "Not mine, oye."},
{"key": "data.voice.nyc.another.0", "text": "Mai dă-mi una!", "src": "Hit me again!"},
{"key": "data.voice.nyc.another.1", "text": "Dă-le încoace, nu te opri!", "src": "Keep 'em comin'!"},
{"key": "data.voice.nyc.another.2", "text": "Încă una, șefu'!", "src": "Another, chief!"},
{"key": "data.voice.nyc.close.0", "text": "Eh. Merge.", "src": "Eh. It's fine."},
{"key": "data.voice.nyc.close.1", "text": "Yeah, bine.", "src": "Yeah, alright."},
{"key": "data.voice.nyc.close.2", "text": "Trece.", "src": "It'll do."},
{"key": "data.voice.nyc.kicked.0", "text": "Vorbești serios acum?", "src": "You serious right now?"},
{"key": "data.voice.nyc.kicked.1", "text": "Bine. Oricum e un bar jalnic.", "src": "Fine. Terrible bar anyway."},
{"key": "data.voice.nyc.kicked.2", "text": "Wow. Okay. Wow.", "src": "Wow. Okay. Wow."},
{"key": "data.voice.nyc.leaving.0", "text": "Am treabă. Las-o baltă.", "src": "I got places to be. Forget it."},
{"key": "data.voice.nyc.leaving.1", "text": "Incredibil. Am plecat.", "src": "Unbelievable. I'm outta here."},
{"key": "data.voice.nyc.leaving.2", "text": "Yo, e bar sau sală de așteptare?", "src": "Yo, is this a bar or a waiting room?"},
{"key": "data.voice.nyc.order.0", "text": "Yo, dă-mi: {drink}.", "src": "Yo, lemme get a {drink}."},
{"key": "data.voice.nyc.order.1", "text": "{drink}. Și mă grăbesc.", "src": "{drink}. And I'm in a hurry."},
{"key": "data.voice.nyc.order.2", "text": "Adu-mi: {drink}, șefu'.", "src": "Gimme a {drink}, chief."},
{"key": "data.voice.nyc.order.3", "text": "{drink}. Fără figuri.", "src": "{drink}. Don't make it weird."},
{"key": "data.voice.nyc.perfect.0", "text": "Așa da!", "src": "Now we're talkin'!"},
{"key": "data.voice.nyc.perfect.1", "text": "Asta da, marfă!", "src": "That's the stuff!"},
{"key": "data.voice.nyc.perfect.2", "text": "Oh, asta e!", "src": "Oh, that's it!"},
{"key": "data.voice.nyc.praise.0", "text": "Okay, m-ai impresionat. Nu se întâmplă niciodată.", "src": "Okay, I'm impressed. That never happens."},
{"key": "data.voice.nyc.praise.1", "text": "Să-ți zic ceva: asta e băutură.", "src": "Lemme tell ya, that's a drink."},
{"key": "data.voice.nyc.praise.2", "text": "Ar trebui să ceri mai mult pe ea. Nu cere.", "src": "You should charge more for this. Don't."},
{"key": "data.voice.nyc.sip.0", "text": "Uite, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.nyc.sip.1", "text": "Doar zic, {advice_l}", "src": "I'm just sayin', {advice_l}"},
{"key": "data.voice.nyc.sip.2", "text": "Nu-i rea, dar {advice_l}", "src": "Not bad, but {advice_l}"},
{"key": "data.voice.nyc.wrong.0", "text": "Ce-i asta?", "src": "What is this?"},
{"key": "data.voice.nyc.wrong.1", "text": "Fuhgeddaboudit.", "src": "Fuhgeddaboudit."},
{"key": "data.voice.nyc.wrong.2", "text": "Greșită, amice.", "src": "Wrong one, pal."},
{"key": "data.voice.surfer.another.0", "text": "Încă una, dude!", "src": "One more, dude!"},
{"key": "data.voice.surfer.another.1", "text": "Încă, încă!", "src": "Again, again!"},
{"key": "data.voice.surfer.another.2", "text": "Să vină valul următor!", "src": "Keep 'em rolling!"},
{"key": "data.voice.surfer.close.0", "text": "Cool, cool.", "src": "Cool, cool."},
{"key": "data.voice.surfer.close.1", "text": "Da, merge.", "src": "Yeah, that works."},
{"key": "data.voice.surfer.close.2", "text": "Destul de nice.", "src": "Nice enough."},
{"key": "data.voice.surfer.kicked.0", "text": "Dur, dude.", "src": "Harsh, dude."},
{"key": "data.voice.surfer.kicked.1", "text": "Okay… și ăsta e un vibe.", "src": "Okay… that's a vibe."},
{"key": "data.voice.surfer.kicked.2", "text": "Wow. Deloc chill.", "src": "Wow. Not chill."},
{"key": "data.voice.surfer.leaving.0", "text": "Dude, stau aici de-o veșnicie.", "src": "Dude, I've been here forever."},
{"key": "data.voice.surfer.leaving.1", "text": "Nu-i cool. Am ieșit.", "src": "Not cool. I'm out."},
{"key": "data.voice.surfer.leaving.2", "text": "Da, nu. Mă car.", "src": "Yeah, no. Bailing."},
{"key": "data.voice.surfer.order.0", "text": "Dude, {drink}.", "src": "Dude, a {drink}."},
{"key": "data.voice.surfer.order.1", "text": "Pot să iau, gen: {drink}?", "src": "Can I get, like, a {drink}?"},
{"key": "data.voice.surfer.order.2", "text": "{drink}, te rog. Chill, fără grabă.", "src": "{drink}, please. Chill, no rush."},
{"key": "data.voice.surfer.order.3", "text": "Da, sună epic: {drink}.", "src": "Yeah, a {drink} sounds epic."},
{"key": "data.voice.surfer.perfect.0", "text": "Dude. Da.", "src": "Dude. Yes."},
{"key": "data.voice.surfer.perfect.1", "text": "Super stoked!", "src": "Stoked!"},
{"key": "data.voice.surfer.perfect.2", "text": "Ce bună!", "src": "So good!"},
{"key": "data.voice.surfer.praise.0", "text": "Okay, chiar e perfectă. Respect.", "src": "Okay, that's actually perfect. Respect."},
