{"strings": [
{"key": "data.voice.african.another.0", "text": "Mai adu una!", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "Încă una, abeg!", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "Încă o dată, prietene!", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "E în regulă.", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "No wahala, merge.", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "Bine, mulțumesc.", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "Ah ah! Serios?", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala. Plec.", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "Prietene, asta nu e frumos.", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah ah. Am așteptat destul.", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala. Eu plec.", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "Mă duc, prietene.", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "{drink}, te rog frumos.", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "Prietene, adu-mi: {drink}.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Eu iau: {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "{drink}, abeg.", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "Ah, ce bună!", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "Corect!", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "Asta e faină!", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, asta e corectă. Mulțumesc.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "Nicio wahala. Foarte bună.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "Prietene, tu chiar știi carte.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "Prietene, {advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg, {advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "E bună, dar {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah, nu.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "Nu asta e.", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "Prietene, nu.", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "La fel, mate!", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "Încă una, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "Hai, încă una!", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "Nu-i rău.", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Ta, merge și așa.", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "Bine, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Încântător. Absolut încântător.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "Right. Ei bine. Cheers pentru nimic.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "Glumești, nu?", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Right. Am așteptat destul.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "Las-o baltă. Am plecat.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Cam jalnic, sincer. Bye.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "{drink}, mate, când ai un moment.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, te rog. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "Hai, fie: {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "Iau: {drink}, ta.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "Lovely!", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "Mersi, mate!", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "Bună de tot!", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Blimey. Chiar e lovely.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Ai făcut-o ca la carte.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Al naibii de bună.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "Un mic detaliu: {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Uite, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Cam pe lângă.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Ăăă, nu e a mea.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "Nu asta am cerut.", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "Încă una, yaar!", "src": "One more, yaar!"},
{"key": "data.voice.desi.another.1", "text": "Aur ek! Încă una!", "src": "Aur ek!"},
{"key": "data.voice.desi.another.2", "text": "Încă o dată, te rog!", "src": "Again, please!"},
{"key": "data.voice.desi.close.0", "text": "Theek hai, merge.", "src": "Theek hai."},
{"key": "data.voice.desi.close.1", "text": "E okay, na.", "src": "It is okay, na."},
{"key": "data.voice.desi.close.2", "text": "Chalega. Se poate.", "src": "Chalega."},
{"key": "data.voice.desi.kicked.0", "text": "Kya? Serios?", "src": "Kya? Seriously?"},
{"key": "data.voice.desi.kicked.1", "text": "Arre. Bine, fie.", "src": "Arre. Okay, fine."},
{"key": "data.voice.desi.kicked.2", "text": "Chalo. Plec.", "src": "Chalo. I go."},
{"key": "data.voice.desi.leaving.0", "text": "Arre yaar. Durează prea mult.", "src": "Arre yaar. Too long."},
{"key": "data.voice.desi.leaving.1", "text": "Chalo, eu plec.", "src": "Chalo, I am going."},
{"key": "data.voice.desi.leaving.2", "text": "Bas. Ajunge.", "src": "Bas. Enough."},
{"key": "data.voice.desi.order.0", "text": "{drink}, te rog.", "src": "One {drink}, please."},
{"key": "data.voice.desi.order.1", "text": "{drink}, yaar.", "src": "A {drink}, yaar."},
{"key": "data.voice.desi.order.2", "text": "Eu iau: {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.desi.order.3", "text": "{drink}, na?", "src": "{drink}, na?"},
{"key": "data.voice.desi.perfect.0", "text": "Wah, perfect!", "src": "Wah, perfect!"},
{"key": "data.voice.desi.perfect.1", "text": "Ekdum clasa întâi!", "src": "Ekdum first class!"},
{"key": "data.voice.desi.perfect.2", "text": "Bahut badhiya!", "src": "Bahut badhiya!"},
{"key": "data.voice.desi.praise.0", "text": "Wah. Ekdum perfectă, yaar.", "src": "Wah. Ekdum perfect, yaar."},
{"key": "data.voice.desi.praise.1", "text": "Bahut badhiya. Pe bune.", "src": "Bahut badhiya. Really."},
{"key": "data.voice.desi.praise.2", "text": "Clasa întâi. Mai vin.", "src": "First class. I am coming back."},
{"key": "data.voice.desi.sip.0", "text": "Arre, {advice_l}", "src": "Arre, {advice_l}"},
{"key": "data.voice.desi.sip.1", "text": "Yaar, {advice_l}", "src": "Yaar, {advice_l}"},
{"key": "data.voice.desi.sip.2", "text": "Theek hai, dar {advice_l}", "src": "Theek hai, but {advice_l}"},
{"key": "data.voice.desi.wrong.0", "text": "Arre, nu.", "src": "Arre, no."},
{"key": "data.voice.desi.wrong.1", "text": "Asta nu e a mea.", "src": "This is not mine."},
{"key": "data.voice.desi.wrong.2", "text": "Nahi, e greșită.", "src": "Nahi, wrong one."},
{"key": "data.voice.german.another.0", "text": "Noch eins! Încă una!", "src": "Noch eins!"},
{"key": "data.voice.german.another.1", "text": "Încă una, bitte!", "src": "Another, bitte!"},
{"key": "data.voice.german.another.2", "text": "Încă o dată, te rog!", "src": "Again, please!"},
{"key": "data.voice.german.close.0", "text": "Ja, e în regulă.", "src": "Ja, okay."},
{"key": "data.voice.german.close.1", "text": "Acceptabil.", "src": "Acceptable."},
{"key": "data.voice.german.close.2", "text": "E bine.", "src": "It is fine."},
{"key": "data.voice.german.kicked.0", "text": "E absurd.", "src": "This is absurd."},
{"key": "data.voice.german.kicked.1", "text": "Bine. Nu mă mai întorc.", "src": "Fine. I will not return."},
{"key": "data.voice.german.kicked.2", "text": "Ja, ja. Plec.", "src": "Ja, ja. I am going."},
{"key": "data.voice.german.leaving.0", "text": "Inacceptabil. Plec.", "src": "This is not acceptable. I am leaving."},
{"key": "data.voice.german.leaving.1", "text": "Nein. Am așteptat destul.", "src": "Nein. I have waited enough."},
{"key": "data.voice.german.leaving.2", "text": "Unglaublich. La revedere.", "src": "Unglaublich. Goodbye."},
{"key": "data.voice.german.order.0", "text": "{drink}, te rog. Ca la carte.", "src": "A {drink}, please. Correctly made."},
{"key": "data.voice.german.order.1", "text": "{drink}. Mulțumesc.", "src": "{drink}. Thank you."},
{"key": "data.voice.german.order.2", "text": "{drink}, bitte.", "src": "One {drink}, bitte."},
{"key": "data.voice.german.order.3", "text": "Aș dori: {drink}.", "src": "I would like a {drink}."},
{"key": "data.voice.german.perfect.0", "text": "Genau așa!", "src": "Genau!"},
{"key": "data.voice.german.perfect.1", "text": "Sehr gut!", "src": "Sehr gut!"},
{"key": "data.voice.german.perfect.2", "text": "Wunderbar!", "src": "Wunderbar!"},
{"key": "data.voice.german.praise.0", "text": "Ja. Exact cum trebuie.", "src": "Ja. This is exactly right."},
{"key": "data.voice.german.praise.1", "text": "Precis. Respect precizia.", "src": "Precise. I respect precision."},
{"key": "data.voice.german.praise.2", "text": "Sehr gut. Nimic de obiectat.", "src": "Sehr gut. No notes."},
{"key": "data.voice.german.sip.0", "text": "Genau, dar {advice_l}", "src": "Genau, but {advice_l}"},
{"key": "data.voice.german.sip.1", "text": "O observație: {advice_l}", "src": "One remark: {advice_l}"},
{"key": "data.voice.german.sip.2", "text": "Ja, {advice_l}", "src": "Ja, {advice_l}"},
{"key": "data.voice.german.wrong.0", "text": "Nein. Nu asta.", "src": "Nein. Not this."},
{"key": "data.voice.german.wrong.1", "text": "Asta e incorect.", "src": "This is incorrect."},
{"key": "data.voice.german.wrong.2", "text": "Băutură greșită.", "src": "Wrong drink."},
{"key": "data.voice.korean.another.0", "text": "Han jan deo! Încă una!", "src": "Han jan deo!"},
{"key": "data.voice.korean.another.1", "text": "Încă una!", "src": "One more!"},
{"key": "data.voice.korean.another.2", "text": "Încă o dată, juseyo!", "src": "Again, juseyo!"},
{"key": "data.voice.korean.close.0", "text": "Gwenchana. Merge.", "src": "Gwenchana."},
{"key": "data.voice.korean.close.1", "text": "E okay.", "src": "It is okay."},
{"key": "data.voice.korean.close.2", "text": "Nappeuji anha. Nu-i rea.", "src": "Nappeuji anha."},
{"key": "data.voice.korean.kicked.0", "text": "Jinjja? Wow.", "src": "Jinjja? Wow."},
{"key": "data.voice.korean.kicked.1", "text": "Aish. Bine.", "src": "Aish. Fine."},
{"key": "data.voice.korean.kicked.2", "text": "Atunci annyeong.", "src": "Annyeong, then."},
{"key": "data.voice.korean.leaving.0", "text": "Aish. Durează prea mult.", "src": "Aish. Too long."},
{"key": "data.voice.korean.leaving.1", "text": "Plec. Annyeong.", "src": "I am going. Annyeong."},
{"key": "data.voice.korean.leaving.2", "text": "Mot chamgesseo. Nu mai pot.", "src": "Mot chamgesseo."},
{"key": "data.voice.korean.order.0", "text": "{drink}, juseyo.", "src": "{drink}, juseyo."},
{"key": "data.voice.korean.order.1", "text": "{drink}, te rog.", "src": "One {drink}, please."},
{"key": "data.voice.korean.order.2", "text": "Pentru mine: {drink}.", "src": "A {drink} for me."},
{"key": "data.voice.korean.order.3", "text": "Vreau: {drink}.", "src": "I want a {drink}."},
{"key": "data.voice.korean.perfect.0", "text": "Daebak!", "src": "Daebak!"},
{"key": "data.voice.korean.perfect.1", "text": "Jinjja bună!", "src": "Jinjja good!"},
{"key": "data.voice.korean.perfect.2", "text": "Choego!", "src": "Choego!"},
{"key": "data.voice.korean.praise.0", "text": "Daebak. Jinjja, e perfectă.", "src": "Daebak. Jinjja, this is perfect."},
{"key": "data.voice.korean.praise.1", "text": "Choego. Pe bune.", "src": "Choego. I mean it."},
{"key": "data.voice.korean.praise.2", "text": "Wow. Te pricepi.", "src": "Wow. You are good at this."},
{"key": "data.voice.korean.sip.0", "text": "Jamkkanman, {advice_l}", "src": "Jamkkanman, {advice_l}"},
{"key": "data.voice.korean.sip.1", "text": "Ăm, {advice_l}", "src": "Um, {advice_l}"},
{"key": "data.voice.korean.sip.2", "text": "Gwenchana, dar {advice_l}", "src": "Gwenchana, but {advice_l}"},
{"key": "data.voice.korean.wrong.0", "text": "Aniyo, nu.", "src": "Aniyo, no."},
{"key": "data.voice.korean.wrong.1", "text": "Asta e greșită.", "src": "This is wrong."},
{"key": "data.voice.korean.wrong.2", "text": "Eh? Nu e a mea.", "src": "Eh? Not mine."},
{"key": "data.voice.nordic.another.0", "text": "Încă una. Skål!", "src": "Another. Skål!"},
{"key": "data.voice.nordic.another.1", "text": "Mai una.", "src": "One more."},
{"key": "data.voice.nordic.another.2", "text": "Încă o dată, te rog.", "src": "Again, please."},
{"key": "data.voice.nordic.close.0", "text": "Bine.", "src": "Fine."},
{"key": "data.voice.nordic.close.1", "text": "E okay.", "src": "It's okay."},
{"key": "data.voice.nordic.close.2", "text": "Destul de bună.", "src": "Good enough."},
{"key": "data.voice.nordic.kicked.0", "text": "Okay. Ciudat, dar okay.", "src": "Okay. Strange, but okay."},
{"key": "data.voice.nordic.kicked.1", "text": "Bine atunci.", "src": "Fine."},
{"key": "data.voice.nordic.kicked.2", "text": "Hm. La revedere, atunci.", "src": "Hm. Goodbye then."},
{"key": "data.voice.nordic.leaving.0", "text": "Plec. E în regulă.", "src": "I'll go. It's fine."},
{"key": "data.voice.nordic.leaving.1", "text": "Prea mult. La revedere.", "src": "Too long. Goodbye."},
{"key": "data.voice.nordic.leaving.2", "text": "Nu. Eu plec.", "src": "No. I'm leaving."},
{"key": "data.voice.nordic.order.0", "text": "{drink}. Mersi.", "src": "A {drink}. Thanks."},
{"key": "data.voice.nordic.order.1", "text": "{drink}, te rog.", "src": "{drink}, please."},
{"key": "data.voice.nordic.order.2", "text": "{drink}. Fără grabă.", "src": "One {drink}. No rush."},
{"key": "data.voice.nordic.order.3", "text": "Iau: {drink}.", "src": "I'll have the {drink}."},
{"key": "data.voice.nordic.perfect.0", "text": "Skål!", "src": "Skål!"},
{"key": "data.voice.nordic.perfect.1", "text": "Foarte bună.", "src": "Very good."},
{"key": "data.voice.nordic.perfect.2", "text": "Da. Bună.", "src": "Yes. Good."},
{"key": "data.voice.nordic.praise.0", "text": "Foarte bună. Nu zic asta des.", "src": "This is very good. I don't say that."},
{"key": "data.voice.nordic.praise.1", "text": "Skål. Făcută cum trebuie.", "src": "Skål. Properly done."},
{"key": "data.voice.nordic.praise.2", "text": "Bună. Chiar bună.", "src": "Good. Really good."},
{"key": "data.voice.nordic.sip.0", "text": "Păi. {advice}", "src": "Well. {advice}"},
{"key": "data.voice.nordic.sip.1", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.nordic.sip.2", "text": "Bine, dar {advice_l}", "src": "Fine, but {advice_l}"},
{"key": "data.voice.nordic.wrong.0", "text": "Nu. E greșită.", "src": "No. Wrong one."},
{"key": "data.voice.nordic.wrong.1", "text": "Nu asta e.", "src": "This is not it."},
{"key": "data.voice.nordic.wrong.2", "text": "Hm. Nu e a mea.", "src": "Hm. Not mine."},
{"key": "data.voice.southern.another.0", "text": "Mai toarnă-mi una!", "src": "Pour me another!"},
{"key": "data.voice.southern.another.1", "text": "Încă una, sugar!", "src": "One more, sugar!"},
{"key": "data.voice.southern.another.2", "text": "Tot așa, adu-le!", "src": "Keep 'em comin'!"},
{"key": "data.voice.southern.close.0", "text": "E-n regulă.", "src": "That's alright."},
{"key": "data.voice.southern.close.1", "text": "Corect, ce să zic.", "src": "Fair enough."},
{"key": "data.voice.southern.close.2", "text": "Ei, merge și așa.", "src": "Well, it'll do."},
{"key": "data.voice.southern.kicked.0", "text": "Ei, asta-i chiar nepoliticos.", "src": "Well, that's just rude."},
{"key": "data.voice.southern.kicked.1", "text": "Bine atunci. O seară bună, honey.", "src": "Alright then. Have a good one."},
{"key": "data.voice.southern.kicked.2", "text": "Ia stai puțin… fie.", "src": "Now hold on… fine."},
{"key": "data.voice.southern.leaving.0", "text": "Ei, n-am toată noaptea la dispoziție.", "src": "Well, I ain't got all night."},
{"key": "data.voice.southern.leaving.1", "text": "Cred că beau în altă parte.", "src": "Reckon I'll drink elsewhere."},
{"key": "data.voice.southern.leaving.2", "text": "Y'all nu vă grăbiți deloc, așa-i?", "src": "Y'all take your sweet time, don't you."},
{"key": "data.voice.southern.order.0", "text": "Ia să vedem… mi-ar prinde bine: {drink}.", "src": "Well now, a {drink} would suit me."},
{"key": "data.voice.southern.order.1", "text": "{drink}, darling, dacă nu te superi.", "src": "{drink}, darlin', if you please."},
{"key": "data.voice.southern.order.2", "text": "Cred că iau: {drink}.", "src": "Reckon I'll have a {drink}."},
{"key": "data.voice.southern.order.3", "text": "{drink}, sugar.", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "Ce bunătate!", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "Doamne, ce bună!", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "Hot dang, ce bună!", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "Ei, na. Asta da băutură.", "src": "Well, I'll be. That's a proper drink."},
{"key": "data.voice.southern.praise.1", "text": "Darling, ai har.", "src": "Darlin', you got a gift."},
{"key": "data.voice.southern.praise.2", "text": "Cred că mi-am găsit localul.", "src": "Reckon I found my new spot."},
{"key": "data.voice.southern.sip.0", "text": "Ia ascultă, {advice_l}", "src": "Now, {advice_l}"},
{"key": "data.voice.southern.sip.1", "text": "Sugar, {advice_l}", "src": "Sugar, {advice_l}"},
{"key": "data.voice.southern.sip.2", "text": "Să-ți zic ceva: {advice_l}", "src": "Tell you what, {advice_l}"},
