{"strings": [
{"key": "data.voice.african.another.0", "text": "Traz outra!", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "Mais uma, abeg!", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "De novo, meu amigo!", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "Tá bom.", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "No wahala.", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "Ok, valeu.", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "Ah ah! Sério?", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala. Já vou.", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "Meu amigo, isso não se faz.", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah ah. Já esperei demais.", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala. Tô indo.", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "Deixa eu ir, meu amigo.", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "{drink}, por favor.", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "Meu amigo: {drink}.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Vou querer {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "{drink}, abeg.", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "Ah, que delícia!", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "Correto!", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "Esse tá bom demais!", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, esse aqui tá correto. Valeu mesmo.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "No wahala nenhum. Muito bom.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "Meu amigo, você manja muito.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "Meu amigo, {advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg, {advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "Tá bom, mas {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah, não.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "Não é esse.", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "Meu amigo, não.", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "O mesmo de novo, mate!", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "Mais uma, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "Vai, outra!", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "Nada mal.", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Ta, serve.", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "Beleza, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Que simpático. Simpaticíssimo.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "Certo. Bem. Cheers por nada.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "Só pode ser piada.", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Certo. Já esperei o bastante.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "Ah, que se dane. Tô fora.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Bem fraquinho, isso. Tchau.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "{drink}, mate, quando der.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, por favor. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "Vai lá, então: {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "Vou de {drink}, ta.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "Lovely!", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "Cheers, mate!", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "Bom mesmo!", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Caramba. Isso tá realmente lovely.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Isso foi feito direitinho.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Bom pra caramba, isso.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "Um detalhezinho: {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Olha, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Meio errado, isso.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Hmm, não é o meu.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "Não foi o que pedi.", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "Mais uma, yaar!", "src": "One more, yaar!"},
{"key": "data.voice.desi.another.1", "text": "Aur ek!", "src": "Aur ek!"},
{"key": "data.voice.desi.another.2", "text": "De novo, por favor!", "src": "Again, please!"},
{"key": "data.voice.desi.close.0", "text": "Theek hai.", "src": "Theek hai."},
{"key": "data.voice.desi.close.1", "text": "Tá ok, na.", "src": "It is okay, na."},
{"key": "data.voice.desi.close.2", "text": "Chalega.", "src": "Chalega."},
{"key": "data.voice.desi.kicked.0", "text": "Kya? Sério?", "src": "Kya? Seriously?"},
{"key": "data.voice.desi.kicked.1", "text": "Arre. Tá, tudo bem.", "src": "Arre. Okay, fine."},
{"key": "data.voice.desi.kicked.2", "text": "Chalo. Tô indo.", "src": "Chalo. I go."},
{"key": "data.voice.desi.leaving.0", "text": "Arre yaar. Demorou demais.", "src": "Arre yaar. Too long."},
{"key": "data.voice.desi.leaving.1", "text": "Chalo, vou embora.", "src": "Chalo, I am going."},
{"key": "data.voice.desi.leaving.2", "text": "Bas. Chega.", "src": "Bas. Enough."},
{"key": "data.voice.desi.order.0", "text": "{drink}, por favor.", "src": "One {drink}, please."},
{"key": "data.voice.desi.order.1", "text": "{drink}, yaar.", "src": "A {drink}, yaar."},
{"key": "data.voice.desi.order.2", "text": "Vou de {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.desi.order.3", "text": "{drink}, na?", "src": "{drink}, na?"},
{"key": "data.voice.desi.perfect.0", "text": "Wah, perfeito!", "src": "Wah, perfect!"},
{"key": "data.voice.desi.perfect.1", "text": "Ekdum de primeira!", "src": "Ekdum first class!"},
{"key": "data.voice.desi.perfect.2", "text": "Bahut badhiya!", "src": "Bahut badhiya!"},
{"key": "data.voice.desi.praise.0", "text": "Wah. Ekdum perfeito, yaar.", "src": "Wah. Ekdum perfect, yaar."},
{"key": "data.voice.desi.praise.1", "text": "Bahut badhiya. De verdade.", "src": "Bahut badhiya. Really."},
{"key": "data.voice.desi.praise.2", "text": "De primeira. Eu volto.", "src": "First class. I am coming back."},
{"key": "data.voice.desi.sip.0", "text": "Arre, {advice_l}", "src": "Arre, {advice_l}"},
{"key": "data.voice.desi.sip.1", "text": "Yaar, {advice_l}", "src": "Yaar, {advice_l}"},
{"key": "data.voice.desi.sip.2", "text": "Theek hai, mas {advice_l}", "src": "Theek hai, but {advice_l}"},
{"key": "data.voice.desi.wrong.0", "text": "Arre, não.", "src": "Arre, no."},
{"key": "data.voice.desi.wrong.1", "text": "Esse não é o meu.", "src": "This is not mine."},
{"key": "data.voice.desi.wrong.2", "text": "Nahi, veio errado.", "src": "Nahi, wrong one."},
{"key": "data.voice.german.another.0", "text": "Noch eins!", "src": "Noch eins!"},
{"key": "data.voice.german.another.1", "text": "Outro, bitte!", "src": "Another, bitte!"},
{"key": "data.voice.german.another.2", "text": "De novo, por favor!", "src": "Again, please!"},
{"key": "data.voice.german.close.0", "text": "Ja, ok.", "src": "Ja, okay."},
{"key": "data.voice.german.close.1", "text": "Aceitável.", "src": "Acceptable."},
{"key": "data.voice.german.close.2", "text": "Está bom.", "src": "It is fine."},
{"key": "data.voice.german.kicked.0", "text": "Isso é um absurdo.", "src": "This is absurd."},
{"key": "data.voice.german.kicked.1", "text": "Pois bem. Não volto mais.", "src": "Fine. I will not return."},
{"key": "data.voice.german.kicked.2", "text": "Ja, ja. Estou indo.", "src": "Ja, ja. I am going."},
{"key": "data.voice.german.leaving.0", "text": "Isso não é aceitável. Vou embora.", "src": "This is not acceptable. I am leaving."},
{"key": "data.voice.german.leaving.1", "text": "Nein. Já esperei o suficiente.", "src": "Nein. I have waited enough."},
{"key": "data.voice.german.leaving.2", "text": "Unglaublich. Adeus.", "src": "Unglaublich. Goodbye."},
{"key": "data.voice.german.order.0", "text": "{drink}, por favor. Feito corretamente.", "src": "A {drink}, please. Correctly made."},
{"key": "data.voice.german.order.1", "text": "{drink}. Agradeço.", "src": "{drink}. Thank you."},
{"key": "data.voice.german.order.2", "text": "{drink}, bitte.", "src": "One {drink}, bitte."},
{"key": "data.voice.german.order.3", "text": "Eu gostaria de {drink}.", "src": "I would like a {drink}."},
{"key": "data.voice.german.perfect.0", "text": "Genau!", "src": "Genau!"},
{"key": "data.voice.german.perfect.1", "text": "Sehr gut!", "src": "Sehr gut!"},
{"key": "data.voice.german.perfect.2", "text": "Wunderbar!", "src": "Wunderbar!"},
{"key": "data.voice.german.praise.0", "text": "Ja. Exatamente como deve ser.", "src": "Ja. This is exactly right."},
{"key": "data.voice.german.praise.1", "text": "Preciso. Eu respeito precisão.", "src": "Precise. I respect precision."},
{"key": "data.voice.german.praise.2", "text": "Sehr gut. Nada a apontar.", "src": "Sehr gut. No notes."},
{"key": "data.voice.german.sip.0", "text": "Genau, mas {advice_l}", "src": "Genau, but {advice_l}"},
{"key": "data.voice.german.sip.1", "text": "Uma observação: {advice_l}", "src": "One remark: {advice_l}"},
{"key": "data.voice.german.sip.2", "text": "Ja, {advice_l}", "src": "Ja, {advice_l}"},
{"key": "data.voice.german.wrong.0", "text": "Nein. Não é este.", "src": "Nein. Not this."},
{"key": "data.voice.german.wrong.1", "text": "Isto está incorreto.", "src": "This is incorrect."},
{"key": "data.voice.german.wrong.2", "text": "Drinque errado.", "src": "Wrong drink."},
{"key": "data.voice.korean.another.0", "text": "Han jan deo!", "src": "Han jan deo!"},
{"key": "data.voice.korean.another.1", "text": "Mais uma!", "src": "One more!"},
{"key": "data.voice.korean.another.2", "text": "De novo, juseyo!", "src": "Again, juseyo!"},
{"key": "data.voice.korean.close.0", "text": "Gwenchana.", "src": "Gwenchana."},
{"key": "data.voice.korean.close.1", "text": "Tá tudo bem.", "src": "It is okay."},
{"key": "data.voice.korean.close.2", "text": "Nappeuji anha.", "src": "Nappeuji anha."},
{"key": "data.voice.korean.kicked.0", "text": "Jinjja? Nossa.", "src": "Jinjja? Wow."},
{"key": "data.voice.korean.kicked.1", "text": "Aish. Tá bom.", "src": "Aish. Fine."},
{"key": "data.voice.korean.kicked.2", "text": "Annyeong, então.", "src": "Annyeong, then."},
{"key": "data.voice.korean.leaving.0", "text": "Aish. Demorou demais.", "src": "Aish. Too long."},
{"key": "data.voice.korean.leaving.1", "text": "Vou indo. Annyeong.", "src": "I am going. Annyeong."},
{"key": "data.voice.korean.leaving.2", "text": "Mot chamgesseo.", "src": "Mot chamgesseo."},
{"key": "data.voice.korean.order.0", "text": "{drink}, juseyo.", "src": "{drink}, juseyo."},
{"key": "data.voice.korean.order.1", "text": "{drink}, por favor.", "src": "One {drink}, please."},
{"key": "data.voice.korean.order.2", "text": "Pra mim: {drink}.", "src": "A {drink} for me."},
{"key": "data.voice.korean.order.3", "text": "Eu quero {drink}.", "src": "I want a {drink}."},
{"key": "data.voice.korean.perfect.0", "text": "Daebak!", "src": "Daebak!"},
{"key": "data.voice.korean.perfect.1", "text": "Jinjja bom!", "src": "Jinjja good!"},
{"key": "data.voice.korean.perfect.2", "text": "Choego!", "src": "Choego!"},
{"key": "data.voice.korean.praise.0", "text": "Daebak. Jinjja, isso tá perfeito.", "src": "Daebak. Jinjja, this is perfect."},
{"key": "data.voice.korean.praise.1", "text": "Choego. Tô falando sério.", "src": "Choego. I mean it."},
{"key": "data.voice.korean.praise.2", "text": "Nossa. Você manda muito bem nisso.", "src": "Wow. You are good at this."},
{"key": "data.voice.korean.sip.0", "text": "Jamkkanman, {advice_l}", "src": "Jamkkanman, {advice_l}"},
{"key": "data.voice.korean.sip.1", "text": "Hum, {advice_l}", "src": "Um, {advice_l}"},
{"key": "data.voice.korean.sip.2", "text": "Gwenchana, mas {advice_l}", "src": "Gwenchana, but {advice_l}"},
{"key": "data.voice.korean.wrong.0", "text": "Aniyo, não.", "src": "Aniyo, no."},
{"key": "data.voice.korean.wrong.1", "text": "Isso tá errado.", "src": "This is wrong."},
{"key": "data.voice.korean.wrong.2", "text": "Hã? Não é o meu.", "src": "Eh? Not mine."},
{"key": "data.voice.nordic.another.0", "text": "Outra. Skål!", "src": "Another. Skål!"},
{"key": "data.voice.nordic.another.1", "text": "Mais uma.", "src": "One more."},
{"key": "data.voice.nordic.another.2", "text": "De novo, por favor.", "src": "Again, please."},
{"key": "data.voice.nordic.close.0", "text": "Tá bom.", "src": "Fine."},
{"key": "data.voice.nordic.close.1", "text": "Tudo certo.", "src": "It's okay."},
{"key": "data.voice.nordic.close.2", "text": "Serve.", "src": "Good enough."},
{"key": "data.voice.nordic.kicked.0", "text": "Ok. Estranho, mas ok.", "src": "Okay. Strange, but okay."},
{"key": "data.voice.nordic.kicked.1", "text": "Tudo bem.", "src": "Fine."},
{"key": "data.voice.nordic.kicked.2", "text": "Hm. Tchau, então.", "src": "Hm. Goodbye then."},
{"key": "data.voice.nordic.leaving.0", "text": "Vou indo. Sem problema.", "src": "I'll go. It's fine."},
{"key": "data.voice.nordic.leaving.1", "text": "Demorou demais. Tchau.", "src": "Too long. Goodbye."},
{"key": "data.voice.nordic.leaving.2", "text": "Não. Vou embora.", "src": "No. I'm leaving."},
{"key": "data.voice.nordic.order.0", "text": "{drink}. Valeu.", "src": "A {drink}. Thanks."},
{"key": "data.voice.nordic.order.1", "text": "{drink}, por favor.", "src": "{drink}, please."},
{"key": "data.voice.nordic.order.2", "text": "{drink}. Sem pressa.", "src": "One {drink}. No rush."},
{"key": "data.voice.nordic.order.3", "text": "Vou querer {drink}.", "src": "I'll have the {drink}."},
{"key": "data.voice.nordic.perfect.0", "text": "Skål!", "src": "Skål!"},
{"key": "data.voice.nordic.perfect.1", "text": "Muito bom.", "src": "Very good."},
{"key": "data.voice.nordic.perfect.2", "text": "Sim. Bom.", "src": "Yes. Good."},
{"key": "data.voice.nordic.praise.0", "text": "Muito bom. E eu não digo isso à toa.", "src": "This is very good. I don't say that."},
{"key": "data.voice.nordic.praise.1", "text": "Skål. Bem-feito.", "src": "Skål. Properly done."},
{"key": "data.voice.nordic.praise.2", "text": "Bom. Bom mesmo.", "src": "Good. Really good."},
{"key": "data.voice.nordic.sip.0", "text": "Bem. {advice}", "src": "Well. {advice}"},
{"key": "data.voice.nordic.sip.1", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.nordic.sip.2", "text": "Tá bom, mas {advice_l}", "src": "Fine, but {advice_l}"},
{"key": "data.voice.nordic.wrong.0", "text": "Não. Esse não.", "src": "No. Wrong one."},
{"key": "data.voice.nordic.wrong.1", "text": "Não é esse.", "src": "This is not it."},
{"key": "data.voice.nordic.wrong.2", "text": "Hm. Não é o meu.", "src": "Hm. Not mine."},
{"key": "data.voice.southern.another.0", "text": "Me serve outra!", "src": "Pour me another!"},
{"key": "data.voice.southern.another.1", "text": "Mais uma, sugar!", "src": "One more, sugar!"},
{"key": "data.voice.southern.another.2", "text": "Pode ir mandando!", "src": "Keep 'em comin'!"},
{"key": "data.voice.southern.close.0", "text": "Tá tudo bem.", "src": "That's alright."},
{"key": "data.voice.southern.close.1", "text": "Justo.", "src": "Fair enough."},
{"key": "data.voice.southern.close.2", "text": "Bom, serve.", "src": "Well, it'll do."},
{"key": "data.voice.southern.kicked.0", "text": "Ora, que falta de educação.", "src": "Well, that's just rude."},
{"key": "data.voice.southern.kicked.1", "text": "Tudo bem então. Have a good one.", "src": "Alright then. Have a good one."},
{"key": "data.voice.southern.kicked.2", "text": "Peraí… tá bom.", "src": "Now hold on… fine."},
{"key": "data.voice.southern.leaving.0", "text": "Olha, eu não tenho a noite toda.", "src": "Well, I ain't got all night."},
{"key": "data.voice.southern.leaving.1", "text": "Acho que vou beber em outro lugar.", "src": "Reckon I'll drink elsewhere."},
{"key": "data.voice.southern.leaving.2", "text": "Y'all não têm pressa nenhuma, né?", "src": "Y'all take your sweet time, don't you."},
{"key": "data.voice.southern.order.0", "text": "Olha só, {drink} me cairia bem.", "src": "Well now, a {drink} would suit me."},
{"key": "data.voice.southern.order.1", "text": "{drink}, darlin', por gentileza.", "src": "{drink}, darlin', if you please."},
{"key": "data.voice.southern.order.2", "text": "Acho que vou de {drink}.", "src": "Reckon I'll have a {drink}."},
{"key": "data.voice.southern.order.3", "text": "{drink}, sugar.", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "Mas que beleza!", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "Lord, que bom!", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "Hot dang!", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "Ora, ora. Isso sim é drinque.", "src": "Well, I'll be. That's a proper drink."},
{"key": "data.voice.southern.praise.1", "text": "Darlin', você tem um dom.", "src": "Darlin', you got a gift."},
{"key": "data.voice.southern.praise.2", "text": "Acho que achei meu novo cantinho.", "src": "Reckon I found my new spot."},
{"key": "data.voice.southern.sip.0", "text": "Agora, {advice_l}", "src": "Now, {advice_l}"},
{"key": "data.voice.southern.sip.1", "text": "Sugar, {advice_l}", "src": "Sugar, {advice_l}"},
{"key": "data.voice.southern.sip.2", "text": "Vou te dizer, {advice_l}", "src": "Tell you what, {advice_l}"},
{"key": "data.voice.southern.wrong.0", "text": "Não é o meu, hon.", "src": "Ain't mine, hon."},
{"key": "data.voice.southern.wrong.1", "text": "Ora, o que é isso?", "src": "Now what is this?"},
{"key": "data.voice.southern.wrong.2", "text": "Bless your heart.", "src": "Bless your heart."}
]}
