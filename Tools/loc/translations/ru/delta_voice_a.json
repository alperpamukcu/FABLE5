{"strings": [
{"key": "data.voice.african.another.0", "text": "Неси ещё одну!", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "Ещё одну, abeg!", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "Повтори, my friend!", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "Нормально.", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "No wahala.", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "Ладно, спасибо.", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "Ah ah! Серьёзно?", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala. Ухожу.", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "My friend, так не делают.", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah ah. Хватит с меня ожидания.", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala. Я пойду.", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "Всё, my friend, пора мне.", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "{drink}, пожалуйста.", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "{drink}, my friend.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Мне — {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "{drink}, abeg.", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "Ah, вкусно!", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "Точно в цель!", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "Вот это хорошо!", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, вот это правильно. Спасибо.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "No wahala вообще. Очень хорошо.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "My friend, ты своё дело знаешь.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "My friend, {advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg, {advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "Нормально, но {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah, нет.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "Это не то.", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "My friend, нет.", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "Повтори, mate!", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "Ещё одну, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "Давай, ещё одну!", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "Неплохо.", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Ta, сойдёт.", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "Ладно, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Очаровательно. Просто очаровательно.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "Так. Ну что ж. Cheers ни за что.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "Шутишь, что ли?", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Так. Ждать мне надоело.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "Да ну его. Ухожу.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Ерунда какая-то. Bye.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "{drink}, mate, как будет минутка.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, пожалуйста. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "Ну давай, {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "Мне — {drink}, ta.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "Lovely!", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "Cheers, mate!", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "Proper, отлично!", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Blimey. Это правда прекрасно.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Сделано как положено.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Чертовски хорошо, честно.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "Одна мелочь: {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Слушай, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Что-то не то.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Эм, это не моё.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "Это не мой заказ.", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "Ещё одну, yaar!", "src": "One more, yaar!"},
{"key": "data.voice.desi.another.1", "text": "Aur ek!", "src": "Aur ek!"},
{"key": "data.voice.desi.another.2", "text": "Повтори, пожалуйста!", "src": "Again, please!"},
{"key": "data.voice.desi.close.0", "text": "Theek hai.", "src": "Theek hai."},
{"key": "data.voice.desi.close.1", "text": "Нормально, na.", "src": "It is okay, na."},
{"key": "data.voice.desi.close.2", "text": "Chalega.", "src": "Chalega."},
{"key": "data.voice.desi.kicked.0", "text": "Kya? Серьёзно?", "src": "Kya? Seriously?"},
{"key": "data.voice.desi.kicked.1", "text": "Arre. Ну ладно, хорошо.", "src": "Arre. Okay, fine."},
{"key": "data.voice.desi.kicked.2", "text": "Chalo. Ухожу.", "src": "Chalo. I go."},
{"key": "data.voice.desi.leaving.0", "text": "Arre yaar. Слишком долго.", "src": "Arre yaar. Too long."},
{"key": "data.voice.desi.leaving.1", "text": "Chalo, я пойду.", "src": "Chalo, I am going."},
{"key": "data.voice.desi.leaving.2", "text": "Bas. Хватит.", "src": "Bas. Enough."},
{"key": "data.voice.desi.order.0", "text": "{drink}, пожалуйста.", "src": "One {drink}, please."},
{"key": "data.voice.desi.order.1", "text": "{drink}, yaar.", "src": "A {drink}, yaar."},
{"key": "data.voice.desi.order.2", "text": "Мне — {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.desi.order.3", "text": "{drink}, na?", "src": "{drink}, na?"},
{"key": "data.voice.desi.perfect.0", "text": "Wah, идеально!", "src": "Wah, perfect!"},
{"key": "data.voice.desi.perfect.1", "text": "Ekdum first class!", "src": "Ekdum first class!"},
{"key": "data.voice.desi.perfect.2", "text": "Bahut badhiya!", "src": "Bahut badhiya!"},
{"key": "data.voice.desi.praise.0", "text": "Wah. Ekdum идеально, yaar.", "src": "Wah. Ekdum perfect, yaar."},
{"key": "data.voice.desi.praise.1", "text": "Bahut badhiya. Правда.", "src": "Bahut badhiya. Really."},
{"key": "data.voice.desi.praise.2", "text": "First class. Я ещё вернусь.", "src": "First class. I am coming back."},
{"key": "data.voice.desi.sip.0", "text": "Arre, {advice_l}", "src": "Arre, {advice_l}"},
{"key": "data.voice.desi.sip.1", "text": "Yaar, {advice_l}", "src": "Yaar, {advice_l}"},
{"key": "data.voice.desi.sip.2", "text": "Theek hai, но {advice_l}", "src": "Theek hai, but {advice_l}"},
{"key": "data.voice.desi.wrong.0", "text": "Arre, нет.", "src": "Arre, no."},
{"key": "data.voice.desi.wrong.1", "text": "Это не моё.", "src": "This is not mine."},
{"key": "data.voice.desi.wrong.2", "text": "Nahi, не тот.", "src": "Nahi, wrong one."},
{"key": "data.voice.german.another.0", "text": "Noch eins!", "src": "Noch eins!"},
{"key": "data.voice.german.another.1", "text": "Ещё одну, bitte!", "src": "Another, bitte!"},
{"key": "data.voice.german.another.2", "text": "Повторить, пожалуйста!", "src": "Again, please!"},
{"key": "data.voice.german.close.0", "text": "Ja, ладно.", "src": "Ja, okay."},
{"key": "data.voice.german.close.1", "text": "Приемлемо.", "src": "Acceptable."},
{"key": "data.voice.german.close.2", "text": "Нормально.", "src": "It is fine."},
{"key": "data.voice.german.kicked.0", "text": "Это абсурд.", "src": "This is absurd."},
{"key": "data.voice.german.kicked.1", "text": "Хорошо. Больше я сюда не приду.", "src": "Fine. I will not return."},
{"key": "data.voice.german.kicked.2", "text": "Ja, ja. Ухожу.", "src": "Ja, ja. I am going."},
{"key": "data.voice.german.leaving.0", "text": "Это неприемлемо. Я ухожу.", "src": "This is not acceptable. I am leaving."},
{"key": "data.voice.german.leaving.1", "text": "Nein. Ждать больше не буду.", "src": "Nein. I have waited enough."},
{"key": "data.voice.german.leaving.2", "text": "Unglaublich. До свидания.", "src": "Unglaublich. Goodbye."},
{"key": "data.voice.german.order.0", "text": "{drink}, пожалуйста. И по всем правилам.", "src": "A {drink}, please. Correctly made."},
{"key": "data.voice.german.order.1", "text": "{drink}. Danke.", "src": "{drink}. Thank you."},
{"key": "data.voice.german.order.2", "text": "{drink}, bitte.", "src": "One {drink}, bitte."},
{"key": "data.voice.german.order.3", "text": "Мне, пожалуйста, — {drink}.", "src": "I would like a {drink}."},
{"key": "data.voice.german.perfect.0", "text": "Genau!", "src": "Genau!"},
{"key": "data.voice.german.perfect.1", "text": "Sehr gut!", "src": "Sehr gut!"},
{"key": "data.voice.german.perfect.2", "text": "Wunderbar!", "src": "Wunderbar!"},
{"key": "data.voice.german.praise.0", "text": "Ja. Именно так, как надо.", "src": "Ja. This is exactly right."},
{"key": "data.voice.german.praise.1", "text": "Точно. Я уважаю точность.", "src": "Precise. I respect precision."},
{"key": "data.voice.german.praise.2", "text": "Sehr gut. Замечаний нет.", "src": "Sehr gut. No notes."},
{"key": "data.voice.german.sip.0", "text": "Genau, но {advice_l}", "src": "Genau, but {advice_l}"},
{"key": "data.voice.german.sip.1", "text": "Одно замечание: {advice_l}", "src": "One remark: {advice_l}"},
{"key": "data.voice.german.sip.2", "text": "Ja, {advice_l}", "src": "Ja, {advice_l}"},
{"key": "data.voice.german.wrong.0", "text": "Nein. Не это.", "src": "Nein. Not this."},
{"key": "data.voice.german.wrong.1", "text": "Это неверно.", "src": "This is incorrect."},
{"key": "data.voice.german.wrong.2", "text": "Не тот напиток.", "src": "Wrong drink."},
{"key": "data.voice.korean.another.0", "text": "Han jan deo!", "src": "Han jan deo!"},
{"key": "data.voice.korean.another.1", "text": "Ещё одну!", "src": "One more!"},
{"key": "data.voice.korean.another.2", "text": "Повтори, juseyo!", "src": "Again, juseyo!"},
{"key": "data.voice.korean.close.0", "text": "Gwenchana.", "src": "Gwenchana."},
{"key": "data.voice.korean.close.1", "text": "Нормально.", "src": "It is okay."},
{"key": "data.voice.korean.close.2", "text": "Nappeuji anha.", "src": "Nappeuji anha."},
{"key": "data.voice.korean.kicked.0", "text": "Jinjja? Ого.", "src": "Jinjja? Wow."},
{"key": "data.voice.korean.kicked.1", "text": "Aish. Ладно.", "src": "Aish. Fine."},
{"key": "data.voice.korean.kicked.2", "text": "Ну, annyeong тогда.", "src": "Annyeong, then."},
{"key": "data.voice.korean.leaving.0", "text": "Aish. Слишком долго.", "src": "Aish. Too long."},
{"key": "data.voice.korean.leaving.1", "text": "Я пойду. Annyeong.", "src": "I am going. Annyeong."},
{"key": "data.voice.korean.leaving.2", "text": "Mot chamgesseo.", "src": "Mot chamgesseo."},
{"key": "data.voice.korean.order.0", "text": "{drink}, juseyo.", "src": "{drink}, juseyo."},
{"key": "data.voice.korean.order.1", "text": "{drink}, пожалуйста.", "src": "One {drink}, please."},
{"key": "data.voice.korean.order.2", "text": "Мне — {drink}.", "src": "A {drink} for me."},
{"key": "data.voice.korean.order.3", "text": "Хочу вот это: {drink}.", "src": "I want a {drink}."},
{"key": "data.voice.korean.perfect.0", "text": "Daebak!", "src": "Daebak!"},
{"key": "data.voice.korean.perfect.1", "text": "Jinjja вкусно!", "src": "Jinjja good!"},
{"key": "data.voice.korean.perfect.2", "text": "Choego!", "src": "Choego!"},
{"key": "data.voice.korean.praise.0", "text": "Daebak. Jinjja, это идеально.", "src": "Daebak. Jinjja, this is perfect."},
{"key": "data.voice.korean.praise.1", "text": "Choego. Честно.", "src": "Choego. I mean it."},
{"key": "data.voice.korean.praise.2", "text": "Ого. У тебя талант.", "src": "Wow. You are good at this."},
{"key": "data.voice.korean.sip.0", "text": "Jamkkanman, {advice_l}", "src": "Jamkkanman, {advice_l}"},
{"key": "data.voice.korean.sip.1", "text": "Эм, {advice_l}", "src": "Um, {advice_l}"},
{"key": "data.voice.korean.sip.2", "text": "Gwenchana, но {advice_l}", "src": "Gwenchana, but {advice_l}"},
{"key": "data.voice.korean.wrong.0", "text": "Aniyo, нет.", "src": "Aniyo, no."},
{"key": "data.voice.korean.wrong.1", "text": "Это не то.", "src": "This is wrong."},
{"key": "data.voice.korean.wrong.2", "text": "А? Не моё.", "src": "Eh? Not mine."},
{"key": "data.voice.nordic.another.0", "text": "Ещё одну. Skål!", "src": "Another. Skål!"},
{"key": "data.voice.nordic.another.1", "text": "Ещё.", "src": "One more."},
{"key": "data.voice.nordic.another.2", "text": "Повтори, пожалуйста.", "src": "Again, please."},
{"key": "data.voice.nordic.close.0", "text": "Нормально.", "src": "Fine."},
{"key": "data.voice.nordic.close.1", "text": "Ничего.", "src": "It's okay."},
{"key": "data.voice.nordic.close.2", "text": "Сойдёт.", "src": "Good enough."},
{"key": "data.voice.nordic.kicked.0", "text": "Хорошо. Странно, но хорошо.", "src": "Okay. Strange, but okay."},
{"key": "data.voice.nordic.kicked.1", "text": "Ладно.", "src": "Fine."},
{"key": "data.voice.nordic.kicked.2", "text": "Хм. Тогда до свидания.", "src": "Hm. Goodbye then."},
{"key": "data.voice.nordic.leaving.0", "text": "Я пойду. Всё в порядке.", "src": "I'll go. It's fine."},
{"key": "data.voice.nordic.leaving.1", "text": "Слишком долго. До свидания.", "src": "Too long. Goodbye."},
{"key": "data.voice.nordic.leaving.2", "text": "Нет. Ухожу.", "src": "No. I'm leaving."},
{"key": "data.voice.nordic.order.0", "text": "{drink}. Спасибо.", "src": "A {drink}. Thanks."},
{"key": "data.voice.nordic.order.1", "text": "{drink}, пожалуйста.", "src": "{drink}, please."},
{"key": "data.voice.nordic.order.2", "text": "{drink}. Не спеши.", "src": "One {drink}. No rush."},
{"key": "data.voice.nordic.order.3", "text": "Мне — {drink}.", "src": "I'll have the {drink}."},
{"key": "data.voice.nordic.perfect.0", "text": "Skål!", "src": "Skål!"},
{"key": "data.voice.nordic.perfect.1", "text": "Очень хорошо.", "src": "Very good."},
{"key": "data.voice.nordic.perfect.2", "text": "Да. Хорошо.", "src": "Yes. Good."},
{"key": "data.voice.nordic.praise.0", "text": "Это очень хорошо. Я так редко говорю.", "src": "This is very good. I don't say that."},
{"key": "data.voice.nordic.praise.1", "text": "Skål. Сделано как надо.", "src": "Skål. Properly done."},
{"key": "data.voice.nordic.praise.2", "text": "Хорошо. Правда хорошо.", "src": "Good. Really good."},
{"key": "data.voice.nordic.sip.0", "text": "Ну. {advice}", "src": "Well. {advice}"},
{"key": "data.voice.nordic.sip.1", "text": "Хм. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.nordic.sip.2", "text": "Нормально, но {advice_l}", "src": "Fine, but {advice_l}"},
{"key": "data.voice.nordic.wrong.0", "text": "Нет. Не тот.", "src": "No. Wrong one."},
{"key": "data.voice.nordic.wrong.1", "text": "Это не то.", "src": "This is not it."},
{"key": "data.voice.nordic.wrong.2", "text": "Хм. Не моё.", "src": "Hm. Not mine."},
{"key": "data.voice.southern.another.0", "text": "Давай-ка ещё одну!", "src": "Pour me another!"},
{"key": "data.voice.southern.another.1", "text": "Ещё одну, sugar!", "src": "One more, sugar!"},
{"key": "data.voice.southern.another.2", "text": "Неси ещё, darlin'!", "src": "Keep 'em comin'!"},
{"key": "data.voice.southern.close.0", "text": "Ну и ладно.", "src": "That's alright."},
{"key": "data.voice.southern.close.1", "text": "Справедливо.", "src": "Fair enough."},
{"key": "data.voice.southern.close.2", "text": "Что ж, сойдёт.", "src": "Well, it'll do."},
{"key": "data.voice.southern.kicked.0", "text": "Well, это просто грубо.", "src": "Well, that's just rude."},
{"key": "data.voice.southern.kicked.1", "text": "Ладненько. Хорошего вечера.", "src": "Alright then. Have a good one."},
{"key": "data.voice.southern.kicked.2", "text": "Погоди-ка… ну ладно.", "src": "Now hold on… fine."},
{"key": "data.voice.southern.leaving.0", "text": "Well, у меня не вся ночь впереди.", "src": "Well, I ain't got all night."},
{"key": "data.voice.southern.leaving.1", "text": "Пожалуй, выпью в другом месте.", "src": "Reckon I'll drink elsewhere."},
{"key": "data.voice.southern.leaving.2", "text": "Y'all тут никуда не спешите, да?", "src": "Y'all take your sweet time, don't you."},
{"key": "data.voice.southern.order.0", "text": "Well now, {drink} — самое то.", "src": "Well now, a {drink} would suit me."},
{"key": "data.voice.southern.order.1", "text": "{drink}, darlin', если не трудно.", "src": "{drink}, darlin', if you please."},
{"key": "data.voice.southern.order.2", "text": "Пожалуй, возьму: {drink}.", "src": "Reckon I'll have a {drink}."},
{"key": "data.voice.southern.order.3", "text": "{drink}, sugar.", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "Вот это славно!", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "Lord, как хорошо!", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "Hot dang!", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "Well, I'll be. Вот это настоящий напиток.", "src": "Well, I'll be. That's a proper drink."},
{"key": "data.voice.southern.praise.1", "text": "Darlin', у тебя талант.", "src": "Darlin', you got a gift."},
