{"strings": [
{"key": "data.voice.aussie.another.0", "text": "Повтори, mate!", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "Ещё одну, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "Ещё одну, legend!", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "Ага, righto.", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "Неплохо, mate.", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "Сойдёт.", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "Ты серьёзно, mate?", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto. Справедливо.", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Не, это жёстко.", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto, наждался уже.", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Не, ну его. Отчаливаю.", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "Cheers ни за что, mate.", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "{drink}, mate.", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink}, пожалуйста.", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "Возьму, пожалуй: {drink}.", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "{drink}, cheers.", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "Ripper!", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "Too easy!", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "Bloody хорошо!", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "Bloody ripper, mate. Cheers.", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "Too easy. Дело своё знаешь.", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "Лучший за весь вечер, честно.", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "Слушай, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "No dramas, но {advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Не, mate.", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "Не моё, извини.", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "Не тот, mate.", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "Повторить!", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "Ещё по одной!", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "Давай ещё!", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "Спасибо.", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "Сойдёт.", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "Почти то, что надо.", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "Серьёзно? Ну и ладно.", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "Зря ты так.", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "Да пожалуйста. Оставь свой бар себе.", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "Всё, ждать больше не буду.", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "Тут сегодня кто-нибудь работает?", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "Ладно. Выпью в другом месте.", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink}, пожалуйста.", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "Мне — {drink}.", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "{drink}, как будет секунда.", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "Давай так: {drink}.", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "Идеально!", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "То, что надо!", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "В точку!", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "Менять тут нечего.", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "Вот это я понимаю — напиток.", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "Кто тебя учил — передай спасибо.", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "Хм. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice} Просто говорю.", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "Честно? {advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "Это не мой заказ.", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "Не тот напиток.", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "Это не моё.", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "Encore, пожалуйста!", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "Ещё одну, oui!", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "Повтори, merci!", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ça va.", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "Нормально.", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon, ладно.", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "Quoi? Серьёзно?", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Bon. Au revoir.", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule.", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non. Ждать больше не буду.", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis. Ухожу.", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "Au revoir тогда.", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "{drink}, s'il vous plaît.", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "{drink}, пожалуйста.", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "{drink}, merci.", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "Мне — {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "Parfait!", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "Voilà, идеально!", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "Magnifique!", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait. Никаких замечаний.", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voilà. Хоть кто-то здесь умеет наливать.", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique. Правда.", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Écoute, {advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon, {advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors, {advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non.", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "Это не то.", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon, не то.", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "Mou ippai!", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "Ещё одну, kanpai!", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "Повтори, onegai!", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Hai, хорошо.", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa.", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "Неплохо, ne.", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "Eh?! Правда?", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi. Ладно, ухожу.", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta. Sayonara.", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen, больше ждать не могу.", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii. Пойду.", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai. До свидания.", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen, {drink}.", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "{drink}, onegai.", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink}, пожалуйста. Arigatou.", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto… {drink}.", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "Oishii!", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "Sugoi, идеально!", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "Kanpai!", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii. Правда, то самое.", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "Sugoi. Ты профи, ne.", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "Kanpai. Это идеально.", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "Etto, {advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "Ne, {advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "Sumimasen, но {advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "Chotto… нет.", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "Eh? Не это.", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "Chigau, прости.", "src": "Chigau, sorry."},
{"key": "data.voice.midwest.another.0", "text": "Ещё одну, пожалуйста!", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "Ещё разок, спасибо!", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "Повторить, ope!", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "О, всё нормально.", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "Конечно, спасибо.", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "Совсем неплохо.", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "О. Ну. Ладно тогда.", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "Ope, извини… я пойду.", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "Это уже чересчур, но ладно.", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "Oh gosh, я правда больше не могу ждать.", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "Ну, пожалуй, мне пора.", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "Извини, но я, наверное, двинусь.", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "{drink}, если можно? Thanks a bunch.", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "{drink}, если не трудно.", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "О, мне просто — {drink}.", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink}, пожалуйста. Не спеши.", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "О, real nice!", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "You betcha!", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "Oh jeez, да!", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "Oh my gosh, это просто прелесть.", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "Real nice. Моей тёте тут бы понравилось.", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "Ну, вот это в самый раз.", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "О, {advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "Просто на заметку: {advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "Ничего страшного, но {advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "Ope. Не тот.", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "О, это не моё.", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "Извини, нет. Не это.", "src": "Sorry, no. Not this."},
{"key": "data.voice.polish.another.0", "text": "Jeszcze raz!", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "Ещё одну, proszę!", "src": "Another, proszę!"},
{"key": "data.voice.polish.another.2", "text": "Повтори!", "src": "One more!"},
{"key": "data.voice.polish.close.0", "text": "Dobrze.", "src": "Dobrze."},
{"key": "data.voice.polish.close.1", "text": "Окей.", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "Нормально, спасибо.", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "Serio? Ладно.", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "Хорошо. Do widzenia.", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "Co? Окей, ухожу.", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "Хватит. Ухожу.", "src": "Enough. I'm going."},
{"key": "data.voice.polish.leaving.1", "text": "Nie, nie. Слишком долго.", "src": "Nie, nie. Too long."},
{"key": "data.voice.polish.leaving.2", "text": "Do widzenia.", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "{drink}, proszę.", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "{drink}, пожалуйста.", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "{drink}. Спасибо.", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "Dobrze, мне — {drink}.", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "Na zdrowie!", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "Świetnie!", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "Очень хорошо!", "src": "Very good!"},
{"key": "data.voice.polish.praise.0", "text": "Na zdrowie. Вот это настоящий напиток.", "src": "Na zdrowie. This is a real drink."},
{"key": "data.voice.polish.praise.1", "text": "Świetnie. Как дома.", "src": "Świetnie. Like at home."},
{"key": "data.voice.polish.praise.2", "text": "Dobrze. Очень, очень хорошо.", "src": "Dobrze. Very, very good."},
{"key": "data.voice.polish.sip.0", "text": "Dobrze, но {advice_l}", "src": "Dobrze, but {advice_l}"},
{"key": "data.voice.polish.sip.1", "text": "Слушай, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.polish.sip.2", "text": "Хм, {advice_l}", "src": "Hm, {advice_l}"},
{"key": "data.voice.polish.wrong.0", "text": "Nie. Не тот.", "src": "Nie. Wrong one."},
{"key": "data.voice.polish.wrong.1", "text": "Это не моё.", "src": "This is not mine."},
{"key": "data.voice.polish.wrong.2", "text": "Co to jest?", "src": "Co to jest?"},
{"key": "data.voice.turkish.another.0", "text": "Bir daha!", "src": "Bir daha!"},
{"key": "data.voice.turkish.another.1", "text": "Ещё одну, abi!", "src": "Another, abi!"},
{"key": "data.voice.turkish.another.2", "text": "Повтори, eyvallah!", "src": "Again, eyvallah!"},
{"key": "data.voice.turkish.close.0", "text": "Tamam.", "src": "Tamam."},
{"key": "data.voice.turkish.close.1", "text": "İdare eder.", "src": "İdare eder."},
{"key": "data.voice.turkish.close.2", "text": "Окей, нормально.", "src": "Okay, fine."},
{"key": "data.voice.turkish.kicked.0", "text": "Ciddi misin? Ладно.", "src": "Ciddi misin? Okay."},
{"key": "data.voice.turkish.kicked.1", "text": "Abi, серьёзно? Ну хорошо.", "src": "Abi, really? Fine."},
{"key": "data.voice.turkish.kicked.2", "text": "Yok, yok. Ухожу.", "src": "Yok, yok. I'm going."},
{"key": "data.voice.turkish.leaving.0", "text": "Yok, больше не жду.", "src": "Yok, I'm not waiting anymore."},
{"key": "data.voice.turkish.leaving.1", "text": "Abi, тут вообще кто-нибудь работает?", "src": "Abi, is nobody working here?"},
{"key": "data.voice.turkish.leaving.2", "text": "Tamam, hoşça kal.", "src": "Tamam, hoşça kal."},
{"key": "data.voice.turkish.order.0", "text": "Abi, {drink}.", "src": "Abi, a {drink}."},
{"key": "data.voice.turkish.order.1", "text": "{drink}, eyvallah.", "src": "One {drink}, eyvallah."},
{"key": "data.voice.turkish.order.2", "text": "{drink}, canım, как сможешь.", "src": "{drink}, canım, when you can."},
{"key": "data.voice.turkish.order.3", "text": "Bir {drink}, пожалуйста.", "src": "Bir {drink}, please."},
{"key": "data.voice.turkish.perfect.0", "text": "Eyvallah!", "src": "Eyvallah!"},
{"key": "data.voice.turkish.perfect.1", "text": "Harika!", "src": "Harika!"},
{"key": "data.voice.turkish.perfect.2", "text": "Süper, abi!", "src": "Süper, abi!"},
{"key": "data.voice.turkish.praise.0", "text": "Eyvallah. Вот как это делается.", "src": "Eyvallah. This is how it's done."},
{"key": "data.voice.turkish.praise.1", "text": "Abi, снимаю шляпу. Harika.", "src": "Abi, my hat is off. Harika."},
