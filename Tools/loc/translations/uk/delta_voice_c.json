{"strings": [
{"key": "data.voice.aussie.another.0", "text": "Ще такий самий, mate!", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "Ще один, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "Повтори, legend!", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "Ага, righto.", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "Непогано, mate.", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "Зійде.", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "Ти серйозно, mate?", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto. Ну, чесно.", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Nah, це вже жорстко.", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto, досить уже чекати.", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Nah, ну його. Бувай.", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "Дякую ні за що, mate.", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "Мені {drink}, mate.", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink}, будь ласка.", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "Для мене — {drink}.", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "Давай так: {drink}. Cheers.", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "Ripper! Клас!", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "Too easy, супер!", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "Бісово добре!", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "Bloody ripper, mate. Дякую.", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "Too easy. Ти знаєшся на ділі.", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "Найкращий за всю ніч, чесно.", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "Слухай, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "No dramas, але {advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Nah, mate, не те.", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "Не моє, вибач.", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "Не той, mate.", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "Повтори!", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "Ще такий самий!", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "Неси ще!", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "Дякую.", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "Зійде.", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "Майже те, що треба.", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "Серйозно? Ну й добре.", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "Ти робиш помилку.", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "Та й байдуже. Лишай собі свій бар.", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "Та ну. Набридло чекати.", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "Тут сьогодні хтось працює?", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "Усе. Піду в інше місце.", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink}, будь ласка.", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "Мені {drink}.", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "{drink}, як матимеш хвилинку.", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "Хай буде {drink}.", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "Ідеально!", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "Оце воно!", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "В яблучко!", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "Тут нічого не треба міняти.", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "Оце я розумію — напій.", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "Хто б тебе не вчив — подякуй йому.", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "Хм. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice} Просто кажу.", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "Чесно? {advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "Це не те замовлення.", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "Не той напій.", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "Це не моє.", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "Encore, будь ласка!", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "Ще один, oui!", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "Повтори, merci!", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ça va, нормально.", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "Та нічого.", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon, гаразд.", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "Quoi? Справді?", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Ну, bon. Au revoir.", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule. Смішно.", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non. Досить чекати.", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis. Я йду.", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "Тоді au revoir.", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "Мені {drink}, s'il vous plaît.", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "{drink}, будь ласка.", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "Для мене — {drink}, merci.", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "Хай буде {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "Parfait! Ідеально!", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "Voilà, бездоганно!", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "Magnifique! Чудово!", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait. Жодних зауважень.", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voilà. Хтось тут таки вміє наливати.", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique. Справді.", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Écoute, {advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon, {advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors, {advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non. Не те.", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "Це не те.", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon, не той.", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "Mou ippai! Ще один!", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "Ще раз, kanpai!", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "Повтори, onegai!", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Hai, гаразд.", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa. Так собі.", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "Непогано, ne.", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "Е?! Справді?", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi. Добре, я піду.", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta. Що ж, sayonara.", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen, більше не можу чекати.", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii. Мені час.", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai. До побачення.", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen, мені {drink}.", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "Для мене — {drink}, onegai.", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink}, будь ласка. Arigatou.", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto… хай буде {drink}.", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "Oishii! Смачно!", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "Sugoi, ідеально!", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "Kanpai! Чудово!", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii. Справді, оце воно.", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "Sugoi. Ти профі, ne.", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "Kanpai. Це ідеально.", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "Etto, {advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "Ne, {advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "Sumimasen, але {advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "Chotto… ні.", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "Е? Не це.", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "Chigau, вибач.", "src": "Chigau, sorry."},
{"key": "data.voice.midwest.another.0", "text": "Ще один, будь ласка!", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "Ще раз, дякую!", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "Ope, те саме ще раз!", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "Ой, та нормально.", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "Звісно, дякую.", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "Зовсім непогано.", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "Ой. Ну. Гаразд тоді.", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "Ope, вибач… я піду.", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "Трохи занадто, але гаразд.", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "Oh gosh, я вже справді не можу чекати.", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "Що ж, мені вже пора.", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "Вибач, але я, мабуть, піду.", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "{drink} — можна? Дуже дякую!", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "{drink}, якщо не важко.", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "Ой, мені просто {drink}.", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink}, будь ласка. Не поспішай.", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "Ой, як гарно!", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "You betcha! Оце так!", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "Oh jeez, так!", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "Oh my gosh, це просто чудово.", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "Дуже гарно. Моїй тітці тут би сподобалося.", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "Що ж, саме те, що треба.", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "Ой, {advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "Просто до відома: {advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "Нічого страшного, але {advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "Ope. Не той.", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "Ой, це не моє.", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "Вибач, ні. Не це.", "src": "Sorry, no. Not this."},
{"key": "data.voice.polish.another.0", "text": "Jeszcze raz! Ще раз!", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "Ще один, proszę!", "src": "Another, proszę!"},
{"key": "data.voice.polish.another.2", "text": "Повтори!", "src": "One more!"},
{"key": "data.voice.polish.close.0", "text": "Dobrze. Годиться.", "src": "Dobrze."},
{"key": "data.voice.polish.close.1", "text": "Гаразд.", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "Нормально, дякую.", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "Serio? Ну добре.", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "Гаразд. Do widzenia.", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "Co? Добре, я йду.", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "Досить. Мені час.", "src": "Enough. I'm going."},
{"key": "data.voice.polish.leaving.1", "text": "Nie, nie. Задовго.", "src": "Nie, nie. Too long."},
{"key": "data.voice.polish.leaving.2", "text": "Ну все, do widzenia.", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "Мені {drink}, proszę.", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "{drink}, будь ласка.", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "Для мене — {drink}. Дякую.", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "Dobrze, хай буде {drink}.", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "Na zdrowie! Чудово!", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "Świetnie! Клас!", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "Дуже добре!", "src": "Very good!"},
{"key": "data.voice.polish.praise.0", "text": "Na zdrowie. Оце справжній напій.", "src": "Na zdrowie. This is a real drink."},
{"key": "data.voice.polish.praise.1", "text": "Świetnie. Як удома.", "src": "Świetnie. Like at home."},
{"key": "data.voice.polish.praise.2", "text": "Dobrze. Дуже-дуже добре.", "src": "Dobrze. Very, very good."},
{"key": "data.voice.polish.sip.0", "text": "Dobrze, але {advice_l}", "src": "Dobrze, but {advice_l}"},
{"key": "data.voice.polish.sip.1", "text": "Слухай, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.polish.sip.2", "text": "Хм, {advice_l}", "src": "Hm, {advice_l}"},
{"key": "data.voice.polish.wrong.0", "text": "Nie. Не той.", "src": "Nie. Wrong one."},
{"key": "data.voice.polish.wrong.1", "text": "Це не моє.", "src": "This is not mine."},
{"key": "data.voice.polish.wrong.2", "text": "Co to jest? Що це?", "src": "Co to jest?"},
{"key": "data.voice.turkish.another.0", "text": "Bir daha! Ще!", "src": "Bir daha!"},
{"key": "data.voice.turkish.another.1", "text": "Ще один, abi!", "src": "Another, abi!"},
{"key": "data.voice.turkish.another.2", "text": "Повтори, eyvallah!", "src": "Again, eyvallah!"},
{"key": "data.voice.turkish.close.0", "text": "Tamam, нормально.", "src": "Tamam."},
{"key": "data.voice.turkish.close.1", "text": "İdare eder. Зійде.", "src": "İdare eder."},
{"key": "data.voice.turkish.close.2", "text": "Гаразд, добре.", "src": "Okay, fine."},
{"key": "data.voice.turkish.kicked.0", "text": "Ciddi misin? Ну гаразд.", "src": "Ciddi misin? Okay."},
{"key": "data.voice.turkish.kicked.1", "text": "Abi, справді? Ну добре.", "src": "Abi, really? Fine."},
{"key": "data.voice.turkish.kicked.2", "text": "Yok, yok. Я йду.", "src": "Yok, yok. I'm going."},
{"key": "data.voice.turkish.leaving.0", "text": "Yok, я більше не чекаю.", "src": "Yok, I'm not waiting anymore."},
{"key": "data.voice.turkish.leaving.1", "text": "Abi, тут хтось працює?", "src": "Abi, is nobody working here?"},
{"key": "data.voice.turkish.leaving.2", "text": "Tamam, hoşça kal. Бувай.", "src": "Tamam, hoşça kal."},
{"key": "data.voice.turkish.order.0", "text": "Abi, мені {drink}.", "src": "Abi, a {drink}."},
{"key": "data.voice.turkish.order.1", "text": "{drink}, eyvallah.", "src": "One {drink}, eyvallah."},
{"key": "data.voice.turkish.order.2", "text": "{drink}, canım, коли зможеш.", "src": "{drink}, canım, when you can."},
