{"strings": [
{"key": "data.voice.arabic.another.0", "text": "Kaman wahad! Ще один!", "src": "Kaman wahad!"},
{"key": "data.voice.arabic.another.1", "text": "Yalla, ще раз!", "src": "One more, yalla!"},
{"key": "data.voice.arabic.another.2", "text": "Повтори, habibi!", "src": "Again, habibi!"},
{"key": "data.voice.arabic.close.0", "text": "Maashi, нормально.", "src": "Maashi."},
{"key": "data.voice.arabic.close.1", "text": "Та гаразд.", "src": "It is okay."},
{"key": "data.voice.arabic.close.2", "text": "Tamam, дякую.", "src": "Tamam, shukran."},
{"key": "data.voice.arabic.kicked.0", "text": "Shu? Серйозно?", "src": "Shu? Seriously?"},
{"key": "data.voice.arabic.kicked.1", "text": "Khalas. Ну добре.", "src": "Khalas. Fine."},
{"key": "data.voice.arabic.kicked.2", "text": "Yalla. Я йду.", "src": "Yalla. I go."},
{"key": "data.voice.arabic.leaving.0", "text": "Khalas. Мені час.", "src": "Khalas. I am going."},
{"key": "data.voice.arabic.leaving.1", "text": "Yalla, досить чекати.", "src": "Yalla, enough waiting."},
{"key": "data.voice.arabic.leaving.2", "text": "Maa salama. Бувай.", "src": "Maa salama."},
{"key": "data.voice.arabic.order.0", "text": "Мені {drink}, будь ласка.", "src": "A {drink}, please."},
{"key": "data.voice.arabic.order.1", "text": "{drink}, shukran.", "src": "One {drink}, shukran."},
{"key": "data.voice.arabic.order.2", "text": "Habibi, мені — {drink}.", "src": "Habibi, a {drink}."},
{"key": "data.voice.arabic.order.3", "text": "Для мене — {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.arabic.perfect.0", "text": "Ya salam! Чудово!", "src": "Ya salam!"},
{"key": "data.voice.arabic.perfect.1", "text": "Helu kteer! Смачно!", "src": "Helu kteer!"},
{"key": "data.voice.arabic.perfect.2", "text": "Ідеально, habibi!", "src": "Perfect, habibi!"},
{"key": "data.voice.arabic.praise.0", "text": "Ya salam. Оце воно, habibi.", "src": "Ya salam. This is the one, habibi."},
{"key": "data.voice.arabic.praise.1", "text": "Helu kteer. Щиро дякую.", "src": "Helu kteer. Shukran."},
{"key": "data.voice.arabic.praise.2", "text": "Yalla, ти майстер своєї справи.", "src": "Yalla, you know your work."},
{"key": "data.voice.arabic.sip.0", "text": "Habibi, {advice_l}", "src": "Habibi, {advice_l}"},
{"key": "data.voice.arabic.sip.1", "text": "Shuf, {advice_l}", "src": "Shuf, {advice_l}"},
{"key": "data.voice.arabic.sip.2", "text": "Tamam, але {advice_l}", "src": "Tamam, bas {advice_l}"},
{"key": "data.voice.arabic.wrong.0", "text": "La, la. Ні.", "src": "La, la."},
{"key": "data.voice.arabic.wrong.1", "text": "Це не те.", "src": "This is not it."},
{"key": "data.voice.arabic.wrong.2", "text": "Shu hada? Що це?", "src": "Shu hada?"},
{"key": "data.voice.chinese.another.0", "text": "Zai lai yi bei! Ще келих!", "src": "Zai lai yi bei!"},
{"key": "data.voice.chinese.another.1", "text": "Ще один, а!", "src": "One more, ah!"},
{"key": "data.voice.chinese.another.2", "text": "Повтори, будь ласка!", "src": "Again, please!"},
{"key": "data.voice.chinese.close.0", "text": "Hai keyi. Нормально.", "src": "Hai keyi."},
{"key": "data.voice.chinese.close.1", "text": "Добре, lah.", "src": "Okay lah."},
{"key": "data.voice.chinese.close.2", "text": "Та нічого.", "src": "It is fine."},
{"key": "data.voice.chinese.kicked.0", "text": "Shenme? Справді?", "src": "Shenme? Really?"},
{"key": "data.voice.chinese.kicked.1", "text": "Aiya. Ну добре.", "src": "Aiya. Fine."},
{"key": "data.voice.chinese.kicked.2", "text": "Hao. Я йду.", "src": "Hao. I leave."},
{"key": "data.voice.chinese.leaving.0", "text": "Aiya. Надто довго чекати.", "src": "Aiya. I waited too long."},
{"key": "data.voice.chinese.leaving.1", "text": "Suan le. Піду.", "src": "Suan le. I go."},
{"key": "data.voice.chinese.leaving.2", "text": "Тоді zaijian.", "src": "Zaijian, then."},
{"key": "data.voice.chinese.order.0", "text": "{drink}, будь ласка.", "src": "{drink}, please."},
{"key": "data.voice.chinese.order.1", "text": "Мені {drink}, xiexie.", "src": "One {drink}, xiexie."},
{"key": "data.voice.chinese.order.2", "text": "Для мене — {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.chinese.order.3", "text": "Замовлю так: {drink}.", "src": "A {drink} for me."},
{"key": "data.voice.chinese.perfect.0", "text": "Hen hao! Дуже добре!", "src": "Hen hao!"},
{"key": "data.voice.chinese.perfect.1", "text": "Ідеально, а!", "src": "Perfect, ah!"},
{"key": "data.voice.chinese.perfect.2", "text": "Zhen bang! Клас!", "src": "Zhen bang!"},
{"key": "data.voice.chinese.praise.0", "text": "Zhen bang. Заради цього я ще прийду.", "src": "Zhen bang. I will come back for this."},
{"key": "data.voice.chinese.praise.1", "text": "Hen hao. Ти знаєш, що робиш.", "src": "Hen hao. You know what you are doing."},
{"key": "data.voice.chinese.praise.2", "text": "Ідеально, а. Справді.", "src": "Perfect, ah. Really."},
{"key": "data.voice.chinese.sip.0", "text": "Ай, {advice_l}", "src": "Ai, {advice_l}"},
{"key": "data.voice.chinese.sip.1", "text": "Слухай, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.chinese.sip.2", "text": "Hao, але {advice_l}", "src": "Hao, but {advice_l}"},
{"key": "data.voice.chinese.wrong.0", "text": "Bu dui. Не те.", "src": "Bu dui."},
{"key": "data.voice.chinese.wrong.1", "text": "Aiya, ні.", "src": "Aiya, no."},
{"key": "data.voice.chinese.wrong.2", "text": "Не цей.", "src": "Not this one."},
{"key": "data.voice.filipino.another.0", "text": "Isa pa! Ще один!", "src": "Isa pa!"},
{"key": "data.voice.filipino.another.1", "text": "Ще раз, ha!", "src": "One more, ha!"},
{"key": "data.voice.filipino.another.2", "text": "Повтори, будь ласка!", "src": "Again, please!"},
{"key": "data.voice.filipino.close.0", "text": "Okay lang, нормально.", "src": "Okay lang."},
{"key": "data.voice.filipino.close.1", "text": "Sige, дякую.", "src": "Sige, thanks."},
{"key": "data.voice.filipino.close.2", "text": "Ay, та нічого.", "src": "Ay, it's fine."},
{"key": "data.voice.filipino.kicked.0", "text": "Ha? Справді?", "src": "Ha? Really?"},
{"key": "data.voice.filipino.kicked.1", "text": "Ay. Гаразд. Бувай.", "src": "Ay. Okay. Bye."},
{"key": "data.voice.filipino.kicked.2", "text": "Grabe naman. Ну ти даєш.", "src": "Grabe naman."},
{"key": "data.voice.filipino.leaving.0", "text": "Ay, grabe. Задовго. Я йду.", "src": "Ay, grabe. Too long. I'm going."},
{"key": "data.voice.filipino.leaving.1", "text": "Sige na, бувай.", "src": "Sige na, bye."},
{"key": "data.voice.filipino.leaving.2", "text": "Naku, ніхто так і не підходить.", "src": "Naku, no one is coming."},
{"key": "data.voice.filipino.order.0", "text": "Ay, мені {drink}, будь ласка.", "src": "Ay, one {drink}, please."},
{"key": "data.voice.filipino.order.1", "text": "Для мене — {drink}. Salamat.", "src": "{drink} for me. Salamat."},
{"key": "data.voice.filipino.order.2", "text": "{drink} — можна? Дякую, ha.", "src": "Can I have a {drink}? Thanks, ha."},
{"key": "data.voice.filipino.order.3", "text": "Kuya, мені {drink}.", "src": "A {drink}, kuya."},
{"key": "data.voice.filipino.perfect.0", "text": "Ay, sarap! Смачно!", "src": "Ay, sarap!"},
{"key": "data.voice.filipino.perfect.1", "text": "Grabe, так!", "src": "Grabe, yes!"},
{"key": "data.voice.filipino.perfect.2", "text": "Ідеально, kuya!", "src": "Perfect, kuya!"},
{"key": "data.voice.filipino.praise.0", "text": "Grabe. Це так добре. Salamat.", "src": "Grabe. That is so good. Salamat."},
{"key": "data.voice.filipino.praise.1", "text": "Ay, sarap. Після такого й зміна не страшна.", "src": "Ay, sarap. You made my whole shift."},
{"key": "data.voice.filipino.praise.2", "text": "Sige, заради цього я ще повернуся.", "src": "Sige, I'm coming back for this."},
{"key": "data.voice.filipino.sip.0", "text": "Ay, {advice_l}", "src": "Ay, {advice_l}"},
{"key": "data.voice.filipino.sip.1", "text": "Sige, але {advice_l}", "src": "Sige, but {advice_l}"},
{"key": "data.voice.filipino.sip.2", "text": "Ha? {advice}", "src": "Ha? {advice}"},
{"key": "data.voice.filipino.wrong.0", "text": "Ay, hindi. Не це.", "src": "Ay, hindi. Not this."},
{"key": "data.voice.filipino.wrong.1", "text": "Grabe, не той напій.", "src": "Grabe, wrong drink."},
{"key": "data.voice.filipino.wrong.2", "text": "Не моє, kuya.", "src": "Not mine, kuya."},
{"key": "data.voice.italian.another.0", "text": "Ancora, dai! Ще!", "src": "Ancora, dai!"},
{"key": "data.voice.italian.another.1", "text": "Ще один, grazie!", "src": "Another, grazie!"},
{"key": "data.voice.italian.another.2", "text": "Ще раз, amore!", "src": "Once more, amore!"},
{"key": "data.voice.italian.close.0", "text": "Va bene, нормально.", "src": "Va bene."},
{"key": "data.voice.italian.close.1", "text": "Добре, grazie.", "src": "Okay, grazie."},
{"key": "data.voice.italian.close.2", "text": "Непогано, eh.", "src": "Not bad, eh."},
{"key": "data.voice.italian.kicked.0", "text": "Ma dai! Справді?", "src": "Ma dai! Really?"},
{"key": "data.voice.italian.kicked.1", "text": "Ну, va bene. Ciao, ciao.", "src": "Va bene. Ciao, ciao."},
{"key": "data.voice.italian.kicked.2", "text": "Che maleducato. Як неввічливо.", "src": "Che maleducato."},
{"key": "data.voice.italian.leaving.0", "text": "Basta. Я йду.", "src": "Basta. I go."},
{"key": "data.voice.italian.leaving.1", "text": "Mamma mia, скільки можна чекати!", "src": "Mamma mia, the waiting!"},
{"key": "data.voice.italian.leaving.2", "text": "Ciao. Може, в наступному житті.", "src": "Ciao. Maybe next life."},
{"key": "data.voice.italian.order.0", "text": "Мені {drink}, per favore.", "src": "Un {drink}, per favore."},
{"key": "data.voice.italian.order.1", "text": "Amore, {drink}, будь ласка.", "src": "A {drink}, amore."},
{"key": "data.voice.italian.order.2", "text": "Для мене — {drink}, grazie.", "src": "{drink}, grazie."},
{"key": "data.voice.italian.order.3", "text": "Dai, нехай буде {drink}.", "src": "Dai, a {drink}."},
{"key": "data.voice.italian.perfect.0", "text": "Perfetto! Ідеально!", "src": "Perfetto!"},
{"key": "data.voice.italian.perfect.1", "text": "Bravo! Молодчина!", "src": "Bravo!"},
{"key": "data.voice.italian.perfect.2", "text": "Che buono! Смакота!", "src": "Che buono!"},
{"key": "data.voice.italian.praise.0", "text": "Perfetto. Справді. Grazie mille.", "src": "Perfetto. Truly. Grazie mille."},
{"key": "data.voice.italian.praise.1", "text": "Bravo. Моя nonna б розплакалася.", "src": "Bravo. My nonna would cry."},
{"key": "data.voice.italian.praise.2", "text": "Che buono. Я звідси не піду.", "src": "Che buono. I'm not leaving."},
{"key": "data.voice.italian.sip.0", "text": "Senti, {advice_l}", "src": "Senti, {advice_l}"},
{"key": "data.voice.italian.sip.1", "text": "Allora, {advice_l}", "src": "Allora, {advice_l}"},
{"key": "data.voice.italian.sip.2", "text": "Va bene, ma {advice_l}", "src": "Va bene, ma {advice_l}"},
{"key": "data.voice.italian.wrong.0", "text": "Mamma mia, ні.", "src": "Mamma mia, no."},
{"key": "data.voice.italian.wrong.1", "text": "Ma che cos'è? Що це?", "src": "Ma che cos'è?"},
{"key": "data.voice.italian.wrong.2", "text": "Ні, ні. Не це.", "src": "No, no. Not this."},
{"key": "data.voice.miami.another.0", "text": "¡Otra, dale! Ще!", "src": "¡Otra, dale!"},
{"key": "data.voice.miami.another.1", "text": "Ще один, oye!", "src": "One more, oye!"},
{"key": "data.voice.miami.another.2", "text": "Повтори, mi amor!", "src": "Again, mi amor!"},
{"key": "data.voice.miami.close.0", "text": "Está bien, нормально.", "src": "Está bien."},
{"key": "data.voice.miami.close.1", "text": "Непогано, chico.", "src": "Not bad, chico."},
{"key": "data.voice.miami.close.2", "text": "Окей, окей.", "src": "Okay, okay."},
{"key": "data.voice.miami.kicked.0", "text": "¿En serio? Ну й добре.", "src": "¿En serio? Okay, fine."},
{"key": "data.voice.miami.kicked.1", "text": "Ти жартуєш, chico.", "src": "You're kidding me, chico."},
{"key": "data.voice.miami.kicked.2", "text": "Dale. Тобі ж гірше.", "src": "Dale. Your loss."},
{"key": "data.voice.miami.leaving.0", "text": "¡Oye! Я тут цілу ніч сиджу.", "src": "¡Oye! I've been sitting here all night."},
{"key": "data.voice.miami.leaving.1", "text": "Bueno, усе. Ciao.", "src": "Bueno, that's it. Ciao."},
{"key": "data.voice.miami.leaving.2", "text": "No, no. Я більше не чекаю.", "src": "No, no. I'm not waiting anymore."},
{"key": "data.voice.miami.order.0", "text": "Oye, мені {drink}.", "src": "Oye, a {drink} for me."},
{"key": "data.voice.miami.order.1", "text": "Dale: {drink}, будь ласка.", "src": "Dale, one {drink}."},
{"key": "data.voice.miami.order.2", "text": "{drink}, papi, коли зможеш.", "src": "{drink}, papi, when you can."},
{"key": "data.voice.miami.order.3", "text": "Mi amor, для мене — {drink}.", "src": "Mi amor, a {drink}."},
{"key": "data.voice.miami.perfect.0", "text": "¡Qué rico! Смакота!", "src": "¡Qué rico!"},
{"key": "data.voice.miami.perfect.1", "text": "¡Eso es! Оце воно!", "src": "¡Eso es!"},
{"key": "data.voice.miami.perfect.2", "text": "¡Dale, ідеально!", "src": "¡Dale, perfecto!"},
{"key": "data.voice.miami.praise.0", "text": "Ay, оце воно. Gracias.", "src": "Ay, this is the one. Gracias."},
{"key": "data.voice.miami.praise.1", "text": "Моя abuela схвалила б, а вона нічого не схвалює.", "src": "My abuela would approve, and she approves of nothing."},
{"key": "data.voice.miami.praise.2", "text": "Dale. Ти знаєш, що робиш.", "src": "Dale. You know what you're doing."},
{"key": "data.voice.miami.sip.0", "text": "Mira, {advice_l}", "src": "Mira, {advice_l}"},
{"key": "data.voice.miami.sip.1", "text": "Oye, {advice_l}", "src": "Oye, {advice_l}"},
{"key": "data.voice.miami.sip.2", "text": "Está bien, pero… {advice_l}", "src": "Está bien, pero… {advice_l}"},
{"key": "data.voice.miami.wrong.0", "text": "¿Qué es esto? Що це?", "src": "¿Qué es esto?"},
{"key": "data.voice.miami.wrong.1", "text": "Ні, ні, ні.", "src": "No, no, no."},
{"key": "data.voice.miami.wrong.2", "text": "Не моє, oye.", "src": "Not mine, oye."},
{"key": "data.voice.nyc.another.0", "text": "Давай ще!", "src": "Hit me again!"},
{"key": "data.voice.nyc.another.1", "text": "Неси ще, не зупиняйся!", "src": "Keep 'em comin'!"},
{"key": "data.voice.nyc.another.2", "text": "Ще один, chief!", "src": "Another, chief!"},
{"key": "data.voice.nyc.close.0", "text": "Е. Нормально.", "src": "Eh. It's fine."},
{"key": "data.voice.nyc.close.1", "text": "Yeah, гаразд.", "src": "Yeah, alright."},
{"key": "data.voice.nyc.close.2", "text": "Зійде.", "src": "It'll do."},
{"key": "data.voice.nyc.kicked.0", "text": "Ти зараз серйозно?", "src": "You serious right now?"},
{"key": "data.voice.nyc.kicked.1", "text": "Та й ну. Бар однаково жахливий.", "src": "Fine. Terrible bar anyway."},
{"key": "data.voice.nyc.kicked.2", "text": "Вау. Окей. Вау.", "src": "Wow. Okay. Wow."},
{"key": "data.voice.nyc.leaving.0", "text": "У мене справи. Забудь.", "src": "I got places to be. Forget it."},
{"key": "data.voice.nyc.leaving.1", "text": "Неймовірно. Я звідси.", "src": "Unbelievable. I'm outta here."},
{"key": "data.voice.nyc.leaving.2", "text": "Yo, це бар чи зала очікування?", "src": "Yo, is this a bar or a waiting room?"},
{"key": "data.voice.nyc.order.0", "text": "Yo, мені {drink}.", "src": "Yo, lemme get a {drink}."},
{"key": "data.voice.nyc.order.1", "text": "{drink}. І я поспішаю.", "src": "{drink}. And I'm in a hurry."},
{"key": "data.voice.nyc.order.2", "text": "{drink}, chief. Давай.", "src": "Gimme a {drink}, chief."},
{"key": "data.voice.nyc.order.3", "text": "{drink}. І без фокусів.", "src": "{drink}. Don't make it weird."},
{"key": "data.voice.nyc.perfect.0", "text": "Оце вже розмова!", "src": "Now we're talkin'!"},
{"key": "data.voice.nyc.perfect.1", "text": "Оце те, що треба!", "src": "That's the stuff!"},
{"key": "data.voice.nyc.perfect.2", "text": "О, саме воно!", "src": "Oh, that's it!"},
{"key": "data.voice.nyc.praise.0", "text": "Окей, це вражає. А мене важко вразити.", "src": "Okay, I'm impressed. That never happens."},
{"key": "data.voice.nyc.praise.1", "text": "Кажу тобі, оце напій.", "src": "Lemme tell ya, that's a drink."},
{"key": "data.voice.nyc.praise.2", "text": "За таке треба брати більше. Не бери.", "src": "You should charge more for this. Don't."},
{"key": "data.voice.nyc.sip.0", "text": "Слухай, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.nyc.sip.1", "text": "Я просто кажу: {advice_l}", "src": "I'm just sayin', {advice_l}"},
{"key": "data.voice.nyc.sip.2", "text": "Непогано, але {advice_l}", "src": "Not bad, but {advice_l}"},
{"key": "data.voice.nyc.wrong.0", "text": "Що це таке?", "src": "What is this?"},
{"key": "data.voice.nyc.wrong.1", "text": "Fuhgeddaboudit. Не те.", "src": "Fuhgeddaboudit."},
{"key": "data.voice.nyc.wrong.2", "text": "Не той, pal.", "src": "Wrong one, pal."},
{"key": "data.voice.surfer.another.0", "text": "Ще один, dude!", "src": "One more, dude!"},
{"key": "data.voice.surfer.another.1", "text": "Ще, ще!", "src": "Again, again!"},
{"key": "data.voice.surfer.another.2", "text": "Не зупиняйся, хвиля йде!", "src": "Keep 'em rolling!"},
{"key": "data.voice.surfer.close.0", "text": "Cool, нормас.", "src": "Cool, cool."},
{"key": "data.voice.surfer.close.1", "text": "Ага, згодиться.", "src": "Yeah, that works."},
{"key": "data.voice.surfer.close.2", "text": "Досить непогано.", "src": "Nice enough."},
{"key": "data.voice.surfer.kicked.0", "text": "Жорстко, dude.", "src": "Harsh, dude."},
{"key": "data.voice.surfer.kicked.1", "text": "Окей… такий вайб.", "src": "Okay… that's a vibe."},
{"key": "data.voice.surfer.kicked.2", "text": "Вау. Зовсім не chill.", "src": "Wow. Not chill."},
{"key": "data.voice.surfer.leaving.0", "text": "Dude, я тут уже цілу вічність.", "src": "Dude, I've been here forever."},
{"key": "data.voice.surfer.leaving.1", "text": "Not cool. Я пас.", "src": "Not cool. I'm out."},
{"key": "data.voice.surfer.leaving.2", "text": "Ну, ні. Злиняю.", "src": "Yeah, no. Bailing."},
