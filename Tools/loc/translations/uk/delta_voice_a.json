{"strings": [
{"key": "data.voice.african.another.0", "text": "Неси ще один!", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "Ще один, abeg!", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "Повтори, друже мій!", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "Нормально.", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "No wahala, усе гаразд.", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "Добре, дякую.", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "Ah ah! Серйозно?", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala. Я піду.", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "Друже мій, це негарно.", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah ah. Досить уже чекати.", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala. Я йду.", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "Піду я, друже мій.", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "{drink}, будь ласка.", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "Друже мій, мені — {drink}.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Для мене — {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "{drink}, abeg. Дякую!", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "Ah, смакота!", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "Оце правильно!", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "Оце гарно!", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, оце правильний напій. Дякую.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "Жодних wahala. Дуже гарно.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "Друже мій, ти своє діло знаєш.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "Друже мій, {advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg, {advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "Нормально, але {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah, ні.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "Це не те.", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "Друже мій, ні.", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "Те саме, mate!", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "Ще раз, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "Ну давай, ще один!", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "Непогано.", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Ta, зійде.", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "Гаразд, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Чарівно. Просто чарівно.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "Так. Ну що ж. Дякую ні за що.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "Ти що, жартуєш?", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Усе. Досить із мене чекання.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "Та ну його. Я звідси.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Якось паршиво тут. Bye.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "{drink}, mate, як матимеш хвильку.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, будь ласка. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "Ну гаразд, нехай буде {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "Мені — {drink}, ta.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "Просто lovely!", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "Дякую, mate!", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "Оце по-справжньому!", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Blimey. Це справді lovely.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Зроблено як слід.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Чортовськи добре, скажу тобі.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "Одна дрібниця: {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Слухай, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Щось не те.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Ем, це не моє.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "Це не моє замовлення.", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "Ще один, yaar!", "src": "One more, yaar!"},
{"key": "data.voice.desi.another.1", "text": "Aur ek! Ще!", "src": "Aur ek!"},
{"key": "data.voice.desi.another.2", "text": "Повтори, будь ласка!", "src": "Again, please!"},
{"key": "data.voice.desi.close.0", "text": "Theek hai, нормально.", "src": "Theek hai."},
{"key": "data.voice.desi.close.1", "text": "Та нічого, na.", "src": "It is okay, na."},
{"key": "data.voice.desi.close.2", "text": "Chalega. Зійде.", "src": "Chalega."},
{"key": "data.voice.desi.kicked.0", "text": "Kya? Серйозно?", "src": "Kya? Seriously?"},
{"key": "data.voice.desi.kicked.1", "text": "Arre. Ну добре.", "src": "Arre. Okay, fine."},
{"key": "data.voice.desi.kicked.2", "text": "Chalo. Я йду.", "src": "Chalo. I go."},
{"key": "data.voice.desi.leaving.0", "text": "Arre yaar. Надто довго.", "src": "Arre yaar. Too long."},
{"key": "data.voice.desi.leaving.1", "text": "Chalo, мені час.", "src": "Chalo, I am going."},
{"key": "data.voice.desi.leaving.2", "text": "Bas. Досить.", "src": "Bas. Enough."},
{"key": "data.voice.desi.order.0", "text": "{drink}, будь ласка.", "src": "One {drink}, please."},
{"key": "data.voice.desi.order.1", "text": "Yaar, мені — {drink}.", "src": "A {drink}, yaar."},
{"key": "data.voice.desi.order.2", "text": "Для мене — {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.desi.order.3", "text": "{drink}, na? Можна?", "src": "{drink}, na?"},
{"key": "data.voice.desi.perfect.0", "text": "Wah, ідеально!", "src": "Wah, perfect!"},
{"key": "data.voice.desi.perfect.1", "text": "Ekdum першокласно!", "src": "Ekdum first class!"},
{"key": "data.voice.desi.perfect.2", "text": "Bahut badhiya! Клас!", "src": "Bahut badhiya!"},
{"key": "data.voice.desi.praise.0", "text": "Wah. Ekdum ідеально, yaar.", "src": "Wah. Ekdum perfect, yaar."},
{"key": "data.voice.desi.praise.1", "text": "Bahut badhiya. Чесно.", "src": "Bahut badhiya. Really."},
{"key": "data.voice.desi.praise.2", "text": "Першокласно. Я ще прийду.", "src": "First class. I am coming back."},
{"key": "data.voice.desi.sip.0", "text": "Arre, {advice_l}", "src": "Arre, {advice_l}"},
{"key": "data.voice.desi.sip.1", "text": "Yaar, {advice_l}", "src": "Yaar, {advice_l}"},
{"key": "data.voice.desi.sip.2", "text": "Theek hai, але {advice_l}", "src": "Theek hai, but {advice_l}"},
{"key": "data.voice.desi.wrong.0", "text": "Arre, ні.", "src": "Arre, no."},
{"key": "data.voice.desi.wrong.1", "text": "Це не моє.", "src": "This is not mine."},
{"key": "data.voice.desi.wrong.2", "text": "Nahi, не той.", "src": "Nahi, wrong one."},
{"key": "data.voice.german.another.0", "text": "Noch eins! Ще один!", "src": "Noch eins!"},
{"key": "data.voice.german.another.1", "text": "Ще раз, bitte!", "src": "Another, bitte!"},
{"key": "data.voice.german.another.2", "text": "Повторити, будь ласка!", "src": "Again, please!"},
{"key": "data.voice.german.close.0", "text": "Ja, гаразд.", "src": "Ja, okay."},
{"key": "data.voice.german.close.1", "text": "Прийнятно.", "src": "Acceptable."},
{"key": "data.voice.german.close.2", "text": "Цілком нормально.", "src": "It is fine."},
{"key": "data.voice.german.kicked.0", "text": "Це абсурд.", "src": "This is absurd."},
{"key": "data.voice.german.kicked.1", "text": "Добре. Більше я не прийду.", "src": "Fine. I will not return."},
{"key": "data.voice.german.kicked.2", "text": "Ja, ja. Я йду.", "src": "Ja, ja. I am going."},
{"key": "data.voice.german.leaving.0", "text": "Це неприйнятно. Я йду геть.", "src": "This is not acceptable. I am leaving."},
{"key": "data.voice.german.leaving.1", "text": "Nein. Досить чекати.", "src": "Nein. I have waited enough."},
{"key": "data.voice.german.leaving.2", "text": "Unglaublich. До побачення.", "src": "Unglaublich. Goodbye."},
{"key": "data.voice.german.order.0", "text": "{drink}, будь ласка. І як слід.", "src": "A {drink}, please. Correctly made."},
{"key": "data.voice.german.order.1", "text": "{drink}. Дякую.", "src": "{drink}. Thank you."},
{"key": "data.voice.german.order.2", "text": "Мені {drink}, bitte.", "src": "One {drink}, bitte."},
{"key": "data.voice.german.order.3", "text": "Прошу: {drink}.", "src": "I would like a {drink}."},
{"key": "data.voice.german.perfect.0", "text": "Genau! Саме так!", "src": "Genau!"},
{"key": "data.voice.german.perfect.1", "text": "Sehr gut, точно!", "src": "Sehr gut!"},
{"key": "data.voice.german.perfect.2", "text": "Wunderbar, чудово!", "src": "Wunderbar!"},
{"key": "data.voice.german.praise.0", "text": "Ja. Саме так, як має бути.", "src": "Ja. This is exactly right."},
{"key": "data.voice.german.praise.1", "text": "Точно. Поважаю точність.", "src": "Precise. I respect precision."},
{"key": "data.voice.german.praise.2", "text": "Sehr gut. Жодних зауважень.", "src": "Sehr gut. No notes."},
{"key": "data.voice.german.sip.0", "text": "Genau, але {advice_l}", "src": "Genau, but {advice_l}"},
{"key": "data.voice.german.sip.1", "text": "Одне зауваження: {advice_l}", "src": "One remark: {advice_l}"},
{"key": "data.voice.german.sip.2", "text": "Ja, {advice_l}", "src": "Ja, {advice_l}"},
{"key": "data.voice.german.wrong.0", "text": "Nein. Не це.", "src": "Nein. Not this."},
{"key": "data.voice.german.wrong.1", "text": "Це неправильно.", "src": "This is incorrect."},
{"key": "data.voice.german.wrong.2", "text": "Не той напій.", "src": "Wrong drink."},
{"key": "data.voice.korean.another.0", "text": "Han jan deo! Ще!", "src": "Han jan deo!"},
{"key": "data.voice.korean.another.1", "text": "Ще один!", "src": "One more!"},
{"key": "data.voice.korean.another.2", "text": "Повтори, juseyo!", "src": "Again, juseyo!"},
{"key": "data.voice.korean.close.0", "text": "Gwenchana. Нормально.", "src": "Gwenchana."},
{"key": "data.voice.korean.close.1", "text": "Та нічого.", "src": "It is okay."},
{"key": "data.voice.korean.close.2", "text": "Nappeuji anha. Непогано.", "src": "Nappeuji anha."},
{"key": "data.voice.korean.kicked.0", "text": "Jinjja? Ого.", "src": "Jinjja? Wow."},
{"key": "data.voice.korean.kicked.1", "text": "Aish. Ну й добре.", "src": "Aish. Fine."},
{"key": "data.voice.korean.kicked.2", "text": "Ну, тоді annyeong.", "src": "Annyeong, then."},
{"key": "data.voice.korean.leaving.0", "text": "Aish. Надто довго.", "src": "Aish. Too long."},
{"key": "data.voice.korean.leaving.1", "text": "Я йду. Annyeong.", "src": "I am going. Annyeong."},
{"key": "data.voice.korean.leaving.2", "text": "Mot chamgesseo. Досить.", "src": "Mot chamgesseo."},
{"key": "data.voice.korean.order.0", "text": "Мені {drink}, juseyo.", "src": "{drink}, juseyo."},
{"key": "data.voice.korean.order.1", "text": "{drink}, будь ласка.", "src": "One {drink}, please."},
{"key": "data.voice.korean.order.2", "text": "Для мене — {drink}.", "src": "A {drink} for me."},
{"key": "data.voice.korean.order.3", "text": "Хочу: {drink}.", "src": "I want a {drink}."},
{"key": "data.voice.korean.perfect.0", "text": "Daebak! Круто!", "src": "Daebak!"},
{"key": "data.voice.korean.perfect.1", "text": "Jinjja класно!", "src": "Jinjja good!"},
{"key": "data.voice.korean.perfect.2", "text": "Choego! Найкраще!", "src": "Choego!"},
{"key": "data.voice.korean.praise.0", "text": "Daebak. Jinjja, це ідеально.", "src": "Daebak. Jinjja, this is perfect."},
{"key": "data.voice.korean.praise.1", "text": "Choego. Я серйозно.", "src": "Choego. I mean it."},
{"key": "data.voice.korean.praise.2", "text": "Ого. Ти в цьому майстер.", "src": "Wow. You are good at this."},
{"key": "data.voice.korean.sip.0", "text": "Jamkkanman, {advice_l}", "src": "Jamkkanman, {advice_l}"},
{"key": "data.voice.korean.sip.1", "text": "Ем, {advice_l}", "src": "Um, {advice_l}"},
{"key": "data.voice.korean.sip.2", "text": "Gwenchana, але {advice_l}", "src": "Gwenchana, but {advice_l}"},
{"key": "data.voice.korean.wrong.0", "text": "Aniyo, ні.", "src": "Aniyo, no."},
{"key": "data.voice.korean.wrong.1", "text": "Це не те.", "src": "This is wrong."},
{"key": "data.voice.korean.wrong.2", "text": "Е? Не моє.", "src": "Eh? Not mine."},
{"key": "data.voice.nordic.another.0", "text": "Ще один. Skål!", "src": "Another. Skål!"},
{"key": "data.voice.nordic.another.1", "text": "Ще раз.", "src": "One more."},
{"key": "data.voice.nordic.another.2", "text": "Повторити, будь ласка.", "src": "Again, please."},
{"key": "data.voice.nordic.close.0", "text": "Нормально.", "src": "Fine."},
{"key": "data.voice.nordic.close.1", "text": "Та гаразд.", "src": "It's okay."},
{"key": "data.voice.nordic.close.2", "text": "Досить добре.", "src": "Good enough."},
{"key": "data.voice.nordic.kicked.0", "text": "Гаразд. Дивно, але гаразд.", "src": "Okay. Strange, but okay."},
{"key": "data.voice.nordic.kicked.1", "text": "Ну що ж.", "src": "Fine."},
{"key": "data.voice.nordic.kicked.2", "text": "Хм. Тоді бувай.", "src": "Hm. Goodbye then."},
{"key": "data.voice.nordic.leaving.0", "text": "Я піду. Нічого страшного.", "src": "I'll go. It's fine."},
{"key": "data.voice.nordic.leaving.1", "text": "Задовго. Бувай.", "src": "Too long. Goodbye."},
{"key": "data.voice.nordic.leaving.2", "text": "Ні. Я йду.", "src": "No. I'm leaving."},
{"key": "data.voice.nordic.order.0", "text": "{drink}. Дякую.", "src": "A {drink}. Thanks."},
{"key": "data.voice.nordic.order.1", "text": "Мені {drink}, будь ласка.", "src": "{drink}, please."},
{"key": "data.voice.nordic.order.2", "text": "{drink}. Не поспішай.", "src": "One {drink}. No rush."},
{"key": "data.voice.nordic.order.3", "text": "Для мене — {drink}.", "src": "I'll have the {drink}."},
{"key": "data.voice.nordic.perfect.0", "text": "Skål, гарно!", "src": "Skål!"},
{"key": "data.voice.nordic.perfect.1", "text": "Дуже добре.", "src": "Very good."},
{"key": "data.voice.nordic.perfect.2", "text": "Так. Добре.", "src": "Yes. Good."},
{"key": "data.voice.nordic.praise.0", "text": "Це дуже добре. А я таке рідко кажу.", "src": "This is very good. I don't say that."},
{"key": "data.voice.nordic.praise.1", "text": "Skål. Зроблено як слід.", "src": "Skål. Properly done."},
{"key": "data.voice.nordic.praise.2", "text": "Добре. Справді добре.", "src": "Good. Really good."},
{"key": "data.voice.nordic.sip.0", "text": "Ну. {advice}", "src": "Well. {advice}"},
{"key": "data.voice.nordic.sip.1", "text": "Хм. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.nordic.sip.2", "text": "Нормально, але {advice_l}", "src": "Fine, but {advice_l}"},
{"key": "data.voice.nordic.wrong.0", "text": "Ні. Не той.", "src": "No. Wrong one."},
{"key": "data.voice.nordic.wrong.1", "text": "Це не те.", "src": "This is not it."},
{"key": "data.voice.nordic.wrong.2", "text": "Хм. Не моє.", "src": "Hm. Not mine."},
{"key": "data.voice.southern.another.0", "text": "Налий-но ще!", "src": "Pour me another!"},
{"key": "data.voice.southern.another.1", "text": "Ще один, sugar!", "src": "One more, sugar!"},
{"key": "data.voice.southern.another.2", "text": "Не зупиняйся, darlin'!", "src": "Keep 'em comin'!"},
{"key": "data.voice.southern.close.0", "text": "Та нічого.", "src": "That's alright."},
{"key": "data.voice.southern.close.1", "text": "Що ж, справедливо.", "src": "Fair enough."},
{"key": "data.voice.southern.close.2", "text": "Ну, зійде.", "src": "Well, it'll do."},
{"key": "data.voice.southern.kicked.0", "text": "Ну, це вже просто грубо.", "src": "Well, that's just rude."},
{"key": "data.voice.southern.kicked.1", "text": "Ну гаразд. Гарного вечора.", "src": "Alright then. Have a good one."},
{"key": "data.voice.southern.kicked.2", "text": "Стривай-но… ну добре.", "src": "Now hold on… fine."},
{"key": "data.voice.southern.leaving.0", "text": "Ну, в мене не вся ніч у запасі.", "src": "Well, I ain't got all night."},
{"key": "data.voice.southern.leaving.1", "text": "Мабуть, пошукаю інший бар.", "src": "Reckon I'll drink elsewhere."},
{"key": "data.voice.southern.leaving.2", "text": "Y'all тут не поспішаєте, еге ж?", "src": "Y'all take your sweet time, don't you."},
{"key": "data.voice.southern.order.0", "text": "Ну що ж, {drink} мені підійде.", "src": "Well now, a {drink} would suit me."},
{"key": "data.voice.southern.order.1", "text": "{drink}, darlin', будь ласка.", "src": "{drink}, darlin', if you please."},
{"key": "data.voice.southern.order.2", "text": "Мабуть, мені {drink}.", "src": "Reckon I'll have a {drink}."},
{"key": "data.voice.southern.order.3", "text": "Для мене — {drink}, sugar.", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "Оце так краса!", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "Lord, як смачно!", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "Hot dang, клас!", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "Ну треба ж. Оце справжній напій.", "src": "Well, I'll be. That's a proper drink."},
{"key": "data.voice.southern.praise.1", "text": "Darlin', у тебе талант.", "src": "Darlin', you got a gift."},
{"key": "data.voice.southern.praise.2", "text": "Схоже, це моє нове місце.", "src": "Reckon I found my new spot."},
{"key": "data.voice.southern.sip.0", "text": "Тепер слухай: {advice_l}", "src": "Now, {advice_l}"},
{"key": "data.voice.southern.sip.1", "text": "Sugar, {advice_l}", "src": "Sugar, {advice_l}"},
{"key": "data.voice.southern.sip.2", "text": "Скажу тобі так: {advice_l}", "src": "Tell you what, {advice_l}"},
{"key": "data.voice.southern.wrong.0", "text": "Це не моє, hon.", "src": "Ain't mine, hon."},
{"key": "data.voice.southern.wrong.1", "text": "А це ще що таке?", "src": "Now what is this?"},
{"key": "data.voice.southern.wrong.2", "text": "Ох, bless your heart.", "src": "Bless your heart."}
]}
