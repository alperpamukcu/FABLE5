{"strings": [
{"key": "data.voice.aussie.another.0", "text": "同じのもう一杯、マイト！", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "もう一杯、チアーズ！", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "おかわり、レジェンド！", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "ああ、ライトー。", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "悪くないよ、マイト。", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "これでいいさ。", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "マジかよ、マイト？", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "ライトー。まあ、しょうがない。", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "ナー、それはキツいわ。", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "ライトー、もう十分待ったよ。", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "ナー、やってらんない。帰るわ。", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "何もしてもらってないけど、チアーズ、マイト。", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "{drink}を、マイト。", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink}をお願い。", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "{drink}もらおうかな。", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "{drink}をひとつ、チアーズ。", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "リッパー！", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "トゥー・イージー！", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "めちゃくちゃいい！", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "最高のリッパーだ、マイト。チアーズ。", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "トゥー・イージー。わかってるね。", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "正直、今夜一番の一杯だよ。", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "マイト、{advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "あのさ、{advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "ノー・ドラマだけど、{advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "ナー、マイト。", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "これ、頼んでないや、ごめん。", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "違うやつだよ、マイト。", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "もう一杯！", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "同じのをもう一杯！", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "どんどんお願い！", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "どうも。", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "これで十分。", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "惜しいけど、いいよ。", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "本気？まあいいや。", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "後悔するよ。", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "もういい。好きにして。", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "もういい。待つのはやめた。", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "今夜、誰か働いてる？", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "よし。よそで飲む。", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink}をお願い。", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "{drink}にします。", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "手が空いたら、{drink}を。", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "{drink}にしてください。", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "完璧！", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "これこれ！", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "ばっちり！", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "直すところなんてひとつもない。", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "これぞ一杯だね。", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "教えてくれた人に感謝しないと。", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "うーん。{advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice}一応ね。", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "正直に言うと？{advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "頼んだのと違う。", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "ドリンクが違うよ。", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "それ、私のじゃない。", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "アンコール、お願い！", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "もう一杯、ウィ！", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "おかわり、メルシー！", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "サ・ヴァ。", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "まあ、いいでしょう。", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "ボン、オーケー。", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "コワ？本当に？", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "ボン。オ・ルヴォワール。", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "セ・リディキュル。", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "ノン。もう十分待った。", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "タン・ピ。帰る。", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "では、オ・ルヴォワール。", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "{drink}を、シル・ヴ・プレ。", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "{drink}をお願い。", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "{drink}をひとつ、メルシー。", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "{drink}をいただくよ。", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "パルフェ！", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "ヴォワラ、完璧！", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "マニフィック！", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "パルフェ。言うことは何もない。", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "ヴォワラ。ここにも注げる人がいた。", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "マニフィック。本当に。", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "エクート、{advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "ボン、{advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "アロール、{advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "ノン、ノン。", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "これじゃない。", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "パルドン、違うよ。", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "もう一杯！", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "もう一杯、乾杯！", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "おかわり、お願い！", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "うん、まあいいよ。", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "まあまあだね。", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "悪くないね。", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "えっ？！マジで？", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "ひどいな。わかった、帰るよ。", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "わかったよ。じゃあね。", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "すみません、もう待てないです。", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "もういいや。帰る。", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "しかたない。お先に。", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "すみません、{drink}を。", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "{drink}ひとつ、お願い。", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink}お願いします。ありがとう。", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "えっと…{drink}で。", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "おいしい！", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "すごい、完璧！", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "乾杯！", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "おいしい。本当に、これだよ。", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "すごい。プロだね。", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "乾杯。これは完璧。", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "えっと、{advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "ねえ、{advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "すみません、でも{advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "ちょっと…違うかな。", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "え？これじゃない。", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "違うよ、ごめんね。", "src": "Chigau, sorry."},
{"key": "data.voice.midwest.another.0", "text": "もう一杯、お願いします！", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "もう一杯、ありがとう！", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "同じのもう一杯、オープ！", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "あら、大丈夫ですよ。", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "ええ、ありがとう。", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "全然悪くないです。", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "あら。そう。わかりました。", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "オープ、ごめんなさい…帰りますね。", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "ちょっとやりすぎだけど、わかりました。", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "あらまあ、本当にもう待てなくて。", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "さて、そろそろ行かないと。", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "ごめんなさい、もう出ますね。", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "{drink}をもらえます？ほんとにありがとう。", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "ご迷惑でなければ、{drink}を。", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "あ、私は{drink}だけで。", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink}をお願いします。いつでも。", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "あら、すごくいい！", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "ユー・ベッチャ！", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "オー・ジーズ、最高！", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "まあ、なんて素敵なの。", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "すごくいい。叔母もこの店が気に入りそう。", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "ああ、これが飲みたかった。", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "あ、{advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "念のためだけど、{advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "大したことじゃないけど、{advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "オープ。これ、違うやつ。", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "あら、私のじゃないです。", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "ごめんなさい、これじゃなくて。", "src": "Sorry, no. Not this."},
{"key": "data.voice.polish.another.0", "text": "イェシチェ・ラズ！", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "もう一杯、プロシェ！", "src": "Another, proszę!"},
{"key": "data.voice.polish.another.2", "text": "おかわり！", "src": "One more!"},
{"key": "data.voice.polish.close.0", "text": "ドブジェ。", "src": "Dobrze."},
{"key": "data.voice.polish.close.1", "text": "オーケー。", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "いいよ、ありがとう。", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "セリオ？わかった。", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "いいよ。ド・ヴィジェニャ。", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "ツォ？わかった、帰る。", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "もう十分。帰る。", "src": "Enough. I'm going."},
{"key": "data.voice.polish.leaving.1", "text": "ニェ、ニェ。長すぎ。", "src": "Nie, nie. Too long."},
{"key": "data.voice.polish.leaving.2", "text": "ド・ヴィジェニャ。", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "{drink}を、プロシェ。", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "{drink}をお願い。", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "{drink}をひとつ。ありがとう。", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "ドブジェ、{drink}を。", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "ナ・ズドロヴィエ！", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "シフィェトニェ！", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "すごくいい！", "src": "Very good!"},
{"key": "data.voice.polish.praise.0", "text": "ナ・ズドロヴィエ。これは本物の一杯だ。", "src": "Na zdrowie. This is a real drink."},
{"key": "data.voice.polish.praise.1", "text": "シフィェトニェ。家で飲むみたい。", "src": "Świetnie. Like at home."},
{"key": "data.voice.polish.praise.2", "text": "ドブジェ。すごく、すごくいい。", "src": "Dobrze. Very, very good."},
{"key": "data.voice.polish.sip.0", "text": "ドブジェ、でも{advice_l}", "src": "Dobrze, but {advice_l}"},
{"key": "data.voice.polish.sip.1", "text": "聞いて、{advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.polish.sip.2", "text": "うーん、{advice_l}", "src": "Hm, {advice_l}"},
{"key": "data.voice.polish.wrong.0", "text": "ニェ。違うやつ。", "src": "Nie. Wrong one."},
{"key": "data.voice.polish.wrong.1", "text": "これ、私のじゃない。", "src": "This is not mine."},
{"key": "data.voice.polish.wrong.2", "text": "ツォ・ト・イェスト？", "src": "Co to jest?"},
{"key": "data.voice.turkish.another.0", "text": "ビル・ダハ！", "src": "Bir daha!"},
{"key": "data.voice.turkish.another.1", "text": "もう一杯、アビ！", "src": "Another, abi!"},
{"key": "data.voice.turkish.another.2", "text": "おかわり、エイヴァッラー！", "src": "Again, eyvallah!"},
{"key": "data.voice.turkish.close.0", "text": "タマム。", "src": "Tamam."},
{"key": "data.voice.turkish.close.1", "text": "イダーレ・エデル。まあまあ。", "src": "İdare eder."},
{"key": "data.voice.turkish.close.2", "text": "オーケー、いいよ。", "src": "Okay, fine."},
{"key": "data.voice.turkish.kicked.0", "text": "ジッディ・ミスィン？わかった。", "src": "Ciddi misin? Okay."},
{"key": "data.voice.turkish.kicked.1", "text": "アビ、本当に？まあいい。", "src": "Abi, really? Fine."},
{"key": "data.voice.turkish.kicked.2", "text": "ヨク、ヨク。帰るよ。", "src": "Yok, yok. I'm going."},
{"key": "data.voice.turkish.leaving.0", "text": "ヨク、もう待たない。", "src": "Yok, I'm not waiting anymore."},
{"key": "data.voice.turkish.leaving.1", "text": "アビ、ここ誰も働いてないの？", "src": "Abi, is nobody working here?"},
{"key": "data.voice.turkish.leaving.2", "text": "タマム、ホシュチャ・カル。", "src": "Tamam, hoşça kal."},
{"key": "data.voice.turkish.order.0", "text": "アビ、{drink}を。", "src": "Abi, a {drink}."},
{"key": "data.voice.turkish.order.1", "text": "{drink}をひとつ、エイヴァッラー。", "src": "One {drink}, eyvallah."},
{"key": "data.voice.turkish.order.2", "text": "ジャヌム、手が空いたら{drink}を。", "src": "{drink}, canım, when you can."},
{"key": "data.voice.turkish.order.3", "text": "ビル・{drink}、お願い。", "src": "Bir {drink}, please."},
{"key": "data.voice.turkish.perfect.0", "text": "エイヴァッラー！", "src": "Eyvallah!"},
{"key": "data.voice.turkish.perfect.1", "text": "ハリカ！", "src": "Harika!"},
{"key": "data.voice.turkish.perfect.2", "text": "スーペル、アビ！", "src": "Süper, abi!"},
{"key": "data.voice.turkish.praise.0", "text": "エイヴァッラー。こうやって作るんだよ。", "src": "Eyvallah. This is how it's done."},
{"key": "data.voice.turkish.praise.1", "text": "アビ、脱帽だ。ハリカ。", "src": "Abi, my hat is off. Harika."},
{"key": "data.voice.turkish.praise.2", "text": "タマム、いい仕事するね。", "src": "Tamam, you know your work."},
{"key": "data.voice.turkish.sip.0", "text": "アビ、{advice_l}", "src": "Abi, {advice_l}"},
{"key": "data.voice.turkish.sip.1", "text": "バク、{advice_l}", "src": "Bak, {advice_l}"},
{"key": "data.voice.turkish.sip.2", "text": "タマム、でも{advice_l}", "src": "Tamam ama, {advice_l}"},
{"key": "data.voice.turkish.wrong.0", "text": "ヨク、これじゃない。", "src": "Yok, not this."},
{"key": "data.voice.turkish.wrong.1", "text": "アビ、違うやつだよ。", "src": "Abi, wrong one."},
{"key": "data.voice.turkish.wrong.2", "text": "ブ・ネ・シムディ？", "src": "Bu ne şimdi?"}
]}
