{"strings": [
{"key": "data.voice.african.another.0", "text": "もう一杯持ってきて！", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "アベグ、もう一杯！", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "マイフレンド、おかわり！", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "まあ、いいよ。", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "ノー・ワハラ。問題なし。", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "オーケー、ありがとう。", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "アーア！本気で？", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "ノー・ワハラ。帰るよ。", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "マイフレンド、これはひどいな。", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "アーア。もう十分待ったよ。", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "ノー・ワハラ。もう行くね。", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "じゃあ行くよ、マイフレンド。", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "{drink}をお願い。", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "マイフレンド、{drink}をひとつ。", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "{drink}にしようかな。", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "アベグ、{drink}を。", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "ああ、うまい！", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "コレクト！", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "これはいいね！", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "ああ、これはコレクトだ。ありがとう。", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "ワハラなんて全然なし。すごくいい。", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "マイフレンド、よくわかってるね。", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "マイフレンド、{advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "アベグ、{advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "悪くないけど、{advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "アーア、違うよ。", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "これじゃないな。", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "マイフレンド、これは違う。", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "同じのもう一杯、メイト！", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "もう一杯、チアーズ！", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "よし、おかわり！", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "悪くない。", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "どうも、これで十分。", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "オーライ、チアーズ。", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "チャーミングだこと。実にね。", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "そうかい。何もしてもらってないけど、チアーズ。", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "冗談きついね。", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "よし。もう十分待った。", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "もういい。帰る。", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "イマイチだな、ここ。バイ。", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "メイト、手が空いたら{drink}を。", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}をお願い。チアーズ。", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "じゃあ、{drink}にしよう。", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "{drink}をもらうよ、どうも。", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "ラブリー！", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "チアーズ、メイト！", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "ちゃんとうまい！", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "ブライミー。本当にラブリーだ。", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "チアーズ。ちゃんとした仕事だ。", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "こりゃ最高にいいね。", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "メイト、{advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "ひとつだけ。{advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "あのさ、{advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "ちょっと違うな、これ。", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "えーと、これ頼んでない。", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "頼んだのと違う。", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "ヤール、もう一杯！", "src": "One more, yaar!"},
{"key": "data.voice.desi.another.1", "text": "アウル・エーク！", "src": "Aur ek!"},
{"key": "data.voice.desi.another.2", "text": "おかわり、お願い！", "src": "Again, please!"},
{"key": "data.voice.desi.close.0", "text": "ティーク・ハイ。", "src": "Theek hai."},
{"key": "data.voice.desi.close.1", "text": "まあ、いいんじゃない？", "src": "It is okay, na."},
{"key": "data.voice.desi.close.2", "text": "チャレーガ。これでいい。", "src": "Chalega."},
{"key": "data.voice.desi.kicked.0", "text": "なに？本気で言ってる？", "src": "Kya? Seriously?"},
{"key": "data.voice.desi.kicked.1", "text": "アレー。わかった、いいよ。", "src": "Arre. Okay, fine."},
{"key": "data.voice.desi.kicked.2", "text": "チャロー。帰るよ。", "src": "Chalo. I go."},
{"key": "data.voice.desi.leaving.0", "text": "アレー、ヤール。長すぎる。", "src": "Arre yaar. Too long."},
{"key": "data.voice.desi.leaving.1", "text": "チャロー、もう行く。", "src": "Chalo, I am going."},
{"key": "data.voice.desi.leaving.2", "text": "バス。もう十分。", "src": "Bas. Enough."},
{"key": "data.voice.desi.order.0", "text": "{drink}をひとつ、お願い。", "src": "One {drink}, please."},
{"key": "data.voice.desi.order.1", "text": "ヤール、{drink}を。", "src": "A {drink}, yaar."},
{"key": "data.voice.desi.order.2", "text": "{drink}をもらおうかな。", "src": "I will take a {drink}."},
{"key": "data.voice.desi.order.3", "text": "{drink}、いいよね？", "src": "{drink}, na?"},
{"key": "data.voice.desi.perfect.0", "text": "ワー、完璧！", "src": "Wah, perfect!"},
{"key": "data.voice.desi.perfect.1", "text": "エクダム、ファーストクラス！", "src": "Ekdum first class!"},
{"key": "data.voice.desi.perfect.2", "text": "バフット・バディヤー！", "src": "Bahut badhiya!"},
{"key": "data.voice.desi.praise.0", "text": "ワー。エクダム完璧だよ、ヤール。", "src": "Wah. Ekdum perfect, yaar."},
{"key": "data.voice.desi.praise.1", "text": "バフット・バディヤー。本当に。", "src": "Bahut badhiya. Really."},
{"key": "data.voice.desi.praise.2", "text": "ファーストクラス。また来るよ。", "src": "First class. I am coming back."},
{"key": "data.voice.desi.sip.0", "text": "アレー、{advice_l}", "src": "Arre, {advice_l}"},
{"key": "data.voice.desi.sip.1", "text": "ヤール、{advice_l}", "src": "Yaar, {advice_l}"},
{"key": "data.voice.desi.sip.2", "text": "ティーク・ハイ、でも{advice_l}", "src": "Theek hai, but {advice_l}"},
{"key": "data.voice.desi.wrong.0", "text": "アレー、違う。", "src": "Arre, no."},
{"key": "data.voice.desi.wrong.1", "text": "これ、私のじゃない。", "src": "This is not mine."},
{"key": "data.voice.desi.wrong.2", "text": "ナヒーン、別のだよ。", "src": "Nahi, wrong one."},
{"key": "data.voice.german.another.0", "text": "ノッホ・アインス！", "src": "Noch eins!"},
{"key": "data.voice.german.another.1", "text": "もう一杯、ビッテ！", "src": "Another, bitte!"},
{"key": "data.voice.german.another.2", "text": "おかわりをお願い！", "src": "Again, please!"},
{"key": "data.voice.german.close.0", "text": "ヤー、オーケー。", "src": "Ja, okay."},
{"key": "data.voice.german.close.1", "text": "許容範囲だ。", "src": "Acceptable."},
{"key": "data.voice.german.close.2", "text": "問題ない。", "src": "It is fine."},
{"key": "data.voice.german.kicked.0", "text": "これは不条理だ。", "src": "This is absurd."},
{"key": "data.voice.german.kicked.1", "text": "結構。二度と来ない。", "src": "Fine. I will not return."},
{"key": "data.voice.german.kicked.2", "text": "ヤー、ヤー。帰るよ。", "src": "Ja, ja. I am going."},
{"key": "data.voice.german.leaving.0", "text": "これは受け入れられない。帰る。", "src": "This is not acceptable. I am leaving."},
{"key": "data.voice.german.leaving.1", "text": "ナイン。もう十分待った。", "src": "Nein. I have waited enough."},
{"key": "data.voice.german.leaving.2", "text": "ウングラウプリヒ。さようなら。", "src": "Unglaublich. Goodbye."},
{"key": "data.voice.german.order.0", "text": "{drink}を。正確に作ってほしい。", "src": "A {drink}, please. Correctly made."},
{"key": "data.voice.german.order.1", "text": "{drink}。ありがとう。", "src": "{drink}. Thank you."},
{"key": "data.voice.german.order.2", "text": "{drink}をひとつ、ビッテ。", "src": "One {drink}, bitte."},
{"key": "data.voice.german.order.3", "text": "{drink}をいただきたい。", "src": "I would like a {drink}."},
{"key": "data.voice.german.perfect.0", "text": "ゲナウ！", "src": "Genau!"},
{"key": "data.voice.german.perfect.1", "text": "ゼア・グート！", "src": "Sehr gut!"},
{"key": "data.voice.german.perfect.2", "text": "ヴンダバー！", "src": "Wunderbar!"},
{"key": "data.voice.german.praise.0", "text": "ヤー。まさにこれが正解だ。", "src": "Ja. This is exactly right."},
{"key": "data.voice.german.praise.1", "text": "正確だ。正確さには敬意を払う。", "src": "Precise. I respect precision."},
{"key": "data.voice.german.praise.2", "text": "ゼア・グート。指摘なし。", "src": "Sehr gut. No notes."},
{"key": "data.voice.german.sip.0", "text": "ゲナウ、ただ{advice_l}", "src": "Genau, but {advice_l}"},
{"key": "data.voice.german.sip.1", "text": "ひとつ指摘を。{advice_l}", "src": "One remark: {advice_l}"},
{"key": "data.voice.german.sip.2", "text": "ヤー、{advice_l}", "src": "Ja, {advice_l}"},
{"key": "data.voice.german.wrong.0", "text": "ナイン。これじゃない。", "src": "Nein. Not this."},
{"key": "data.voice.german.wrong.1", "text": "これは間違いだ。", "src": "This is incorrect."},
{"key": "data.voice.german.wrong.2", "text": "ドリンクが違う。", "src": "Wrong drink."},
{"key": "data.voice.korean.another.0", "text": "ハンジャン・ド！", "src": "Han jan deo!"},
{"key": "data.voice.korean.another.1", "text": "もう一杯！", "src": "One more!"},
{"key": "data.voice.korean.another.2", "text": "おかわり、ジュセヨ！", "src": "Again, juseyo!"},
{"key": "data.voice.korean.close.0", "text": "ケンチャナ。", "src": "Gwenchana."},
{"key": "data.voice.korean.close.1", "text": "大丈夫ですよ。", "src": "It is okay."},
{"key": "data.voice.korean.close.2", "text": "ナップジ・アナ。悪くない。", "src": "Nappeuji anha."},
{"key": "data.voice.korean.kicked.0", "text": "チンチャ？うわ。", "src": "Jinjja? Wow."},
{"key": "data.voice.korean.kicked.1", "text": "アイシ。わかりました。", "src": "Aish. Fine."},
{"key": "data.voice.korean.kicked.2", "text": "じゃあ、アンニョン。", "src": "Annyeong, then."},
{"key": "data.voice.korean.leaving.0", "text": "アイシ。長すぎ。", "src": "Aish. Too long."},
{"key": "data.voice.korean.leaving.1", "text": "もう行きます。アンニョン。", "src": "I am going. Annyeong."},
{"key": "data.voice.korean.leaving.2", "text": "モッ・チャムゲッソ。もう無理。", "src": "Mot chamgesseo."},
{"key": "data.voice.korean.order.0", "text": "{drink}、ジュセヨ。", "src": "{drink}, juseyo."},
{"key": "data.voice.korean.order.1", "text": "{drink}をひとつ、お願いします。", "src": "One {drink}, please."},
{"key": "data.voice.korean.order.2", "text": "私には{drink}を。", "src": "A {drink} for me."},
{"key": "data.voice.korean.order.3", "text": "{drink}が飲みたいです。", "src": "I want a {drink}."},
{"key": "data.voice.korean.perfect.0", "text": "テバク！", "src": "Daebak!"},
{"key": "data.voice.korean.perfect.1", "text": "チンチャ、いい！", "src": "Jinjja good!"},
{"key": "data.voice.korean.perfect.2", "text": "チェゴ！", "src": "Choego!"},
{"key": "data.voice.korean.praise.0", "text": "テバク。チンチャ、完璧です。", "src": "Daebak. Jinjja, this is perfect."},
{"key": "data.voice.korean.praise.1", "text": "チェゴ。本気で言ってます。", "src": "Choego. I mean it."},
{"key": "data.voice.korean.praise.2", "text": "わあ。上手ですね。", "src": "Wow. You are good at this."},
{"key": "data.voice.korean.sip.0", "text": "チャムカンマン、{advice_l}", "src": "Jamkkanman, {advice_l}"},
{"key": "data.voice.korean.sip.1", "text": "えっと、{advice_l}", "src": "Um, {advice_l}"},
{"key": "data.voice.korean.sip.2", "text": "ケンチャナ、でも{advice_l}", "src": "Gwenchana, but {advice_l}"},
{"key": "data.voice.korean.wrong.0", "text": "アニョ、違います。", "src": "Aniyo, no."},
{"key": "data.voice.korean.wrong.1", "text": "これ、違いますよ。", "src": "This is wrong."},
{"key": "data.voice.korean.wrong.2", "text": "え？私のじゃないです。", "src": "Eh? Not mine."},
{"key": "data.voice.nordic.another.0", "text": "もう一杯。スコール！", "src": "Another. Skål!"},
{"key": "data.voice.nordic.another.1", "text": "もう一杯。", "src": "One more."},
{"key": "data.voice.nordic.another.2", "text": "おかわりを、お願い。", "src": "Again, please."},
{"key": "data.voice.nordic.close.0", "text": "いいよ。", "src": "Fine."},
{"key": "data.voice.nordic.close.1", "text": "大丈夫。", "src": "It's okay."},
{"key": "data.voice.nordic.close.2", "text": "これで十分。", "src": "Good enough."},
{"key": "data.voice.nordic.kicked.0", "text": "そう。変だけど、わかった。", "src": "Okay. Strange, but okay."},
{"key": "data.voice.nordic.kicked.1", "text": "了解。", "src": "Fine."},
{"key": "data.voice.nordic.kicked.2", "text": "ふむ。じゃあ、さよなら。", "src": "Hm. Goodbye then."},
{"key": "data.voice.nordic.leaving.0", "text": "行くよ。気にしないで。", "src": "I'll go. It's fine."},
{"key": "data.voice.nordic.leaving.1", "text": "長すぎる。さよなら。", "src": "Too long. Goodbye."},
{"key": "data.voice.nordic.leaving.2", "text": "いや。帰る。", "src": "No. I'm leaving."},
{"key": "data.voice.nordic.order.0", "text": "{drink}を。どうも。", "src": "A {drink}. Thanks."},
{"key": "data.voice.nordic.order.1", "text": "{drink}をお願い。", "src": "{drink}, please."},
{"key": "data.voice.nordic.order.2", "text": "{drink}をひとつ。急がなくていい。", "src": "One {drink}. No rush."},
{"key": "data.voice.nordic.order.3", "text": "{drink}にする。", "src": "I'll have the {drink}."},
{"key": "data.voice.nordic.perfect.0", "text": "スコール！", "src": "Skål!"},
{"key": "data.voice.nordic.perfect.1", "text": "とてもいい。", "src": "Very good."},
{"key": "data.voice.nordic.perfect.2", "text": "うん。いい。", "src": "Yes. Good."},
{"key": "data.voice.nordic.praise.0", "text": "とてもいい。普段こんなこと言わない。", "src": "This is very good. I don't say that."},
{"key": "data.voice.nordic.praise.1", "text": "スコール。ちゃんとしてる。", "src": "Skål. Properly done."},
{"key": "data.voice.nordic.praise.2", "text": "いい。本当にいい。", "src": "Good. Really good."},
{"key": "data.voice.nordic.sip.0", "text": "まあ。{advice}", "src": "Well. {advice}"},
{"key": "data.voice.nordic.sip.1", "text": "ふむ。{advice}", "src": "Hm. {advice}"},
{"key": "data.voice.nordic.sip.2", "text": "いいけど、{advice_l}", "src": "Fine, but {advice_l}"},
{"key": "data.voice.nordic.wrong.0", "text": "違う。別のだ。", "src": "No. Wrong one."},
{"key": "data.voice.nordic.wrong.1", "text": "これじゃない。", "src": "This is not it."},
{"key": "data.voice.nordic.wrong.2", "text": "ふむ。私のじゃない。", "src": "Hm. Not mine."},
{"key": "data.voice.southern.another.0", "text": "もう一杯注いでおくれ！", "src": "Pour me another!"},
{"key": "data.voice.southern.another.1", "text": "もう一杯、シュガー！", "src": "One more, sugar!"},
{"key": "data.voice.southern.another.2", "text": "どんどん頼むよ！", "src": "Keep 'em comin'!"},
{"key": "data.voice.southern.close.0", "text": "まあ、いいさ。", "src": "That's alright."},
{"key": "data.voice.southern.close.1", "text": "文句はないよ。", "src": "Fair enough."},
{"key": "data.voice.southern.close.2", "text": "ま、これでいいか。", "src": "Well, it'll do."},
{"key": "data.voice.southern.kicked.0", "text": "おやまあ、失礼な話だね。", "src": "Well, that's just rude."},
{"key": "data.voice.southern.kicked.1", "text": "わかったよ。よい夜を。", "src": "Alright then. Have a good one."},
{"key": "data.voice.southern.kicked.2", "text": "ちょっと待ちなって…まあいいさ。", "src": "Now hold on… fine."},
{"key": "data.voice.southern.leaving.0", "text": "こっちも一晩中ヒマじゃないんでね。", "src": "Well, I ain't got all night."},
{"key": "data.voice.southern.leaving.1", "text": "よそで飲むとするか。", "src": "Reckon I'll drink elsewhere."},
{"key": "data.voice.southern.leaving.2", "text": "ずいぶんのんびりしてるんだね、あんたたち。", "src": "Y'all take your sweet time, don't you."},
{"key": "data.voice.southern.order.0", "text": "さてと、{drink}なんかいいねえ。", "src": "Well now, a {drink} would suit me."},
{"key": "data.voice.southern.order.1", "text": "ダーリン、{drink}をお願いできるかい。", "src": "{drink}, darlin', if you please."},
{"key": "data.voice.southern.order.2", "text": "{drink}にしようかね。", "src": "Reckon I'll have a {drink}."},
{"key": "data.voice.southern.order.3", "text": "{drink}をひとつ、シュガー。", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "こりゃいいね！", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "ロード、こりゃうまい！", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "ホット・ダン！", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "たまげた。ちゃんとした一杯だよ。", "src": "Well, I'll be. That's a proper drink."},
{"key": "data.voice.southern.praise.1", "text": "ダーリン、あんた才能あるよ。", "src": "Darlin', you got a gift."},
{"key": "data.voice.southern.praise.2", "text": "新しい行きつけを見つけたみたいだ。", "src": "Reckon I found my new spot."},
{"key": "data.voice.southern.sip.0", "text": "さて、{advice_l}", "src": "Now, {advice_l}"},
{"key": "data.voice.southern.sip.1", "text": "シュガー、{advice_l}", "src": "Sugar, {advice_l}"},
{"key": "data.voice.southern.sip.2", "text": "いいかい、{advice_l}", "src": "Tell you what, {advice_l}"},
{"key": "data.voice.southern.wrong.0", "text": "これは違うよ、ハニー。", "src": "Ain't mine, hon."},
{"key": "data.voice.southern.wrong.1", "text": "おや、こりゃなんだい？", "src": "Now what is this?"},
{"key": "data.voice.southern.wrong.2", "text": "まあ、ブレス・ユア・ハート。", "src": "Bless your heart."}
]}
