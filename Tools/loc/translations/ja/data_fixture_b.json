{
  "strings": [
    {"key": "data.fixture.post5_car.blurb", "text": "夕日に向けて停めた、幌を下ろしたティールのオープンカー。オーナーいわく、もう少しで買うところだった車。"},
    {"key": "data.fixture.post5_car.name", "text": "オープンカーのポスター"},
    {"key": "data.fixture.post5_diver.blurb", "text": "ターコイズのプールの上、宙を舞うダイバー。バーじゅうが一緒に息をのむ。"},
    {"key": "data.fixture.post5_diver.name", "text": "ダイバーのポスター"},
    {"key": "data.fixture.post5_neon.blurb", "text": "雨の中、ピンクと青の看板が並ぶ通り。部屋が街の一部に感じられる。"},
    {"key": "data.fixture.post5_neon.name", "text": "ネオン街のポスター"},
    {"key": "data.fixture.post_coast_R.blurb", "text": "上から見た海沿いの道、ヤシと海と細い白い車。誰もがいつか行くつもりのドライブ。"},
    {"key": "data.fixture.post_coast_R.name", "text": "海岸のポスター"},
    {"key": "data.fixture.post_malibu_R.blurb", "text": "燃えるような空の下のライフガード小屋。角が一か所めくれたポスター。"},
    {"key": "data.fixture.post_malibu_R.name", "text": "Malibu ポスター"},
    {"key": "data.fixture.post_pier_R.blurb", "text": "夕暮れの桟橋、灯りがともりはじめる。観光客なら誰もが送る一枚の絵はがき。"},
    {"key": "data.fixture.post_pier_R.name", "text": "桟橋のポスター"},
    {"key": "data.fixture.post_surf_R.blurb", "text": "ティールの波に乗るサーファー、粒子が見えるほど大きく刷られている。ここでサーフィンをした者はいない。"},
    {"key": "data.fixture.post_surf_R.name", "text": "サーフのポスター"},
    {"key": "data.fixture.prep_mat.blurb", "text": "皿の下のコルク。一度も洗われたことがない。"},
    {"key": "data.fixture.prep_mat.name", "text": "おつまみマット"},
    {"key": "data.fixture.rug6_memphis.blurb", "text": "80年代に売られていたあらゆる色の、くねくね線、水玉、三角。壁と言い争って、勝つ。"},
    {"key": "data.fixture.rug6_memphis.name", "text": "メンフィスのラグ"},
    {"key": "data.fixture.rug6_palm.blurb", "text": "クリーム地に大きな緑の葉。床全体が誰かのベランダみたいになる。"},
    {"key": "data.fixture.rug6_palm.name", "text": "ヤシの葉のラグ"},
    {"key": "data.fixture.rug6_sunset.blurb", "text": "金からマゼンタ、そして夜へのストライプ。床に広げた夕暮れ。"},
    {"key": "data.fixture.rug6_sunset.name", "text": "夕焼けのストライプ"},
    {"key": "data.fixture.rug_leopard.blurb", "text": "壁から壁まで斑点、はみ出さないようにティールの縁取り。派手で、それが自慢。"},
    {"key": "data.fixture.rug_leopard.name", "text": "ヒョウ柄のラグ"},
    {"key": "data.fixture.rug_wave.blurb", "text": "床板いっぱいに織られた砕ける波。テーブルが波打ち際に立っているように見える。"},
    {"key": "data.fixture.rug_wave.name", "text": "波のラグ"},
    {"key": "data.fixture.rwall6_stripe.blurb", "text": "ドアまで続くピンクとクリームの帯。横の壁が、ようやく海辺のバーらしくなった。"},
    {"key": "data.fixture.rwall6_stripe.name", "text": "フラミンゴのストライプ"},
    {"key": "data.fixture.rwall6_sunray.blurb", "text": "隅から広がるコーラルとマゼンタの光線、差し込む夕日。あのドアから出る人は、みんな見ていく。"},
    {"key": "data.fixture.rwall6_sunray.name", "text": "サンレイの壁"},
    {"key": "data.fixture.rwall6_tile.blurb", "text": "クリーム地にティールのダイヤ、遠ざかる壁に合わせてまっすぐ並ぶ。寄りかかれるプール。"},
    {"key": "data.fixture.rwall6_tile.name", "text": "ターコイズのダイヤ"},
    {"key": "data.fixture.shaker_gold.blurb", "text": "磨き上げた金。中のドリンクはまったく同じ。でも、誰も中身なんて見ていない。"},
    {"key": "data.fixture.shaker_gold.name", "text": "金のシェイカー"},
    {"key": "data.fixture.shaker_steel.blurb", "text": "店についてきたシェイカー。底はへこみ、手に冷たく、一杯もしくじったことがない。"},
    {"key": "data.fixture.shaker_steel.name", "text": "スチールのシェイカー"},
    {"key": "data.fixture.sink_brass.blurb", "text": "ネオンを映してとどめるシンク — しかも排水代は誰にも請求されない。"},
    {"key": "data.fixture.sink_brass.name", "text": "真鍮のシンク"},
    {"key": "data.fixture.table5_bistro_L.blurb", "text": "賃貸についてきた四角い天板と、曲げ木の椅子2脚。長居する人はいない。"},
    {"key": "data.fixture.table5_bistro_L.name", "text": "ビストロテーブル"},
    {"key": "data.fixture.table5_bistro_R.blurb", "text": "賃貸についてきた四角い天板と、曲げ木の椅子2脚。長居する人はいない。"},
    {"key": "data.fixture.table5_bistro_R.name", "text": "ビストロテーブル"},
    {"key": "data.fixture.table_left_3.blurb", "text": "磨いた支柱にプラム色のビニール。放っておくと回る。"},
    {"key": "data.fixture.table_left_3.name", "text": "スチール昇降スツールセット"},
    {"key": "data.fixture.table_right_3.blurb", "text": "磨いた支柱にプラム色のビニール。放っておくと回る。"},
    {"key": "data.fixture.table_right_3.name", "text": "スチール昇降スツールセット"},
    {"key": "data.fixture.table_v1_L.blurb", "text": "真鍮の脚に背の高い丸天板、赤いスツール2脚、グラスが待っている。つい長居したくなる席。"},
    {"key": "data.fixture.table_v1_L.name", "text": "カクテル用ハイテーブル"},
    {"key": "data.fixture.table_v1_R.blurb", "text": "真鍮の脚に背の高い丸天板、赤いスツール2脚、グラスが待っている。つい長居したくなる席。"},
    {"key": "data.fixture.table_v1_R.name", "text": "カクテル用ハイテーブル"},
    {"key": "data.fixture.table_v2_L.blurb", "text": "クロームの台座にティールの天板、おそろいのスツール、ボトルもすでに置いてある。指名される席。"},
    {"key": "data.fixture.table_v2_L.name", "text": "ティールの台座セット"},
    {"key": "data.fixture.table_v2_R.blurb", "text": "クロームの台座にティールの天板、おそろいのスツール、ボトルもすでに置いてある。指名される席。"},
    {"key": "data.fixture.table_v2_R.name", "text": "ティールの台座セット"},
    {"key": "data.fixture.taps_one.blurb", "text": "1口、ラガー1種。まずはここから。"},
    {"key": "data.fixture.taps_one.name", "text": "シングルタワー"},
    {"key": "data.fixture.taps_three.blurb", "text": "1本の柱に3つの注ぎ口。順番待ちはもうない。"},
    {"key": "data.fixture.taps_three.name", "text": "トリプルタワー"},
    {"key": "data.fixture.taps_two.blurb", "text": "2本脚の真鍮のブリッジに、ハンドルが横一列。"},
    {"key": "data.fixture.taps_two.name", "text": "アーチ型ブリッジ"},
    {"key": "data.fixture.wall_lamps_one.blurb", "text": "先端はシアン、管はピンク、スチールのブラケットが支える。店でいちばん安いのに、今が何年かわかっている品。"},
    {"key": "data.fixture.wall_lamps_one.name", "text": "ガラス管ランプ"},
    {"key": "data.fixture.wall_lamps_three.blurb", "text": "光るココナッツのついた真鍮のヤシ。誰にも必要ない。誰もが欲しがる。"},
    {"key": "data.fixture.wall_lamps_three.name", "text": "ヤシのランプ"},
    {"key": "data.fixture.wall_lamps_two.blurb", "text": "コーラルの枠にクリーム色の面、窓ほどの幅。壁を点で照らさず、面で洗う。"},
    {"key": "data.fixture.wall_lamps_two.name", "text": "サンセットパネル"},
    {"key": "data.fixture.wall_tv.blurb", "text": "ボックス席の上にボルトで留めた箱型のテレビ。誰も観ていない広告を、誰もが眺めている。"},
    {"key": "data.fixture.wall_tv.name", "text": "壁掛けテレビ"},
    {"key": "data.fixture.walls_1.blurb", "text": "前の借り主が残した壁。まあ持ちこたえているし、ひびも広がらなくなった。"},
    {"key": "data.fixture.walls_1.name", "text": "ひび割れたしっくい"},
    {"key": "data.fixture.walls_2.blurb", "text": "平らにならして、クリーム色に塗った。ひびはその下。誰も知らなくていい。"},
    {"key": "data.fixture.walls_2.name", "text": "塗りたてのしっくい"},
    {"key": "data.fixture.walls_3.blurb", "text": "壁一面にコーラルの腰板、天井際にはストライプ。部屋が謝るのをやめる。"},
    {"key": "data.fixture.walls_3.name", "text": "腰板の壁"},
    {"key": "data.fixture.walls_4.blurb", "text": "腰板の上にピンクとライラックのダイヤ柄。絵はがきに写っているのはこの壁。"},
    {"key": "data.fixture.walls_4.name", "text": "ハーレクイン柄の壁紙"},
    {"key": "data.fixture.walls_right_1.blurb", "text": "前の借り主の紫、湿気が入ったところからはがれている。3か所で板が見えているが、誰も何も聞いてこない。"},
    {"key": "data.fixture.walls_right_1.name", "text": "はがれた紫"},
    {"key": "data.fixture.walls_right_2.blurb", "text": "隅からドアまで、プラム色をひと塗り。つぎはぎは隠れる。それ以外は何も。"},
    {"key": "data.fixture.walls_right_2.name", "text": "プラムのひと塗り"},
    {"key": "data.fixture.walls_right_3.blurb", "text": "紫の上に暗い丸、隅へ向かってストライプ。ドアがわざとそこにあるように見える。"},
    {"key": "data.fixture.walls_right_3.name", "text": "バブル柄の壁紙"},
    {"key": "data.fixture.walls_right_4.blurb", "text": "コーラルの腰板の上にクリーム色、天井際にストライプ。横の壁が、ようやく絵はがきと同じになった。"},
    {"key": "data.fixture.walls_right_4.name", "text": "サンセットの腰板"}
  ]
}
