{"strings": [
{"key": "data.voice.arabic.another.0", "text": "カマン・ワーヘド！", "src": "Kaman wahad!"},
{"key": "data.voice.arabic.another.1", "text": "もう一杯、ヤッラ！", "src": "One more, yalla!"},
{"key": "data.voice.arabic.another.2", "text": "おかわり、ハビービ！", "src": "Again, habibi!"},
{"key": "data.voice.arabic.close.0", "text": "マーシー。", "src": "Maashi."},
{"key": "data.voice.arabic.close.1", "text": "まあ、大丈夫。", "src": "It is okay."},
{"key": "data.voice.arabic.close.2", "text": "タマーム、シュクラン。", "src": "Tamam, shukran."},
{"key": "data.voice.arabic.kicked.0", "text": "シュー？本気で？", "src": "Shu? Seriously?"},
{"key": "data.voice.arabic.kicked.1", "text": "ハラース。わかったよ。", "src": "Khalas. Fine."},
{"key": "data.voice.arabic.kicked.2", "text": "ヤッラ。帰るよ。", "src": "Yalla. I go."},
{"key": "data.voice.arabic.leaving.0", "text": "ハラース。もう行く。", "src": "Khalas. I am going."},
{"key": "data.voice.arabic.leaving.1", "text": "ヤッラ、待つのはもう終わり。", "src": "Yalla, enough waiting."},
{"key": "data.voice.arabic.leaving.2", "text": "マア・サラーマ。", "src": "Maa salama."},
{"key": "data.voice.arabic.order.0", "text": "{drink}をお願い。", "src": "A {drink}, please."},
{"key": "data.voice.arabic.order.1", "text": "{drink}をひとつ、シュクラン。", "src": "One {drink}, shukran."},
{"key": "data.voice.arabic.order.2", "text": "ハビービ、{drink}を。", "src": "Habibi, a {drink}."},
{"key": "data.voice.arabic.order.3", "text": "{drink}をもらうよ。", "src": "I will take a {drink}."},
{"key": "data.voice.arabic.perfect.0", "text": "ヤー・サラーム！", "src": "Ya salam!"},
{"key": "data.voice.arabic.perfect.1", "text": "ヘルー・キティール！", "src": "Helu kteer!"},
{"key": "data.voice.arabic.perfect.2", "text": "完璧だよ、ハビービ！", "src": "Perfect, habibi!"},
{"key": "data.voice.arabic.praise.0", "text": "ヤー・サラーム。これだよ、ハビービ。", "src": "Ya salam. This is the one, habibi."},
{"key": "data.voice.arabic.praise.1", "text": "ヘルー・キティール。シュクラン。", "src": "Helu kteer. Shukran."},
{"key": "data.voice.arabic.praise.2", "text": "ヤッラ、いい仕事するね。", "src": "Yalla, you know your work."},
{"key": "data.voice.arabic.sip.0", "text": "ハビービ、{advice_l}", "src": "Habibi, {advice_l}"},
{"key": "data.voice.arabic.sip.1", "text": "シューフ、{advice_l}", "src": "Shuf, {advice_l}"},
{"key": "data.voice.arabic.sip.2", "text": "タマーム、でも{advice_l}", "src": "Tamam, bas {advice_l}"},
{"key": "data.voice.arabic.wrong.0", "text": "ラー、ラー。", "src": "La, la."},
{"key": "data.voice.arabic.wrong.1", "text": "これじゃないよ。", "src": "This is not it."},
{"key": "data.voice.arabic.wrong.2", "text": "シュー・ハーダ？", "src": "Shu hada?"},
{"key": "data.voice.chinese.another.0", "text": "ザイライ・イーベイ！", "src": "Zai lai yi bei!"},
{"key": "data.voice.chinese.another.1", "text": "もう一杯、ね！", "src": "One more, ah!"},
{"key": "data.voice.chinese.another.2", "text": "おかわり、お願い！", "src": "Again, please!"},
{"key": "data.voice.chinese.close.0", "text": "ハイ・クーイー。まあまあ。", "src": "Hai keyi."},
{"key": "data.voice.chinese.close.1", "text": "まあ、いいよ。", "src": "Okay lah."},
{"key": "data.voice.chinese.close.2", "text": "大丈夫。", "src": "It is fine."},
{"key": "data.voice.chinese.kicked.0", "text": "シェンマ？本当に？", "src": "Shenme? Really?"},
{"key": "data.voice.chinese.kicked.1", "text": "アイヤー。わかった。", "src": "Aiya. Fine."},
{"key": "data.voice.chinese.kicked.2", "text": "ハオ。帰るよ。", "src": "Hao. I leave."},
{"key": "data.voice.chinese.leaving.0", "text": "アイヤー。待ちすぎた。", "src": "Aiya. I waited too long."},
{"key": "data.voice.chinese.leaving.1", "text": "スワンラ。もう行く。", "src": "Suan le. I go."},
{"key": "data.voice.chinese.leaving.2", "text": "じゃあ、ザイジェン。", "src": "Zaijian, then."},
{"key": "data.voice.chinese.order.0", "text": "{drink}をお願い。", "src": "{drink}, please."},
{"key": "data.voice.chinese.order.1", "text": "{drink}をひとつ、シエシエ。", "src": "One {drink}, xiexie."},
{"key": "data.voice.chinese.order.2", "text": "{drink}にするよ。", "src": "I will have a {drink}."},
{"key": "data.voice.chinese.order.3", "text": "私に{drink}を。", "src": "A {drink} for me."},
{"key": "data.voice.chinese.perfect.0", "text": "ヘンハオ！", "src": "Hen hao!"},
{"key": "data.voice.chinese.perfect.1", "text": "完璧だね！", "src": "Perfect, ah!"},
{"key": "data.voice.chinese.perfect.2", "text": "ジェンバン！", "src": "Zhen bang!"},
{"key": "data.voice.chinese.praise.0", "text": "ジェンバン。これのためにまた来るよ。", "src": "Zhen bang. I will come back for this."},
{"key": "data.voice.chinese.praise.1", "text": "ヘンハオ。わかってるね。", "src": "Hen hao. You know what you are doing."},
{"key": "data.voice.chinese.praise.2", "text": "完璧だよ。本当に。", "src": "Perfect, ah. Really."},
{"key": "data.voice.chinese.sip.0", "text": "アイ、{advice_l}", "src": "Ai, {advice_l}"},
{"key": "data.voice.chinese.sip.1", "text": "聞いて、{advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.chinese.sip.2", "text": "ハオ、でも{advice_l}", "src": "Hao, but {advice_l}"},
{"key": "data.voice.chinese.wrong.0", "text": "ブードゥイ。", "src": "Bu dui."},
{"key": "data.voice.chinese.wrong.1", "text": "アイヤー、違う。", "src": "Aiya, no."},
{"key": "data.voice.chinese.wrong.2", "text": "これじゃない。", "src": "Not this one."},
{"key": "data.voice.filipino.another.0", "text": "イサ・パ！", "src": "Isa pa!"},
{"key": "data.voice.filipino.another.1", "text": "もう一杯、ね？", "src": "One more, ha!"},
{"key": "data.voice.filipino.another.2", "text": "おかわりお願い！", "src": "Again, please!"},
{"key": "data.voice.filipino.close.0", "text": "オーケー・ラン。", "src": "Okay lang."},
{"key": "data.voice.filipino.close.1", "text": "シゲ、ありがとう。", "src": "Sige, thanks."},
{"key": "data.voice.filipino.close.2", "text": "アイ、大丈夫。", "src": "Ay, it's fine."},
{"key": "data.voice.filipino.kicked.0", "text": "ハ？本当に？", "src": "Ha? Really?"},
{"key": "data.voice.filipino.kicked.1", "text": "アイ。わかった。バイ。", "src": "Ay. Okay. Bye."},
{"key": "data.voice.filipino.kicked.2", "text": "グラベ・ナマン。", "src": "Grabe naman."},
{"key": "data.voice.filipino.leaving.0", "text": "アイ、グラベ。長すぎ。もう行く。", "src": "Ay, grabe. Too long. I'm going."},
{"key": "data.voice.filipino.leaving.1", "text": "シゲ・ナ、バイ。", "src": "Sige na, bye."},
{"key": "data.voice.filipino.leaving.2", "text": "ナク、誰も来ないじゃない。", "src": "Naku, no one is coming."},
{"key": "data.voice.filipino.order.0", "text": "アイ、{drink}をひとつ、お願い。", "src": "Ay, one {drink}, please."},
{"key": "data.voice.filipino.order.1", "text": "{drink}をください。サラマット。", "src": "{drink} for me. Salamat."},
{"key": "data.voice.filipino.order.2", "text": "{drink}もらえる？ありがとね。", "src": "Can I have a {drink}? Thanks, ha."},
{"key": "data.voice.filipino.order.3", "text": "{drink}をお願い、クヤ。", "src": "A {drink}, kuya."},
{"key": "data.voice.filipino.perfect.0", "text": "アイ、サラップ！", "src": "Ay, sarap!"},
{"key": "data.voice.filipino.perfect.1", "text": "グラベ、最高！", "src": "Grabe, yes!"},
{"key": "data.voice.filipino.perfect.2", "text": "完璧、クヤ！", "src": "Perfect, kuya!"},
{"key": "data.voice.filipino.praise.0", "text": "グラベ。すごくおいしい。サラマット。", "src": "Grabe. That is so good. Salamat."},
{"key": "data.voice.filipino.praise.1", "text": "アイ、サラップ。今日のシフトの疲れが飛んだ。", "src": "Ay, sarap. You made my whole shift."},
{"key": "data.voice.filipino.praise.2", "text": "シゲ、これ飲みにまた来る。", "src": "Sige, I'm coming back for this."},
{"key": "data.voice.filipino.sip.0", "text": "アイ、{advice_l}", "src": "Ay, {advice_l}"},
{"key": "data.voice.filipino.sip.1", "text": "シゲ、でも{advice_l}", "src": "Sige, but {advice_l}"},
{"key": "data.voice.filipino.sip.2", "text": "ハ？{advice}", "src": "Ha? {advice}"},
{"key": "data.voice.filipino.wrong.0", "text": "アイ、ヒンディ。これじゃない。", "src": "Ay, hindi. Not this."},
{"key": "data.voice.filipino.wrong.1", "text": "グラベ、ドリンクが違う。", "src": "Grabe, wrong drink."},
{"key": "data.voice.filipino.wrong.2", "text": "私のじゃないよ、クヤ。", "src": "Not mine, kuya."},
{"key": "data.voice.italian.another.0", "text": "アンコーラ、ダイ！", "src": "Ancora, dai!"},
{"key": "data.voice.italian.another.1", "text": "もう一杯、グラッツィエ！", "src": "Another, grazie!"},
{"key": "data.voice.italian.another.2", "text": "もう一回、アモーレ！", "src": "Once more, amore!"},
{"key": "data.voice.italian.close.0", "text": "ヴァ・ベーネ。", "src": "Va bene."},
{"key": "data.voice.italian.close.1", "text": "オーケー、グラッツィエ。", "src": "Okay, grazie."},
{"key": "data.voice.italian.close.2", "text": "悪くないね、うん。", "src": "Not bad, eh."},
{"key": "data.voice.italian.kicked.0", "text": "マ・ダイ！本当に？", "src": "Ma dai! Really?"},
{"key": "data.voice.italian.kicked.1", "text": "ヴァ・ベーネ。チャオ、チャオ。", "src": "Va bene. Ciao, ciao."},
{"key": "data.voice.italian.kicked.2", "text": "ケ・マレドゥカート。失礼だね。", "src": "Che maleducato."},
{"key": "data.voice.italian.leaving.0", "text": "バスタ。帰る。", "src": "Basta. I go."},
{"key": "data.voice.italian.leaving.1", "text": "マンマ・ミーア、待たせすぎ！", "src": "Mamma mia, the waiting!"},
{"key": "data.voice.italian.leaving.2", "text": "チャオ。また来世でね。", "src": "Ciao. Maybe next life."},
{"key": "data.voice.italian.order.0", "text": "{drink}をひとつ、ペル・ファヴォーレ。", "src": "Un {drink}, per favore."},
{"key": "data.voice.italian.order.1", "text": "アモーレ、{drink}を。", "src": "A {drink}, amore."},
{"key": "data.voice.italian.order.2", "text": "{drink}を、グラッツィエ。", "src": "{drink}, grazie."},
{"key": "data.voice.italian.order.3", "text": "ダイ、{drink}をちょうだい。", "src": "Dai, a {drink}."},
{"key": "data.voice.italian.perfect.0", "text": "ペルフェット！", "src": "Perfetto!"},
{"key": "data.voice.italian.perfect.1", "text": "ブラーヴォ！", "src": "Bravo!"},
{"key": "data.voice.italian.perfect.2", "text": "ケ・ブオーノ！", "src": "Che buono!"},
{"key": "data.voice.italian.praise.0", "text": "ペルフェット。本当に。グラッツィエ・ミッレ。", "src": "Perfetto. Truly. Grazie mille."},
{"key": "data.voice.italian.praise.1", "text": "ブラーヴォ。うちのノンナが泣くよ。", "src": "Bravo. My nonna would cry."},
{"key": "data.voice.italian.praise.2", "text": "ケ・ブオーノ。もう帰らない。", "src": "Che buono. I'm not leaving."},
{"key": "data.voice.italian.sip.0", "text": "センティ、{advice_l}", "src": "Senti, {advice_l}"},
{"key": "data.voice.italian.sip.1", "text": "アッローラ、{advice_l}", "src": "Allora, {advice_l}"},
{"key": "data.voice.italian.sip.2", "text": "ヴァ・ベーネ、でも{advice_l}", "src": "Va bene, ma {advice_l}"},
{"key": "data.voice.italian.wrong.0", "text": "マンマ・ミーア、違う。", "src": "Mamma mia, no."},
{"key": "data.voice.italian.wrong.1", "text": "マ・ケ・コゼ？", "src": "Ma che cos'è?"},
{"key": "data.voice.italian.wrong.2", "text": "ノ、ノ。これじゃない。", "src": "No, no. Not this."},
{"key": "data.voice.miami.another.0", "text": "オトラ、ダレ！", "src": "¡Otra, dale!"},
{"key": "data.voice.miami.another.1", "text": "もう一杯、オイェ！", "src": "One more, oye!"},
{"key": "data.voice.miami.another.2", "text": "おかわり、ミ・アモール！", "src": "Again, mi amor!"},
{"key": "data.voice.miami.close.0", "text": "エスタ・ビエン。", "src": "Está bien."},
{"key": "data.voice.miami.close.1", "text": "悪くないよ、チコ。", "src": "Not bad, chico."},
{"key": "data.voice.miami.close.2", "text": "オーケー、オーケー。", "src": "Okay, okay."},
{"key": "data.voice.miami.kicked.0", "text": "エン・セリオ？まあいいけど。", "src": "¿En serio? Okay, fine."},
{"key": "data.voice.miami.kicked.1", "text": "冗談でしょ、チコ。", "src": "You're kidding me, chico."},
{"key": "data.voice.miami.kicked.2", "text": "ダレ。損するのはそっち。", "src": "Dale. Your loss."},
{"key": "data.voice.miami.leaving.0", "text": "オイェ！一晩中ここに座ってるんだけど。", "src": "¡Oye! I've been sitting here all night."},
{"key": "data.voice.miami.leaving.1", "text": "ブエノ、もうおしまい。チャオ。", "src": "Bueno, that's it. Ciao."},
{"key": "data.voice.miami.leaving.2", "text": "ノー、ノー。もう待たない。", "src": "No, no. I'm not waiting anymore."},
{"key": "data.voice.miami.order.0", "text": "オイェ、{drink}をちょうだい。", "src": "Oye, a {drink} for me."},
{"key": "data.voice.miami.order.1", "text": "ダレ、{drink}をひとつ。", "src": "Dale, one {drink}."},
{"key": "data.voice.miami.order.2", "text": "パピ、手が空いたら{drink}を。", "src": "{drink}, papi, when you can."},
{"key": "data.voice.miami.order.3", "text": "ミ・アモール、{drink}を。", "src": "Mi amor, a {drink}."},
{"key": "data.voice.miami.perfect.0", "text": "ケ・リコ！", "src": "¡Qué rico!"},
{"key": "data.voice.miami.perfect.1", "text": "エソ・エス！", "src": "¡Eso es!"},
{"key": "data.voice.miami.perfect.2", "text": "ダレ、ペルフェクト！", "src": "¡Dale, perfecto!"},
{"key": "data.voice.miami.praise.0", "text": "アイ、これこれ。グラシアス。", "src": "Ay, this is the one. Gracias."},
{"key": "data.voice.miami.praise.1", "text": "うちのアブエラも認めるよ。何も認めない人なのに。", "src": "My abuela would approve, and she approves of nothing."},
{"key": "data.voice.miami.praise.2", "text": "ダレ。わかってるね。", "src": "Dale. You know what you're doing."},
{"key": "data.voice.miami.sip.0", "text": "ミラ、{advice_l}", "src": "Mira, {advice_l}"},
{"key": "data.voice.miami.sip.1", "text": "オイェ、{advice_l}", "src": "Oye, {advice_l}"},
{"key": "data.voice.miami.sip.2", "text": "エスタ・ビエン、ペロ…{advice_l}", "src": "Está bien, pero… {advice_l}"},
{"key": "data.voice.miami.wrong.0", "text": "ケ・エス・エスト？", "src": "¿Qué es esto?"},
{"key": "data.voice.miami.wrong.1", "text": "ノー、ノー、ノー。", "src": "No, no, no."},
{"key": "data.voice.miami.wrong.2", "text": "私のじゃないよ、オイェ。", "src": "Not mine, oye."},
{"key": "data.voice.nyc.another.0", "text": "もう一杯、ヒット・ミー！", "src": "Hit me again!"},
{"key": "data.voice.nyc.another.1", "text": "どんどん持ってきて！", "src": "Keep 'em comin'!"},
{"key": "data.voice.nyc.another.2", "text": "おかわり、チーフ！", "src": "Another, chief!"},
{"key": "data.voice.nyc.close.0", "text": "まあ。いいんじゃない。", "src": "Eh. It's fine."},
{"key": "data.voice.nyc.close.1", "text": "ああ、オーライ。", "src": "Yeah, alright."},
{"key": "data.voice.nyc.close.2", "text": "これでいいや。", "src": "It'll do."},
{"key": "data.voice.nyc.kicked.0", "text": "今それ本気で言ってる？", "src": "You serious right now?"},
{"key": "data.voice.nyc.kicked.1", "text": "いいよ。どうせひどい店だし。", "src": "Fine. Terrible bar anyway."},
{"key": "data.voice.nyc.kicked.2", "text": "ワオ。オーケー。ワオ。", "src": "Wow. Okay. Wow."},
{"key": "data.voice.nyc.leaving.0", "text": "こっちは予定があるんだ。もういい。", "src": "I got places to be. Forget it."},
{"key": "data.voice.nyc.leaving.1", "text": "信じられない。出てくわ。", "src": "Unbelievable. I'm outta here."},
{"key": "data.voice.nyc.leaving.2", "text": "ヨー、ここはバー？それとも待合室？", "src": "Yo, is this a bar or a waiting room?"},
{"key": "data.voice.nyc.order.0", "text": "ヨー、{drink}ちょうだい。", "src": "Yo, lemme get a {drink}."},
{"key": "data.voice.nyc.order.1", "text": "{drink}。急いでるんで。", "src": "{drink}. And I'm in a hurry."},
{"key": "data.voice.nyc.order.2", "text": "{drink}をくれ、チーフ。", "src": "Gimme a {drink}, chief."},
{"key": "data.voice.nyc.order.3", "text": "{drink}。変なことしないでよ。", "src": "{drink}. Don't make it weird."},
{"key": "data.voice.nyc.perfect.0", "text": "そうこなくっちゃ！", "src": "Now we're talkin'!"},
{"key": "data.voice.nyc.perfect.1", "text": "これだよ、これ！", "src": "That's the stuff!"},
{"key": "data.voice.nyc.perfect.2", "text": "おお、それそれ！", "src": "Oh, that's it!"},
{"key": "data.voice.nyc.praise.0", "text": "オーケー、感心した。めったにないよ。", "src": "Okay, I'm impressed. That never happens."},
{"key": "data.voice.nyc.praise.1", "text": "言わせてもらうと、これぞ一杯だ。", "src": "Lemme tell ya, that's a drink."},
{"key": "data.voice.nyc.praise.2", "text": "もっと値上げしていいよ。しないでね。", "src": "You should charge more for this. Don't."},
{"key": "data.voice.nyc.sip.0", "text": "いいかい、{advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.nyc.sip.1", "text": "言っとくけど、{advice_l}", "src": "I'm just sayin', {advice_l}"},
{"key": "data.voice.nyc.sip.2", "text": "悪くない、でも{advice_l}", "src": "Not bad, but {advice_l}"},
{"key": "data.voice.nyc.wrong.0", "text": "何これ？", "src": "What is this?"},
{"key": "data.voice.nyc.wrong.1", "text": "フゲダボウディット。違うって。", "src": "Fuhgeddaboudit."},
{"key": "data.voice.nyc.wrong.2", "text": "違うよ、パル。", "src": "Wrong one, pal."},
{"key": "data.voice.surfer.another.0", "text": "もう一杯、デュード！", "src": "One more, dude!"},
{"key": "data.voice.surfer.another.1", "text": "もう一回、もう一回！", "src": "Again, again!"},
{"key": "data.voice.surfer.another.2", "text": "どんどん回して！", "src": "Keep 'em rolling!"},
{"key": "data.voice.surfer.close.0", "text": "クール、クール。", "src": "Cool, cool."},
{"key": "data.voice.surfer.close.1", "text": "うん、アリだね。", "src": "Yeah, that works."},
{"key": "data.voice.surfer.close.2", "text": "いい感じ。", "src": "Nice enough."},
{"key": "data.voice.surfer.kicked.0", "text": "キツいなあ、デュード。", "src": "Harsh, dude."},
{"key": "data.voice.surfer.kicked.1", "text": "オーケー…そういうバイブね。", "src": "Okay… that's a vibe."},
{"key": "data.voice.surfer.kicked.2", "text": "ワオ。チルじゃないね。", "src": "Wow. Not chill."},
{"key": "data.voice.surfer.leaving.0", "text": "デュード、もう永遠にここにいるんだけど。", "src": "Dude, I've been here forever."},
{"key": "data.voice.surfer.leaving.1", "text": "クールじゃないな。帰る。", "src": "Not cool. I'm out."},
{"key": "data.voice.surfer.leaving.2", "text": "うん、ナシ。抜けるわ。", "src": "Yeah, no. Bailing."},
{"key": "data.voice.surfer.order.0", "text": "デュード、{drink}を。", "src": "Dude, a {drink}."},
{"key": "data.voice.surfer.order.1", "text": "なんか、{drink}とかもらえる？", "src": "Can I get, like, a {drink}?"},
{"key": "data.voice.surfer.order.2", "text": "{drink}お願い。チルでいいよ、急がないで。", "src": "{drink}, please. Chill, no rush."},
{"key": "data.voice.surfer.order.3", "text": "うん、{drink}とか最高じゃん。", "src": "Yeah, a {drink} sounds epic."},
{"key": "data.voice.surfer.perfect.0", "text": "デュード。イエス。", "src": "Dude. Yes."},
{"key": "data.voice.surfer.perfect.1", "text": "ストークト！", "src": "Stoked!"},
{"key": "data.voice.surfer.perfect.2", "text": "超いい！", "src": "So good!"},
{"key": "data.voice.surfer.praise.0", "text": "オーケー、マジで完璧。リスペクト。", "src": "Okay, that's actually perfect. Respect."},
{"key": "data.voice.surfer.praise.1", "text": "デュード。冗談抜きで最高。", "src": "Dude. I'm not even kidding. Amazing."},
{"key": "data.voice.surfer.praise.2", "text": "ナーリー。いい意味でね。", "src": "Gnarly. In a good way."},
{"key": "data.voice.surfer.sip.0", "text": "デュード、{advice_l}", "src": "Dude, {advice_l}"},
{"key": "data.voice.surfer.sip.1", "text": "で、えっと、{advice_l}", "src": "Okay so, {advice_l}"},
{"key": "data.voice.surfer.sip.2", "text": "気にしないでほしいけど、{advice_l}", "src": "No stress, but {advice_l}"},
{"key": "data.voice.surfer.wrong.0", "text": "あれ、ドリンク違う？", "src": "Uh, wrong drink?"},
{"key": "data.voice.surfer.wrong.1", "text": "これじゃないよ、デュード。", "src": "Not it, dude."},
{"key": "data.voice.surfer.wrong.2", "text": "バマー。私のじゃない。", "src": "Bummer. Not mine."}
]}
