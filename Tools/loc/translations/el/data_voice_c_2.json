{"strings": [
{"key": "data.voice.japanese.order.2", "text": "{drink}, παρακαλώ. Arigatou.", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto… {drink}.", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "Oishii!", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "Sugoi, τέλειο!", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "Kanpai!", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii. Αλήθεια, αυτό είναι.", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "Sugoi. Είσαι επαγγελματίας, ne.", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "Kanpai. Είναι τέλειο.", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "Etto, {advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "Ne, {advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "Sumimasen, αλλά {advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "Chotto… όχι.", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "Eh! Όχι αυτό.", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "Chigau, συγγνώμη.", "src": "Chigau, sorry."},
{"key": "data.voice.midwest.another.0", "text": "Άλλο ένα, παρακαλώ!", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "Ένα ακόμα, ευχαριστώ!", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "Τα ίδια, ope!", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "Α, καλό είναι.", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "Βεβαίως, ευχαριστώ.", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "Καθόλου άσχημα.", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "Α. Λοιπόν. Εντάξει τότε.", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "Ope, συγγνώμη… φεύγω.", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "Λίγο υπερβολικό, αλλά εντάξει.", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "Oh gosh, δεν μπορώ να περιμένω άλλο.", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "Λοιπόν, πρέπει να πηγαίνω.", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "Συγγνώμη, αλλά θα φύγω.", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "Μπορώ να έχω {drink}; Ευχαριστώ πολύ.", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "{drink}, αν δεν είναι κόπος.", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "Α, απλώς {drink} για μένα.", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink}, παρακαλώ. Όποτε μπορείς.", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "Α, πολύ ωραίο!", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "You betcha!", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "Oh jeez, ναι!", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "Oh my gosh, είναι απλώς υπέροχο.", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "Πολύ ωραίο. Η θεία μου θα λάτρευε αυτό το μέρος.", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "Λοιπόν, αυτό έπιασε τόπο.", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "Α, {advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "Απλώς να ξέρεις, {advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "Δεν είναι τίποτα, αλλά {advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "Ope. Λάθος.", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "Α, αυτό δεν είναι δικό μου.", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "Συγγνώμη, όχι. Όχι αυτό.", "src": "Sorry, no. Not this."},
{"key": "data.voice.polish.another.0", "text": "Jeszcze raz!", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "Άλλο ένα, proszę!", "src": "Another, proszę!"},
{"key": "data.voice.polish.another.2", "text": "Ένα ακόμα!", "src": "One more!"},
{"key": "data.voice.polish.close.0", "text": "Dobrze.", "src": "Dobrze."},
{"key": "data.voice.polish.close.1", "text": "Εντάξει.", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "Καλό, ευχαριστώ.", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "Serio; Εντάξει.", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "Καλά. Do widzenia.", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "Co; Εντάξει, φεύγω.", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "Φτάνει. Φεύγω.", "src": "Enough. I'm going."},
{"key": "data.voice.polish.leaving.1", "text": "Nie, nie. Πολλή ώρα.", "src": "Nie, nie. Too long."},
{"key": "data.voice.polish.leaving.2", "text": "Do widzenia.", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "{drink}, proszę.", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "{drink}, παρακαλώ.", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "{drink}. Ευχαριστώ.", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "Dobrze, {drink}.", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "Na zdrowie!", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "Świetnie!", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "Πολύ καλό!", "src": "Very good!"},
{"key": "data.voice.polish.praise.0", "text": "Na zdrowie. Αυτό είναι κανονικό ποτό.", "src": "Na zdrowie. This is a real drink."},
{"key": "data.voice.polish.praise.1", "text": "Świetnie. Σαν στο σπίτι.", "src": "Świetnie. Like at home."},
{"key": "data.voice.polish.praise.2", "text": "Dobrze. Πολύ, πολύ καλό.", "src": "Dobrze. Very, very good."},
{"key": "data.voice.polish.sip.0", "text": "Dobrze, αλλά {advice_l}", "src": "Dobrze, but {advice_l}"},
{"key": "data.voice.polish.sip.1", "text": "Άκου, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.polish.sip.2", "text": "Χμ, {advice_l}", "src": "Hm, {advice_l}"},
{"key": "data.voice.polish.wrong.0", "text": "Nie. Λάθος.", "src": "Nie. Wrong one."},
{"key": "data.voice.polish.wrong.1", "text": "Δεν είναι δικό μου.", "src": "This is not mine."},
{"key": "data.voice.polish.wrong.2", "text": "Co to jest?", "src": "Co to jest?"},
{"key": "data.voice.turkish.another.0", "text": "Bir daha!", "src": "Bir daha!"},
{"key": "data.voice.turkish.another.1", "text": "Άλλο ένα, abi!", "src": "Another, abi!"},
{"key": "data.voice.turkish.another.2", "text": "Πάλι, eyvallah!", "src": "Again, eyvallah!"},
{"key": "data.voice.turkish.close.0", "text": "Tamam.", "src": "Tamam."},
{"key": "data.voice.turkish.close.1", "text": "İdare eder.", "src": "İdare eder."},
{"key": "data.voice.turkish.close.2", "text": "Εντάξει, καλό.", "src": "Okay, fine."},
{"key": "data.voice.turkish.kicked.0", "text": "Ciddi misin; Εντάξει.", "src": "Ciddi misin? Okay."},
{"key": "data.voice.turkish.kicked.1", "text": "Abi, αλήθεια; Καλά.", "src": "Abi, really? Fine."},
{"key": "data.voice.turkish.kicked.2", "text": "Yok, yok. Φεύγω.", "src": "Yok, yok. I'm going."},
{"key": "data.voice.turkish.leaving.0", "text": "Yok, δεν περιμένω άλλο.", "src": "Yok, I'm not waiting anymore."},
{"key": "data.voice.turkish.leaving.1", "text": "Abi, δεν δουλεύει κανείς εδώ;", "src": "Abi, is nobody working here?"},
{"key": "data.voice.turkish.leaving.2", "text": "Tamam, hoşça kal.", "src": "Tamam, hoşça kal."},
{"key": "data.voice.turkish.order.0", "text": "Abi, {drink}.", "src": "Abi, a {drink}."},
{"key": "data.voice.turkish.order.1", "text": "{drink}, eyvallah.", "src": "One {drink}, eyvallah."},
{"key": "data.voice.turkish.order.2", "text": "{drink}, canım, όταν μπορείς.", "src": "{drink}, canım, when you can."},
{"key": "data.voice.turkish.order.3", "text": "Bir {drink}, παρακαλώ.", "src": "Bir {drink}, please."},
{"key": "data.voice.turkish.perfect.0", "text": "Eyvallah!", "src": "Eyvallah!"},
{"key": "data.voice.turkish.perfect.1", "text": "Harika!", "src": "Harika!"},
{"key": "data.voice.turkish.perfect.2", "text": "Süper, abi!", "src": "Süper, abi!"},
{"key": "data.voice.turkish.praise.0", "text": "Eyvallah. Έτσι γίνεται.", "src": "Eyvallah. This is how it's done."},
{"key": "data.voice.turkish.praise.1", "text": "Abi, βγάζω το καπέλο. Harika.", "src": "Abi, my hat is off. Harika."},
{"key": "data.voice.turkish.praise.2", "text": "Tamam, ξέρεις τη δουλειά σου.", "src": "Tamam, you know your work."},
{"key": "data.voice.turkish.sip.0", "text": "Abi, {advice_l}", "src": "Abi, {advice_l}"},
{"key": "data.voice.turkish.sip.1", "text": "Bak, {advice_l}", "src": "Bak, {advice_l}"},
{"key": "data.voice.turkish.sip.2", "text": "Tamam ama, {advice_l}", "src": "Tamam ama, {advice_l}"},
{"key": "data.voice.turkish.wrong.0", "text": "Yok, όχι αυτό.", "src": "Yok, not this."},
{"key": "data.voice.turkish.wrong.1", "text": "Abi, λάθος.", "src": "Abi, wrong one."},
{"key": "data.voice.turkish.wrong.2", "text": "Bu ne şimdi?", "src": "Bu ne şimdi?"}
]}
