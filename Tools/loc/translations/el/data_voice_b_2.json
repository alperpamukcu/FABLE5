{"strings": [
{"key": "data.voice.italian.order.2", "text": "{drink}, grazie.", "src": "{drink}, grazie."},
{"key": "data.voice.italian.order.3", "text": "Dai, {drink}.", "src": "Dai, a {drink}."},
{"key": "data.voice.italian.perfect.0", "text": "Perfetto!", "src": "Perfetto!"},
{"key": "data.voice.italian.perfect.1", "text": "Bravo!", "src": "Bravo!"},
{"key": "data.voice.italian.perfect.2", "text": "Che buono!", "src": "Che buono!"},
{"key": "data.voice.italian.praise.0", "text": "Perfetto. Αλήθεια. Grazie mille.", "src": "Perfetto. Truly. Grazie mille."},
{"key": "data.voice.italian.praise.1", "text": "Bravo. Η nonna μου θα έκλαιγε.", "src": "Bravo. My nonna would cry."},
{"key": "data.voice.italian.praise.2", "text": "Che buono. Δεν φεύγω.", "src": "Che buono. I'm not leaving."},
{"key": "data.voice.italian.sip.0", "text": "Senti, {advice_l}", "src": "Senti, {advice_l}"},
{"key": "data.voice.italian.sip.1", "text": "Allora, {advice_l}", "src": "Allora, {advice_l}"},
{"key": "data.voice.italian.sip.2", "text": "Va bene, ma {advice_l}", "src": "Va bene, ma {advice_l}"},
{"key": "data.voice.italian.wrong.0", "text": "Mamma mia, όχι.", "src": "Mamma mia, no."},
{"key": "data.voice.italian.wrong.1", "text": "Ma che cos'è?", "src": "Ma che cos'è?"},
{"key": "data.voice.italian.wrong.2", "text": "No, no. Όχι αυτό.", "src": "No, no. Not this."},
{"key": "data.voice.miami.another.0", "text": "¡Otra, dale!", "src": "¡Otra, dale!"},
{"key": "data.voice.miami.another.1", "text": "Άλλο ένα, oye!", "src": "One more, oye!"},
{"key": "data.voice.miami.another.2", "text": "Πάλι, mi amor!", "src": "Again, mi amor!"},
{"key": "data.voice.miami.close.0", "text": "Está bien.", "src": "Está bien."},
{"key": "data.voice.miami.close.1", "text": "Όχι άσχημα, chico.", "src": "Not bad, chico."},
{"key": "data.voice.miami.close.2", "text": "Οκέι, οκέι.", "src": "Okay, okay."},
{"key": "data.voice.miami.kicked.0", "text": "¿En serio? Καλά, εντάξει.", "src": "¿En serio? Okay, fine."},
{"key": "data.voice.miami.kicked.1", "text": "Πλάκα μου κάνεις, chico.", "src": "You're kidding me, chico."},
{"key": "data.voice.miami.kicked.2", "text": "Dale. Εσύ χάνεις.", "src": "Dale. Your loss."},
{"key": "data.voice.miami.leaving.0", "text": "¡Oye! Κάθομαι εδώ όλη νύχτα.", "src": "¡Oye! I've been sitting here all night."},
{"key": "data.voice.miami.leaving.1", "text": "Bueno, τέλος. Ciao.", "src": "Bueno, that's it. Ciao."},
{"key": "data.voice.miami.leaving.2", "text": "No, no. Δεν περιμένω άλλο.", "src": "No, no. I'm not waiting anymore."},
{"key": "data.voice.miami.order.0", "text": "Oye, {drink} για μένα.", "src": "Oye, a {drink} for me."},
{"key": "data.voice.miami.order.1", "text": "Dale, {drink}.", "src": "Dale, one {drink}."},
{"key": "data.voice.miami.order.2", "text": "{drink}, papi, όταν μπορείς.", "src": "{drink}, papi, when you can."},
{"key": "data.voice.miami.order.3", "text": "Mi amor, {drink}.", "src": "Mi amor, a {drink}."},
{"key": "data.voice.miami.perfect.0", "text": "¡Qué rico!", "src": "¡Qué rico!"},
{"key": "data.voice.miami.perfect.1", "text": "¡Eso es!", "src": "¡Eso es!"},
{"key": "data.voice.miami.perfect.2", "text": "¡Dale, perfecto!", "src": "¡Dale, perfecto!"},
{"key": "data.voice.miami.praise.0", "text": "Ay, αυτό είναι. Gracias.", "src": "Ay, this is the one. Gracias."},
{"key": "data.voice.miami.praise.1", "text": "Η abuela μου θα το ενέκρινε, κι αυτή δεν εγκρίνει τίποτα.", "src": "My abuela would approve, and she approves of nothing."},
{"key": "data.voice.miami.praise.2", "text": "Dale. Ξέρεις τι κάνεις.", "src": "Dale. You know what you're doing."},
{"key": "data.voice.miami.sip.0", "text": "Mira, {advice_l}", "src": "Mira, {advice_l}"},
{"key": "data.voice.miami.sip.1", "text": "Oye, {advice_l}", "src": "Oye, {advice_l}"},
{"key": "data.voice.miami.sip.2", "text": "Está bien, pero… {advice_l}", "src": "Está bien, pero… {advice_l}"},
{"key": "data.voice.miami.wrong.0", "text": "¿Qué es esto?", "src": "¿Qué es esto?"},
{"key": "data.voice.miami.wrong.1", "text": "No, no, no.", "src": "No, no, no."},
{"key": "data.voice.miami.wrong.2", "text": "Δεν είναι δικό μου, oye.", "src": "Not mine, oye."},
{"key": "data.voice.nyc.another.0", "text": "Ξαναβάλε!", "src": "Hit me again!"},
{"key": "data.voice.nyc.another.1", "text": "Φέρνε, φέρνε!", "src": "Keep 'em comin'!"},
{"key": "data.voice.nyc.another.2", "text": "Άλλο ένα, chief!", "src": "Another, chief!"},
{"key": "data.voice.nyc.close.0", "text": "Ε. Καλό είναι.", "src": "Eh. It's fine."},
{"key": "data.voice.nyc.close.1", "text": "Ναι, εντάξει.", "src": "Yeah, alright."},
{"key": "data.voice.nyc.close.2", "text": "Θα κάνει.", "src": "It'll do."},
{"key": "data.voice.nyc.kicked.0", "text": "Σοβαρολογείς τώρα;", "src": "You serious right now?"},
{"key": "data.voice.nyc.kicked.1", "text": "Καλά. Άθλιο μπαρ έτσι κι αλλιώς.", "src": "Fine. Terrible bar anyway."},
{"key": "data.voice.nyc.kicked.2", "text": "Ουάου. Εντάξει. Ουάου.", "src": "Wow. Okay. Wow."},
{"key": "data.voice.nyc.leaving.0", "text": "Έχω δουλειές. Ξέχνα το.", "src": "I got places to be. Forget it."},
{"key": "data.voice.nyc.leaving.1", "text": "Απίστευτο. Την κάνω.", "src": "Unbelievable. I'm outta here."},
{"key": "data.voice.nyc.leaving.2", "text": "Yo, μπαρ είναι αυτό ή αίθουσα αναμονής;", "src": "Yo, is this a bar or a waiting room?"},
{"key": "data.voice.nyc.order.0", "text": "Yo, δώσε μου {drink}.", "src": "Yo, lemme get a {drink}."},
{"key": "data.voice.nyc.order.1", "text": "{drink}. Και βιάζομαι.", "src": "{drink}. And I'm in a hurry."},
{"key": "data.voice.nyc.order.2", "text": "Φέρε μου {drink}, chief.", "src": "Gimme a {drink}, chief."},
{"key": "data.voice.nyc.order.3", "text": "{drink}. Χωρίς περίεργα.", "src": "{drink}. Don't make it weird."},
{"key": "data.voice.nyc.perfect.0", "text": "Τώρα μάλιστα!", "src": "Now we're talkin'!"},
{"key": "data.voice.nyc.perfect.1", "text": "Αυτό είναι!", "src": "That's the stuff!"},
{"key": "data.voice.nyc.perfect.2", "text": "Ω, αυτό!", "src": "Oh, that's it!"},
{"key": "data.voice.nyc.praise.0", "text": "Εντάξει, εντυπωσιάστηκα. Δεν συμβαίνει ποτέ.", "src": "Okay, I'm impressed. That never happens."},
{"key": "data.voice.nyc.praise.1", "text": "Άκου να σου πω, αυτό είναι ποτό.", "src": "Lemme tell ya, that's a drink."},
{"key": "data.voice.nyc.praise.2", "text": "Θα 'πρεπε να το χρεώνεις ακριβότερα. Μην το κάνεις.", "src": "You should charge more for this. Don't."},
{"key": "data.voice.nyc.sip.0", "text": "Κοίτα, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.nyc.sip.1", "text": "Απλώς λέω, {advice_l}", "src": "I'm just sayin', {advice_l}"},
{"key": "data.voice.nyc.sip.2", "text": "Όχι άσχημα, αλλά {advice_l}", "src": "Not bad, but {advice_l}"},
{"key": "data.voice.nyc.wrong.0", "text": "Τι είναι αυτό;", "src": "What is this?"},
{"key": "data.voice.nyc.wrong.1", "text": "Fuhgeddaboudit.", "src": "Fuhgeddaboudit."},
{"key": "data.voice.nyc.wrong.2", "text": "Λάθος, pal.", "src": "Wrong one, pal."},
{"key": "data.voice.surfer.another.0", "text": "Άλλο ένα, dude!", "src": "One more, dude!"},
{"key": "data.voice.surfer.another.1", "text": "Πάλι, πάλι!", "src": "Again, again!"},
{"key": "data.voice.surfer.another.2", "text": "Συνέχισε το κύμα!", "src": "Keep 'em rolling!"},
{"key": "data.voice.surfer.close.0", "text": "Cool, cool.", "src": "Cool, cool."},
{"key": "data.voice.surfer.close.1", "text": "Ναι, κάνει.", "src": "Yeah, that works."},
{"key": "data.voice.surfer.close.2", "text": "Αρκετά ωραίο.", "src": "Nice enough."},
{"key": "data.voice.surfer.kicked.0", "text": "Σκληρό, dude.", "src": "Harsh, dude."},
{"key": "data.voice.surfer.kicked.1", "text": "Οκέι… κι αυτό vibe είναι.", "src": "Okay… that's a vibe."},
{"key": "data.voice.surfer.kicked.2", "text": "Ουάου. Καθόλου chill.", "src": "Wow. Not chill."},
{"key": "data.voice.surfer.leaving.0", "text": "Dude, είμαι εδώ μια αιωνιότητα.", "src": "Dude, I've been here forever."},
{"key": "data.voice.surfer.leaving.1", "text": "Όχι cool. Φεύγω.", "src": "Not cool. I'm out."},
{"key": "data.voice.surfer.leaving.2", "text": "Ναι, όχι. Την κάνω.", "src": "Yeah, no. Bailing."},
{"key": "data.voice.surfer.order.0", "text": "Dude, {drink}.", "src": "Dude, a {drink}."},
{"key": "data.voice.surfer.order.1", "text": "Μπορώ να πάρω, ας πούμε, {drink};", "src": "Can I get, like, a {drink}?"},
{"key": "data.voice.surfer.order.2", "text": "{drink}, παρακαλώ. Chill, χωρίς βιασύνη.", "src": "{drink}, please. Chill, no rush."},
{"key": "data.voice.surfer.order.3", "text": "Ναι, {drink} ακούγεται epic.", "src": "Yeah, a {drink} sounds epic."},
{"key": "data.voice.surfer.perfect.0", "text": "Dude. Ναι.", "src": "Dude. Yes."},
{"key": "data.voice.surfer.perfect.1", "text": "Stoked!", "src": "Stoked!"},
{"key": "data.voice.surfer.perfect.2", "text": "Τέλειο!", "src": "So good!"},
{"key": "data.voice.surfer.praise.0", "text": "Οκέι, αυτό είναι όντως τέλειο. Respect.", "src": "Okay, that's actually perfect. Respect."},
{"key": "data.voice.surfer.praise.1", "text": "Dude. Δεν κάνω πλάκα. Φοβερό.", "src": "Dude. I'm not even kidding. Amazing."},
{"key": "data.voice.surfer.praise.2", "text": "Gnarly. Με την καλή έννοια.", "src": "Gnarly. In a good way."},
{"key": "data.voice.surfer.sip.0", "text": "Dude, {advice_l}", "src": "Dude, {advice_l}"},
{"key": "data.voice.surfer.sip.1", "text": "Οκέι, λοιπόν, {advice_l}", "src": "Okay so, {advice_l}"},
{"key": "data.voice.surfer.sip.2", "text": "Κανένα άγχος, αλλά {advice_l}", "src": "No stress, but {advice_l}"},
{"key": "data.voice.surfer.wrong.0", "text": "Εμ, λάθος ποτό;", "src": "Uh, wrong drink?"},
{"key": "data.voice.surfer.wrong.1", "text": "Όχι αυτό, dude.", "src": "Not it, dude."},
{"key": "data.voice.surfer.wrong.2", "text": "Bummer. Δεν είναι δικό μου.", "src": "Bummer. Not mine."}
]}
