{"strings": [
{"key": "data.voice.arabic.another.0", "text": "Kaman wahad!", "src": "Kaman wahad!"},
{"key": "data.voice.arabic.another.1", "text": "Άλλο ένα, yalla!", "src": "One more, yalla!"},
{"key": "data.voice.arabic.another.2", "text": "Πάλι, habibi!", "src": "Again, habibi!"},
{"key": "data.voice.arabic.close.0", "text": "Maashi.", "src": "Maashi."},
{"key": "data.voice.arabic.close.1", "text": "Εντάξει είναι.", "src": "It is okay."},
{"key": "data.voice.arabic.close.2", "text": "Tamam, shukran.", "src": "Tamam, shukran."},
{"key": "data.voice.arabic.kicked.0", "text": "Shu; Σοβαρά;", "src": "Shu? Seriously?"},
{"key": "data.voice.arabic.kicked.1", "text": "Khalas. Καλά.", "src": "Khalas. Fine."},
{"key": "data.voice.arabic.kicked.2", "text": "Yalla. Πάω.", "src": "Yalla. I go."},
{"key": "data.voice.arabic.leaving.0", "text": "Khalas. Φεύγω.", "src": "Khalas. I am going."},
{"key": "data.voice.arabic.leaving.1", "text": "Yalla, φτάνει η αναμονή.", "src": "Yalla, enough waiting."},
{"key": "data.voice.arabic.leaving.2", "text": "Maa salama.", "src": "Maa salama."},
{"key": "data.voice.arabic.order.0", "text": "{drink}, παρακαλώ.", "src": "A {drink}, please."},
{"key": "data.voice.arabic.order.1", "text": "{drink}, shukran.", "src": "One {drink}, shukran."},
{"key": "data.voice.arabic.order.2", "text": "Habibi, {drink}.", "src": "Habibi, a {drink}."},
{"key": "data.voice.arabic.order.3", "text": "Θα πάρω {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.arabic.perfect.0", "text": "Ya salam!", "src": "Ya salam!"},
{"key": "data.voice.arabic.perfect.1", "text": "Helu kteer!", "src": "Helu kteer!"},
{"key": "data.voice.arabic.perfect.2", "text": "Τέλειο, habibi!", "src": "Perfect, habibi!"},
{"key": "data.voice.arabic.praise.0", "text": "Ya salam. Αυτό είναι, habibi.", "src": "Ya salam. This is the one, habibi."},
{"key": "data.voice.arabic.praise.1", "text": "Helu kteer. Shukran.", "src": "Helu kteer. Shukran."},
{"key": "data.voice.arabic.praise.2", "text": "Yalla, ξέρεις τη δουλειά σου.", "src": "Yalla, you know your work."},
{"key": "data.voice.arabic.sip.0", "text": "Habibi, {advice_l}", "src": "Habibi, {advice_l}"},
{"key": "data.voice.arabic.sip.1", "text": "Shuf, {advice_l}", "src": "Shuf, {advice_l}"},
{"key": "data.voice.arabic.sip.2", "text": "Tamam, bas {advice_l}", "src": "Tamam, bas {advice_l}"},
{"key": "data.voice.arabic.wrong.0", "text": "La, la.", "src": "La, la."},
{"key": "data.voice.arabic.wrong.1", "text": "Δεν είναι αυτό.", "src": "This is not it."},
{"key": "data.voice.arabic.wrong.2", "text": "Shu hada?", "src": "Shu hada?"},
{"key": "data.voice.chinese.another.0", "text": "Zai lai yi bei!", "src": "Zai lai yi bei!"},
{"key": "data.voice.chinese.another.1", "text": "Άλλο ένα, ah!", "src": "One more, ah!"},
{"key": "data.voice.chinese.another.2", "text": "Πάλι, παρακαλώ!", "src": "Again, please!"},
{"key": "data.voice.chinese.close.0", "text": "Hai keyi.", "src": "Hai keyi."},
{"key": "data.voice.chinese.close.1", "text": "Εντάξει, lah.", "src": "Okay lah."},
{"key": "data.voice.chinese.close.2", "text": "Καλό είναι.", "src": "It is fine."},
{"key": "data.voice.chinese.kicked.0", "text": "Shenme; Αλήθεια;", "src": "Shenme? Really?"},
{"key": "data.voice.chinese.kicked.1", "text": "Aiya. Καλά.", "src": "Aiya. Fine."},
{"key": "data.voice.chinese.kicked.2", "text": "Hao. Φεύγω.", "src": "Hao. I leave."},
{"key": "data.voice.chinese.leaving.0", "text": "Aiya. Περίμενα πολύ.", "src": "Aiya. I waited too long."},
{"key": "data.voice.chinese.leaving.1", "text": "Suan le. Πάω.", "src": "Suan le. I go."},
{"key": "data.voice.chinese.leaving.2", "text": "Zaijian, λοιπόν.", "src": "Zaijian, then."},
{"key": "data.voice.chinese.order.0", "text": "{drink}, παρακαλώ.", "src": "{drink}, please."},
{"key": "data.voice.chinese.order.1", "text": "{drink}, xiexie.", "src": "One {drink}, xiexie."},
{"key": "data.voice.chinese.order.2", "text": "Θα πάρω {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.chinese.order.3", "text": "{drink} για μένα.", "src": "A {drink} for me."},
{"key": "data.voice.chinese.perfect.0", "text": "Hen hao!", "src": "Hen hao!"},
{"key": "data.voice.chinese.perfect.1", "text": "Τέλειο, ah!", "src": "Perfect, ah!"},
{"key": "data.voice.chinese.perfect.2", "text": "Zhen bang!", "src": "Zhen bang!"},
{"key": "data.voice.chinese.praise.0", "text": "Zhen bang. Θα ξανάρθω γι' αυτό.", "src": "Zhen bang. I will come back for this."},
{"key": "data.voice.chinese.praise.1", "text": "Hen hao. Ξέρεις τι κάνεις.", "src": "Hen hao. You know what you are doing."},
{"key": "data.voice.chinese.praise.2", "text": "Τέλειο, ah. Αλήθεια.", "src": "Perfect, ah. Really."},
{"key": "data.voice.chinese.sip.0", "text": "Ai, {advice_l}", "src": "Ai, {advice_l}"},
{"key": "data.voice.chinese.sip.1", "text": "Άκου, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.chinese.sip.2", "text": "Hao, αλλά {advice_l}", "src": "Hao, but {advice_l}"},
{"key": "data.voice.chinese.wrong.0", "text": "Bu dui.", "src": "Bu dui."},
{"key": "data.voice.chinese.wrong.1", "text": "Aiya, όχι.", "src": "Aiya, no."},
{"key": "data.voice.chinese.wrong.2", "text": "Όχι αυτό.", "src": "Not this one."},
{"key": "data.voice.filipino.another.0", "text": "Isa pa!", "src": "Isa pa!"},
{"key": "data.voice.filipino.another.1", "text": "Άλλο ένα, ha!", "src": "One more, ha!"},
{"key": "data.voice.filipino.another.2", "text": "Πάλι, παρακαλώ!", "src": "Again, please!"},
{"key": "data.voice.filipino.close.0", "text": "Okay lang.", "src": "Okay lang."},
{"key": "data.voice.filipino.close.1", "text": "Sige, ευχαριστώ.", "src": "Sige, thanks."},
{"key": "data.voice.filipino.close.2", "text": "Ay, καλό είναι.", "src": "Ay, it's fine."},
{"key": "data.voice.filipino.kicked.0", "text": "Ha; Αλήθεια;", "src": "Ha? Really?"},
{"key": "data.voice.filipino.kicked.1", "text": "Ay. Εντάξει. Γεια.", "src": "Ay. Okay. Bye."},
{"key": "data.voice.filipino.kicked.2", "text": "Grabe naman.", "src": "Grabe naman."},
{"key": "data.voice.filipino.leaving.0", "text": "Ay, grabe. Πολλή ώρα. Φεύγω.", "src": "Ay, grabe. Too long. I'm going."},
{"key": "data.voice.filipino.leaving.1", "text": "Sige na, γεια.", "src": "Sige na, bye."},
{"key": "data.voice.filipino.leaving.2", "text": "Naku, δεν έρχεται κανείς.", "src": "Naku, no one is coming."},
{"key": "data.voice.filipino.order.0", "text": "Ay, {drink}, παρακαλώ.", "src": "Ay, one {drink}, please."},
{"key": "data.voice.filipino.order.1", "text": "{drink} για μένα. Salamat.", "src": "{drink} for me. Salamat."},
{"key": "data.voice.filipino.order.2", "text": "Μου φέρνεις {drink}; Ευχαριστώ, ha.", "src": "Can I have a {drink}? Thanks, ha."},
{"key": "data.voice.filipino.order.3", "text": "{drink}, kuya.", "src": "A {drink}, kuya."},
{"key": "data.voice.filipino.perfect.0", "text": "Ay, sarap!", "src": "Ay, sarap!"},
{"key": "data.voice.filipino.perfect.1", "text": "Grabe, ναι!", "src": "Grabe, yes!"},
{"key": "data.voice.filipino.perfect.2", "text": "Τέλειο, kuya!", "src": "Perfect, kuya!"},
{"key": "data.voice.filipino.praise.0", "text": "Grabe. Τόσο καλό. Salamat.", "src": "Grabe. That is so good. Salamat."},
{"key": "data.voice.filipino.praise.1", "text": "Ay, sarap. Μου έφτιαξες όλη τη βάρδια.", "src": "Ay, sarap. You made my whole shift."},
{"key": "data.voice.filipino.praise.2", "text": "Sige, θα ξανάρθω γι' αυτό.", "src": "Sige, I'm coming back for this."},
{"key": "data.voice.filipino.sip.0", "text": "Ay, {advice_l}", "src": "Ay, {advice_l}"},
{"key": "data.voice.filipino.sip.1", "text": "Sige, αλλά {advice_l}", "src": "Sige, but {advice_l}"},
{"key": "data.voice.filipino.sip.2", "text": "Ha; {advice}", "src": "Ha? {advice}"},
{"key": "data.voice.filipino.wrong.0", "text": "Ay, hindi. Όχι αυτό.", "src": "Ay, hindi. Not this."},
{"key": "data.voice.filipino.wrong.1", "text": "Grabe, λάθος ποτό.", "src": "Grabe, wrong drink."},
{"key": "data.voice.filipino.wrong.2", "text": "Δεν είναι δικό μου, kuya.", "src": "Not mine, kuya."},
{"key": "data.voice.italian.another.0", "text": "Ancora, dai!", "src": "Ancora, dai!"},
{"key": "data.voice.italian.another.1", "text": "Άλλο ένα, grazie!", "src": "Another, grazie!"},
{"key": "data.voice.italian.another.2", "text": "Άλλη μια φορά, amore!", "src": "Once more, amore!"},
{"key": "data.voice.italian.close.0", "text": "Va bene.", "src": "Va bene."},
{"key": "data.voice.italian.close.1", "text": "Εντάξει, grazie.", "src": "Okay, grazie."},
{"key": "data.voice.italian.close.2", "text": "Όχι άσχημα, ε.", "src": "Not bad, eh."},
{"key": "data.voice.italian.kicked.0", "text": "Ma dai! Αλήθεια;", "src": "Ma dai! Really?"},
{"key": "data.voice.italian.kicked.1", "text": "Va bene. Ciao, ciao.", "src": "Va bene. Ciao, ciao."},
{"key": "data.voice.italian.kicked.2", "text": "Che maleducato.", "src": "Che maleducato."},
{"key": "data.voice.italian.leaving.0", "text": "Basta. Φεύγω.", "src": "Basta. I go."},
{"key": "data.voice.italian.leaving.1", "text": "Mamma mia, αυτή η αναμονή!", "src": "Mamma mia, the waiting!"},
{"key": "data.voice.italian.leaving.2", "text": "Ciao. Ίσως σε άλλη ζωή.", "src": "Ciao. Maybe next life."},
{"key": "data.voice.italian.order.0", "text": "{drink}, per favore.", "src": "Un {drink}, per favore."},
{"key": "data.voice.italian.order.1", "text": "{drink}, amore.", "src": "A {drink}, amore."}
]}
