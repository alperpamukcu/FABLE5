{"strings": [
{"key": "data.voice.german.order.2", "text": "{drink}, bitte.", "src": "One {drink}, bitte."},
{"key": "data.voice.german.order.3", "text": "Θα ήθελα {drink}.", "src": "I would like a {drink}."},
{"key": "data.voice.german.perfect.0", "text": "Genau!", "src": "Genau!"},
{"key": "data.voice.german.perfect.1", "text": "Sehr gut!", "src": "Sehr gut!"},
{"key": "data.voice.german.perfect.2", "text": "Wunderbar!", "src": "Wunderbar!"},
{"key": "data.voice.german.praise.0", "text": "Ja. Αυτό είναι ακριβώς σωστό.", "src": "Ja. This is exactly right."},
{"key": "data.voice.german.praise.1", "text": "Ακρίβεια. Σέβομαι την ακρίβεια.", "src": "Precise. I respect precision."},
{"key": "data.voice.german.praise.2", "text": "Sehr gut. Καμία παρατήρηση.", "src": "Sehr gut. No notes."},
{"key": "data.voice.german.sip.0", "text": "Genau, αλλά {advice_l}", "src": "Genau, but {advice_l}"},
{"key": "data.voice.german.sip.1", "text": "Μία παρατήρηση: {advice_l}", "src": "One remark: {advice_l}"},
{"key": "data.voice.german.sip.2", "text": "Ja, {advice_l}", "src": "Ja, {advice_l}"},
{"key": "data.voice.german.wrong.0", "text": "Nein. Όχι αυτό.", "src": "Nein. Not this."},
{"key": "data.voice.german.wrong.1", "text": "Αυτό είναι λάθος.", "src": "This is incorrect."},
{"key": "data.voice.german.wrong.2", "text": "Λάθος ποτό.", "src": "Wrong drink."},
{"key": "data.voice.korean.another.0", "text": "Han jan deo!", "src": "Han jan deo!"},
{"key": "data.voice.korean.another.1", "text": "Άλλο ένα!", "src": "One more!"},
{"key": "data.voice.korean.another.2", "text": "Πάλι, juseyo!", "src": "Again, juseyo!"},
{"key": "data.voice.korean.close.0", "text": "Gwenchana.", "src": "Gwenchana."},
{"key": "data.voice.korean.close.1", "text": "Εντάξει είναι.", "src": "It is okay."},
{"key": "data.voice.korean.close.2", "text": "Nappeuji anha.", "src": "Nappeuji anha."},
{"key": "data.voice.korean.kicked.0", "text": "Jinjja; Ουάου.", "src": "Jinjja? Wow."},
{"key": "data.voice.korean.kicked.1", "text": "Aish. Καλά.", "src": "Aish. Fine."},
{"key": "data.voice.korean.kicked.2", "text": "Annyeong, λοιπόν.", "src": "Annyeong, then."},
{"key": "data.voice.korean.leaving.0", "text": "Aish. Πολλή αναμονή.", "src": "Aish. Too long."},
{"key": "data.voice.korean.leaving.1", "text": "Φεύγω. Annyeong.", "src": "I am going. Annyeong."},
{"key": "data.voice.korean.leaving.2", "text": "Mot chamgesseo.", "src": "Mot chamgesseo."},
{"key": "data.voice.korean.order.0", "text": "{drink}, juseyo.", "src": "{drink}, juseyo."},
{"key": "data.voice.korean.order.1", "text": "{drink}, παρακαλώ.", "src": "One {drink}, please."},
{"key": "data.voice.korean.order.2", "text": "{drink} για μένα.", "src": "A {drink} for me."},
{"key": "data.voice.korean.order.3", "text": "Θέλω {drink}.", "src": "I want a {drink}."},
{"key": "data.voice.korean.perfect.0", "text": "Daebak!", "src": "Daebak!"},
{"key": "data.voice.korean.perfect.1", "text": "Jinjja καλό!", "src": "Jinjja good!"},
{"key": "data.voice.korean.perfect.2", "text": "Choego!", "src": "Choego!"},
{"key": "data.voice.korean.praise.0", "text": "Daebak. Jinjja, είναι τέλειο.", "src": "Daebak. Jinjja, this is perfect."},
{"key": "data.voice.korean.praise.1", "text": "Choego. Το εννοώ.", "src": "Choego. I mean it."},
{"key": "data.voice.korean.praise.2", "text": "Ουάου. Το 'χεις μ' αυτό.", "src": "Wow. You are good at this."},
{"key": "data.voice.korean.sip.0", "text": "Jamkkanman, {advice_l}", "src": "Jamkkanman, {advice_l}"},
{"key": "data.voice.korean.sip.1", "text": "Εμ, {advice_l}", "src": "Um, {advice_l}"},
{"key": "data.voice.korean.sip.2", "text": "Gwenchana, αλλά {advice_l}", "src": "Gwenchana, but {advice_l}"},
{"key": "data.voice.korean.wrong.0", "text": "Aniyo, όχι.", "src": "Aniyo, no."},
{"key": "data.voice.korean.wrong.1", "text": "Αυτό είναι λάθος.", "src": "This is wrong."},
{"key": "data.voice.korean.wrong.2", "text": "Ε; Δεν είναι δικό μου.", "src": "Eh? Not mine."},
{"key": "data.voice.nordic.another.0", "text": "Άλλο ένα. Skål!", "src": "Another. Skål!"},
{"key": "data.voice.nordic.another.1", "text": "Ένα ακόμα.", "src": "One more."},
{"key": "data.voice.nordic.another.2", "text": "Πάλι, παρακαλώ.", "src": "Again, please."},
{"key": "data.voice.nordic.close.0", "text": "Καλό.", "src": "Fine."},
{"key": "data.voice.nordic.close.1", "text": "Εντάξει είναι.", "src": "It's okay."},
{"key": "data.voice.nordic.close.2", "text": "Αρκετά καλό.", "src": "Good enough."},
{"key": "data.voice.nordic.kicked.0", "text": "Εντάξει. Περίεργο, αλλά εντάξει.", "src": "Okay. Strange, but okay."},
{"key": "data.voice.nordic.kicked.1", "text": "Καλώς.", "src": "Fine."},
{"key": "data.voice.nordic.kicked.2", "text": "Χμ. Αντίο λοιπόν.", "src": "Hm. Goodbye then."},
{"key": "data.voice.nordic.leaving.0", "text": "Θα φύγω. Δεν πειράζει.", "src": "I'll go. It's fine."},
{"key": "data.voice.nordic.leaving.1", "text": "Πολλή ώρα. Αντίο.", "src": "Too long. Goodbye."},
{"key": "data.voice.nordic.leaving.2", "text": "Όχι. Φεύγω.", "src": "No. I'm leaving."},
{"key": "data.voice.nordic.order.0", "text": "{drink}. Ευχαριστώ.", "src": "A {drink}. Thanks."},
{"key": "data.voice.nordic.order.1", "text": "{drink}, παρακαλώ.", "src": "{drink}, please."},
{"key": "data.voice.nordic.order.2", "text": "{drink}. Χωρίς βιασύνη.", "src": "One {drink}. No rush."},
{"key": "data.voice.nordic.order.3", "text": "Θα πάρω {drink}.", "src": "I'll have the {drink}."},
{"key": "data.voice.nordic.perfect.0", "text": "Skål!", "src": "Skål!"},
{"key": "data.voice.nordic.perfect.1", "text": "Πολύ καλό.", "src": "Very good."},
{"key": "data.voice.nordic.perfect.2", "text": "Ναι. Καλό.", "src": "Yes. Good."},
{"key": "data.voice.nordic.praise.0", "text": "Είναι πολύ καλό. Δεν το λέω συχνά.", "src": "This is very good. I don't say that."},
{"key": "data.voice.nordic.praise.1", "text": "Skål. Σωστή δουλειά.", "src": "Skål. Properly done."},
{"key": "data.voice.nordic.praise.2", "text": "Καλό. Πραγματικά καλό.", "src": "Good. Really good."},
{"key": "data.voice.nordic.sip.0", "text": "Λοιπόν. {advice}", "src": "Well. {advice}"},
{"key": "data.voice.nordic.sip.1", "text": "Χμ. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.nordic.sip.2", "text": "Καλό, αλλά {advice_l}", "src": "Fine, but {advice_l}"},
{"key": "data.voice.nordic.wrong.0", "text": "Όχι. Λάθος.", "src": "No. Wrong one."},
{"key": "data.voice.nordic.wrong.1", "text": "Δεν είναι αυτό.", "src": "This is not it."},
{"key": "data.voice.nordic.wrong.2", "text": "Χμ. Δεν είναι δικό μου.", "src": "Hm. Not mine."},
{"key": "data.voice.southern.another.0", "text": "Βάλε μου άλλο ένα!", "src": "Pour me another!"},
{"key": "data.voice.southern.another.1", "text": "Άλλο ένα, sugar!", "src": "One more, sugar!"},
{"key": "data.voice.southern.another.2", "text": "Φέρ' τα, darlin'!", "src": "Keep 'em comin'!"},
{"key": "data.voice.southern.close.0", "text": "Εντάξει είναι.", "src": "That's alright."},
{"key": "data.voice.southern.close.1", "text": "Δίκαιο.", "src": "Fair enough."},
{"key": "data.voice.southern.close.2", "text": "Ε, θα κάνει.", "src": "Well, it'll do."},
{"key": "data.voice.southern.kicked.0", "text": "Ε, αυτό είναι σκέτη αγένεια.", "src": "Well, that's just rude."},
{"key": "data.voice.southern.kicked.1", "text": "Εντάξει λοιπόν. Να περάσεις καλά.", "src": "Alright then. Have a good one."},
{"key": "data.voice.southern.kicked.2", "text": "Για στάσου… καλά.", "src": "Now hold on… fine."},
{"key": "data.voice.southern.leaving.0", "text": "Ε, δεν έχω όλη τη νύχτα.", "src": "Well, I ain't got all night."},
{"key": "data.voice.southern.leaving.1", "text": "Λέω να πάω αλλού.", "src": "Reckon I'll drink elsewhere."},
{"key": "data.voice.southern.leaving.2", "text": "Y'all δεν βιάζεστε καθόλου, ε;", "src": "Y'all take your sweet time, don't you."},
{"key": "data.voice.southern.order.0", "text": "Λοιπόν, {drink} θα μου πήγαινε.", "src": "Well now, a {drink} would suit me."},
{"key": "data.voice.southern.order.1", "text": "{drink}, darlin', αν έχεις την καλοσύνη.", "src": "{drink}, darlin', if you please."},
{"key": "data.voice.southern.order.2", "text": "Λέω να πάρω {drink}.", "src": "Reckon I'll have a {drink}."},
{"key": "data.voice.southern.order.3", "text": "{drink}, sugar.", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "Τι ωραίο!", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "Lord, τι καλό!", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "Hot dang!", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "Για δες. Αυτό είναι ποτό όπως πρέπει.", "src": "Well, I'll be. That's a proper drink."},
{"key": "data.voice.southern.praise.1", "text": "Darlin', έχεις χάρισμα.", "src": "Darlin', you got a gift."},
{"key": "data.voice.southern.praise.2", "text": "Νομίζω βρήκα το νέο μου στέκι.", "src": "Reckon I found my new spot."},
{"key": "data.voice.southern.sip.0", "text": "Λοιπόν, {advice_l}", "src": "Now, {advice_l}"},
{"key": "data.voice.southern.sip.1", "text": "Sugar, {advice_l}", "src": "Sugar, {advice_l}"},
{"key": "data.voice.southern.sip.2", "text": "Να σου πω, {advice_l}", "src": "Tell you what, {advice_l}"},
{"key": "data.voice.southern.wrong.0", "text": "Δεν είναι δικό μου, hon.", "src": "Ain't mine, hon."},
{"key": "data.voice.southern.wrong.1", "text": "Και τι είναι τούτο;", "src": "Now what is this?"},
{"key": "data.voice.southern.wrong.2", "text": "Bless your heart.", "src": "Bless your heart."}
]}
