{"strings": [
{"key": "data.voice.aussie.another.0", "text": "Same again, mate!", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "Άλλο ένα, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "Άλλο ένα, legend!", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "Ναι, righto.", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "Όχι άσχημα, mate.", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "Θα κάνει.", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "Σοβαρά, mate;", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto. Δίκαιο.", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Nah, αυτό είναι βαρύ.", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto, περίμενα αρκετά.", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Nah, άσ' το. Φεύγω.", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "Cheers για το τίποτα, mate.", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "{drink}, mate.", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink}, παρακαλώ.", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "Θα πάρω {drink}.", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "{drink}, cheers.", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "Ripper!", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "Too easy!", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "Bloody καλό!", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "Bloody ripper, mate. Cheers.", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "Too easy. Ξέρεις τη δουλειά.", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "Το καλύτερο όλης της βραδιάς, ειλικρινά.", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "Κοίτα, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "No dramas, αλλά {advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Nah, mate.", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "Δεν είναι δικό μου, sorry.", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "Λάθος, mate.", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "Άλλη μια γύρα!", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "Τα ίδια!", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "Συνέχισε έτσι!", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "Ευχαριστώ.", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "Καλό είναι.", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "Κοντά έπεσες.", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "Σοβαρά; Καλά.", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "Κάνεις λάθος.", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "Ό,τι πεις. Κράτα το μαγαζί σου.", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "Άσ' το. Βαρέθηκα να περιμένω.", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "Δουλεύει κανείς απόψε;", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "Ωραία. Πάω αλλού.", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink}, παρακαλώ.", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "Θα πάρω {drink}.", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "{drink}, όταν βρεις ένα λεπτό.", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "Βάλε μου {drink}.", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "Τέλειο!", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "Αυτό είναι!", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "Ακριβώς!", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "Ούτε σταγόνα δεν θα άλλαζα.", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "Αυτό λέγεται ποτό.", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "Όποιος σε έμαθε, πες του ευχαριστώ.", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "Χμ. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice} Λέω τώρα.", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "Ειλικρινά; {advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "Δεν ζήτησα αυτό.", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "Λάθος ποτό.", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "Αυτό δεν είναι δικό μου.", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "Encore, παρακαλώ!", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "Άλλο ένα, oui!", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "Πάλι, merci!", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ca va.", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "Καλό είναι.", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon, εντάξει.", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "Quoi; Αλήθεια;", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Bon. Au revoir.", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule.", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non. Περίμενα αρκετά.", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis. Φεύγω.", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "Au revoir, λοιπόν.", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "{drink}, s'il vous plait.", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "{drink}, παρακαλώ.", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "{drink}, merci.", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "Θα πάρω {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "Parfait!", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "Voila, τέλειο!", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "Magnifique!", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait. Καμία απολύτως παρατήρηση.", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voila. Κάποιος εδώ ξέρει να φτιάχνει ποτό.", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique. Αλήθεια.", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Ecoute, {advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon, {advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors, {advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non.", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "Δεν είναι αυτό.", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon, λάθος.", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "Mou ippai!", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "Άλλο ένα, kanpai!", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "Πάλι, onegai!", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Hai, εντάξει.", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa.", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "Όχι άσχημα, ne.", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "Eh! Αλήθεια;", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi. Εντάξει, φεύγω.", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta. Sayonara.", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen, δεν μπορώ να περιμένω άλλο.", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii. Φεύγω.", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai. Αντίο.", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen, {drink}.", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "{drink}, onegai.", "src": "One {drink}, onegai."}
]}
