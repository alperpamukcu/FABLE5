{"strings": [
{"key": "data.voice.african.another.0", "text": "Φέρε κι άλλο!", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "Άλλο ένα, abeg!", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "Πάλι, φίλε μου!", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "Εντάξει είναι.", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "No wahala.", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "Οκέι, ευχαριστώ.", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "Ah ah! Σοβαρά;", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala. Πάω.", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "Φίλε μου, αυτό δεν είναι ωραίο.", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah ah. Περίμενα αρκετά.", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala. Φεύγω τώρα.", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "Άσε με να πηγαίνω, φίλε μου.", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "{drink}, παρακαλώ.", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "Φίλε μου, {drink}.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Θα πάρω {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "{drink}, abeg.", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "Ah, γλυκό!", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "Correct!", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "Αυτό είναι ωραίο!", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, αυτό είναι correct. Ευχαριστώ.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "No wahala καθόλου. Πολύ ωραίο.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "Φίλε μου, το ξέρεις το βιβλίο.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "Φίλε μου, {advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg, {advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "Εντάξει είναι, αλλά {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah, όχι.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "Δεν είναι αυτό.", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "Φίλε μου, όχι.", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "Same again, mate!", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "Άλλο ένα, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "Άντε, άλλο ένα!", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "Όχι άσχημα.", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Ta, καλό είναι.", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "Εντάξει, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Charming. Τελείως charming.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "Ωραία. Cheers για το τίποτα.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "Πλάκα μου κάνεις.", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Εντάξει. Περίμενα αρκετά.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "Άσ' το. Την κάνω.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Λίγο rubbish αυτό. Γεια.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "{drink}, mate, όταν βρεις λεπτό.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, παρακαλώ. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "Άντε λοιπόν, {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "Θα πάρω {drink}, ta.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "Lovely!", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "Cheers, mate!", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "Proper καλό!", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Blimey. Αυτό είναι όντως lovely.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Το έκανες όπως πρέπει.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Bloody καλό αυτό.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "Ένα πραγματάκι: {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Κοίτα, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Λίγο στραβό αυτό.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Εμ, δεν είναι δικό μου.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "Δεν ζήτησα αυτό.", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "Άλλο ένα, yaar!", "src": "One more, yaar!"},
{"key": "data.voice.desi.another.1", "text": "Aur ek!", "src": "Aur ek!"},
{"key": "data.voice.desi.another.2", "text": "Πάλι, παρακαλώ!", "src": "Again, please!"},
{"key": "data.voice.desi.close.0", "text": "Theek hai.", "src": "Theek hai."},
{"key": "data.voice.desi.close.1", "text": "Εντάξει είναι, na.", "src": "It is okay, na."},
{"key": "data.voice.desi.close.2", "text": "Chalega.", "src": "Chalega."},
{"key": "data.voice.desi.kicked.0", "text": "Kya; Σοβαρά;", "src": "Kya? Seriously?"},
{"key": "data.voice.desi.kicked.1", "text": "Arre. Εντάξει, καλά.", "src": "Arre. Okay, fine."},
{"key": "data.voice.desi.kicked.2", "text": "Chalo. Φεύγω.", "src": "Chalo. I go."},
{"key": "data.voice.desi.leaving.0", "text": "Arre yaar. Πολλή αναμονή.", "src": "Arre yaar. Too long."},
{"key": "data.voice.desi.leaving.1", "text": "Chalo, πάω.", "src": "Chalo, I am going."},
{"key": "data.voice.desi.leaving.2", "text": "Bas. Φτάνει.", "src": "Bas. Enough."},
{"key": "data.voice.desi.order.0", "text": "{drink}, παρακαλώ.", "src": "One {drink}, please."},
{"key": "data.voice.desi.order.1", "text": "{drink}, yaar.", "src": "A {drink}, yaar."},
{"key": "data.voice.desi.order.2", "text": "Θα πάρω {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.desi.order.3", "text": "{drink}, na;", "src": "{drink}, na?"},
{"key": "data.voice.desi.perfect.0", "text": "Wah, τέλειο!", "src": "Wah, perfect!"},
{"key": "data.voice.desi.perfect.1", "text": "Ekdum first class!", "src": "Ekdum first class!"},
{"key": "data.voice.desi.perfect.2", "text": "Bahut badhiya!", "src": "Bahut badhiya!"},
{"key": "data.voice.desi.praise.0", "text": "Wah. Ekdum τέλειο, yaar.", "src": "Wah. Ekdum perfect, yaar."},
{"key": "data.voice.desi.praise.1", "text": "Bahut badhiya. Αλήθεια.", "src": "Bahut badhiya. Really."},
{"key": "data.voice.desi.praise.2", "text": "First class. Θα ξανάρθω.", "src": "First class. I am coming back."},
{"key": "data.voice.desi.sip.0", "text": "Arre, {advice_l}", "src": "Arre, {advice_l}"},
{"key": "data.voice.desi.sip.1", "text": "Yaar, {advice_l}", "src": "Yaar, {advice_l}"},
{"key": "data.voice.desi.sip.2", "text": "Theek hai, αλλά {advice_l}", "src": "Theek hai, but {advice_l}"},
{"key": "data.voice.desi.wrong.0", "text": "Arre, όχι.", "src": "Arre, no."},
{"key": "data.voice.desi.wrong.1", "text": "Δεν είναι δικό μου.", "src": "This is not mine."},
{"key": "data.voice.desi.wrong.2", "text": "Nahi, λάθος.", "src": "Nahi, wrong one."},
{"key": "data.voice.german.another.0", "text": "Noch eins!", "src": "Noch eins!"},
{"key": "data.voice.german.another.1", "text": "Άλλο ένα, bitte!", "src": "Another, bitte!"},
{"key": "data.voice.german.another.2", "text": "Πάλι, παρακαλώ!", "src": "Again, please!"},
{"key": "data.voice.german.close.0", "text": "Ja, εντάξει.", "src": "Ja, okay."},
{"key": "data.voice.german.close.1", "text": "Αποδεκτό.", "src": "Acceptable."},
{"key": "data.voice.german.close.2", "text": "Καλό είναι.", "src": "It is fine."},
{"key": "data.voice.german.kicked.0", "text": "Αυτό είναι παράλογο.", "src": "This is absurd."},
{"key": "data.voice.german.kicked.1", "text": "Καλώς. Δεν θα ξανάρθω.", "src": "Fine. I will not return."},
{"key": "data.voice.german.kicked.2", "text": "Ja, ja. Φεύγω.", "src": "Ja, ja. I am going."},
{"key": "data.voice.german.leaving.0", "text": "Αυτό δεν είναι αποδεκτό. Φεύγω.", "src": "This is not acceptable. I am leaving."},
{"key": "data.voice.german.leaving.1", "text": "Nein. Περίμενα αρκετά.", "src": "Nein. I have waited enough."},
{"key": "data.voice.german.leaving.2", "text": "Unglaublich. Αντίο.", "src": "Unglaublich. Goodbye."},
{"key": "data.voice.german.order.0", "text": "{drink}, παρακαλώ. Σωστά φτιαγμένο.", "src": "A {drink}, please. Correctly made."},
{"key": "data.voice.german.order.1", "text": "{drink}. Ευχαριστώ.", "src": "{drink}. Thank you."}
]}
