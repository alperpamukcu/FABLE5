{"strings": [
{"key": "data.voice.aussie.another.0", "text": "Samma igen, mate!", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "En till, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "En till, legend!", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "Yeah, righto.", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "Inte illa, mate.", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "Det duger.", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "Seriöst, mate?", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto. Fair enough.", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Nah, det var tufft.", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto, nu har jag väntat länge nog.", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Nah, strunt i det här. Jag drar.", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "Cheers för ingenting, mate.", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "{drink}, mate.", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink}, tack.", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "Jag tar {drink}.", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "{drink}, cheers.", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "Ripper!", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "Too easy!", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "Jäkligt bra!", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "Bloody ripper, mate. Cheers.", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "Too easy. Du kan ditt.", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "Kvällens bästa, ärligt talat.", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "Hör här, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "No dramas, men {advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Nah, mate.", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "Inte min, sorry.", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "Fel drink, mate.", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "En runda till!", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "Samma igen!", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "Kör på, en till!", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "Tack.", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "Det duger.", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "Nära nog.", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "Seriöst? Okej.", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "Du gör ett misstag.", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "Strunt samma. Behåll din bar.", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "Glöm det. Jag orkar inte vänta mer.", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "Jobbar någon här i kväll?", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "Okej. Jag dricker någon annanstans.", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink}, tack.", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "Jag tar {drink}.", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "{drink}, när du har en sekund.", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "Det får bli {drink}.", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "Perfekt!", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "Det är den!", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "Mitt i prick!", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "Inget jag skulle ändra.", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "Det där är en drink.", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "Vem som än lärde dig, tacka dem.", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice} Bara så du vet.", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "Ärligt? {advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "Inte det jag bad om.", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "Fel drink.", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "Den är inte min.", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "Encore, tack!", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "En till, oui!", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "Igen, merci!", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ça va.", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "Det går bra.", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon, okej.", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "Quoi? Verkligen?", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Bon. Au revoir.", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule.", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non. Jag har väntat nog.", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis. Jag går.", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "Au revoir, då.", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "{drink}, s'il vous plaît.", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "{drink}, tack.", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "{drink}, merci.", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "Jag tar {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "Parfait!", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "Voilà, perfekt!", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "Magnifique!", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait. Jag har inga anmärkningar alls.", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voilà. Här finns någon som kan hälla.", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique. Verkligen.", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Écoute, {advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon, {advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors, {advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non.", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "Det här är inte den.", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon, fel drink.", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "Mou ippai!", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "En till, kanpai!", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "Igen, onegai!", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Hai, okej.", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa.", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "Inte illa, ne.", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "Eh?! Verkligen?", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi. Okej, jag går.", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta. Sayonara.", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen, jag kan inte vänta längre.", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii. Jag går.", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai. Hej då.", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen, {drink}.", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "{drink}, onegai.", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink}, tack. Arigatou.", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto… {drink}.", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "Oishii!", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "Sugoi, perfekt!", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "Kanpai!", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii. Verkligen, den här är rätt.", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "Sugoi. Du är ett proffs, ne.", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "Kanpai. Det här är perfekt.", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "Etto, {advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "Ne, {advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "Sumimasen, men {advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "Chotto… nej.", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "Eh? Inte den här.", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "Chigau, förlåt.", "src": "Chigau, sorry."},
{"key": "data.voice.midwest.another.0", "text": "En till, är du snäll!", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "En till, thanks!", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "Samma igen, ope!", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "Oh, det är fine.", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "Visst, tack.", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "Inte illa alls.", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "Oh. Jaha. Okej då.", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "Ope, förlåt… jag går.", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "Det var lite mycket, men okej.", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "Oh gosh, jag kan verkligen inte vänta längre.", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "Nja, jag borde nog ge mig av.", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "Förlåt, men jag sticker.", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "Kan jag få {drink}? Thanks a bunch.", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "{drink}, om det inte är besvärligt.", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "Oh, bara {drink} till mig.", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink}, tack. När det passar.", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "Oh, real nice!", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "You betcha!", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "Oh jeez, ja!", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "Oh my gosh, den är ju helt ljuvlig.", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "Real nice. Min moster skulle älska det här stället.", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "Nå, den satt fint.", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "Oh, {advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "Bara så du vet, {advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "Ingen stor grej, men {advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "Ope. Fel drink.", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "Oh, den är inte min.", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "Förlåt, nej. Inte den här.", "src": "Sorry, no. Not this."},
{"key": "data.voice.polish.another.0", "text": "Jeszcze raz!", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "En till, proszę!", "src": "Another, proszę!"},
{"key": "data.voice.polish.another.2", "text": "Kör en till!", "src": "One more!"},
{"key": "data.voice.polish.close.0", "text": "Dobrze.", "src": "Dobrze."},
{"key": "data.voice.polish.close.1", "text": "Okej.", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "Det går bra, tack.", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "Serio? Okej.", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "Visst. Do widzenia.", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "Co? Okej, jag går.", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "Det räcker. Jag går.", "src": "Enough. I'm going."},
{"key": "data.voice.polish.leaving.1", "text": "Nie, nie. För länge.", "src": "Nie, nie. Too long."},
{"key": "data.voice.polish.leaving.2", "text": "Do widzenia.", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "{drink}, proszę.", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "{drink}, tack.", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "{drink}. Tack ska du ha.", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "Dobrze, {drink}.", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "Na zdrowie!", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "Świetnie!", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "Mycket bra!", "src": "Very good!"},
{"key": "data.voice.polish.praise.0", "text": "Na zdrowie. Det här är en riktig drink.", "src": "Na zdrowie. This is a real drink."},
{"key": "data.voice.polish.praise.1", "text": "Świetnie. Som hemma.", "src": "Świetnie. Like at home."},
{"key": "data.voice.polish.praise.2", "text": "Dobrze. Väldigt, väldigt bra.", "src": "Dobrze. Very, very good."},
{"key": "data.voice.polish.sip.0", "text": "Dobrze, men {advice_l}", "src": "Dobrze, but {advice_l}"},
{"key": "data.voice.polish.sip.1", "text": "Hör här, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.polish.sip.2", "text": "Hm, {advice_l}", "src": "Hm, {advice_l}"},
{"key": "data.voice.polish.wrong.0", "text": "Nie. Fel drink.", "src": "Nie. Wrong one."},
{"key": "data.voice.polish.wrong.1", "text": "Det här är inte min.", "src": "This is not mine."},
{"key": "data.voice.polish.wrong.2", "text": "Co to jest?", "src": "Co to jest?"},
{"key": "data.voice.turkish.another.0", "text": "Bir daha!", "src": "Bir daha!"},
{"key": "data.voice.turkish.another.1", "text": "En till, abi!", "src": "Another, abi!"},
{"key": "data.voice.turkish.another.2", "text": "Igen, eyvallah!", "src": "Again, eyvallah!"},
{"key": "data.voice.turkish.close.0", "text": "Tamam.", "src": "Tamam."},
{"key": "data.voice.turkish.close.1", "text": "İdare eder.", "src": "İdare eder."},
{"key": "data.voice.turkish.close.2", "text": "Okej, det går.", "src": "Okay, fine."},
{"key": "data.voice.turkish.kicked.0", "text": "Ciddi misin? Okej.", "src": "Ciddi misin? Okay."},
{"key": "data.voice.turkish.kicked.1", "text": "Abi, verkligen? Visst.", "src": "Abi, really? Fine."},
{"key": "data.voice.turkish.kicked.2", "text": "Yok, yok. Jag går.", "src": "Yok, yok. I'm going."},
{"key": "data.voice.turkish.leaving.0", "text": "Yok, jag väntar inte längre.", "src": "Yok, I'm not waiting anymore."},
{"key": "data.voice.turkish.leaving.1", "text": "Abi, jobbar ingen här?", "src": "Abi, is nobody working here?"},
{"key": "data.voice.turkish.leaving.2", "text": "Tamam, hoşça kal.", "src": "Tamam, hoşça kal."},
{"key": "data.voice.turkish.order.0", "text": "Abi, {drink}.", "src": "Abi, a {drink}."},
{"key": "data.voice.turkish.order.1", "text": "{drink}, eyvallah.", "src": "One {drink}, eyvallah."},
{"key": "data.voice.turkish.order.2", "text": "{drink}, canım, när du hinner.", "src": "{drink}, canım, when you can."},
{"key": "data.voice.turkish.order.3", "text": "Bir {drink}, tack.", "src": "Bir {drink}, please."},
{"key": "data.voice.turkish.perfect.0", "text": "Eyvallah!", "src": "Eyvallah!"},
{"key": "data.voice.turkish.perfect.1", "text": "Harika!", "src": "Harika!"},
{"key": "data.voice.turkish.perfect.2", "text": "Süper, abi!", "src": "Süper, abi!"},
{"key": "data.voice.turkish.praise.0", "text": "Eyvallah. Så ska det göras.", "src": "Eyvallah. This is how it's done."},
{"key": "data.voice.turkish.praise.1", "text": "Abi, jag lyfter på hatten. Harika.", "src": "Abi, my hat is off. Harika."},
{"key": "data.voice.turkish.praise.2", "text": "Tamam, du kan ditt jobb.", "src": "Tamam, you know your work."},
{"key": "data.voice.turkish.sip.0", "text": "Abi, {advice_l}", "src": "Abi, {advice_l}"},
{"key": "data.voice.turkish.sip.1", "text": "Bak, {advice_l}", "src": "Bak, {advice_l}"},
{"key": "data.voice.turkish.sip.2", "text": "Tamam ama, {advice_l}", "src": "Tamam ama, {advice_l}"},
{"key": "data.voice.turkish.wrong.0", "text": "Yok, inte den här.", "src": "Yok, not this."},
{"key": "data.voice.turkish.wrong.1", "text": "Abi, fel drink.", "src": "Abi, wrong one."},
{"key": "data.voice.turkish.wrong.2", "text": "Bu ne şimdi?", "src": "Bu ne şimdi?"}
]}
