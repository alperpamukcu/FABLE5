{"strings": [
{"key": "data.voice.african.another.0", "text": "Ta hit en till!", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "En till, abeg!", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "Igen, min vän!", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "Det går bra.", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "No wahala.", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "Okej, tack.", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "Ah ah! Menar du allvar?", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala. Jag går.", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "Min vän, det här är inte snällt.", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah ah. Nu har jag väntat nog.", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala. Jag drar.", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "Låt mig gå, min vän.", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "{drink}, tack.", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "Min vän, {drink} till mig.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Jag tar {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "{drink}, abeg.", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "Ah, gott!", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "Helt rätt!", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "Den här är fin!", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, den här är helt rätt. Tack ska du ha.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "No wahala alls. Riktigt fint.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "Min vän, du kan verkligen det här.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "Min vän, {advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg, {advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "Det går bra, men {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah, nej.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "Det här är inte den.", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "Min vän, nej.", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "Samma igen, mate!", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "En till, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "Kör, en till!", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "Inte illa.", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Ta, det duger.", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "Alright, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Charmigt. Helt charmigt.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "Jaha. Nå. Tack för ingenting.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "You're having a laugh.", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Nej. Nu har jag väntat länge nog.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "Äh, strunt i det. Jag drar.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Lite rubbish, det här. Hej då.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "{drink}, mate, när du har en stund.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, tack. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "Okej då, {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "Jag tar {drink}, ta.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "Lovely!", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "Cheers, mate!", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "Riktigt bra!", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Blimey. Den är faktiskt lovely.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Det där gjorde du ordentligt.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Förbaskat bra, det där.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "En grej bara: {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Hör här, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Lite fel, det där.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Öh, inte min.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "Inte det jag bad om.", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "En till, yaar!", "src": "One more, yaar!"},
{"key": "data.voice.desi.another.1", "text": "Aur ek!", "src": "Aur ek!"},
{"key": "data.voice.desi.another.2", "text": "Igen, tack!", "src": "Again, please!"},
{"key": "data.voice.desi.close.0", "text": "Theek hai.", "src": "Theek hai."},
{"key": "data.voice.desi.close.1", "text": "Det är okej, na.", "src": "It is okay, na."},
{"key": "data.voice.desi.close.2", "text": "Chalega.", "src": "Chalega."},
{"key": "data.voice.desi.kicked.0", "text": "Kya? Seriöst?", "src": "Kya? Seriously?"},
{"key": "data.voice.desi.kicked.1", "text": "Arre. Okej, visst.", "src": "Arre. Okay, fine."},
{"key": "data.voice.desi.kicked.2", "text": "Chalo. Jag går.", "src": "Chalo. I go."},
{"key": "data.voice.desi.leaving.0", "text": "Arre yaar. För länge.", "src": "Arre yaar. Too long."},
{"key": "data.voice.desi.leaving.1", "text": "Chalo, jag går nu.", "src": "Chalo, I am going."},
{"key": "data.voice.desi.leaving.2", "text": "Bas. Det räcker.", "src": "Bas. Enough."},
{"key": "data.voice.desi.order.0", "text": "{drink}, tack.", "src": "One {drink}, please."},
{"key": "data.voice.desi.order.1", "text": "{drink}, yaar.", "src": "A {drink}, yaar."},
{"key": "data.voice.desi.order.2", "text": "Jag tar {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.desi.order.3", "text": "{drink}, na?", "src": "{drink}, na?"},
{"key": "data.voice.desi.perfect.0", "text": "Wah, perfekt!", "src": "Wah, perfect!"},
{"key": "data.voice.desi.perfect.1", "text": "Ekdum first class!", "src": "Ekdum first class!"},
{"key": "data.voice.desi.perfect.2", "text": "Bahut badhiya!", "src": "Bahut badhiya!"},
{"key": "data.voice.desi.praise.0", "text": "Wah. Ekdum perfekt, yaar.", "src": "Wah. Ekdum perfect, yaar."},
{"key": "data.voice.desi.praise.1", "text": "Bahut badhiya. Verkligen.", "src": "Bahut badhiya. Really."},
{"key": "data.voice.desi.praise.2", "text": "First class. Jag kommer tillbaka.", "src": "First class. I am coming back."},
{"key": "data.voice.desi.sip.0", "text": "Arre, {advice_l}", "src": "Arre, {advice_l}"},
{"key": "data.voice.desi.sip.1", "text": "Yaar, {advice_l}", "src": "Yaar, {advice_l}"},
{"key": "data.voice.desi.sip.2", "text": "Theek hai, men {advice_l}", "src": "Theek hai, but {advice_l}"},
{"key": "data.voice.desi.wrong.0", "text": "Arre, nej.", "src": "Arre, no."},
{"key": "data.voice.desi.wrong.1", "text": "Det här är inte min.", "src": "This is not mine."},
{"key": "data.voice.desi.wrong.2", "text": "Nahi, fel drink.", "src": "Nahi, wrong one."},
{"key": "data.voice.german.another.0", "text": "Noch eins!", "src": "Noch eins!"},
{"key": "data.voice.german.another.1", "text": "En till, bitte!", "src": "Another, bitte!"},
{"key": "data.voice.german.another.2", "text": "Igen, tack!", "src": "Again, please!"},
{"key": "data.voice.german.close.0", "text": "Ja, okej.", "src": "Ja, okay."},
{"key": "data.voice.german.close.1", "text": "Godtagbart.", "src": "Acceptable."},
{"key": "data.voice.german.close.2", "text": "Det duger.", "src": "It is fine."},
{"key": "data.voice.german.kicked.0", "text": "Det här är absurt.", "src": "This is absurd."},
{"key": "data.voice.german.kicked.1", "text": "Gott. Jag kommer inte tillbaka.", "src": "Fine. I will not return."},
{"key": "data.voice.german.kicked.2", "text": "Ja, ja. Jag går.", "src": "Ja, ja. I am going."},
{"key": "data.voice.german.leaving.0", "text": "Det här är inte acceptabelt. Jag går.", "src": "This is not acceptable. I am leaving."},
{"key": "data.voice.german.leaving.1", "text": "Nein. Jag har väntat nog.", "src": "Nein. I have waited enough."},
{"key": "data.voice.german.leaving.2", "text": "Unglaublich. Adjö.", "src": "Unglaublich. Goodbye."},
{"key": "data.voice.german.order.0", "text": "{drink}, tack. Korrekt gjord.", "src": "A {drink}, please. Correctly made."},
{"key": "data.voice.german.order.1", "text": "{drink}. Danke.", "src": "{drink}. Thank you."},
{"key": "data.voice.german.order.2", "text": "{drink}, bitte.", "src": "One {drink}, bitte."},
{"key": "data.voice.german.order.3", "text": "Jag skulle vilja ha {drink}.", "src": "I would like a {drink}."},
{"key": "data.voice.german.perfect.0", "text": "Genau!", "src": "Genau!"},
{"key": "data.voice.german.perfect.1", "text": "Sehr gut!", "src": "Sehr gut!"},
{"key": "data.voice.german.perfect.2", "text": "Wunderbar!", "src": "Wunderbar!"},
{"key": "data.voice.german.praise.0", "text": "Ja. Det här är exakt rätt.", "src": "Ja. This is exactly right."},
{"key": "data.voice.german.praise.1", "text": "Precist. Jag respekterar precision.", "src": "Precise. I respect precision."},
{"key": "data.voice.german.praise.2", "text": "Sehr gut. Inga anmärkningar.", "src": "Sehr gut. No notes."},
{"key": "data.voice.german.sip.0", "text": "Genau, men {advice_l}", "src": "Genau, but {advice_l}"},
{"key": "data.voice.german.sip.1", "text": "En anmärkning: {advice_l}", "src": "One remark: {advice_l}"},
{"key": "data.voice.german.sip.2", "text": "Ja, {advice_l}", "src": "Ja, {advice_l}"},
{"key": "data.voice.german.wrong.0", "text": "Nein. Inte den här.", "src": "Nein. Not this."},
{"key": "data.voice.german.wrong.1", "text": "Det här är felaktigt.", "src": "This is incorrect."},
{"key": "data.voice.german.wrong.2", "text": "Fel drink.", "src": "Wrong drink."},
{"key": "data.voice.korean.another.0", "text": "Han jan deo!", "src": "Han jan deo!"},
{"key": "data.voice.korean.another.1", "text": "En till!", "src": "One more!"},
{"key": "data.voice.korean.another.2", "text": "Igen, juseyo!", "src": "Again, juseyo!"},
{"key": "data.voice.korean.close.0", "text": "Gwenchana.", "src": "Gwenchana."},
{"key": "data.voice.korean.close.1", "text": "Det är okej.", "src": "It is okay."},
{"key": "data.voice.korean.close.2", "text": "Nappeuji anha.", "src": "Nappeuji anha."},
{"key": "data.voice.korean.kicked.0", "text": "Jinjja? Wow.", "src": "Jinjja? Wow."},
{"key": "data.voice.korean.kicked.1", "text": "Aish. Okej då.", "src": "Aish. Fine."},
{"key": "data.voice.korean.kicked.2", "text": "Annyeong, då.", "src": "Annyeong, then."},
{"key": "data.voice.korean.leaving.0", "text": "Aish. För länge.", "src": "Aish. Too long."},
{"key": "data.voice.korean.leaving.1", "text": "Jag går. Annyeong.", "src": "I am going. Annyeong."},
{"key": "data.voice.korean.leaving.2", "text": "Mot chamgesseo.", "src": "Mot chamgesseo."},
{"key": "data.voice.korean.order.0", "text": "{drink}, juseyo.", "src": "{drink}, juseyo."},
{"key": "data.voice.korean.order.1", "text": "{drink}, tack.", "src": "One {drink}, please."},
{"key": "data.voice.korean.order.2", "text": "{drink} till mig.", "src": "A {drink} for me."},
{"key": "data.voice.korean.order.3", "text": "Jag vill ha {drink}.", "src": "I want a {drink}."},
{"key": "data.voice.korean.perfect.0", "text": "Daebak!", "src": "Daebak!"},
{"key": "data.voice.korean.perfect.1", "text": "Jinjja gott!", "src": "Jinjja good!"},
{"key": "data.voice.korean.perfect.2", "text": "Choego!", "src": "Choego!"},
{"key": "data.voice.korean.praise.0", "text": "Daebak. Jinjja, den är perfekt.", "src": "Daebak. Jinjja, this is perfect."},
{"key": "data.voice.korean.praise.1", "text": "Choego. Jag menar det.", "src": "Choego. I mean it."},
{"key": "data.voice.korean.praise.2", "text": "Wow. Du är duktig på det här.", "src": "Wow. You are good at this."},
{"key": "data.voice.korean.sip.0", "text": "Jamkkanman, {advice_l}", "src": "Jamkkanman, {advice_l}"},
{"key": "data.voice.korean.sip.1", "text": "Öh, {advice_l}", "src": "Um, {advice_l}"},
{"key": "data.voice.korean.sip.2", "text": "Gwenchana, men {advice_l}", "src": "Gwenchana, but {advice_l}"},
{"key": "data.voice.korean.wrong.0", "text": "Aniyo, nej.", "src": "Aniyo, no."},
{"key": "data.voice.korean.wrong.1", "text": "Det här är fel.", "src": "This is wrong."},
{"key": "data.voice.korean.wrong.2", "text": "Eh? Inte min.", "src": "Eh? Not mine."},
{"key": "data.voice.nordic.another.0", "text": "En till. Skål!", "src": "Another. Skål!"},
{"key": "data.voice.nordic.another.1", "text": "Kör en till.", "src": "One more."},
{"key": "data.voice.nordic.another.2", "text": "Samma igen, tack.", "src": "Again, please."},
{"key": "data.voice.nordic.close.0", "text": "Det funkar.", "src": "Fine."},
{"key": "data.voice.nordic.close.1", "text": "Helt okej.", "src": "It's okay."},
{"key": "data.voice.nordic.close.2", "text": "Duger gott.", "src": "Good enough."},
{"key": "data.voice.nordic.kicked.0", "text": "Okej. Konstigt, men okej.", "src": "Okay. Strange, but okay."},
{"key": "data.voice.nordic.kicked.1", "text": "Jaha.", "src": "Fine."},
{"key": "data.voice.nordic.kicked.2", "text": "Hm. Hej då, då.", "src": "Hm. Goodbye then."},
{"key": "data.voice.nordic.leaving.0", "text": "Jag drar. Det är lugnt.", "src": "I'll go. It's fine."},
{"key": "data.voice.nordic.leaving.1", "text": "Det tar för lång tid. Hej då.", "src": "Too long. Goodbye."},
{"key": "data.voice.nordic.leaving.2", "text": "Nej. Jag går nu.", "src": "No. I'm leaving."},
{"key": "data.voice.nordic.order.0", "text": "{drink}. Tack.", "src": "A {drink}. Thanks."},
{"key": "data.voice.nordic.order.1", "text": "{drink}, är du snäll.", "src": "{drink}, please."},
{"key": "data.voice.nordic.order.2", "text": "{drink}. Ingen stress.", "src": "One {drink}. No rush."},
{"key": "data.voice.nordic.order.3", "text": "Jag tar {drink}.", "src": "I'll have the {drink}."},
{"key": "data.voice.nordic.perfect.0", "text": "Skål!", "src": "Skål!"},
{"key": "data.voice.nordic.perfect.1", "text": "Riktigt bra.", "src": "Very good."},
{"key": "data.voice.nordic.perfect.2", "text": "Ja. Gott.", "src": "Yes. Good."},
{"key": "data.voice.nordic.praise.0", "text": "Det här är riktigt gott. Det säger jag inte ofta.", "src": "This is very good. I don't say that."},
{"key": "data.voice.nordic.praise.1", "text": "Skål. Snyggt gjort.", "src": "Skål. Properly done."},
{"key": "data.voice.nordic.praise.2", "text": "Gott. Väldigt gott.", "src": "Good. Really good."},
{"key": "data.voice.nordic.sip.0", "text": "Tja. {advice}", "src": "Well. {advice}"},
{"key": "data.voice.nordic.sip.1", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.nordic.sip.2", "text": "Okej, men {advice_l}", "src": "Fine, but {advice_l}"},
{"key": "data.voice.nordic.wrong.0", "text": "Nej. Fel drink.", "src": "No. Wrong one."},
{"key": "data.voice.nordic.wrong.1", "text": "Det här är inte den.", "src": "This is not it."},
{"key": "data.voice.nordic.wrong.2", "text": "Hm. Inte min.", "src": "Hm. Not mine."},
{"key": "data.voice.southern.another.0", "text": "Häll upp en till!", "src": "Pour me another!"},
{"key": "data.voice.southern.another.1", "text": "En till, sugar!", "src": "One more, sugar!"},
{"key": "data.voice.southern.another.2", "text": "Keep 'em comin'!", "src": "Keep 'em comin'!"},
{"key": "data.voice.southern.close.0", "text": "Det är alright.", "src": "That's alright."},
{"key": "data.voice.southern.close.1", "text": "Fair enough.", "src": "Fair enough."},
{"key": "data.voice.southern.close.2", "text": "Tja, det duger.", "src": "Well, it'll do."},
{"key": "data.voice.southern.kicked.0", "text": "Well, det var bara oförskämt.", "src": "Well, that's just rude."},
{"key": "data.voice.southern.kicked.1", "text": "Alright då. Ha det gott.", "src": "Alright then. Have a good one."},
{"key": "data.voice.southern.kicked.2", "text": "Nu vänta lite… okej då.", "src": "Now hold on… fine."},
{"key": "data.voice.southern.leaving.0", "text": "Well, jag har inte hela natten på mig.", "src": "Well, I ain't got all night."},
{"key": "data.voice.southern.leaving.1", "text": "Reckon jag dricker nån annanstans.", "src": "Reckon I'll drink elsewhere."},
{"key": "data.voice.southern.leaving.2", "text": "Y'all tar verkligen god tid på er, va.", "src": "Y'all take your sweet time, don't you."},
{"key": "data.voice.southern.order.0", "text": "Well now, {drink} skulle passa mig.", "src": "Well now, a {drink} would suit me."},
{"key": "data.voice.southern.order.1", "text": "{drink}, darlin', om du vill vara snäll.", "src": "{drink}, darlin', if you please."},
{"key": "data.voice.southern.order.2", "text": "Reckon jag tar {drink}.", "src": "Reckon I'll have a {drink}."},
{"key": "data.voice.southern.order.3", "text": "{drink}, sugar.", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "Ain't that fine!", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "Herregud, så gott!", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "Hot dang!", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "Well, I'll be. Det där är en riktig drink.", "src": "Well, I'll be. That's a proper drink."},
{"key": "data.voice.southern.praise.1", "text": "Darlin', du har en gåva.", "src": "Darlin', you got a gift."},
{"key": "data.voice.southern.praise.2", "text": "Reckon jag har hittat mitt nya ställe.", "src": "Reckon I found my new spot."},
{"key": "data.voice.southern.sip.0", "text": "Nå, {advice_l}", "src": "Now, {advice_l}"},
{"key": "data.voice.southern.sip.1", "text": "Sugar, {advice_l}", "src": "Sugar, {advice_l}"},
{"key": "data.voice.southern.sip.2", "text": "Vet du vad, {advice_l}", "src": "Tell you what, {advice_l}"},
{"key": "data.voice.southern.wrong.0", "text": "Inte min, hon.", "src": "Ain't mine, hon."},
{"key": "data.voice.southern.wrong.1", "text": "Vad är nu det här?", "src": "Now what is this?"},
{"key": "data.voice.southern.wrong.2", "text": "Bless your heart.", "src": "Bless your heart."}
]}
