{"strings": [
{"key": "data.voice.arabic.another.0", "text": "Kaman wahad!", "src": "Kaman wahad!"},
{"key": "data.voice.arabic.another.1", "text": "En till, yalla!", "src": "One more, yalla!"},
{"key": "data.voice.arabic.another.2", "text": "Igen, habibi!", "src": "Again, habibi!"},
{"key": "data.voice.arabic.close.0", "text": "Maashi.", "src": "Maashi."},
{"key": "data.voice.arabic.close.1", "text": "Det är okej.", "src": "It is okay."},
{"key": "data.voice.arabic.close.2", "text": "Tamam, shukran.", "src": "Tamam, shukran."},
{"key": "data.voice.arabic.kicked.0", "text": "Shu? Seriöst?", "src": "Shu? Seriously?"},
{"key": "data.voice.arabic.kicked.1", "text": "Khalas. Okej då.", "src": "Khalas. Fine."},
{"key": "data.voice.arabic.kicked.2", "text": "Yalla. Jag går.", "src": "Yalla. I go."},
{"key": "data.voice.arabic.leaving.0", "text": "Khalas. Jag går nu.", "src": "Khalas. I am going."},
{"key": "data.voice.arabic.leaving.1", "text": "Yalla, nog med väntan.", "src": "Yalla, enough waiting."},
{"key": "data.voice.arabic.leaving.2", "text": "Maa salama.", "src": "Maa salama."},
{"key": "data.voice.arabic.order.0", "text": "{drink}, tack.", "src": "A {drink}, please."},
{"key": "data.voice.arabic.order.1", "text": "{drink}, shukran.", "src": "One {drink}, shukran."},
{"key": "data.voice.arabic.order.2", "text": "Habibi, {drink}.", "src": "Habibi, a {drink}."},
{"key": "data.voice.arabic.order.3", "text": "Jag tar {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.arabic.perfect.0", "text": "Ya salam!", "src": "Ya salam!"},
{"key": "data.voice.arabic.perfect.1", "text": "Helu kteer!", "src": "Helu kteer!"},
{"key": "data.voice.arabic.perfect.2", "text": "Perfekt, habibi!", "src": "Perfect, habibi!"},
{"key": "data.voice.arabic.praise.0", "text": "Ya salam. Den här är rätt, habibi.", "src": "Ya salam. This is the one, habibi."},
{"key": "data.voice.arabic.praise.1", "text": "Helu kteer. Shukran.", "src": "Helu kteer. Shukran."},
{"key": "data.voice.arabic.praise.2", "text": "Yalla, du kan ditt jobb.", "src": "Yalla, you know your work."},
{"key": "data.voice.arabic.sip.0", "text": "Habibi, {advice_l}", "src": "Habibi, {advice_l}"},
{"key": "data.voice.arabic.sip.1", "text": "Shuf, {advice_l}", "src": "Shuf, {advice_l}"},
{"key": "data.voice.arabic.sip.2", "text": "Tamam, bas {advice_l}", "src": "Tamam, bas {advice_l}"},
{"key": "data.voice.arabic.wrong.0", "text": "La, la.", "src": "La, la."},
{"key": "data.voice.arabic.wrong.1", "text": "Det här är inte den.", "src": "This is not it."},
{"key": "data.voice.arabic.wrong.2", "text": "Shu hada?", "src": "Shu hada?"},
{"key": "data.voice.chinese.another.0", "text": "Zai lai yi bei!", "src": "Zai lai yi bei!"},
{"key": "data.voice.chinese.another.1", "text": "En till, ah!", "src": "One more, ah!"},
{"key": "data.voice.chinese.another.2", "text": "Igen, tack!", "src": "Again, please!"},
{"key": "data.voice.chinese.close.0", "text": "Hai keyi.", "src": "Hai keyi."},
{"key": "data.voice.chinese.close.1", "text": "Okej lah.", "src": "Okay lah."},
{"key": "data.voice.chinese.close.2", "text": "Det går bra.", "src": "It is fine."},
{"key": "data.voice.chinese.kicked.0", "text": "Shenme? Verkligen?", "src": "Shenme? Really?"},
{"key": "data.voice.chinese.kicked.1", "text": "Aiya. Okej då.", "src": "Aiya. Fine."},
{"key": "data.voice.chinese.kicked.2", "text": "Hao. Jag går.", "src": "Hao. I leave."},
{"key": "data.voice.chinese.leaving.0", "text": "Aiya. Jag väntade för länge.", "src": "Aiya. I waited too long."},
{"key": "data.voice.chinese.leaving.1", "text": "Suan le. Jag går.", "src": "Suan le. I go."},
{"key": "data.voice.chinese.leaving.2", "text": "Zaijian, då.", "src": "Zaijian, then."},
{"key": "data.voice.chinese.order.0", "text": "{drink}, tack.", "src": "{drink}, please."},
{"key": "data.voice.chinese.order.1", "text": "{drink}, xiexie.", "src": "One {drink}, xiexie."},
{"key": "data.voice.chinese.order.2", "text": "Jag tar {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.chinese.order.3", "text": "{drink} till mig.", "src": "A {drink} for me."},
{"key": "data.voice.chinese.perfect.0", "text": "Hen hao!", "src": "Hen hao!"},
{"key": "data.voice.chinese.perfect.1", "text": "Perfekt, ah!", "src": "Perfect, ah!"},
{"key": "data.voice.chinese.perfect.2", "text": "Zhen bang!", "src": "Zhen bang!"},
{"key": "data.voice.chinese.praise.0", "text": "Zhen bang. Jag kommer tillbaka för den här.", "src": "Zhen bang. I will come back for this."},
{"key": "data.voice.chinese.praise.1", "text": "Hen hao. Du vet vad du gör.", "src": "Hen hao. You know what you are doing."},
{"key": "data.voice.chinese.praise.2", "text": "Perfekt, ah. Verkligen.", "src": "Perfect, ah. Really."},
{"key": "data.voice.chinese.sip.0", "text": "Ai, {advice_l}", "src": "Ai, {advice_l}"},
{"key": "data.voice.chinese.sip.1", "text": "Hör här, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.chinese.sip.2", "text": "Hao, men {advice_l}", "src": "Hao, but {advice_l}"},
{"key": "data.voice.chinese.wrong.0", "text": "Bu dui.", "src": "Bu dui."},
{"key": "data.voice.chinese.wrong.1", "text": "Aiya, nej.", "src": "Aiya, no."},
{"key": "data.voice.chinese.wrong.2", "text": "Inte den här.", "src": "Not this one."},
{"key": "data.voice.filipino.another.0", "text": "Isa pa!", "src": "Isa pa!"},
{"key": "data.voice.filipino.another.1", "text": "En till, ha!", "src": "One more, ha!"},
{"key": "data.voice.filipino.another.2", "text": "Igen, tack!", "src": "Again, please!"},
{"key": "data.voice.filipino.close.0", "text": "Okay lang.", "src": "Okay lang."},
{"key": "data.voice.filipino.close.1", "text": "Sige, tack.", "src": "Sige, thanks."},
{"key": "data.voice.filipino.close.2", "text": "Ay, det går bra.", "src": "Ay, it's fine."},
{"key": "data.voice.filipino.kicked.0", "text": "Ha? Verkligen?", "src": "Ha? Really?"},
{"key": "data.voice.filipino.kicked.1", "text": "Ay. Okej. Hej då.", "src": "Ay. Okay. Bye."},
{"key": "data.voice.filipino.kicked.2", "text": "Grabe naman.", "src": "Grabe naman."},
{"key": "data.voice.filipino.leaving.0", "text": "Ay, grabe. För länge. Jag går.", "src": "Ay, grabe. Too long. I'm going."},
{"key": "data.voice.filipino.leaving.1", "text": "Sige na, hej då.", "src": "Sige na, bye."},
{"key": "data.voice.filipino.leaving.2", "text": "Naku, ingen kommer ju.", "src": "Naku, no one is coming."},
{"key": "data.voice.filipino.order.0", "text": "Ay, {drink}, tack.", "src": "Ay, one {drink}, please."},
{"key": "data.voice.filipino.order.1", "text": "{drink} till mig. Salamat.", "src": "{drink} for me. Salamat."},
{"key": "data.voice.filipino.order.2", "text": "Kan jag få {drink}? Tack, ha.", "src": "Can I have a {drink}? Thanks, ha."},
{"key": "data.voice.filipino.order.3", "text": "{drink}, kuya.", "src": "A {drink}, kuya."},
{"key": "data.voice.filipino.perfect.0", "text": "Ay, sarap!", "src": "Ay, sarap!"},
{"key": "data.voice.filipino.perfect.1", "text": "Grabe, ja!", "src": "Grabe, yes!"},
{"key": "data.voice.filipino.perfect.2", "text": "Perfekt, kuya!", "src": "Perfect, kuya!"},
{"key": "data.voice.filipino.praise.0", "text": "Grabe. Så gott. Salamat.", "src": "Grabe. That is so good. Salamat."},
{"key": "data.voice.filipino.praise.1", "text": "Ay, sarap. Du räddade hela mitt pass.", "src": "Ay, sarap. You made my whole shift."},
{"key": "data.voice.filipino.praise.2", "text": "Sige, jag kommer tillbaka för den här.", "src": "Sige, I'm coming back for this."},
{"key": "data.voice.filipino.sip.0", "text": "Ay, {advice_l}", "src": "Ay, {advice_l}"},
{"key": "data.voice.filipino.sip.1", "text": "Sige, men {advice_l}", "src": "Sige, but {advice_l}"},
{"key": "data.voice.filipino.sip.2", "text": "Ha? {advice}", "src": "Ha? {advice}"},
{"key": "data.voice.filipino.wrong.0", "text": "Ay, hindi. Inte den här.", "src": "Ay, hindi. Not this."},
{"key": "data.voice.filipino.wrong.1", "text": "Grabe, fel drink.", "src": "Grabe, wrong drink."},
{"key": "data.voice.filipino.wrong.2", "text": "Inte min, kuya.", "src": "Not mine, kuya."},
{"key": "data.voice.italian.another.0", "text": "Ancora, dai!", "src": "Ancora, dai!"},
{"key": "data.voice.italian.another.1", "text": "En till, grazie!", "src": "Another, grazie!"},
{"key": "data.voice.italian.another.2", "text": "En gång till, amore!", "src": "Once more, amore!"},
{"key": "data.voice.italian.close.0", "text": "Va bene.", "src": "Va bene."},
{"key": "data.voice.italian.close.1", "text": "Okej, grazie.", "src": "Okay, grazie."},
{"key": "data.voice.italian.close.2", "text": "Inte illa, eh.", "src": "Not bad, eh."},
{"key": "data.voice.italian.kicked.0", "text": "Ma dai! Verkligen?", "src": "Ma dai! Really?"},
{"key": "data.voice.italian.kicked.1", "text": "Va bene. Ciao, ciao.", "src": "Va bene. Ciao, ciao."},
{"key": "data.voice.italian.kicked.2", "text": "Che maleducato.", "src": "Che maleducato."},
{"key": "data.voice.italian.leaving.0", "text": "Basta. Jag går.", "src": "Basta. I go."},
{"key": "data.voice.italian.leaving.1", "text": "Mamma mia, all denna väntan!", "src": "Mamma mia, the waiting!"},
{"key": "data.voice.italian.leaving.2", "text": "Ciao. Kanske i nästa liv.", "src": "Ciao. Maybe next life."},
{"key": "data.voice.italian.order.0", "text": "{drink}, per favore.", "src": "Un {drink}, per favore."},
{"key": "data.voice.italian.order.1", "text": "{drink}, amore.", "src": "A {drink}, amore."},
{"key": "data.voice.italian.order.2", "text": "{drink}, grazie.", "src": "{drink}, grazie."},
{"key": "data.voice.italian.order.3", "text": "Dai, {drink}.", "src": "Dai, a {drink}."},
{"key": "data.voice.italian.perfect.0", "text": "Perfetto!", "src": "Perfetto!"},
{"key": "data.voice.italian.perfect.1", "text": "Bravo!", "src": "Bravo!"},
{"key": "data.voice.italian.perfect.2", "text": "Che buono!", "src": "Che buono!"},
{"key": "data.voice.italian.praise.0", "text": "Perfetto. Verkligen. Grazie mille.", "src": "Perfetto. Truly. Grazie mille."},
{"key": "data.voice.italian.praise.1", "text": "Bravo. Min nonna skulle gråta.", "src": "Bravo. My nonna would cry."},
{"key": "data.voice.italian.praise.2", "text": "Che buono. Jag går ingenstans.", "src": "Che buono. I'm not leaving."},
{"key": "data.voice.italian.sip.0", "text": "Senti, {advice_l}", "src": "Senti, {advice_l}"},
{"key": "data.voice.italian.sip.1", "text": "Allora, {advice_l}", "src": "Allora, {advice_l}"},
{"key": "data.voice.italian.sip.2", "text": "Va bene, ma {advice_l}", "src": "Va bene, ma {advice_l}"},
{"key": "data.voice.italian.wrong.0", "text": "Mamma mia, nej.", "src": "Mamma mia, no."},
{"key": "data.voice.italian.wrong.1", "text": "Ma che cos'è?", "src": "Ma che cos'è?"},
{"key": "data.voice.italian.wrong.2", "text": "Nej, nej. Inte den här.", "src": "No, no. Not this."},
{"key": "data.voice.miami.another.0", "text": "¡Otra, dale!", "src": "¡Otra, dale!"},
{"key": "data.voice.miami.another.1", "text": "En till, oye!", "src": "One more, oye!"},
{"key": "data.voice.miami.another.2", "text": "Igen, mi amor!", "src": "Again, mi amor!"},
{"key": "data.voice.miami.close.0", "text": "Está bien.", "src": "Está bien."},
{"key": "data.voice.miami.close.1", "text": "Inte illa, chico.", "src": "Not bad, chico."},
{"key": "data.voice.miami.close.2", "text": "Okej, okej.", "src": "Okay, okay."},
{"key": "data.voice.miami.kicked.0", "text": "¿En serio? Okej, visst.", "src": "¿En serio? Okay, fine."},
{"key": "data.voice.miami.kicked.1", "text": "Du skojar med mig, chico.", "src": "You're kidding me, chico."},
{"key": "data.voice.miami.kicked.2", "text": "Dale. Din förlust.", "src": "Dale. Your loss."},
{"key": "data.voice.miami.leaving.0", "text": "¡Oye! Jag har suttit här hela kvällen.", "src": "¡Oye! I've been sitting here all night."},
{"key": "data.voice.miami.leaving.1", "text": "Bueno, nu räcker det. Ciao.", "src": "Bueno, that's it. Ciao."},
{"key": "data.voice.miami.leaving.2", "text": "No, no. Jag väntar inte längre.", "src": "No, no. I'm not waiting anymore."},
{"key": "data.voice.miami.order.0", "text": "Oye, {drink} till mig.", "src": "Oye, a {drink} for me."},
{"key": "data.voice.miami.order.1", "text": "Dale, {drink}.", "src": "Dale, one {drink}."},
{"key": "data.voice.miami.order.2", "text": "{drink}, papi, när du hinner.", "src": "{drink}, papi, when you can."},
{"key": "data.voice.miami.order.3", "text": "Mi amor, {drink}.", "src": "Mi amor, a {drink}."},
{"key": "data.voice.miami.perfect.0", "text": "¡Qué rico!", "src": "¡Qué rico!"},
{"key": "data.voice.miami.perfect.1", "text": "¡Eso es!", "src": "¡Eso es!"},
{"key": "data.voice.miami.perfect.2", "text": "¡Dale, perfecto!", "src": "¡Dale, perfecto!"},
{"key": "data.voice.miami.praise.0", "text": "Ay, det här är den. Gracias.", "src": "Ay, this is the one. Gracias."},
{"key": "data.voice.miami.praise.1", "text": "Min abuela skulle godkänna, och hon godkänner ingenting.", "src": "My abuela would approve, and she approves of nothing."},
{"key": "data.voice.miami.praise.2", "text": "Dale. Du vet vad du håller på med.", "src": "Dale. You know what you're doing."},
{"key": "data.voice.miami.sip.0", "text": "Mira, {advice_l}", "src": "Mira, {advice_l}"},
{"key": "data.voice.miami.sip.1", "text": "Oye, {advice_l}", "src": "Oye, {advice_l}"},
{"key": "data.voice.miami.sip.2", "text": "Está bien, pero… {advice_l}", "src": "Está bien, pero… {advice_l}"},
{"key": "data.voice.miami.wrong.0", "text": "¿Qué es esto?", "src": "¿Qué es esto?"},
{"key": "data.voice.miami.wrong.1", "text": "No, no, no.", "src": "No, no, no."},
{"key": "data.voice.miami.wrong.2", "text": "Inte min, oye.", "src": "Not mine, oye."},
{"key": "data.voice.nyc.another.0", "text": "Hit me again!", "src": "Hit me again!"},
{"key": "data.voice.nyc.another.1", "text": "Kör, en till direkt!", "src": "Keep 'em comin'!"},
{"key": "data.voice.nyc.another.2", "text": "En till, chief!", "src": "Another, chief!"},
{"key": "data.voice.nyc.close.0", "text": "Eh. Det duger.", "src": "Eh. It's fine."},
{"key": "data.voice.nyc.close.1", "text": "Yeah, alright.", "src": "Yeah, alright."},
{"key": "data.voice.nyc.close.2", "text": "Det får gå.", "src": "It'll do."},
{"key": "data.voice.nyc.kicked.0", "text": "Menar du allvar just nu?", "src": "You serious right now?"},
{"key": "data.voice.nyc.kicked.1", "text": "Fine. Usel bar ändå.", "src": "Fine. Terrible bar anyway."},
{"key": "data.voice.nyc.kicked.2", "text": "Wow. Okej. Wow.", "src": "Wow. Okay. Wow."},
{"key": "data.voice.nyc.leaving.0", "text": "Jag har ställen att vara på. Glöm det.", "src": "I got places to be. Forget it."},
{"key": "data.voice.nyc.leaving.1", "text": "Unbelievable. Jag är outta here.", "src": "Unbelievable. I'm outta here."},
{"key": "data.voice.nyc.leaving.2", "text": "Yo, är det här en bar eller ett väntrum?", "src": "Yo, is this a bar or a waiting room?"},
{"key": "data.voice.nyc.order.0", "text": "Yo, ge mig {drink}.", "src": "Yo, lemme get a {drink}."},
{"key": "data.voice.nyc.order.1", "text": "{drink}. Och jag har bråttom.", "src": "{drink}. And I'm in a hurry."},
{"key": "data.voice.nyc.order.2", "text": "{drink}, chief. Lemme get it.", "src": "Gimme a {drink}, chief."},
{"key": "data.voice.nyc.order.3", "text": "{drink}. Gör det inte konstigt.", "src": "{drink}. Don't make it weird."},
{"key": "data.voice.nyc.perfect.0", "text": "Now we're talkin'!", "src": "Now we're talkin'!"},
{"key": "data.voice.nyc.perfect.1", "text": "Det är grejen!", "src": "That's the stuff!"},
{"key": "data.voice.nyc.perfect.2", "text": "Oh, det är den!", "src": "Oh, that's it!"},
{"key": "data.voice.nyc.praise.0", "text": "Okej, jag är imponerad. Det händer aldrig.", "src": "Okay, I'm impressed. That never happens."},
{"key": "data.voice.nyc.praise.1", "text": "Lemme tell ya, det där är en drink.", "src": "Lemme tell ya, that's a drink."},
{"key": "data.voice.nyc.praise.2", "text": "Du borde ta mer betalt för den här. Gör det inte.", "src": "You should charge more for this. Don't."},
{"key": "data.voice.nyc.sip.0", "text": "Look, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.nyc.sip.1", "text": "Jag säger bara, {advice_l}", "src": "I'm just sayin', {advice_l}"},
{"key": "data.voice.nyc.sip.2", "text": "Inte illa, men {advice_l}", "src": "Not bad, but {advice_l}"},
{"key": "data.voice.nyc.wrong.0", "text": "Vad är det här?", "src": "What is this?"},
{"key": "data.voice.nyc.wrong.1", "text": "Fuhgeddaboudit.", "src": "Fuhgeddaboudit."},
{"key": "data.voice.nyc.wrong.2", "text": "Fel drink, pal.", "src": "Wrong one, pal."},
{"key": "data.voice.surfer.another.0", "text": "En till, dude!", "src": "One more, dude!"},
{"key": "data.voice.surfer.another.1", "text": "Igen, igen!", "src": "Again, again!"},
{"key": "data.voice.surfer.another.2", "text": "Keep 'em rolling!", "src": "Keep 'em rolling!"},
{"key": "data.voice.surfer.close.0", "text": "Cool, cool.", "src": "Cool, cool."},
{"key": "data.voice.surfer.close.1", "text": "Yeah, det funkar.", "src": "Yeah, that works."},
{"key": "data.voice.surfer.close.2", "text": "Nice nog.", "src": "Nice enough."},
{"key": "data.voice.surfer.kicked.0", "text": "Harsh, dude.", "src": "Harsh, dude."},
{"key": "data.voice.surfer.kicked.1", "text": "Okej… det är en vibe.", "src": "Okay… that's a vibe."},
{"key": "data.voice.surfer.kicked.2", "text": "Wow. Inte chill.", "src": "Wow. Not chill."},
{"key": "data.voice.surfer.leaving.0", "text": "Dude, jag har varit här i evigheter.", "src": "Dude, I've been here forever."},
{"key": "data.voice.surfer.leaving.1", "text": "Inte coolt. Jag drar.", "src": "Not cool. I'm out."},
{"key": "data.voice.surfer.leaving.2", "text": "Yeah, nej. Jag sticker.", "src": "Yeah, no. Bailing."},
{"key": "data.voice.surfer.order.0", "text": "Dude, {drink}.", "src": "Dude, a {drink}."},
{"key": "data.voice.surfer.order.1", "text": "Kan jag få, typ, {drink}?", "src": "Can I get, like, a {drink}?"},
{"key": "data.voice.surfer.order.2", "text": "{drink}, tack. Chill, ingen stress.", "src": "{drink}, please. Chill, no rush."},
{"key": "data.voice.surfer.order.3", "text": "Yeah, {drink} låter episkt.", "src": "Yeah, a {drink} sounds epic."},
{"key": "data.voice.surfer.perfect.0", "text": "Dude. Ja.", "src": "Dude. Yes."},
{"key": "data.voice.surfer.perfect.1", "text": "Stoked!", "src": "Stoked!"},
{"key": "data.voice.surfer.perfect.2", "text": "Så gott!", "src": "So good!"},
{"key": "data.voice.surfer.praise.0", "text": "Okej, den är faktiskt perfekt. Respekt.", "src": "Okay, that's actually perfect. Respect."},
{"key": "data.voice.surfer.praise.1", "text": "Dude. Jag skojar inte ens. Grymt.", "src": "Dude. I'm not even kidding. Amazing."},
{"key": "data.voice.surfer.praise.2", "text": "Gnarly. På ett bra sätt.", "src": "Gnarly. In a good way."},
{"key": "data.voice.surfer.sip.0", "text": "Dude, {advice_l}", "src": "Dude, {advice_l}"},
