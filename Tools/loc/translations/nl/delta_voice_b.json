{"strings": [
{"key": "data.voice.arabic.another.0", "text": "Kaman wahad, nog één!", "src": "Kaman wahad!"},
{"key": "data.voice.arabic.another.1", "text": "Nog eentje, yalla!", "src": "One more, yalla!"},
{"key": "data.voice.arabic.another.2", "text": "Nog een keer, habibi!", "src": "Again, habibi!"},
{"key": "data.voice.arabic.close.0", "text": "Maashi, prima.", "src": "Maashi."},
{"key": "data.voice.arabic.close.1", "text": "Het is oké.", "src": "It is okay."},
{"key": "data.voice.arabic.close.2", "text": "Tamam, shukran.", "src": "Tamam, shukran."},
{"key": "data.voice.arabic.kicked.0", "text": "Shu? Serieus?", "src": "Shu? Seriously?"},
{"key": "data.voice.arabic.kicked.1", "text": "Khalas. Prima.", "src": "Khalas. Fine."},
{"key": "data.voice.arabic.kicked.2", "text": "Yalla. Ik ga.", "src": "Yalla. I go."},
{"key": "data.voice.arabic.leaving.0", "text": "Khalas. Ik ga ervandoor.", "src": "Khalas. I am going."},
{"key": "data.voice.arabic.leaving.1", "text": "Yalla, genoeg gewacht.", "src": "Yalla, enough waiting."},
{"key": "data.voice.arabic.leaving.2", "text": "Maa salama, dag.", "src": "Maa salama."},
{"key": "data.voice.arabic.order.0", "text": "Een {drink}, alsjeblieft.", "src": "A {drink}, please."},
{"key": "data.voice.arabic.order.1", "text": "Eén {drink}, shukran.", "src": "One {drink}, shukran."},
{"key": "data.voice.arabic.order.2", "text": "Habibi, een {drink}.", "src": "Habibi, a {drink}."},
{"key": "data.voice.arabic.order.3", "text": "Ik neem een {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.arabic.perfect.0", "text": "Ya salam!", "src": "Ya salam!"},
{"key": "data.voice.arabic.perfect.1", "text": "Helu kteer!", "src": "Helu kteer!"},
{"key": "data.voice.arabic.perfect.2", "text": "Perfect, habibi!", "src": "Perfect, habibi!"},
{"key": "data.voice.arabic.praise.0", "text": "Ya salam. Dit is hem, habibi.", "src": "Ya salam. This is the one, habibi."},
{"key": "data.voice.arabic.praise.1", "text": "Helu kteer. Shukran, echt.", "src": "Helu kteer. Shukran."},
{"key": "data.voice.arabic.praise.2", "text": "Yalla, jij kent je vak.", "src": "Yalla, you know your work."},
{"key": "data.voice.arabic.sip.0", "text": "Habibi, {advice_l}", "src": "Habibi, {advice_l}"},
{"key": "data.voice.arabic.sip.1", "text": "Shuf, {advice_l}", "src": "Shuf, {advice_l}"},
{"key": "data.voice.arabic.sip.2", "text": "Tamam, bas {advice_l}", "src": "Tamam, bas {advice_l}"},
{"key": "data.voice.arabic.wrong.0", "text": "La, la. Nee.", "src": "La, la."},
{"key": "data.voice.arabic.wrong.1", "text": "Dit is hem niet.", "src": "This is not it."},
{"key": "data.voice.arabic.wrong.2", "text": "Shu hada? Dit niet.", "src": "Shu hada?"},
{"key": "data.voice.chinese.another.0", "text": "Zai lai yi bei! Nog één!", "src": "Zai lai yi bei!"},
{"key": "data.voice.chinese.another.1", "text": "Nog eentje, ah!", "src": "One more, ah!"},
{"key": "data.voice.chinese.another.2", "text": "Nog een keer, alsjeblieft!", "src": "Again, please!"},
{"key": "data.voice.chinese.close.0", "text": "Hai keyi. Gaat wel.", "src": "Hai keyi."},
{"key": "data.voice.chinese.close.1", "text": "Oké lah.", "src": "Okay lah."},
{"key": "data.voice.chinese.close.2", "text": "Het is goed.", "src": "It is fine."},
{"key": "data.voice.chinese.kicked.0", "text": "Shenme? Echt?", "src": "Shenme? Really?"},
{"key": "data.voice.chinese.kicked.1", "text": "Aiya. Goed dan.", "src": "Aiya. Fine."},
{"key": "data.voice.chinese.kicked.2", "text": "Hao. Ik ga.", "src": "Hao. I leave."},
{"key": "data.voice.chinese.leaving.0", "text": "Aiya. Ik heb te lang gewacht.", "src": "Aiya. I waited too long."},
{"key": "data.voice.chinese.leaving.1", "text": "Suan le. Ik ga.", "src": "Suan le. I go."},
{"key": "data.voice.chinese.leaving.2", "text": "Zaijian, dan maar.", "src": "Zaijian, then."},
{"key": "data.voice.chinese.order.0", "text": "{drink}, alsjeblieft.", "src": "{drink}, please."},
{"key": "data.voice.chinese.order.1", "text": "Eén {drink}, xiexie.", "src": "One {drink}, xiexie."},
{"key": "data.voice.chinese.order.2", "text": "Ik neem een {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.chinese.order.3", "text": "Een {drink} voor mij.", "src": "A {drink} for me."},
{"key": "data.voice.chinese.perfect.0", "text": "Hen hao!", "src": "Hen hao!"},
{"key": "data.voice.chinese.perfect.1", "text": "Perfect, ah!", "src": "Perfect, ah!"},
{"key": "data.voice.chinese.perfect.2", "text": "Zhen bang!", "src": "Zhen bang!"},
{"key": "data.voice.chinese.praise.0", "text": "Zhen bang. Hiervoor kom ik terug.", "src": "Zhen bang. I will come back for this."},
{"key": "data.voice.chinese.praise.1", "text": "Hen hao. Jij weet wat je doet.", "src": "Hen hao. You know what you are doing."},
{"key": "data.voice.chinese.praise.2", "text": "Perfect, ah. Echt waar.", "src": "Perfect, ah. Really."},
{"key": "data.voice.chinese.sip.0", "text": "Ai, {advice_l}", "src": "Ai, {advice_l}"},
{"key": "data.voice.chinese.sip.1", "text": "Luister, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.chinese.sip.2", "text": "Hao, maar {advice_l}", "src": "Hao, but {advice_l}"},
{"key": "data.voice.chinese.wrong.0", "text": "Bu dui. Nee.", "src": "Bu dui."},
{"key": "data.voice.chinese.wrong.1", "text": "Aiya, nee.", "src": "Aiya, no."},
{"key": "data.voice.chinese.wrong.2", "text": "Deze niet.", "src": "Not this one."},
{"key": "data.voice.filipino.another.0", "text": "Isa pa! Nog één!", "src": "Isa pa!"},
{"key": "data.voice.filipino.another.1", "text": "Nog eentje, ha!", "src": "One more, ha!"},
{"key": "data.voice.filipino.another.2", "text": "Nog een keer, alsjeblieft!", "src": "Again, please!"},
{"key": "data.voice.filipino.close.0", "text": "Okay lang. Prima.", "src": "Okay lang."},
{"key": "data.voice.filipino.close.1", "text": "Sige, dank je.", "src": "Sige, thanks."},
{"key": "data.voice.filipino.close.2", "text": "Ay, het is goed.", "src": "Ay, it's fine."},
{"key": "data.voice.filipino.kicked.0", "text": "Ha? Echt?", "src": "Ha? Really?"},
{"key": "data.voice.filipino.kicked.1", "text": "Ay. Oké. Doei.", "src": "Ay. Okay. Bye."},
{"key": "data.voice.filipino.kicked.2", "text": "Grabe naman, zeg.", "src": "Grabe naman."},
{"key": "data.voice.filipino.leaving.0", "text": "Ay, grabe. Te lang. Ik ga.", "src": "Ay, grabe. Too long. I'm going."},
{"key": "data.voice.filipino.leaving.1", "text": "Sige na, doei.", "src": "Sige na, bye."},
{"key": "data.voice.filipino.leaving.2", "text": "Naku, er komt niemand.", "src": "Naku, no one is coming."},
{"key": "data.voice.filipino.order.0", "text": "Ay, één {drink}, alsjeblieft.", "src": "Ay, one {drink}, please."},
{"key": "data.voice.filipino.order.1", "text": "{drink} voor mij. Salamat.", "src": "{drink} for me. Salamat."},
{"key": "data.voice.filipino.order.2", "text": "Mag ik een {drink}? Dank je, ha.", "src": "Can I have a {drink}? Thanks, ha."},
{"key": "data.voice.filipino.order.3", "text": "Een {drink}, kuya.", "src": "A {drink}, kuya."},
{"key": "data.voice.filipino.perfect.0", "text": "Ay, sarap!", "src": "Ay, sarap!"},
{"key": "data.voice.filipino.perfect.1", "text": "Grabe, ja!", "src": "Grabe, yes!"},
{"key": "data.voice.filipino.perfect.2", "text": "Perfect, kuya!", "src": "Perfect, kuya!"},
{"key": "data.voice.filipino.praise.0", "text": "Grabe. Zo lekker. Salamat.", "src": "Grabe. That is so good. Salamat."},
{"key": "data.voice.filipino.praise.1", "text": "Ay, sarap. Mijn hele avond is goed.", "src": "Ay, sarap. You made my whole shift."},
{"key": "data.voice.filipino.praise.2", "text": "Sige, hiervoor kom ik terug.", "src": "Sige, I'm coming back for this."},
{"key": "data.voice.filipino.sip.0", "text": "Ay, {advice_l}", "src": "Ay, {advice_l}"},
{"key": "data.voice.filipino.sip.1", "text": "Sige, maar {advice_l}", "src": "Sige, but {advice_l}"},
{"key": "data.voice.filipino.sip.2", "text": "Ha? {advice}", "src": "Ha? {advice}"},
{"key": "data.voice.filipino.wrong.0", "text": "Ay, hindi. Dit niet.", "src": "Ay, hindi. Not this."},
{"key": "data.voice.filipino.wrong.1", "text": "Grabe, verkeerd drankje.", "src": "Grabe, wrong drink."},
{"key": "data.voice.filipino.wrong.2", "text": "Niet de mijne, kuya.", "src": "Not mine, kuya."},
{"key": "data.voice.italian.another.0", "text": "Ancora, dai! Nog één!", "src": "Ancora, dai!"},
{"key": "data.voice.italian.another.1", "text": "Nog eentje, grazie!", "src": "Another, grazie!"},
{"key": "data.voice.italian.another.2", "text": "Nog een keer, amore!", "src": "Once more, amore!"},
{"key": "data.voice.italian.close.0", "text": "Va bene, prima.", "src": "Va bene."},
{"key": "data.voice.italian.close.1", "text": "Oké, grazie.", "src": "Okay, grazie."},
{"key": "data.voice.italian.close.2", "text": "Niet slecht, eh.", "src": "Not bad, eh."},
{"key": "data.voice.italian.kicked.0", "text": "Ma dai! Echt?", "src": "Ma dai! Really?"},
{"key": "data.voice.italian.kicked.1", "text": "Va bene. Ciao, hoor.", "src": "Va bene. Ciao, ciao."},
{"key": "data.voice.italian.kicked.2", "text": "Che maleducato. Onbeleefd!", "src": "Che maleducato."},
{"key": "data.voice.italian.leaving.0", "text": "Basta. Ik ga.", "src": "Basta. I go."},
{"key": "data.voice.italian.leaving.1", "text": "Mamma mia, dat wachten!", "src": "Mamma mia, the waiting!"},
{"key": "data.voice.italian.leaving.2", "text": "Ciao. Misschien in een volgend leven.", "src": "Ciao. Maybe next life."},
{"key": "data.voice.italian.order.0", "text": "Een {drink}, per favore.", "src": "Un {drink}, per favore."},
{"key": "data.voice.italian.order.1", "text": "Een {drink}, amore.", "src": "A {drink}, amore."},
{"key": "data.voice.italian.order.2", "text": "{drink}, graag. Grazie.", "src": "{drink}, grazie."},
{"key": "data.voice.italian.order.3", "text": "Dai, een {drink}.", "src": "Dai, a {drink}."},
{"key": "data.voice.italian.perfect.0", "text": "Perfetto!", "src": "Perfetto!"},
{"key": "data.voice.italian.perfect.1", "text": "Bravo, zeg!", "src": "Bravo!"},
{"key": "data.voice.italian.perfect.2", "text": "Che buono!", "src": "Che buono!"},
{"key": "data.voice.italian.praise.0", "text": "Perfetto. Echt. Grazie mille.", "src": "Perfetto. Truly. Grazie mille."},
{"key": "data.voice.italian.praise.1", "text": "Bravo. Mijn nonna zou huilen.", "src": "Bravo. My nonna would cry."},
{"key": "data.voice.italian.praise.2", "text": "Che buono. Ik ga hier niet meer weg.", "src": "Che buono. I'm not leaving."},
{"key": "data.voice.italian.sip.0", "text": "Senti, {advice_l}", "src": "Senti, {advice_l}"},
{"key": "data.voice.italian.sip.1", "text": "Allora, {advice_l}", "src": "Allora, {advice_l}"},
{"key": "data.voice.italian.sip.2", "text": "Va bene, ma {advice_l}", "src": "Va bene, ma {advice_l}"},
{"key": "data.voice.italian.wrong.0", "text": "Mamma mia, nee.", "src": "Mamma mia, no."},
{"key": "data.voice.italian.wrong.1", "text": "Ma che cos'è? Nee.", "src": "Ma che cos'è?"},
{"key": "data.voice.italian.wrong.2", "text": "Nee, nee. Dit niet.", "src": "No, no. Not this."},
{"key": "data.voice.miami.another.0", "text": "¡Otra, dale! Nog één!", "src": "¡Otra, dale!"},
{"key": "data.voice.miami.another.1", "text": "Nog eentje, oye!", "src": "One more, oye!"},
{"key": "data.voice.miami.another.2", "text": "Nog een keer, mi amor!", "src": "Again, mi amor!"},
{"key": "data.voice.miami.close.0", "text": "Está bien, hoor.", "src": "Está bien."},
{"key": "data.voice.miami.close.1", "text": "Niet slecht, chico.", "src": "Not bad, chico."},
{"key": "data.voice.miami.close.2", "text": "Oké, oké.", "src": "Okay, okay."},
{"key": "data.voice.miami.kicked.0", "text": "¿En serio? Oké, prima.", "src": "¿En serio? Okay, fine."},
{"key": "data.voice.miami.kicked.1", "text": "Je maakt een grapje, chico.", "src": "You're kidding me, chico."},
{"key": "data.voice.miami.kicked.2", "text": "Dale. Jouw verlies.", "src": "Dale. Your loss."},
{"key": "data.voice.miami.leaving.0", "text": "¡Oye! Ik zit hier al de hele avond.", "src": "¡Oye! I've been sitting here all night."},
{"key": "data.voice.miami.leaving.1", "text": "Bueno, dat was het. Ciao.", "src": "Bueno, that's it. Ciao."},
{"key": "data.voice.miami.leaving.2", "text": "Nee, nee. Ik wacht niet langer.", "src": "No, no. I'm not waiting anymore."},
{"key": "data.voice.miami.order.0", "text": "Oye, een {drink} voor mij.", "src": "Oye, a {drink} for me."},
{"key": "data.voice.miami.order.1", "text": "Dale, één {drink}.", "src": "Dale, one {drink}."},
{"key": "data.voice.miami.order.2", "text": "{drink}, papi, als je kunt.", "src": "{drink}, papi, when you can."},
{"key": "data.voice.miami.order.3", "text": "Mi amor, een {drink}.", "src": "Mi amor, a {drink}."},
{"key": "data.voice.miami.perfect.0", "text": "¡Qué rico!", "src": "¡Qué rico!"},
{"key": "data.voice.miami.perfect.1", "text": "¡Eso es! Top!", "src": "¡Eso es!"},
{"key": "data.voice.miami.perfect.2", "text": "¡Dale, perfecto!", "src": "¡Dale, perfecto!"},
{"key": "data.voice.miami.praise.0", "text": "Ay, dit is hem. Gracias.", "src": "Ay, this is the one. Gracias."},
{"key": "data.voice.miami.praise.1", "text": "Mijn abuela zou het goedkeuren, en zij keurt niks goed.", "src": "My abuela would approve, and she approves of nothing."},
{"key": "data.voice.miami.praise.2", "text": "Dale. Jij weet wat je doet.", "src": "Dale. You know what you're doing."},
{"key": "data.voice.miami.sip.0", "text": "Mira, {advice_l}", "src": "Mira, {advice_l}"},
{"key": "data.voice.miami.sip.1", "text": "Oye, {advice_l}", "src": "Oye, {advice_l}"},
{"key": "data.voice.miami.sip.2", "text": "Está bien, pero… {advice_l}", "src": "Está bien, pero… {advice_l}"},
{"key": "data.voice.miami.wrong.0", "text": "¿Qué es esto? Nee.", "src": "¿Qué es esto?"},
{"key": "data.voice.miami.wrong.1", "text": "Nee, nee, nee.", "src": "No, no, no."},
{"key": "data.voice.miami.wrong.2", "text": "Niet de mijne, oye.", "src": "Not mine, oye."},
{"key": "data.voice.nyc.another.0", "text": "Nog eentje, hit me!", "src": "Hit me again!"},
{"key": "data.voice.nyc.another.1", "text": "Keep 'em comin', man!", "src": "Keep 'em comin'!"},
{"key": "data.voice.nyc.another.2", "text": "Nog één, chief!", "src": "Another, chief!"},
{"key": "data.voice.nyc.close.0", "text": "Eh. Gaat wel.", "src": "Eh. It's fine."},
{"key": "data.voice.nyc.close.1", "text": "Yeah, oké dan.", "src": "Yeah, alright."},
{"key": "data.voice.nyc.close.2", "text": "Kan ermee door.", "src": "It'll do."},
{"key": "data.voice.nyc.kicked.0", "text": "Meen je dit nou?", "src": "You serious right now?"},
{"key": "data.voice.nyc.kicked.1", "text": "Prima. Waardeloze bar trouwens.", "src": "Fine. Terrible bar anyway."},
{"key": "data.voice.nyc.kicked.2", "text": "Wow. Oké. Wow.", "src": "Wow. Okay. Wow."},
{"key": "data.voice.nyc.leaving.0", "text": "Ik moet nog ergens heen. Laat maar.", "src": "I got places to be. Forget it."},
{"key": "data.voice.nyc.leaving.1", "text": "Ongelofelijk. Ik ben weg.", "src": "Unbelievable. I'm outta here."},
{"key": "data.voice.nyc.leaving.2", "text": "Yo, is dit een bar of een wachtkamer?", "src": "Yo, is this a bar or a waiting room?"},
{"key": "data.voice.nyc.order.0", "text": "Yo, doe mij een {drink}.", "src": "Yo, lemme get a {drink}."},
{"key": "data.voice.nyc.order.1", "text": "{drink}. En ik heb haast.", "src": "{drink}. And I'm in a hurry."},
{"key": "data.voice.nyc.order.2", "text": "Geef me een {drink}, chief.", "src": "Gimme a {drink}, chief."},
{"key": "data.voice.nyc.order.3", "text": "{drink}. Maak het niet raar.", "src": "{drink}. Don't make it weird."},
{"key": "data.voice.nyc.perfect.0", "text": "Nu praten we!", "src": "Now we're talkin'!"},
{"key": "data.voice.nyc.perfect.1", "text": "Dat is 'm!", "src": "That's the stuff!"},
{"key": "data.voice.nyc.perfect.2", "text": "Oh, dat is het!", "src": "Oh, that's it!"},
{"key": "data.voice.nyc.praise.0", "text": "Oké, ik ben onder de indruk. Dat gebeurt nooit.", "src": "Okay, I'm impressed. That never happens."},
{"key": "data.voice.nyc.praise.1", "text": "Ik zeg je, dát is een drankje.", "src": "Lemme tell ya, that's a drink."},
{"key": "data.voice.nyc.praise.2", "text": "Je zou hier meer voor moeten vragen. Niet doen.", "src": "You should charge more for this. Don't."},
{"key": "data.voice.nyc.sip.0", "text": "Kijk, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.nyc.sip.1", "text": "Ik zeg maar, {advice_l}", "src": "I'm just sayin', {advice_l}"},
{"key": "data.voice.nyc.sip.2", "text": "Niet slecht, maar {advice_l}", "src": "Not bad, but {advice_l}"},
{"key": "data.voice.nyc.wrong.0", "text": "Wat is dit?", "src": "What is this?"},
{"key": "data.voice.nyc.wrong.1", "text": "Fuhgeddaboudit, man.", "src": "Fuhgeddaboudit."},
{"key": "data.voice.nyc.wrong.2", "text": "Verkeerde, pal.", "src": "Wrong one, pal."},
{"key": "data.voice.surfer.another.0", "text": "Nog eentje, dude!", "src": "One more, dude!"},
{"key": "data.voice.surfer.another.1", "text": "Nog een keer, nog een keer!", "src": "Again, again!"},
{"key": "data.voice.surfer.another.2", "text": "Keep 'em rolling, man!", "src": "Keep 'em rolling!"},
{"key": "data.voice.surfer.close.0", "text": "Chill, cool.", "src": "Cool, cool."},
{"key": "data.voice.surfer.close.1", "text": "Yeah, dat werkt.", "src": "Yeah, that works."},
{"key": "data.voice.surfer.close.2", "text": "Best nice.", "src": "Nice enough."},
{"key": "data.voice.surfer.kicked.0", "text": "Harsh, dude. Echt.", "src": "Harsh, dude."},
{"key": "data.voice.surfer.kicked.1", "text": "Oké… ook een vibe.", "src": "Okay… that's a vibe."},
{"key": "data.voice.surfer.kicked.2", "text": "Wow. Niet chill.", "src": "Wow. Not chill."},
{"key": "data.voice.surfer.leaving.0", "text": "Dude, ik zit hier al eeuwen.", "src": "Dude, I've been here forever."},
{"key": "data.voice.surfer.leaving.1", "text": "Niet cool. Ik ben weg.", "src": "Not cool. I'm out."},
{"key": "data.voice.surfer.leaving.2", "text": "Yeah, nee. Ik ga.", "src": "Yeah, no. Bailing."},
{"key": "data.voice.surfer.order.0", "text": "Dude, een {drink}.", "src": "Dude, a {drink}."},
{"key": "data.voice.surfer.order.1", "text": "Mag ik, zeg maar, een {drink}?", "src": "Can I get, like, a {drink}?"},
{"key": "data.voice.surfer.order.2", "text": "{drink}, graag. Chill, geen haast.", "src": "{drink}, please. Chill, no rush."},
{"key": "data.voice.surfer.order.3", "text": "Yeah, een {drink} klinkt epic.", "src": "Yeah, a {drink} sounds epic."},
{"key": "data.voice.surfer.perfect.0", "text": "Dude. Ja.", "src": "Dude. Yes."},
{"key": "data.voice.surfer.perfect.1", "text": "Stoked, man!", "src": "Stoked!"},
{"key": "data.voice.surfer.perfect.2", "text": "Zo goed!", "src": "So good!"},
{"key": "data.voice.surfer.praise.0", "text": "Oké, dit is echt perfect. Respect.", "src": "Okay, that's actually perfect. Respect."},
{"key": "data.voice.surfer.praise.1", "text": "Dude. Geen grap. Geweldig.", "src": "Dude. I'm not even kidding. Amazing."},
{"key": "data.voice.surfer.praise.2", "text": "Gnarly. Op een goede manier.", "src": "Gnarly. In a good way."},
