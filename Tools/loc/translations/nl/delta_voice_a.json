{"strings": [
{"key": "data.voice.african.another.0", "text": "Breng er nog één!", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "Nog eentje, abeg!", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "Nog een keer, mijn vriend!", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "Het is goed.", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "No wahala, hoor.", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "Oké, dank je.", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "Ah ah! Serieus?", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala. Ik ga al.", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "Mijn vriend, dit is niet netjes.", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah ah. Ik heb lang genoeg gewacht.", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala. Ik ga ervandoor.", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "Laat maar, mijn vriend. Ik ga.", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "Een {drink}, alsjeblieft.", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "Eén {drink}, mijn vriend.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Ik neem een {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "{drink}, abeg.", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "Ah, lekker!", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "Helemaal correct!", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "Deze is mooi!", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, deze is correct. Dank je wel.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "No wahala, echt niet. Heel mooi.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "Mijn vriend, jij kent je vak.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "Mijn vriend, {advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg, {advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "Het is goed, maar {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah, nee.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "Dit is hem niet.", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "Mijn vriend, nee.", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "Nog eentje, mate!", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "Nog één, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "Go on, nog eentje!", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "Niet slecht, hoor.", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Ta, dat is prima.", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "Prima, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Charmant. Werkelijk charmant.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "Right. Nou. Bedankt voor niks.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "Je maakt een grapje, toch?", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Right. Ik heb lang genoeg gewacht.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "Laat maar zitten. I'm off.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Beetje rubbish, dit. Doei.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "Een {drink}, mate, als je even tijd hebt.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, graag. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "Go on then, een {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "Doe mij maar een {drink}, ta.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "Lovely, zeg!", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "Top, mate!", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "Proper lekker!", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Blimey. Die is echt lovely.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Dat heb je netjes gedaan.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Bloody goed, deze.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "Klein puntje: {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Kijk, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Beetje off, deze.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Eh, niet de mijne.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "Dit vroeg ik niet.", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "Nog eentje, yaar!", "src": "One more, yaar!"},
{"key": "data.voice.desi.another.1", "text": "Aur ek, nog één!", "src": "Aur ek!"},
{"key": "data.voice.desi.another.2", "text": "Nog een keer, alsjeblieft!", "src": "Again, please!"},
{"key": "data.voice.desi.close.0", "text": "Theek hai, prima.", "src": "Theek hai."},
{"key": "data.voice.desi.close.1", "text": "Is oké, na.", "src": "It is okay, na."},
{"key": "data.voice.desi.close.2", "text": "Chalega, hoor.", "src": "Chalega."},
{"key": "data.voice.desi.kicked.0", "text": "Kya? Serieus?", "src": "Kya? Seriously?"},
{"key": "data.voice.desi.kicked.1", "text": "Arre. Oké, prima.", "src": "Arre. Okay, fine."},
{"key": "data.voice.desi.kicked.2", "text": "Chalo. Ik ga.", "src": "Chalo. I go."},
{"key": "data.voice.desi.leaving.0", "text": "Arre yaar. Veel te lang.", "src": "Arre yaar. Too long."},
{"key": "data.voice.desi.leaving.1", "text": "Chalo, ik ga ervandoor.", "src": "Chalo, I am going."},
{"key": "data.voice.desi.leaving.2", "text": "Bas. Genoeg.", "src": "Bas. Enough."},
{"key": "data.voice.desi.order.0", "text": "Eén {drink}, alsjeblieft.", "src": "One {drink}, please."},
{"key": "data.voice.desi.order.1", "text": "Een {drink}, yaar.", "src": "A {drink}, yaar."},
{"key": "data.voice.desi.order.2", "text": "Ik neem een {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.desi.order.3", "text": "{drink}, na?", "src": "{drink}, na?"},
{"key": "data.voice.desi.perfect.0", "text": "Wah, perfect!", "src": "Wah, perfect!"},
{"key": "data.voice.desi.perfect.1", "text": "Ekdum eersteklas!", "src": "Ekdum first class!"},
{"key": "data.voice.desi.perfect.2", "text": "Bahut badhiya!", "src": "Bahut badhiya!"},
{"key": "data.voice.desi.praise.0", "text": "Wah. Ekdum perfect, yaar.", "src": "Wah. Ekdum perfect, yaar."},
{"key": "data.voice.desi.praise.1", "text": "Bahut badhiya. Echt waar.", "src": "Bahut badhiya. Really."},
{"key": "data.voice.desi.praise.2", "text": "Eersteklas. Ik kom terug.", "src": "First class. I am coming back."},
{"key": "data.voice.desi.sip.0", "text": "Arre, {advice_l}", "src": "Arre, {advice_l}"},
{"key": "data.voice.desi.sip.1", "text": "Yaar, {advice_l}", "src": "Yaar, {advice_l}"},
{"key": "data.voice.desi.sip.2", "text": "Theek hai, maar {advice_l}", "src": "Theek hai, but {advice_l}"},
{"key": "data.voice.desi.wrong.0", "text": "Arre, nee.", "src": "Arre, no."},
{"key": "data.voice.desi.wrong.1", "text": "Dit is niet de mijne.", "src": "This is not mine."},
{"key": "data.voice.desi.wrong.2", "text": "Nahi, verkeerde.", "src": "Nahi, wrong one."},
{"key": "data.voice.german.another.0", "text": "Noch eins! Nog één!", "src": "Noch eins!"},
{"key": "data.voice.german.another.1", "text": "Nog één, bitte!", "src": "Another, bitte!"},
{"key": "data.voice.german.another.2", "text": "Nog een keer, graag!", "src": "Again, please!"},
{"key": "data.voice.german.close.0", "text": "Ja, oké.", "src": "Ja, okay."},
{"key": "data.voice.german.close.1", "text": "Acceptabel.", "src": "Acceptable."},
{"key": "data.voice.german.close.2", "text": "Het is in orde.", "src": "It is fine."},
{"key": "data.voice.german.kicked.0", "text": "Dit is absurd.", "src": "This is absurd."},
{"key": "data.voice.german.kicked.1", "text": "Goed. Ik kom niet terug.", "src": "Fine. I will not return."},
{"key": "data.voice.german.kicked.2", "text": "Ja, ja. Ik ga al.", "src": "Ja, ja. I am going."},
{"key": "data.voice.german.leaving.0", "text": "Dit is niet acceptabel. Ik vertrek.", "src": "This is not acceptable. I am leaving."},
{"key": "data.voice.german.leaving.1", "text": "Nein. Ik heb lang genoeg gewacht.", "src": "Nein. I have waited enough."},
{"key": "data.voice.german.leaving.2", "text": "Unglaublich. Tot ziens.", "src": "Unglaublich. Goodbye."},
{"key": "data.voice.german.order.0", "text": "Een {drink}, graag. Correct gemaakt.", "src": "A {drink}, please. Correctly made."},
{"key": "data.voice.german.order.1", "text": "{drink}. Danke.", "src": "{drink}. Thank you."},
{"key": "data.voice.german.order.2", "text": "Eén {drink}, bitte.", "src": "One {drink}, bitte."},
{"key": "data.voice.german.order.3", "text": "Ik zou graag een {drink} willen.", "src": "I would like a {drink}."},
{"key": "data.voice.german.perfect.0", "text": "Genau, precies!", "src": "Genau!"},
{"key": "data.voice.german.perfect.1", "text": "Sehr gut, zeg!", "src": "Sehr gut!"},
{"key": "data.voice.german.perfect.2", "text": "Wunderbar!", "src": "Wunderbar!"},
{"key": "data.voice.german.praise.0", "text": "Ja. Dit is precies goed.", "src": "Ja. This is exactly right."},
{"key": "data.voice.german.praise.1", "text": "Nauwkeurig. Ik respecteer nauwkeurigheid.", "src": "Precise. I respect precision."},
{"key": "data.voice.german.praise.2", "text": "Sehr gut. Geen opmerkingen.", "src": "Sehr gut. No notes."},
{"key": "data.voice.german.sip.0", "text": "Genau, maar {advice_l}", "src": "Genau, but {advice_l}"},
{"key": "data.voice.german.sip.1", "text": "Eén opmerking: {advice_l}", "src": "One remark: {advice_l}"},
{"key": "data.voice.german.sip.2", "text": "Ja, {advice_l}", "src": "Ja, {advice_l}"},
{"key": "data.voice.german.wrong.0", "text": "Nein. Dit niet.", "src": "Nein. Not this."},
{"key": "data.voice.german.wrong.1", "text": "Dit is incorrect.", "src": "This is incorrect."},
{"key": "data.voice.german.wrong.2", "text": "Verkeerd drankje.", "src": "Wrong drink."},
{"key": "data.voice.korean.another.0", "text": "Han jan deo! Nog één!", "src": "Han jan deo!"},
{"key": "data.voice.korean.another.1", "text": "Nog eentje!", "src": "One more!"},
{"key": "data.voice.korean.another.2", "text": "Nog een keer, juseyo!", "src": "Again, juseyo!"},
{"key": "data.voice.korean.close.0", "text": "Gwenchana, prima.", "src": "Gwenchana."},
{"key": "data.voice.korean.close.1", "text": "Het is oké.", "src": "It is okay."},
{"key": "data.voice.korean.close.2", "text": "Nappeuji anha. Niet slecht.", "src": "Nappeuji anha."},
{"key": "data.voice.korean.kicked.0", "text": "Jinjja? Wow, zeg.", "src": "Jinjja? Wow."},
{"key": "data.voice.korean.kicked.1", "text": "Aish. Goed dan.", "src": "Aish. Fine."},
{"key": "data.voice.korean.kicked.2", "text": "Annyeong, dan maar.", "src": "Annyeong, then."},
{"key": "data.voice.korean.leaving.0", "text": "Aish. Veel te lang.", "src": "Aish. Too long."},
{"key": "data.voice.korean.leaving.1", "text": "Ik ga. Annyeong.", "src": "I am going. Annyeong."},
{"key": "data.voice.korean.leaving.2", "text": "Mot chamgesseo. Ik ga.", "src": "Mot chamgesseo."},
{"key": "data.voice.korean.order.0", "text": "{drink}, juseyo.", "src": "{drink}, juseyo."},
{"key": "data.voice.korean.order.1", "text": "Eén {drink}, alsjeblieft.", "src": "One {drink}, please."},
{"key": "data.voice.korean.order.2", "text": "Een {drink} voor mij.", "src": "A {drink} for me."},
{"key": "data.voice.korean.order.3", "text": "Ik wil een {drink}.", "src": "I want a {drink}."},
{"key": "data.voice.korean.perfect.0", "text": "Daebak!", "src": "Daebak!"},
{"key": "data.voice.korean.perfect.1", "text": "Jinjja goed!", "src": "Jinjja good!"},
{"key": "data.voice.korean.perfect.2", "text": "Choego!", "src": "Choego!"},
{"key": "data.voice.korean.praise.0", "text": "Daebak. Jinjja, dit is perfect.", "src": "Daebak. Jinjja, this is perfect."},
{"key": "data.voice.korean.praise.1", "text": "Choego. Ik meen het.", "src": "Choego. I mean it."},
{"key": "data.voice.korean.praise.2", "text": "Wow. Jij bent hier goed in.", "src": "Wow. You are good at this."},
{"key": "data.voice.korean.sip.0", "text": "Jamkkanman, {advice_l}", "src": "Jamkkanman, {advice_l}"},
{"key": "data.voice.korean.sip.1", "text": "Eh, {advice_l}", "src": "Um, {advice_l}"},
{"key": "data.voice.korean.sip.2", "text": "Gwenchana, maar {advice_l}", "src": "Gwenchana, but {advice_l}"},
{"key": "data.voice.korean.wrong.0", "text": "Aniyo, nee.", "src": "Aniyo, no."},
{"key": "data.voice.korean.wrong.1", "text": "Dit klopt niet.", "src": "This is wrong."},
{"key": "data.voice.korean.wrong.2", "text": "Eh? Niet de mijne.", "src": "Eh? Not mine."},
{"key": "data.voice.nordic.another.0", "text": "Nog één. Skål!", "src": "Another. Skål!"},
{"key": "data.voice.nordic.another.1", "text": "Nog eentje.", "src": "One more."},
{"key": "data.voice.nordic.another.2", "text": "Nog een keer, graag.", "src": "Again, please."},
{"key": "data.voice.nordic.close.0", "text": "Prima.", "src": "Fine."},
{"key": "data.voice.nordic.close.1", "text": "Het is oké.", "src": "It's okay."},
{"key": "data.voice.nordic.close.2", "text": "Goed genoeg.", "src": "Good enough."},
{"key": "data.voice.nordic.kicked.0", "text": "Oké. Vreemd, maar oké.", "src": "Okay. Strange, but okay."},
{"key": "data.voice.nordic.kicked.1", "text": "Prima dan.", "src": "Fine."},
{"key": "data.voice.nordic.kicked.2", "text": "Hm. Dag dan.", "src": "Hm. Goodbye then."},
{"key": "data.voice.nordic.leaving.0", "text": "Ik ga. Het is goed.", "src": "I'll go. It's fine."},
{"key": "data.voice.nordic.leaving.1", "text": "Te lang. Dag.", "src": "Too long. Goodbye."},
{"key": "data.voice.nordic.leaving.2", "text": "Nee. Ik vertrek.", "src": "No. I'm leaving."},
{"key": "data.voice.nordic.order.0", "text": "Een {drink}. Dank je.", "src": "A {drink}. Thanks."},
{"key": "data.voice.nordic.order.1", "text": "{drink}, graag.", "src": "{drink}, please."},
{"key": "data.voice.nordic.order.2", "text": "Eén {drink}. Geen haast.", "src": "One {drink}. No rush."},
{"key": "data.voice.nordic.order.3", "text": "Doe maar {drink}.", "src": "I'll have the {drink}."},
{"key": "data.voice.nordic.perfect.0", "text": "Skål!", "src": "Skål!"},
{"key": "data.voice.nordic.perfect.1", "text": "Heel goed.", "src": "Very good."},
{"key": "data.voice.nordic.perfect.2", "text": "Ja. Goed.", "src": "Yes. Good."},
{"key": "data.voice.nordic.praise.0", "text": "Dit is heel goed. Dat zeg ik niet vaak.", "src": "This is very good. I don't say that."},
{"key": "data.voice.nordic.praise.1", "text": "Skål. Netjes gedaan.", "src": "Skål. Properly done."},
{"key": "data.voice.nordic.praise.2", "text": "Goed. Echt goed.", "src": "Good. Really good."},
{"key": "data.voice.nordic.sip.0", "text": "Tja. {advice}", "src": "Well. {advice}"},
{"key": "data.voice.nordic.sip.1", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.nordic.sip.2", "text": "Prima, maar {advice_l}", "src": "Fine, but {advice_l}"},
{"key": "data.voice.nordic.wrong.0", "text": "Nee. Verkeerde.", "src": "No. Wrong one."},
{"key": "data.voice.nordic.wrong.1", "text": "Dit is hem niet.", "src": "This is not it."},
{"key": "data.voice.nordic.wrong.2", "text": "Hm. Niet de mijne.", "src": "Hm. Not mine."},
{"key": "data.voice.southern.another.0", "text": "Schenk er nog eentje in!", "src": "Pour me another!"},
{"key": "data.voice.southern.another.1", "text": "Nog één, sugar!", "src": "One more, sugar!"},
{"key": "data.voice.southern.another.2", "text": "Keep 'em comin', hoor!", "src": "Keep 'em comin'!"},
{"key": "data.voice.southern.close.0", "text": "Dat is alright.", "src": "That's alright."},
{"key": "data.voice.southern.close.1", "text": "Fair enough, hoor.", "src": "Fair enough."},
{"key": "data.voice.southern.close.2", "text": "Nou, het kan ermee door.", "src": "Well, it'll do."},
{"key": "data.voice.southern.kicked.0", "text": "Nou, dat is gewoon onbeleefd.", "src": "Well, that's just rude."},
{"key": "data.voice.southern.kicked.1", "text": "Alright dan. Have a good one.", "src": "Alright then. Have a good one."},
{"key": "data.voice.southern.kicked.2", "text": "Wacht eens even… prima.", "src": "Now hold on… fine."},
{"key": "data.voice.southern.leaving.0", "text": "Nou, ik heb niet de hele avond.", "src": "Well, I ain't got all night."},
{"key": "data.voice.southern.leaving.1", "text": "Reckon ik ga ergens anders drinken.", "src": "Reckon I'll drink elsewhere."},
{"key": "data.voice.southern.leaving.2", "text": "Y'all nemen je tijd, hè.", "src": "Y'all take your sweet time, don't you."},
{"key": "data.voice.southern.order.0", "text": "Well now, een {drink} zou me goed doen.", "src": "Well now, a {drink} would suit me."},
{"key": "data.voice.southern.order.1", "text": "{drink}, darlin', als je zo goed wilt zijn.", "src": "{drink}, darlin', if you please."},
{"key": "data.voice.southern.order.2", "text": "Reckon ik neem een {drink}.", "src": "Reckon I'll have a {drink}."},
{"key": "data.voice.southern.order.3", "text": "Eén {drink}, sugar.", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "Nou, is dat even fijn!", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "Lord, wat goed!", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "Hot dang, zeg!", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "Well, I'll be. Dat is een echt drankje.", "src": "Well, I'll be. That's a proper drink."},
{"key": "data.voice.southern.praise.1", "text": "Darlin', jij hebt een gave.", "src": "Darlin', you got a gift."},
{"key": "data.voice.southern.praise.2", "text": "Reckon ik heb mijn nieuwe stek gevonden.", "src": "Reckon I found my new spot."},
{"key": "data.voice.southern.sip.0", "text": "Nou, {advice_l}", "src": "Now, {advice_l}"},
{"key": "data.voice.southern.sip.1", "text": "Sugar, {advice_l}", "src": "Sugar, {advice_l}"},
