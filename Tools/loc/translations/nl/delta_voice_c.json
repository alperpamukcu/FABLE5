{"strings": [
{"key": "data.voice.aussie.another.0", "text": "Nog eentje, mate!", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "Nog één, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "Nog eentje, legend!", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "Yeah, righto, prima.", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "Niet slecht, mate.", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "Kan ermee door.", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "Meen je dat, mate?", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto. Eerlijk is eerlijk.", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Nah, dat is rough.", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto, ik heb lang genoeg gewacht.", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Nah, laat maar. Ik ben weg.", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "Bedankt voor niks, mate.", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "Een {drink}, mate.", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink}, graag.", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "Ik pak een {drink}.", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "Eén {drink}, cheers.", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "Ripper!", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "Too easy, zeg!", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "Bloody goed!", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "Bloody ripper, mate. Cheers.", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "Too easy. Jij kent je vak.", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "Beste van de avond, echt waar.", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "Kijk, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "No dramas, maar {advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Nah, mate. Nee.", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "Niet de mijne, sorry.", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "Verkeerde, mate.", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "Nog een rondje!", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "Doe er nog maar één!", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "Blijven komen!", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "Dank je.", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "Kan ermee door.", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "Bijna goed.", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "Serieus? Prima.", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "Daar krijg je spijt van.", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "Laat maar. Hou je bar maar.", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "Laat maar. Ik wacht niet langer.", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "Werkt hier vanavond iemand?", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "Oké. Dan drink ik wel ergens anders.", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink}, graag.", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "Doe mij maar een {drink}.", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "Een {drink}, als je even tijd hebt.", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "Maak er maar een {drink} van.", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "Perfect, zeg!", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "Dat is 'm!", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "Helemaal goed!", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "Ik zou er niks aan veranderen.", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "Dát is nou een drankje.", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "Wie jou dit geleerd heeft: bedankt.", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice} Zeg ik maar even.", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "Eerlijk? {advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "Dit vroeg ik niet.", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "Verkeerd drankje.", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "Die is niet van mij.", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "Encore, alsjeblieft!", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "Nog eentje, oui!", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "Nog een keer, merci!", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ça va, prima.", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "Het is goed.", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon, oké.", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "Quoi? Echt?", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Bon. Au revoir, dan.", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule, zeg.", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non. Ik heb lang genoeg gewacht.", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis. Ik ga.", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "Au revoir, dan maar.", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "Een {drink}, s'il vous plaît.", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "{drink}, graag.", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "Een {drink}, merci.", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "Ik neem een {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "Parfait!", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "Voilà, perfect!", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "Magnifique!", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait. Ik heb helemaal niets op te merken.", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voilà. Hier kan iemand schenken.", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique. Echt waar.", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Écoute, {advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon, {advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors, {advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non. Nee.", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "Dit is hem niet.", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon, verkeerd.", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "Mou ippai! Nog één!", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "Nog eentje, kanpai!", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "Nog een keer, onegai!", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Hai, oké.", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa, gaat wel.", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "Niet slecht, ne.", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "Eh?! Echt?", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi. Oké, ik ga.", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta. Sayonara dan.", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen, ik kan niet langer wachten.", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii. Ik ga.", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai. Dag.", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen, een {drink}.", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "Eén {drink}, onegai.", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink}, graag. Arigatou.", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto… een {drink}.", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "Oishii!", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "Sugoi, perfect!", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "Kanpai!", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii. Echt, dit is hem.", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "Sugoi. Jij bent een pro, ne.", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "Kanpai. Dit is perfect.", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "Etto, {advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "Ne, {advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "Sumimasen, maar {advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "Chotto… nee.", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "Eh? Dit niet.", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "Chigau, sorry.", "src": "Chigau, sorry."},
{"key": "data.voice.midwest.another.0", "text": "Nog eentje, graag!", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "Nog één, dank je!", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "Nog een keer, ope!", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "Oh, dat is prima.", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "Tuurlijk, dank je.", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "Helemaal niet slecht.", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "Oh. Nou. Oké dan.", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "Ope, sorry… ik ga al.", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "Beetje veel, maar oké.", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "Oh gosh, ik kan echt niet langer wachten.", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "Nou, ik moest maar eens gaan.", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "Sorry, maar ik ga ervandoor.", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "Mag ik een {drink}? Thanks a bunch.", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "Een {drink}, als het geen moeite is.", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "Oh, doe mij maar gewoon een {drink}.", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink}, graag. Geen haast.", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "Oh, echt fijn!", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "You betcha, hoor!", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "Oh jeez, ja!", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "Oh my gosh, dat is gewoon heerlijk.", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "Echt fijn. Mijn tante zou deze zaak geweldig vinden.", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "Nou, dat deed me goed.", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "Oh, {advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "Even dat je het weet, {advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "Geen punt, maar {advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "Ope. Verkeerde.", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "Oh, die is niet van mij.", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "Sorry, nee. Dit niet.", "src": "Sorry, no. Not this."},
{"key": "data.voice.polish.another.0", "text": "Jeszcze raz! Nog één!", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "Nog eentje, proszę!", "src": "Another, proszę!"},
{"key": "data.voice.polish.another.2", "text": "Nog een keer!", "src": "One more!"},
{"key": "data.voice.polish.close.0", "text": "Dobrze. Prima.", "src": "Dobrze."},
{"key": "data.voice.polish.close.1", "text": "Oké.", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "Prima, dank je.", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "Serio? Nou, oké.", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "Prima. Do widzenia.", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "Co? Oké, ik ga.", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "Genoeg. Ik ga.", "src": "Enough. I'm going."},
{"key": "data.voice.polish.leaving.1", "text": "Nie, nie. Te lang.", "src": "Nie, nie. Too long."},
{"key": "data.voice.polish.leaving.2", "text": "Do widzenia, hoor.", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "Een {drink}, proszę.", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "{drink}, graag.", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "Eén {drink}. Dank je.", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "Dobrze, een {drink}.", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "Na zdrowie!", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "Świetnie!", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "Heel goed!", "src": "Very good!"},
{"key": "data.voice.polish.praise.0", "text": "Na zdrowie. Dit is een echt drankje.", "src": "Na zdrowie. This is a real drink."},
{"key": "data.voice.polish.praise.1", "text": "Świetnie. Net als thuis.", "src": "Świetnie. Like at home."},
{"key": "data.voice.polish.praise.2", "text": "Dobrze. Heel, heel goed.", "src": "Dobrze. Very, very good."},
{"key": "data.voice.polish.sip.0", "text": "Dobrze, maar {advice_l}", "src": "Dobrze, but {advice_l}"},
{"key": "data.voice.polish.sip.1", "text": "Luister, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.polish.sip.2", "text": "Hm, {advice_l}", "src": "Hm, {advice_l}"},
{"key": "data.voice.polish.wrong.0", "text": "Nie. Verkeerde.", "src": "Nie. Wrong one."},
{"key": "data.voice.polish.wrong.1", "text": "Dit is niet de mijne.", "src": "This is not mine."},
{"key": "data.voice.polish.wrong.2", "text": "Co to jest? Nee.", "src": "Co to jest?"},
{"key": "data.voice.turkish.another.0", "text": "Bir daha! Nog één!", "src": "Bir daha!"},
{"key": "data.voice.turkish.another.1", "text": "Nog eentje, abi!", "src": "Another, abi!"},
{"key": "data.voice.turkish.another.2", "text": "Nog een keer, eyvallah!", "src": "Again, eyvallah!"},
{"key": "data.voice.turkish.close.0", "text": "Tamam, prima.", "src": "Tamam."},
{"key": "data.voice.turkish.close.1", "text": "İdare eder.", "src": "İdare eder."},
{"key": "data.voice.turkish.close.2", "text": "Oké, het is goed.", "src": "Okay, fine."},
{"key": "data.voice.turkish.kicked.0", "text": "Ciddi misin? Oké.", "src": "Ciddi misin? Okay."},
{"key": "data.voice.turkish.kicked.1", "text": "Abi, echt? Prima.", "src": "Abi, really? Fine."},
{"key": "data.voice.turkish.kicked.2", "text": "Yok, yok. Ik ga.", "src": "Yok, yok. I'm going."},
{"key": "data.voice.turkish.leaving.0", "text": "Yok, ik wacht niet langer.", "src": "Yok, I'm not waiting anymore."},
{"key": "data.voice.turkish.leaving.1", "text": "Abi, werkt hier niemand?", "src": "Abi, is nobody working here?"},
{"key": "data.voice.turkish.leaving.2", "text": "Tamam, hoşça kal.", "src": "Tamam, hoşça kal."},
{"key": "data.voice.turkish.order.0", "text": "Abi, een {drink}.", "src": "Abi, a {drink}."},
{"key": "data.voice.turkish.order.1", "text": "Eén {drink}, eyvallah.", "src": "One {drink}, eyvallah."},
{"key": "data.voice.turkish.order.2", "text": "{drink}, canım, als je kunt.", "src": "{drink}, canım, when you can."},
{"key": "data.voice.turkish.order.3", "text": "Bir {drink}, graag.", "src": "Bir {drink}, please."},
{"key": "data.voice.turkish.perfect.0", "text": "Eyvallah!", "src": "Eyvallah!"},
{"key": "data.voice.turkish.perfect.1", "text": "Harika!", "src": "Harika!"},
{"key": "data.voice.turkish.perfect.2", "text": "Süper, abi!", "src": "Süper, abi!"},
{"key": "data.voice.turkish.praise.0", "text": "Eyvallah. Zo doe je dat.", "src": "Eyvallah. This is how it's done."},
{"key": "data.voice.turkish.praise.1", "text": "Abi, petje af. Harika.", "src": "Abi, my hat is off. Harika."},
{"key": "data.voice.turkish.praise.2", "text": "Tamam, jij kent je vak.", "src": "Tamam, you know your work."},
{"key": "data.voice.turkish.sip.0", "text": "Abi, {advice_l}", "src": "Abi, {advice_l}"},
