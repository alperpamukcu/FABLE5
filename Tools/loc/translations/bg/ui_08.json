{"key": "rule.snack_needs_order", "text": "Мезетата вървят с поръчка на питие — а поръчка още няма.", "src": "Snacks ride a drink order — they have not ordered one yet."},
{"key": "rule.snack_not_at_bar", "text": "Не е на бара.", "src": "They are not at the bar."},
{"key": "rule.still_choosing", "text": "Още избира.", "src": "They are still choosing."},
{"key": "rule.still_talking", "text": "Още говори. Нищо не е поръчано.", "src": "They are still talking. Nothing ordered yet."},
{"key": "rule.stir_empty", "text": "В шейкъра няма нищо за разбъркване.", "src": "Nothing in the shaker to stir."},
{"key": "rule.trial_not_asked", "text": "Още нищо не е поискано.", "src": "They have not asked for anything yet."},
