{"key": "rule.already_at_bar", "text": "Вече е на бара.", "src": "They are already at the bar."},
{"key": "rule.bar_top_best", "text": "Плотът на бара вече е най-добрият.", "src": "The bar top is already the best one."},
{"key": "rule.bottle_owned", "text": "Тази бутилка вече е твоя.", "src": "That bottle is already yours."},
{"key": "rule.card_not_read", "text": "Картата не е прочетена; документите са зад нея.", "src": "The card has not been read; the papers are behind it."},
{"key": "rule.counter_clean", "text": "Тук тезгяхът е чист.", "src": "The counter is clean here."},
{"key": "rule.drink_in_shaker", "text": "Питието още е в шейкъра — първо го налей в чаша.", "src": "That drink is still in the shaker — pour it into a glass first."},
{"key": "rule.fixture_needs_stars", "text": "{fixture}: трябва зала с {stars} звезди; този бар е на {rating}.", "src": "{fixture} needs a {stars}-star room; this bar rates {rating}."},
{"key": "rule.fixture_owned", "text": "Барът вече има това: {fixture}.", "src": "The bar already has {fixture}."},
{"key": "rule.fixture_rung_one_at_a_time", "text": "{fixture} е стъпало {level} от стълбата си; барът е на стъпало {bar_level}. Качва се по едно стъпало.", "src": "{fixture} is rung {level} of its ladder; the bar stands on rung {bar_level}. It climbs one rung at a time."},
{"key": "rule.fixture_tower_one_line", "text": "{fixture} има {lines} линии; този бар има {bar_lines}. Кулата се слага по една линия.", "src": "{fixture} runs {lines} lines; this bar runs {bar_lines}. A tower is fitted one line at a time."},
{"key": "rule.glass_line_finest", "text": "Чаши: {glass} — вече са най-добрите.", "src": "The {glass} line is already the finest."},
{"key": "rule.kick_already_served", "text": "Не можеш да покажеш вратата на някого, когото вече обслужи; моментът беше при картата.", "src": "You cannot show the door to someone you have already served; the card was your moment."},
{"key": "rule.kick_guest_of_house", "text": "На госта на заведението не ти е работа да показваш вратата.", "src": "The guest of the house is not yours to show the door."},
{"key": "rule.kick_read_card_first", "text": "Първо прочети картата.", "src": "Read the card first."},
{"key": "rule.no_glass_to_collect", "text": "Тук няма чаша за прибиране.", "src": "There is no glass here to collect."},
{"key": "rule.no_last_call", "text": "Никой не чака последната поръчка.", "src": "Nobody is waiting on the last call."},
{"key": "rule.no_pourable_drinks", "text": "Още няма напитки, които можеш да налееш.", "src": "No drinks you can pour yet."},
{"key": "rule.no_room_stool", "text": "Няма място за още един стол.", "src": "No room for another stool."},
{"key": "rule.not_enough_money", "text": "Няма достатъчно пари ({money} < {price}).", "src": "Not enough money ({money} < {price})."},
{"key": "rule.not_on_counter", "text": "Това не е на този тезгях.", "src": "That is not on this counter."},
{"key": "rule.not_ordered", "text": "Още няма поръчка.", "src": "They have not ordered yet."},
{"key": "rule.not_waiting", "text": "Вече не чака.", "src": "They are not waiting any more."},
{"key": "rule.not_waiting_at_bar", "text": "Не чака на бара.", "src": "They are not waiting at the bar."},
{"key": "rule.nothing_to_serve", "text": "Няма какво да сервираш.", "src": "Nothing to serve."},
{"key": "rule.nothing_to_wash", "text": "Нямаш нищо в ръцете за миене.", "src": "There is nothing in your hands to wash."},
{"key": "rule.one_fitting_a_night", "text": "По едно обзавеждане на нощ — останалото чака до утре.", "src": "One fitting a night — the rest keeps until tomorrow."},
{"key": "rule.pour_unmixed", "text": "Два алкохола в шейкъра — разклати или разбъркай, преди да отиде в чашата.", "src": "Two spirits in the tin — shake it or stir it before it goes to the glass."},
{"key": "rule.pull_cocktail_in_tin", "text": "Довърши коктейла или го изхвърли, преди да точиш бира.", "src": "Finish or bin the cocktail before you pull a pint."},
{"key": "rule.pull_glass_full", "text": "Чашата е пълна. Сервирай я или я изхвърли.", "src": "The glass is full. Serve it or bin it."},
{"key": "rule.pull_glass_taken", "text": "В тази чаша вече има питие — сервирай го или го изхвърли, преди да точиш бира.", "src": "There is already a drink in that glass — serve it or bin it before pulling a pint."},
{"key": "rule.recipe_not_earned", "text": "Рецептата {recipe} още не е отключена — {lock}.", "src": "{recipe} is not earned yet — {lock}."},
{"key": "rule.recipe_short_money", "text": "Няма достатъчно пари — {recipe} струва {price}.", "src": "Not enough money — {recipe} costs {price}."},
{"key": "rule.refund_under_rung", "text": "{fixture} е под по-високо стъпало; първо върни него.", "src": "{fixture} is under a higher rung; take that one back first."},
{"key": "rule.refund_under_tower", "text": "{fixture} е под кулата с {lines} линии; първо върни нея.", "src": "{fixture} is under the {lines}-line tower; take that one back first."},
{"key": "rule.shake_empty", "text": "В шейкъра няма нищо за разклащане.", "src": "Nothing in the shaker to shake."},
