{"strings": [
{"key": "data.voice.african.another.0", "text": "Дай още едно!", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "Още едно, abeg!", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "Пак, приятелю!", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "Става.", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "No wahala.", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "Добре, благодаря.", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "Ah ah! Сериозно ли?", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala. Тръгвам.", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "Приятелю, това не е хубаво.", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah ah. Чаках достатъчно.", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala. Отивам си.", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "Ще си ходя, приятелю.", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "{drink}, моля.", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "За мен: {drink}, приятелю.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Ще взема {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "{drink}, abeg.", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "Ah, сладко!", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "Точно така!", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "Това е хубаво!", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, това е както трябва. Благодаря.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "Изобщо no wahala. Много хубаво.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "Приятелю, ти си учен човек.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "Приятелю, {advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg, {advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "Става, но {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah, не.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "Не е това.", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "Приятелю, не.", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "Същото пак, mate!", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "Още едно, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "Давай, още едно!", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "Не е зле.", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Ta, става.", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "Добре, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Очарователно. Направо очарователно.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "Така. Ами. Cheers за нищо.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "Майтап си правиш.", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Така. Чаках достатъчно.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "Стига толкова. Тръгвам.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Жалка работа. Чао.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "{drink}, mate, като имаш секунда.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, моля. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "Хайде тогава: {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "Ще взема {drink}, ta.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "Прекрасно!", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "Cheers, mate!", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "Бива си го!", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Blimey. Това наистина е прекрасно.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Направено както си трябва.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Bloody добро, това.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "Само едно нещо: {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Виж, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Малко не е това.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Ъм, не е моето.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "Не това поисках.", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "Още едно, yaar!", "src": "One more, yaar!"},
{"key": "data.voice.desi.another.1", "text": "Aur ek!", "src": "Aur ek!"},
{"key": "data.voice.desi.another.2", "text": "Пак, моля!", "src": "Again, please!"},
{"key": "data.voice.desi.close.0", "text": "Theek hai.", "src": "Theek hai."},
{"key": "data.voice.desi.close.1", "text": "Става, na.", "src": "It is okay, na."},
{"key": "data.voice.desi.close.2", "text": "Chalega.", "src": "Chalega."},
{"key": "data.voice.desi.kicked.0", "text": "Kya? Сериозно?", "src": "Kya? Seriously?"},
{"key": "data.voice.desi.kicked.1", "text": "Arre. Добре, щом така.", "src": "Arre. Okay, fine."},
{"key": "data.voice.desi.kicked.2", "text": "Chalo. Тръгвам.", "src": "Chalo. I go."},
{"key": "data.voice.desi.leaving.0", "text": "Arre yaar. Много дълго.", "src": "Arre yaar. Too long."},
{"key": "data.voice.desi.leaving.1", "text": "Chalo, отивам си.", "src": "Chalo, I am going."},
{"key": "data.voice.desi.leaving.2", "text": "Bas. Стига.", "src": "Bas. Enough."},
{"key": "data.voice.desi.order.0", "text": "{drink}, моля.", "src": "One {drink}, please."},
{"key": "data.voice.desi.order.1", "text": "За мен: {drink}, yaar.", "src": "A {drink}, yaar."},
{"key": "data.voice.desi.order.2", "text": "Ще взема {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.desi.order.3", "text": "{drink}, na?", "src": "{drink}, na?"},
{"key": "data.voice.desi.perfect.0", "text": "Wah, перфектно!", "src": "Wah, perfect!"},
{"key": "data.voice.desi.perfect.1", "text": "Ekdum първа класа!", "src": "Ekdum first class!"},
{"key": "data.voice.desi.perfect.2", "text": "Bahut badhiya!", "src": "Bahut badhiya!"},
{"key": "data.voice.desi.praise.0", "text": "Wah. Ekdum перфектно, yaar.", "src": "Wah. Ekdum perfect, yaar."},
{"key": "data.voice.desi.praise.1", "text": "Bahut badhiya. Наистина.", "src": "Bahut badhiya. Really."},
{"key": "data.voice.desi.praise.2", "text": "Първа класа. Пак ще дойда.", "src": "First class. I am coming back."},
{"key": "data.voice.desi.sip.0", "text": "Arre, {advice_l}", "src": "Arre, {advice_l}"},
{"key": "data.voice.desi.sip.1", "text": "Yaar, {advice_l}", "src": "Yaar, {advice_l}"},
{"key": "data.voice.desi.sip.2", "text": "Theek hai, но {advice_l}", "src": "Theek hai, but {advice_l}"},
{"key": "data.voice.desi.wrong.0", "text": "Arre, не.", "src": "Arre, no."},
{"key": "data.voice.desi.wrong.1", "text": "Това не е моето.", "src": "This is not mine."},
{"key": "data.voice.desi.wrong.2", "text": "Nahi, грешно.", "src": "Nahi, wrong one."},
{"key": "data.voice.german.another.0", "text": "Noch eins!", "src": "Noch eins!"},
{"key": "data.voice.german.another.1", "text": "Още едно, bitte!", "src": "Another, bitte!"},
{"key": "data.voice.german.another.2", "text": "Пак, моля!", "src": "Again, please!"},
{"key": "data.voice.german.close.0", "text": "Ja, добре.", "src": "Ja, okay."},
{"key": "data.voice.german.close.1", "text": "Приемливо.", "src": "Acceptable."},
{"key": "data.voice.german.close.2", "text": "Става.", "src": "It is fine."},
{"key": "data.voice.german.kicked.0", "text": "Това е абсурдно.", "src": "This is absurd."},
{"key": "data.voice.german.kicked.1", "text": "Добре. Няма да се върна.", "src": "Fine. I will not return."},
{"key": "data.voice.german.kicked.2", "text": "Ja, ja. Тръгвам.", "src": "Ja, ja. I am going."},
{"key": "data.voice.german.leaving.0", "text": "Това не е приемливо. Тръгвам си.", "src": "This is not acceptable. I am leaving."},
{"key": "data.voice.german.leaving.1", "text": "Nein. Чаках достатъчно.", "src": "Nein. I have waited enough."},
{"key": "data.voice.german.leaving.2", "text": "Unglaublich. Довиждане.", "src": "Unglaublich. Goodbye."},
{"key": "data.voice.german.order.0", "text": "{drink}, моля. Правилно направено.", "src": "A {drink}, please. Correctly made."},
{"key": "data.voice.german.order.1", "text": "{drink}. Благодаря.", "src": "{drink}. Thank you."},
{"key": "data.voice.german.order.2", "text": "{drink}, bitte.", "src": "One {drink}, bitte."},
{"key": "data.voice.german.order.3", "text": "За мен {drink}, ако обичате.", "src": "I would like a {drink}."},
{"key": "data.voice.german.perfect.0", "text": "Genau!", "src": "Genau!"},
{"key": "data.voice.german.perfect.1", "text": "Sehr gut!", "src": "Sehr gut!"},
{"key": "data.voice.german.perfect.2", "text": "Wunderbar!", "src": "Wunderbar!"},
{"key": "data.voice.german.praise.0", "text": "Ja. Точно както трябва.", "src": "Ja. This is exactly right."},
{"key": "data.voice.german.praise.1", "text": "Прецизно. Уважавам прецизността.", "src": "Precise. I respect precision."},
{"key": "data.voice.german.praise.2", "text": "Sehr gut. Без забележки.", "src": "Sehr gut. No notes."},
{"key": "data.voice.german.sip.0", "text": "Genau, но {advice_l}", "src": "Genau, but {advice_l}"},
{"key": "data.voice.german.sip.1", "text": "Една забележка: {advice_l}", "src": "One remark: {advice_l}"},
{"key": "data.voice.german.sip.2", "text": "Ja, {advice_l}", "src": "Ja, {advice_l}"},
{"key": "data.voice.german.wrong.0", "text": "Nein. Не това.", "src": "Nein. Not this."},
{"key": "data.voice.german.wrong.1", "text": "Това е неправилно.", "src": "This is incorrect."},
{"key": "data.voice.german.wrong.2", "text": "Грешна напитка.", "src": "Wrong drink."},
{"key": "data.voice.korean.another.0", "text": "Han jan deo!", "src": "Han jan deo!"},
{"key": "data.voice.korean.another.1", "text": "Още едно!", "src": "One more!"},
{"key": "data.voice.korean.another.2", "text": "Пак, juseyo!", "src": "Again, juseyo!"},
{"key": "data.voice.korean.close.0", "text": "Gwenchana.", "src": "Gwenchana."},
{"key": "data.voice.korean.close.1", "text": "Става.", "src": "It is okay."},
{"key": "data.voice.korean.close.2", "text": "Nappeuji anha.", "src": "Nappeuji anha."},
{"key": "data.voice.korean.kicked.0", "text": "Jinjja? Уау.", "src": "Jinjja? Wow."},
{"key": "data.voice.korean.kicked.1", "text": "Aish. Добре.", "src": "Aish. Fine."},
{"key": "data.voice.korean.kicked.2", "text": "Annyeong тогава.", "src": "Annyeong, then."},
{"key": "data.voice.korean.leaving.0", "text": "Aish. Много дълго.", "src": "Aish. Too long."},
{"key": "data.voice.korean.leaving.1", "text": "Тръгвам. Annyeong.", "src": "I am going. Annyeong."},
{"key": "data.voice.korean.leaving.2", "text": "Mot chamgesseo. Не издържам.", "src": "Mot chamgesseo."},
{"key": "data.voice.korean.order.0", "text": "{drink}, juseyo.", "src": "{drink}, juseyo."},
{"key": "data.voice.korean.order.1", "text": "{drink}, моля.", "src": "One {drink}, please."},
{"key": "data.voice.korean.order.2", "text": "За мен: {drink}.", "src": "A {drink} for me."},
{"key": "data.voice.korean.order.3", "text": "Искам {drink}.", "src": "I want a {drink}."},
{"key": "data.voice.korean.perfect.0", "text": "Daebak!", "src": "Daebak!"},
{"key": "data.voice.korean.perfect.1", "text": "Jinjja хубаво!", "src": "Jinjja good!"},
{"key": "data.voice.korean.perfect.2", "text": "Choego!", "src": "Choego!"},
{"key": "data.voice.korean.praise.0", "text": "Daebak. Jinjja, това е перфектно.", "src": "Daebak. Jinjja, this is perfect."},
{"key": "data.voice.korean.praise.1", "text": "Choego. Сериозно го казвам.", "src": "Choego. I mean it."},
{"key": "data.voice.korean.praise.2", "text": "Уау. Много те бива в това.", "src": "Wow. You are good at this."},
{"key": "data.voice.korean.sip.0", "text": "Jamkkanman, {advice_l}", "src": "Jamkkanman, {advice_l}"},
{"key": "data.voice.korean.sip.1", "text": "Ъм, {advice_l}", "src": "Um, {advice_l}"},
{"key": "data.voice.korean.sip.2", "text": "Gwenchana, но {advice_l}", "src": "Gwenchana, but {advice_l}"},
{"key": "data.voice.korean.wrong.0", "text": "Aniyo, не.", "src": "Aniyo, no."},
{"key": "data.voice.korean.wrong.1", "text": "Това е грешно.", "src": "This is wrong."},
{"key": "data.voice.korean.wrong.2", "text": "А? Не е моето.", "src": "Eh? Not mine."},
{"key": "data.voice.nordic.another.0", "text": "Още едно. Skål!", "src": "Another. Skål!"},
{"key": "data.voice.nordic.another.1", "text": "Още по едно.", "src": "One more."},
{"key": "data.voice.nordic.another.2", "text": "Пак, моля.", "src": "Again, please."},
{"key": "data.voice.nordic.close.0", "text": "Добре.", "src": "Fine."},
{"key": "data.voice.nordic.close.1", "text": "Става.", "src": "It's okay."},
{"key": "data.voice.nordic.close.2", "text": "Достатъчно добро.", "src": "Good enough."},
{"key": "data.voice.nordic.kicked.0", "text": "Добре. Странно, но добре.", "src": "Okay. Strange, but okay."},
{"key": "data.voice.nordic.kicked.1", "text": "Ясно.", "src": "Fine."},
{"key": "data.voice.nordic.kicked.2", "text": "Хм. Довиждане тогава.", "src": "Hm. Goodbye then."},
{"key": "data.voice.nordic.leaving.0", "text": "Ще тръгвам. Няма проблем.", "src": "I'll go. It's fine."},
{"key": "data.voice.nordic.leaving.1", "text": "Много дълго. Довиждане.", "src": "Too long. Goodbye."},
{"key": "data.voice.nordic.leaving.2", "text": "Не. Тръгвам си.", "src": "No. I'm leaving."},
{"key": "data.voice.nordic.order.0", "text": "{drink}. Благодаря.", "src": "A {drink}. Thanks."},
{"key": "data.voice.nordic.order.1", "text": "{drink}, моля.", "src": "{drink}, please."},
{"key": "data.voice.nordic.order.2", "text": "{drink}. Без бързане.", "src": "One {drink}. No rush."},
{"key": "data.voice.nordic.order.3", "text": "За мен: {drink}.", "src": "I'll have the {drink}."},
{"key": "data.voice.nordic.perfect.0", "text": "Skål!", "src": "Skål!"},
{"key": "data.voice.nordic.perfect.1", "text": "Много добро.", "src": "Very good."},
{"key": "data.voice.nordic.perfect.2", "text": "Да. Добро.", "src": "Yes. Good."},
{"key": "data.voice.nordic.praise.0", "text": "Много е добро. А аз не го казвам.", "src": "This is very good. I don't say that."},
{"key": "data.voice.nordic.praise.1", "text": "Skål. Направено както трябва.", "src": "Skål. Properly done."},
{"key": "data.voice.nordic.praise.2", "text": "Добро. Наистина добро.", "src": "Good. Really good."},
{"key": "data.voice.nordic.sip.0", "text": "Е. {advice}", "src": "Well. {advice}"},
{"key": "data.voice.nordic.sip.1", "text": "Хм. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.nordic.sip.2", "text": "Добре, но {advice_l}", "src": "Fine, but {advice_l}"},
{"key": "data.voice.nordic.wrong.0", "text": "Не. Грешно.", "src": "No. Wrong one."},
{"key": "data.voice.nordic.wrong.1", "text": "Не е това.", "src": "This is not it."},
{"key": "data.voice.nordic.wrong.2", "text": "Хм. Не е моето.", "src": "Hm. Not mine."},
{"key": "data.voice.southern.another.0", "text": "Налей ми още едно!", "src": "Pour me another!"},
{"key": "data.voice.southern.another.1", "text": "Още едно, sugar!", "src": "One more, sugar!"},
{"key": "data.voice.southern.another.2", "text": "Давай ги насам, y'all!", "src": "Keep 'em comin'!"},
{"key": "data.voice.southern.close.0", "text": "Бива.", "src": "That's alright."},
{"key": "data.voice.southern.close.1", "text": "Честна работа.", "src": "Fair enough."},
{"key": "data.voice.southern.close.2", "text": "Е, ще свърши работа.", "src": "Well, it'll do."},
{"key": "data.voice.southern.kicked.0", "text": "Е, това просто е грубо.", "src": "Well, that's just rude."},
{"key": "data.voice.southern.kicked.1", "text": "Добре тогава. Приятна вечер.", "src": "Alright then. Have a good one."},
{"key": "data.voice.southern.kicked.2", "text": "Чакай малко… добре.", "src": "Now hold on… fine."},
{"key": "data.voice.southern.leaving.0", "text": "Е, нямам цяла нощ.", "src": "Well, I ain't got all night."},
{"key": "data.voice.southern.leaving.1", "text": "Reckon ще пия другаде.", "src": "Reckon I'll drink elsewhere."},
{"key": "data.voice.southern.leaving.2", "text": "Y'all хич не бързате, а?", "src": "Y'all take your sweet time, don't you."},
{"key": "data.voice.southern.order.0", "text": "Е, {drink} ще ми дойде добре.", "src": "Well now, a {drink} would suit me."},
{"key": "data.voice.southern.order.1", "text": "{drink}, darlin', ако обичаш.", "src": "{drink}, darlin', if you please."},
{"key": "data.voice.southern.order.2", "text": "Reckon ще взема {drink}.", "src": "Reckon I'll have a {drink}."},
{"key": "data.voice.southern.order.3", "text": "{drink}, sugar.", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "Ама че хубаво!", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "Господи, колко е добро!", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "Hot dang!", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "Е, не мога да повярвам. Това е истинско питие.", "src": "Well, I'll be. That's a proper drink."},
