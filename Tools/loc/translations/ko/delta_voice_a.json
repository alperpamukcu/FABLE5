{"key": "data.voice.southern.another.0", "text": "한 잔 더 따라 줘요!", "src": "Pour me another!"},
{"key": "data.voice.southern.another.1", "text": "하나 더요, sugar!", "src": "One more, sugar!"},
{"key": "data.voice.southern.another.2", "text": "계속 가져와요!", "src": "Keep 'em comin'!"},
{"key": "data.voice.southern.close.0", "text": "그 정도면 됐어요.", "src": "That's alright."},
{"key": "data.voice.southern.close.1", "text": "그럴 만하네요.", "src": "Fair enough."},
{"key": "data.voice.southern.close.2", "text": "뭐, 이만하면 돼요.", "src": "Well, it'll do."},
{"key": "data.voice.southern.kicked.0", "text": "어머, 그건 좀 무례하네요.", "src": "Well, that's just rude."},
{"key": "data.voice.southern.kicked.1", "text": "알았어요. 좋은 밤 보내요.", "src": "Alright then. Have a good one."},
{"key": "data.voice.southern.kicked.2", "text": "잠깐만요… 그래요, 뭐.", "src": "Now hold on… fine."},
{"key": "data.voice.southern.leaving.0", "text": "나도 밤새 여기 있을 순 없잖아요.", "src": "Well, I ain't got all night."},
{"key": "data.voice.southern.leaving.1", "text": "딴 데 가서 마셔야겠네요.", "src": "Reckon I'll drink elsewhere."},
{"key": "data.voice.southern.leaving.2", "text": "Y'all 참 느긋들 하시네요.", "src": "Y'all take your sweet time, don't you."},
{"key": "data.voice.southern.order.0", "text": "자, {drink} 한 잔이면 딱이겠네요.", "src": "Well now, a {drink} would suit me."},
{"key": "data.voice.southern.order.1", "text": "{drink} 부탁해요, darlin'.", "src": "{drink}, darlin', if you please."},
{"key": "data.voice.southern.order.2", "text": "{drink} 한 잔 할까 봐요.", "src": "Reckon I'll have a {drink}."},
{"key": "data.voice.southern.order.3", "text": "{drink} 하나요, sugar.", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "이거 참 좋네!", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "Lord, 맛있다!", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "Hot dang!", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "세상에. 이게 제대로 된 한 잔이죠.", "src": "Well, I'll be. That's a proper drink."},
{"key": "data.voice.southern.praise.1", "text": "Darlin', 재능 있네요.", "src": "Darlin', you got a gift."},
{"key": "data.voice.southern.praise.2", "text": "새 단골집 찾았나 봐요.", "src": "Reckon I found my new spot."},
{"key": "data.voice.southern.sip.0", "text": "자, {advice_l}", "src": "Now, {advice_l}"},
{"key": "data.voice.southern.sip.1", "text": "Sugar, {advice_l}", "src": "Sugar, {advice_l}"},
{"key": "data.voice.southern.sip.2", "text": "있잖아요, {advice_l}", "src": "Tell you what, {advice_l}"},
{"key": "data.voice.southern.wrong.0", "text": "제 거 아니에요, hon.", "src": "Ain't mine, hon."},
{"key": "data.voice.southern.wrong.1", "text": "이게 뭐예요?", "src": "Now what is this?"},
{"key": "data.voice.southern.wrong.2", "text": "어머, bless your heart.", "src": "Bless your heart."}
]}
