{"key": "data.voice.brit.praise.2", "text": "Bloody 좋네요, 이거.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
