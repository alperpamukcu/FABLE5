{"strings": [
{"key": "data.voice.arabic.another.0", "text": "Kaman wahad! 한 잔 더!", "src": "Kaman wahad!"},
{"key": "data.voice.arabic.another.1", "text": "하나 더, yalla!", "src": "One more, yalla!"},
{"key": "data.voice.arabic.another.2", "text": "또 줘요, habibi!", "src": "Again, habibi!"},
{"key": "data.voice.arabic.close.0", "text": "Maashi, 괜찮아요.", "src": "Maashi."},
{"key": "data.voice.arabic.close.1", "text": "괜찮네요.", "src": "It is okay."},
{"key": "data.voice.arabic.close.2", "text": "Tamam, shukran.", "src": "Tamam, shukran."},
{"key": "data.voice.arabic.kicked.0", "text": "Shu? 진짜로요?", "src": "Shu? Seriously?"},
{"key": "data.voice.arabic.kicked.1", "text": "Khalas. 알았어요.", "src": "Khalas. Fine."},
{"key": "data.voice.arabic.kicked.2", "text": "Yalla. 갈게요.", "src": "Yalla. I go."},
{"key": "data.voice.arabic.leaving.0", "text": "Khalas. 이만 갈게요.", "src": "Khalas. I am going."},
{"key": "data.voice.arabic.leaving.1", "text": "Yalla, 기다리는 건 이제 그만.", "src": "Yalla, enough waiting."},
{"key": "data.voice.arabic.leaving.2", "text": "Maa salama. 안녕히.", "src": "Maa salama."},
{"key": "data.voice.arabic.order.0", "text": "{drink} 한 잔 주세요.", "src": "A {drink}, please."},
{"key": "data.voice.arabic.order.1", "text": "{drink} 하나요, shukran.", "src": "One {drink}, shukran."},
{"key": "data.voice.arabic.order.2", "text": "Habibi, {drink} 한 잔.", "src": "Habibi, a {drink}."},
{"key": "data.voice.arabic.order.3", "text": "{drink} 마실게요.", "src": "I will take a {drink}."},
{"key": "data.voice.arabic.perfect.0", "text": "Ya salam!", "src": "Ya salam!"},
{"key": "data.voice.arabic.perfect.1", "text": "Helu kteer! 맛있어요!", "src": "Helu kteer!"},
{"key": "data.voice.arabic.perfect.2", "text": "완벽해요, habibi!", "src": "Perfect, habibi!"},
{"key": "data.voice.arabic.praise.0", "text": "Ya salam. 바로 이거예요, habibi.", "src": "Ya salam. This is the one, habibi."},
{"key": "data.voice.arabic.praise.1", "text": "Helu kteer. 정말 고마워요.", "src": "Helu kteer. Shukran."},
{"key": "data.voice.arabic.praise.2", "text": "Yalla, 일 좀 아시네요.", "src": "Yalla, you know your work."},
{"key": "data.voice.arabic.sip.0", "text": "Habibi, {advice_l}", "src": "Habibi, {advice_l}"},
{"key": "data.voice.arabic.sip.1", "text": "Shuf, {advice_l}", "src": "Shuf, {advice_l}"},
{"key": "data.voice.arabic.sip.2", "text": "Tamam, 근데 {advice_l}", "src": "Tamam, bas {advice_l}"},
{"key": "data.voice.arabic.wrong.0", "text": "La, la. 아니에요.", "src": "La, la."},
{"key": "data.voice.arabic.wrong.1", "text": "이게 아닌데요.", "src": "This is not it."},
{"key": "data.voice.arabic.wrong.2", "text": "Shu hada? 이게 뭐예요?", "src": "Shu hada?"},
{"key": "data.voice.chinese.another.0", "text": "Zai lai yi bei! 한 잔 더!", "src": "Zai lai yi bei!"},
{"key": "data.voice.chinese.another.1", "text": "하나 더요!", "src": "One more, ah!"},
{"key": "data.voice.chinese.another.2", "text": "또 부탁해요!", "src": "Again, please!"},
{"key": "data.voice.chinese.close.0", "text": "Hai keyi. 괜찮네요.", "src": "Hai keyi."},
{"key": "data.voice.chinese.close.1", "text": "뭐, 괜찮아요.", "src": "Okay lah."},
{"key": "data.voice.chinese.close.2", "text": "이 정도면 돼요.", "src": "It is fine."},
{"key": "data.voice.chinese.kicked.0", "text": "Shenme? 진짜요?", "src": "Shenme? Really?"},
{"key": "data.voice.chinese.kicked.1", "text": "Aiya. 알았어요.", "src": "Aiya. Fine."},
{"key": "data.voice.chinese.kicked.2", "text": "Hao. 갈게요.", "src": "Hao. I leave."},
{"key": "data.voice.chinese.leaving.0", "text": "Aiya. 너무 오래 기다렸어요.", "src": "Aiya. I waited too long."},
{"key": "data.voice.chinese.leaving.1", "text": "Suan le. 갈래요.", "src": "Suan le. I go."},
{"key": "data.voice.chinese.leaving.2", "text": "그럼 zaijian.", "src": "Zaijian, then."},
{"key": "data.voice.chinese.order.0", "text": "{drink} 주세요.", "src": "{drink}, please."},
{"key": "data.voice.chinese.order.1", "text": "{drink} 하나요, xiexie.", "src": "One {drink}, xiexie."},
{"key": "data.voice.chinese.order.2", "text": "{drink} 마실게요.", "src": "I will have a {drink}."},
{"key": "data.voice.chinese.order.3", "text": "저는 {drink} 한 잔.", "src": "A {drink} for me."},
{"key": "data.voice.chinese.perfect.0", "text": "Hen hao! 좋아요!", "src": "Hen hao!"},
{"key": "data.voice.chinese.perfect.1", "text": "완벽해요!", "src": "Perfect, ah!"},
{"key": "data.voice.chinese.perfect.2", "text": "Zhen bang!", "src": "Zhen bang!"},
{"key": "data.voice.chinese.praise.0", "text": "Zhen bang. 이거 마시러 또 올게요.", "src": "Zhen bang. I will come back for this."},
{"key": "data.voice.chinese.praise.1", "text": "Hen hao. 뭘 좀 아시네요.", "src": "Hen hao. You know what you are doing."},
{"key": "data.voice.chinese.praise.2", "text": "완벽해요. 진짜로요.", "src": "Perfect, ah. Really."},
{"key": "data.voice.chinese.sip.0", "text": "Ai, {advice_l}", "src": "Ai, {advice_l}"},
{"key": "data.voice.chinese.sip.1", "text": "들어 봐요, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.chinese.sip.2", "text": "Hao, 근데 {advice_l}", "src": "Hao, but {advice_l}"},
{"key": "data.voice.chinese.wrong.0", "text": "Bu dui. 아니에요.", "src": "Bu dui."},
{"key": "data.voice.chinese.wrong.1", "text": "Aiya, 이거 아니에요.", "src": "Aiya, no."},
{"key": "data.voice.chinese.wrong.2", "text": "이게 아닌데요.", "src": "Not this one."},
{"key": "data.voice.filipino.another.0", "text": "Isa pa! 한 잔 더!", "src": "Isa pa!"},
{"key": "data.voice.filipino.another.1", "text": "하나 더요, ha!", "src": "One more, ha!"},
{"key": "data.voice.filipino.another.2", "text": "또 주세요!", "src": "Again, please!"},
{"key": "data.voice.filipino.close.0", "text": "Okay lang, 괜찮아요.", "src": "Okay lang."},
{"key": "data.voice.filipino.close.1", "text": "Sige, 고마워요.", "src": "Sige, thanks."},
{"key": "data.voice.filipino.close.2", "text": "Ay, 괜찮네요.", "src": "Ay, it's fine."},
{"key": "data.voice.filipino.kicked.0", "text": "Ha? 진짜요?", "src": "Ha? Really?"},
{"key": "data.voice.filipino.kicked.1", "text": "Ay. 알았어요. 안녕.", "src": "Ay. Okay. Bye."},
{"key": "data.voice.filipino.kicked.2", "text": "Grabe naman. 너무하네.", "src": "Grabe naman."},
{"key": "data.voice.filipino.leaving.0", "text": "Ay, grabe. 너무 오래 걸려요. 갈게요.", "src": "Ay, grabe. Too long. I'm going."},
{"key": "data.voice.filipino.leaving.1", "text": "Sige na, 안녕.", "src": "Sige na, bye."},
{"key": "data.voice.filipino.leaving.2", "text": "Naku, 아무도 안 오네.", "src": "Naku, no one is coming."},
{"key": "data.voice.filipino.order.0", "text": "Ay, {drink} 한 잔 주세요.", "src": "Ay, one {drink}, please."},
{"key": "data.voice.filipino.order.1", "text": "{drink} 주세요. Salamat.", "src": "{drink} for me. Salamat."},
{"key": "data.voice.filipino.order.2", "text": "{drink} 돼요? 고마워요, ha.", "src": "Can I have a {drink}? Thanks, ha."},
{"key": "data.voice.filipino.order.3", "text": "{drink} 하나요, kuya.", "src": "A {drink}, kuya."},
{"key": "data.voice.filipino.perfect.0", "text": "Ay, sarap!", "src": "Ay, sarap!"},
{"key": "data.voice.filipino.perfect.1", "text": "Grabe, 좋다!", "src": "Grabe, yes!"},
{"key": "data.voice.filipino.perfect.2", "text": "완벽해요, kuya!", "src": "Perfect, kuya!"},
{"key": "data.voice.filipino.praise.0", "text": "Grabe. 너무 맛있어요. Salamat.", "src": "Grabe. That is so good. Salamat."},
{"key": "data.voice.filipino.praise.1", "text": "Ay, sarap. 오늘 하루가 다 풀리네요.", "src": "Ay, sarap. You made my whole shift."},
{"key": "data.voice.filipino.praise.2", "text": "Sige, 이거 마시러 또 올게요.", "src": "Sige, I'm coming back for this."},
{"key": "data.voice.filipino.sip.0", "text": "Ay, {advice_l}", "src": "Ay, {advice_l}"},
{"key": "data.voice.filipino.sip.1", "text": "Sige, 근데 {advice_l}", "src": "Sige, but {advice_l}"},
{"key": "data.voice.filipino.sip.2", "text": "Ha? {advice}", "src": "Ha? {advice}"},
{"key": "data.voice.filipino.wrong.0", "text": "Ay, hindi. 이거 아니에요.", "src": "Ay, hindi. Not this."},
{"key": "data.voice.filipino.wrong.1", "text": "Grabe, 음료가 틀렸어요.", "src": "Grabe, wrong drink."},
{"key": "data.voice.filipino.wrong.2", "text": "제 거 아니에요, kuya.", "src": "Not mine, kuya."},
{"key": "data.voice.italian.another.0", "text": "Ancora, dai! 한 잔 더!", "src": "Ancora, dai!"},
{"key": "data.voice.italian.another.1", "text": "하나 더요, grazie!", "src": "Another, grazie!"},
{"key": "data.voice.italian.another.2", "text": "한 번 더, amore!", "src": "Once more, amore!"},
{"key": "data.voice.italian.close.0", "text": "Va bene. 괜찮아요.", "src": "Va bene."},
{"key": "data.voice.italian.close.1", "text": "오케이, grazie.", "src": "Okay, grazie."},
{"key": "data.voice.italian.close.2", "text": "나쁘지 않네요, eh.", "src": "Not bad, eh."},
{"key": "data.voice.italian.kicked.0", "text": "Ma dai! 진짜요?", "src": "Ma dai! Really?"},
{"key": "data.voice.italian.kicked.1", "text": "Va bene. 잘 있어요, ciao.", "src": "Va bene. Ciao, ciao."},
{"key": "data.voice.italian.kicked.2", "text": "Che maleducato. 무례하네요.", "src": "Che maleducato."},
{"key": "data.voice.italian.leaving.0", "text": "Basta. 갈게요.", "src": "Basta. I go."},
{"key": "data.voice.italian.leaving.1", "text": "Mamma mia, 이 기다림!", "src": "Mamma mia, the waiting!"},
{"key": "data.voice.italian.leaving.2", "text": "Ciao. 다음 생에 봐요.", "src": "Ciao. Maybe next life."},
{"key": "data.voice.italian.order.0", "text": "{drink} 한 잔, per favore.", "src": "Un {drink}, per favore."},
{"key": "data.voice.italian.order.1", "text": "{drink} 하나요, amore.", "src": "A {drink}, amore."},
{"key": "data.voice.italian.order.2", "text": "{drink} 주세요, grazie.", "src": "{drink}, grazie."},
{"key": "data.voice.italian.order.3", "text": "Dai, {drink} 한 잔.", "src": "Dai, a {drink}."},
{"key": "data.voice.italian.perfect.0", "text": "Perfetto! 완벽해요!", "src": "Perfetto!"},
{"key": "data.voice.italian.perfect.1", "text": "Bravo!", "src": "Bravo!"},
{"key": "data.voice.italian.perfect.2", "text": "Che buono! 맛있다!", "src": "Che buono!"},
{"key": "data.voice.italian.praise.0", "text": "Perfetto. 진짜로요. Grazie mille.", "src": "Perfetto. Truly. Grazie mille."},
{"key": "data.voice.italian.praise.1", "text": "Bravo. 우리 nonna가 보면 울겠어요.", "src": "Bravo. My nonna would cry."},
{"key": "data.voice.italian.praise.2", "text": "Che buono. 저 안 갈래요.", "src": "Che buono. I'm not leaving."},
{"key": "data.voice.italian.sip.0", "text": "Senti, {advice_l}", "src": "Senti, {advice_l}"},
{"key": "data.voice.italian.sip.1", "text": "Allora, {advice_l}", "src": "Allora, {advice_l}"},
{"key": "data.voice.italian.sip.2", "text": "Va bene, ma {advice_l}", "src": "Va bene, ma {advice_l}"},
{"key": "data.voice.italian.wrong.0", "text": "Mamma mia, 아니에요.", "src": "Mamma mia, no."},
{"key": "data.voice.italian.wrong.1", "text": "Ma che cos'è? 이게 뭐예요?", "src": "Ma che cos'è?"},
{"key": "data.voice.italian.wrong.2", "text": "No, no. 이거 아니에요.", "src": "No, no. Not this."},
{"key": "data.voice.miami.another.0", "text": "¡Otra, dale! 한 잔 더!", "src": "¡Otra, dale!"},
{"key": "data.voice.miami.another.1", "text": "하나 더, oye!", "src": "One more, oye!"},
{"key": "data.voice.miami.another.2", "text": "또 줘요, mi amor!", "src": "Again, mi amor!"},
{"key": "data.voice.miami.close.0", "text": "Está bien. 괜찮아요.", "src": "Está bien."},
{"key": "data.voice.miami.close.1", "text": "나쁘지 않네, chico.", "src": "Not bad, chico."},
{"key": "data.voice.miami.close.2", "text": "오케이, 오케이.", "src": "Okay, okay."},
{"key": "data.voice.miami.kicked.0", "text": "¿En serio? 알았어요, 됐어요.", "src": "¿En serio? Okay, fine."},
{"key": "data.voice.miami.kicked.1", "text": "농담이죠, chico.", "src": "You're kidding me, chico."},
{"key": "data.voice.miami.kicked.2", "text": "Dale. 손해는 그쪽이죠.", "src": "Dale. Your loss."},
{"key": "data.voice.miami.leaving.0", "text": "¡Oye! 밤새 여기 앉아 있었다고요.", "src": "¡Oye! I've been sitting here all night."},
{"key": "data.voice.miami.leaving.1", "text": "Bueno, 여기까지. Ciao.", "src": "Bueno, that's it. Ciao."},
{"key": "data.voice.miami.leaving.2", "text": "No, no. 더는 안 기다려요.", "src": "No, no. I'm not waiting anymore."},
{"key": "data.voice.miami.order.0", "text": "Oye, {drink} 한 잔요.", "src": "Oye, a {drink} for me."},
{"key": "data.voice.miami.order.1", "text": "Dale, {drink} 하나.", "src": "Dale, one {drink}."},
{"key": "data.voice.miami.order.2", "text": "{drink} 부탁해요, papi. 시간 될 때.", "src": "{drink}, papi, when you can."},
{"key": "data.voice.miami.order.3", "text": "Mi amor, {drink} 한 잔.", "src": "Mi amor, a {drink}."},
{"key": "data.voice.miami.perfect.0", "text": "¡Qué rico!", "src": "¡Qué rico!"},
{"key": "data.voice.miami.perfect.1", "text": "¡Eso es! 바로 이거!", "src": "¡Eso es!"},
{"key": "data.voice.miami.perfect.2", "text": "¡Dale, 완벽해!", "src": "¡Dale, perfecto!"},
{"key": "data.voice.miami.praise.0", "text": "Ay, 바로 이거예요. Gracias.", "src": "Ay, this is the one. Gracias."},
{"key": "data.voice.miami.praise.1", "text": "우리 abuela도 인정하겠어요. 뭐든 인정 안 하는 분인데.", "src": "My abuela would approve, and she approves of nothing."},
{"key": "data.voice.miami.praise.2", "text": "Dale. 뭘 좀 아시네요.", "src": "Dale. You know what you're doing."},
{"key": "data.voice.miami.sip.0", "text": "Mira, {advice_l}", "src": "Mira, {advice_l}"},
{"key": "data.voice.miami.sip.1", "text": "Oye, {advice_l}", "src": "Oye, {advice_l}"},
{"key": "data.voice.miami.sip.2", "text": "Está bien, pero… {advice_l}", "src": "Está bien, pero… {advice_l}"},
{"key": "data.voice.miami.wrong.0", "text": "¿Qué es esto?", "src": "¿Qué es esto?"},
{"key": "data.voice.miami.wrong.1", "text": "No, no, no. 아니에요.", "src": "No, no, no."},
{"key": "data.voice.miami.wrong.2", "text": "제 거 아니에요, oye.", "src": "Not mine, oye."},
{"key": "data.voice.nyc.another.0", "text": "한 잔 더 줘요!", "src": "Hit me again!"},
{"key": "data.voice.nyc.another.1", "text": "계속 가져와요!", "src": "Keep 'em comin'!"},
{"key": "data.voice.nyc.another.2", "text": "하나 더, chief!", "src": "Another, chief!"},
{"key": "data.voice.nyc.close.0", "text": "에. 괜찮네.", "src": "Eh. It's fine."},
{"key": "data.voice.nyc.close.1", "text": "그래, 됐어요.", "src": "Yeah, alright."},
{"key": "data.voice.nyc.close.2", "text": "이 정도면 돼요.", "src": "It'll do."},
{"key": "data.voice.nyc.kicked.0", "text": "지금 장난해요?", "src": "You serious right now?"},
{"key": "data.voice.nyc.kicked.1", "text": "좋아요. 어차피 별로인 바였어요.", "src": "Fine. Terrible bar anyway."},
{"key": "data.voice.nyc.kicked.2", "text": "와. 오케이. 와.", "src": "Wow. Okay. Wow."},
{"key": "data.voice.nyc.leaving.0", "text": "나 바쁜 사람이에요. 됐어요.", "src": "I got places to be. Forget it."},
{"key": "data.voice.nyc.leaving.1", "text": "말도 안 돼. 나 갑니다.", "src": "Unbelievable. I'm outta here."},
{"key": "data.voice.nyc.leaving.2", "text": "Yo, 여기 바예요, 대기실이에요?", "src": "Yo, is this a bar or a waiting room?"},
{"key": "data.voice.nyc.order.0", "text": "Yo, {drink} 하나 줘요.", "src": "Yo, lemme get a {drink}."},
{"key": "data.voice.nyc.order.1", "text": "{drink}. 나 좀 급해요.", "src": "{drink}. And I'm in a hurry."},
{"key": "data.voice.nyc.order.2", "text": "{drink} 하나 줘요, chief.", "src": "Gimme a {drink}, chief."},
{"key": "data.voice.nyc.order.3", "text": "{drink}. 이상하게 만들지 말고요.", "src": "{drink}. Don't make it weird."},
{"key": "data.voice.nyc.perfect.0", "text": "이제 좀 말이 통하네!", "src": "Now we're talkin'!"},
{"key": "data.voice.nyc.perfect.1", "text": "바로 이 맛이지!", "src": "That's the stuff!"},
{"key": "data.voice.nyc.perfect.2", "text": "오, 이거지!", "src": "Oh, that's it!"},
{"key": "data.voice.nyc.praise.0", "text": "오케이, 감동했어요. 이런 일 잘 없는데.", "src": "Okay, I'm impressed. That never happens."},
{"key": "data.voice.nyc.praise.1", "text": "내 말 들어 봐요, 이게 제대로 된 한 잔이지.", "src": "Lemme tell ya, that's a drink."},
{"key": "data.voice.nyc.praise.2", "text": "이거 돈 더 받아도 돼요. 받지는 말고요.", "src": "You should charge more for this. Don't."},
{"key": "data.voice.nyc.sip.0", "text": "봐요, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.nyc.sip.1", "text": "그냥 하는 말인데, {advice_l}", "src": "I'm just sayin', {advice_l}"},
{"key": "data.voice.nyc.sip.2", "text": "나쁘진 않은데, {advice_l}", "src": "Not bad, but {advice_l}"},
{"key": "data.voice.nyc.wrong.0", "text": "이게 뭐예요?", "src": "What is this?"},
{"key": "data.voice.nyc.wrong.1", "text": "Fuhgeddaboudit. 됐어요.", "src": "Fuhgeddaboudit."},
