{"strings": [
{"key": "data.voice.aussie.another.0", "text": "같은 걸로 한 잔 더, mate!", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "하나 더요, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "한 잔 더, legend!", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "그래요, righto.", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "나쁘지 않네, mate.", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "그 정도면 됐어요.", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "진심이에요, mate?", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto. 그럴 수 있죠.", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Nah, 좀 심하네.", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto, 기다릴 만큼 기다렸어요.", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Nah, 관둬요. 갑니다.", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "고맙기도 하네요, mate.", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "{drink} 하나요, mate.", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink} 주세요.", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "{drink} 하나 할게요.", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "{drink} 한 잔, cheers.", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "Ripper!", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "Too easy! 완벽!", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "Bloody 좋다!", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "Bloody ripper, mate. 고마워요.", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "Too easy. 뭘 좀 아시네.", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "솔직히, 오늘 밤 최고의 한 잔이에요.", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "저기, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "No dramas, 근데 {advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Nah, mate. 아니에요.", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "제 거 아니에요, 미안.", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "잘못 나왔어요, mate.", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "한 잔 더!", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "같은 걸로요!", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "계속 주세요!", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "고마워요.", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "이 정도면 돼요.", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "거의 맞네요.", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "진짜요? 알았어요.", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "실수하시는 거예요.", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "됐어요. 바는 혼자 하세요.", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "됐어요. 더는 못 기다려요.", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "오늘 일하는 사람 없어요?", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "그래요. 딴 데 가서 마실게요.", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink} 주세요.", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "{drink} 한 잔 할게요.", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "{drink} 하나요, 틈날 때.", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "{drink} 한 잔으로 주세요.", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "완벽해요!", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "바로 이거예요!", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "딱 맞아요!", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "바꿀 게 하나도 없네요.", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "이거야말로 제대로 된 한 잔이죠.", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "누가 가르쳤는지, 고맙다고 전해 줘요.", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "흠. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice} 그냥 그렇다고요.", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "솔직히? {advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "주문한 게 아니에요.", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "음료가 틀렸어요.", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "그거 제 거 아니에요.", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "Encore, 한 잔 더요!", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "하나 더, oui!", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "또 주세요, merci!", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ça va. 괜찮아요.", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "괜찮네요.", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon, 오케이.", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "Quoi? 진짜요?", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Bon. 안녕히, au revoir.", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule. 어이없네요.", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non. 기다릴 만큼 기다렸어요.", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis. 갈게요.", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "그럼, au revoir.", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "{drink} 한 잔, s'il vous plaît.", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "{drink} 주세요.", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "{drink} 하나, merci.", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "{drink} 마실게요.", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "Parfait!", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "Voilà, 완벽해요!", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "Magnifique!", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait. 덧붙일 말이 하나도 없어요.", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voilà. 여기 따를 줄 아는 사람이 있네요.", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique. 진심으로요.", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Écoute, {advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon, {advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors, {advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non. 아니에요.", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "이게 아니에요.", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon, 잘못 나왔어요.", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "Mou ippai! 한 잔 더!", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "하나 더요, kanpai!", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "또 부탁해요, onegai!", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Hai, 괜찮아요.", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa. 그럭저럭요.", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "나쁘지 않네요, ne.", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "Eh?! 진짜요?", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi. 알겠어요, 갈게요.", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta. 사요나라.", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen, 더는 못 기다리겠어요.", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii. 갈게요.", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai. 안녕히 계세요.", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen, {drink} 한 잔요.", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "{drink} 하나, onegai.", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink} 주세요. Arigatou.", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto… {drink} 한 잔.", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "Oishii!", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "Sugoi, 완벽해요!", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "Kanpai!", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii. 정말, 바로 이거예요.", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "Sugoi. 프로시네요, ne.", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "Kanpai. 완벽해요.", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "Etto, {advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "Ne, {advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "Sumimasen, 근데 {advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "Chotto… 아니에요.", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "Eh? 이거 아닌데요.", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "Chigau, 죄송해요.", "src": "Chigau, sorry."},
{"key": "data.voice.midwest.another.0", "text": "한 잔 더 부탁해요!", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "하나 더요, 고마워요!", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "같은 걸로 또요, ope!", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "아, 괜찮아요.", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "네, 고마워요.", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "전혀 나쁘지 않네요.", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "아. 음. 그럼 알겠어요.", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "Ope, 죄송해요… 갈게요.", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "좀 심하긴 한데, 알겠어요.", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "Oh gosh, 이제 정말 못 기다리겠어요.", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "음, 이만 가 봐야겠네요.", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "죄송하지만, 먼저 일어날게요.", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "{drink} 한 잔 될까요? 정말 고마워요.", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "{drink} 하나요, 번거롭지 않으면요.", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "아, 저는 그냥 {drink} 한 잔.", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink} 주세요. 아무 때나요.", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "오, 정말 좋네요!", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "You betcha!", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "Oh jeez, 좋아요!", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "어머나, 정말 근사하네요.", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "정말 좋아요. 우리 이모가 이 가게 좋아하겠어요.", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "아, 딱 원하던 맛이에요.", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "아, {advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "참고로요, {advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "별건 아닌데, {advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "Ope. 잘못 나왔네요.", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "어, 그거 제 거 아니에요.", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "죄송해요, 이건 아니에요.", "src": "Sorry, no. Not this."},
{"key": "data.voice.polish.another.0", "text": "Jeszcze raz! 한 잔 더!", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "하나 더요, proszę!", "src": "Another, proszę!"},
{"key": "data.voice.polish.another.2", "text": "또 한 잔요!", "src": "One more!"},
{"key": "data.voice.polish.close.0", "text": "Dobrze. 괜찮아요.", "src": "Dobrze."},
{"key": "data.voice.polish.close.1", "text": "오케이.", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "괜찮네요, 고마워요.", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "Serio? 알았어요.", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "좋아요. Do widzenia.", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "Co? 알았어요, 갈게요.", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "그만. 갈게요.", "src": "Enough. I'm going."},
{"key": "data.voice.polish.leaving.1", "text": "Nie, nie. 너무 오래 걸려요.", "src": "Nie, nie. Too long."},
{"key": "data.voice.polish.leaving.2", "text": "Do widzenia. 안녕히.", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "{drink} 한 잔, proszę.", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "{drink} 주세요.", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "{drink} 하나요. 고맙습니다.", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "Dobrze, {drink} 한 잔.", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "Na zdrowie!", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "Świetnie!", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "아주 좋아요!", "src": "Very good!"},
{"key": "data.voice.polish.praise.0", "text": "Na zdrowie. 이게 진짜 한 잔이죠.", "src": "Na zdrowie. This is a real drink."},
{"key": "data.voice.polish.praise.1", "text": "Świetnie. 집에서 마시는 것 같아요.", "src": "Świetnie. Like at home."},
{"key": "data.voice.polish.praise.2", "text": "Dobrze. 아주, 아주 좋아요.", "src": "Dobrze. Very, very good."},
{"key": "data.voice.polish.sip.0", "text": "Dobrze, 근데 {advice_l}", "src": "Dobrze, but {advice_l}"},
{"key": "data.voice.polish.sip.1", "text": "들어 봐요, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.polish.sip.2", "text": "흠, {advice_l}", "src": "Hm, {advice_l}"},
{"key": "data.voice.polish.wrong.0", "text": "Nie. 잘못 나왔어요.", "src": "Nie. Wrong one."},
{"key": "data.voice.polish.wrong.1", "text": "이건 제 거 아니에요.", "src": "This is not mine."},
{"key": "data.voice.polish.wrong.2", "text": "Co to jest? 이게 뭐예요?", "src": "Co to jest?"},
{"key": "data.voice.turkish.another.0", "text": "Bir daha! 한 잔 더!", "src": "Bir daha!"},
{"key": "data.voice.turkish.another.1", "text": "하나 더요, abi!", "src": "Another, abi!"},
{"key": "data.voice.turkish.another.2", "text": "또 줘요, eyvallah!", "src": "Again, eyvallah!"},
{"key": "data.voice.turkish.close.0", "text": "Tamam. 괜찮아요.", "src": "Tamam."},
{"key": "data.voice.turkish.close.1", "text": "İdare eder. 그럭저럭.", "src": "İdare eder."},
{"key": "data.voice.turkish.close.2", "text": "오케이, 됐어요.", "src": "Okay, fine."},
{"key": "data.voice.turkish.kicked.0", "text": "Ciddi misin? 알았어요.", "src": "Ciddi misin? Okay."},
{"key": "data.voice.turkish.kicked.1", "text": "Abi, 진짜요? 됐어요.", "src": "Abi, really? Fine."},
{"key": "data.voice.turkish.kicked.2", "text": "Yok, yok. 갈게요.", "src": "Yok, yok. I'm going."},
{"key": "data.voice.turkish.leaving.0", "text": "Yok, 더는 안 기다려요.", "src": "Yok, I'm not waiting anymore."},
{"key": "data.voice.turkish.leaving.1", "text": "Abi, 여기 일하는 사람 없어요?", "src": "Abi, is nobody working here?"},
{"key": "data.voice.turkish.leaving.2", "text": "Tamam, hoşça kal.", "src": "Tamam, hoşça kal."},
{"key": "data.voice.turkish.order.0", "text": "Abi, {drink} 한 잔.", "src": "Abi, a {drink}."},
{"key": "data.voice.turkish.order.1", "text": "{drink} 하나요, eyvallah.", "src": "One {drink}, eyvallah."},
{"key": "data.voice.turkish.order.2", "text": "{drink} 부탁해요, canım. 시간 될 때.", "src": "{drink}, canım, when you can."},
{"key": "data.voice.turkish.order.3", "text": "Bir {drink} 주세요.", "src": "Bir {drink}, please."},
{"key": "data.voice.turkish.perfect.0", "text": "Eyvallah!", "src": "Eyvallah!"},
{"key": "data.voice.turkish.perfect.1", "text": "Harika!", "src": "Harika!"},
{"key": "data.voice.turkish.perfect.2", "text": "Süper, abi!", "src": "Süper, abi!"},
{"key": "data.voice.turkish.praise.0", "text": "Eyvallah. 이렇게 만드는 거죠.", "src": "Eyvallah. This is how it's done."},
{"key": "data.voice.turkish.praise.1", "text": "Abi, 존경합니다. Harika.", "src": "Abi, my hat is off. Harika."},
{"key": "data.voice.turkish.praise.2", "text": "Tamam, 일 좀 아시네요.", "src": "Tamam, you know your work."},
{"key": "data.voice.turkish.sip.0", "text": "Abi, {advice_l}", "src": "Abi, {advice_l}"},
{"key": "data.voice.turkish.sip.1", "text": "Bak, {advice_l}", "src": "Bak, {advice_l}"},
{"key": "data.voice.turkish.sip.2", "text": "Tamam ama, {advice_l}", "src": "Tamam ama, {advice_l}"},
{"key": "data.voice.turkish.wrong.0", "text": "Yok, 이거 아니에요.", "src": "Yok, not this."},
{"key": "data.voice.turkish.wrong.1", "text": "Abi, 잘못 나왔어요.", "src": "Abi, wrong one."},
{"key": "data.voice.turkish.wrong.2", "text": "Bu ne şimdi? 이게 뭐예요?", "src": "Bu ne şimdi?"}
]}
