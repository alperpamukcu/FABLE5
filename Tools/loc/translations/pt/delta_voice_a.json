{"strings": [
{"key": "data.voice.african.another.0", "text": "Traz outra!", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "Mais uma, abeg!", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "Outra vez, meu amigo!", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "Está bem.", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "No wahala.", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "Ok, muito bem.", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "Ah ah! A sério?", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala. Eu vou.", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "Meu amigo, isto não se faz.", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah ah. Já esperei que chegue.", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala. Vou-me embora.", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "Deixa-me ir, meu amigo.", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "{drink}, se faz favor.", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "Meu amigo: {drink}.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Para mim é {drink}.", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "{drink}, abeg.", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "Ah, que doce!", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "Certinho!", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "Esta está boa!", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, esta está certa. Bem haja.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "Wahala nenhum. Muito boa.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "Meu amigo, tu sabes da poda.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "Meu amigo, {advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg, {advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "Está bem, mas {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah, não.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "Não é esta.", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "Meu amigo, não.", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "O mesmo outra vez, mate!", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "Mais uma, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "Vá lá, outra!", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "Nada mau.", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Ta, isso serve.", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "Pronto, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Encantador. Absolutamente encantador.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "Certo. Pois. Cheers por nada.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "Estás a gozar comigo.", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Certo. Já esperei o suficiente.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "Que se lixe. Vou-me embora.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Isto é uma treta. Bye.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "{drink}, mate, quando tiveres um momento.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, por favor. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "Vá, então: {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "Para mim é {drink}, ta.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "Lovely!", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "Cheers, mate!", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "Muito bom mesmo!", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Blimey. Está mesmo lovely.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Isto foi feito como deve ser.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Boa à brava, isto.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "Só uma coisinha: {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Olha, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Isto não bate certo.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Erm, não é a minha.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "Não foi isto que pedi.", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "Mais uma, yaar!", "src": "One more, yaar!"},
{"key": "data.voice.desi.another.1", "text": "Aur ek!", "src": "Aur ek!"},
{"key": "data.voice.desi.another.2", "text": "Outra vez, por favor!", "src": "Again, please!"},
{"key": "data.voice.desi.close.0", "text": "Theek hai.", "src": "Theek hai."},
{"key": "data.voice.desi.close.1", "text": "Está bem, na.", "src": "It is okay, na."},
{"key": "data.voice.desi.close.2", "text": "Chalega.", "src": "Chalega."},
{"key": "data.voice.desi.kicked.0", "text": "Kya? A sério?", "src": "Kya? Seriously?"},
{"key": "data.voice.desi.kicked.1", "text": "Arre. Pronto, está bem.", "src": "Arre. Okay, fine."},
{"key": "data.voice.desi.kicked.2", "text": "Chalo. Eu vou.", "src": "Chalo. I go."},
{"key": "data.voice.desi.leaving.0", "text": "Arre yaar. Demora demais.", "src": "Arre yaar. Too long."},
{"key": "data.voice.desi.leaving.1", "text": "Chalo, vou-me embora.", "src": "Chalo, I am going."},
{"key": "data.voice.desi.leaving.2", "text": "Bas. Chega.", "src": "Bas. Enough."},
{"key": "data.voice.desi.order.0", "text": "{drink}, por favor.", "src": "One {drink}, please."},
{"key": "data.voice.desi.order.1", "text": "{drink}, yaar.", "src": "A {drink}, yaar."},
{"key": "data.voice.desi.order.2", "text": "Para mim é {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.desi.order.3", "text": "{drink}, na?", "src": "{drink}, na?"},
{"key": "data.voice.desi.perfect.0", "text": "Wah, perfeito!", "src": "Wah, perfect!"},
{"key": "data.voice.desi.perfect.1", "text": "Ekdum de primeira!", "src": "Ekdum first class!"},
{"key": "data.voice.desi.perfect.2", "text": "Bahut badhiya!", "src": "Bahut badhiya!"},
{"key": "data.voice.desi.praise.0", "text": "Wah. Ekdum perfeita, yaar.", "src": "Wah. Ekdum perfect, yaar."},
{"key": "data.voice.desi.praise.1", "text": "Bahut badhiya. A sério.", "src": "Bahut badhiya. Really."},
{"key": "data.voice.desi.praise.2", "text": "De primeira. Eu volto cá.", "src": "First class. I am coming back."},
{"key": "data.voice.desi.sip.0", "text": "Arre, {advice_l}", "src": "Arre, {advice_l}"},
{"key": "data.voice.desi.sip.1", "text": "Yaar, {advice_l}", "src": "Yaar, {advice_l}"},
{"key": "data.voice.desi.sip.2", "text": "Theek hai, mas {advice_l}", "src": "Theek hai, but {advice_l}"},
{"key": "data.voice.desi.wrong.0", "text": "Arre, não.", "src": "Arre, no."},
{"key": "data.voice.desi.wrong.1", "text": "Esta não é a minha.", "src": "This is not mine."},
{"key": "data.voice.desi.wrong.2", "text": "Nahi, veio a errada.", "src": "Nahi, wrong one."},
{"key": "data.voice.german.another.0", "text": "Noch eins!", "src": "Noch eins!"},
{"key": "data.voice.german.another.1", "text": "Outra, bitte!", "src": "Another, bitte!"},
{"key": "data.voice.german.another.2", "text": "Outra vez, por favor!", "src": "Again, please!"},
{"key": "data.voice.german.close.0", "text": "Ja, ok.", "src": "Ja, okay."},
{"key": "data.voice.german.close.1", "text": "Aceitável.", "src": "Acceptable."},
{"key": "data.voice.german.close.2", "text": "Está bem.", "src": "It is fine."},
{"key": "data.voice.german.kicked.0", "text": "Isto é absurdo.", "src": "This is absurd."},
{"key": "data.voice.german.kicked.1", "text": "Muito bem. Não volto cá.", "src": "Fine. I will not return."},
{"key": "data.voice.german.kicked.2", "text": "Ja, ja. Já vou.", "src": "Ja, ja. I am going."},
{"key": "data.voice.german.leaving.0", "text": "Isto não é aceitável. Vou-me embora.", "src": "This is not acceptable. I am leaving."},
{"key": "data.voice.german.leaving.1", "text": "Nein. Já esperei o suficiente.", "src": "Nein. I have waited enough."},
{"key": "data.voice.german.leaving.2", "text": "Unglaublich. Adeus.", "src": "Unglaublich. Goodbye."},
{"key": "data.voice.german.order.0", "text": "{drink}, por favor. Bem feito.", "src": "A {drink}, please. Correctly made."},
{"key": "data.voice.german.order.1", "text": "{drink}. Agradeço.", "src": "{drink}. Thank you."},
{"key": "data.voice.german.order.2", "text": "{drink}, bitte.", "src": "One {drink}, bitte."},
{"key": "data.voice.german.order.3", "text": "Gostaria de pedir: {drink}.", "src": "I would like a {drink}."},
{"key": "data.voice.german.perfect.0", "text": "Genau!", "src": "Genau!"},
{"key": "data.voice.german.perfect.1", "text": "Sehr gut!", "src": "Sehr gut!"},
{"key": "data.voice.german.perfect.2", "text": "Wunderbar!", "src": "Wunderbar!"},
{"key": "data.voice.german.praise.0", "text": "Ja. Exatamente como deve ser.", "src": "Ja. This is exactly right."},
{"key": "data.voice.german.praise.1", "text": "Rigoroso. Eu respeito o rigor.", "src": "Precise. I respect precision."},
{"key": "data.voice.german.praise.2", "text": "Sehr gut. Nada a apontar.", "src": "Sehr gut. No notes."},
{"key": "data.voice.german.sip.0", "text": "Genau, mas {advice_l}", "src": "Genau, but {advice_l}"},
{"key": "data.voice.german.sip.1", "text": "Uma observação: {advice_l}", "src": "One remark: {advice_l}"},
{"key": "data.voice.german.sip.2", "text": "Ja, {advice_l}", "src": "Ja, {advice_l}"},
{"key": "data.voice.german.wrong.0", "text": "Nein. Isto não.", "src": "Nein. Not this."},
{"key": "data.voice.german.wrong.1", "text": "Isto está incorreto.", "src": "This is incorrect."},
{"key": "data.voice.german.wrong.2", "text": "Bebida errada.", "src": "Wrong drink."},
{"key": "data.voice.korean.another.0", "text": "Han jan deo!", "src": "Han jan deo!"},
{"key": "data.voice.korean.another.1", "text": "Mais uma!", "src": "One more!"},
{"key": "data.voice.korean.another.2", "text": "Outra vez, juseyo!", "src": "Again, juseyo!"},
{"key": "data.voice.korean.close.0", "text": "Gwenchana.", "src": "Gwenchana."},
{"key": "data.voice.korean.close.1", "text": "Está tudo bem.", "src": "It is okay."},
{"key": "data.voice.korean.close.2", "text": "Nappeuji anha.", "src": "Nappeuji anha."},
{"key": "data.voice.korean.kicked.0", "text": "Jinjja? Uau.", "src": "Jinjja? Wow."},
{"key": "data.voice.korean.kicked.1", "text": "Aish. Está bem.", "src": "Aish. Fine."},
{"key": "data.voice.korean.kicked.2", "text": "Annyeong, então.", "src": "Annyeong, then."},
{"key": "data.voice.korean.leaving.0", "text": "Aish. Demora demais.", "src": "Aish. Too long."},
{"key": "data.voice.korean.leaving.1", "text": "Vou-me embora. Annyeong.", "src": "I am going. Annyeong."},
{"key": "data.voice.korean.leaving.2", "text": "Mot chamgesseo.", "src": "Mot chamgesseo."},
{"key": "data.voice.korean.order.0", "text": "{drink}, juseyo.", "src": "{drink}, juseyo."},
{"key": "data.voice.korean.order.1", "text": "{drink}, por favor.", "src": "One {drink}, please."},
{"key": "data.voice.korean.order.2", "text": "Para mim: {drink}.", "src": "A {drink} for me."},
{"key": "data.voice.korean.order.3", "text": "Apetece-me {drink}.", "src": "I want a {drink}."},
{"key": "data.voice.korean.perfect.0", "text": "Daebak!", "src": "Daebak!"},
{"key": "data.voice.korean.perfect.1", "text": "Jinjja boa!", "src": "Jinjja good!"},
{"key": "data.voice.korean.perfect.2", "text": "Choego!", "src": "Choego!"},
{"key": "data.voice.korean.praise.0", "text": "Daebak. Jinjja, está perfeita.", "src": "Daebak. Jinjja, this is perfect."},
{"key": "data.voice.korean.praise.1", "text": "Choego. Estou a falar a sério.", "src": "Choego. I mean it."},
{"key": "data.voice.korean.praise.2", "text": "Uau. Tu tens jeito para isto.", "src": "Wow. You are good at this."},
{"key": "data.voice.korean.sip.0", "text": "Jamkkanman, {advice_l}", "src": "Jamkkanman, {advice_l}"},
{"key": "data.voice.korean.sip.1", "text": "Hum, {advice_l}", "src": "Um, {advice_l}"},
{"key": "data.voice.korean.sip.2", "text": "Gwenchana, mas {advice_l}", "src": "Gwenchana, but {advice_l}"},
{"key": "data.voice.korean.wrong.0", "text": "Aniyo, não.", "src": "Aniyo, no."},
{"key": "data.voice.korean.wrong.1", "text": "Isto está errado.", "src": "This is wrong."},
{"key": "data.voice.korean.wrong.2", "text": "Hã? Não é a minha.", "src": "Eh? Not mine."},
{"key": "data.voice.nordic.another.0", "text": "Outra. Skål!", "src": "Another. Skål!"},
{"key": "data.voice.nordic.another.1", "text": "Mais uma.", "src": "One more."},
{"key": "data.voice.nordic.another.2", "text": "Outra vez, por favor.", "src": "Again, please."},
{"key": "data.voice.nordic.close.0", "text": "Pode ser.", "src": "Fine."},
{"key": "data.voice.nordic.close.1", "text": "Está bem.", "src": "It's okay."},
{"key": "data.voice.nordic.close.2", "text": "Chega bem.", "src": "Good enough."},
{"key": "data.voice.nordic.kicked.0", "text": "Ok. Estranho, mas ok.", "src": "Okay. Strange, but okay."},
{"key": "data.voice.nordic.kicked.1", "text": "Pronto.", "src": "Fine."},
{"key": "data.voice.nordic.kicked.2", "text": "Hm. Adeus, então.", "src": "Hm. Goodbye then."},
{"key": "data.voice.nordic.leaving.0", "text": "Eu vou. Não faz mal.", "src": "I'll go. It's fine."},
{"key": "data.voice.nordic.leaving.1", "text": "Demora demais. Adeus.", "src": "Too long. Goodbye."},
{"key": "data.voice.nordic.leaving.2", "text": "Não. Vou-me embora.", "src": "No. I'm leaving."},
{"key": "data.voice.nordic.order.0", "text": "{drink}, se faz favor.", "src": "A {drink}. Thanks."},
{"key": "data.voice.nordic.order.1", "text": "{drink}, por favor.", "src": "{drink}, please."},
{"key": "data.voice.nordic.order.2", "text": "{drink}. Sem pressa.", "src": "One {drink}. No rush."},
{"key": "data.voice.nordic.order.3", "text": "Para mim é {drink}.", "src": "I'll have the {drink}."},
{"key": "data.voice.nordic.perfect.0", "text": "Skål!", "src": "Skål!"},
{"key": "data.voice.nordic.perfect.1", "text": "Muito boa.", "src": "Very good."},
{"key": "data.voice.nordic.perfect.2", "text": "Sim. Boa.", "src": "Yes. Good."},
{"key": "data.voice.nordic.praise.0", "text": "Muito boa. E eu não costumo dizer isto.", "src": "This is very good. I don't say that."},
{"key": "data.voice.nordic.praise.1", "text": "Skål. Bem feita.", "src": "Skål. Properly done."},
{"key": "data.voice.nordic.praise.2", "text": "Boa. Mesmo boa.", "src": "Good. Really good."},
{"key": "data.voice.nordic.sip.0", "text": "Bem. {advice}", "src": "Well. {advice}"},
{"key": "data.voice.nordic.sip.1", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.nordic.sip.2", "text": "Está bem, mas {advice_l}", "src": "Fine, but {advice_l}"},
{"key": "data.voice.nordic.wrong.0", "text": "Não. É a errada.", "src": "No. Wrong one."},
{"key": "data.voice.nordic.wrong.1", "text": "Não é esta.", "src": "This is not it."},
{"key": "data.voice.nordic.wrong.2", "text": "Hm. Não é a minha.", "src": "Hm. Not mine."},
{"key": "data.voice.southern.another.0", "text": "Serve-me outra!", "src": "Pour me another!"},
{"key": "data.voice.southern.another.1", "text": "Mais uma, sugar!", "src": "One more, sugar!"},
{"key": "data.voice.southern.another.2", "text": "Venham elas!", "src": "Keep 'em comin'!"},
{"key": "data.voice.southern.close.0", "text": "Está tudo bem.", "src": "That's alright."},
{"key": "data.voice.southern.close.1", "text": "É justo.", "src": "Fair enough."},
{"key": "data.voice.southern.close.2", "text": "Bem, serve.", "src": "Well, it'll do."},
{"key": "data.voice.southern.kicked.0", "text": "Ora, que falta de educação.", "src": "Well, that's just rude."},
{"key": "data.voice.southern.kicked.1", "text": "Pronto, então. Have a good one.", "src": "Alright then. Have a good one."},
{"key": "data.voice.southern.kicked.2", "text": "Espera lá… pronto.", "src": "Now hold on… fine."},
{"key": "data.voice.southern.leaving.0", "text": "Olha, eu não tenho a noite toda.", "src": "Well, I ain't got all night."},
{"key": "data.voice.southern.leaving.1", "text": "Acho que vou beber para outro lado.", "src": "Reckon I'll drink elsewhere."},
{"key": "data.voice.southern.leaving.2", "text": "Y'all não têm pressa nenhuma, pois não?", "src": "Y'all take your sweet time, don't you."},
{"key": "data.voice.southern.order.0", "text": "Ora bem, {drink} caía-me bem.", "src": "Well now, a {drink} would suit me."},
{"key": "data.voice.southern.order.1", "text": "{drink}, darlin', se faz favor.", "src": "{drink}, darlin', if you please."},
{"key": "data.voice.southern.order.2", "text": "Acho que vou pedir: {drink}.", "src": "Reckon I'll have a {drink}."},
{"key": "data.voice.southern.order.3", "text": "{drink}, sugar.", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "Mas que maravilha!", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "Lord, que bom!", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "Hot dang!", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "Ora, ora. Isto sim, é uma bebida.", "src": "Well, I'll be. That's a proper drink."},
{"key": "data.voice.southern.praise.1", "text": "Darlin', tu tens um dom.", "src": "Darlin', you got a gift."},
{"key": "data.voice.southern.praise.2", "text": "Acho que encontrei o meu novo poiso.", "src": "Reckon I found my new spot."},
{"key": "data.voice.southern.sip.0", "text": "Ora, {advice_l}", "src": "Now, {advice_l}"},
{"key": "data.voice.southern.sip.1", "text": "Sugar, {advice_l}", "src": "Sugar, {advice_l}"},
{"key": "data.voice.southern.sip.2", "text": "Vou-te dizer uma coisa: {advice_l}", "src": "Tell you what, {advice_l}"},
{"key": "data.voice.southern.wrong.0", "text": "Não é a minha, hon.", "src": "Ain't mine, hon."},
{"key": "data.voice.southern.wrong.1", "text": "Então, o que é isto?", "src": "Now what is this?"},
{"key": "data.voice.southern.wrong.2", "text": "Bless your heart.", "src": "Bless your heart."}
]}
