{"strings": [
{"key": "data.voice.aussie.another.0", "text": "Outra igual, mate!", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "Mais uma, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "Outra, legend!", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "Yeah, righto.", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "Nada mau, mate.", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "Isso serve.", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "A sério, mate?", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto. É justo.", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Nah, isso foi duro.", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto, já esperei que chegue.", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Nah, que se lixe. Vou andando.", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "Cheers por nada, mate.", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "{drink}, mate.", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink}, por favor.", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "Vou pedir: {drink}.", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "{drink}, cheers.", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "Ripper!", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "Too easy!", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "Boa à brava!", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "Bloody ripper, mate. Cheers.", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "Too easy. Tu percebes disto.", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "A melhor da noite, a sério.", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "Olha, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "No dramas, mas {advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Nah, mate.", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "Não é a minha, desculpa.", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "Veio a errada, mate.", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "Mais uma ronda!", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "Outra igual!", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "Venham mais!", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "Bem haja.", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "Isso serve.", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "Anda lá perto.", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "A sério? Pronto.", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "Estás a cometer um erro.", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "Tanto faz. Fica lá com o teu bar.", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "Esquece. Fartei-me de esperar.", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "Há alguém a trabalhar hoje?", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "Pronto. Vou beber a outro lado.", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink}, se faz favor.", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "Para mim é {drink}.", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "{drink}, quando puderes.", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "Pode ser {drink}.", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "Perfeito!", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "É mesmo isto!", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "Em cheio!", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "Não mudava nada.", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "Isto sim, é uma bebida.", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "Quem te ensinou merece um obrigado.", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "Hum. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice} É só um reparo.", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "Sinceramente? {advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "Não foi isto que pedi.", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "Bebida errada.", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "Isto não é meu.", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "Encore, por favor!", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "Mais uma, oui!", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "Outra vez, merci!", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ça va.", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "Está bem.", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon, ok.", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "Quoi? A sério?", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Bon. Au revoir.", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule.", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non. Já esperei que chegue.", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis. Vou-me embora.", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "Au revoir, então.", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "{drink}, s'il vous plaît.", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "{drink}, por favor.", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "Un {drink}, merci.", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "Para mim é {drink}.", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "Parfait!", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "Voilà, perfeita!", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "Magnifique!", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait. Não tenho nada a apontar.", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voilà. Alguém aqui sabe servir.", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique. A sério.", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Écoute, {advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon, {advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors, {advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non.", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "Não é esta.", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon, está errada.", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "Mou ippai!", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "Mais uma, kanpai!", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "Outra vez, onegai!", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Hai, ok.", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa.", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "Nada mau, ne.", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "Eh?! A sério?", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi. Ok, eu vou.", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta. Sayonara.", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen, não consigo esperar mais.", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii. Vou-me embora.", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai. Adeus.", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen, {drink}.", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "{drink}, onegai.", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink}, por favor. Arigatou.", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto… {drink}.", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "Oishii!", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "Sugoi, perfeita!", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "Kanpai!", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii. A sério, é esta.", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "Sugoi. Trabalho de profissional, ne.", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "Kanpai. Está perfeita.", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "Etto, {advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "Ne, {advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "Sumimasen, mas {advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "Chotto… não.", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "Eh? Isto não.", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "Chigau, desculpa.", "src": "Chigau, sorry."},
{"key": "data.voice.midwest.another.0", "text": "Outra, por favor!", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "Mais uma, thanks!", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "O mesmo outra vez, ope!", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "Oh, está ótimo.", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "Claro, thanks.", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "Nada mau, mesmo.", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "Oh. Bem. Ok, então.", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "Ope, desculpa… eu vou.", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "É um bocadinho demais, mas ok.", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "Oh gosh, já não consigo esperar mais.", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "Bem, tenho de ir andando.", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "Desculpa, mas vou indo.", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "Pode ser {drink}? Thanks a bunch.", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "{drink}, se não for incómodo.", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "Oh, só {drink} para mim.", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink}, por favor. Quando der.", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "Oh, que bom!", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "You betcha!", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "Oh jeez, sim!", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "Oh my gosh, está simplesmente uma delícia.", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "Muito bom. A minha tia ia adorar isto aqui.", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "Bem, isto soube mesmo bem.", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "Oh, {advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "Só para saberes, {advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "Não é nada de especial, mas {advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "Ope. Veio a errada.", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "Oh, essa não é a minha.", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "Desculpa, não. Isto não.", "src": "Sorry, no. Not this."},
{"key": "data.voice.polish.another.0", "text": "Jeszcze raz!", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "Outra, proszę!", "src": "Another, proszę!"},
{"key": "data.voice.polish.another.2", "text": "Mais uma!", "src": "One more!"},
{"key": "data.voice.polish.close.0", "text": "Dobrze.", "src": "Dobrze."},
{"key": "data.voice.polish.close.1", "text": "Ok.", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "Está bem, pode ser.", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "Serio? Ok.", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "Está bem. Do widzenia.", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "Co? Ok, eu vou.", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "Chega. Vou-me embora.", "src": "Enough. I'm going."},
{"key": "data.voice.polish.leaving.1", "text": "Nie, nie. Demora demais.", "src": "Nie, nie. Too long."},
{"key": "data.voice.polish.leaving.2", "text": "Do widzenia.", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "{drink}, proszę.", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "{drink}, por favor.", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "{drink}. Agradeço.", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "Dobrze, {drink}.", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "Na zdrowie!", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "Świetnie!", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "Muito boa!", "src": "Very good!"},
{"key": "data.voice.polish.praise.0", "text": "Na zdrowie. Isto é uma bebida a sério.", "src": "Na zdrowie. This is a real drink."},
{"key": "data.voice.polish.praise.1", "text": "Świetnie. Como em casa.", "src": "Świetnie. Like at home."},
{"key": "data.voice.polish.praise.2", "text": "Dobrze. Muito, muito boa.", "src": "Dobrze. Very, very good."},
{"key": "data.voice.polish.sip.0", "text": "Dobrze, mas {advice_l}", "src": "Dobrze, but {advice_l}"},
{"key": "data.voice.polish.sip.1", "text": "Ouve, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.polish.sip.2", "text": "Hm, {advice_l}", "src": "Hm, {advice_l}"},
{"key": "data.voice.polish.wrong.0", "text": "Nie. É a errada.", "src": "Nie. Wrong one."},
{"key": "data.voice.polish.wrong.1", "text": "Esta não é a minha.", "src": "This is not mine."},
{"key": "data.voice.polish.wrong.2", "text": "Co to jest?", "src": "Co to jest?"},
{"key": "data.voice.turkish.another.0", "text": "Bir daha!", "src": "Bir daha!"},
{"key": "data.voice.turkish.another.1", "text": "Outra, abi!", "src": "Another, abi!"},
{"key": "data.voice.turkish.another.2", "text": "Outra vez, eyvallah!", "src": "Again, eyvallah!"},
{"key": "data.voice.turkish.close.0", "text": "Tamam.", "src": "Tamam."},
{"key": "data.voice.turkish.close.1", "text": "İdare eder.", "src": "İdare eder."},
{"key": "data.voice.turkish.close.2", "text": "Ok, está bem.", "src": "Okay, fine."},
{"key": "data.voice.turkish.kicked.0", "text": "Ciddi misin? Ok.", "src": "Ciddi misin? Okay."},
{"key": "data.voice.turkish.kicked.1", "text": "Abi, a sério? Pronto.", "src": "Abi, really? Fine."},
{"key": "data.voice.turkish.kicked.2", "text": "Yok, yok. Vou-me embora.", "src": "Yok, yok. I'm going."},
{"key": "data.voice.turkish.leaving.0", "text": "Yok, não espero mais.", "src": "Yok, I'm not waiting anymore."},
{"key": "data.voice.turkish.leaving.1", "text": "Abi, ninguém trabalha aqui?", "src": "Abi, is nobody working here?"},
{"key": "data.voice.turkish.leaving.2", "text": "Tamam, hoşça kal.", "src": "Tamam, hoşça kal."},
{"key": "data.voice.turkish.order.0", "text": "Abi, {drink}.", "src": "Abi, a {drink}."},
{"key": "data.voice.turkish.order.1", "text": "{drink}, eyvallah.", "src": "One {drink}, eyvallah."},
{"key": "data.voice.turkish.order.2", "text": "{drink}, canım, quando puderes.", "src": "{drink}, canım, when you can."},
{"key": "data.voice.turkish.order.3", "text": "Bir {drink}, por favor.", "src": "Bir {drink}, please."},
{"key": "data.voice.turkish.perfect.0", "text": "Eyvallah!", "src": "Eyvallah!"},
{"key": "data.voice.turkish.perfect.1", "text": "Harika!", "src": "Harika!"},
{"key": "data.voice.turkish.perfect.2", "text": "Süper, abi!", "src": "Süper, abi!"},
{"key": "data.voice.turkish.praise.0", "text": "Eyvallah. É assim que se faz.", "src": "Eyvallah. This is how it's done."},
{"key": "data.voice.turkish.praise.1", "text": "Abi, tiro-te o chapéu. Harika.", "src": "Abi, my hat is off. Harika."},
{"key": "data.voice.turkish.praise.2", "text": "Tamam, tu conheces o ofício.", "src": "Tamam, you know your work."},
{"key": "data.voice.turkish.sip.0", "text": "Abi, {advice_l}", "src": "Abi, {advice_l}"},
{"key": "data.voice.turkish.sip.1", "text": "Bak, {advice_l}", "src": "Bak, {advice_l}"},
{"key": "data.voice.turkish.sip.2", "text": "Tamam ama, {advice_l}", "src": "Tamam ama, {advice_l}"},
{"key": "data.voice.turkish.wrong.0", "text": "Yok, isto não.", "src": "Yok, not this."},
{"key": "data.voice.turkish.wrong.1", "text": "Abi, veio a errada.", "src": "Abi, wrong one."},
{"key": "data.voice.turkish.wrong.2", "text": "Bu ne şimdi?", "src": "Bu ne şimdi?"}
]}
