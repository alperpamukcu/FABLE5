{"strings": [
{"key": "data.voice.african.another.0", "text": "Bir tane daha getir!", "src": "Bring another!"},
{"key": "data.voice.african.another.1", "text": "Bir daha, abeg!", "src": "One more, abeg!"},
{"key": "data.voice.african.another.2", "text": "Yine, dostum!", "src": "Again, my friend!"},
{"key": "data.voice.african.close.0", "text": "İdare eder.", "src": "It is fine."},
{"key": "data.voice.african.close.1", "text": "No wahala.", "src": "No wahala."},
{"key": "data.voice.african.close.2", "text": "Tamam, sağ ol.", "src": "Okay, thanks."},
{"key": "data.voice.african.kicked.0", "text": "Ah ah! Ciddi misin?", "src": "Ah ah! Serious?"},
{"key": "data.voice.african.kicked.1", "text": "No wahala. Gidiyorum.", "src": "No wahala. I go."},
{"key": "data.voice.african.kicked.2", "text": "Dostum, bu hiç hoş değil.", "src": "My friend, this is bad."},
{"key": "data.voice.african.leaving.0", "text": "Ah ah. Yeterince bekledim.", "src": "Ah ah. I have waited enough."},
{"key": "data.voice.african.leaving.1", "text": "No wahala. Ben kalkıyorum.", "src": "No wahala. I am going."},
{"key": "data.voice.african.leaving.2", "text": "Bırak gideyim, dostum.", "src": "Let me go, my friend."},
{"key": "data.voice.african.order.0", "text": "Bir {drink}, lütfen.", "src": "A {drink}, please."},
{"key": "data.voice.african.order.1", "text": "Bir {drink}, dostum.", "src": "One {drink}, my friend."},
{"key": "data.voice.african.order.2", "text": "Ben {drink} alayım.", "src": "I will have a {drink}."},
{"key": "data.voice.african.order.3", "text": "{drink}, abeg.", "src": "{drink}, abeg."},
{"key": "data.voice.african.perfect.0", "text": "Ah, nefis!", "src": "Ah, sweet!"},
{"key": "data.voice.african.perfect.1", "text": "Tam isabet!", "src": "Correct!"},
{"key": "data.voice.african.perfect.2", "text": "Bu çok güzel!", "src": "This one is nice!"},
{"key": "data.voice.african.praise.0", "text": "Ah, bu tam olmuş. Sağ ol.", "src": "Ah, this one is correct. Thank you."},
{"key": "data.voice.african.praise.1", "text": "Hiç wahala yok. Çok güzel.", "src": "No wahala at all. Very nice."},
{"key": "data.voice.african.praise.2", "text": "Dostum, sen bu işi biliyorsun.", "src": "My friend, you know book."},
{"key": "data.voice.african.sip.0", "text": "Dostum, {advice_l}", "src": "My friend, {advice_l}"},
{"key": "data.voice.african.sip.1", "text": "Abeg, {advice_l}", "src": "Abeg, {advice_l}"},
{"key": "data.voice.african.sip.2", "text": "İdare eder ama {advice_l}", "src": "It is fine, but {advice_l}"},
{"key": "data.voice.african.wrong.0", "text": "Ah ah, yok.", "src": "Ah ah, no."},
{"key": "data.voice.african.wrong.1", "text": "Bu değil.", "src": "This is not it."},
{"key": "data.voice.african.wrong.2", "text": "Dostum, olmadı.", "src": "My friend, no."},
{"key": "data.voice.brit.another.0", "text": "Aynısından, mate!", "src": "Same again, mate!"},
{"key": "data.voice.brit.another.1", "text": "Bir tane daha, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.brit.another.2", "text": "Hadi, bir daha!", "src": "Go on, another!"},
{"key": "data.voice.brit.close.0", "text": "Fena değil.", "src": "Not bad."},
{"key": "data.voice.brit.close.1", "text": "Ta, iş görür.", "src": "Ta, that'll do."},
{"key": "data.voice.brit.close.2", "text": "Pekâlâ, cheers.", "src": "Alright, cheers."},
{"key": "data.voice.brit.kicked.0", "text": "Ne kibar. Gerçekten çok kibar.", "src": "Charming. Absolutely charming."},
{"key": "data.voice.brit.kicked.1", "text": "Peki. Hiçbir şey için cheers.", "src": "Right. Well. Cheers for nothing."},
{"key": "data.voice.brit.kicked.2", "text": "Dalga geçiyorsun herhalde.", "src": "You're having a laugh."},
{"key": "data.voice.brit.leaving.0", "text": "Peki. Yeterince bekledim.", "src": "Right. I've waited long enough."},
{"key": "data.voice.brit.leaving.1", "text": "Boş ver bunu. Ben kaçtım.", "src": "Sod this. I'm off."},
{"key": "data.voice.brit.leaving.2", "text": "Biraz rubbish bu. Bye.", "src": "Bit rubbish, this. Bye."},
{"key": "data.voice.brit.order.0", "text": "Bir {drink}, mate, müsait olunca.", "src": "A {drink}, mate, when you've a moment."},
{"key": "data.voice.brit.order.1", "text": "{drink}, lütfen. Cheers.", "src": "{drink}, please. Cheers."},
{"key": "data.voice.brit.order.2", "text": "Hadi bakalım, bir {drink}.", "src": "Go on then, a {drink}."},
{"key": "data.voice.brit.order.3", "text": "Bir {drink} alayım, ta.", "src": "I'll have a {drink}, ta."},
{"key": "data.voice.brit.perfect.0", "text": "Lovely!", "src": "Lovely!"},
{"key": "data.voice.brit.perfect.1", "text": "Cheers, mate!", "src": "Cheers, mate!"},
{"key": "data.voice.brit.perfect.2", "text": "Proper iyi!", "src": "Proper good!"},
{"key": "data.voice.brit.praise.0", "text": "Blimey. Bu gerçekten lovely.", "src": "Blimey. That's actually lovely."},
{"key": "data.voice.brit.praise.1", "text": "Cheers. Hakkını vermişsin.", "src": "Cheers. You've done that properly."},
{"key": "data.voice.brit.praise.2", "text": "Fena halde iyi, bu.", "src": "Bloody good, that."},
{"key": "data.voice.brit.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.brit.sip.1", "text": "Ufak bir şey: {advice_l}", "src": "Bit of a thing: {advice_l}"},
{"key": "data.voice.brit.sip.2", "text": "Bak, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.brit.wrong.0", "text": "Biraz yamuk bu.", "src": "Bit off, that."},
{"key": "data.voice.brit.wrong.1", "text": "Şey, benimki değil.", "src": "Erm, not mine."},
{"key": "data.voice.brit.wrong.2", "text": "İstediğim bu değil.", "src": "Not what I asked."},
{"key": "data.voice.desi.another.0", "text": "Bir tane daha, yaar!", "src": "One more, yaar!"},
{"key": "data.voice.desi.another.1", "text": "Aur ek!", "src": "Aur ek!"},
{"key": "data.voice.desi.another.2", "text": "Bir daha, lütfen!", "src": "Again, please!"},
{"key": "data.voice.desi.close.0", "text": "Theek hai.", "src": "Theek hai."},
{"key": "data.voice.desi.close.1", "text": "İdare eder, na.", "src": "It is okay, na."},
{"key": "data.voice.desi.close.2", "text": "Chalega.", "src": "Chalega."},
{"key": "data.voice.desi.kicked.0", "text": "Kya? Ciddi misin?", "src": "Kya? Seriously?"},
{"key": "data.voice.desi.kicked.1", "text": "Arre. Peki, tamam.", "src": "Arre. Okay, fine."},
{"key": "data.voice.desi.kicked.2", "text": "Chalo. Gidiyorum.", "src": "Chalo. I go."},
{"key": "data.voice.desi.leaving.0", "text": "Arre yaar. Çok uzun sürdü.", "src": "Arre yaar. Too long."},
{"key": "data.voice.desi.leaving.1", "text": "Chalo, ben kalkıyorum.", "src": "Chalo, I am going."},
{"key": "data.voice.desi.leaving.2", "text": "Bas. Yeter.", "src": "Bas. Enough."},
{"key": "data.voice.desi.order.0", "text": "Bir {drink}, lütfen.", "src": "One {drink}, please."},
{"key": "data.voice.desi.order.1", "text": "Bir {drink}, yaar.", "src": "A {drink}, yaar."},
{"key": "data.voice.desi.order.2", "text": "Ben {drink} alayım.", "src": "I will take a {drink}."},
{"key": "data.voice.desi.order.3", "text": "{drink}, na?", "src": "{drink}, na?"},
{"key": "data.voice.desi.perfect.0", "text": "Wah, mükemmel!", "src": "Wah, perfect!"},
{"key": "data.voice.desi.perfect.1", "text": "Ekdum birinci sınıf!", "src": "Ekdum first class!"},
{"key": "data.voice.desi.perfect.2", "text": "Bahut badhiya!", "src": "Bahut badhiya!"},
{"key": "data.voice.desi.praise.0", "text": "Wah. Ekdum kusursuz, yaar.", "src": "Wah. Ekdum perfect, yaar."},
{"key": "data.voice.desi.praise.1", "text": "Bahut badhiya. Gerçekten.", "src": "Bahut badhiya. Really."},
{"key": "data.voice.desi.praise.2", "text": "Birinci sınıf. Yine geleceğim.", "src": "First class. I am coming back."},
{"key": "data.voice.desi.sip.0", "text": "Arre, {advice_l}", "src": "Arre, {advice_l}"},
{"key": "data.voice.desi.sip.1", "text": "Yaar, {advice_l}", "src": "Yaar, {advice_l}"},
{"key": "data.voice.desi.sip.2", "text": "Theek hai ama {advice_l}", "src": "Theek hai, but {advice_l}"},
{"key": "data.voice.desi.wrong.0", "text": "Arre, yok.", "src": "Arre, no."},
{"key": "data.voice.desi.wrong.1", "text": "Bu benimki değil.", "src": "This is not mine."},
{"key": "data.voice.desi.wrong.2", "text": "Nahi, yanlış bu.", "src": "Nahi, wrong one."},
{"key": "data.voice.german.another.0", "text": "Noch eins!", "src": "Noch eins!"},
{"key": "data.voice.german.another.1", "text": "Bir tane daha, bitte!", "src": "Another, bitte!"},
{"key": "data.voice.german.another.2", "text": "Tekrar, lütfen!", "src": "Again, please!"},
{"key": "data.voice.german.close.0", "text": "Ja, tamam.", "src": "Ja, okay."},
{"key": "data.voice.german.close.1", "text": "Kabul edilebilir.", "src": "Acceptable."},
{"key": "data.voice.german.close.2", "text": "Olur.", "src": "It is fine."},
{"key": "data.voice.german.kicked.0", "text": "Bu saçmalık.", "src": "This is absurd."},
{"key": "data.voice.german.kicked.1", "text": "Peki. Bir daha gelmem.", "src": "Fine. I will not return."},
{"key": "data.voice.german.kicked.2", "text": "Ja, ja. Gidiyorum.", "src": "Ja, ja. I am going."},
{"key": "data.voice.german.leaving.0", "text": "Bu kabul edilemez. Gidiyorum.", "src": "This is not acceptable. I am leaving."},
{"key": "data.voice.german.leaving.1", "text": "Nein. Yeterince bekledim.", "src": "Nein. I have waited enough."},
{"key": "data.voice.german.leaving.2", "text": "Unglaublich. Hoşça kalın.", "src": "Unglaublich. Goodbye."},
{"key": "data.voice.german.order.0", "text": "Bir {drink}, lütfen. Doğru yapılmış olsun.", "src": "A {drink}, please. Correctly made."},
{"key": "data.voice.german.order.1", "text": "{drink}. Teşekkürler.", "src": "{drink}. Thank you."},
{"key": "data.voice.german.order.2", "text": "Bir {drink}, bitte.", "src": "One {drink}, bitte."},
{"key": "data.voice.german.order.3", "text": "Bir {drink} rica ediyorum.", "src": "I would like a {drink}."},
{"key": "data.voice.german.perfect.0", "text": "Genau!", "src": "Genau!"},
{"key": "data.voice.german.perfect.1", "text": "Sehr gut!", "src": "Sehr gut!"},
{"key": "data.voice.german.perfect.2", "text": "Wunderbar!", "src": "Wunderbar!"},
{"key": "data.voice.german.praise.0", "text": "Ja. Tam olması gerektiği gibi.", "src": "Ja. This is exactly right."},
{"key": "data.voice.german.praise.1", "text": "Hassas iş. Hassasiyete saygım var.", "src": "Precise. I respect precision."},
{"key": "data.voice.german.praise.2", "text": "Sehr gut. Diyecek bir şey yok.", "src": "Sehr gut. No notes."},
{"key": "data.voice.german.sip.0", "text": "Genau, ama {advice_l}", "src": "Genau, but {advice_l}"},
{"key": "data.voice.german.sip.1", "text": "Bir not: {advice_l}", "src": "One remark: {advice_l}"},
{"key": "data.voice.german.sip.2", "text": "Ja, {advice_l}", "src": "Ja, {advice_l}"},
{"key": "data.voice.german.wrong.0", "text": "Nein. Bu değil.", "src": "Nein. Not this."},
{"key": "data.voice.german.wrong.1", "text": "Bu yanlış.", "src": "This is incorrect."},
{"key": "data.voice.german.wrong.2", "text": "Yanlış içki.", "src": "Wrong drink."},
{"key": "data.voice.korean.another.0", "text": "Han jan deo!", "src": "Han jan deo!"},
{"key": "data.voice.korean.another.1", "text": "Bir tane daha!", "src": "One more!"},
{"key": "data.voice.korean.another.2", "text": "Tekrar, juseyo!", "src": "Again, juseyo!"},
{"key": "data.voice.korean.close.0", "text": "Gwenchana.", "src": "Gwenchana."},
{"key": "data.voice.korean.close.1", "text": "İdare eder.", "src": "It is okay."},
{"key": "data.voice.korean.close.2", "text": "Nappeuji anha.", "src": "Nappeuji anha."},
{"key": "data.voice.korean.kicked.0", "text": "Jinjja? Vay be.", "src": "Jinjja? Wow."},
{"key": "data.voice.korean.kicked.1", "text": "Aish. Peki.", "src": "Aish. Fine."},
{"key": "data.voice.korean.kicked.2", "text": "O zaman annyeong.", "src": "Annyeong, then."},
{"key": "data.voice.korean.leaving.0", "text": "Aish. Çok uzun sürdü.", "src": "Aish. Too long."},
{"key": "data.voice.korean.leaving.1", "text": "Gidiyorum. Annyeong.", "src": "I am going. Annyeong."},
{"key": "data.voice.korean.leaving.2", "text": "Mot chamgesseo.", "src": "Mot chamgesseo."},
{"key": "data.voice.korean.order.0", "text": "{drink}, juseyo.", "src": "{drink}, juseyo."},
{"key": "data.voice.korean.order.1", "text": "Bir {drink}, lütfen.", "src": "One {drink}, please."},
{"key": "data.voice.korean.order.2", "text": "Bana bir {drink}.", "src": "A {drink} for me."},
{"key": "data.voice.korean.order.3", "text": "Bir {drink} istiyorum.", "src": "I want a {drink}."},
{"key": "data.voice.korean.perfect.0", "text": "Daebak!", "src": "Daebak!"},
{"key": "data.voice.korean.perfect.1", "text": "Jinjja güzel!", "src": "Jinjja good!"},
{"key": "data.voice.korean.perfect.2", "text": "Choego!", "src": "Choego!"},
{"key": "data.voice.korean.praise.0", "text": "Daebak. Jinjja, bu kusursuz.", "src": "Daebak. Jinjja, this is perfect."},
{"key": "data.voice.korean.praise.1", "text": "Choego. Ciddiyim.", "src": "Choego. I mean it."},
{"key": "data.voice.korean.praise.2", "text": "Vay. Bu işte iyisin.", "src": "Wow. You are good at this."},
{"key": "data.voice.korean.sip.0", "text": "Jamkkanman, {advice_l}", "src": "Jamkkanman, {advice_l}"},
{"key": "data.voice.korean.sip.1", "text": "Şey, {advice_l}", "src": "Um, {advice_l}"},
{"key": "data.voice.korean.sip.2", "text": "Gwenchana ama {advice_l}", "src": "Gwenchana, but {advice_l}"},
{"key": "data.voice.korean.wrong.0", "text": "Aniyo, yok.", "src": "Aniyo, no."},
{"key": "data.voice.korean.wrong.1", "text": "Bu yanlış.", "src": "This is wrong."},
{"key": "data.voice.korean.wrong.2", "text": "Eh? Benimki değil.", "src": "Eh? Not mine."},
{"key": "data.voice.nordic.another.0", "text": "Bir tane daha. Skål!", "src": "Another. Skål!"},
{"key": "data.voice.nordic.another.1", "text": "Bir daha.", "src": "One more."},
{"key": "data.voice.nordic.another.2", "text": "Tekrar, lütfen.", "src": "Again, please."},
{"key": "data.voice.nordic.close.0", "text": "Olur.", "src": "Fine."},
{"key": "data.voice.nordic.close.1", "text": "Fena değil.", "src": "It's okay."},
{"key": "data.voice.nordic.close.2", "text": "Yeterince iyi.", "src": "Good enough."},
{"key": "data.voice.nordic.kicked.0", "text": "Tamam. Garip ama tamam.", "src": "Okay. Strange, but okay."},
{"key": "data.voice.nordic.kicked.1", "text": "Peki.", "src": "Fine."},
{"key": "data.voice.nordic.kicked.2", "text": "Hm. Hoşça kal o zaman.", "src": "Hm. Goodbye then."},
{"key": "data.voice.nordic.leaving.0", "text": "Ben gideyim. Sorun yok.", "src": "I'll go. It's fine."},
{"key": "data.voice.nordic.leaving.1", "text": "Çok uzun. Hoşça kal.", "src": "Too long. Goodbye."},
{"key": "data.voice.nordic.leaving.2", "text": "Yok. Gidiyorum.", "src": "No. I'm leaving."},
{"key": "data.voice.nordic.order.0", "text": "Bir {drink}. Teşekkürler.", "src": "A {drink}. Thanks."},
{"key": "data.voice.nordic.order.1", "text": "{drink}, lütfen.", "src": "{drink}, please."},
{"key": "data.voice.nordic.order.2", "text": "Bir {drink}. Acelesi yok.", "src": "One {drink}. No rush."},
{"key": "data.voice.nordic.order.3", "text": "{drink} alayım.", "src": "I'll have the {drink}."},
{"key": "data.voice.nordic.perfect.0", "text": "Skål!", "src": "Skål!"},
{"key": "data.voice.nordic.perfect.1", "text": "Çok iyi.", "src": "Very good."},
{"key": "data.voice.nordic.perfect.2", "text": "Evet. Güzel.", "src": "Yes. Good."},
{"key": "data.voice.nordic.praise.0", "text": "Bu çok iyi. Bunu pek söylemem.", "src": "This is very good. I don't say that."},
{"key": "data.voice.nordic.praise.1", "text": "Skål. Hakkıyla yapılmış.", "src": "Skål. Properly done."},
{"key": "data.voice.nordic.praise.2", "text": "İyi. Gerçekten iyi.", "src": "Good. Really good."},
{"key": "data.voice.nordic.sip.0", "text": "Eh. {advice}", "src": "Well. {advice}"},
{"key": "data.voice.nordic.sip.1", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.nordic.sip.2", "text": "Olur ama {advice_l}", "src": "Fine, but {advice_l}"},
{"key": "data.voice.nordic.wrong.0", "text": "Yok. Yanlış bu.", "src": "No. Wrong one."},
{"key": "data.voice.nordic.wrong.1", "text": "Bu değil.", "src": "This is not it."},
{"key": "data.voice.nordic.wrong.2", "text": "Hm. Benimki değil.", "src": "Hm. Not mine."},
{"key": "data.voice.southern.another.0", "text": "Bir tane daha doldur!", "src": "Pour me another!"},
{"key": "data.voice.southern.another.1", "text": "Bir daha, sugar!", "src": "One more, sugar!"},
{"key": "data.voice.southern.another.2", "text": "Durma, arkası gelsin!", "src": "Keep 'em comin'!"},
{"key": "data.voice.southern.close.0", "text": "Olmuş sayılır.", "src": "That's alright."},
{"key": "data.voice.southern.close.1", "text": "Pekâlâ, kabul.", "src": "Fair enough."},
{"key": "data.voice.southern.close.2", "text": "Eh, iş görür.", "src": "Well, it'll do."},
{"key": "data.voice.southern.kicked.0", "text": "Eh, bu düpedüz kabalık.", "src": "Well, that's just rude."},
{"key": "data.voice.southern.kicked.1", "text": "Peki öyleyse. İyi akşamlar.", "src": "Alright then. Have a good one."},
{"key": "data.voice.southern.kicked.2", "text": "Dur bir dakika… peki.", "src": "Now hold on… fine."},
{"key": "data.voice.southern.leaving.0", "text": "Bütün gece bekleyecek değilim.", "src": "Well, I ain't got all night."},
{"key": "data.voice.southern.leaving.1", "text": "Başka yerde içerim herhalde.", "src": "Reckon I'll drink elsewhere."},
{"key": "data.voice.southern.leaving.2", "text": "Y'all hiç acele etmiyorsunuz, değil mi?", "src": "Y'all take your sweet time, don't you."},
{"key": "data.voice.southern.order.0", "text": "Şimdi bir {drink} iyi giderdi.", "src": "Well now, a {drink} would suit me."},
{"key": "data.voice.southern.order.1", "text": "{drink}, darlin', zahmet olmazsa.", "src": "{drink}, darlin', if you please."},
{"key": "data.voice.southern.order.2", "text": "Bir {drink} alayım derim.", "src": "Reckon I'll have a {drink}."},
{"key": "data.voice.southern.order.3", "text": "Bir {drink}, sugar.", "src": "One {drink}, sugar."},
{"key": "data.voice.southern.perfect.0", "text": "İşte bu be!", "src": "Ain't that fine!"},
{"key": "data.voice.southern.perfect.1", "text": "Lord, bu çok iyi!", "src": "Lord, that's good!"},
{"key": "data.voice.southern.perfect.2", "text": "Hot dang!", "src": "Hot dang!"},
{"key": "data.voice.southern.praise.0", "text": "Vay vay. İşte adam gibi içki.", "src": "Well, I'll be. That's a proper drink."},
{"key": "data.voice.southern.praise.1", "text": "Darlin', sende bu iş var.", "src": "Darlin', you got a gift."},
{"key": "data.voice.southern.praise.2", "text": "Galiba yeni mekânımı buldum.", "src": "Reckon I found my new spot."},
