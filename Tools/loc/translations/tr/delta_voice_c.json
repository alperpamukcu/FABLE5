{"strings": [
{"key": "data.voice.aussie.another.0", "text": "Aynısı bir daha, mate!", "src": "Same again, mate!"},
{"key": "data.voice.aussie.another.1", "text": "Bir tane daha, cheers!", "src": "One more, cheers!"},
{"key": "data.voice.aussie.another.2", "text": "Bir daha, legend!", "src": "Another, legend!"},
{"key": "data.voice.aussie.close.0", "text": "Yeah, righto.", "src": "Yeah, righto."},
{"key": "data.voice.aussie.close.1", "text": "Fena değil, mate.", "src": "Not bad, mate."},
{"key": "data.voice.aussie.close.2", "text": "İş görür.", "src": "That'll do."},
{"key": "data.voice.aussie.kicked.0", "text": "Ciddi misin, mate?", "src": "You serious, mate?"},
{"key": "data.voice.aussie.kicked.1", "text": "Righto. Anlaşıldı.", "src": "Righto. Fair enough."},
{"key": "data.voice.aussie.kicked.2", "text": "Nah, bu biraz sert.", "src": "Nah, that's rough."},
{"key": "data.voice.aussie.leaving.0", "text": "Righto, yeterince bekledim.", "src": "Righto, I have waited long enough."},
{"key": "data.voice.aussie.leaving.1", "text": "Nah, boş ver. Ben gidiyorum.", "src": "Nah, stuff this. Off I go."},
{"key": "data.voice.aussie.leaving.2", "text": "Sağ ol hiçbir şey için, mate.", "src": "Cheers for nothing, mate."},
{"key": "data.voice.aussie.order.0", "text": "Bir {drink}, mate.", "src": "A {drink}, mate."},
{"key": "data.voice.aussie.order.1", "text": "{drink}, lütfen.", "src": "{drink}, please."},
{"key": "data.voice.aussie.order.2", "text": "Bir {drink} kapayım.", "src": "I'll grab a {drink}."},
{"key": "data.voice.aussie.order.3", "text": "Bir {drink}, cheers.", "src": "One {drink}, cheers."},
{"key": "data.voice.aussie.perfect.0", "text": "Süper, mate!", "src": "Ripper!"},
{"key": "data.voice.aussie.perfect.1", "text": "Bu iş tamam!", "src": "Too easy!"},
{"key": "data.voice.aussie.perfect.2", "text": "Acayip iyi!", "src": "Bloody good!"},
{"key": "data.voice.aussie.praise.0", "text": "Efsane olmuş, mate. Cheers.", "src": "Bloody ripper, mate. Cheers."},
{"key": "data.voice.aussie.praise.1", "text": "Çocuk oyuncağı. İşini biliyorsun.", "src": "Too easy. You know your stuff."},
{"key": "data.voice.aussie.praise.2", "text": "Bütün gecenin en iyisi, cidden.", "src": "Best one all night, honestly."},
{"key": "data.voice.aussie.sip.0", "text": "Mate, {advice_l}", "src": "Mate, {advice_l}"},
{"key": "data.voice.aussie.sip.1", "text": "Bak, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.aussie.sip.2", "text": "Dert değil ama {advice_l}", "src": "No dramas, but {advice_l}"},
{"key": "data.voice.aussie.wrong.0", "text": "Nah, mate.", "src": "Nah, mate."},
{"key": "data.voice.aussie.wrong.1", "text": "Benimki değil, sorry.", "src": "Not mine, sorry."},
{"key": "data.voice.aussie.wrong.2", "text": "Yanlış bu, mate.", "src": "Wrong one, mate."},
{"key": "data.voice.default.another.0", "text": "Bir tane daha!", "src": "Another round!"},
{"key": "data.voice.default.another.1", "text": "Aynısından!", "src": "Same again!"},
{"key": "data.voice.default.another.2", "text": "Arkası gelsin!", "src": "Keep them coming!"},
{"key": "data.voice.default.close.0", "text": "Sağ ol.", "src": "Thanks."},
{"key": "data.voice.default.close.1", "text": "İş görür.", "src": "That'll do."},
{"key": "data.voice.default.close.2", "text": "Yakın sayılır.", "src": "Close enough."},
{"key": "data.voice.default.kicked.0", "text": "Ciddi misin? Peki.", "src": "Seriously? Fine."},
{"key": "data.voice.default.kicked.1", "text": "Hata yapıyorsun.", "src": "You're making a mistake."},
{"key": "data.voice.default.kicked.2", "text": "Neyse. Barın senin olsun.", "src": "Whatever. Keep your bar."},
{"key": "data.voice.default.leaving.0", "text": "Boş ver. Beklemekten bıktım.", "src": "Forget it. I'm done waiting."},
{"key": "data.voice.default.leaving.1", "text": "Bu gece çalışan yok mu?", "src": "Is anyone working tonight?"},
{"key": "data.voice.default.leaving.2", "text": "Peki. Başka yerde içerim.", "src": "Right. I'll drink somewhere else."},
{"key": "data.voice.default.order.0", "text": "{drink}, lütfen.", "src": "{drink}, please."},
{"key": "data.voice.default.order.1", "text": "Bir {drink} alayım.", "src": "I'll take a {drink}."},
{"key": "data.voice.default.order.2", "text": "Bir {drink}, bir saniyen olunca.", "src": "A {drink}, when you get a second."},
{"key": "data.voice.default.order.3", "text": "Bir {drink} olsun.", "src": "Make it a {drink}."},
{"key": "data.voice.default.perfect.0", "text": "Mükemmel!", "src": "Perfect!"},
{"key": "data.voice.default.perfect.1", "text": "İşte bu!", "src": "That's the one!"},
{"key": "data.voice.default.perfect.2", "text": "Tam isabet!", "src": "Spot on!"},
{"key": "data.voice.default.praise.0", "text": "Tek bir şeyine dokunmam.", "src": "Not a thing I'd change."},
{"key": "data.voice.default.praise.1", "text": "İşte içki dediğin bu.", "src": "Now that is a drink."},
{"key": "data.voice.default.praise.2", "text": "Sana kim öğrettiyse, ona teşekkür et.", "src": "Whoever taught you, thank them."},
{"key": "data.voice.default.sip.0", "text": "Hm. {advice}", "src": "Hm. {advice}"},
{"key": "data.voice.default.sip.1", "text": "{advice} Söylemiş olayım.", "src": "{advice} Just saying."},
{"key": "data.voice.default.sip.2", "text": "Açıkçası? {advice_l}", "src": "Honestly? {advice_l}"},
{"key": "data.voice.default.wrong.0", "text": "İstediğim bu değil.", "src": "Not what I asked."},
{"key": "data.voice.default.wrong.1", "text": "Yanlış içki.", "src": "Wrong drink."},
{"key": "data.voice.default.wrong.2", "text": "Bu benimki değil.", "src": "That isn't mine."},
{"key": "data.voice.french.another.0", "text": "Encore, lütfen!", "src": "Encore, please!"},
{"key": "data.voice.french.another.1", "text": "Bir tane daha, oui!", "src": "One more, oui!"},
{"key": "data.voice.french.another.2", "text": "Tekrar, merci!", "src": "Again, merci!"},
{"key": "data.voice.french.close.0", "text": "Ça va.", "src": "Ca va."},
{"key": "data.voice.french.close.1", "text": "İdare eder.", "src": "It is fine."},
{"key": "data.voice.french.close.2", "text": "Bon, tamam.", "src": "Bon, okay."},
{"key": "data.voice.french.kicked.0", "text": "Quoi? Gerçekten mi?", "src": "Quoi? Really?"},
{"key": "data.voice.french.kicked.1", "text": "Bon. Au revoir.", "src": "Bon. Au revoir."},
{"key": "data.voice.french.kicked.2", "text": "C'est ridicule.", "src": "C'est ridicule."},
{"key": "data.voice.french.leaving.0", "text": "Non. Yeterince bekledim.", "src": "Non. I have waited enough."},
{"key": "data.voice.french.leaving.1", "text": "Tant pis. Gidiyorum.", "src": "Tant pis. I go."},
{"key": "data.voice.french.leaving.2", "text": "Au revoir o zaman.", "src": "Au revoir, then."},
{"key": "data.voice.french.order.0", "text": "Bir {drink}, s'il vous plaît.", "src": "A {drink}, s'il vous plait."},
{"key": "data.voice.french.order.1", "text": "{drink}, lütfen.", "src": "{drink}, please."},
{"key": "data.voice.french.order.2", "text": "Un {drink}, merci.", "src": "Un {drink}, merci."},
{"key": "data.voice.french.order.3", "text": "Ben {drink} alayım.", "src": "I will take a {drink}."},
{"key": "data.voice.french.perfect.0", "text": "Parfait!", "src": "Parfait!"},
{"key": "data.voice.french.perfect.1", "text": "Voilà, mükemmel!", "src": "Voila, perfect!"},
{"key": "data.voice.french.perfect.2", "text": "Magnifique!", "src": "Magnifique!"},
{"key": "data.voice.french.praise.0", "text": "Parfait. Hiçbir itirazım yok.", "src": "Parfait. I have no notes at all."},
{"key": "data.voice.french.praise.1", "text": "Voilà. Burada içki koymayı bilen biri var.", "src": "Voila. Someone here can pour."},
{"key": "data.voice.french.praise.2", "text": "Magnifique. Gerçekten.", "src": "Magnifique. Truly."},
{"key": "data.voice.french.sip.0", "text": "Écoute, {advice_l}", "src": "Ecoute, {advice_l}"},
{"key": "data.voice.french.sip.1", "text": "Bon, {advice_l}", "src": "Bon, {advice_l}"},
{"key": "data.voice.french.sip.2", "text": "Alors, {advice_l}", "src": "Alors, {advice_l}"},
{"key": "data.voice.french.wrong.0", "text": "Non, non.", "src": "Non, non."},
{"key": "data.voice.french.wrong.1", "text": "Bu değil.", "src": "This is not it."},
{"key": "data.voice.french.wrong.2", "text": "Pardon, yanlış.", "src": "Pardon, wrong."},
{"key": "data.voice.japanese.another.0", "text": "Mou ippai!", "src": "Mou ippai!"},
{"key": "data.voice.japanese.another.1", "text": "Bir tane daha, kanpai!", "src": "One more, kanpai!"},
{"key": "data.voice.japanese.another.2", "text": "Tekrar, onegai!", "src": "Again, onegai!"},
{"key": "data.voice.japanese.close.0", "text": "Hai, tamam.", "src": "Hai, okay."},
{"key": "data.voice.japanese.close.1", "text": "Maa maa.", "src": "Maa maa."},
{"key": "data.voice.japanese.close.2", "text": "Fena değil, ne.", "src": "Not bad, ne."},
{"key": "data.voice.japanese.kicked.0", "text": "Eh?! Gerçekten mi?", "src": "Eh?! Really?"},
{"key": "data.voice.japanese.kicked.1", "text": "Hidoi. Tamam, gidiyorum.", "src": "Hidoi. Okay, I go."},
{"key": "data.voice.japanese.kicked.2", "text": "Wakatta. Sayonara.", "src": "Wakatta. Sayonara."},
{"key": "data.voice.japanese.leaving.0", "text": "Sumimasen, daha fazla bekleyemem.", "src": "Sumimasen, I cannot wait more."},
{"key": "data.voice.japanese.leaving.1", "text": "Mou ii. Ben kalkıyorum.", "src": "Mou ii. I go."},
{"key": "data.voice.japanese.leaving.2", "text": "Shikata nai. Hoşça kalın.", "src": "Shikata nai. Goodbye."},
{"key": "data.voice.japanese.order.0", "text": "Sumimasen, bir {drink}.", "src": "Sumimasen, a {drink}."},
{"key": "data.voice.japanese.order.1", "text": "Bir {drink}, onegai.", "src": "One {drink}, onegai."},
{"key": "data.voice.japanese.order.2", "text": "{drink}, lütfen. Arigatou.", "src": "{drink}, please. Arigatou."},
{"key": "data.voice.japanese.order.3", "text": "Etto… bir {drink}.", "src": "Etto… a {drink}."},
{"key": "data.voice.japanese.perfect.0", "text": "Oishii!", "src": "Oishii!"},
{"key": "data.voice.japanese.perfect.1", "text": "Sugoi, mükemmel!", "src": "Sugoi, perfect!"},
{"key": "data.voice.japanese.perfect.2", "text": "Kanpai!", "src": "Kanpai!"},
{"key": "data.voice.japanese.praise.0", "text": "Oishii. Gerçekten, işte bu.", "src": "Oishii. Truly, this is the one."},
{"key": "data.voice.japanese.praise.1", "text": "Sugoi. Tam bir ustasın, ne.", "src": "Sugoi. You are a pro, ne."},
{"key": "data.voice.japanese.praise.2", "text": "Kanpai. Bu kusursuz.", "src": "Kanpai. This is perfect."},
{"key": "data.voice.japanese.sip.0", "text": "Etto, {advice_l}", "src": "Etto, {advice_l}"},
{"key": "data.voice.japanese.sip.1", "text": "Ne, {advice_l}", "src": "Ne, {advice_l}"},
{"key": "data.voice.japanese.sip.2", "text": "Sumimasen ama {advice_l}", "src": "Sumimasen, but {advice_l}"},
{"key": "data.voice.japanese.wrong.0", "text": "Chotto… yok.", "src": "Chotto… no."},
{"key": "data.voice.japanese.wrong.1", "text": "Eh? Bu değil.", "src": "Eh? Not this."},
{"key": "data.voice.japanese.wrong.2", "text": "Chigau, kusura bakma.", "src": "Chigau, sorry."},
{"key": "data.voice.midwest.another.0", "text": "Bir tane daha, lütfen!", "src": "Another, please!"},
{"key": "data.voice.midwest.another.1", "text": "Bir daha, teşekkürler!", "src": "One more, thanks!"},
{"key": "data.voice.midwest.another.2", "text": "Aynısından, ope!", "src": "Same again, ope!"},
{"key": "data.voice.midwest.close.0", "text": "Oh, gayet iyi.", "src": "Oh, that's fine."},
{"key": "data.voice.midwest.close.1", "text": "Tabii, sağ ol.", "src": "Sure, thanks."},
{"key": "data.voice.midwest.close.2", "text": "Hiç fena değil.", "src": "Not bad at all."},
{"key": "data.voice.midwest.kicked.0", "text": "Oh. Şey. Peki o zaman.", "src": "Oh. Well. Okay then."},
{"key": "data.voice.midwest.kicked.1", "text": "Ope, pardon… gidiyorum.", "src": "Ope, sorry… I'll go."},
{"key": "data.voice.midwest.kicked.2", "text": "Biraz fazla oldu ama peki.", "src": "That's a bit much, but okay."},
{"key": "data.voice.midwest.leaving.0", "text": "Oh gosh, gerçekten daha bekleyemem.", "src": "Oh gosh, I really can't wait anymore."},
{"key": "data.voice.midwest.leaving.1", "text": "Eh, artık gitsem iyi olur.", "src": "Well, I should get going."},
{"key": "data.voice.midwest.leaving.2", "text": "Kusura bakma ama ben kalkıyorum.", "src": "Sorry, but I'll head out."},
{"key": "data.voice.midwest.order.0", "text": "Bir {drink} alabilir miyim? Çok sağ ol.", "src": "Could I get a {drink}? Thanks a bunch."},
{"key": "data.voice.midwest.order.1", "text": "Bir {drink}, zahmet olmazsa.", "src": "A {drink}, if it's no trouble."},
{"key": "data.voice.midwest.order.2", "text": "Oh, bana sadece bir {drink}.", "src": "Oh, just a {drink} for me."},
{"key": "data.voice.midwest.order.3", "text": "{drink}, lütfen. Ne zaman olursa.", "src": "{drink}, please. Whenever."},
{"key": "data.voice.midwest.perfect.0", "text": "Oh, çok güzel!", "src": "Oh, real nice!"},
{"key": "data.voice.midwest.perfect.1", "text": "You betcha!", "src": "You betcha!"},
{"key": "data.voice.midwest.perfect.2", "text": "Oh jeez, evet!", "src": "Oh jeez, yes!"},
{"key": "data.voice.midwest.praise.0", "text": "Oh my gosh, bu çok hoş olmuş.", "src": "Oh my gosh, that is just lovely."},
{"key": "data.voice.midwest.praise.1", "text": "Çok güzel. Teyzem burayı çok severdi.", "src": "Real nice. My aunt would love this place."},
{"key": "data.voice.midwest.praise.2", "text": "Eh, tam yerine oturdu.", "src": "Well, that hit the spot."},
{"key": "data.voice.midwest.sip.0", "text": "Oh, {advice_l}", "src": "Oh, {advice_l}"},
{"key": "data.voice.midwest.sip.1", "text": "Haberin olsun, {advice_l}", "src": "Just so you know, {advice_l}"},
{"key": "data.voice.midwest.sip.2", "text": "Önemli değil ama {advice_l}", "src": "No big deal, but {advice_l}"},
{"key": "data.voice.midwest.wrong.0", "text": "Ope. Yanlışı geldi.", "src": "Ope. Wrong one."},
{"key": "data.voice.midwest.wrong.1", "text": "Oh, bu benimki değil.", "src": "Oh, that's not mine."},
{"key": "data.voice.midwest.wrong.2", "text": "Pardon, yok. Bu değil.", "src": "Sorry, no. Not this."},
{"key": "data.voice.polish.another.0", "text": "Jeszcze raz!", "src": "Jeszcze raz!"},
{"key": "data.voice.polish.another.1", "text": "Bir tane daha, proszę!", "src": "Another, proszę!"},
{"key": "data.voice.polish.another.2", "text": "Bir daha!", "src": "One more!"},
{"key": "data.voice.polish.close.0", "text": "Dobrze.", "src": "Dobrze."},
{"key": "data.voice.polish.close.1", "text": "Tamam.", "src": "Okay."},
{"key": "data.voice.polish.close.2", "text": "Olur, sağ ol.", "src": "Fine, thanks."},
{"key": "data.voice.polish.kicked.0", "text": "Serio? Tamam.", "src": "Serio? Okay."},
{"key": "data.voice.polish.kicked.1", "text": "Peki. Do widzenia.", "src": "Fine. Do widzenia."},
{"key": "data.voice.polish.kicked.2", "text": "Co? Tamam, gidiyorum.", "src": "Co? Okay, I go."},
{"key": "data.voice.polish.leaving.0", "text": "Yeter. Ben kalkıyorum.", "src": "Enough. I'm going."},
{"key": "data.voice.polish.leaving.1", "text": "Nie, nie. Çok uzun sürdü.", "src": "Nie, nie. Too long."},
{"key": "data.voice.polish.leaving.2", "text": "Do widzenia.", "src": "Do widzenia."},
{"key": "data.voice.polish.order.0", "text": "Bir {drink}, proszę.", "src": "A {drink}, proszę."},
{"key": "data.voice.polish.order.1", "text": "{drink}, lütfen.", "src": "{drink}, please."},
{"key": "data.voice.polish.order.2", "text": "Bir {drink}. Teşekkür ederim.", "src": "One {drink}. Thank you."},
{"key": "data.voice.polish.order.3", "text": "Dobrze, bir {drink}.", "src": "Dobrze, a {drink}."},
{"key": "data.voice.polish.perfect.0", "text": "Na zdrowie!", "src": "Na zdrowie!"},
{"key": "data.voice.polish.perfect.1", "text": "Świetnie!", "src": "Świetnie!"},
{"key": "data.voice.polish.perfect.2", "text": "Çok iyi!", "src": "Very good!"},
{"key": "data.voice.polish.praise.0", "text": "Na zdrowie. İşte gerçek içki.", "src": "Na zdrowie. This is a real drink."},
{"key": "data.voice.polish.praise.1", "text": "Świetnie. Evdeki gibi.", "src": "Świetnie. Like at home."},
{"key": "data.voice.polish.praise.2", "text": "Dobrze. Çok, çok iyi.", "src": "Dobrze. Very, very good."},
{"key": "data.voice.polish.sip.0", "text": "Dobrze ama {advice_l}", "src": "Dobrze, but {advice_l}"},
{"key": "data.voice.polish.sip.1", "text": "Dinle, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.polish.sip.2", "text": "Hm, {advice_l}", "src": "Hm, {advice_l}"},
{"key": "data.voice.polish.wrong.0", "text": "Nie. Yanlış bu.", "src": "Nie. Wrong one."},
{"key": "data.voice.polish.wrong.1", "text": "Bu benimki değil.", "src": "This is not mine."},
{"key": "data.voice.polish.wrong.2", "text": "Co to jest?", "src": "Co to jest?"},
{"key": "data.voice.turkish.another.0", "text": "Bir daha!", "src": "Bir daha!"},
{"key": "data.voice.turkish.another.1", "text": "Abi, bir tane daha!", "src": "Another, abi!"},
{"key": "data.voice.turkish.another.2", "text": "Yenisini koy, eyvallah!", "src": "Again, eyvallah!"},
{"key": "data.voice.turkish.close.0", "text": "Tamam.", "src": "Tamam."},
{"key": "data.voice.turkish.close.1", "text": "İdare eder.", "src": "İdare eder."},
{"key": "data.voice.turkish.close.2", "text": "Olur, sorun yok.", "src": "Okay, fine."},
{"key": "data.voice.turkish.kicked.0", "text": "Ciddi misin? Peki.", "src": "Ciddi misin? Okay."},
{"key": "data.voice.turkish.kicked.1", "text": "Abi, yapma ya. Tamam.", "src": "Abi, really? Fine."},
{"key": "data.voice.turkish.kicked.2", "text": "Yok, yok. Gidiyorum.", "src": "Yok, yok. I'm going."},
{"key": "data.voice.turkish.leaving.0", "text": "Yok, daha fazla beklemem.", "src": "Yok, I'm not waiting anymore."},
{"key": "data.voice.turkish.leaving.1", "text": "Abi, burada çalışan yok mu?", "src": "Abi, is nobody working here?"},
{"key": "data.voice.turkish.leaving.2", "text": "Tamam, hoşça kal.", "src": "Tamam, hoşça kal."},
{"key": "data.voice.turkish.order.0", "text": "Abi, bir {drink}.", "src": "Abi, a {drink}."},
{"key": "data.voice.turkish.order.1", "text": "Bir {drink}, eyvallah.", "src": "One {drink}, eyvallah."},
{"key": "data.voice.turkish.order.2", "text": "{drink}, canım, müsait olunca.", "src": "{drink}, canım, when you can."},
{"key": "data.voice.turkish.order.3", "text": "Bir {drink} rica etsem.", "src": "Bir {drink}, please."},
{"key": "data.voice.turkish.perfect.0", "text": "Eyvallah!", "src": "Eyvallah!"},
{"key": "data.voice.turkish.perfect.1", "text": "Harika!", "src": "Harika!"},
{"key": "data.voice.turkish.perfect.2", "text": "Süper, abi!", "src": "Süper, abi!"},
{"key": "data.voice.turkish.praise.0", "text": "Eyvallah. İşte böyle yapılır.", "src": "Eyvallah. This is how it's done."},
{"key": "data.voice.turkish.praise.1", "text": "Abi, şapka çıkarırım. Harika.", "src": "Abi, my hat is off. Harika."},
{"key": "data.voice.turkish.praise.2", "text": "Tamam, sen bu işi biliyorsun.", "src": "Tamam, you know your work."},
