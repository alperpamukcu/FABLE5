{"strings": [
{"key": "data.voice.arabic.another.0", "text": "Kaman wahad!", "src": "Kaman wahad!"},
{"key": "data.voice.arabic.another.1", "text": "Bir tane daha, yalla!", "src": "One more, yalla!"},
{"key": "data.voice.arabic.another.2", "text": "Bir daha, habibi!", "src": "Again, habibi!"},
{"key": "data.voice.arabic.close.0", "text": "Maashi.", "src": "Maashi."},
{"key": "data.voice.arabic.close.1", "text": "İdare eder.", "src": "It is okay."},
{"key": "data.voice.arabic.close.2", "text": "Tamam, shukran.", "src": "Tamam, shukran."},
{"key": "data.voice.arabic.kicked.0", "text": "Shu? Ciddi misin?", "src": "Shu? Seriously?"},
{"key": "data.voice.arabic.kicked.1", "text": "Khalas. Peki.", "src": "Khalas. Fine."},
{"key": "data.voice.arabic.kicked.2", "text": "Yalla. Gidiyorum.", "src": "Yalla. I go."},
{"key": "data.voice.arabic.leaving.0", "text": "Khalas. Ben kalkıyorum.", "src": "Khalas. I am going."},
{"key": "data.voice.arabic.leaving.1", "text": "Yalla, bu kadar bekleme yeter.", "src": "Yalla, enough waiting."},
{"key": "data.voice.arabic.leaving.2", "text": "Maa salama.", "src": "Maa salama."},
{"key": "data.voice.arabic.order.0", "text": "Bir {drink}, lütfen.", "src": "A {drink}, please."},
{"key": "data.voice.arabic.order.1", "text": "Bir {drink}, shukran.", "src": "One {drink}, shukran."},
{"key": "data.voice.arabic.order.2", "text": "Habibi, bir {drink}.", "src": "Habibi, a {drink}."},
{"key": "data.voice.arabic.order.3", "text": "Ben {drink} alayım.", "src": "I will take a {drink}."},
{"key": "data.voice.arabic.perfect.0", "text": "Ya salam!", "src": "Ya salam!"},
{"key": "data.voice.arabic.perfect.1", "text": "Helu kteer!", "src": "Helu kteer!"},
{"key": "data.voice.arabic.perfect.2", "text": "Mükemmel, habibi!", "src": "Perfect, habibi!"},
{"key": "data.voice.arabic.praise.0", "text": "Ya salam. İşte bu, habibi.", "src": "Ya salam. This is the one, habibi."},
{"key": "data.voice.arabic.praise.1", "text": "Helu kteer. Shukran.", "src": "Helu kteer. Shukran."},
{"key": "data.voice.arabic.praise.2", "text": "Yalla, sen işini biliyorsun.", "src": "Yalla, you know your work."},
{"key": "data.voice.arabic.sip.0", "text": "Habibi, {advice_l}", "src": "Habibi, {advice_l}"},
{"key": "data.voice.arabic.sip.1", "text": "Shuf, {advice_l}", "src": "Shuf, {advice_l}"},
{"key": "data.voice.arabic.sip.2", "text": "Tamam, bas {advice_l}", "src": "Tamam, bas {advice_l}"},
{"key": "data.voice.arabic.wrong.0", "text": "La, la.", "src": "La, la."},
{"key": "data.voice.arabic.wrong.1", "text": "Bu değil.", "src": "This is not it."},
{"key": "data.voice.arabic.wrong.2", "text": "Shu hada?", "src": "Shu hada?"},
{"key": "data.voice.chinese.another.0", "text": "Zai lai yi bei!", "src": "Zai lai yi bei!"},
{"key": "data.voice.chinese.another.1", "text": "Bir tane daha, ah!", "src": "One more, ah!"},
{"key": "data.voice.chinese.another.2", "text": "Tekrar, lütfen!", "src": "Again, please!"},
{"key": "data.voice.chinese.close.0", "text": "Hai keyi.", "src": "Hai keyi."},
{"key": "data.voice.chinese.close.1", "text": "Olur lah.", "src": "Okay lah."},
{"key": "data.voice.chinese.close.2", "text": "İdare eder.", "src": "It is fine."},
{"key": "data.voice.chinese.kicked.0", "text": "Shenme? Gerçekten mi?", "src": "Shenme? Really?"},
{"key": "data.voice.chinese.kicked.1", "text": "Aiya. Peki.", "src": "Aiya. Fine."},
{"key": "data.voice.chinese.kicked.2", "text": "Hao. Gidiyorum.", "src": "Hao. I leave."},
{"key": "data.voice.chinese.leaving.0", "text": "Aiya. Çok bekledim.", "src": "Aiya. I waited too long."},
{"key": "data.voice.chinese.leaving.1", "text": "Suan le. Ben kalkıyorum.", "src": "Suan le. I go."},
{"key": "data.voice.chinese.leaving.2", "text": "Zaijian o zaman.", "src": "Zaijian, then."},
{"key": "data.voice.chinese.order.0", "text": "{drink}, lütfen.", "src": "{drink}, please."},
{"key": "data.voice.chinese.order.1", "text": "Bir {drink}, xiexie.", "src": "One {drink}, xiexie."},
{"key": "data.voice.chinese.order.2", "text": "Ben {drink} alayım.", "src": "I will have a {drink}."},
{"key": "data.voice.chinese.order.3", "text": "Bana bir {drink}.", "src": "A {drink} for me."},
{"key": "data.voice.chinese.perfect.0", "text": "Hen hao!", "src": "Hen hao!"},
{"key": "data.voice.chinese.perfect.1", "text": "Mükemmel, ah!", "src": "Perfect, ah!"},
{"key": "data.voice.chinese.perfect.2", "text": "Zhen bang!", "src": "Zhen bang!"},
{"key": "data.voice.chinese.praise.0", "text": "Zhen bang. Bunun için yine gelirim.", "src": "Zhen bang. I will come back for this."},
{"key": "data.voice.chinese.praise.1", "text": "Hen hao. Ne yaptığını biliyorsun.", "src": "Hen hao. You know what you are doing."},
{"key": "data.voice.chinese.praise.2", "text": "Mükemmel, ah. Gerçekten.", "src": "Perfect, ah. Really."},
{"key": "data.voice.chinese.sip.0", "text": "Ai, {advice_l}", "src": "Ai, {advice_l}"},
{"key": "data.voice.chinese.sip.1", "text": "Dinle, {advice_l}", "src": "Listen, {advice_l}"},
{"key": "data.voice.chinese.sip.2", "text": "Hao ama {advice_l}", "src": "Hao, but {advice_l}"},
{"key": "data.voice.chinese.wrong.0", "text": "Bu dui.", "src": "Bu dui."},
{"key": "data.voice.chinese.wrong.1", "text": "Aiya, yok.", "src": "Aiya, no."},
{"key": "data.voice.chinese.wrong.2", "text": "Bu değil.", "src": "Not this one."},
{"key": "data.voice.filipino.another.0", "text": "Isa pa!", "src": "Isa pa!"},
{"key": "data.voice.filipino.another.1", "text": "Bir tane daha, ha!", "src": "One more, ha!"},
{"key": "data.voice.filipino.another.2", "text": "Tekrar, lütfen!", "src": "Again, please!"},
{"key": "data.voice.filipino.close.0", "text": "Okay lang.", "src": "Okay lang."},
{"key": "data.voice.filipino.close.1", "text": "Sige, sağ ol.", "src": "Sige, thanks."},
{"key": "data.voice.filipino.close.2", "text": "Ay, olur.", "src": "Ay, it's fine."},
{"key": "data.voice.filipino.kicked.0", "text": "Ha? Gerçekten mi?", "src": "Ha? Really?"},
{"key": "data.voice.filipino.kicked.1", "text": "Ay. Tamam. Bye.", "src": "Ay. Okay. Bye."},
{"key": "data.voice.filipino.kicked.2", "text": "Grabe naman.", "src": "Grabe naman."},
{"key": "data.voice.filipino.leaving.0", "text": "Ay, grabe. Çok uzun. Gidiyorum.", "src": "Ay, grabe. Too long. I'm going."},
{"key": "data.voice.filipino.leaving.1", "text": "Sige na, bye.", "src": "Sige na, bye."},
{"key": "data.voice.filipino.leaving.2", "text": "Naku, gelen giden yok.", "src": "Naku, no one is coming."},
{"key": "data.voice.filipino.order.0", "text": "Ay, bir {drink}, lütfen.", "src": "Ay, one {drink}, please."},
{"key": "data.voice.filipino.order.1", "text": "Bana {drink}. Salamat.", "src": "{drink} for me. Salamat."},
{"key": "data.voice.filipino.order.2", "text": "Bir {drink} alabilir miyim? Sağ ol, ha.", "src": "Can I have a {drink}? Thanks, ha."},
{"key": "data.voice.filipino.order.3", "text": "Bir {drink}, kuya.", "src": "A {drink}, kuya."},
{"key": "data.voice.filipino.perfect.0", "text": "Ay, sarap!", "src": "Ay, sarap!"},
{"key": "data.voice.filipino.perfect.1", "text": "Grabe, evet!", "src": "Grabe, yes!"},
{"key": "data.voice.filipino.perfect.2", "text": "Mükemmel, kuya!", "src": "Perfect, kuya!"},
{"key": "data.voice.filipino.praise.0", "text": "Grabe. Çok güzel olmuş. Salamat.", "src": "Grabe. That is so good. Salamat."},
{"key": "data.voice.filipino.praise.1", "text": "Ay, sarap. Bütün vardiyamı kurtardın.", "src": "Ay, sarap. You made my whole shift."},
{"key": "data.voice.filipino.praise.2", "text": "Sige, bunun için yine gelirim.", "src": "Sige, I'm coming back for this."},
{"key": "data.voice.filipino.sip.0", "text": "Ay, {advice_l}", "src": "Ay, {advice_l}"},
{"key": "data.voice.filipino.sip.1", "text": "Sige ama {advice_l}", "src": "Sige, but {advice_l}"},
{"key": "data.voice.filipino.sip.2", "text": "Ha? {advice}", "src": "Ha? {advice}"},
{"key": "data.voice.filipino.wrong.0", "text": "Ay, hindi. Bu değil.", "src": "Ay, hindi. Not this."},
{"key": "data.voice.filipino.wrong.1", "text": "Grabe, yanlış içki.", "src": "Grabe, wrong drink."},
{"key": "data.voice.filipino.wrong.2", "text": "Benimki değil, kuya.", "src": "Not mine, kuya."},
{"key": "data.voice.italian.another.0", "text": "Ancora, dai!", "src": "Ancora, dai!"},
{"key": "data.voice.italian.another.1", "text": "Bir tane daha, grazie!", "src": "Another, grazie!"},
{"key": "data.voice.italian.another.2", "text": "Bir daha, amore!", "src": "Once more, amore!"},
{"key": "data.voice.italian.close.0", "text": "Va bene.", "src": "Va bene."},
{"key": "data.voice.italian.close.1", "text": "Tamam, grazie.", "src": "Okay, grazie."},
{"key": "data.voice.italian.close.2", "text": "Fena değil, eh.", "src": "Not bad, eh."},
{"key": "data.voice.italian.kicked.0", "text": "Ma dai! Gerçekten mi?", "src": "Ma dai! Really?"},
{"key": "data.voice.italian.kicked.1", "text": "Va bene. Ciao, ciao.", "src": "Va bene. Ciao, ciao."},
{"key": "data.voice.italian.kicked.2", "text": "Che maleducato.", "src": "Che maleducato."},
{"key": "data.voice.italian.leaving.0", "text": "Basta. Gidiyorum.", "src": "Basta. I go."},
{"key": "data.voice.italian.leaving.1", "text": "Mamma mia, bu ne bekleyiş!", "src": "Mamma mia, the waiting!"},
{"key": "data.voice.italian.leaving.2", "text": "Ciao. Belki başka bir hayatta.", "src": "Ciao. Maybe next life."},
{"key": "data.voice.italian.order.0", "text": "Un {drink}, per favore.", "src": "Un {drink}, per favore."},
{"key": "data.voice.italian.order.1", "text": "Bir {drink}, amore.", "src": "A {drink}, amore."},
{"key": "data.voice.italian.order.2", "text": "{drink}, grazie.", "src": "{drink}, grazie."},
{"key": "data.voice.italian.order.3", "text": "Dai, bir {drink}.", "src": "Dai, a {drink}."},
{"key": "data.voice.italian.perfect.0", "text": "Perfetto!", "src": "Perfetto!"},
{"key": "data.voice.italian.perfect.1", "text": "Bravo!", "src": "Bravo!"},
{"key": "data.voice.italian.perfect.2", "text": "Che buono!", "src": "Che buono!"},
{"key": "data.voice.italian.praise.0", "text": "Perfetto. Gerçekten. Grazie mille.", "src": "Perfetto. Truly. Grazie mille."},
{"key": "data.voice.italian.praise.1", "text": "Bravo. Nonnam görse ağlardı.", "src": "Bravo. My nonna would cry."},
{"key": "data.voice.italian.praise.2", "text": "Che buono. Hiçbir yere gitmiyorum.", "src": "Che buono. I'm not leaving."},
{"key": "data.voice.italian.sip.0", "text": "Senti, {advice_l}", "src": "Senti, {advice_l}"},
{"key": "data.voice.italian.sip.1", "text": "Allora, {advice_l}", "src": "Allora, {advice_l}"},
{"key": "data.voice.italian.sip.2", "text": "Va bene, ma {advice_l}", "src": "Va bene, ma {advice_l}"},
{"key": "data.voice.italian.wrong.0", "text": "Mamma mia, yok.", "src": "Mamma mia, no."},
{"key": "data.voice.italian.wrong.1", "text": "Ma che cos'è?", "src": "Ma che cos'è?"},
{"key": "data.voice.italian.wrong.2", "text": "No, no. Bu değil.", "src": "No, no. Not this."},
{"key": "data.voice.miami.another.0", "text": "¡Otra, dale!", "src": "¡Otra, dale!"},
{"key": "data.voice.miami.another.1", "text": "Bir daha, oye!", "src": "One more, oye!"},
{"key": "data.voice.miami.another.2", "text": "Tekrar, mi amor!", "src": "Again, mi amor!"},
{"key": "data.voice.miami.close.0", "text": "Está bien.", "src": "Está bien."},
{"key": "data.voice.miami.close.1", "text": "Fena değil, chico.", "src": "Not bad, chico."},
{"key": "data.voice.miami.close.2", "text": "Tamam, tamam.", "src": "Okay, okay."},
{"key": "data.voice.miami.kicked.0", "text": "¿En serio? Peki, tamam.", "src": "¿En serio? Okay, fine."},
{"key": "data.voice.miami.kicked.1", "text": "Şaka yapıyorsun, chico.", "src": "You're kidding me, chico."},
{"key": "data.voice.miami.kicked.2", "text": "Dale. Sen kaybedersin.", "src": "Dale. Your loss."},
{"key": "data.voice.miami.leaving.0", "text": "¡Oye! Bütün gece burada oturdum.", "src": "¡Oye! I've been sitting here all night."},
{"key": "data.voice.miami.leaving.1", "text": "Bueno, bu kadar. Ciao.", "src": "Bueno, that's it. Ciao."},
{"key": "data.voice.miami.leaving.2", "text": "No, no. Artık beklemiyorum.", "src": "No, no. I'm not waiting anymore."},
{"key": "data.voice.miami.order.0", "text": "Oye, bana bir {drink}.", "src": "Oye, a {drink} for me."},
{"key": "data.voice.miami.order.1", "text": "Dale, bir {drink}.", "src": "Dale, one {drink}."},
{"key": "data.voice.miami.order.2", "text": "{drink}, papi, müsait olunca.", "src": "{drink}, papi, when you can."},
{"key": "data.voice.miami.order.3", "text": "Mi amor, bir {drink}.", "src": "Mi amor, a {drink}."},
{"key": "data.voice.miami.perfect.0", "text": "¡Qué rico!", "src": "¡Qué rico!"},
{"key": "data.voice.miami.perfect.1", "text": "¡Eso es!", "src": "¡Eso es!"},
{"key": "data.voice.miami.perfect.2", "text": "¡Dale, perfecto!", "src": "¡Dale, perfecto!"},
{"key": "data.voice.miami.praise.0", "text": "Ay, işte bu. Gracias.", "src": "Ay, this is the one. Gracias."},
{"key": "data.voice.miami.praise.1", "text": "Abuelam bile beğenirdi, o hiçbir şeyi beğenmez.", "src": "My abuela would approve, and she approves of nothing."},
{"key": "data.voice.miami.praise.2", "text": "Dale. Ne yaptığını biliyorsun.", "src": "Dale. You know what you're doing."},
{"key": "data.voice.miami.sip.0", "text": "Mira, {advice_l}", "src": "Mira, {advice_l}"},
{"key": "data.voice.miami.sip.1", "text": "Oye, {advice_l}", "src": "Oye, {advice_l}"},
{"key": "data.voice.miami.sip.2", "text": "Está bien, pero… {advice_l}", "src": "Está bien, pero… {advice_l}"},
{"key": "data.voice.miami.wrong.0", "text": "¿Qué es esto?", "src": "¿Qué es esto?"},
{"key": "data.voice.miami.wrong.1", "text": "No, no, no.", "src": "No, no, no."},
{"key": "data.voice.miami.wrong.2", "text": "Benimki değil, oye.", "src": "Not mine, oye."},
{"key": "data.voice.nyc.another.0", "text": "Bir daha doldur!", "src": "Hit me again!"},
{"key": "data.voice.nyc.another.1", "text": "Arkası gelsin!", "src": "Keep 'em comin'!"},
{"key": "data.voice.nyc.another.2", "text": "Bir tane daha, chief!", "src": "Another, chief!"},
{"key": "data.voice.nyc.close.0", "text": "Eh. Olur.", "src": "Eh. It's fine."},
{"key": "data.voice.nyc.close.1", "text": "Yeah, tamam.", "src": "Yeah, alright."},
{"key": "data.voice.nyc.close.2", "text": "İş görür.", "src": "It'll do."},
{"key": "data.voice.nyc.kicked.0", "text": "Şu an ciddi misin?", "src": "You serious right now?"},
{"key": "data.voice.nyc.kicked.1", "text": "Peki. Zaten berbat bir bar.", "src": "Fine. Terrible bar anyway."},
{"key": "data.voice.nyc.kicked.2", "text": "Vay. Tamam. Vay.", "src": "Wow. Okay. Wow."},
{"key": "data.voice.nyc.leaving.0", "text": "Gidecek yerlerim var. Boş ver.", "src": "I got places to be. Forget it."},
{"key": "data.voice.nyc.leaving.1", "text": "İnanılmaz. Ben çıkıyorum.", "src": "Unbelievable. I'm outta here."},
{"key": "data.voice.nyc.leaving.2", "text": "Yo, burası bar mı bekleme salonu mu?", "src": "Yo, is this a bar or a waiting room?"},
{"key": "data.voice.nyc.order.0", "text": "Yo, bana bir {drink} ver.", "src": "Yo, lemme get a {drink}."},
{"key": "data.voice.nyc.order.1", "text": "{drink}. Acelem de var.", "src": "{drink}. And I'm in a hurry."},
{"key": "data.voice.nyc.order.2", "text": "Bir {drink} patlat, chief.", "src": "Gimme a {drink}, chief."},
{"key": "data.voice.nyc.order.3", "text": "{drink}. Olay çıkarmadan.", "src": "{drink}. Don't make it weird."},
{"key": "data.voice.nyc.perfect.0", "text": "İşte şimdi konuşuyoruz!", "src": "Now we're talkin'!"},
{"key": "data.voice.nyc.perfect.1", "text": "Tam aradığım!", "src": "That's the stuff!"},
{"key": "data.voice.nyc.perfect.2", "text": "Oh, işte bu!", "src": "Oh, that's it!"},
{"key": "data.voice.nyc.praise.0", "text": "Tamam, etkilendim. Bu hiç olmaz.", "src": "Okay, I'm impressed. That never happens."},
{"key": "data.voice.nyc.praise.1", "text": "Bak sana söyleyeyim, içki dediğin bu.", "src": "Lemme tell ya, that's a drink."},
{"key": "data.voice.nyc.praise.2", "text": "Bunun için daha çok para istemelisin. İsteme.", "src": "You should charge more for this. Don't."},
{"key": "data.voice.nyc.sip.0", "text": "Bak, {advice_l}", "src": "Look, {advice_l}"},
{"key": "data.voice.nyc.sip.1", "text": "Sadece diyorum, {advice_l}", "src": "I'm just sayin', {advice_l}"},
{"key": "data.voice.nyc.sip.2", "text": "Fena değil ama {advice_l}", "src": "Not bad, but {advice_l}"},
{"key": "data.voice.nyc.wrong.0", "text": "Bu ne?", "src": "What is this?"},
{"key": "data.voice.nyc.wrong.1", "text": "Unut gitsin.", "src": "Fuhgeddaboudit."},
{"key": "data.voice.nyc.wrong.2", "text": "Yanlış bu, bro.", "src": "Wrong one, pal."},
{"key": "data.voice.surfer.another.0", "text": "Bir tane daha, dude!", "src": "One more, dude!"},
{"key": "data.voice.surfer.another.1", "text": "Tekrar, tekrar!", "src": "Again, again!"},
{"key": "data.voice.surfer.another.2", "text": "Dalga dalga gelsin!", "src": "Keep 'em rolling!"},
{"key": "data.voice.surfer.close.0", "text": "Cool, cool.", "src": "Cool, cool."},
{"key": "data.voice.surfer.close.1", "text": "Yeah, iş görür.", "src": "Yeah, that works."},
{"key": "data.voice.surfer.close.2", "text": "Yeterince güzel.", "src": "Nice enough."},
{"key": "data.voice.surfer.kicked.0", "text": "Sert oldu, dude.", "src": "Harsh, dude."},
{"key": "data.voice.surfer.kicked.1", "text": "Tamam… bu da bir vibe.", "src": "Okay… that's a vibe."},
{"key": "data.voice.surfer.kicked.2", "text": "Vay. Hiç chill değil.", "src": "Wow. Not chill."},
{"key": "data.voice.surfer.leaving.0", "text": "Dude, kaç saattir buradayım.", "src": "Dude, I've been here forever."},
{"key": "data.voice.surfer.leaving.1", "text": "Hiç cool değil. Ben kaçtım.", "src": "Not cool. I'm out."},
{"key": "data.voice.surfer.leaving.2", "text": "Yeah, yok. Ben sıvışıyorum.", "src": "Yeah, no. Bailing."},
{"key": "data.voice.surfer.order.0", "text": "Dude, bir {drink}.", "src": "Dude, a {drink}."},
{"key": "data.voice.surfer.order.1", "text": "Şey, bir {drink} alabilir miyim?", "src": "Can I get, like, a {drink}?"},
{"key": "data.voice.surfer.order.2", "text": "{drink}, lütfen. Chill, acele yok.", "src": "{drink}, please. Chill, no rush."},
{"key": "data.voice.surfer.order.3", "text": "Yeah, bir {drink} epic olur.", "src": "Yeah, a {drink} sounds epic."},
{"key": "data.voice.surfer.perfect.0", "text": "Dude. Evet.", "src": "Dude. Yes."},
{"key": "data.voice.surfer.perfect.1", "text": "Stoked!", "src": "Stoked!"},
{"key": "data.voice.surfer.perfect.2", "text": "Çok iyi!", "src": "So good!"},
{"key": "data.voice.surfer.praise.0", "text": "Tamam, bu gerçekten kusursuz. Respect.", "src": "Okay, that's actually perfect. Respect."},
{"key": "data.voice.surfer.praise.1", "text": "Dude. Şaka yapmıyorum. Muazzam.", "src": "Dude. I'm not even kidding. Amazing."},
